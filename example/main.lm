// The first Lumen program, and the one the README points at.
// It is everyday Lumen: a record, an algebraic data type, a `match`, and a `for` loop.
// Nothing is written out, because version 0.1 has no way to write a number out.
// Running to the end is what it shows, and `docs/specs/example-program.md` says why.
// A file reads top down, so what a name is comes below the first line that uses it.
fn main() -> () {
    ordered := Placed(Basket { apples: 3, pears: 4 })
    each := shared(total: picked(ordered) + picked(Unplaced), people: 2)
    most := fullest(many: each)
    ()
}

/// What each of `people` gets, which is nothing when there is nobody to give it to.
// example: shared(total: 7, people: 2) == 3
// example: shared(total: 7, people: 0) == 0
fn shared(total: Int, people: Int) -> Int {
    or(total / people, 0)
}

/// The fullest of `many` baskets, each one fuller than the last, which is how a loop reads.
// example: fullest(many: 3) == 6
fn fullest(many: Int) -> Int {
    var most = 0
    var left = many
    for left > 0 {
        held := picked(Placed(Basket { apples: left, pears: left }))
        if held > most {
            most = held
        }
        left += -1
    }
    most
}

/// How much an order comes to, which is nothing at all when nothing was ordered.
// example: picked(Placed(Basket { apples: 3, pears: 4 })) == 7
// example: picked(Unplaced) == 0
fn picked(order: Order) -> Int {
    match order {
        Unplaced => 0
        Placed(basket) => basket.apples + basket.pears
    }
}

type Order =
    | Unplaced
    | Placed(Basket)

type Basket = {
    apples: Int
    pears: Int
}
