// The first Bux program, and the one the README points at.
// It is everyday Bux: a record, an algebraic data type, a `match`, and a loop over a list.
// It writes every answer it works out, because a program that shows nobody anything is not one.
// `io.println` writes a line and `shown` gives a number its text; `docs/specs/io.md` says how.
// A file reads top down, so what a name is comes below the first line that uses it.
import io

fn main(arguments: List<String>) -> Int {
    let ordered = Placed(Basket { apples: 3, pears: 4 })
    let held = picked(ordered) + picked(Unplaced)
    let each = shared(total: held, people: 2)
    let most = fullest([Basket { apples: 1, pears: 1 }, Basket { apples: each, pears: each }])
    io.println("held: " + shown(held))
    io.println("each: " + shown(each))
    io.println("most: " + shown(most))
    0
}

/// What each of `people` gets, which is nothing when there is nobody to give it to.
// example: shared(total: 7, people: 2) == 3
// example: shared(total: 7, people: 0) == 0
fn shared(total: Int, people: Int) -> Int {
    or(total / people, 0)
}

/// The fullest of the baskets, which is what a loop over a written list reads like.
// example: fullest([Basket { apples: 1, pears: 1 }, Basket { apples: 3, pears: 3 }]) == 6
fn fullest(baskets: List<Basket>) -> Int {
    var most = 0
    for basket in baskets {
        let held = picked(Placed(basket))
        if held > most {
            most = held
        }
    }
    most
}

/// How much an order comes to, which is nothing at all when nothing was ordered.
// example: picked(Placed(Basket { apples: 3, pears: 4 })) == 7
// example: picked(Unplaced) == 0
fn picked(order: Order) -> Int {
    match order {
        Unplaced => 0
        Placed(basket) => basket.apples + basket.pears
    }
}

type Order =
    | Unplaced
    | Placed(Basket)

type Basket = {
    apples: Int
    pears: Int
}
