#!/bin/sh
# The runner in tests/runner.bx, built by the Bux compiler and started from the repository root.
#
# `bin/bux build` writes the classes of the runner, and of every compiler module it imports, in
# tests/target/, and beside them the library, the help topics, and the explanations that the
# compiler it calls reads. tests/target/ is the one directory on the class path.
set -e
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
root=$(cd "$(dirname "$self")/.." && pwd)
cd "$root"
bin/bux build tests/runner.bx
# The heap bound keeps the runner from the quarter of the memory that the JDK gives it by default.
# docs/implementation.md section 7 records the measurement behind it.
heap=-Xmx4g
exec "$JAVA_HOME/bin/java" --enable-preview "$heap" -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 \
    -cp "$root/tests/target" runner "$@"
