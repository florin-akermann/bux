#!/bin/sh
# The bootstrap: the seed builds the Bux compiler, and that compiler builds itself once more.
#
# bin/seed.jar holds the classes of a Bux compiler that an earlier compiler built. It writes
# stage 1, the classes in target/, which bin/bux starts. Stage 1 then builds stage 2 from a copy
# of the root package in a temporary directory outside the repository. Stage 2 must be stage 1
# byte for byte. If it is not, the compiler does not build itself as it says, and this script
# names the first class that differs and ends with status 1. A build writes only under target/,
# so deleting target/ is a clean build.
#
# A build copies the resources of its compiler beside the classes: the library, the help topics,
# and the explanations. The seed holds the copies it was packed with, and those are old. So the
# seed runs from one directory: the seed unpacked, with the three directories of this checkout in
# place of its own. Stage 1 then carries the resources of the checkout.
# A link to this script is followed to the script itself, which sits in bin/.
set -e
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
root=$(cd "$(dirname "$self")/.." && pwd)
if [ -z "$JAVA_HOME" ]; then
    echo "error: JAVA_HOME is not set, and the bootstrap runs on the JDK it names" >&2
    exit 2
fi
java="$JAVA_HOME/bin/java"
if [ ! -x "$java" ]; then
    echo "error: $java: JAVA_HOME names no JDK" >&2
    exit 2
fi
if [ ! -f "$root/bin/seed.jar" ]; then
    echo "error: $root/bin/seed.jar: the seed is missing, and the bootstrap starts from it" >&2
    exit 2
fi
# The heap bound of each of the two compiles. docs/implementation.md section 7, "The share of
# the machine", records why it is 256 MB.
heap=-Xmx256m
cd "$root"
rm -rf target
seed=$(mktemp -d "${TMPDIR:-/tmp}/bux-seed.XXXXXX")
copy=$(mktemp -d "${TMPDIR:-/tmp}/bux-bootstrap.XXXXXX")
trap 'rm -rf "$seed" "$copy"' EXIT
(cd "$seed" && "$JAVA_HOME/bin/jar" xf "$root/bin/seed.jar")
rm -rf "$seed/library" "$seed/help" "$seed/explanations"
cp -R library help explanations "$seed"
"$java" --enable-preview "$heap" -cp "$seed" main build src/main.bx
cp bux.package "$copy/bux.package"
cp -R src "$copy/src"
"$java" --enable-preview "$heap" -cp "$root/target" main build "$copy/src/main.bx"

# One diff compares the stages. Its first line names the first class that differs, as
# "Files A and B differ", or the first class or directory that only one stage holds, as
# "Only in D: C". A status of 2 from diff is a comparison that failed, and diff names why.
status=0
answer=$(diff -rq target "$copy/target") || status=$?
if [ "$status" -ne 1 ]; then
    exit "$status"
fi
first=$(printf '%s\n' "$answer" | head -n 1)
case $first in
    "Only in "*)
        place=${first#Only in }
        class=${place%%: *}/${place#*: }
        ;;
    *)
        class=${first#Files }
        class=${class%% and *}
        ;;
esac
echo "error: ${class#"$copy"/}: stage 2 differs from stage 1" >&2
exit 1
