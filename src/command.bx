// The `bux` command line, written in Bux: every command `bux --help` lists, and its answer.
//
// `docs/specs/run.md` states the command line and the launcher that starts it, and
// `docs/specs/diagnostics.md` states how a refusal reads. A command answers with text rather than
// with a print, so a test runs many commands in one JVM and holds each to its golden answer.
// `main.bx` prints the answer; it is a module of its own because no module imports `main`.
import archives
import ast
import boundary
import clock
import environment
import exhaustiveness
import files
import format
import holes
import infer
import ir
import jvm
import lexer
import list
import map
import modules
import parser
import programs
import refusal
import resolver
import set
import strings
import surface
import types

// example: said_by(answered(["--version"])).output == "bux 0.1.0\n"
fn answered(arguments: List<String>) -> Answer {
    answered_within(arguments, ir.library_read(or(modules.carried("prelude"), "")))
}

// `run` gives back the program to start, because that program uses the streams of this process.
// example: said_by(answered_within(["--version"], ir.little_library())).status == 0
// example: said_by(answered_within([], ir.little_library())).status == 2
fn answered_within(arguments: List<String>, library: ir.Library) -> Answer {
    match asked_by(arguments) {
        Told(said) => Spoken(said)
        Asked(command) => Spoken(path_said(command, library))
        Running(asked) => run_said(asked, library)
    }
}

// The JVM reads `main.bx/` as `main.bx`, so this function examines the path before it reads it.
// example: path_said(Fmt("/"), ir.little_library()).status == 2
fn path_said(command: Command, library: ir.Library) -> Said {
    let path = path_of(command)
    if is_a_file_as_a_directory(path) {
        return unusable(path + ": Not a directory (os error 20)")
    }
    if is_misnamed(path) {
        return misnamed_said(path, form_asked(command))
    }
    command_said(command, library)
}

// example: said_by(run_said(Started { file: "no-such-directory/a.bx", arguments: [] }, ir.little_library())).status == 2
fn run_said(asked: Started, library: ir.Library) -> Answer {
    if is_a_file_as_a_directory(asked.file) {
        return Spoken(unusable(asked.file + ": Not a directory (os error 20)"))
    }
    if is_misnamed(asked.file) {
        return Spoken(misnamed_said(asked.file, AsPage))
    }
    if has_a_split_directory(asked.file) {
        return Spoken(split_said(asked.file))
    }
    started(asked, library)
}

// example: path_of(Explain("L0100")) == ""
fn path_of(command: Command) -> String {
    match command {
        Fmt(file) => file
        Check { path } => path
        Build(path) => path
        Test(file) => file
        Api(file) => file
        Explain(_) => ""
    }
}

// example: !is_a_file_as_a_directory("/")
fn is_a_file_as_a_directory(path: String) -> Bool {
    let place = files.named(path)
    has_trailing_slash(path) && files.is_there(place) && !files.is_directory(place)
}

// example: !is_misnamed("no-such-directory/a.lm")
// example: !is_misnamed("")
fn is_misnamed(path: String) -> Bool {
    let place = files.named(path)
    files.is_there(place) && !files.is_directory(place) && !modules.is_a_module_name(modules.last_part(path))
}

// The name is wrong and the text is not, so the diagnostic points at the start of the file.
// example: misnamed_said("no-such-directory/a.lm", AsPage).errors == "error[L0605]: `a.lm` is not a Bux source, because its name does not end in `.bx`\n  --> no-such-directory/a.lm:1:1\n\n  1 | \n    | ^\n\nhelp: rename the file to `a.bx`\n"
// example: misnamed_said("no-such-directory/a.lm", AsData).status == 1
fn misnamed_said(path: String, form: Form) -> Said {
    let name = modules.last_part(path)
    let diagnostic = Diagnostic { code: "L0605", message: "`" + name + "` is not a Bux source, because its name does not end in `.bx`", span: lexer.Span { start: 0, length: 0 }, help: Some("rename the file to `" + modules.stem_of(name) + ".bx`"), fix: None }
    refused_in_form(Refusal { diagnostics: [diagnostic], page: Page { source: ok_or(files.read(path), ""), path: path } }, form)
}

// example: form_asked(Check { path: "a.bx", form: AsData }) == AsData
// example: form_asked(Build("a.bx")) == AsPage
fn form_asked(command: Command) -> Form {
    match command {
        Check { form } => form
        _ => AsPage
    }
}

// The program uses the streams of this process, so its output does not pass through here.
// example: said_by(Spoken(nothing_said())).status == 0
fn said_by(answer: Answer) -> Said {
    match answer {
        Spoken(said) => said
        Starts(line) => program_ended(line)
    }
}

// example: program_ended(["no-such-program-at-all"]).status == 2
fn program_ended(line: List<String>) -> Said {
    let builder = programs.of_command(line)
    cleared(builder)
    match programs.started(programs.inheriting(builder)) {
        Ok(ran) => Said { output: "", errors: "", status: ok_or(programs.waited_for(ran), 2) }
        Err(why) => unusable(or(list.at(line, 0), "") + ": " + why)
    }
}

// example: command_said(Explain("L9999"), ir.little_library()).errors == "error: there is no diagnostic L9999\n"
fn command_said(command: Command, library: ir.Library) -> Said {
    match command {
        Fmt(file) => formatted(file, library.prelude.names)
        Check { path, form } => checked_said(Checking { path: path, form: form }, library)
        Build(path) => built_said(path, library)
        Test(file) => tested(file, library)
        Api(file) => surface_said(file, library)
        Explain(code) => explained(code)
    }
}

// example: formatted("no-such-directory/main.bx", ir.little_library().prelude.names).errors == "error: no-such-directory/main.bx: No such file or directory (os error 2)\n"
fn formatted(path: String, names: resolver.Prelude) -> Said {
    match files.read(path) {
        Ok(source) => source_formatted(Page { source: source, path: path }, names)
        Err(_) => unusable(path + ": " + read_refusal(path))
    }
}

// example: source_formatted(Page { source: "fn (", path: "a.bx" }, ir.little_library().prelude.names).status == 1
fn source_formatted(page: Page, names: resolver.Prelude) -> Said {
    match repaired(page.source, names) {
        Ok(canonical) => rewritten(page, canonical)
        Err(error) => refused_each([parse_diagnostic(error)], page)
    }
}

// A module that the resolver refuses keeps its order, because `bux build` reports the refusal.
// example: ok_or(repaired("fn one() -> Int {\n    1\n}\n\nfn two() -> Int {\n    one()\n}\n", ir.little_library().prelude.names), "") == "fn two() -> Int {\n    one()\n}\n\nfn one() -> Int {\n    1\n}\n"
// example: ok_or(repaired("fn one() -> Int {\n    missing()\n}\n\nfn two() -> Int {\n    one()\n}\n", ir.little_library().prelude.names), "") == "fn one() -> Int {\n    missing()\n}\n\nfn two() -> Int {\n    one()\n}\n"
fn repaired(source: String, names: resolver.Prelude) -> Result<String, parser.ParseError> {
    let canonical = format.format(source)?
    let parsed = parser.parse(canonical)?
    match resolver.top_down(parsed, names) {
        Ok(ordered) => Ok(format.reordered(canonical, ordered))
        Err(_) => Ok(canonical)
    }
}

// example: rewritten(Page { source: "a", path: "no-such-directory/a.bx" }, "a").status == 0
fn rewritten(page: Page, canonical: String) -> Said {
    if canonical == page.source {
        return nothing_said()
    }
    match files.write(page.path, canonical) {
        Ok(_) => nothing_said()
        Err(_) => unusable(page.path + ": " + write_refusal(page.path))
    }
}

// example: checked_said(Checking { path: "no-such-directory/a.bx", form: AsPage }, ir.little_library()).status == 2
fn checked_said(checking: Checking, library: ir.Library) -> Said {
    if files.is_directory(files.named(checking.path)) {
        return across(checking.path, CheckingAs(checking.form), library)
    }
    match checked(checking.path, library) {
        Ok(_) => nothing_said()
        Err(not) => not_compiled_said(not, checking.form)
    }
}

// example: built_said("no-such-directory/a.bx", ir.little_library()).status == 2
fn built_said(path: String, library: ir.Library) -> Said {
    if files.is_directory(files.named(path)) {
        return across(path, Building, library)
    }
    match built(path, library) {
        Ok(_) => nothing_said()
        Err(said) => said
    }
}

// A refusal of the layout of the package is shown in the form the command asks for, as a
// refusal of one of its modules is.
// example: across("no-such-directory", Building, ir.little_library()).errors == "error: no-such-directory: there is no package here, which is a directory holding `bux.package`\n"
fn across(directory: String, over: Over, library: ir.Library) -> Said {
    match package_found(directory) {
        Ok(paths) => every_module_said(paths, over, library)
        Err(not) => not_compiled_said(not, form_over(over))
    }
}

// example: form_over(CheckingAs(AsData)) == AsData
// example: form_over(Building) == AsPage
fn form_over(over: Over) -> Form {
    match over {
        CheckingAs(form) => form
        Building => AsPage
    }
}

// example: every_module_said([], Building, ir.little_library()).status == 0
fn every_module_said(paths: List<String>, over: Over, library: ir.Library) -> Said {
    for path in paths {
        let said = module_said(path, over, library)
        if said.status != 0 {
            return said
        }
    }
    nothing_said()
}

// example: module_said("no-such-directory/a.bx", Building, ir.little_library()).status == 2
fn module_said(path: String, over: Over, library: ir.Library) -> Said {
    match over {
        CheckingAs(form) => checked_said(Checking { path: path, form: form }, library)
        Building => built_said(path, library)
    }
}

// The program compiles before the search for the JDK.
// So a machine without a JDK still reports a program that does not compile.
// example: said_by(started(Started { file: "no-such-directory/a.bx", arguments: [] }, ir.little_library())).status == 2
fn started(asked: Started, library: ir.Library) -> Answer {
    match built(asked.file, library) {
        Ok(done) => built_started(done, asked)
        Err(said) => Spoken(said)
    }
}

// example: said_by(built_started(Built { module: "a", target: "", archives: [], starts: false }, Started { file: "a.bx", arguments: [] })).errors == "error: a.bx: a module is run through `fn main(arguments: List<String>) -> Int`, which this one does not declare\n"
fn built_started(done: Built, asked: Started) -> Answer {
    if !done.starts {
        return Spoken(unusable(asked.file + ": a module is run through `fn main(arguments: List<String>) -> Int`, which this one does not declare"))
    }
    match java_found() {
        Ok(java) => Starts(program_line(java: java, classes: all_of(values: [done.target], more: done.archives), module: done.module, arguments: asked.arguments))
        Err(said) => Spoken(said)
    }
}

// example: is_refused(built("no-such-directory/a.bx", ir.little_library()))
fn built(path: String, library: ir.Library) -> Result<Built, Said> {
    let program = page_said(checked(path, library))?
    let module = named_module(program.root.module.path)?
    let lowered = page_said(lowered_of(program, library))?
    let classes = page_said(written_of(lowered, program))?
    let reached = page_said(archives_of(path))?
    let target = target_of(path)
    _ = written_whole(classes, target)?
    Ok(Built { module: module, target: target, archives: reached, starts: is_a_program(lowered) })
}

// example: is_refused(Err(nothing_said()))
private fn is_refused<T>(answer: Result<T, Said>) -> Bool {
    match answer {
        Ok(_) => false
        Err(_) => true
    }
}

// example: is_refused(page_said(Err(Unusable("error: gone\n"))))
fn page_said<T>(answer: Result<T, NotCompiled>) -> Result<T, Said> {
    match answer {
        Ok(value) => Ok(value)
        Err(not) => Err(not_compiled_said(not, AsPage))
    }
}

// The named module lowers last, and its class is the first class that it writes.
// A JVM starts a class with a `String[]`, so `main` must take the arguments as one.
// example: !is_a_program([])
fn is_a_program(lowered: List<ir.Lowered>) -> Bool {
    match list.at(lowered, list.length(lowered) - 1) {
        Some(module) => has_main(module.classes)
        None => false
    }
}

// example: !has_main([])
fn has_main(classes: List<ir.Class>) -> Bool {
    match list.at(classes, 0) {
        Some(class) => has_starting_method(class.methods)
        None => false
    }
}

// example: !has_starting_method([])
fn has_starting_method(methods: List<ir.Method>) -> Bool {
    for method in methods {
        if ir.is_started_at(method) {
            return true
        }
    }
    false
}

// example: tested("no-such-directory/a.bx", ir.little_library()).status == 2
fn tested(path: String, library: ir.Library) -> Said {
    if has_a_split_archive(path) {
        return split_said(path)
    }
    if files.is_directory(files.named(path)) {
        return package_tested(path, library)
    }
    reported(module_tested(path, Typing { library: library, memo: no_memo() }).tried)
}

// `test` writes classes to its own directory, so only an archive puts the package on a class path.
// example: !has_a_split_archive("no-such-directory:a/main.bx")
fn has_a_split_archive(path: String) -> Bool {
    for one in ok_or(modules.archives_reached(package_directory_of(path)), []) {
        if modules.can_split_the_class_path(one.file) {
            return true
        }
    }
    false
}

// `run` puts the `target/` of the package of the module on a class path, which reads a `:` as the
// end of one path. A path that names nothing is refused when it is read.
// example: !has_a_split_directory("no-such-directory:a/main.bx")
fn has_a_split_directory(path: String) -> Bool {
    files.is_there(files.named(path)) && modules.can_split_the_class_path(modules.package_directory(path))
}

// The directory is wrong and the text is not, so the diagnostic points at the start of the file.
// example: split_said("no-such-directory:a/main.bx").errors == "error[L0610]: `no-such-directory:a` holds `:`, which a class path reads as two paths\n  --> no-such-directory:a/main.bx:1:1\n\n  1 | \n    | ^\n\nhelp: move the module to a directory whose path holds no `:`\n"
fn split_said(path: String) -> Said {
    let diagnostic = Diagnostic { code: "L0610", message: "`" + package_directory_of(path) + "` holds `:`, which a class path reads as two paths", span: lexer.Span { start: 0, length: 0 }, help: Some("move the module to a directory whose path holds no `:`"), fix: None }
    refused_each([diagnostic], Page { source: ok_or(files.read(path), ""), path: path })
}

// example: package_directory_of("no-such-directory/main.bx") == "no-such-directory"
fn package_directory_of(path: String) -> String {
    if files.is_directory(files.named(path)) {
        return path
    }
    modules.package_directory(path)
}

// A refused module does not stop the run, so one report names each module that fails.
// example: package_tested("no-such-directory", ir.little_library()).status == 2
fn package_tested(directory: String, library: ir.Library) -> Said {
    match package_found(directory) {
        Ok(paths) => reported(every_module_tested(paths, library, pool_size()))
        Err(not) => not_compiled_said(not, AsPage)
    }
}

// Half the processors, because a pool of one worker for each processor was slower on 2026-09-24.
// `docs/implementation.md` section 7, "The share of the machine", records the measurement.
// example: pool_size() > 0
fn pool_size() -> Int {
    or((environment.processors() + 1) / 2, 1)
}

// The layout is held before any module is, so a stray file is refused where no module reaches it.
// example: is_refused(page_said(package_found("no-such-directory")))
fn package_found(directory: String) -> Result<List<String>, NotCompiled> {
    if !modules.has_manifest(directory) {
        return Err(Unusable("error: " + directory + ": there is no package here, which is a directory holding `bux.package`\n"))
    }
    match modules.layout_held(directory) {
        Ok(_) => in_both_parts(directory)
        Err(not) => Err(not_loaded(not))
    }
}

// example: list.length(ok_or(in_both_parts("no-such-directory"), ["x"])) == 0
fn in_both_parts(directory: String) -> Result<List<String>, NotCompiled> {
    let sources = modules_of(modules.joined(directory, "src"))?
    let tests = modules_of(modules.joined(directory, "tests"))?
    Ok(all_of(values: sources, more: tests))
}

// example: list.length(ok_or(modules_of("no-such-directory/src"), ["x"])) == 0
fn modules_of(part: String) -> Result<List<String>, NotCompiled> {
    match modules.listing(part) {
        Ok(names) => Ok(module_paths(directory: part, names: names))
        Err(not) => Err(not_loaded(not))
    }
}

// example: module_paths(directory: "a", names: ["b.bx", "c.txt"]) == ["a/b.bx"]
fn module_paths(directory: String, names: List<String>) -> List<String> {
    var paths = []
    for name in names {
        if modules.is_a_module_name(name) {
            paths = list.push(paths, modules.joined(directory, name))
        }
    }
    paths
}

// A pool of `workers` workers hands each module to the next free worker. Each worker is waited
// for before the pool, so a JVM error that stops a worker stops the command with it.
// example: every_module_tested([], ir.little_library(), 2).said.status == 0
fn every_module_tested(paths: List<String>, library: ir.Library, workers: Int) -> Tried {
    let pooling = spawn Pool(paths, workers)
    var working = []
    for list.length(working) < workers {
        let worker = spawn Worker(pooling, library)
        _ = send(pooling, Joined(worker), NoLimit)
        working = list.push(working, worker)
    }
    for worker in working {
        _ = ended(worker)
    }
    in_file_order(paths, ended(pooling).answers)
}

// A module without an answer is a refusal of the command.
// The pool ends only when each worker leaves, so it never gives that refusal.
// example: in_file_order(["a.bx"], map.empty()).said.errors == "error: a.bx: no worker gave an answer\n"
fn in_file_order(paths: List<String>, answers: map.Map<Int, Tried>) -> Tried {
    var found = only_said(nothing_said())
    var number = 0
    for path in paths {
        found = tried_both(first: found, second: or(map.get(answers, number), only_said(unusable(path + ": no worker gave an answer"))))
        number += 1
    }
    found
}

process Pool {
    fn start(paths: List<String>, workers: Int) -> Pooling {
        Pooling { paths: paths, handed: 0, answers: map.empty(), workers: workers }
    }

    fn receive(pooling: Pooling, message: Pooled) -> Next<Pooling> {
        match message {
            Joined(worker) => Continue(handed_to(pooling, worker))
            Finished(answer, worker) => Continue(answer_kept(pooling, answer, worker))
            Left => worker_left(pooling)
        }
    }
}

// example: every_module_tested(["no-such-directory/a.bx", "no-such-directory/b.bx"], ir.little_library(), 2).said.errors == "error: no-such-directory/a.bx: No such file or directory (os error 2)\n\nerror: no-such-directory/b.bx: No such file or directory (os error 2)\n"
fn answer_kept(pooling: Pooling, answer: Answered, worker: Process<Work, Working>) -> Pooling {
    handed_to(pooling { answers: map.insert(pooling.answers, answer.number, answer.tried) }, worker)
}

// example: every_module_tested(["no-such-directory/a.bx"], ir.little_library(), 2).said.status == 2
fn handed_to(pooling: Pooling, worker: Process<Work, Working>) -> Pooling {
    match list.at(pooling.paths, pooling.handed) {
        Some(path) => handed_module(pooling, Handed { number: pooling.handed, path: path, worker: worker })
        None => stopped(pooling, worker)
    }
}

// example: every_module_tested(["no-such-directory/a.bx", "no-such-directory/b.bx"], ir.little_library(), 2).said.status == 2
fn handed_module(pooling: Pooling, handed: Handed) -> Pooling {
    _ = send(handed.worker, Give(handed), NoLimit)
    pooling { handed: pooling.handed + 1 }
}

// example: every_module_tested([], ir.little_library(), 2).said.status == 0
fn stopped(pooling: Pooling, worker: Process<Work, Working>) -> Pooling {
    _ = send(worker, Stop, NoLimit)
    pooling
}

// example: every_module_tested([], ir.little_library(), 2).said.output == ""
fn worker_left(pooling: Pooling) -> Next<Pooling> {
    if pooling.workers == 1 {
        return Done
    }
    Continue(pooling { workers: pooling.workers - 1 })
}

// The memo goes from one module to the next, so the worker types each imported module once.
process Worker {
    fn start(pool: Process<Pooled, Pooling>, library: ir.Library) -> Working {
        Working { pool: pool, typing: Typing { library: library, memo: no_memo() } }
    }

    fn receive(working: Working, message: Work) -> Next<Working> {
        match message {
            Give(handed) => Continue(worked(working, handed))
            Stop => quit(working)
        }
    }
}

// example: every_module_tested(["no-such-directory/a.bx"], ir.little_library(), 2).said.errors == "error: no-such-directory/a.bx: No such file or directory (os error 2)\n"
fn worked(working: Working, handed: Handed) -> Working {
    let ran = module_tested(handed.path, working.typing)
    _ = send(working.pool, Finished(Answered { number: handed.number, tried: ran.tried }, handed.worker), NoLimit)
    let typing = working.typing
    working { typing: typing { memo: ran.memo } }
}

// example: every_module_tested([], ir.little_library(), 2).said.errors == ""
fn quit(working: Working) -> Next<Working> {
    _ = send(working.pool, Left, NoLimit)
    Done
}

// example: module_tested("no-such-directory/a.bx", Typing { library: ir.little_library(), memo: no_memo() }).tried.said.status == 2
fn module_tested(path: String, typing: Typing) -> Tested {
    let loaded = checked_once(path, typing.library, typing.memo)
    match loaded.found {
        Ok(program) => program_tested(program, typing { memo: loaded.memo })
        Err(not) => Tested { tried: only_said(not_compiled_said(not, AsPage)), memo: loaded.memo }
    }
}

// example: reported(Tried { said: nothing_said(), tests: 2, examples: 1, failed: 1 }).errors == "test: 2 tests, 1 examples; 1 failed\n"
// example: reported(Tried { said: nothing_said(), tests: 2, examples: 1, failed: 0 }).errors == ""
fn reported(tried: Tried) -> Said {
    if tried.failed == 0 {
        return tried.said
    }
    let counted = "test: " + shown(tried.tests) + " tests, " + shown(tried.examples) + " examples; " + shown(tried.failed) + " failed\n"
    let said = tried.said
    said { errors: said.errors + counted }
}

// example: tried_both(first: only_said(unusable("gone")), second: only_said(nothing_said())).said.status == 2
// example: tried_both(first: only_said(unusable("a")), second: only_said(unusable("b"))).said.errors == "error: a\n\nerror: b\n"
fn tried_both(first: Tried, second: Tried) -> Tried {
    var between = ""
    if first.said.errors != "" && second.said.errors != "" {
        between = "\n"
    }
    let said = Said { output: first.said.output + second.said.output, errors: first.said.errors + between + second.said.errors, status: larger(one: first.said.status, other: second.said.status) }
    Tried { said: said, tests: first.tests + second.tests, examples: first.examples + second.examples, failed: first.failed + second.failed }
}

// example: program_tested(Checked { modules: [], root: Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") } }, Typing { library: ir.little_library(), memo: no_memo() }).tried.said.status == 0
fn program_tested(program: Checked, typing: Typing) -> Tested {
    let root = program.root
    match stated_in(root, ast.tests_of(root.inferred.resolved.program)) {
        Ok(found) => run_held(found, root, typing)
        Err(refusals) => Tested { tried: only_said(refused_each(refusals, page_of(root))), memo: typing.memo }
    }
}

// example: run_held(None, Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }, Typing { library: ir.little_library(), memo: no_memo() }).tried.said.status == 0
fn run_held(found: Option<Run>, root: Typed, typing: Typing) -> Tested {
    match found {
        Some(run) => examples_held(run, root, typing)
        None => Tested { tried: only_said(nothing_said()), memo: typing.memo }
    }
}

// `tests/documented.bx` gives no tests for `tests/spec`, because a golden answer holds them.
// example: is_none_run(stated_in(Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }, []))
fn stated_in(root: Typed, tests: List<ast.TestDeclaration>) -> Result<Option<Run>, List<Diagnostic>> {
    let source = root.module.source
    let program = root.inferred.resolved.program
    let stated = stated_by(source, program)?
    if list.length(stated) == 0 && list.length(tests) == 0 {
        return Ok(None)
    }
    match run_of(Page { source: source, path: root.module.path }, program, Trying { examples: stated, tests: tests }) {
        Ok(run) => Ok(Some(run))
        Err(reached) => Err([reached])
    }
}

// example: is_none_run(Ok(None))
private fn is_none_run(found: Result<Option<Run>, List<Diagnostic>>) -> Bool {
    match found {
        Ok(None) => true
        _ => false
    }
}

// The classes go to a directory of the run's own, so the run touches nothing that a build wrote.
// Each imported module goes there too, because the run reaches it as the module does.
// example: examples_held(Run { source: "", stretches: [], examples: [], tests: [], module: lexer.Span { start: 0, length: 0 } }, Typed { module: modules.Module { name: "main", path: "a.b.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }, Typing { library: ir.little_library(), memo: no_memo() }).tried.said.status == 2
fn examples_held(run: Run, root: Typed, typing: Typing) -> Tested {
    match named_module(root.module.path) {
        Ok(module) => named_held(module, run, root, typing)
        Err(said) => Tested { tried: only_said(said), memo: typing.memo }
    }
}

// example: named_held("main", Run { source: "fn (", stretches: [], examples: [], tests: [], module: lexer.Span { start: 0, length: 0 } }, Typed { module: modules.Module { name: "main", path: "no-such-directory/main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }, Typing { library: ir.little_library(), memo: no_memo() }).tried.said.status == 1
fn named_held(module: String, run: Run, root: Typed, typing: Typing) -> Tested {
    let classes = run_classes_once(run, root, typing.library, typing.memo)
    Tested { tried: settled(classes_held(Named { module: module, classes: classes.found }, run, root)), memo: classes.memo }
}

// example: settled(Err(nothing_said())).said.status == 0
fn settled(answer: Result<Tried, Said>) -> Tried {
    match answer {
        Ok(tried) => tried
        Err(said) => only_said(said)
    }
}

// example: is_refused(classes_held(Named { module: "main", classes: Err(Unusable("")) }, Run { source: "", stretches: [], examples: [], tests: [], module: lexer.Span { start: 0, length: 0 } }, Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }))
fn classes_held(named: Named, run: Run, root: Typed) -> Result<Tried, Said> {
    let classes = refusing(named.classes, run, root)?
    let reached = refusing(archives_of(root.module.path), run, root)?
    let java = java_found()?
    let beside = somewhere_of_its_own()?
    let tried = ran_in(Beside { java: java, module: named.module, beside: beside, archives: reached }, classes, run, root)
    removed_whole(beside)
    Ok(tried)
}

// example: list.length(ok_or(page_said(archives_of("no-such-directory/a.bx")), ["x"])) == 0
fn archives_of(path: String) -> Result<List<String>, NotCompiled> {
    archive_said(archives.reached(modules.package_directory(path)))
}

// A module of a package writes into the `target/` beside the manifest, and a module in no
// package into the `target/` beside itself. No class lands beside a source, and deleting this
// directory is a clean build.
// example: target_of("no-such-directory/src/main.bx") == "no-such-directory/src/target"
fn target_of(path: String) -> String {
    modules.joined(modules.package_directory(path), "target")
}

// example: ok_or(java_found(), "") != "java"
fn java_found() -> Result<String, Said> {
    let home = or(environment.read("JAVA_HOME"), "")
    if home == "" {
        return Err(unusable("JAVA_HOME is not set, and running a program needs the JDK it names"))
    }
    let java = modules.joined(modules.joined(home, "bin"), "java")
    if !files.is_file(files.named(java)) {
        return Err(unusable(java + ": JAVA_HOME names no JDK"))
    }
    Ok(java)
}

// The class takes the name of the file, and a JVM refuses to load a class with a bad name.
// example: ok_or(named_module("a/b.bx"), "") == "b"
// example: is_refused(named_module("a.b.bx"))
fn named_module(path: String) -> Result<String, Said> {
    let stem = modules.stem_of(path)
    if stem == "" || has_unit_of(stem, [46, 59, 91, 47]) {
        return Err(unusable(path + ": a module is named by its file, and a class name holds none of ['.', ';', '[', '/']"))
    }
    Ok(stem)
}

// example: has_unit_of("a;b", [59])
fn has_unit_of(text: String, units: List<Int>) -> Bool {
    var index = 0
    for index < strings.length(text) {
        if list.has_value(units, or(strings.at(text, index), 0)) {
            return true
        }
        index += 1
    }
    false
}

// The run has the path of the module under test but not its text, so the run is typed again.
// example: !is_refused(page_said(run_classes_once(Run { source: "", stretches: [], examples: [], tests: [], module: lexer.Span { start: 0, length: 0 } }, Typed { module: modules.Module { name: "main", path: "no-such-directory/main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }, ir.little_library(), no_memo()).found))
fn run_classes_once(run: Run, root: Typed, library: ir.Library, memo: Memo) -> Memoed<List<jvm.ClassFile>> {
    let written = written_once(Page { source: run.source, path: root.module.path }, library, memo)
    match written.found {
        Ok(program) => classes_once(program, library, written.memo)
        Err(not) => Memoed { found: Err(not), memo: written.memo }
    }
}

// A refusal of the run's own module points into text that the compiler wrote.
// So this function moves it back to the file that the author wrote.
// example: !is_refused(refusing(Ok(1), Run { source: "", stretches: [], examples: [], tests: [], module: lexer.Span { start: 0, length: 0 } }, Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }))
fn refusing<T>(answer: Result<T, NotCompiled>, run: Run, root: Typed) -> Result<T, Said> {
    match answer {
        Ok(value) => Ok(value)
        Err(not) => Err(run_refused(not, run, root))
    }
}

// example: run_refused(Unusable("error: gone\n"), Run { source: "", stretches: [], examples: [], tests: [], module: lexer.Span { start: 0, length: 0 } }, Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }).status == 2
fn run_refused(not: NotCompiled, run: Run, root: Typed) -> Said {
    match not {
        Unusable(errors) => Said { output: "", errors: errors, status: 2 }
        Refused(refused) => put_back(refused, run, root)
    }
}

// example: put_back(Refusal { diagnostics: [], page: Page { source: "", path: "b.bx" } }, Run { source: "", stretches: [], examples: [], tests: [], module: lexer.Span { start: 0, length: 0 } }, Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }).status == 1
fn put_back(refused: Refusal, run: Run, root: Typed) -> Said {
    if refused.page.path != root.module.path {
        return refused_each(refused.diagnostics, refused.page)
    }
    var about = []
    for diagnostic in refused.diagnostics {
        about = list.push(about, diagnostic { span: in_original(run, diagnostic.span), fix: None })
    }
    refused_each(about, page_of(root))
}

// example: ran_in(Beside { java: "no-such-java", module: "a", beside: "/dev/null/a", archives: [] }, [], Run { source: "", stretches: [], examples: [], tests: [], module: lexer.Span { start: 0, length: 0 } }, Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }).said.status == 2
fn ran_in(beside: Beside, classes: List<jvm.ClassFile>, run: Run, root: Typed) -> Tried {
    match written_whole(classes, beside.beside) {
        Ok(_) => run_ended(program_finished(examples_line(java: beside.java, classes: all_of(values: [beside.beside], more: beside.archives), module: beside.module)), beside.java, run, root)
        Err(said) => only_said(said)
    }
}

// example: ok_or(program_finished(["no-such-program-at-all"]), programs.Finished { code: 9, output: "", errors: "" }).code == 9
fn program_finished(line: List<String>) -> Result<programs.Finished, String> {
    let builder = programs.of_command(line)
    cleared(builder)
    let ran = programs.started(programs.reading_from(builder, programs.inherited()))?
    let output = programs.whole(programs.output_of(ran))
    let errors = programs.whole(programs.errors_of(ran))
    let code = programs.waited_for(ran)?
    Ok(programs.Finished { code: code, output: output, errors: errors })
}

// example: list.length(program_line(java: "java", classes: ["a"], module: "b", arguments: ["c"])) == 9
// example: or(list.at(program_line(java: "java", classes: ["a"], module: "b", arguments: []), 4), "") == "-Djdk.serialFilter=!*"
// example: or(list.at(program_line(java: "java", classes: ["target", "x.jar"], module: "b", arguments: []), 6), "") == "target:x.jar"
fn program_line(java: String, classes: List<String>, module: String, arguments: List<String>) -> List<String> {
    line_of(java: java, flags: [], classes: classes, module: module, arguments: arguments)
}

// example: list.length(examples_line(java: "java", classes: ["a"], module: "b")) == 11
// example: or(list.at(examples_line(java: "java", classes: ["a"], module: "b"), 5), "") == "-Xmx256m"
fn examples_line(java: String, classes: List<String>, module: String) -> List<String> {
    line_of(java: java, flags: short_run_flags(), classes: classes, module: module, arguments: [])
}

// `bin/bux test` starts hundreds of these JVMs, several at once, so each must take little.
// `docs/specs/run.md` states each flag, and `docs/implementation.md` section 7 its measurement.
// example: list.length(short_run_flags()) == 3
private fn short_run_flags() -> List<String> {
    ["-Xmx256m", "-XX:+UseSerialGC", "-XX:TieredStopAtLevel=1"]
}

// example: list.length(line_of(java: "java", flags: ["-Xmx1m"], classes: ["a"], module: "b", arguments: [])) == 9
private fn line_of(java: String, flags: List<String>, classes: List<String>, module: String, arguments: List<String>) -> List<String> {
    let guarded = all_of(values: [java, "--enable-preview", "--limit-modules", "java.base", "-Djdk.serialFilter=!*"], more: flags)
    all_of(values: guarded, more: all_of(values: ["-cp", strings.join(classes, ":"), module], more: arguments))
}

// Each of these variables can add a `-javaagent` to the program, which `docs/specs/run.md` refuses.
// The builder changes in place, because a foreign reference is never given back.
fn cleared(builder: programs.ProcessBuilder) -> () {
    let variables = programs.variables_of(builder)
    for name in injecting() {
        _ = programs.removed(variables, programs.as_object(programs.held_as_constant(name)))
    }
}

// example: list.length(injecting()) == 3
// example: or(list.at(injecting(), 0), "") == "JAVA_TOOL_OPTIONS"
fn injecting() -> List<String> {
    ["JAVA_TOOL_OPTIONS", "JDK_JAVA_OPTIONS", "_JAVA_OPTIONS"]
}

// A program that calls the compiler reads its resources from the class path, so they go there.
// example: is_refused(written_whole([], "/dev/null/target"))
fn written_whole(classes: List<jvm.ClassFile>, into: String) -> Result<(), Said> {
    _ = classes_written(classes, into)?
    for name in resource_names() {
        _ = directory_copied(from: resource_found(name)?, into: modules.joined(into, name))?
    }
    Ok(())
}

// example: resource_names() == ["library", "help", "explanations"]
fn resource_names() -> List<String> {
    ["library", "help", "explanations"]
}

// example: is_refused(resource_found("no/such/directory"))
fn resource_found(name: String) -> Result<String, Said> {
    match modules.resource_directory(name) {
        Some(directory) => Ok(directory)
        None => Err(unusable(name + ": no entry of the class path of the compiler holds this directory"))
    }
}

// The copy deletes a stale file, so a resource that the checkout removed does not stay readable.
// It copies only resources, so another file, such as one of a file manager, stops no build.
// example: is_refused(directory_copied(from: "no-such-directory", into: "/dev/null/resources"))
// example: !is_refused(directory_copied(from: "src", into: "src/../src"))
fn directory_copied(from: String, into: String) -> Result<(), Said> {
    let names = listed_or_said(from)?
    if is_same_place(one: from, other: into) {
        return Ok(())
    }
    removed_whole(into)
    _ = folder_made(into)?
    for name in names {
        if is_resource_name(name) {
            _ = file_copied(from: modules.joined(from, name), into: modules.joined(into, name))?
        }
    }
    Ok(())
}

// example: is_refused(file_copied(from: "no-such-directory/a.md", into: "/dev/null/a.md"))
fn file_copied(from: String, into: String) -> Result<(), Said> {
    let text = text_or_said(from)?
    if is_refused_write(files.write(into, text)) {
        return Err(unusable(into + ": " + write_refusal(into)))
    }
    Ok(())
}

// example: is_resource_name("list.bx")
// example: is_resource_name("L0100.md")
// example: !is_resource_name(".DS_Store")
// example: !is_resource_name("mycs.toml")
fn is_resource_name(name: String) -> Bool {
    let dot = modules.last_unit(name, 46)
    let extension = or(strings.cut(name, dot + 1, strings.length(name)), "")
    dot > 0 && (extension == "bx" || extension == "md")
}

// example: is_same_place(one: "src", other: "src/../src")
// example: !is_same_place(one: "src", other: "library")
fn is_same_place(one: String, other: String) -> Bool {
    ok_or(files.canonical_path(files.named(one)), one) == ok_or(files.canonical_path(files.named(other)), other)
}

// example: is_refused(listed_or_said("no-such-directory"))
fn listed_or_said(path: String) -> Result<List<String>, Said> {
    match files.listed(path) {
        Ok(names) => Ok(names)
        Err(why) => Err(unusable(path + ": " + why))
    }
}

// example: is_refused(text_or_said("no-such-directory/a.md"))
fn text_or_said(path: String) -> Result<String, Said> {
    match files.read(path) {
        Ok(text) => Ok(text)
        Err(why) => Err(unusable(path + ": " + why))
    }
}

// example: !is_refused(classes_written([], "no-such-directory"))
fn classes_written(classes: List<jvm.ClassFile>, into: String) -> Result<(), Said> {
    for class in classes {
        let written = modules.joined(into, class.path)
        _ = folder_made(modules.directory_of(written))?
        if is_refused_write(files.write_bytes(written, class.bytes)) {
            return Err(unusable(written + ": " + write_refusal(written)))
        }
    }
    Ok(())
}

// example: !is_refused(folder_made("/"))
fn folder_made(path: String) -> Result<(), Said> {
    if !files.is_directory(files.named(path)) && !files.has_made_all(files.named(path)) {
        return Err(unusable(path + ": " + making_refusal(path)))
    }
    Ok(())
}

// example: is_refused_write(Err("gone"))
fn is_refused_write(answer: Result<String, String>) -> Bool {
    match answer {
        Ok(_) => false
        Err(_) => true
    }
}

// A run with a status other than 0 did not try each example, so its output goes on unchanged.
// example: run_ended(Err("gone"), "java", Run { source: "", stretches: [], examples: [], tests: [], module: lexer.Span { start: 0, length: 0 } }, Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }).said.errors == "error: java: gone\n"
fn run_ended(completion: Result<programs.Finished, String>, java: String, run: Run, root: Typed) -> Tried {
    match completion {
        Ok(finished) => finished_read(finished, run, root)
        Err(why) => only_said(unusable(java + ": " + why))
    }
}

// example: finished_read(programs.Finished { code: 1, output: "", errors: "boom\n" }, Run { source: "", stretches: [], examples: [], tests: [], module: lexer.Span { start: 0, length: 0 } }, Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }).said.errors == "boom\n"
fn finished_read(finished: programs.Finished, run: Run, root: Typed) -> Tried {
    if finished.code != 0 {
        return only_said(Said { output: passed_on(finished.output), errors: finished.errors, status: 2 })
    }
    var refusals = []
    var failed = []
    for line in lines_of(finished.output) {
        refusals = match named_in(run, line) {
            Some(example) => list.push(refusals, did_not_hold(example))
            None => refusals
        }
        failed = all_of(values: failed, more: test_named_in(run, line))
    }
    let written = Said { output: passed_on(finished.output), errors: "", status: 0 }
    let tried = Tried { said: written, tests: list.length(run.tests), examples: list.length(run.examples), failed: list.length(refusals) + list.length(failed) }
    if tried.failed == 0 {
        return tried
    }
    var lines = ""
    for stated in failed {
        lines += test_failed(stated, page_of(root))
    }
    var said = written { errors: lines, status: 1 }
    if list.length(refusals) > 0 {
        let refused = refused_each(refusals, page_of(root))
        said = written { errors: refused.errors + lines, status: refused.status }
    }
    tried { said: said }
}

// example: passed_on("bux: test 0\nskipped: a\n") == "skipped: a\n"
fn passed_on(output: String) -> String {
    var passed = ""
    for line in lines_of(output) {
        if !is_a_mark(line) {
            passed += line + "\n"
        }
    }
    passed
}

// example: is_a_mark("bux: example 2")
// example: !is_a_mark("skipped: a")
fn is_a_mark(line: String) -> Bool {
    or(marked_ordinal(line: line, marker: "bux: example "), -1) >= 0 || or(marked_ordinal(line: line, marker: "bux: test "), -1) >= 0
}

// example: only_said(nothing_said()).failed == 0
fn only_said(said: Said) -> Tried {
    Tried { said: said, tests: 0, examples: 0, failed: 0 }
}

// example: test_failed(ast.TestDeclaration { name: ast.Name { text: "a", span: lexer.Span { start: 7, length: 3 } }, body: ast.Block { statements: [], span: lexer.Span { start: 11, length: 2 } }, span: lexer.Span { start: 2, length: 11 } }, Page { source: "\n\ntest \"a\" {}", path: "b.bx" }) == "b.bx:3: test \"a\" did not hold\n"
fn test_failed(stated: ast.TestDeclaration, page: Page) -> String {
    let place = place_of(stated.span, measured_of(page.source))
    page.path + ":" + shown(place.line) + ": test " + ast.quoted(stated.name.text) + " did not hold\n"
}

// example: list.length(lines_of("a\nb\n")) == 2
fn lines_of(text: String) -> List<String> {
    var lines = []
    var start = 0
    var index = 0
    for index < strings.length(text) {
        if or(strings.at(text, index), 0) == 10 {
            lines = list.push(lines, or(strings.cut(text, start, index), ""))
            start = index + 1
        }
        index += 1
    }
    if start < strings.length(text) {
        lines = list.push(lines, or(strings.cut(text, start, strings.length(text)), ""))
    }
    lines
}

// The temporary directory is shared, and a run deletes its own directory whole.
// So a run makes a new directory and never uses one that was there before.
// example: !is_refused(somewhere_of_its_own())
fn somewhere_of_its_own() -> Result<String, Said> {
    let shared = or(environment.read("TMPDIR"), "/tmp")
    let now = clock.nanoseconds()
    var attempt = 0
    for attempt < 16 {
        let beside = modules.joined(shared, "bux-test-" + shown(now) + "-" + shown(attempt))
        if files.make(files.named(beside)) {
            return Ok(beside)
        }
        attempt += 1
    }
    Err(unusable(shared + ": nowhere to write the classes a run starts"))
}

fn removed_whole(path: String) -> () {
    if files.is_directory(files.named(path)) {
        for name in ok_or(files.listed(path), []) {
            removed_whole(modules.joined(path, name))
        }
    }
    _ = files.removed(path)
}

// example: surface_said("no-such-directory/a.bx", ir.little_library()).status == 2
fn surface_said(path: String, library: ir.Library) -> Said {
    match checked(path, library) {
        Ok(program) => Said { output: types.page_of(program.root.inferred), errors: "", status: 0 }
        Err(not) => not_compiled_said(not, AsPage)
    }
}

// example: explained("L9999").status == 2
fn explained(code: String) -> Said {
    match explanation_of(code) {
        Some(text) => Said { output: text, errors: "", status: 0 }
        None => unusable("there is no diagnostic " + code)
    }
}

// Only `L` and four digits is a code, so no other text can reach a resource.
// example: or(explanation_of("../x"), "none") == "none"
fn explanation_of(code: String) -> Option<String> {
    if !is_code_shaped(code) {
        return None
    }
    modules.resource_text("explanations/" + code + ".md")
}

// example: is_code_shaped("L0100")
// example: !is_code_shaped("L01")
fn is_code_shaped(code: String) -> Bool {
    if strings.length(code) != 5 || !has_prefix(text: code, opening: "L") {
        return false
    }
    var index = 1
    for index < 5 {
        if !is_digit(or(strings.at(code, index), 0)) {
            return false
        }
        index += 1
    }
    true
}

// example: not_compiled_said(Unusable("error: gone\n"), AsPage).errors == "error: gone\n"
fn not_compiled_said(not: NotCompiled, form: Form) -> Said {
    match not {
        Unusable(errors) => Said { output: "", errors: errors, status: 2 }
        Refused(refused) => refused_in_form(refused, form)
    }
}

// A check stops at the first refusal, so `--json` has only one diagnostic to write.
// example: refused_in_form(Refusal { diagnostics: [], page: Page { source: "", path: "a.bx" } }, AsData).status == 1
fn refused_in_form(refused: Refusal, form: Form) -> Said {
    match form {
        AsPage => refused_each(refused.diagnostics, refused.page)
        AsData => Said { output: first_as_data(refused), errors: "", status: 1 }
    }
}

// example: first_as_data(Refusal { diagnostics: [], page: Page { source: "", path: "a.bx" } }) == ""
fn first_as_data(refused: Refusal) -> String {
    match list.at(refused.diagnostics, 0) {
        Some(first) => json_of(first, refused.page.path)
        None => ""
    }
}

// A build refuses each diagnostic, not only the first, because a build tells a reader what is left.
// example: refused_each([], Page { source: "", path: "a.bx" }).status == 1
fn refused_each(diagnostics: List<Diagnostic>, page: Page) -> Said {
    var errors = ""
    for diagnostic in diagnostics {
        if errors != "" {
            errors += "\n"
        }
        errors += rendered(diagnostic, page)
    }
    Said { output: "", errors: errors, status: 1 }
}

// example: nothing_said().output == ""
fn nothing_said() -> Said {
    Said { output: "", errors: "", status: 0 }
}

// example: unusable("gone").errors == "error: gone\n"
fn unusable(line: String) -> Said {
    Said { output: "", errors: "error: " + line + "\n", status: 2 }
}

// example: is_refused(page_said(checked("no-such-directory/a.bx", ir.little_library())))
fn checked(path: String, library: ir.Library) -> Result<Checked, NotCompiled> {
    checked_once(path, library, no_memo()).found
}

// A command starts with an empty memo, so what a command says never depends on a memo.
// example: is_refused(page_said(checked_once("no-such-directory/a.bx", ir.little_library(), no_memo()).found))
fn checked_once(path: String, library: ir.Library, memo: Memo) -> Memoed<Checked> {
    let found = loaded_checked(path, library, memo)
    Memoed { found: found, memo: remembered(memo: memo, found: found, form: ToCanonicalForm) }
}

// example: is_refused(page_said(loaded_checked("no-such-directory/a.bx", ir.little_library(), no_memo())))
fn loaded_checked(path: String, library: ir.Library, memo: Memo) -> Result<Checked, NotCompiled> {
    let loaded = loaded_or_refused(modules.load(path))?
    let archived = archived_of(path, loaded)?
    each_accepted(loaded, Accepting { imported: surface.nothing_imported(), form: ToCanonicalForm, archived: archived }, library, memo)
}

// The written module is not in canonical form, so it is held to each rule except canonical form.
// example: !is_refused(page_said(checked_as_written(Page { source: "fn one() -> Int {\n    1\n}\n", path: "no-such-directory/main.bx" }, ir.little_library())))
fn checked_as_written(page: Page, library: ir.Library) -> Result<Checked, NotCompiled> {
    written_once(page, library, no_memo()).found
}

// example: !is_refused(page_said(written_once(Page { source: "fn one() -> Int {\n    1\n}\n", path: "no-such-directory/main.bx" }, ir.little_library(), no_memo()).found))
fn written_once(page: Page, library: ir.Library, memo: Memo) -> Memoed<Checked> {
    let found = loaded_written(page, library, memo)
    Memoed { found: found, memo: remembered(memo: memo, found: found, form: AsWritten) }
}

// example: !is_refused(page_said(loaded_written(Page { source: "fn one() -> Int {\n    1\n}\n", path: "no-such-directory/main.bx" }, ir.little_library(), no_memo())))
fn loaded_written(page: Page, library: ir.Library, memo: Memo) -> Result<Checked, NotCompiled> {
    let loaded = loaded_or_refused(modules.load_written(page.source, page.path))?
    let archived = archived_of(page.path, loaded)?
    each_accepted(loaded, Accepting { imported: surface.nothing_imported(), form: AsWritten, archived: archived }, library, memo)
}

// example: set.has_value(ok_or(archived_of("no-such-directory/a.bx", []), set.insert(set.empty(), "x")), "x") == false
fn archived_of(path: String, loaded: List<modules.Module>) -> Result<set.Set<String>, NotCompiled> {
    var named = []
    for module in loaded {
        for class in boundary.classes_outside(module.program) {
            named = list.push(named, class)
        }
    }
    archive_said(archives.classes_held(modules.package_directory(path), named))
}

// example: list.length(ok_or(archive_said(Ok([])), ["x"])) == 0
fn archive_said<T>(answer: Result<T, archives.Unreached>) -> Result<T, NotCompiled> {
    match answer {
        Ok(found) => Ok(found)
        Err(archives.Unread(not)) => Err(not_loaded(not))
        Err(archives.Refused { manifest, error }) => Err(Refused(Refusal { diagnostics: [archive_diagnostic(error)], page: Page { source: manifest.source, path: manifest.path } }))
    }
}

// example: archive_diagnostic(archives.ArchiveError { kind: archives.Missing("x.jar"), span: lexer.Span { start: 0, length: 1 } }).code == "L0606"
fn archive_diagnostic(error: archives.ArchiveError) -> Diagnostic {
    Diagnostic { code: archives.code_of(error.kind), message: archives.message(error.kind), span: error.span, help: help_written(archives.help_of(error.kind)), fix: None }
}

// example: is_refused(page_said(each_accepted([], Accepting { imported: surface.nothing_imported(), form: ToCanonicalForm, archived: set.empty() }, ir.little_library(), no_memo())))
fn each_accepted(loaded: List<modules.Module>, root: Accepting, library: ir.Library, memo: Memo) -> Result<Checked, NotCompiled> {
    var imported = root.imported
    var typed = []
    var index = 0
    for module in loaded {
        index += 1
        var form = ToCanonicalForm
        if index == list.length(loaded) {
            form = root.form
        }
        let inferred = refused_in(accepted_once(module, Accepting { imported: imported, form: form, archived: root.archived }, Typing { library: library, memo: memo }), module)?
        typed = list.push(typed, Typed { module: module, inferred: inferred })
        imported = surface.offering(imported, module.name, types.surface_of(inferred))
    }
    rooted(typed)
}

// example: is_refused(page_said(rooted([])))
fn rooted(typed: List<Typed>) -> Result<Checked, NotCompiled> {
    match list.at(typed, list.length(typed) - 1) {
        Some(root) => Ok(Checked { modules: typed, root: root })
        None => Err(Unusable(""))
    }
}

// example: is_refused(page_said(refused_in(Err(no_diagnostic()), modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } })))
fn refused_in<T>(answer: Result<T, Diagnostic>, module: modules.Module) -> Result<T, NotCompiled> {
    match answer {
        Ok(value) => Ok(value)
        Err(diagnostic) => Err(Refused(Refusal { diagnostics: [diagnostic], page: Page { source: module.source, path: module.path } }))
    }
}

// example: is_refused(page_said(loaded_or_refused(Err(modules.Unreadable { path: "no-such-directory/a.bx", why: "" }))))
fn loaded_or_refused(answer: Result<List<modules.Module>, modules.NotLoaded>) -> Result<List<modules.Module>, NotCompiled> {
    match answer {
        Ok(loaded) => Ok(loaded)
        Err(not) => Err(not_loaded(not))
    }
}

// example: not_compiled_said(not_loaded(modules.Unreadable { path: "no-such-directory/a.bx", why: "" }), AsPage).errors == "error: no-such-directory/a.bx: No such file or directory (os error 2)\n"
fn not_loaded(not: modules.NotLoaded) -> NotCompiled {
    match not {
        modules.Unreadable { path } => Unusable("error: " + path + ": " + read_refusal(path) + "\n")
        modules.Unparsed { path, source, error } => Refused(Refusal { diagnostics: [parse_diagnostic(error)], page: Page { source: source, path: path } })
        modules.Refused { path, source, error } => Refused(Refusal { diagnostics: [load_diagnostic(error)], page: Page { source: source, path: path } })
    }
}

// Only a module in canonical form is in the memo, and an inference is used only for the same text.
// example: code_refused(accepted_once(modules.Module { name: "main", path: "main.bx", source: "fn (", program: ast.Program { items: [] } }, Accepting { imported: surface.nothing_imported(), form: AsWritten, archived: set.empty() }, Typing { library: ir.little_library(), memo: no_memo() })) == ""
fn accepted_once(module: modules.Module, accepting: Accepting, typing: Typing) -> Result<infer.Inference, Diagnostic> {
    var found = None
    if accepting.form == ToCanonicalForm {
        found = map.get(typing.memo.typed, key_of(module))
    }
    match found {
        Some(one) => if one.module.source == module.source {
            Ok(one.inferred)
        } else {
            accepted(module, accepting, typing.library)
        }
        None => accepted(module, accepting, typing.library)
    }
}

// example: code_refused(accepted(modules.Module { name: "main", path: "main.bx", source: "fn (", program: ast.Program { items: [] } }, Accepting { imported: surface.nothing_imported(), form: ToCanonicalForm, archived: set.empty() }, ir.little_library())) == "L0100"
fn accepted(module: modules.Module, accepting: Accepting, library: ir.Library) -> Result<infer.Inference, Diagnostic> {
    if accepting.form == ToCanonicalForm {
        _ = in_canonical_form(module.source)?
    }
    let resolved = resolved_of(resolved_in(module, library.prelude.names))?
    let inferred = inferred_of(types.check(resolved, accepting.imported, types.with_archived(library.prelude, accepting.archived)))?
    _ = exhaustive(exhaustiveness.check(inferred))?
    Ok(inferred)
}

// Only an unread import can change because of the examples, so the second lex is only for it.
// example: resolver.answer_printed(resolved_in(modules.Module { name: "main", path: "main.bx", source: "import io\n\n// example: io.shown(1) == \"1\"\nfn f() -> Int {\n    1\n}\n", program: ok_or(parser.parse("import io\n"), ast.Program { items: [] }) }, ir.little_library().prelude.names)) == "resolved\n7..9 value module declared 7..9\n"
fn resolved_in(module: modules.Module, names: resolver.Prelude) -> Result<resolver.Resolved, resolver.ResolveError> {
    match resolver.resolve(module.program, module.name, names, set.empty()) {
        Ok(resolved) => Ok(resolved)
        Err(refused) => if resolver.code_of(refused.kind) == "L0320" {
            resolver.resolve(module.program, module.name, names, examples_read(module.source))
        } else {
            Err(refused)
        }
    }
}

// An example compiles in the scope of the module, so an import that only an example uses is read.
// example: set.has_value(examples_read("// example: list.length([]) == 0\n"), "list")
// example: set.has_value(examples_read("// list.length([]) == 0\n"), "list") == false
fn examples_read(source: String) -> set.Set<String> {
    var read = set.empty()
    for comment in commented_of(source).comments {
        read = with_modules_written(read, or(stated_at(comment.text), ""))
    }
    read
}

// example: code_refused(Err(no_diagnostic())) == "L0000"
private fn code_refused<T>(answer: Result<T, Diagnostic>) -> String {
    match answer {
        Ok(_) => ""
        Err(diagnostic) => diagnostic.code
    }
}

// example: code_refused(in_canonical_form("import files\n\nimport io\n")) == "L0200"
fn in_canonical_form(source: String) -> Result<(), Diagnostic> {
    match format.check(source) {
        Ok(_) => Ok(())
        Err(refused) => Err(check_diagnostic(refused, source))
    }
}

// example: code_refused(resolved_of(resolver.resolve(ast.Program { items: [] }, "main", types.little_prelude().names, set.empty()))) == ""
fn resolved_of(answer: Result<resolver.Resolved, resolver.ResolveError>) -> Result<resolver.Resolved, Diagnostic> {
    match answer {
        Ok(resolved) => Ok(resolved)
        Err(error) => Err(Diagnostic { code: resolver.code_of(error.kind), message: resolver.message(error.kind), span: error.span, help: help_written(resolver.help_of(error.kind)), fix: None })
    }
}

// example: code_refused(inferred_of(Ok(types.checked_of("")))) == ""
fn inferred_of(answer: Result<infer.Inference, refusal.TypeError>) -> Result<infer.Inference, Diagnostic> {
    match answer {
        Ok(inferred) => Ok(inferred)
        Err(error) => Err(Diagnostic { code: refusal.code_of(error.kind), message: refusal.message(error.kind), span: error.span, help: help_written(refusal.help_of(error.kind)), fix: None })
    }
}

// example: code_refused(exhaustive(Ok(()))) == ""
fn exhaustive(answer: Result<(), exhaustiveness.MatchError>) -> Result<(), Diagnostic> {
    match answer {
        Ok(_) => Ok(())
        Err(error) => Err(Diagnostic { code: exhaustiveness.code_of(error), message: exhaustiveness.message_of(error), span: exhaustiveness.span_of(error), help: help_written(exhaustiveness.help_of(error)), fix: None })
    }
}

// example: parse_diagnostic(parser.ParseError { kind: parser.ChainedComparison, span: lexer.Span { start: 0, length: 1 } }).code == "L0105"
fn parse_diagnostic(error: parser.ParseError) -> Diagnostic {
    Diagnostic { code: parser.code_of(error.kind), message: parser.message(error.kind), span: error.span, help: help_written(parser.help_of(error.kind)), fix: None }
}

// example: load_diagnostic(modules.LoadError { kind: modules.Ring(["main"]), span: lexer.Span { start: 0, length: 1 } }).code == "L0307"
fn load_diagnostic(error: modules.LoadError) -> Diagnostic {
    Diagnostic { code: modules.code_of(error.kind), message: modules.message(error.kind), span: error.span, help: help_written(modules.help_of(error.kind)), fix: None }
}

// Only a refusal of canonical form carries an edit, because only there the compiler knows the fix.
// example: is_fixed(check_diagnostic(format.NotCanonical { deviation: format.Ending(lexer.Span { start: 0, length: 1 }), canonical: "a\n" }, "a"))
fn check_diagnostic(refused: format.CheckError, source: String) -> Diagnostic {
    Diagnostic { code: format.code_of(refused), message: format.message_of(refused), span: format.span_of(refused), help: help_written(format.help_of(refused)), fix: fix_of(refused, source) }
}

// example: !is_fixed(no_diagnostic())
private fn is_fixed(diagnostic: Diagnostic) -> Bool {
    match diagnostic.fix {
        Some(_) => true
        None => false
    }
}

// example: is_fixed(Diagnostic { code: "", message: "", span: lexer.Span { start: 0, length: 0 }, help: None, fix: fix_of(format.NotCanonical { deviation: format.ExtraLine(lexer.Span { start: 0, length: 1 }), canonical: "a\n" }, "a") })
fn fix_of(refused: format.CheckError, source: String) -> Option<Fix> {
    match refused {
        format.NotCanonical { canonical } => Some(Fix { span: lexer.Span { start: 0, length: byte_count(source) }, text: canonical })
        _ => None
    }
}

// example: !is_stated(help_written(""))
fn help_written(help: String) -> Option<String> {
    if help == "" {
        return None
    }
    Some(help)
}

// example: list.length(ok_or(classes_once(Checked { modules: [], root: Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") } }, ir.little_library(), no_memo()).found, [])) > 0
fn classes_once(program: Checked, library: ir.Library, memo: Memo) -> Memoed<List<jvm.ClassFile>> {
    let lowered = lowered_once(program, library, memo)
    match lowered.found {
        Ok(passes) => Memoed { found: written_of(passes, program), memo: lowered.memo }
        Err(not) => Memoed { found: Err(not), memo: lowered.memo }
    }
}

// A build refuses each hole and each example of a module, because a build tells what is left.
// example: list.length(ok_or(lowered_of(Checked { modules: [], root: Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") } }, ir.little_library()), [])) == 1
fn lowered_of(program: Checked, library: ir.Library) -> Result<List<ir.Lowered>, NotCompiled> {
    lowered_once(program, library, no_memo()).found
}

// example: list.length(ok_or(lowered_once(Checked { modules: [], root: Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") } }, ir.little_library(), no_memo()).found, [])) == 1
fn lowered_once(program: Checked, library: ir.Library, memo: Memo) -> Memoed<List<ir.Lowered>> {
    match each_whole(program.modules, memo) {
        Ok(kept) => Memoed { found: Ok(passes_of(program, library)), memo: kept }
        Err(not) => Memoed { found: Err(not), memo: memo }
    }
}

// A run has the path of the module under test but not its text, so a run is never marked whole.
// example: !is_refused(page_said(each_whole([], no_memo())))
fn each_whole(typed: List<Typed>, memo: Memo) -> Result<Memo, NotCompiled> {
    var kept = memo
    for one in turned(typed) {
        if !is_whole_already(one, kept) {
            _ = whole(one)?
            if is_remembered_as(one, kept) {
                kept = kept { whole: set.insert(kept.whole, key_of(one.module)) }
            }
        }
    }
    Ok(kept)
}

// example: !is_whole_already(Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }, no_memo())
fn is_whole_already(one: Typed, memo: Memo) -> Bool {
    is_remembered_as(one, memo) && set.has_value(memo.whole, key_of(one.module))
}

// example: !is_remembered_as(Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }, no_memo())
fn is_remembered_as(one: Typed, memo: Memo) -> Bool {
    match map.get(memo.typed, key_of(one.module)) {
        Some(typed) => typed.module.source == one.module.source
        None => false
    }
}

// example: list.length(passes_of(Checked { modules: [], root: Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") } }, ir.little_library())) == 1
fn passes_of(program: Checked, library: ir.Library) -> List<ir.Lowered> {
    var typed = []
    for one in program.modules {
        typed = list.push(typed, one.inferred)
    }
    ir.passes_lowered(typed, library)
}

// example: !set.has_value(no_memo().whole, "main.bx")
fn no_memo() -> Memo {
    Memo { typed: map.empty(), whole: set.empty() }
}

// A root checked only as written is not the file at its path, so the memo does not keep it.
// example: !is_typed(remembered(memo: no_memo(), found: Err(Unusable("")), form: ToCanonicalForm), "main.bx")
fn remembered(memo: Memo, found: Result<Checked, NotCompiled>, form: RootForm) -> Memo {
    match found {
        Ok(program) => each_remembered(memo: memo, program: program, form: form)
        Err(_) => memo
    }
}

// A module in the memo keeps the text it was typed from, so a mark of `whole` stays true.
// example: !is_typed(each_remembered(memo: no_memo(), program: Checked { modules: [], root: Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") } }, form: AsWritten), "main.bx")
fn each_remembered(memo: Memo, program: Checked, form: RootForm) -> Memo {
    var kept = memo
    var index = 0
    for one in program.modules {
        index += 1
        if (index < list.length(program.modules) || form == ToCanonicalForm) && !is_typed(kept, one.module.path) {
            kept = kept { typed: map.insert(kept.typed, key_of(one.module), one) }
        }
    }
    kept
}

// example: key_of(modules.Module { name: "main", path: "no-such-directory/../main.bx", source: "", program: ast.Program { items: [] } }) != "no-such-directory/../main.bx"
fn key_of(module: modules.Module) -> String {
    modules.route_to(module.path).found
}

// example: !is_typed(no_memo(), "main.bx")
fn is_typed(memo: Memo, path: String) -> Bool {
    match map.get(memo.typed, modules.route_to(path).found) {
        Some(_) => true
        None => false
    }
}

// example: !is_refused(page_said(written_of([], Checked { modules: [], root: Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") } })))
fn written_of(lowered: List<ir.Lowered>, program: Checked) -> Result<List<jvm.ClassFile>, NotCompiled> {
    match jvm.program_written(lowered) {
        Ok(classes) => Ok(classes)
        Err(unwritten) => Err(Refused(unwritten_refused(unwritten, program)))
    }
}

// example: first_of(unwritten_refused(jvm.Unwritten { class: "main", method: Some("f"), why: jvm.TooLarge }, Checked { modules: [], root: Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") } })).code == "L0700"
fn unwritten_refused(unwritten: jvm.Unwritten, program: Checked) -> Refusal {
    let one = owning(program, unwritten.class)
    let diagnostic = Diagnostic { code: jvm.code_of(unwritten.why), message: jvm.message(unwritten), span: declared_span(one, jvm.named_in(unwritten)), help: Some(jvm.help_of(unwritten.why)), fix: None }
    Refusal { diagnostics: [diagnostic], page: page_of(one) }
}

// Where two modules have the name, the last loaded wins, because it is the program's own module.
// example: owning(Checked { modules: [], root: Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") } }, "demo/Box").module.name == "main"
fn owning(program: Checked, class: String) -> Typed {
    var owner = program.root
    for one in program.modules {
        if jvm.module_of(class) == one.module.name {
            owner = one
        }
    }
    owner
}

// example: declared_span(Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }, "f").length == 0
fn declared_span(one: Typed, named: String) -> lexer.Span {
    for function in infer.functions_of(one.module.program) {
        if function.name.text == named {
            return function.name.span
        }
    }
    lexer.Span { start: 0, length: 0 }
}

// example: first_of(Refusal { diagnostics: [], page: Page { source: "", path: "a.bx" } }).code == ""
private fn first_of(refused: Refusal) -> Diagnostic {
    or(list.at(refused.diagnostics, 0), Diagnostic { code: "", message: "", span: lexer.Span { start: 0, length: 0 }, help: None, fix: None })
}

// example: !is_refused(page_said(whole(Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") })))
fn whole(one: Typed) -> Result<(), NotCompiled> {
    let page = page_of(one)
    let found = holes.of_module(one.inferred.resolved)
    if list.length(found) > 0 {
        return Err(Refused(Refusal { diagnostics: holes_refused(found), page: page }))
    }
    match stated_by(page.source, one.inferred.resolved.program) {
        Ok(_) => Ok(())
        Err(refusals) => Err(Refused(Refusal { diagnostics: refusals, page: page }))
    }
}

// example: page_of(Typed { module: modules.Module { name: "main", path: "main.bx", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }).path == "main.bx"
fn page_of(one: Typed) -> Page {
    Page { source: one.module.source, path: one.module.path }
}

// example: list.length(holes_refused([holes.Hole { span: lexer.Span { start: 0, length: 1 } }])) == 1
fn holes_refused(found: List<holes.Hole>) -> List<Diagnostic> {
    var refusals = []
    for hole in found {
        refusals = list.push(refusals, Diagnostic { code: "L0600", message: "this hole is not compiled", span: hole.span, help: Some("`bux check` accepts a hole; fill it in, or build a module that holds none"), fix: None })
    }
    refusals
}

// example: list.length(ok_or(stated_by("private fn f() -> Int {\n    1\n}\n", ok_or(parser.parse("private fn f() -> Int {\n    1\n}\n"), ast.Program { items: [] })), [Example { of: "", expression: "", span: lexer.Span { start: 0, length: 0 } }])) == 0
// example: list.length(ok_or(stated_by("", ast.Program { items: [] }), [])) == 0
fn stated_by(source: String, program: ast.Program) -> Result<List<Example>, List<Diagnostic>> {
    let written = commented_of(source)
    var stated = []
    var refused_none = []
    for function in documented(program) {
        let theirs = examples_of(written, function)
        if list.length(theirs) == 0 && !ast.is_private(function.visibility) {
            refused_none = list.push(refused_none, Diagnostic { code: "L0601", message: "`" + function.name.text + "` states no example", span: function.name.span, help: Some("write `// example: <an expression that is true>` in the comment above it"), fix: None })
        }
        stated = all_of(values: stated, more: theirs)
    }
    let refusals = in_order(first: refused_none, second: documenting_nothing(written, stated))
    if list.length(refusals) > 0 {
        return Err(refusals)
    }
    Ok(stated)
}

// example: list.length(all_of(values: [1], more: [2, 3])) == 3
fn all_of<T>(values: List<T>, more: List<T>) -> List<T> {
    var joined = values
    for value in more {
        joined = list.push(joined, value)
    }
    joined
}

// example: list.length(in_order(first: [no_diagnostic()], second: [no_diagnostic()])) == 2
fn in_order(first: List<Diagnostic>, second: List<Diagnostic>) -> List<Diagnostic> {
    var merged = []
    var left = 0
    var right = 0
    for left < list.length(first) || right < list.length(second) {
        let one = or(list.at(first, left), no_diagnostic())
        let other = or(list.at(second, right), no_diagnostic())
        if right >= list.length(second) || left < list.length(first) && one.span.start <= other.span.start {
            merged = list.push(merged, one)
            left += 1
        } else {
            merged = list.push(merged, other)
            right += 1
        }
    }
    merged
}

// example: no_diagnostic().code == "L0000"
fn no_diagnostic() -> Diagnostic {
    Diagnostic { code: "L0000", message: "", span: lexer.Span { start: 0, length: 0 }, help: None, fix: None }
}

// example: list.length(documented(ast.Program { items: [] })) == 0
fn documented(program: ast.Program) -> List<ast.FunctionDeclaration> {
    var found = []
    for item in program.items {
        found = match item {
            ast.Function(function) => with_documented(found, function)
            _ => found
        }
    }
    found
}

// example: list.length(with_documented([], parsed_function("fn main() -> Int {\n    0\n}\n"))) == 0
fn with_documented(found: List<ast.FunctionDeclaration>, function: ast.FunctionDeclaration) -> List<ast.FunctionDeclaration> {
    if function.name.text == "main" || is_unit_result(function.result) {
        return found
    }
    list.push(found, function)
}

// example: parsed_function("fn f() -> Int {\n    0\n}\n").name.text == "f"
private fn parsed_function(source: String) -> ast.FunctionDeclaration {
    var first = ast.FunctionDeclaration { name: ast.Name { text: "", span: lexer.Span { start: 0, length: 0 } }, type_parameters: [], parameters: [], result: None, body: ast.Block { statements: [], span: lexer.Span { start: 0, length: 0 } }, span: lexer.Span { start: 0, length: 0 }, visibility: ast.Public }
    for item in ok_or(parser.parse(source), ast.Program { items: [] }).items {
        first = match item {
            ast.Function(function) => function
            _ => first
        }
    }
    first
}

// example: !is_unit_result(None)
fn is_unit_result(result: Option<ast.TypeRef>) -> Bool {
    match result {
        Some(written) => is_unit_type(written.kind)
        None => false
    }
}

// example: is_unit_type(ast.UnitType)
fn is_unit_type(kind: ast.TypeRefKind) -> Bool {
    match kind {
        ast.UnitType => true
        _ => false
    }
}

// example: list.length(examples_of(commented_of("// example: f() == 0\nfn f() -> Int {\n    0\n}\n"), parsed_function("// example: f() == 0\nfn f() -> Int {\n    0\n}\n"))) == 1
fn examples_of(written: Commented, function: ast.FunctionDeclaration) -> List<Example> {
    var found = []
    for comment in comments_above(written, function.span.start) {
        found = match stated_at(comment.text) {
            Some(expression) => list.push(found, Example { of: function.name.text, expression: expression, span: comment.span })
            None => found
        }
    }
    found
}

// example: list.length(documenting_nothing(commented_of("// example: 1 == 1\n"), [])) == 1
fn documenting_nothing(written: Commented, stated: List<Example>) -> List<Diagnostic> {
    var taken = set.empty()
    for example in stated {
        taken = set.insert(taken, example.span.start)
    }
    var refusals = []
    for comment in written.comments {
        if is_stated(stated_at(comment.text)) && !set.has_value(taken, comment.span.start) {
            refusals = list.push(refusals, Diagnostic { code: "L0602", message: "this example documents nothing", span: comment.span, help: Some("an example goes in the comment above the function it documents"), fix: None })
        }
    }
    refusals
}

// example: or(stated_at("// example: f() == 1 "), "") == "f() == 1"
// example: or(stated_at("// an example: 1"), "none") == "none"
fn stated_at(text: String) -> Option<String> {
    var start = 0
    for start < strings.length(text) && or(strings.at(text, start), 0) == 47 {
        start += 1
    }
    let rest = trimmed_start(or(strings.cut(text, start, strings.length(text)), ""))
    if !has_prefix(text: rest, opening: "example:") {
        return None
    }
    Some(trimmed_end(trimmed_start(or(strings.cut(rest, 8, strings.length(rest)), ""))))
}

// example: trimmed_start(" \ta") == "a"
fn trimmed_start(text: String) -> String {
    var start = 0
    for start < strings.length(text) && is_white(or(strings.at(text, start), 0)) {
        start += 1
    }
    or(strings.cut(text, start, strings.length(text)), "")
}

// The run uses `io`, `arguments`, and a function name for each test.
// So a module that declares one of these names is refused.
// example: code_refused(result_of_run(run_of(Page { source: "", path: "a.bx" }, ok_or(parser.parse("fn io() -> Int {\n    0\n}\n"), ast.Program { items: [] }), Trying { examples: [], tests: [] }))) == "L0604"
fn run_of(page: Page, program: ast.Program, stated: Trying) -> Result<Run, Diagnostic> {
    var reached = ["io", "arguments"]
    var ordinal = 0
    for _ in stated.tests {
        reached = list.push(reached, test_function(ordinal))
        ordinal += 1
    }
    for named in reached {
        let declared = declaring(program, named)
        if has_span(declared) {
            return Err(Diagnostic { code: "L0604", message: "a run of the examples reaches `" + named + "`, and this module declares it", span: or(declared, lexer.Span { start: 0, length: 0 }), help: Some("call the declaration something else, or run the module rather than its examples"), fix: None })
        }
    }
    Ok(run_written(page, program, stated))
}

// example: code_refused(result_of_run(Err(no_diagnostic()))) == "L0000"
private fn result_of_run(answer: Result<Run, Diagnostic>) -> Result<(), Diagnostic> {
    match answer {
        Ok(_) => Ok(())
        Err(diagnostic) => Err(diagnostic)
    }
}

// example: has_span(Some(lexer.Span { start: 0, length: 1 }))
fn has_span(declared: Option<lexer.Span>) -> Bool {
    match declared {
        Some(_) => true
        None => false
    }
}

// example: has_span(declaring(ok_or(parser.parse("fn io() -> Int {\n    0\n}\n"), ast.Program { items: [] }), "io"))
fn declaring(program: ast.Program, named: String) -> Option<lexer.Span> {
    for item in program.items {
        let declared = name_declared(item)
        if declared.text == named && named != "" {
            return Some(declared.span)
        }
    }
    None
}

// example: name_declared(ast.Import(ast.ImportDeclaration { module: ast.Name { text: "io", span: lexer.Span { start: 7, length: 2 } }, span: lexer.Span { start: 0, length: 9 } })).text == ""
fn name_declared(item: ast.Item) -> ast.Name {
    match item {
        ast.Type(declaration) => declaration.name
        ast.Trait(declaration) => declaration.name
        ast.Function(function) => function.name
        ast.Extern(declaration) => declaration.name
        ast.Process(declaration) => declaration.name
        _ => ast.Name { text: "", span: lexer.Span { start: 0, length: 0 } }
    }
}

// The run leaves out `main`, and can leave out the tests, so it imports only what it still uses.
// An import that is not used is refused, as in each module.
// example: run_written(Page { source: "", path: "a.bx" }, ast.Program { items: [] }, Trying { examples: [], tests: [] }).source == "\nfn main(arguments: List<String>) -> Int {\n    0\n}\n"
fn run_written(page: Page, program: ast.Program, stated: Trying) -> Run {
    let body = body_written(page, program, stated)
    let imports = wrote(Writing { source: "", bytes: 0, stretches: [] }, Stretch { text: imports_of(program, with_modules_written(set.empty(), body.source)), about: WholeModule })
    var stretches = imports.stretches
    for placed in body.stretches {
        stretches = list.push(stretches, Placed { span: lexer.Span { start: placed.span.start + imports.bytes, length: placed.span.length }, about: placed.about })
    }
    Run { source: imports.source + body.source, stretches: stretches, examples: stated.examples, tests: stated.tests, module: lexer.Span { start: 0, length: byte_count(page.source) } }
}

// A test function goes above the declarations, because a function goes above what it uses.
// example: body_written(Page { source: "", path: "a.bx" }, ast.Program { items: [] }, Trying { examples: [], tests: [] }).source == "fn main(arguments: List<String>) -> Int {\n    0\n}\n"
fn body_written(page: Page, program: ast.Program, stated: Trying) -> Writing {
    var writing = wrote(Writing { source: "", bytes: 0, stretches: [] }, Stretch { text: "fn main(arguments: List<String>) -> Int {\n", about: WholeModule })
    var ordinal = 0
    for example in stated.examples {
        writing = wrote(writing, Stretch { text: "    if !(" + example.expression + ") {\n        io.println(\"bux: example " + shown(ordinal) + "\")\n    }\n", about: OneExample(ordinal) })
        ordinal += 1
    }
    ordinal = 0
    for _ in stated.tests {
        writing = wrote(writing, Stretch { text: "    if !" + test_function(ordinal) + "() {\n        io.println(\"bux: test " + shown(ordinal) + "\")\n    }\n", about: WholeModule })
        ordinal += 1
    }
    writing = wrote(writing, Stretch { text: "    0\n}\n", about: WholeModule })
    let commented = commented_of(page.source)
    writing = test_functions_written(writing, stated.tests, commented.measured)
    for declared in declarations_of(program) {
        let block = block_of(commented, declared)
        writing = wrote(writing, Stretch { text: "\n", about: WholeModule })
        writing = wrote(writing, Stretch { text: measured_cut(commented.measured, Stretched { from: block.start, to: block.start + block.length }), about: SameText(block.start) })
        writing = wrote(writing, Stretch { text: "\n", about: WholeModule })
    }
    writing
}

// A function that gives back a value must state an example, so each test function states `true`.
// example: test_functions_written(Writing { source: "", bytes: 0, stretches: [] }, ast.tests_of(ok_or(parser.parse("test \"a\" {\n    true\n}\n"), ast.Program { items: [] })), measured_of("test \"a\" {\n    true\n}\n")).source == "\n// example: true\nfn is_held_0() -> Bool {\n    true\n}\n"
fn test_functions_written(writing: Writing, tests: List<ast.TestDeclaration>, measured: Measured) -> Writing {
    var written = writing
    var ordinal = 0
    for stated in tests {
        let body = stated.body.span
        written = wrote(written, Stretch { text: "\n// example: true\nfn " + test_function(ordinal) + "() -> Bool ", about: WholeModule })
        written = wrote(written, Stretch { text: measured_cut(measured, Stretched { from: body.start, to: body.start + body.length }), about: SameText(body.start) })
        written = wrote(written, Stretch { text: "\n", about: WholeModule })
        ordinal += 1
    }
    written
}

// example: test_function(2) == "is_held_2"
fn test_function(ordinal: Int) -> String {
    "is_held_" + shown(ordinal)
}

// example: list.length(commented_of("// a\nfn\n").comments) == 1
fn commented_of(source: String) -> Commented {
    var comments = []
    for token in lexer.lex(source) {
        if token.kind == lexer.LineComment {
            comments = list.push(comments, token)
        }
    }
    Commented { measured: measured_of(source), comments: comments }
}

// example: wrote(Writing { source: "", bytes: 0, stretches: [] }, Stretch { text: "é", about: WholeModule }).bytes == 2
fn wrote(writing: Writing, stretch: Stretch) -> Writing {
    let width = byte_count(stretch.text)
    let placed = Placed { span: lexer.Span { start: writing.bytes, length: width }, about: stretch.about }
    Writing { source: writing.source + stretch.text, bytes: writing.bytes + width, stretches: list.push(writing.stretches, placed) }
}

// example: byte_count("aé") == 3
fn byte_count(text: String) -> Int {
    lexer.byte_length(lexer.Rest { source: text, start: 0 }, strings.length(text))
}

// example: imports_of(ok_or(parser.parse("import list\n"), ast.Program { items: [] }), set.insert(set.insert(set.empty(), "io"), "list")) == "import io\nimport list\n\n"
// example: imports_of(ok_or(parser.parse("import list\n"), ast.Program { items: [] }), set.insert(set.empty(), "io")) == "import io\n\n"
fn imports_of(program: ast.Program, read: set.Set<String>) -> String {
    var named = ["io"]
    for item in program.items {
        named = match item {
            ast.Import(imported) => list.push(named, imported.module.text)
            _ => named
        }
    }
    var written = ""
    var last = ""
    for module in list.sorted(named) {
        if module != last && set.has_value(read, module) {
            written += "import " + module + "\n"
        }
        last = module
    }
    written + "\n"
}

// A name after a dot is a field or a member, so only the first name of a chain is a module.
// example: set.has_value(with_modules_written(set.empty(), "a.b(c.d)"), "c")
// example: set.has_value(with_modules_written(set.empty(), "a.b.c"), "b") == false
fn with_modules_written(read: set.Set<String>, text: String) -> set.Set<String> {
    var named = read
    var before = ""
    var after_a_dot = false
    for token in lexer.lex(text) {
        let is_dot = token.kind == lexer.Punct(lexer.Dot)
        if is_dot && before != "" {
            named = set.insert(named, before)
        }
        before = if token.kind == lexer.Identifier && !after_a_dot {
            token.text
        } else {
            ""
        }
        after_a_dot = is_dot
    }
    named
}

// example: list.length(declarations_of(ok_or(parser.parse("import io\n\nfn main() -> Int {\n    0\n}\n"), ast.Program { items: [] }))) == 0
fn declarations_of(program: ast.Program) -> List<lexer.Span> {
    var found = []
    for item in program.items {
        found = match item {
            ast.Import(_) => found
            ast.Type(declaration) => list.push(found, declaration.span)
            ast.Trait(declaration) => list.push(found, declaration.span)
            ast.Instance(declaration) => list.push(found, declaration.span)
            ast.Derive(declaration) => list.push(found, declaration.span)
            ast.Function(function) => with_copied(found, function)
            ast.Extern(declaration) => list.push(found, declaration.span)
            ast.Process(declaration) => list.push(found, declaration.span)
            ast.Test(_) => found
        }
    }
    found
}

// example: list.length(with_copied([], parsed_function("fn main() -> Int {\n    0\n}\n"))) == 0
fn with_copied(found: List<lexer.Span>, function: ast.FunctionDeclaration) -> List<lexer.Span> {
    if function.name.text == "main" {
        return found
    }
    list.push(found, function.span)
}

// example: block_of(commented_of("// a\nfn"), lexer.Span { start: 5, length: 2 }).start == 0
fn block_of(written: Commented, declared: lexer.Span) -> lexer.Span {
    let opens = match list.at(comments_above(written, declared.start), 0) {
        Some(first) => opening_of(written.measured, first.span.start)
        None => declared.start
    }
    lexer.Span { start: opens, length: declared.start + declared.length - opens }
}

// example: list.length(comments_above(commented_of("// a\n// b\nfn"), 10)) == 2
// example: list.length(comments_above(commented_of("// a\n\nfn"), 6)) == 0
fn comments_above(written: Commented, below: Int) -> List<lexer.Token> {
    var found = []
    var reached = below
    for {
        let index = last_ending_by(written.comments, reached)
        if index < 0 {
            break
        }
        let comment = or(list.at(written.comments, index), no_token())
        let opens = opening_of(written.measured, comment.span.start)
        let between = measured_cut(written.measured, Stretched { from: comment.span.start + comment.span.length, to: reached })
        let before = measured_cut(written.measured, Stretched { from: opens, to: comment.span.start })
        if !is_one_line_break(between) || !is_blank_run(before) {
            break
        }
        found = list.push(found, comment)
        reached = opens
    }
    turned(found)
}

// example: or(list.at(turned([1, 2]), 0), 0) == 2
fn turned<T>(values: List<T>) -> List<T> {
    var backwards = []
    var index = list.length(values) - 1
    for index >= 0 {
        backwards = match list.at(values, index) {
            Some(value) => list.push(backwards, value)
            None => backwards
        }
        index = index - 1
    }
    backwards
}

// The comments are in source order and do not overlap, so each end is after the end before it.
// example: last_ending_by(commented_of("// a\n// b\n").comments, 9) == 1
fn last_ending_by(comments: List<lexer.Token>, reached: Int) -> Int {
    var low = 0
    var high = list.length(comments)
    for low < high {
        let middle = or((low + high) / 2, 0)
        let comment = or(list.at(comments, middle), no_token())
        if comment.span.start + comment.span.length <= reached {
            low = middle + 1
        } else {
            high = middle
        }
    }
    low - 1
}

// example: no_token().text == ""
fn no_token() -> lexer.Token {
    lexer.Token { kind: lexer.Unknown, span: lexer.Span { start: 0, length: 0 }, text: "" }
}

// example: is_one_line_break(" \n\t")
// example: !is_one_line_break("\n\n")
fn is_one_line_break(between: String) -> Bool {
    var breaks = 0
    var index = 0
    for index < strings.length(between) {
        let unit = or(strings.at(between, index), 0)
        if unit == 10 {
            breaks += 1
        } else if !is_blank(unit) {
            return false
        }
        index += 1
    }
    breaks == 1
}

// example: is_blank_run(" \t")
fn is_blank_run(text: String) -> Bool {
    var index = 0
    for index < strings.length(text) {
        if !is_blank(or(strings.at(text, index), 0)) {
            return false
        }
        index += 1
    }
    true
}

// example: is_blank(13)
fn is_blank(unit: Int) -> Bool {
    unit == 32 || unit == 9 || unit == 13
}

// example: opening_of(measured_of("ab\ncd"), 4) == 3
fn opening_of(measured: Measured, at: Int) -> Int {
    var unit = unit_of(measured, at)
    for unit > 0 && or(strings.at(measured.source, unit - 1), 0) != 10 {
        unit = unit - 1
    }
    byte_of(measured, unit)
}

// example: measured_cut(measured_of("aé!"), Stretched { from: 1, to: 3 }) == "é"
fn measured_cut(measured: Measured, stretched: Stretched) -> String {
    or(strings.cut(measured.source, unit_of(measured, stretched.from), unit_of(measured, stretched.to)), "")
}

// example: is_named(named_in(Run { source: "", stretches: [], examples: [], tests: [], module: lexer.Span { start: 0, length: 0 } }, "bux: example 0")) == false
fn named_in(run: Run, line: String) -> Option<Example> {
    match marked_ordinal(line: line, marker: "bux: example ") {
        Some(ordinal) => list.at(run.examples, ordinal)
        None => None
    }
}

// example: list.length(test_named_in(Run { source: "", stretches: [], examples: [], tests: [], module: lexer.Span { start: 0, length: 0 } }, "bux: test 0")) == 0
fn test_named_in(run: Run, line: String) -> List<ast.TestDeclaration> {
    match marked_ordinal(line: line, marker: "bux: test ") {
        Some(ordinal) => at_most_one(list.at(run.tests, ordinal))
        None => []
    }
}

// example: or(marked_ordinal(line: "bux: test 3 ", marker: "bux: test "), 0) == 3
// example: or(marked_ordinal(line: "bux: example 3", marker: "bux: test "), 0) == 0
fn marked_ordinal(line: String, marker: String) -> Option<Int> {
    let trimmed = trimmed_end(line)
    if !has_prefix(text: trimmed, opening: marker) {
        return None
    }
    ordinal_read(or(strings.cut(trimmed, strings.length(marker), strings.length(trimmed)), ""))
}

// example: trimmed_end("a \r") == "a"
fn trimmed_end(text: String) -> String {
    var end = strings.length(text)
    for end > 0 && is_white(or(strings.at(text, end - 1), 0)) {
        end = end - 1
    }
    or(strings.cut(text, 0, end), "")
}

// example: is_white(12288)
// example: !is_white(97)
fn is_white(unit: Int) -> Bool {
    if unit >= 9 && unit <= 13 {
        return true
    }
    if unit >= 8192 && unit <= 8202 {
        return true
    }
    list.has_value([32, 133, 160, 5760, 8232, 8233, 8239, 8287, 12288], unit)
}

// example: !is_named(None)
private fn is_named(found: Option<Example>) -> Bool {
    match found {
        Some(_) => true
        None => false
    }
}

// example: or(ordinal_read("+12"), 0) == 12
// example: or(ordinal_read("1a"), 0) == 0
fn ordinal_read(text: String) -> Option<Int> {
    var index = 0
    if has_prefix(text: text, opening: "+") {
        index = 1
    }
    if index >= strings.length(text) || strings.length(text) - index > 18 {
        return None
    }
    var value = 0
    for index < strings.length(text) {
        let unit = or(strings.at(text, index), 0)
        if !is_digit(unit) {
            return None
        }
        value = value * 10 + unit - 48
        index += 1
    }
    Some(value)
}

// example: is_digit(48)
fn is_digit(unit: Int) -> Bool {
    unit >= 48 && unit <= 57
}

// example: did_not_hold(Example { of: "f", expression: "false", span: lexer.Span { start: 0, length: 1 } }).message == "the example of `f` does not hold"
fn did_not_hold(example: Example) -> Diagnostic {
    Diagnostic { code: "L0603", message: "the example of `" + example.of + "` does not hold", span: example.span, help: Some("an example states what a function works out, and this one states what it does not"), fix: None }
}

// example: in_original(Run { source: "", stretches: [], examples: [], tests: [], module: lexer.Span { start: 0, length: 7 } }, lexer.Span { start: 3, length: 1 }).length == 7
fn in_original(run: Run, written: lexer.Span) -> lexer.Span {
    for placed in run.stretches {
        if placed.span.start <= written.start && written.start < placed.span.start + placed.span.length {
            return placed_back(run, placed, written)
        }
    }
    run.module
}

// example: placed_back(Run { source: "", stretches: [], examples: [], tests: [], module: lexer.Span { start: 0, length: 7 } }, Placed { span: lexer.Span { start: 2, length: 4 }, about: SameText(10) }, lexer.Span { start: 3, length: 9 }).length == 3
fn placed_back(run: Run, placed: Placed, written: lexer.Span) -> lexer.Span {
    match placed.about {
        SameText(from) => lexer.Span { start: from + written.start - placed.span.start, length: smaller(one: written.length, other: placed.span.length - (written.start - placed.span.start)) }
        OneExample(ordinal) => example_span(run, ordinal)
        WholeModule => run.module
    }
}

// example: example_span(Run { source: "", stretches: [], examples: [], tests: [], module: lexer.Span { start: 0, length: 7 } }, 0).length == 7
fn example_span(run: Run, ordinal: Int) -> lexer.Span {
    match list.at(run.examples, ordinal) {
        Some(example) => example.span
        None => run.module
    }
}

// example: rendered(Diagnostic { code: "L0102", message: "m", span: lexer.Span { start: 1, length: 1 }, help: None, fix: None }, Page { source: "a$b\n", path: "x.bx" }) == "error[L0102]: m\n  --> x.bx:1:2\n\n  1 | a$b\n    |  ^\n"
fn rendered(diagnostic: Diagnostic, page: Page) -> String {
    let place = place_of(diagnostic.span, measured_of(page.source))
    let line = shown(place.line)
    let gutter = "  " + line + " "
    var written = "error[" + diagnostic.code + "]: " + diagnostic.message + "\n"
    written += "  --> " + page.path + ":" + line + ":" + shown(place.column) + "\n\n"
    written += gutter + "| " + place.text + "\n"
    written += repeated(text: " ", times: strings.length(gutter)) + "| " + place.padding + repeated(text: "^", times: place.width) + place.note
    written + help_line(diagnostic.help) + "\n"
}

// example: or(list.at(measured_of("é!").starts, 1), 0) == 2
fn measured_of(source: String) -> Measured {
    var starts = []
    var at = 0
    var index = 0
    for index < strings.length(source) {
        starts = list.push(starts, at)
        at += lexer.unit_width(or(strings.at(source, index), 0))
        index += 1
    }
    Measured { source: source, starts: list.push(starts, at) }
}

// example: help_line(Some("x")) == "\n\nhelp: x"
fn help_line(help: Option<String>) -> String {
    match help {
        Some(text) => "\n\nhelp: " + text
        None => ""
    }
}

// example: place_of(lexer.Span { start: 0, length: 3 }, measured_of("a\nb")).note == " this runs on to line 2"
fn place_of(span: lexer.Span, measured: Measured) -> Pointed {
    let total = byte_of(measured, strings.length(measured.source))
    let start = smaller(one: span.start, other: larger(one: total - 1, other: 0))
    let end = span.start + span.length
    let start_unit = unit_of(measured, start)
    let opens = line_start(measured.source, start_unit)
    let closes = line_end(measured.source, start_unit)
    let line = 1 + breaks_before(measured.source, start_unit)
    let last = 1 + breaks_before(measured.source, unit_of(measured, larger(one: smaller(one: end, other: total) - 1, other: 0)))
    let column = 1 + characters_of(measured.source, Stretched { from: opens, to: start_unit })
    let reach = unit_of(measured, smaller(one: end, other: byte_of(measured, closes)))
    let text = or(strings.cut(measured.source, opens, closes), "")
    Pointed { line: line, column: column, text: text, width: larger(one: characters_of(measured.source, Stretched { from: start_unit, to: reach }), other: 1), padding: padding_of(text, column - 1), note: note_of(Lines { first: line, last: last }) }
}

// example: unit_of(measured_of("é!"), 2) == 1
// example: unit_of(measured_of("é!"), 1) == 1
fn unit_of(measured: Measured, byte: Int) -> Int {
    var low = 0
    var high = list.length(measured.starts) - 1
    for low < high {
        let middle = or((low + high) / 2, 0)
        if or(list.at(measured.starts, middle), 0) < byte {
            low = middle + 1
        } else {
            high = middle
        }
    }
    low
}

// example: byte_of(measured_of("é!"), 1) == 2
fn byte_of(measured: Measured, unit: Int) -> Int {
    or(list.at(measured.starts, unit), 0)
}

// example: note_of(Lines { first: 1, last: 1 }) == ""
fn note_of(lines: Lines) -> String {
    if lines.last > lines.first {
        return " this runs on to line " + shown(lines.last)
    }
    ""
}

// example: line_start("ab\ncd", 4) == 3
fn line_start(source: String, unit: Int) -> Int {
    var at = unit
    for at > 0 && or(strings.at(source, at - 1), 0) != 10 {
        at = at - 1
    }
    at
}

// example: line_end("ab\ncd", 1) == 2
fn line_end(source: String, unit: Int) -> Int {
    var at = unit
    for at < strings.length(source) && or(strings.at(source, at), 0) != 10 {
        at += 1
    }
    at
}

// example: breaks_before("a\nb\nc", 4) == 2
fn breaks_before(source: String, unit: Int) -> Int {
    var count = 0
    var at = 0
    for at < unit && at < strings.length(source) {
        if or(strings.at(source, at), 0) == 10 {
            count += 1
        }
        at += 1
    }
    count
}

// example: characters_of("a😀b", Stretched { from: 0, to: 4 }) == 3
fn characters_of(source: String, stretched: Stretched) -> Int {
    var count = 0
    var at = stretched.from
    for at < stretched.to && at < strings.length(source) {
        let unit = or(strings.at(source, at), 0)
        if unit < 56320 || unit > 57343 {
            count += 1
        }
        at += 1
    }
    count
}

// A tab stays a tab, so the carets align under the text for each tab width.
// example: padding_of("\tab", 2) == "\t "
fn padding_of(text: String, count: Int) -> String {
    var written = ""
    var taken = 0
    var at = 0
    for taken < count && at < strings.length(text) {
        let unit = or(strings.at(text, at), 0)
        if unit == 9 {
            written += "\t"
        } else if unit < 56320 || unit > 57343 {
            written += " "
        }
        if unit < 56320 || unit > 57343 {
            taken += 1
        }
        at += 1
    }
    written
}

// example: json_of(no_diagnostic(), "a.bx") == "{\"file\":\"a.bx\",\"code\":\"L0000\",\"message\":\"\",\"span\":{\"start\":0,\"len\":0}}\n"
fn json_of(diagnostic: Diagnostic, path: String) -> String {
    var written = "{" + json_field(name: "file", value: path) + "," + json_field(name: "code", value: diagnostic.code) + "," + json_field(name: "message", value: diagnostic.message)
    written += ",\"span\":" + json_span(diagnostic.span)
    written += json_help(diagnostic.help) + json_fix(diagnostic.fix)
    written + "}\n"
}

// example: json_span(lexer.Span { start: 1, length: 2 }) == "{\"start\":1,\"len\":2}"
fn json_span(span: lexer.Span) -> String {
    "{\"start\":" + shown(span.start) + ",\"len\":" + shown(span.length) + "}"
}

// example: json_help(None) == ""
fn json_help(help: Option<String>) -> String {
    match help {
        Some(text) => "," + json_field(name: "help", value: text)
        None => ""
    }
}

// example: json_field(name: "a", value: "b") == "\"a\":\"b\""
fn json_field(name: String, value: String) -> String {
    "\"" + name + "\":" + quoted(value)
}

// example: json_fix(Some(Fix { span: lexer.Span { start: 0, length: 1 }, text: "a" })) == ",\"fix\":{\"start\":0,\"len\":1,\"text\":\"a\"}"
fn json_fix(fix: Option<Fix>) -> String {
    match fix {
        Some(edit) => ",\"fix\":{\"start\":" + shown(edit.span.start) + ",\"len\":" + shown(edit.span.length) + ",\"text\":" + quoted(edit.text) + "}"
        None => ""
    }
}

// The text between two escapes is copied whole, so a long text is not built one unit at a time.
// example: quoted("a\"\n") == "\"a\\\"\\n\""
fn quoted(text: String) -> String {
    var written = "\""
    var plain = 0
    var index = 0
    for index < strings.length(text) {
        let escape = escape_of(or(strings.at(text, index), 0))
        if escape != "" {
            written += or(strings.cut(text, plain, index), "") + escape
            plain = index + 1
        }
        index += 1
    }
    written + or(strings.cut(text, plain, strings.length(text)), "") + "\""
}

// example: escape_of(9) == "\\t"
// example: escape_of(31) == "\\u001f"
// example: escape_of(97) == ""
fn escape_of(unit: Int) -> String {
    if unit == 34 {
        return "\\\""
    }
    if unit == 92 {
        return "\\\\"
    }
    if unit == 10 {
        return "\\n"
    }
    if unit == 13 {
        return "\\r"
    }
    if unit == 9 {
        return "\\t"
    }
    if unit < 32 {
        return "\\u00" + hex_digit(or(unit / 16, 0)) + hex_digit(or(unit % 16, 0))
    }
    ""
}

// example: hex_digit(11) == "b"
fn hex_digit(value: Int) -> String {
    or(strings.cut("0123456789abcdef", value, value + 1), "0")
}

// Each refusal of the words reads as the Rust binary wrote it, with the same tip and usage line.
// example: is_told(asked_by(["-V"]))
// example: !is_told(asked_by(["check", "a.bx"]))
fn asked_by(arguments: List<String>) -> Parsed {
    var index = 0
    var escaped = false
    for word in arguments {
        index += 1
        if escaped {
            return Told(escaped_word(word))
        }
        if word != "--" {
            return unescaped_parsed(word, after(arguments, index))
        }
        escaped = true
    }
    Told(Said { output: "", errors: top_short_help(), status: 2 })
}

// example: is_told(Told(nothing_said()))
private fn is_told(parsed: Parsed) -> Bool {
    match parsed {
        Told(_) => true
        _ => false
    }
}

// example: is_told(unescaped_parsed("chek", []))
fn unescaped_parsed(word: String, rest: List<String>) -> Parsed {
    match subcommand_named(word) {
        Some(sub) => subcommand_parsed(sub, rest)
        None => Told(flag_or_word(word, rest))
    }
}

// example: !is_told(subcommand_parsed(or(subcommand_named("fmt"), help_subcommand()), ["a.bx"]))
fn subcommand_parsed(sub: Subcommand, rest: List<String>) -> Parsed {
    if sub.name == "help" {
        return Told(help_asked(rest))
    }
    if sub.name == "run" {
        return run_parsed(rest)
    }
    match positional_read(sub, rest) {
        Ok(command) => Asked(command)
        Err(said) => Told(said)
    }
}

// example: flag_or_word("-V", []).output == "bux 0.1.0\n"
fn flag_or_word(word: String, rest: List<String>) -> Said {
    if is_long(word) {
        return top_long(long_of(word), rest)
    }
    if is_short(word) {
        return top_short(word)
    }
    unrecognized(word)
}

// example: top_long(long_of("--version"), []).output == "bux 0.1.0\n"
fn top_long(long: Long, rest: List<String>) -> Said {
    if long.name == "help" || long.name == "version" {
        return top_flag(long)
    }
    let shown_flag = "--" + long.name
    match most_similar(long.name, ["help", "version"]) {
        Some(similar) => complained(Complaint { message: "unexpected argument '" + shown_flag + "' found", tip: Some("a similar argument exists: '--" + similar + "'"), usage: "bux --" + similar + " <COMMAND>", offers_help: true })
        None => complained(Complaint { message: "unexpected argument '" + shown_flag + "' found", tip: flag_of_a_command(long.name, rest), usage: "bux <COMMAND>", offers_help: true })
    }
}

// example: top_flag(Long { name: "help", value: Some("x") }).status == 2
fn top_flag(long: Long) -> Said {
    match long.value {
        Some(value) => too_many(value, Complaint { message: "--" + long.name, tip: None, usage: "bux --" + long.name + " <COMMAND>", offers_help: true })
        None => top_flag_said(long.name)
    }
}

// example: top_flag_said("version").output == "bux 0.1.0\n"
fn top_flag_said(name: String) -> Said {
    if name == "version" {
        return version_said()
    }
    Said { output: top_long_help(), errors: "", status: 0 }
}

// example: or(flag_of_a_command("jsn", ["check"]), "") == "'check --json' exists"
fn flag_of_a_command(name: String, rest: List<String>) -> Option<String> {
    var best = None
    var best_at = list.length(rest)
    for sub in subcommands() {
        let at = or(list.index_of(rest, sub.name), list.length(rest))
        let similar = most_similar(name, sub.longs)
        if at < best_at && is_stated(similar) {
            best = Some("'" + sub.name + " --" + or(similar, "") + "' exists")
            best_at = at
        }
    }
    best
}

// example: top_short("-x").errors == "error: unexpected argument '-x' found\n\nUsage: bux <COMMAND>\n\nFor more information, try '--help'.\n"
fn top_short(word: String) -> Said {
    let letter = first_letter(word)
    if letter == "h" {
        return Said { output: top_short_help(), errors: "", status: 0 }
    }
    if letter == "V" {
        return version_said()
    }
    complained(Complaint { message: "unexpected argument '-" + letter + "' found", tip: None, usage: "bux <COMMAND>", offers_help: true })
}

// example: version_said().status == 0
fn version_said() -> Said {
    Said { output: "bux 0.1.0\n", errors: "", status: 0 }
}

// example: escaped_word("check").errors == "error: unexpected argument 'check' found\n\n  tip: subcommand 'check' exists; to use it, remove the '--' before it\n\nUsage: bux <COMMAND>\n\nFor more information, try '--help'.\n"
fn escaped_word(word: String) -> Said {
    match subcommand_named(word) {
        Some(_) => complained(Complaint { message: "unexpected argument '" + word + "' found", tip: Some("subcommand '" + word + "' exists; to use it, remove the '--' before it"), usage: "bux <COMMAND>", offers_help: true })
        None => unrecognized(word)
    }
}

// example: unrecognized("chek").errors == "error: unrecognized subcommand 'chek'\n\n  tip: a similar subcommand exists: 'check'\n\nUsage: bux <COMMAND>\n\nFor more information, try '--help'.\n"
fn unrecognized(word: String) -> Said {
    let similar = all_similar(word, subcommand_names())
    complained(Complaint { message: "unrecognized subcommand '" + word + "'", tip: commands_tip(similar), usage: "bux <COMMAND>", offers_help: true })
}

// example: or(commands_tip(["a", "b"]), "") == "some similar subcommands exist: 'a', 'b'"
fn commands_tip(similar: List<String>) -> Option<String> {
    if list.length(similar) == 0 {
        return None
    }
    if list.length(similar) == 1 {
        return Some("a similar subcommand exists: '" + or(list.at(similar, 0), "") + "'")
    }
    var quoted_names = []
    for name in similar {
        quoted_names = list.push(quoted_names, "'" + name + "'")
    }
    Some("some similar subcommands exist: " + strings.join(quoted_names, ", "))
}

// example: list.length(subcommand_names()) == 8
fn subcommand_names() -> List<String> {
    var names = []
    for sub in subcommands() {
        names = list.push(names, sub.name)
    }
    names
}

// example: is_refused(positional_read(or(subcommand_named("fmt"), help_subcommand()), []))
fn positional_read(sub: Subcommand, rest: List<String>) -> Result<Command, Said> {
    var used = []
    var given = []
    var escaped = false
    for word in rest {
        if !escaped && word == "--" {
            escaped = true
            continue
        }
        if escaped || !is_long(word) && !is_short(word) {
            if list.length(given) > 0 {
                return Err(complained(Complaint { message: "unexpected argument '" + word + "' found", tip: None, usage: sub.usage, offers_help: true }))
            }
            given = list.push(given, word)
            continue
        }
        used = flag_read(sub, Flagged { word: word, used: used })?
    }
    if list.length(given) == 0 {
        given = at_most_one(sub.absent)
    }
    match list.at(given, 0) {
        Some(value) => Ok(command_of(sub, Given { value: value, used: used }))
        None => Err(complained(Complaint { message: "the following required arguments were not provided:\n  <" + sub.value + ">", tip: None, usage: smart_usage(sub, used), offers_help: true }))
    }
}

// example: at_most_one(Some(3)) == [3]
fn at_most_one<T>(found: Option<T>) -> List<T> {
    match found {
        Some(value) => [value]
        None => []
    }
}

// example: command_of(or(subcommand_named("explain"), help_subcommand()), Given { value: "L0100", used: [] }) == Explain("L0100")
fn command_of(sub: Subcommand, given: Given) -> Command {
    let value = given.value
    match sub.name {
        "fmt" => Fmt(value)
        "check" => Check { path: value, form: form_of(given.used) }
        "build" => Build(value)
        "test" => Test(value)
        "api" => Api(value)
        _ => Explain(value)
    }
}

// example: form_of(["json"]) == AsData
fn form_of(used: List<String>) -> Form {
    if list.has_value(used, "json") {
        return AsData
    }
    AsPage
}

// example: ok_or(flag_read(or(subcommand_named("check"), help_subcommand()), Flagged { word: "--json", used: [] }), []) == ["json"]
fn flag_read(sub: Subcommand, flagged: Flagged) -> Result<List<String>, Said> {
    if is_short(flagged.word) {
        return Err(short_read(sub, flagged.word))
    }
    let long = long_of(flagged.word)
    if long.name == "help" {
        return Err(help_flag_said(sub, Held { long: long, used: flagged.used }))
    }
    if long.name == "json" && list.has_value(sub.longs, "json") {
        return json_read(sub, Held { long: long, used: flagged.used })
    }
    Err(unknown_long(sub, Held { long: long, used: flagged.used }))
}

// example: short_read(or(subcommand_named("fmt"), help_subcommand()), "-h").status == 0
fn short_read(sub: Subcommand, word: String) -> Said {
    let letter = first_letter(word)
    if letter == "h" {
        return Said { output: short_help(sub), errors: "", status: 0 }
    }
    let shown_flag = "-" + letter
    complained(Complaint { message: "unexpected argument '" + shown_flag + "' found", tip: Some("to pass '" + shown_flag + "' as a value, use '-- " + shown_flag + "'"), usage: sub.usage, offers_help: true })
}

// example: help_flag_said(or(subcommand_named("fmt"), help_subcommand()), Held { long: Long { name: "help", value: Some("") }, used: [] }).status == 2
fn help_flag_said(sub: Subcommand, held: Held) -> Said {
    match held.long.value {
        Some(value) => too_many(value, Complaint { message: "--help", tip: None, usage: value_usage(sub, held), offers_help: true })
        None => Said { output: long_help(sub), errors: "", status: 0 }
    }
}

// example: is_refused(json_read(or(subcommand_named("check"), help_subcommand()), Held { long: Long { name: "json", value: None }, used: ["json"] }))
fn json_read(sub: Subcommand, held: Held) -> Result<List<String>, Said> {
    match held.long.value {
        Some(value) => Err(too_many(value, Complaint { message: "--json", tip: None, usage: value_usage(sub, held), offers_help: true }))
        None => json_noted(sub, held.used)
    }
}

// example: too_many("x", Complaint { message: "--help", tip: None, usage: "u", offers_help: false }).errors == "error: unexpected value 'x' for '--help' found; no more were expected\n\nUsage: u\n"
fn too_many(value: String, complaint: Complaint) -> Said {
    complained(complaint { message: "unexpected value '" + value + "' for '" + complaint.message + "' found; no more were expected" })
}

// example: ok_or(json_noted(or(subcommand_named("check"), help_subcommand()), []), []) == ["json"]
fn json_noted(sub: Subcommand, used: List<String>) -> Result<List<String>, Said> {
    if list.has_value(used, "json") {
        return Err(complained(Complaint { message: "the argument '--json' cannot be used multiple times", tip: None, usage: sub.usage, offers_help: true }))
    }
    Ok(list.push(used, "json"))
}

// The Rust binary wrote `<PATH|--json>` after an earlier `--json`, and this usage line does too.
// example: value_usage(or(subcommand_named("check"), help_subcommand()), Held { long: Long { name: "help", value: None }, used: ["json"] }) == "bux check --help <PATH|--json>"
fn value_usage(sub: Subcommand, held: Held) -> String {
    if list.has_value(held.used, "json") {
        if held.long.name == "help" {
            return "bux " + sub.name + " --help <" + sub.value + "|--json>"
        }
        return "bux " + sub.name + " <" + sub.value + "|--json>"
    }
    smart_usage(sub, [held.long.name])
}

// example: unknown_long(or(subcommand_named("fmt"), help_subcommand()), Held { long: Long { name: "hlp", value: None }, used: [] }).errors == "error: unexpected argument '--hlp' found\n\n  tip: a similar argument exists: '--help'\n\nUsage: bux fmt --help <FILE>\n\nFor more information, try '--help'.\n"
fn unknown_long(sub: Subcommand, held: Held) -> Said {
    let shown_flag = "--" + held.long.name
    let message = "unexpected argument '" + shown_flag + "' found"
    match most_similar(held.long.name, sub.longs) {
        Some(similar) => complained(Complaint { message: message, tip: Some("a similar argument exists: '--" + similar + "'"), usage: smart_usage(sub, with_flag(held.used, similar)), offers_help: true })
        None => complained(Complaint { message: message, tip: Some("to pass '" + shown_flag + "' as a value, use '-- " + shown_flag + "'"), usage: used_usage(sub, held.used), offers_help: true })
    }
}

// example: list.length(with_flag(["json"], "json")) == 1
fn with_flag(used: List<String>, flag: String) -> List<String> {
    if list.has_value(used, flag) {
        return used
    }
    list.push(used, flag)
}

// example: used_usage(or(subcommand_named("check"), help_subcommand()), []) == "bux check [OPTIONS] <PATH>"
fn used_usage(sub: Subcommand, used: List<String>) -> String {
    if list.length(used) == 0 {
        return sub.usage
    }
    smart_usage(sub, used)
}

// example: smart_usage(or(subcommand_named("check"), help_subcommand()), ["json"]) == "bux check --json <PATH>"
fn smart_usage(sub: Subcommand, used: List<String>) -> String {
    var written = "bux " + sub.name + " "
    for flag in used {
        written += "--" + flag + " "
    }
    written + argument_written(sub)
}

// example: is_told(run_parsed([]))
fn run_parsed(rest: List<String>) -> Parsed {
    var escaped = false
    var file = []
    var arguments = []
    for word in rest {
        if !escaped && list.length(arguments) == 0 && word == "--" {
            escaped = true
            continue
        }
        if list.length(file) > 0 {
            arguments = list.push(arguments, word)
            continue
        }
        if !escaped && (is_long(word) || is_short(word)) {
            return Told(run_flag_refused(word))
        }
        file = list.push(file, word)
    }
    match list.at(file, 0) {
        Some(named) => Running(Started { file: named, arguments: arguments })
        None => Told(complained(Complaint { message: "the following required arguments were not provided:\n  <FILE>", tip: None, usage: "bux run <FILE> [ARGUMENTS]...", offers_help: false }))
    }
}

// example: is_short("-h")
// example: !is_short("-")
fn is_short(word: String) -> Bool {
    has_prefix(text: word, opening: "-") && !has_prefix(text: word, opening: "--") && strings.length(word) > 1
}

// example: run_flag_refused("--x=1").errors == "error: unexpected argument '--x' found\n\n  tip: to pass '--x' as a value, use '-- --x'\n\nUsage: bux run <FILE> [ARGUMENTS]...\n"
fn run_flag_refused(word: String) -> Said {
    let shown_flag = flag_shown(word)
    complained(Complaint { message: "unexpected argument '" + shown_flag + "' found", tip: Some("to pass '" + shown_flag + "' as a value, use '-- " + shown_flag + "'"), usage: "bux run <FILE> [ARGUMENTS]...", offers_help: false })
}

// example: flag_shown("-xy") == "-x"
fn flag_shown(word: String) -> String {
    if is_long(word) {
        return "--" + long_of(word).name
    }
    "-" + first_letter(word)
}

// example: is_long("--json")
// example: !is_long("--")
fn is_long(word: String) -> Bool {
    has_prefix(text: word, opening: "--") && strings.length(word) > 2
}

// example: has_prefix(text: "--json", opening: "--")
// example: !has_prefix(text: "-", opening: "--")
fn has_prefix(text: String, opening: String) -> Bool {
    lexer.has_prefix(lexer.Rest { source: text, start: 0 }, opening)
}

// example: or(long_of("--help=x").value, "") == "x"
fn long_of(word: String) -> Long {
    var index = 2
    for index < strings.length(word) {
        if or(strings.at(word, index), 0) == 61 {
            return Long { name: or(strings.cut(word, 2, index), ""), value: strings.cut(word, index + 1, strings.length(word)) }
        }
        index += 1
    }
    Long { name: or(strings.cut(word, 2, strings.length(word)), ""), value: None }
}

// example: first_letter("-xy") == "x"
fn first_letter(word: String) -> String {
    let unit = or(strings.at(word, 1), 0)
    if unit >= 55296 && unit <= 56319 {
        return or(strings.cut(word, 1, 3), "")
    }
    or(strings.cut(word, 1, 2), "")
}

// example: help_asked([]).status == 0
// example: help_asked(["nope"]).status == 2
fn help_asked(rest: List<String>) -> Said {
    match list.at(rest, 0) {
        Some(name) => help_named(name, after(rest, 1))
        None => Said { output: top_long_help(), errors: "", status: 0 }
    }
}

// example: list.length(after([1, 2, 3], 1)) == 2
fn after<T>(values: List<T>, index: Int) -> List<T> {
    var rest = []
    var at = index
    for at < list.length(values) {
        rest = match list.at(values, at) {
            Some(value) => list.push(rest, value)
            None => rest
        }
        at += 1
    }
    rest
}

// example: help_named("fmt", ["x"]).errors == "error: unrecognized subcommand 'x'\n\nUsage: bux fmt <FILE>\n\nFor more information, try '--help'.\n"
fn help_named(name: String, more: List<String>) -> Said {
    match subcommand_named(name) {
        Some(sub) => help_of_command(sub, more)
        None => help_of_topic(name, more)
    }
}

// example: help_of_topic("process", []).status == 0
// example: help_of_topic("proces", []).status == 2
fn help_of_topic(name: String, more: List<String>) -> Said {
    if name != "process" {
        return complained(Complaint { message: "unrecognized subcommand '" + name + "'", tip: None, usage: "bux <COMMAND>", offers_help: true })
    }
    match list.at(more, 0) {
        Some(extra) => complained(Complaint { message: "unrecognized subcommand '" + extra + "'", tip: None, usage: "bux help process", offers_help: false })
        None => Said { output: topic_text(name), errors: "", status: 0 }
    }
}

// example: or(subcommand_named("check"), help_subcommand()).value == "PATH"
fn subcommand_named(word: String) -> Option<Subcommand> {
    for sub in subcommands() {
        if sub.name == word {
            return Some(sub)
        }
    }
    None
}

// example: help_of_command(help_subcommand(), []).output == "Print this message or the help of the given subcommand(s)\n\nUsage: bux help [COMMAND]...\n\nArguments:\n  [COMMAND]...  Print help for the subcommand(s)\n"
fn help_of_command(sub: Subcommand, more: List<String>) -> Said {
    match list.at(more, 0) {
        Some(extra) => complained(Complaint { message: "unrecognized subcommand '" + extra + "'", tip: None, usage: sub.usage, offers_help: list.has_value(sub.longs, "help") })
        None => Said { output: long_help(sub), errors: "", status: 0 }
    }
}

// example: complained(Complaint { message: "m", tip: Some("t"), usage: "u", offers_help: false }).errors == "error: m\n\n  tip: t\n\nUsage: u\n"
fn complained(complaint: Complaint) -> Said {
    var written = "error: " + complaint.message + "\n"
    written += tip_line(complaint.tip)
    written += "\nUsage: " + complaint.usage + "\n"
    if complaint.offers_help {
        written += "\nFor more information, try '--help'.\n"
    }
    Said { output: "", errors: written, status: 2 }
}

// example: tip_line(None) == ""
fn tip_line(tip: Option<String>) -> String {
    match tip {
        Some(text) => "\n  tip: " + text + "\n"
        None => ""
    }
}

// example: has_prefix(text: top_short_help(), opening: "The Bux compiler")
fn top_short_help() -> String {
    "The Bux compiler: Go's simplicity, Haskell's types, the JVM's runtime\n\nUsage: bux <COMMAND>\n\nCommands:\n" + commands_listed() + "\n\nOptions:\n  -h, --help     Print help (see more with '--help')\n  -V, --version  Print version\n"
}

// example: has_prefix(text: top_long_help(), opening: "")
fn top_long_help() -> String {
    topic_text("bux") + "\n\nUsage: bux <COMMAND>\n\nCommands:\n" + commands_listed() + "\n\nOptions:\n  -h, --help\n          Print help (see a summary with '-h')\n\n  -V, --version\n          Print version\n"
}

// example: has_prefix(text: commands_listed(), opening: "  fmt      Rewrite")
fn commands_listed() -> String {
    var lines = []
    for sub in subcommands() {
        lines = list.push(lines, "  " + sub.name + repeated(text: " ", times: 7 - strings.length(sub.name)) + "  " + sub.about)
    }
    strings.join(lines, "\n")
}

// example: repeated(text: "^", times: 3) == "^^^"
fn repeated(text: String, times: Int) -> String {
    var written = ""
    var count = 0
    for count < times {
        written += text
        count += 1
    }
    written
}

// example: short_help(or(subcommand_named("fmt"), help_subcommand())) == "Rewrite a source file in canonical form\n\nUsage: bux fmt <FILE>\n\nArguments:\n  <FILE>  \n\nOptions:\n  -h, --help  Print help (see more with '--help')\n"
fn short_help(sub: Subcommand) -> String {
    var options = ""
    if list.has_value(sub.longs, "json") {
        options = "      --json  Write the refusal as one line of JSON on standard output, edit included\n"
    }
    sub.about + "\n\nUsage: " + sub.usage + "\n\nArguments:\n  " + argument_written(sub) + "  \n\nOptions:\n" + options + "  -h, --help  Print help (see more with '--help')\n"
}

// example: strings.length(long_help(or(subcommand_named("run"), help_subcommand()))) > 0
fn long_help(sub: Subcommand) -> String {
    if sub.name == "help" {
        return "Print this message or the help of the given subcommand(s)\n\nUsage: bux help [COMMAND]...\n\nArguments:\n  [COMMAND]...  Print help for the subcommand(s)\n"
    }
    var topics = ""
    for topic in sub.topics {
        topics += topic_text(topic)
    }
    let written = topics + "\n\nUsage: " + sub.usage + "\n\nArguments:\n  " + argument_written(sub) + "\n          \n\n"
    if sub.name == "run" {
        return written + "  [ARGUMENTS]...\n          The words the program is run with, which reach it as the list `main` takes\n"
    }
    var options = "Options:\n"
    if list.has_value(sub.longs, "json") {
        options += "      --json\n          Write the refusal as one line of JSON on standard output, edit included\n\n"
    }
    written + options + "  -h, --help\n          Print help (see a summary with '-h')\n"
}

// example: argument_written(or(subcommand_named("test"), help_subcommand())) == "[PATH]"
// example: argument_written(or(subcommand_named("fmt"), help_subcommand())) == "<FILE>"
fn argument_written(sub: Subcommand) -> String {
    match sub.absent {
        Some(_) => "[" + sub.value + "]"
        None => "<" + sub.value + ">"
    }
}

// example: topic_text("no-such-topic") == ""
fn topic_text(topic: String) -> String {
    or(modules.resource_text("help/" + topic + ".md"), "")
}

// example: list.length(subcommands()) == 8
fn subcommands() -> List<Subcommand> {
    [Subcommand { name: "fmt", about: "Rewrite a source file in canonical form", value: "FILE", absent: None, usage: "bux fmt <FILE>", topics: ["fmt"], longs: ["help"] }, Subcommand { name: "check", about: "Report the first thing about a source file or a package the compiler will not have", value: "PATH", absent: None, usage: "bux check [OPTIONS] <PATH>", topics: ["check", "packages"], longs: ["json", "help"] }, Subcommand { name: "build", about: "Compile a source file or a package to the class files a JVM loads", value: "PATH", absent: None, usage: "bux build <PATH>", topics: ["build", "packages"], longs: ["help"] }, Subcommand { name: "run", about: "Compile a source file and run the program it holds", value: "FILE", absent: None, usage: "bux run <FILE> [ARGUMENTS]...", topics: ["run"], longs: [] }, Subcommand { name: "test", about: "Run the examples and the tests of a module or a package", value: "PATH", absent: Some("."), usage: "bux test [PATH]", topics: ["test"], longs: ["help"] }, Subcommand { name: "api", about: "Print the public surface of a module", value: "FILE", absent: None, usage: "bux api <FILE>", topics: ["api"], longs: ["help"] }, Subcommand { name: "explain", about: "Print the long form of one diagnostic code", value: "CODE", absent: None, usage: "bux explain <CODE>", topics: ["explain"], longs: ["help"] }, help_subcommand()]
}

// example: help_subcommand().name == "help"
fn help_subcommand() -> Subcommand {
    Subcommand { name: "help", about: "Print this message or the help of the given subcommand(s)", value: "COMMAND", absent: None, usage: "bux help [COMMAND]...", topics: [], longs: [] }
}

// example: or(most_similar("hlp", ["json", "help"]), "") == "help"
fn most_similar(written: String, known: List<String>) -> Option<String> {
    let similar = all_similar(written, known)
    list.at(similar, list.length(similar) - 1)
}

// The bound 0.7 on the Jaro similarity is the one that the Rust argument parser used.
// example: all_similar("tst", ["fmt", "test"]) == ["test"]
fn all_similar(written: String, known: List<String>) -> List<String> {
    var found = []
    for name in known {
        let score = jaro(Compared { written: written, known: name })
        if score.numerator * 10 > score.denominator * 7 {
            found = placed_by_score(found, Scored { name: name, score: score })
        }
    }
    var names = []
    for one in found {
        names = list.push(names, one.name)
    }
    names
}

// example: list.length(placed_by_score([], Scored { name: "a", score: Score { numerator: 1, denominator: 1 } })) == 1
fn placed_by_score(found: List<Scored>, one: Scored) -> List<Scored> {
    var placed = []
    var done = false
    for other in found {
        if !done && is_higher(score: other.score, than: one.score) {
            placed = list.push(placed, one)
            done = true
        }
        placed = list.push(placed, other)
    }
    if !done {
        placed = list.push(placed, one)
    }
    placed
}

// example: is_higher(score: Score { numerator: 2, denominator: 3 }, than: Score { numerator: 1, denominator: 2 })
fn is_higher(score: Score, than: Score) -> Bool {
    score.numerator * than.denominator > than.numerator * score.denominator
}

// example: is_higher(score: jaro(Compared { written: "chek", known: "check" }), than: Score { numerator: 7, denominator: 10 })
// example: jaro(Compared { written: "", known: "" }).numerator == 1
fn jaro(compared: Compared) -> Score {
    let written_length = strings.length(compared.written)
    let known_length = strings.length(compared.known)
    if written_length == 0 && known_length == 0 {
        return Score { numerator: 1, denominator: 1 }
    }
    if written_length == 0 || known_length == 0 {
        return Score { numerator: 0, denominator: 1 }
    }
    let matched = matches_of(compared)
    let count = list.length(matched.written)
    if count == 0 {
        return Score { numerator: 0, denominator: 1 }
    }
    let swapped = or(transpositions(compared, matched) / 2, 0)
    Score { numerator: count * count * known_length + count * count * written_length + (count - swapped) * written_length * known_length, denominator: 3 * written_length * known_length * count }
}

// example: list.length(matches_of(Compared { written: "chek", known: "check" }).written) == 4
fn matches_of(compared: Compared) -> Matched {
    let written_length = strings.length(compared.written)
    let known_length = strings.length(compared.known)
    let reach = larger(one: or(larger(one: written_length, other: known_length) / 2, 0) - 1, other: 0)
    var taken = set.empty()
    var written_matched = []
    var index = 0
    for index < written_length {
        let letter = or(strings.at(compared.written, index), 0)
        var other = larger(one: index - reach, other: 0)
        for other < smaller(one: known_length, other: index + reach + 1) {
            if !set.has_value(taken, other) && or(strings.at(compared.known, other), 0) == letter {
                taken = set.insert(taken, other)
                written_matched = list.push(written_matched, index)
                break
            }
            other += 1
        }
        index += 1
    }
    var known_matched = []
    var at = 0
    for at < known_length {
        if set.has_value(taken, at) {
            known_matched = list.push(known_matched, at)
        }
        at += 1
    }
    Matched { written: written_matched, known: known_matched }
}

// example: smaller(one: 2, other: 3) == 2
fn smaller(one: Int, other: Int) -> Int {
    if other < one {
        return other
    }
    one
}

// example: larger(one: 2, other: 3) == 3
fn larger(one: Int, other: Int) -> Int {
    if other > one {
        return other
    }
    one
}

// example: transpositions(Compared { written: "ab", known: "ba" }, Matched { written: [0, 1], known: [0, 1] }) == 2
fn transpositions(compared: Compared, matched: Matched) -> Int {
    var count = 0
    var index = 0
    for index < list.length(matched.written) {
        let one = or(strings.at(compared.written, or(list.at(matched.written, index), 0)), 0)
        let other = or(strings.at(compared.known, or(list.at(matched.known, index), 0)), 0)
        if one != other {
            count += 1
        }
        index += 1
    }
    count
}

// The JVM gives a read failure in its own words, so this function finds the reason from the path.
// example: read_refusal("no-such-directory/a.bx") == "No such file or directory (os error 2)"
fn read_refusal(path: String) -> String {
    let place = files.named(path)
    if files.is_there(place) && !files.is_readable(place) {
        return "Permission denied (os error 13)"
    }
    if files.is_directory(place) {
        return "Is a directory (os error 21)"
    }
    if files.is_there(place) {
        return "stream did not contain valid UTF-8"
    }
    if is_under_a_file(path) {
        return "Not a directory (os error 20)"
    }
    "No such file or directory (os error 2)"
}

// example: write_refusal("no-such-directory/a.bx") == "No such file or directory (os error 2)"
fn write_refusal(path: String) -> String {
    if files.is_directory(files.named(path)) {
        return "Is a directory (os error 21)"
    }
    if is_under_a_file(path) {
        return "Not a directory (os error 20)"
    }
    if !files.is_directory(files.named(modules.directory_of(path))) {
        return "No such file or directory (os error 2)"
    }
    "Permission denied (os error 13)"
}

// example: making_refusal("/") == "File exists (os error 17)"
fn making_refusal(path: String) -> String {
    if files.is_there(files.named(path)) {
        return "File exists (os error 17)"
    }
    if is_under_a_file(path) {
        return "Not a directory (os error 20)"
    }
    "Permission denied (os error 13)"
}

// example: has_trailing_slash("a/")
fn has_trailing_slash(path: String) -> Bool {
    or(strings.at(path, strings.length(path) - 1), 0) == 47
}

// example: !is_under_a_file("no-such-directory/a.bx")
fn is_under_a_file(path: String) -> Bool {
    var above = files.parent_path(files.named(path))
    for is_stated(above) {
        let place = files.named(or(above, ""))
        if files.is_there(place) && !files.is_directory(place) {
            return true
        }
        above = files.parent_path(place)
    }
    false
}

// example: is_stated(Some("1 == 1"))
fn is_stated(expression: Option<String>) -> Bool {
    match expression {
        Some(_) => true
        None => false
    }
}

type Answer =
    | Spoken(Said)
    | Starts(List<String>)

derive Eq for Command

derive Eq for Form

type Parsed =
    | Told(Said)
    | Asked(Command)
    | Running(Started)

type Tested = {
    tried: Tried
    memo: Memo
}

type Named = {
    module: String
    classes: Result<List<jvm.ClassFile>, NotCompiled>
}

type Pooled =
    | Joined(Process<Work, Working>)
    | Finished(Answered, Process<Work, Working>)
    | Left

type Work =
    | Give(Handed)
    | Stop

type Handed = {
    number: Int
    path: String
    worker: Process<Work, Working>
}

type Answered = {
    number: Int
    tried: Tried
}

type Working = {
    pool: Process<Pooled, Pooling>
    typing: Typing
}

type Pooling = {
    paths: List<String>
    handed: Int
    answers: map.Map<Int, Tried>
    workers: Int
}

type Tried = {
    said: Said
    tests: Int
    examples: Int
    failed: Int
}

type Said = {
    output: String
    errors: String
    status: Int
}

type Command =
    | Fmt(String)
    | Check {
        path: String
        form: Form
    }
    | Build(String)
    | Test(String)
    | Api(String)
    | Explain(String)

type Checking = {
    path: String
    form: Form
}

type Over =
    | CheckingAs(Form)
    | Building

type Form =
    | AsPage
    | AsData

type Started = {
    file: String
    arguments: List<String>
}

type Built = {
    module: String
    target: String
    archives: List<String>
    starts: Bool
}

type Checked = {
    modules: List<Typed>
    root: Typed
}

type Memoed<T> = {
    found: Result<T, NotCompiled>
    memo: Memo
}

type Typing = {
    library: ir.Library
    memo: Memo
}

// A module is whole when it holds no hole and each of its functions states an example.
type Memo = {
    typed: map.Map<String, Typed>
    whole: set.Set<String>
}

type Typed = {
    module: modules.Module
    inferred: infer.Inference
}

type NotCompiled =
    | Unusable(String)
    | Refused(Refusal)

type Refusal = {
    diagnostics: List<Diagnostic>
    page: Page
}

type Page = {
    source: String
    path: String
}

type Diagnostic = {
    code: String
    message: String
    span: lexer.Span
    help: Option<String>
    fix: Option<Fix>
}

type Fix = {
    span: lexer.Span
    text: String
}

type Beside = {
    java: String
    module: String
    beside: String
    archives: List<String>
}

derive Eq for RootForm

type Accepting = {
    imported: surface.Imported
    form: RootForm
    archived: set.Set<String>
}

type RootForm =
    | ToCanonicalForm
    | AsWritten

type Commented = {
    measured: Measured
    comments: List<lexer.Token>
}

type Measured = {
    source: String
    starts: List<Int>
}

type Stretched = {
    from: Int
    to: Int
}

type Run = {
    source: String
    stretches: List<Placed>
    examples: List<Example>
    tests: List<ast.TestDeclaration>
    module: lexer.Span
}

type Trying = {
    examples: List<Example>
    tests: List<ast.TestDeclaration>
}

type Example = {
    of: String
    expression: String
    span: lexer.Span
}

type Writing = {
    source: String
    bytes: Int
    stretches: List<Placed>
}

type Stretch = {
    text: String
    about: About
}

type Placed = {
    span: lexer.Span
    about: About
}

type About =
    | SameText(Int)
    | OneExample(Int)
    | WholeModule

type Pointed = {
    line: Int
    column: Int
    text: String
    width: Int
    padding: String
    note: String
}

type Lines = {
    first: Int
    last: Int
}

type Subcommand = {
    name: String
    about: String
    value: String
    absent: Option<String>
    usage: String
    topics: List<String>
    longs: List<String>
}

type Flagged = {
    word: String
    used: List<String>
}

type Held = {
    long: Long
    used: List<String>
}

type Long = {
    name: String
    value: Option<String>
}

type Given = {
    value: String
    used: List<String>
}

type Complaint = {
    message: String
    tip: Option<String>
    usage: String
    offers_help: Bool
}

type Scored = {
    name: String
    score: Score
}

// A score is a fraction, so a comparison of two scores is exact.
type Score = {
    numerator: Int
    denominator: Int
}

type Compared = {
    written: String
    known: String
}

type Matched = {
    written: List<Int>
    known: List<Int>
}
