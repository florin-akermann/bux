// Lowering: each typed module turned into the classes of the JVM, as instructions over a stack.
//
// `docs/specs/codegen.md` states the rules, and `tests/lowering.bx` holds them on drawn modules.
// A module gives its own class, one class for each type it declares, and the class of a list.
// A generic is written once for each set of types a use settles it on, which a pass asks for.
// The passes go on until no module asks another for a method it has not written.
import ast
import declared
import exhaustiveness
import holes
import infer
import lexer
import list
import map
import modules
import parser
import resolver
import set
import strings
import surface
import types
import unify

// A program that holds a hole is skipped, because a build refuses a hole.
// example: list.length(ok_or(program_lowered("no-such-directory/main.bx", little_library()), [])) == 0
fn program_lowered(path: String, library: Library) -> Result<List<Lowered>, exhaustiveness.Unchecked> {
    match modules.load(path) {
        Ok(loaded) => checked_lowered(exhaustiveness.modules_checked(loaded, library.prelude), library)
        Err(_) => Err(exhaustiveness.Skipped)
    }
}

// example: list.length(ok_or(checked_lowered(Err(exhaustiveness.Skipped), little_library()), [])) == 0
fn checked_lowered(checked: Result<List<infer.Inference>, exhaustiveness.Unchecked>, library: Library) -> Result<List<Lowered>, exhaustiveness.Unchecked> {
    let typed = checked?
    for module in typed {
        if list.length(holes.of_module(module.resolved)) > 0 {
            return Err(exhaustiveness.Skipped)
        }
    }
    Ok(passes_lowered(typed, library))
}

// A module lowered before another asks it for a generic did not write it, so a pass runs again.
// The modules are lowered last first, so a module is lowered after each module that imports it.
// example: list.length(passes_lowered([], little_library())) == 1
fn passes_lowered(typed: List<infer.Inference>, library: Library) -> List<Lowered> {
    let homes = module_homes(typed)
    var asked = no_asks()
    for {
        let pass = pass_over(typed, library, homes, asked)
        if !is_asking_more(pass) {
            return reversed(pass.lowered)
        }
        asked = pass.asked
    }
    []
}

// example: list.length(pass_over([], little_library(), only_the_prelude(), no_asks()).knew) == 1
fn pass_over(typed: List<infer.Inference>, library: Library, homes: map.Map<String, Module>, asked: Asked) -> Pass {
    var pass = Pass { lowered: [], asked: asked, knew: [] }
    for module in reversed(typed) {
        let naming = naming_in(pass, homes, module.resolved.module)
        pass = pass_added(pass, naming.module, lowered_module(module, library, naming, pass.asked))
    }
    pass_added(pass, "prelude", lowered_prelude(library, homes, pass.asked))
}

// example: naming_in(Pass { lowered: [], asked: no_asks(), knew: [] }, only_the_prelude(), "prelude").home == OfTheProgram("prelude")
// example: naming_in(Pass { lowered: [], asked: no_asks(), knew: [] }, only_the_prelude(), "prelude").module == "prelude$"
// example: naming_in(Pass { lowered: [no_lowered()], asked: no_asks(), knew: [] }, only_the_prelude(), "prelude").home == ThePrelude
fn naming_in(pass: Pass, homes: map.Map<String, Module>, name: String) -> Naming {
    if list.length(pass.lowered) == 0 {
        return Naming { module: root_spelled(homes, name), home: OfTheProgram(name), homes: homes }
    }
    Naming { module: name, home: module_named(homes, name), homes: homes }
}

// A name the library carries names its module, because an import reaches the library before a file.
// example: module_named(module_homes([]), "prelude") == ThePrelude
// example: module_named(module_homes([types.checked_of("")]), "main") == OfTheProgram("main")
fn module_homes(typed: List<infer.Inference>) -> map.Map<String, Module> {
    var homes = only_the_prelude()
    let last = list.length(typed) - 1
    var index = 0
    for module in typed {
        let name = module.resolved.module
        if index < last && is_carried(name) {
            homes = library_module_added(homes, name)
        }
        index += 1
    }
    match list.at(typed, last) {
        Some(root) => root_module_added(homes, root.resolved.module)
        None => homes
    }
}

// example: module_named(root_module_added(only_the_prelude(), "prelude"), "prelude$") == OfTheProgram("prelude")
// example: module_named(root_module_added(only_the_prelude(), "main"), "main") == OfTheProgram("main")
fn root_module_added(homes: map.Map<String, Module>, name: String) -> map.Map<String, Module> {
    let spelled = root_spelled(homes, name)
    if spelled == name {
        return homes
    }
    map.insert(homes, spelled, OfTheProgram(name))
}

// example: !is_carried("lexer")
fn is_carried(name: String) -> Bool {
    match modules.carried(name) {
        Some(_) => true
        None => false
    }
}

// A type is spelled with the name of its module, so a `$` tells this module from a library module.
// example: root_spelled(only_the_prelude(), "prelude") == "prelude$"
// example: root_spelled(only_the_prelude(), "main") == "main"
fn root_spelled(homes: map.Map<String, Module>, name: String) -> String {
    match map.get(homes, name) {
        Some(_) => name + "$"
        None => name
    }
}

// example: list.length(pass_added(Pass { lowered: [], asked: no_asks(), knew: [] }, "main", no_lowered()).lowered) == 1
fn pass_added(pass: Pass, module: String, one: Lowered) -> Pass {
    Pass { lowered: list.push(pass.lowered, one), asked: asks_joined(asked: pass.asked, other: one.asks), knew: list.push(pass.knew, Knew { module: module, asked: pass.asked }) }
}

// example: !is_asking_more(Pass { lowered: [], asked: no_asks(), knew: [] })
fn is_asking_more(pass: Pass) -> Bool {
    for knew in pass.knew {
        if is_asked_more_of(asked: pass.asked, module: knew.module, before: knew.asked) {
            return true
        }
    }
    false
}

// example: or(list.at(reversed([1, 2]), 0), 0) == 2
fn reversed<T>(values: List<T>) -> List<T> {
    var turned = []
    var index = list.length(values) - 1
    for index >= 0 {
        turned = match list.at(values, index) {
            Some(value) => list.push(turned, value)
            None => turned
        }
        index = index - 1
    }
    turned
}

// example: list.length(asks_joined(asked: no_asks(), other: Asked { of: [little_ask()] }).of) == 1
fn asks_joined(asked: Asked, other: Asked) -> Asked {
    var joined = asked
    for one in other.of {
        joined = noted(joined, one)
    }
    joined
}

// example: is_asked_more_of(asked: Asked { of: [little_ask()] }, module: "main", before: no_asks())
fn is_asked_more_of(asked: Asked, module: String, before: Asked) -> Bool {
    for one in asked.of {
        if one.module == module && !list.has_value(before.of, one) {
            return true
        }
    }
    false
}

// example: little_ask().function == "pick"
private fn little_ask() -> Specialisation {
    Specialisation { module: "main", function: "pick", settled: [unify.int()], foreign: [] }
}

// example: list.length(no_lowered().classes) == 0
fn no_lowered() -> Lowered {
    Lowered { classes: [], asks: no_asks() }
}

// The prelude is typed as a module is, so inference gives the bodies of its instances.
// example: set.has_value(library_read("type Box = Box\n").types, "Box")
fn library_read(source: String) -> Library {
    let program = ok_or(parser.parse(source), ast.Program { items: [] })
    let prelude = types.prelude_read(source)
    let resolved = ok_or(resolver.prelude_resolved(program), resolver.Resolved { module: "prelude", program: program, found: map.empty() })
    library_of(prelude, resolved)
}

// example: list.length(lowered_module(types.checked_of("fn f() -> Int {\n    1\n}\n"), little_library(), main_naming(), no_asks()).classes) == 8
fn lowered_module(typed: infer.Inference, library: Library, naming: Naming, asked: Asked) -> Lowered {
    lowered(lowering_of(typed, library, naming.module, shapes_of(typed, naming, library)), asked)
}

// example: list.length(lowered_prelude(little_library(), only_the_prelude(), no_asks()).classes) == 8
fn lowered_prelude(library: Library, homes: map.Map<String, Module>, asked: Asked) -> Lowered {
    lowered(lowering_of(library.typed, library, "prelude", prelude_shapes(library, homes)), asked)
}

// example: list.length(lowered(little_lowering("fn f() -> Int {\n    1\n}\n"), no_asks()).classes) == 8
fn lowered(lowering: Lowering, asked: Asked) -> Lowered {
    let reached = lowering { shapes: asked_reached(lowering.shapes, asked, lowering.module) }
    let classed = module_class(reached, asked)
    let written = concatenated(first: concatenated(first: [classed.class], second: shape_classes(reached.shapes)), second: process_classes(classed.lowering))
    Lowered { classes: list.push(written, carrier()), asks: classed.lowering.asks }
}

// Each module that declares a process writes the same class of a handle, as it does for a list.
// example: list.length(process_classes(little_lowering("fn f() -> Int {\n    1\n}\n"))) == 0
fn process_classes(lowering: Lowering) -> List<Class> {
    var classes = []
    for item in lowering.typed.resolved.program.items {
        classes = match item {
            ast.Process(declaration) => list.push(classes, process_class(lowering, declaration))
            _ => classes
        }
    }
    if list.length(classes) == 0 {
        return []
    }
    list.push(classes, handle_class(lowering.shapes))
}

// example: process_class(little_lowering(""), ast.ProcessDeclaration { name: infer.no_name(), functions: [], span: infer.no_name().span, visibility: ast.Public }).implements == [Task]
fn process_class(lowering: Lowering, declaration: ast.ProcessDeclaration) -> Class {
    let started = signature_of_process(lowering, declaration, 0)
    let received = signature_of_process(lowering, declaration, 1)
    let shape = process_shape(ProcessOf { module: lowering.shapes.home, name: declaration.name.text }, started)
    let ran = Ran { module: lowering.shapes.home, named: declaration.name.text, started: started, received: received }
    let methods = [constructor_method(shape, Anything), spawned_method(shape, started), run_method(lowering.shapes, shape, ran)]
    Class { of: shape.class, extends: Anything, extending: Never, implements: [Task], fields: held_fields(shape), methods: methods }
}

// example: list.length(process_shape(counter_process(), Signature { parameters: [Some(Whole)], result: Some(Whole) }).carries) == 3
fn process_shape(class: Kind, started: Signature) -> Shape {
    var carries = []
    var index = 0
    for taken in started.parameters {
        carries = list.push(carries, Carried { name: "argument" + shown(index), of: taken })
        index += 1
    }
    carries = concatenated(first: carries, second: [Carried { name: "mailbox", of: Some(Of(Mailbox)) }, Carried { name: "finished", of: Some(Of(End)) }])
    Shape { class: class, base: class, tag: None, carries: carries }
}

// example: counter_process() == ProcessOf { module: OfTheProgram("main"), name: "Counter" }
private fn counter_process() -> Kind {
    ProcessOf { module: OfTheProgram("main"), name: "Counter" }
}

// `start` runs on the new thread, so `spawn` never waits for it.
// example: spawned_method(process_shape(counter_process(), Signature { parameters: [], result: Some(Whole) }), Signature { parameters: [], result: Some(Whole) }).name == "spawned"
// example: list.length(spawned_method(process_shape(counter_process(), Signature { parameters: [Some(Whole)], result: Some(Whole) }), Signature { parameters: [Some(Whole)], result: Some(Whole) }).parameters) == 1
fn spawned_method(shape: Shape, started: Signature) -> Method {
    var parameters = []
    var loading = []
    for one in taken_values(started.parameters) {
        let argument = Local { name: "argument" + shown(list.length(parameters)), of: one }
        parameters = list.push(parameters, argument)
        loading = list.push(loading, Load(argument))
    }
    let mailbox = Local { name: "mailbox", of: Of(Mailbox) }
    let finished = Local { name: "finished", of: Of(End) }
    let opened = [New(Mailbox), Copy, IntegerOf(mailbox_bound()), Construct { built: Mailbox, taken: [Small] }, Store(mailbox), New(End), Copy, Construct { built: End, taken: [] }, Store(finished)]
    let held = [Load(mailbox), Load(finished)]
    let started_thread = concatenated(first: concatenated(first: concatenated(first: [New(shape.class), Copy], second: loading), second: held), second: [Construct { built: shape.class, taken: constructor_taken(shape) }, Started])
    let handed_back = concatenated(first: concatenated(first: [New(handle_kind()), Copy], second: held), second: [Construct { built: handle_kind(), taken: constructor_taken(handle_shape()) }, Return(Some(handle_value()))])
    let body = Body { instructions: concatenated(first: concatenated(first: opened, second: started_thread), second: handed_back), locals: [mailbox, finished], guards: [] }
    Method { name: "spawned", parameters: parameters, result: Some(handle_value()), reached: ThroughTheClass, body: body }
}

// example: run_method(no_shapes(), process_shape(counter_process(), Signature { parameters: [], result: Some(Whole) }), Ran { module: OfTheProgram("main"), named: "Counter", started: Signature { parameters: [], result: Some(Whole) }, received: Signature { parameters: [Some(Whole), Some(Whole)], result: Some(anything()) } }).name == "run"
fn run_method(shapes: Shapes, shape: Shape, ran: Ran) -> Method {
    let this = Local { name: "this", of: Of(shape.class) }
    let held = Local { name: "held", of: anything() }
    let message = Local { name: "message", of: anything() }
    let next = Local { name: "next", of: next_value() }
    var starting = []
    for carried in shape.carries {
        starting = match carried.of {
            Some(of) => if carried.name != "mailbox" && carried.name != "finished" {
                concatenated(first: starting, second: [Load(this), GetField(FieldRef { owner: shape.class, name: carried.name, of: of })])
            } else {
                starting
            }
            None => starting
        }
    }
    let module = ModuleOf(ran.module)
    let named = ran.named
    let started = concatenated(first: list.push(starting, Call(function_of(owner: module, name: named + "$start", signature: ran.started))), second: as_object(ran.started.result))
    let taking = [Store(held), Label(0), Load(this), GetField(FieldRef { owner: shape.class, name: "mailbox", of: Of(Mailbox) }), Taken, Opened, Store(message)]
    let receiving = concatenated(first: concatenated(first: object_as(held, or(list.at(ran.received.parameters, 0), None)), second: object_as(message, or(list.at(ran.received.parameters, 1), None))), second: [Call(function_of(owner: module, name: named + "$receive", signature: ran.received)), Store(next)])
    let again = built_shape(shapes, "Continue")
    let tested = carrying_tag(again, next, 1)
    let kept = concatenated(first: [Load(next), Cast(again.class), GetField(FieldRef { owner: again.class, name: first_carried_name(again), of: or(first_carried(again), anything()) })], second: as_object(first_carried(again)))
    let ending = [Store(held), Jump(0), Label(1), Load(this), GetField(FieldRef { owner: shape.class, name: "finished", of: Of(End) }), Load(held), Completed, Return(None)]
    let instructions = concatenated(first: concatenated(first: concatenated(first: concatenated(first: [Label(2)], second: started), second: taking), second: concatenated(first: receiving, second: tested)), second: concatenated(first: concatenated(first: kept, second: ending), second: failed_end(shape)))
    let guard = Guard { from: 2, to: 4, handler: 4, catching: Failure }
    let written = Guard { from: 5, to: 6, handler: 6, catching: Failure }
    Method { name: "run", parameters: [], result: None, reached: ThroughAnInstance, body: Body { instructions: instructions, locals: [held, message, next], guards: [guard, written] } }
}

// The throwable is written before the end completes, so whoever learns of the end finds it written.
// A throw out of the write itself is dropped, so the end completes whatever the write does.
// example: list.length(failed_end(process_shape(counter_process(), Signature { parameters: [], result: Some(Whole) }))) == 14
fn failed_end(shape: Shape) -> List<Instruction> {
    let thrown = Local { name: "held", of: Of(Failure) }
    [Label(4), Store(thrown), Label(5), Load(thrown), FailureWritten, Jump(7), Label(6), Drop(Of(Failure)), Label(7), Load(Local { name: "this", of: Of(shape.class) }), GetField(FieldRef { owner: shape.class, name: "finished", of: Of(End) }), Load(thrown), CompletedWithFailure, Return(None)]
}

// example: list.length(object_as(Local { name: "held", of: anything() }, None)) == 0
fn object_as(local: Local, wanted: Option<Value>) -> List<Instruction> {
    match wanted {
        Some(of) => concatenated(first: [Load(local)], second: converted(held: anything(), wanted: of))
        None => []
    }
}

// example: list.length(handle_class(no_shapes()).methods) == 2
fn handle_class(shapes: Shapes) -> Class {
    let shape = handle_shape()
    Class { of: shape.class, extends: Anything, extending: Never, implements: [], fields: held_fields(shape), methods: [constructor_method(shape, Anything), sent_method(shapes)] }
}

// A wait without limit looks for the end every tenth of a second, so the sender learns of it.
// example: sent_method(no_shapes()).name == "sent"
// example: list.length(sent_method(no_shapes()).parameters) == 3
fn sent_method(shapes: Shapes) -> Method {
    let waiting = Local { name: "waiting", of: named_value(shapes, "Waiting") }
    let limit = Local { name: "limit", of: Whole }
    let opened = concatenated(first: ended_test(shapes, 0), second: concatenated(first: [Label(0)], second: enveloped()))
    let unlimited = concatenated(first: carrying_tag(built_shape(shapes, "NoLimit"), waiting, 2), second: [Label(1)])
    let offered = concatenated(first: offer_within(within: [LongOf(100)], shapes: shapes, missed: 5, taken: 7), second: [Label(5)])
    let again = concatenated(first: ended_test(shapes, 1), second: [Label(2), LongOf(0), Store(limit)])
    let timed = built_shape(shapes, "Milliseconds")
    let limited = concatenated(first: carrying_tag(timed, waiting, 3), second: [Load(waiting), Cast(timed.class), GetField(FieldRef { owner: timed.class, name: first_carried_name(timed), of: or(first_carried(timed), Whole) }), Store(limit), Label(3)])
    let bounded = concatenated(first: offer_within(within: [Load(limit)], shapes: shapes, missed: 4, taken: 8), second: concatenated(first: [Label(4)], second: ended_test(shapes, 6)))
    let full = concatenated(first: [Label(6)], second: sent_answer(shapes, "MailboxFull"))
    let instructions = concatenated(first: concatenated(first: concatenated(first: opened, second: unlimited), second: concatenated(first: offered, second: again)), second: concatenated(first: concatenated(first: limited, second: bounded), second: full))
    let parameters = [sent_handle(), sent_message(), waiting]
    Method { name: "sent", parameters: parameters, result: Some(named_value(shapes, "Sent")), reached: ThroughTheClass, body: Body { instructions: instructions, locals: [limit], guards: [] } }
}

// example: list.length(enveloped()) == 5
fn enveloped() -> List<Instruction> {
    [New(Envelope), Copy, Load(sent_message()), Construct { built: Envelope, taken: [anything()] }, Store(sent_message())]
}

// example: list.length(offer_within(within: [LongOf(0)], shapes: no_shapes(), missed: 0, taken: 1)) == 24
fn offer_within(within: List<Instruction>, shapes: Shapes, missed: Int, taken: Int) -> List<Instruction> {
    let loaded = concatenated(first: [Load(sent_handle()), GetField(handle_mailbox()), Load(sent_message())], second: within)
    concatenated(first: concatenated(first: loaded, second: [Offered, JumpIfFalse(missed)]), second: taken_answer(shapes, taken))
}

// No process reads the mailbox of an ended process, so `remove` takes out an envelope left there.
// The envelope is found by its identity, because an equal message can wait in the same mailbox.
// example: list.length(taken_answer(no_shapes(), 1)) == 18
fn taken_answer(shapes: Shapes, taken: Int) -> List<Instruction> {
    let left = [Load(sent_handle()), GetField(handle_mailbox()), Load(sent_message()), Removed, JumpIfFalse(taken)]
    let answered = concatenated(first: list.push(sent_answer(shapes, "ProcessEnded"), Label(taken)), second: sent_answer(shapes, "Delivered"))
    concatenated(first: concatenated(first: unended_jump(taken), second: left), second: answered)
}

// example: sent_message().name == "message"
fn sent_message() -> Local {
    Local { name: "message", of: anything() }
}

// example: list.length(ended_test(no_shapes(), 0)) == 8
fn ended_test(shapes: Shapes, open: Int) -> List<Instruction> {
    concatenated(first: unended_jump(open), second: sent_answer(shapes, "ProcessEnded"))
}

// example: list.length(unended_jump(0)) == 4
fn unended_jump(open: Int) -> List<Instruction> {
    [Load(sent_handle()), GetField(handle_finished()), IsEnded, JumpIfFalse(open)]
}

// example: sent_handle().name == "handle"
fn sent_handle() -> Local {
    Local { name: "handle", of: handle_value() }
}

// example: list.length(sent_answer(no_shapes(), "Delivered")) == 4
fn sent_answer(shapes: Shapes, named: String) -> List<Instruction> {
    let shape = built_shape(shapes, named)
    [New(shape.class), Copy, Construct { built: shape.class, taken: constructor_taken(shape) }, Return(Some(named_value(shapes, "Sent")))]
}

// example: list.length(handle_shape().carries) == 2
fn handle_shape() -> Shape {
    Shape { class: handle_kind(), base: handle_kind(), tag: None, carries: [Carried { name: "mailbox", of: Some(Of(Mailbox)) }, Carried { name: "finished", of: Some(Of(End)) }] }
}

// example: next_value() == Of(TypeOf { module: ThePrelude, name: "Next" })
fn next_value() -> Value {
    Of(TypeOf { module: ThePrelude, name: "Next" })
}

// example: mailbox_bound() == 64
fn mailbox_bound() -> Int {
    64
}

// example: list.length(module_class(little_lowering("fn f() -> Int {\n    1\n}\n"), no_asks()).class.methods) == 1
fn module_class(lowering: Lowering, asked: Asked) -> Classed {
    let owing = every_asked_owed(every_plain_owed(lowering), asked)
    let written = methods_owed(owing)
    let methods = concatenated(first: written.methods, second: entry_point(written.lowering))
    Classed { lowering: written.lowering, class: Class { of: ModuleOf(owing.shapes.home), extends: Anything, extending: Never, implements: [], fields: [], methods: methods } }
}

// example: list.length(every_plain_owed(little_lowering("fn f() -> Int {\n    1\n}\n")).owed) == 1
fn every_plain_owed(lowering: Lowering) -> Lowering {
    let program = lowering.typed.resolved.program
    var owing = lowering
    for function in infer.functions_of(program) {
        if list.length(function.type_parameters) == 0 || function.name.text == "main" {
            owing = plainly_owed(owing, function.name.span)
        }
    }
    for derived in derived_in(program) {
        owing = plainly_owed(owing, derived.named.span)
    }
    for item in program.items {
        owing = extern_owed(owing, item)
    }
    owing
}

// example: list.length(extern_owed(little_lowering(""), declared.first_item("type Box = Box\n")).owed) == 0
fn extern_owed(lowering: Lowering, item: ast.Item) -> Lowering {
    match item {
        ast.Extern(declaration) => plainly_owed(lowering, declaration.name.span)
        _ => lowering
    }
}

// example: list.length(every_asked_owed(little_lowering(""), no_asks()).owed) == 0
fn every_asked_owed(lowering: Lowering, asked: Asked) -> Lowering {
    var owing = lowering
    for one in asked.of {
        if one.module == lowering.module {
            owing = one_asked_owed(owing, one)
        }
    }
    owing
}

// example: list.length(one_asked_owed(little_lowering(""), little_ask()).owed) == 0
fn one_asked_owed(lowering: Lowering, one: Specialisation) -> Lowering {
    match instance_named(lowering, one.function) {
        Some(answers) => instance_method(lowering, answers, one.settled).lowering
        None => function_asked_owed(lowering, one)
    }
}

// example: list.length(function_asked_owed(little_lowering("fn pick<T>(value: T) -> T {\n    value\n}\n"), little_ask()).owed) == 1
fn function_asked_owed(lowering: Lowering, one: Specialisation) -> Lowering {
    match function_named(lowering, one.function) {
        Some(function) => settled_function_owed(lowering, function, one.settled)
        None => lowering
    }
}

// example: list.length(settled_function_owed(little_lowering(""), no_function(), []).owed) == 1
fn settled_function_owed(lowering: Lowering, function: ast.FunctionDeclaration, settled: List<unify.Type>) -> Lowering {
    let at = asked_for(function, settled)
    owe(lowering, function.name.span, instantiation_names(at, named_at(lowering, function.name.span)), at)
}

// example: is_nothing_answered(instance_named(little_lowering(""), "Eq$Box$is_equal"))
fn instance_named(lowering: Lowering, named: String) -> Option<Answers> {
    for answers in lowering.instances {
        if named_at(lowering, answers.declared) == named {
            return Some(answers)
        }
    }
    None
}

// example: is_nothing_answered(None)
private fn is_nothing_answered(answers: Option<Answers>) -> Bool {
    match answers {
        Some(_) => false
        None => true
    }
}

// A body that is written can owe more methods, so this runs until nothing is owed.
// example: list.length(methods_owed(every_plain_owed(little_lowering("fn f() -> Int {\n    1\n}\n"))).methods) == 1
fn methods_owed(lowering: Lowering) -> MethodsWritten {
    var writing = lowering
    var written = set.empty()
    var methods = []
    for writing.next_owed < list.length(writing.owed) {
        let owed = or(list.at(writing.owed, writing.next_owed), Owed { declared: infer.no_name().span, named: "", at: whole() })
        writing = writing { next_owed: writing.next_owed + 1 }
        let signature = signature_of(writing, owed.declared, owed.at)
        let key = owed.named + " " + signature_key(signature)
        if !set.has_value(written, key) {
            written = set.insert(written, key)
            let made = method_written(writing, owed, signature)
            writing = made.lowering
            methods = list.push(methods, made.method)
        }
    }
    MethodsWritten { lowering: writing, methods: methods }
}

// A parameter that nothing carries is left out, because the method never takes it.
// example: signature_key(Signature { parameters: [None, Some(Whole)], result: None }) == "(Whole) ()"
fn signature_key(signature: Signature) -> String {
    var written = "("
    var position = 0
    for taken in taken_values(signature.parameters) {
        if position > 0 {
            written += ", "
        }
        written += value_key(taken)
        position += 1
    }
    written + ") " + held_key(signature.result)
}

// example: method_written(little_lowering(""), Owed { declared: infer.no_name().span, named: "f", at: whole() }, Signature { parameters: [], result: None }).method.name == "f"
fn method_written(lowering: Lowering, owed: Owed, signature: Signature) -> MethodMade {
    let made = body_written(lowering, owed, signature)
    let method = Method { name: owed.named, parameters: parameters_named(signature, made.parameters), result: signature.result, reached: ThroughTheClass, body: made.body }
    MethodMade { lowering: made.lowering, method: method }
}

// example: parameters_named(Signature { parameters: [None, Some(Whole)], result: None }, ["x#0"]) == [Local { name: "x#0", of: Whole }]
// example: parameters_named(Signature { parameters: [Some(Whole)], result: None }, []) == [Local { name: "parameter#0", of: Whole }]
fn parameters_named(signature: Signature, names: List<String>) -> List<Local> {
    var parameters = []
    for of in taken_values(signature.parameters) {
        let position = list.length(parameters)
        parameters = list.push(parameters, Local { name: or(list.at(names, position), "parameter#" + shown(position)), of: of })
    }
    parameters
}

// example: list.length(body_written(little_lowering(""), Owed { declared: infer.no_name().span, named: "f", at: whole() }, Signature { parameters: [], result: None }).body.instructions) == 0
fn body_written(lowering: Lowering, owed: Owed, signature: Signature) -> BodyMade {
    match map.get(lowering.declared, infer.span_key(owed.declared)) {
        Some(written_at) => declared_body(lowering, written_at.body, signature, owed.at)
        None => BodyMade { lowering: lowering, body: empty_body(), parameters: [] }
    }
}

// example: list.length(declared_body(little_lowering(""), FromJava(no_extern()), Signature { parameters: [], result: None }, whole()).body.instructions) > 0
fn declared_body(lowering: Lowering, written: Written, signature: Signature, at: Instantiation) -> BodyMade {
    match written {
        Source(function) => source_body(lowering, function, signature, at)
        FromJava(declaration) => BodyMade { lowering: lowering, body: extern_body(lowering, declaration, signature), parameters: extern_parameters(signature) }
        Derived { of, declaration } => derived_body(lowering, of, declaration)
    }
}

// example: list.length(source_body(little_lowering(""), no_function(), Signature { parameters: [], result: None }, whole()).body.instructions) == 1
// example: source_body(little_lowering(""), no_function(), Signature { parameters: [], result: None }, whole()).parameters == []
fn source_body(lowering: Lowering, function: ast.FunctionDeclaration, signature: Signature, at: Instantiation) -> BodyMade {
    let built = body_built(builder_entering(lowering, function, signature, at), function.body)
    var parameters = []
    var locals = []
    for one in built.locals {
        if list.length(parameters) < built.parameters {
            parameters = list.push(parameters, one.name)
        } else {
            locals = list.push(locals, one)
        }
    }
    BodyMade { lowering: built.lowering, body: Body { instructions: built.instructions, locals: locals, guards: [] }, parameters: parameters }
}

// example: list.length(empty_body().instructions) == 0
fn empty_body() -> Body {
    Body { instructions: [], locals: [], guards: [] }
}

// The low eight bits of what `main` gives back are the code that the process exits with.
// example: list.length(entry_point(little_lowering("fn f() -> Int {\n    1\n}\n"))) == 0
fn entry_point(lowering: Lowering) -> List<Method> {
    match function_named(lowering, "main") {
        Some(function) => entry_of(lowering, function)
        None => []
    }
}

// example: or(function_named(little_lowering("fn f() -> Int {\n    1\n}\n"), "f"), no_function()).name.text == "f"
fn function_named(lowering: Lowering, named: String) -> Option<ast.FunctionDeclaration> {
    for function in infer.functions_of(lowering.typed.resolved.program) {
        if named_at(lowering, function.name.span) == named {
            return Some(function)
        }
    }
    None
}

// example: list.length(entry_of(little_lowering(""), no_function())) == 0
fn entry_of(lowering: Lowering, function: ast.FunctionDeclaration) -> List<Method> {
    let entered = unify.Function { parameters: [unify.list_of(unify.text_type())], result: unify.int() }
    if used_as(lowering, function.name.span) != entered {
        return []
    }
    let started = function_of(owner: ModuleOf(lowering.shapes.home), name: "main", signature: signature_of(lowering, function.name.span, whole()))
    let arguments = Local { name: "arguments", of: arguments_value() }
    let instructions = [Load(arguments), Call(list_built()), Call(started), LowEightBits, Exited, Return(None)]
    [Method { name: "main", parameters: [arguments], result: None, reached: ThroughTheClass, body: Body { instructions: instructions, locals: [], guards: [] } }]
}

// example: !is_started_at(Method { name: "main", parameters: [], result: None, reached: ThroughTheClass, body: empty_body() })
// example: is_started_at(Method { name: "main", parameters: [Local { name: "arguments", of: arguments_value() }], result: None, reached: ThroughTheClass, body: empty_body() })
fn is_started_at(method: Method) -> Bool {
    if method.name != "main" || list.length(method.parameters) != 1 {
        return false
    }
    match list.at(method.parameters, 0) {
        Some(taken) => taken.of == arguments_value()
        None => false
    }
}

// example: arguments_value() == Array(Of(Text))
fn arguments_value() -> Value {
    Array(Of(Text))
}

// example: is_unanswered(Answered { lowering: little_lowering(""), answered_by: None })
private fn is_unanswered(answered: Answered) -> Bool {
    match answered.answered_by {
        Some(_) => false
        None => true
    }
}

// example: is_plain(None)
private fn is_plain(found: Option<ast.FunctionDeclaration>) -> Bool {
    match found {
        Some(_) => false
        None => true
    }
}

// example: list.length(plainly_owed(little_lowering(""), infer.no_name().span).owed) == 1
fn plainly_owed(lowering: Lowering, written_at: lexer.Span) -> Lowering {
    owe(lowering, written_at, named_at(lowering, written_at), whole())
}

// example: no_extern().name.text == ""
private fn no_extern() -> ast.ExternDeclaration {
    ast.ExternDeclaration { name: infer.no_name(), reaches: ast.Constructor, gives: ast.GivesAsDeclared, parameters: [], result: ast.TypeRef { kind: ast.UnitType, span: infer.no_name().span }, span: infer.no_name().span }
}

// example: list.length(little_builder("fn f() -> Int {\n    1\n}\n").locals) == 0
private fn little_builder(source: String) -> Builder {
    let lowering = little_lowering(source)
    let function = or(list.at(infer.functions_of(lowering.typed.resolved.program), 0), no_function())
    builder_entering(lowering, function, signature_of(lowering, function.name.span, whole()), whole())
}

// example: little_builder("fn f(x: Int) -> Int {\n    x\n}\n").parameters == 1
// example: little_builder("fn f(x: Int) -> Int {\n    x\n}\n").locals == [Local { name: "x#0", of: Whole }]
fn builder_entering(lowering: Lowering, function: ast.FunctionDeclaration, signature: Signature, at: Instantiation) -> Builder {
    var builder = Builder { lowering: lowering, instructions: [], bound: map.empty(), locals: [], parameters: 0, next_label: 0, repeat: None, splitting: split(lowering, function), fields: map.empty(), result: signature.result, at: at }
    for parameter in function.parameters {
        builder = declare(builder, parameter.name)
    }
    builder { parameters: list.length(builder.locals) }
}

// example: first_expr("fn f() -> Int {\n    1\n}\n").span.start == 20
private fn first_expr(source: String) -> ast.Expr {
    let function = or(list.at(infer.functions_of(declared.first_program(source)), 0), no_function())
    var found = []
    for statement in function.body.statements {
        found = match statement.kind {
            ast.Evaluated(value) => list.push(found, value)
            _ => found
        }
    }
    or(list.at(found, 0), no_expr())
}

// example: list.length(body_built(little_builder("fn f() -> Int {\n    1\n}\n"), first_function_body("fn f() -> Int {\n    1\n}\n")).instructions) == 2
fn body_built(builder: Builder, block: ast.Block) -> Builder {
    let left = block_built(builder, block)
    let adapted = adapt(builder: left.builder, from: left.held, to: builder.result)
    emit(adapted, Return(builder.result))
}

// example: list.length(first_function_body("fn f() -> Int {\n    1\n}\n").statements) == 1
private fn first_function_body(source: String) -> ast.Block {
    or(list.at(infer.functions_of(declared.first_program(source)), 0), no_function()).body
}

// example: no_function().name.text == ""
private fn no_function() -> ast.FunctionDeclaration {
    ast.FunctionDeclaration { name: infer.no_name(), type_parameters: [], parameters: [], result: None, body: ast.Block { statements: [], span: infer.no_name().span }, span: infer.no_name().span, visibility: ast.Public }
}

// example: is_whole(None)
private fn is_whole(found: Option<lexer.Span>) -> Bool {
    match found {
        Some(_) => false
        None => true
    }
}

// example: method_named(Copy) == ""
private fn method_named(instruction: Instruction) -> String {
    match instruction {
        Call(function) => function.name
        _ => ""
    }
}

// example: is_unheld(None)
private fn is_unheld(found: Option<Local>) -> Bool {
    match found {
        Some(_) => false
        None => true
    }
}

// example: is_unfound(Found { builder: little_builder(""), answered_by: None })
private fn is_unfound(found: Found) -> Bool {
    match found.answered_by {
        Some(_) => false
        None => true
    }
}

// example: is_not_through(None)
private fn is_not_through(found: Option<Through>) -> Bool {
    match found {
        Some(_) => false
        None => true
    }
}

// example: is_unshaped(None)
private fn is_unshaped(found: Option<Shape>) -> Bool {
    match found {
        Some(_) => false
        None => true
    }
}

// example: is_unwritten(None)
private fn is_unwritten(found: Option<Left>) -> Bool {
    match found {
        Some(_) => false
        None => true
    }
}

// A record that only has a field read off it does not escape: `docs/specs/codegen.md` states it.
// example: list.length(split_list(little_lowering("fn f() -> Int {\n    1\n}\n"), no_function())) == 0
fn split(lowering: Lowering, function: ast.FunctionDeclaration) -> set.Set<Int> {
    var splitting = set.empty()
    for one in split_list(lowering, function) {
        splitting = set.insert(splitting, one)
    }
    splitting
}

// example: list.length(split_list(little_lowering(""), no_function())) == 0
fn split_list(lowering: Lowering, function: ast.FunctionDeclaration) -> List<Int> {
    let walk = block_walked(lowering, Escape { built: [], escaped: set.empty() }, function.body)
    var kept = []
    for one in walk.built {
        if !set.has_value(walk.escaped, one) {
            kept = list.push(kept, one)
        }
    }
    kept
}

// example: list.length(block_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, first_function_body("")).built) == 0
fn block_walked(lowering: Lowering, walk: Escape, block: ast.Block) -> Escape {
    var walking = walk
    for statement in block.statements {
        walking = statement_walked(lowering, walking, statement.kind)
    }
    walking
}

// example: list.length(statement_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, ast.Break).built) == 0
fn statement_walked(lowering: Lowering, walk: Escape, kind: ast.StatementKind) -> Escape {
    match kind {
        ast.Binding { mutability, name, value } => bound_walked(lowering, walk, mutability, name, value)
        ast.Assign { target, value } => expr_walked(lowering, let_go_of(lowering, walk, target), value)
        ast.Return(value) => optional_walked(lowering, walk, value)
        ast.For(repeated) => loop_walked(lowering, walk, repeated)
        ast.Discard(value) => expr_walked(lowering, walk, value)
        ast.Evaluated(value) => expr_walked(lowering, walk, value)
        _ => walk
    }
}

// example: list.length(bound_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, ast.Immutable, infer.no_name(), no_expr()).built) == 0
fn bound_walked(lowering: Lowering, walk: Escape, mutability: ast.Mutability, name: ast.Name, value: ast.Expr) -> Escape {
    let walked = expr_walked(lowering, walk, value)
    if is_immutable(mutability) && is_record_literal(lowering, value) {
        return walked { built: list.push(walked.built, infer.span_key(name.span)) }
    }
    walked
}

// example: list.length(loop_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, ast.ForLoop { header: ast.Forever, body: first_function_body("") }).built) == 0
fn loop_walked(lowering: Lowering, walk: Escape, repeated: ast.ForLoop) -> Escape {
    let headed = match repeated.header {
        ast.Forever => walk
        ast.While(condition) => expr_walked(lowering, walk, condition)
        ast.Over { iterable } => expr_walked(lowering, walk, iterable)
    }
    block_walked(lowering, headed, repeated.body)
}

// example: list.length(optional_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, None).built) == 0
fn optional_walked(lowering: Lowering, walk: Escape, value: Option<ast.Expr>) -> Escape {
    match value {
        Some(written) => expr_walked(lowering, walk, written)
        None => walk
    }
}

// example: list.length(expr_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, no_expr()).built) == 0
fn expr_walked(lowering: Lowering, walk: Escape, written: ast.Expr) -> Escape {
    match written.kind {
        ast.NameExpr(name) => let_go_of(lowering, walk, name)
        ast.Unary { operand } => expr_walked(lowering, walk, operand)
        ast.Binary { left, right } => expr_walked(lowering, expr_walked(lowering, walk, left), right)
        ast.Call { callee, arguments } => each_walked(lowering, callee_walked(lowering, walk, callee), infer.values_of(arguments))
        ast.Field { receiver } => receiver_walked(lowering, walk, receiver)
        ast.Try(inner) => expr_walked(lowering, walk, inner)
        ast.Written(elements) => each_walked(lowering, walk, elements)
        ast.Record { base, fields } => fields_walked(lowering, record_base_walked(lowering, walk, base), fields)
        ast.If(chain) => chain_walked(lowering, walk, chain)
        ast.Match(matched) => arms_walked(lowering, expr_walked(lowering, walk, matched.scrutinee), matched.arms)
        ast.Spawn(started) => expr_walked(lowering, walk, started)
        _ => walk
    }
}

// example: list.length(receiver_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, no_expr()).built) == 0
fn receiver_walked(lowering: Lowering, walk: Escape, receiver: ast.Expr) -> Escape {
    match receiver.kind {
        ast.NameExpr(_) => walk
        _ => expr_walked(lowering, walk, receiver)
    }
}

// example: list.length(callee_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, no_expr()).built) == 0
fn callee_walked(lowering: Lowering, walk: Escape, callee: ast.Expr) -> Escape {
    match callee.kind {
        ast.Field {} => walk
        _ => expr_walked(lowering, walk, callee)
    }
}

// example: list.length(each_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, []).built) == 0
fn each_walked(lowering: Lowering, walk: Escape, values: List<ast.Expr>) -> Escape {
    var walking = walk
    for value in values {
        walking = expr_walked(lowering, walking, value)
    }
    walking
}

// example: list.length(fields_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, []).built) == 0
fn fields_walked(lowering: Lowering, walk: Escape, fields: List<ast.FieldValue>) -> Escape {
    var walking = walk
    for field in fields {
        walking = expr_walked(lowering, walking, ast.field_expression(field))
    }
    walking
}

// example: list.length(chain_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, ast.IfExpr { branches: [], otherwise: None }).built) == 0
fn chain_walked(lowering: Lowering, walk: Escape, chain: ast.IfExpr) -> Escape {
    var walking = walk
    for branch in chain.branches {
        walking = block_walked(lowering, expr_walked(lowering, walking, branch.condition), branch.block)
    }
    match chain.otherwise {
        Some(block) => block_walked(lowering, walking, block)
        None => walking
    }
}

// example: list.length(arms_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, []).built) == 0
fn arms_walked(lowering: Lowering, walk: Escape, arms: List<ast.MatchArm>) -> Escape {
    var walking = walk
    for arm in arms {
        walking = expr_walked(lowering, walking, arm.body)
    }
    walking
}

// example: is_immutable(ast.Immutable)
fn is_immutable(mutability: ast.Mutability) -> Bool {
    match mutability {
        ast.Immutable => true
        ast.Mutable => false
    }
}

// example: !is_record_literal(little_lowering(""), no_expr())
fn is_record_literal(lowering: Lowering, value: ast.Expr) -> Bool {
    match value.kind {
        ast.Record { base } => is_constructor(lowering, base) && is_record_constructor(lowering.shapes, path_text(base))
        _ => false
    }
}

// example: !is_constructor(little_lowering(""), ast.Path { module: None, name: infer.no_name() })
fn is_constructor(lowering: Lowering, base: ast.Path) -> Bool {
    if !is_unnamed(base.module) {
        return true
    }
    declared.definition_of(lowering.typed.resolved, resolver.ValueNamespace, base.name).kind == resolver.Constructor
}

// example: list.length(record_base_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, ast.Path { module: None, name: infer.no_name() }).built) == 0
fn record_base_walked(lowering: Lowering, walk: Escape, base: ast.Path) -> Escape {
    if is_unnamed(base.module) {
        return let_go_of(lowering, walk, base.name)
    }
    walk
}

// example: list.length(let_go_of(little_lowering(""), Escape { built: [], escaped: set.empty() }, infer.no_name()).built) == 0
fn let_go_of(lowering: Lowering, walk: Escape, name: ast.Name) -> Escape {
    match declared.definition_of(lowering.typed.resolved, resolver.ValueNamespace, name).origin {
        resolver.InPrelude => walk
        resolver.Declared(at) => walk { escaped: set.insert(walk.escaped, infer.span_key(at)) }
    }
}

// example: prelude_shapes(little_library(), only_the_prelude()).home == ThePrelude
fn prelude_shapes(library: Library, homes: map.Map<String, Module>) -> Shapes {
    let naming = Naming { module: "prelude", home: module_named(homes, "prelude"), homes: homes }
    prelude_declared(empty_shapes(naming, library), library)
}

// example: asked_reached(no_shapes(), no_asks(), "main").module == ""
fn asked_reached(shapes: Shapes, asked: Asked, module: String) -> Shapes {
    var reaching = shapes
    for one in asked.of {
        if one.module == module {
            for foreign in one.foreign {
                if is_not_foreign(map.get(reaching.foreign, foreign.name)) {
                    reaching = reaching { foreign: map.insert(reaching.foreign, foreign.name, foreign.reached) }
                }
            }
        }
    }
    reaching
}

// example: is_not_foreign(None)
fn is_not_foreign(found: Option<JavaClass>) -> Bool {
    match found {
        Some(_) => false
        None => true
    }
}

// example: !is_record_constructor(no_shapes(), "Box")
fn is_record_constructor(shapes: Shapes, named: String) -> Bool {
    set.has_value(shapes.record_builders, named)
}

// example: is_undotted(None)
private fn is_undotted(found: Option<Home>) -> Bool {
    match found {
        Some(_) => false
        None => true
    }
}

// example: list.length(shape_classes(prelude_shapes(little_library(), only_the_prelude()))) == 6
fn shape_classes(shapes: Shapes) -> List<Class> {
    var classes = []
    for declaration in shapes.declarations {
        classes = concatenated(first: classes, second: declaration_classes(shapes, declaration))
    }
    classes
}

// example: list.length(declaration_classes(no_shapes(), RecordDeclared("Box"))) == 1
fn declaration_classes(shapes: Shapes, declaration: ShapeDeclared) -> List<Class> {
    match declaration {
        RecordDeclared(constructor) => [record_class(built_shape(shapes, constructor))]
        VariantsDeclared { base, constructors } => variant_classes(shapes, base, constructors)
    }
}

// example: list.length(variant_classes(no_shapes(), main_box(), ["Box"])) == 2
fn variant_classes(shapes: Shapes, base: Kind, constructors: List<String>) -> List<Class> {
    var classes = [base_class(base)]
    for constructor in constructors {
        classes = list.push(classes, variant_class(built_shape(shapes, constructor), base))
    }
    classes
}

// example: list.length(base_class(main_box()).fields) == 1
fn base_class(base: Kind) -> Class {
    let this = Local { name: "this", of: Of(base) }
    let tag = Local { name: "tag", of: Small }
    let instructions = [Load(this), Load(tag), PutField(FieldRef { owner: base, name: "tag", of: Small }), Load(this), Construct { built: Anything, taken: [] }, Return(None)]
    let made = Method { name: "new", parameters: [tag], result: None, reached: AsItsConstructor, body: Body { instructions: instructions, locals: [], guards: [] } }
    Class { of: base, extends: Anything, extending: ByItsVariants, implements: [], fields: [Field { name: "tag", of: Small }], methods: [made] }
}

// example: variant_class(no_shape(), main_box()).extends == main_box()
fn variant_class(shape: Shape, base: Kind) -> Class {
    Class { of: shape.class, extends: base, extending: Never, implements: [], fields: held_fields(shape), methods: [constructor_method(shape, base)] }
}

// example: list.length(carrier().methods) == 4
fn carrier() -> Class {
    let made = record_class(list_shape())
    made { methods: concatenated(first: made.methods, second: [list_of_method(), list_push_method(), list_listed_method()]) }
}

// example: list.length(record_class(no_shape()).methods) == 1
fn record_class(shape: Shape) -> Class {
    Class { of: shape.class, extends: Anything, extending: Never, implements: [], fields: held_fields(shape), methods: [constructor_method(shape, Anything)] }
}

// example: list.length(constructor_method(no_shape(), Anything).body.instructions) == 3
// example: constructor_method(list_shape(), Anything).parameters == [Local { name: "slots#0", of: buffer() }, Local { name: "length#1", of: Small }]
fn constructor_method(shape: Shape, extends: Kind) -> Method {
    let this = Local { name: "this", of: Of(shape.class) }
    var instructions = []
    var parameters = []
    for field in held_fields(shape) {
        let taken = Local { name: field.name + "#" + shown(list.length(parameters)), of: field.of }
        instructions = concatenated(first: instructions, second: [Load(this), Load(taken), PutField(FieldRef { owner: shape.class, name: field.name, of: field.of })])
        parameters = list.push(parameters, taken)
    }
    instructions = list.push(instructions, Load(this))
    var taken = []
    instructions = match shape.tag {
        Some(tag) => list.push(instructions, IntegerOf(tag))
        None => instructions
    }
    taken = match shape.tag {
        Some(_) => [Small]
        None => taken
    }
    instructions = concatenated(first: instructions, second: [Construct { built: extends, taken: taken }, Return(None)])
    Method { name: "new", parameters: parameters, result: None, reached: AsItsConstructor, body: Body { instructions: instructions, locals: [], guards: [] } }
}

// example: list.length(held_fields(Shape { class: main_box(), base: main_box(), tag: None, carries: [Carried { name: "x", of: None }] })) == 0
fn held_fields(shape: Shape) -> List<Field> {
    var fields = []
    for carried in shape.carries {
        fields = match carried.of {
            Some(of) => list.push(fields, Field { name: carried.name, of: of })
            None => fields
        }
    }
    fields
}

// example: list.length(list_of_method().body.instructions) == 7
fn list_of_method() -> Method {
    let slots = Local { name: "slots", of: buffer() }
    let instructions = [New(list_kind()), Copy, Load(slots), Load(slots), ArrayLength, list_constructed(), Return(Some(list_value()))]
    static_method(function: list_built(), parameters: [slots], instructions: instructions, locals: [])
}

// example: list.length(list_push_method().body.instructions) == 45
fn list_push_method() -> Method {
    let listed = Local { name: "list", of: list_value() }
    let value = Local { name: "value", of: anything() }
    let slots = Local { name: "slots", of: buffer() }
    let length = Local { name: "length", of: Small }
    let grown = Local { name: "grown", of: buffer() }
    let buffered = Load(slots)
    let counted = Load(length)
    let testing = [Load(listed), GetField(list_slots()), Store(slots), Load(listed), GetField(list_length()), Store(length), counted, buffered, ArrayLength, CompareIntegers(Less), JumpIfFalse(0), buffered, counted, LoadFromArray, JumpIfNull(1), Label(0)]
    let copying = [counted, Widen, LongOf(2), Arithmetic(Multiply), LongOf(1), Arithmetic(Add), Narrow, NewArray(Anything), Store(grown), buffered, IntegerOf(0), Load(grown), IntegerOf(0), counted, ArrayCopied, Load(grown), Store(slots)]
    let claiming = [Label(1), buffered, counted, Load(value), StoreInArray, Increment(length), New(list_kind()), Copy, buffered, counted, list_constructed(), Return(Some(list_value()))]
    static_method(function: list_pushed(), parameters: [listed, value], instructions: concatenated(first: concatenated(first: testing, second: copying), second: claiming), locals: [slots, length, grown])
}

// example: list.length(list_listed_method().body.instructions) == 35
fn list_listed_method() -> Method {
    let listed = Local { name: "list", of: list_value() }
    let buffered = Local { name: "buffer", of: buffer() }
    let at = Local { name: "index", of: Small }
    let held = Local { name: "element", of: anything() }
    let counted = [Load(listed), GetField(list_length())]
    let element = Load(held)
    let index = Load(at)
    let starting = concatenated(first: counted, second: [NewArray(Anything), Store(buffered), IntegerOf(0), Store(at), Label(0), index])
    let walking = concatenated(first: counted, second: [CompareIntegers(Less), JumpIfFalse(2), Load(listed), GetField(list_slots()), index, LoadFromArray, Store(held), element, InstanceOf(list_kind()), JumpIfFalse(1), element, Cast(list_kind()), Call(list_crossed()), Store(held), Label(1)])
    let putting = [Load(buffered), index, element, StoreInArray, Increment(at), Jump(0), Label(2), Load(buffered), JavaListOf, Return(Some(Of(JavaList)))]
    static_method(function: list_crossed(), parameters: [listed], instructions: concatenated(first: concatenated(first: starting, second: walking), second: putting), locals: [buffered, at, held])
}

// example: method_named(list_constructed()) == ""
fn list_constructed() -> Instruction {
    Construct { built: list_kind(), taken: constructor_taken(list_shape()) }
}

// example: list.length(list_shape().carries) == 2
fn list_shape() -> Shape {
    Shape { class: list_kind(), base: list_kind(), tag: None, carries: [Carried { name: "slots", of: Some(buffer()) }, Carried { name: "length", of: Some(Small) }] }
}

// example: static_method(function: list_built(), parameters: [], instructions: [], locals: []).name == "of"
fn static_method(function: Function, parameters: List<Local>, instructions: List<Instruction>, locals: List<Local>) -> Method {
    Method { name: function.name, parameters: parameters, result: function.gives, reached: ThroughTheClass, body: Body { instructions: instructions, locals: locals, guards: [] } }
}

// example: is_unsettled(None)
private fn is_unsettled(found: Option<unify.Type>) -> Bool {
    match found {
        Some(_) => false
        None => true
    }
}

// example: list.length(derived_body(little_lowering("type Box = Box\n"), "Show", declared.first_type("type Box = Box\n")).body.instructions) == 3
fn derived_body(lowering: Lowering, of: String, declaration: ast.TypeDeclaration) -> BodyMade {
    let begun = Writing { lowering: lowering, instructions: [], next_label: 0 }
    let writing = if of == "Eq" {
        is_equal_written(begun, declaration)
    } else if of == "Ord" {
        is_less_written(begun, declaration)
    } else if of == "Hash" {
        hashed_written(begun, declaration)
    } else {
        shown_written(begun, declaration)
    }
    BodyMade { lowering: writing.lowering, body: Body { instructions: writing.instructions, locals: [], guards: [] }, parameters: [side_name(0), side_name(1)] }
}

// example: writing_over(box_module()).lowering.module == "main"
private fn writing_over(source: String) -> Writing {
    Writing { lowering: little_lowering(source), instructions: [], next_label: 0 }
}

// example: box_module() == "type Box = {\n    at: Int\n}\n"
private fn box_module() -> String {
    "type Box = {\n    at: Int\n}\n"
}

// example: no_writing().next_label == 0
private fn no_writing() -> Writing {
    Writing { lowering: little_lowering(""), instructions: [], next_label: 0 }
}

// example: little_lowering("fn f() -> Int {\n    1\n}\n").shapes.module == "main"
private fn little_lowering(source: String) -> Lowering {
    let typed = types.checked_of(source)
    let library = little_library()
    lowering_of(typed, library, "main", shapes_of(typed, main_naming(), library))
}

// It is resolved as the prelude is, so a type parameter of `Option` is held as an object.
// example: set.has_value(little_library().types, "Result")
fn little_library() -> Library {
    let program = declared.little_prelude()
    library_of(types.little_prelude(), ok_or(resolver.prelude_resolved(program), resolver.Resolved { module: "prelude", program: program, found: map.empty() }))
}

// example: set.has_value(library_of(types.little_prelude(), declared.resolved_of("type Box = Box\n")).types, "Box")
fn library_of(prelude: types.Prelude, resolved: resolver.Resolved) -> Library {
    Library { prelude: prelude, typed: prelude_typed(prelude, resolved), traits: traits_in(resolved.program), types: types_in(resolved.program) }
}

// example: list.length(prelude_typed(types.little_prelude(), declared.resolved_of("")).functions) == 0
fn prelude_typed(prelude: types.Prelude, resolved: resolver.Resolved) -> infer.Inference {
    let empty = infer.inference_of(resolved, surface.nothing_imported(), infer.no_declaring())
    match declared.environment_of(prelude.declared, resolved, [], [], unify.empty_table()) {
        Ok(declaring) => ok_or(infer.module_inferred(resolved, surface.nothing_imported(), declaring), empty)
        Err(_) => empty
    }
}

// example: list.length(traits_in(declared.little_prelude())) == 3
fn traits_in(program: ast.Program) -> List<ast.TraitDeclaration> {
    var traits = []
    for item in program.items {
        traits = match item {
            ast.Trait(declaration) => list.push(traits, declaration)
            _ => traits
        }
    }
    traits
}

// example: set.has_value(types_in(declared.little_prelude()), "Option")
fn types_in(program: ast.Program) -> set.Set<String> {
    var named = set.empty()
    for item in program.items {
        named = match item {
            ast.Type(declaration) => set.insert(named, declaration.name.text)
            _ => named
        }
    }
    named
}

// example: little_lowering("").module == "main"
fn lowering_of(typed: infer.Inference, library: Library, module: String, shapes: Shapes) -> Lowering {
    let program = typed.resolved.program
    let instances = instances_of(program, library)
    Lowering { typed: typed, library: library, module: module, shapes: shapes, declared: declarations_of(program, library), answers: answers_by_key(instances), instances: instances, owed: [], next_owed: 0, asks: no_asks() }
}

// example: list.length(no_asks().of) == 0
fn no_asks() -> Asked {
    Asked { of: [] }
}

// example: named_at(little_lowering("fn f() -> Int {\n    1\n}\n"), lexer.Span { start: 3, length: 1 }) == "f"
fn declarations_of(program: ast.Program, library: Library) -> map.Map<Int, Declared> {
    var declarations = map.empty()
    for item in program.items {
        declarations = item_declared(declarations, program, library, item)
    }
    declarations
}

// example: list.length(infer.functions_of(declared.little_prelude())) == 6
fn item_declared(declarations: map.Map<Int, Declared>, program: ast.Program, library: Library, item: ast.Item) -> map.Map<Int, Declared> {
    match item {
        ast.Instance(answerer) => instance_declared(declarations, answerer)
        ast.Derive(deriving) => derive_declared(declarations, program, library, deriving)
        ast.Function(function) => map.insert(declarations, infer.span_key(function.name.span), Declared { named: function.name.text, body: Source(function) })
        ast.Extern(declaration) => map.insert(declarations, infer.span_key(declaration.name.span), Declared { named: declaration.name.text, body: FromJava(declaration) })
        ast.Process(declaration) => process_declared(declarations, declaration)
        _ => declarations
    }
}

// example: named_at(little_lowering("process Counter {\n    fn start() -> Int {\n        0\n    }\n\n    fn receive(total: Int, message: Int) -> Next<Int> {\n        match message {\n            _ => Done\n        }\n    }\n}\n"), lexer.Span { start: 25, length: 5 }) == "Counter$start"
fn process_declared(declarations: map.Map<Int, Declared>, process_of: ast.ProcessDeclaration) -> map.Map<Int, Declared> {
    var declaring = declarations
    for function in process_of.functions {
        let named = process_of.name.text + "$" + function.name.text
        declaring = map.insert(declaring, infer.span_key(function.name.span), Declared { named: named, body: Source(function) })
    }
    declaring
}

// example: named_at(little_lowering("instance Eq<Box> {\n    fn is_equal(one: Box, other: Box) -> Bool {\n        true\n    }\n}\n\ntype Box = Box\n"), lexer.Span { start: 26, length: 8 }) == "Eq$Box$is_equal"
fn instance_declared(declarations: map.Map<Int, Declared>, answerer: ast.InstanceDeclaration) -> map.Map<Int, Declared> {
    var declaring = declarations
    for method in answerer.methods {
        let named = answerer.trait_name.text + "$" + answerer.for_type.text + "$" + method.name.text
        declaring = map.insert(declaring, infer.span_key(method.name.span), Declared { named: named, body: Source(method) })
    }
    declaring
}

// example: named_at(little_lowering("derive Eq for Box\n\ntype Box = Box\n"), lexer.Span { start: 7, length: 2 }) == "Eq$Box$is_equal"
fn derive_declared(declarations: map.Map<Int, Declared>, program: ast.Program, library: Library, deriving: ast.DeriveDeclaration) -> map.Map<Int, Declared> {
    var declaring = declarations
    let declaration = type_declared(program, deriving.for_type)
    for named in deriving.traits {
        let method = method_of(library, named.text)
        let written = Declared { named: named.text + "$" + deriving.for_type.text + "$" + method, body: Derived { of: named.text, declaration: declaration } }
        declaring = map.insert(declaring, infer.span_key(named.span), written)
    }
    declaring
}

// example: type_declared(declared.little_prelude(), ast.Name { text: "Option", span: infer.no_name().span }).name.text == "Option"
fn type_declared(program: ast.Program, named: ast.Name) -> ast.TypeDeclaration {
    var found = []
    for item in program.items {
        found = match item {
            ast.Type(declaration) => if declaration.name.text == named.text {
                list.push(found, declaration)
            } else {
                found
            }
            _ => found
        }
    }
    or(list.at(found, 0), ast.TypeDeclaration { name: named, parameters: [], definition: ast.Variants([]), span: named.span, visibility: ast.Public })
}

// example: list.length(instances_of(declared.little_prelude(), little_library())) == 5
fn instances_of(program: ast.Program, library: Library) -> List<Answers> {
    var answers = []
    for item in program.items {
        answers = concatenated(first: answers, second: instance_answers(item))
    }
    for derived in derived_in(program) {
        answers = list.push(answers, Answers { method: method_of(library, derived.named.text), for_type: derived.deriving.for_type.text, arguments: [], declared: derived.named.span })
    }
    answers
}

// example: list.length(instance_answers(declared.first_item("type Box = Box\n"))) == 0
fn instance_answers(item: ast.Item) -> List<Answers> {
    match item {
        ast.Instance(answerer) => each_answer(answerer)
        _ => []
    }
}

// example: list.length(each_answer(ast.InstanceDeclaration { trait_name: infer.no_name(), type_parameters: [], for_type: infer.no_name(), arguments: [], methods: [], span: infer.no_name().span })) == 0
fn each_answer(answerer: ast.InstanceDeclaration) -> List<Answers> {
    var arguments = []
    for written in answerer.arguments {
        arguments = list.push(arguments, written.text)
    }
    var answers = []
    for method in answerer.methods {
        answers = list.push(answers, Answers { method: method.name.text, for_type: answerer.for_type.text, arguments: arguments, declared: method.name.span })
    }
    answers
}

// example: is_nothing_answered(map.get(answers_by_key([]), "is_equal Int"))
fn answers_by_key(answers: List<Answers>) -> map.Map<String, Answers> {
    var by_key = map.empty()
    for one in answers {
        by_key = map.insert(by_key, one.method + " " + one.for_type, one)
    }
    by_key
}

// example: list.length(derived_in(declared.first_program("derive Eq for Box\n\ntype Box = Box\n"))) == 1
fn derived_in(program: ast.Program) -> List<DerivedName> {
    var derived = []
    for item in program.items {
        derived = concatenated(first: derived, second: derive_names(item))
    }
    derived
}

// example: list.length(derive_names(declared.first_item("type Box = Box\n"))) == 0
fn derive_names(item: ast.Item) -> List<DerivedName> {
    match item {
        ast.Derive(deriving) => each_derive_name(deriving)
        _ => []
    }
}

// example: list.length(each_derive_name(ast.DeriveDeclaration { traits: [infer.no_name()], for_type: infer.no_name(), span: infer.no_name().span })) == 1
fn each_derive_name(deriving: ast.DeriveDeclaration) -> List<DerivedName> {
    var names = []
    for named in deriving.traits {
        names = list.push(names, DerivedName { named: named, deriving: deriving })
    }
    names
}

// example: set.has_value(shapes_of(types.checked_of("type Box = Box\n"), main_naming(), little_library()).own, "Box")
fn shapes_of(typed: infer.Inference, naming: Naming, library: Library) -> Shapes {
    var shapes = empty_shapes(naming, library)
    for item in typed.resolved.program.items {
        shapes = match item {
            ast.Type(declaration) => own_declared(shapes, typed.resolved, declaration)
            _ => shapes
        }
    }
    for offered in surface.every_type(typed.imported) {
        shapes = reached_declared(shapes, offered)
    }
    prelude_declared(shapes, library)
}

// example: list.length(empty_shapes(main_naming(), little_library()).declarations) == 0
fn empty_shapes(naming: Naming, library: Library) -> Shapes {
    Shapes { module: naming.module, home: naming.home, homes: naming.homes, declarations: [], built_by: map.empty(), records: map.empty(), record_builders: set.empty(), own: set.empty(), foreign: map.empty(), prelude_types: library.types }
}

// example: set.has_value(own_declared(no_shapes(), declared.resolved_of(""), declared.first_type("type Box = Box\n")).own, "Box")
fn own_declared(shapes: Shapes, resolved: resolver.Resolved, declaration: ast.TypeDeclaration) -> Shapes {
    let owning = shapes { own: set.insert(shapes.own, declaration.name.text) }
    declared_as(owning, resolved, declaration, owning.home)
}

// example: built_shape(reached_declared(main_shapes(), surface.record_of_user()), "User").class == main_kind("User")
fn reached_declared(shapes: Shapes, offered: surface.OfferedType) -> Shapes {
    let module = home_of_type(shapes, offered.name)
    let named = simple(offered.name)
    match offered.built_by {
        surface.Record(one) => offered_record(shapes: shapes, named: offered.name, one: one, base: TypeOf { module: module, name: named })
        surface.Variants(variants) => offered_variants(shapes: shapes, variants: variants, module: module, named: named)
        surface.ForeignClass { class, called } => shapes { foreign: map.insert(shapes.foreign, offered.name, JavaClass { class: class, called: called_as(called) }) }
    }
}

// example: built_shape(offered_record(shapes: no_shapes(), named: "user.User", one: surface.OfferedConstructor { name: "user.User", labels: [], carries: [] }, base: main_kind("User")), "user.User").class == main_kind("User")
fn offered_record(shapes: Shapes, named: String, one: surface.OfferedConstructor, base: Kind) -> Shapes {
    let shape = Shape { class: base, base: base, tag: None, carries: offered_carries(shapes, one) }
    shapes { records: map.insert(shapes.records, named, one.name), record_builders: set.insert(shapes.record_builders, one.name), built_by: map.insert(shapes.built_by, one.name, shape) }
}

// example: built_shape(offered_variants(shapes: no_shapes(), variants: [surface.OfferedConstructor { name: "a.C", labels: [], carries: [] }], module: OfTheProgram("a"), named: "B"), "a.C").class == VariantOf { module: OfTheProgram("a"), of: "B", variant: "C" }
fn offered_variants(shapes: Shapes, variants: List<surface.OfferedConstructor>, module: Module, named: String) -> Shapes {
    let base = TypeOf { module: module, name: named }
    var reaching = shapes
    var position = 0
    for variant in variants {
        let shape = Shape { class: VariantOf { module: module, of: named, variant: simple(variant.name) }, base: base, tag: Some(position), carries: offered_carries(reaching, variant) }
        reaching = reaching { built_by: map.insert(reaching.built_by, variant.name, shape) }
        position += 1
    }
    reaching
}

// example: list.length(offered_carries(no_shapes(), surface.OfferedConstructor { name: "a.B", labels: [], carries: [unify.int()] })) == 1
fn offered_carries(shapes: Shapes, built: surface.OfferedConstructor) -> List<Carried> {
    var carries = []
    var position = 0
    for of in built.carries {
        carries = list.push(carries, Carried { name: or(list.at(built.labels, position), positional(position)), of: carried_type(shapes, of) })
        position += 1
    }
    carries
}

// example: built_shape(prelude_declared(no_shapes(), little_library()), "Some").class == VariantOf { module: ThePrelude, of: "Option", variant: "Some" }
fn prelude_declared(shapes: Shapes, library: Library) -> Shapes {
    var declaring = shapes
    let resolved = library.typed.resolved
    for item in resolved.program.items {
        declaring = match item {
            ast.Type(declaration) => declared_as(declaring, resolved, declaration, ThePrelude)
            _ => declaring
        }
    }
    declaring
}

// example: built_shape(declared_as(no_shapes(), declared.resolved_of(""), declared.first_type("type Box = Box\n"), OfTheProgram("main")), "Box").class == VariantOf { module: OfTheProgram("main"), of: "Box", variant: "Box" }
fn declared_as(shapes: Shapes, resolved: resolver.Resolved, declaration: ast.TypeDeclaration, module: Module) -> Shapes {
    let named = declaration.name.text
    match declaration.definition {
        ast.RecordType(fields) => record_declared(shapes: shapes, named: named, base: TypeOf { module: module, name: named }, carries: fields_carried(shapes, resolved, fields))
        ast.Variants(variants) => variants_declared(shapes: shapes, resolved: resolved, variants: variants, module: module, named: named)
        ast.Foreign { class, called } => shapes { foreign: map.insert(shapes.foreign, named, JavaClass { class: class.text, called: called_as(called) }) }
    }
}

// example: called_as(ast.AsAnInterface) == ThroughItsInterface
fn called_as(called: ast.Called) -> CalledAs {
    match called {
        ast.AsAClass => ThroughItsClass
        ast.AsAnInterface => ThroughItsInterface
    }
}

// example: is_record_constructor(record_declared(shapes: no_shapes(), named: "Box", base: main_box(), carries: []), "Box")
fn record_declared(shapes: Shapes, named: String, base: Kind, carries: List<Carried>) -> Shapes {
    let shape = Shape { class: base, base: base, tag: None, carries: carries }
    shapes { records: map.insert(shapes.records, named, named), record_builders: set.insert(shapes.record_builders, named), declarations: list.push(shapes.declarations, RecordDeclared(named)), built_by: map.insert(shapes.built_by, named, shape) }
}

// example: list.length(variants_declared(shapes: no_shapes(), resolved: declared.resolved_of(""), variants: [declared.no_variant()], module: OfTheProgram("main"), named: "Box").declarations) == 1
fn variants_declared(shapes: Shapes, resolved: resolver.Resolved, variants: List<ast.Variant>, module: Module, named: String) -> Shapes {
    let base = TypeOf { module: module, name: named }
    var declaring = shapes
    var constructors = []
    var position = 0
    for variant in variants {
        let built = variant.name.text
        let shape = Shape { class: VariantOf { module: module, of: named, variant: built }, base: base, tag: Some(position), carries: payload_carried(declaring, resolved, variant.payload) }
        constructors = list.push(constructors, built)
        declaring = declaring { built_by: map.insert(declaring.built_by, built, shape) }
        position += 1
    }
    declaring { declarations: list.push(declaring.declarations, VariantsDeclared { base: base, constructors: constructors }) }
}

// example: list.length(payload_carried(no_shapes(), declared.resolved_of(""), ast.NoPayload)) == 0
fn payload_carried(shapes: Shapes, resolved: resolver.Resolved, payload: ast.VariantPayload) -> List<Carried> {
    match payload {
        ast.NoPayload => []
        ast.TuplePayload(written) => positions_carried(shapes, resolved, written)
        ast.RecordPayload(fields) => fields_carried(shapes, resolved, fields)
    }
}

// example: list.length(positions_carried(no_shapes(), declared.resolved_of(""), [])) == 0
fn positions_carried(shapes: Shapes, resolved: resolver.Resolved, written: List<ast.TypeRef>) -> List<Carried> {
    var carries = []
    var position = 0
    for type_ref in written {
        carries = list.push(carries, Carried { name: positional(position), of: written_type(shapes, resolved, type_ref) })
        position += 1
    }
    carries
}

// example: list.length(fields_carried(no_shapes(), declared.resolved_of(""), [])) == 0
fn fields_carried(shapes: Shapes, resolved: resolver.Resolved, fields: List<ast.RecordField>) -> List<Carried> {
    var carries = []
    for field in fields {
        carries = list.push(carries, Carried { name: field.name.text, of: written_type(shapes, resolved, field.type_ref) })
    }
    carries
}

// example: is_nothing(written_type(no_shapes(), declared.resolved_of(""), ast.TypeRef { kind: ast.UnitType, span: infer.no_name().span }))
fn written_type(shapes: Shapes, resolved: resolver.Resolved, type_ref: ast.TypeRef) -> Option<Value> {
    match type_ref.kind {
        ast.NamedType { path } => Some(named_path(shapes, resolved, path))
        ast.UnitType => None
    }
}

// example: named_path(no_shapes(), declared.resolved_of(""), ast.Path { module: None, name: ast.Name { text: "Int", span: infer.no_name().span } }) == Whole
fn named_path(shapes: Shapes, resolved: resolver.Resolved, path: ast.Path) -> Value {
    if is_unnamed(path.module) && declared.definition_of(resolved, resolver.TypeNamespace, path.name).kind == resolver.TypeParameter {
        return anything()
    }
    named_value(shapes, path_text(path))
}

// example: positional(1) == "value1"
fn positional(position: Int) -> String {
    "value" + shown(position)
}

// example: is_unit_written(unit_written())
private fn unit_written() -> ast.TypeRef {
    ast.TypeRef { kind: ast.UnitType, span: infer.no_name().span }
}

// example: is_unit_written(unit_written())
private fn is_unit_written(written: ast.TypeRef) -> Bool {
    match written.kind {
        ast.UnitType => true
        _ => false
    }
}

// example: list.length(is_equal_written(writing_over(box_module()), declared.first_type(box_module())).instructions) == 12
fn is_equal_written(writing: Writing, declaration: ast.TypeDeclaration) -> Writing {
    let differs = labelled_writing(writing)
    var writes = differs.writing
    for holds in record_holds(writes, declaration.name.text, record_fields_of(declaration)) {
        writes = equal_written(writes, holds, differs.label)
    }
    if has_variants(declaration) {
        writes = same_variant(writes, variants_of(declaration), differs.label)
    }
    equality_answered(writes, differs.label)
}

// example: list.length(same_variant(no_writing(), [], 0).instructions) == 7
fn same_variant(writing: Writing, variants: List<ast.Variant>, differs: Int) -> Writing {
    let equally = labelled_writing(writing)
    let base = base_of(equally.writing, variants)
    var writes = tag_read(tag_read(equally.writing, base, 0), base, 1)
    writes = each_written_out(writes, [CompareIntegers(Equal), JumpIfFalse(differs)])
    for variant in variants {
        writes = variant_equal(writing: writes, variant: variant, differs: differs, equally: equally.label)
    }
    written_out(writes, Label(equally.label))
}

// example: list.length(variant_equal(writing: no_writing(), variant: declared.no_variant(), differs: 0, equally: 1).instructions) == 0
fn variant_equal(writing: Writing, variant: ast.Variant, differs: Int, equally: Int) -> Writing {
    let held = variant_holds(writing, variant)
    if list.length(held) == 0 {
        return writing
    }
    let next = labelled_writing(writing)
    var writes = unless_it_is(next.writing, built_shape(writing.lowering.shapes, variant.name.text), next.label)
    for holds in held {
        writes = equal_written(writes, holds, differs)
    }
    each_written_out(writes, [Jump(equally), Label(next.label)])
}

// example: list.length(equal_written(no_writing(), Holds { shape: no_shape(), carried: Carried { name: "x", of: Some(Whole) }, of: Whole, named: None, written: unit_written() }, 0).instructions) == 6
fn equal_written(writing: Writing, holds: Holds, differs: Int) -> Writing {
    let compared_both = derived_through(value_read(value_read(writing, holds, 0), holds, 1), "Eq", holds)
    written_out(compared_both, JumpIfFalse(differs))
}

// example: list.length(equality_answered(no_writing(), 0).instructions) == 6
fn equality_answered(writing: Writing, differs: Int) -> Writing {
    let end = labelled_writing(writing)
    each_written_out(end.writing, [BooleanOf(true), Jump(end.label), Label(differs), BooleanOf(false), Label(end.label), Return(Some(Truth))])
}

// example: list.length(hashed_written(writing_over(box_module()), declared.first_type(box_module())).instructions) == 7
fn hashed_written(writing: Writing, declaration: ast.TypeDeclaration) -> Writing {
    var writes = writing
    if is_record(declaration) {
        writes = written_out(writes, LongOf(0))
    }
    for holds in record_holds(writes, declaration.name.text, record_fields_of(declaration)) {
        writes = taken_in(writes, holds)
    }
    if has_variants(declaration) {
        writes = hashed_by_variant(writes, variants_of(declaration))
    }
    written_out(writes, Return(Some(Whole)))
}

// example: list.length(hashed_by_variant(no_writing(), []).instructions) == 4
fn hashed_by_variant(writing: Writing, variants: List<ast.Variant>) -> Writing {
    let end = labelled_writing(writing)
    var writes = written_out(tag_read(end.writing, base_of(end.writing, variants), 0), Widen)
    for variant in variants {
        writes = carried_by(writes, variant, end.label)
    }
    written_out(writes, Label(end.label))
}

// example: list.length(carried_by(no_writing(), declared.no_variant(), 0).instructions) == 0
fn carried_by(writing: Writing, variant: ast.Variant, end: Int) -> Writing {
    let held = variant_holds(writing, variant)
    if list.length(held) == 0 {
        return writing
    }
    let next = labelled_writing(writing)
    var writes = unless_it_is(next.writing, built_shape(writing.lowering.shapes, variant.name.text), next.label)
    for holds in held {
        writes = taken_in(writes, holds)
    }
    each_written_out(writes, [Jump(end), Label(next.label)])
}

// example: list.length(taken_in(no_writing(), Holds { shape: no_shape(), carried: Carried { name: "x", of: Some(Whole) }, of: Whole, named: None, written: unit_written() }).instructions) == 5
fn taken_in(writing: Writing, holds: Holds) -> Writing {
    let spread = each_written_out(writing, [LongOf(31), Arithmetic(Multiply)])
    written_out(derived_through(value_read(spread, holds, 0), "Hash", holds), Arithmetic(Add))
}

// example: list.length(is_less_written(writing_over(box_module()), declared.first_type(box_module())).instructions) == 22
fn is_less_written(writing: Writing, declaration: ast.TypeDeclaration) -> Writing {
    let less = labelled_writing(writing)
    let not_less = labelled_writing(less.writing)
    let settled = Decided { less: less.label, not_less: not_less.label }
    var writes = not_less.writing
    for holds in record_holds(writes, declaration.name.text, record_fields_of(declaration)) {
        writes = deciding(writes, holds, settled)
    }
    if has_variants(declaration) {
        writes = ordered_by_variant(writes, variants_of(declaration), settled)
    }
    order_answered(writes, settled)
}

// example: list.length(ordered_by_variant(no_writing(), [], Decided { less: 0, not_less: 1 }).instructions) == 13
fn ordered_by_variant(writing: Writing, variants: List<ast.Variant>, settled: Decided) -> Writing {
    let base = base_of(writing, variants)
    var writes = written_out(tag_read(tag_read(writing, base, 0), base, 1), CompareIntegers(Less))
    writes = leaving_where_it_holds(writes, settled.less)
    writes = written_out(tag_read(tag_read(writes, base, 0), base, 1), CompareIntegers(Equal))
    writes = written_out(writes, JumpIfFalse(settled.not_less))
    for variant in variants {
        writes = variant_ordered(writes, variant, settled)
    }
    writes
}

// example: base_of(no_writing(), []) == Anything
fn base_of(writing: Writing, variants: List<ast.Variant>) -> Kind {
    match list.at(variants, 0) {
        Some(first) => built_shape(writing.lowering.shapes, first.name.text).base
        None => no_shape().base
    }
}

// example: list.length(variant_ordered(no_writing(), declared.no_variant(), Decided { less: 0, not_less: 1 }).instructions) == 0
fn variant_ordered(writing: Writing, variant: ast.Variant, settled: Decided) -> Writing {
    let held = variant_holds(writing, variant)
    if list.length(held) == 0 {
        return writing
    }
    let next = labelled_writing(writing)
    var writes = unless_it_is(next.writing, built_shape(writing.lowering.shapes, variant.name.text), next.label)
    for holds in held {
        writes = deciding(writes, holds, settled)
    }
    each_written_out(writes, [Jump(settled.not_less), Label(next.label)])
}

// example: list.length(deciding(no_writing(), Holds { shape: no_shape(), carried: Carried { name: "x", of: Some(Whole) }, of: Whole, named: None, written: unit_written() }, Decided { less: 0, not_less: 1 }).instructions) == 14
fn deciding(writing: Writing, holds: Holds, settled: Decided) -> Writing {
    let before = derived_through(value_read(value_read(writing, holds, 0), holds, 1), "Ord", holds)
    let after = derived_through(value_read(value_read(leaving_where_it_holds(before, settled.less), holds, 1), holds, 0), "Ord", holds)
    leaving_where_it_holds(after, settled.not_less)
}

// example: list.length(leaving_where_it_holds(no_writing(), 0).instructions) == 2
fn leaving_where_it_holds(writing: Writing, answer: Int) -> Writing {
    each_written_out(writing, [Not, JumpIfFalse(answer)])
}

// example: list.length(order_answered(no_writing(), Decided { less: 0, not_less: 1 }).instructions) == 8
fn order_answered(writing: Writing, settled: Decided) -> Writing {
    let end = labelled_writing(writing)
    each_written_out(end.writing, [Jump(settled.not_less), Label(settled.less), BooleanOf(true), Jump(end.label), Label(settled.not_less), BooleanOf(false), Label(end.label), Return(Some(Truth))])
}

// example: list.length(shown_written(no_writing(), declared.first_type("type Box = Box\n")).instructions) == 3
fn shown_written(writing: Writing, declaration: ast.TypeDeclaration) -> Writing {
    var writes = writing
    if is_record(declaration) {
        writes = inside_braces(writes, declaration.name.text, record_holds(writes, declaration.name.text, record_fields_of(declaration)))
    }
    if has_variants(declaration) {
        writes = shown_by_variant(writes, variants_of(declaration))
    }
    written_out(writes, Return(Some(text_value())))
}

// example: list.length(record_holds(no_writing(), "Box", [])) == 0
fn record_holds(writing: Writing, named: String, fields: List<ast.RecordField>) -> List<Holds> {
    held_values(record_shape(writing.lowering.shapes, named), fields_written(fields))
}

// example: held_key(block_built(little_builder("fn f() -> Int {\n    1\n}\n"), first_function_body("fn f() -> Int {\n    1\n}\n")).held) == "Whole"
fn block_built(builder: Builder, block: ast.Block) -> Left {
    let last = list.length(block.statements) - 1
    var left = Left { builder: builder, held: None }
    var at = 0
    for statement in block.statements {
        left = statement_built(left.builder, statement)
        if at < last {
            left = Left { builder: adapt(builder: left.builder, from: left.held, to: None), held: None }
        }
        at += 1
    }
    left
}

// example: held_key(statement_built(little_builder(""), ast.Statement { kind: ast.Break, span: infer.no_name().span }).held) == "()"
fn statement_built(builder: Builder, statement: ast.Statement) -> Left {
    match statement.kind {
        ast.Evaluated(value) => expr_built(builder, value)
        _ => Left { builder: performed(builder, statement.kind), held: None }
    }
}

// example: list.length(performed(little_builder(""), ast.Break).instructions) == 0
fn performed(builder: Builder, kind: ast.StatementKind) -> Builder {
    match kind {
        ast.Binding { name, value } => binding_built(builder, name, value)
        ast.Assign { target, operator, value } => assigned(builder, target, operator, value)
        ast.Return(value) => returned(builder, value)
        ast.Break => left_for(builder, repeat_done(builder.repeat))
        ast.ContinueLoop => left_for(builder, repeat_again(builder.repeat))
        ast.For(repeated) => for_loop(builder, repeated)
        ast.Discard(value) => discarded(builder, value)
        ast.Evaluated(_) => builder
    }
}

// example: list.length(discarded(little_builder(""), no_expr()).instructions) == 0
fn discarded(builder: Builder, value: ast.Expr) -> Builder {
    let left = expr_built(builder, value)
    adapt(builder: left.builder, from: left.held, to: None)
}

// example: list.length(binding_built(little_builder(""), infer.no_name(), no_expr()).instructions) == 0
fn binding_built(builder: Builder, name: ast.Name, value: ast.Expr) -> Builder {
    if set.has_value(builder.splitting, infer.span_key(name.span)) {
        return split_bound(builder, name, value)
    }
    let left = expr_built(builder, value)
    stored_value(declare(left.builder, name), name, left.held)
}

// example: list.length(split_bound(little_builder(""), infer.no_name(), no_expr()).instructions) == 0
fn split_bound(builder: Builder, name: ast.Name, value: ast.Expr) -> Builder {
    match value.kind {
        ast.Record { base, fields } => each_field_split(builder, name, fields, built_shape(builder.lowering.shapes, path_text(base)))
        _ => builder
    }
}

// example: list.length(each_field_split(little_builder(""), infer.no_name(), [], no_shape()).instructions) == 0
fn each_field_split(builder: Builder, name: ast.Name, fields: List<ast.FieldValue>, shape: Shape) -> Builder {
    var splitting = builder
    for carried in shape.carries {
        splitting = given_fields(splitting, fields, carried)
        splitting = match carried.of {
            Some(of) => field_held(splitting, split_key(name.span, carried.name), of)
            None => splitting
        }
    }
    splitting
}

// example: list.length(assigned(little_builder(""), infer.no_name(), ast.SetTo, no_expr()).instructions) == 0
fn assigned(builder: Builder, name: ast.Name, operator: ast.AssignOperator, value: ast.Expr) -> Builder {
    let left = match operator {
        ast.SetTo => expr_built(builder, value)
        ast.AddTo => added_or_written(builder, bound_local(builder, name), value)
    }
    stored_value(left.builder, name, left.held)
}

// example: held_key(added_or_written(little_builder(""), None, no_expr()).held) == "()"
fn added_or_written(builder: Builder, local: Option<Local>, value: ast.Expr) -> Left {
    match local {
        Some(held) => added_to(builder, held, value)
        None => expr_built(builder, value)
    }
}

// example: list.length(returned(little_builder(""), None).instructions) == 1
fn returned(builder: Builder, value: Option<ast.Expr>) -> Builder {
    let written = match value {
        Some(given) => left_as(expr_built(builder, given), builder.result)
        None => builder
    }
    emit(written, Return(builder.result))
}

// example: list.length(for_loop(little_builder(""), ast.ForLoop { header: ast.Forever, body: ast.Block { statements: [], span: infer.no_name().span } }).instructions) == 4
fn for_loop(builder: Builder, repeated: ast.ForLoop) -> Builder {
    let entered = loop_entered(builder, repeated.header)
    let turn = entered.turn
    let top = entered.builder.next_label
    let again = top + 1
    let done = top + 2
    let entering = entered.builder
    let labelled = emit(entering { next_label: top + 3 }, Label(top))
    let tested = loop_tested(labelled, turn, done)
    let outer = tested.repeat
    let left = block_built(tested { repeat: Some(Repeat { again: again, done: done }) }, repeated.body)
    let adapted = adapt(builder: left.builder, from: left.held, to: None)
    let walked = emit(adapted { repeat: outer }, Label(again))
    let stepped = match turn {
        Walk { index } => emit(walked, Increment(index))
        _ => walked
    }
    emit(emit(stepped, Jump(top)), Label(done))
}

// example: list.length(loop_entered(little_builder(""), ast.Forever).builder.locals) == 0
fn loop_entered(builder: Builder, header: ast.ForHeader) -> Entered {
    match header {
        ast.Forever => Entered { builder: builder, turn: Forever }
        ast.While(condition) => Entered { builder: builder, turn: While(condition) }
        ast.Over { binding, iterable } => walk_entered(builder, binding, iterable)
    }
}

// example: list.length(walk_entered(little_builder(""), infer.no_name(), no_expr()).builder.locals) == 2
fn walk_entered(builder: Builder, binding: ast.Name, iterable: ast.Expr) -> Entered {
    let of = list_value()
    let left = expr_built(builder, iterable)
    let holding = stored_aside(adapt(builder: left.builder, from: left.held, to: Some(of)), "list", of)
    let counting = stored_aside(emit(holding.builder, IntegerOf(0)), "index", Small)
    let bound = declare(counting.builder, binding)
    Entered { builder: bound, turn: Walk { walked_list: holding.local, index: counting.local, item: bound_local(bound, binding) } }
}

// example: list.length(loop_tested(little_builder(""), Forever, 0).instructions) == 0
fn loop_tested(builder: Builder, turn: Turn, done: Int) -> Builder {
    match turn {
        Forever => builder
        While(condition) => emit(condition_built(builder, condition), JumpIfFalse(done))
        Walk { walked_list, index, item } => walk_stepped(builder, Walk { walked_list: walked_list, index: index, item: item }, done)
    }
}

// example: list.length(condition_built(little_builder(""), no_expr()).instructions) == 0
fn condition_built(builder: Builder, condition: ast.Expr) -> Builder {
    let left = expr_built(builder, condition)
    adapt(builder: left.builder, from: left.held, to: Some(Truth))
}

// example: held_key(value_built(little_builder(""), no_expr()).held) == "()"
fn value_built(builder: Builder, written: ast.Expr) -> Left {
    let left = expr_built(builder, written)
    let settled = carried_at(left.builder, written.span)
    Left { builder: adapt(builder: left.builder, from: left.held, to: settled), held: settled }
}

// A `()` that a type parameter stands for is a new object, because a generic holds an object there.
// example: list.length(handed(little_builder(""), no_expr(), None).instructions) == 0
fn handed(builder: Builder, written: ast.Expr, wanted: Option<Value>) -> Builder {
    let left = expr_built(builder, written)
    if is_nothing(left.held) && !is_nothing(wanted) && is_holding_nothing(left.builder, written.span) {
        return adapt(builder: nothing(left.builder), from: Some(anything()), to: wanted)
    }
    adapt(builder: left.builder, from: left.held, to: wanted)
}

// example: held_key(expr_built(little_builder("fn f() -> Int {\n    1\n}\n"), first_expr("fn f() -> Int {\n    1\n}\n")).held) == "Whole"
// example: held_key(expr_built(little_builder(""), no_expr()).held) == "()"
fn expr_built(builder: Builder, written: ast.Expr) -> Left {
    match written.kind {
        ast.NameExpr(name) => name_written(builder, name)
        ast.Integer(value) => whole_number(builder, value, written.span)
        ast.Text(value) => Left { builder: emit(builder, TextOf(value)), held: Some(text_value()) }
        ast.Truth(value) => Left { builder: emit(builder, BooleanOf(value)), held: Some(Truth) }
        ast.Unit => Left { builder: builder, held: None }
        ast.Unary { operator, operand } => unary(builder, operator, operand)
        ast.Binary { operator, left, right } => binary(builder: builder, operator: operator, left: left, right: right)
        ast.Call { callee, arguments } => call(builder, callee, infer.values_of(arguments), written.span)
        ast.Field { receiver, name } => field_built(builder, receiver, name)
        ast.Try(inner) => propagated(builder, inner, written.span)
        ast.Written(elements) => written_list(builder, elements)
        ast.Record { base, fields } => record(builder, base, fields)
        ast.If(chain) => if_expr(builder, chain, written.span)
        ast.Match(matched) => match_expr(builder, matched, written.span)
        ast.Spawn(started) => spawn_built(builder, started)
    }
}

// example: held_key(spawn_built(little_builder(""), no_expr()).held) == "prelude.Process"
fn spawn_built(builder: Builder, started: ast.Expr) -> Left {
    let requested = match started.kind {
        ast.Call { callee, arguments } => Spawning { callee: callee, passed: infer.values_of(arguments) }
        _ => Spawning { callee: started, passed: [] }
    }
    let reached = spawned_process(builder, requested.callee)
    let handing = each_handed(builder, requested.passed, reached.parameters)
    let spawned = Function { owner: reached.spawned, name: "spawned", taken: taken_values(reached.parameters), gives: Some(handle_value()) }
    Left { builder: emit(handing, Call(spawned)), held: Some(handle_value()) }
}

// example: spawned_process(little_builder(""), no_expr()).spawned == ProcessOf { module: OfTheProgram("main"), name: "" }
fn spawned_process(builder: Builder, callee: ast.Expr) -> SpawnedProcess {
    let lowering = builder.lowering
    match reached_inside(builder, callee) {
        Some(through) => SpawnedProcess { spawned: ProcessOf { module: module_named(lowering.shapes.homes, through.module.text), name: through.name.text }, parameters: signature_of(lowering, callee.span, whole()).parameters }
        None => process_of_this_module(builder, callee_of(callee, []).name)
    }
}

// example: process_of_this_module(little_builder(""), infer.no_name()).spawned == ProcessOf { module: OfTheProgram("main"), name: "" }
fn process_of_this_module(builder: Builder, name: ast.Name) -> SpawnedProcess {
    let declaration = spawned_declaration(builder.lowering, value_definition(builder, name).origin)
    let parameters = signature_of_process(builder.lowering, declaration, 0).parameters
    SpawnedProcess { spawned: ProcessOf { module: builder.lowering.shapes.home, name: declaration.name.text }, parameters: parameters }
}

// example: spawned_declaration(little_lowering(""), resolver.InPrelude).name.text == ""
fn spawned_declaration(lowering: Lowering, origin: resolver.Origin) -> ast.ProcessDeclaration {
    var found = ast.ProcessDeclaration { name: infer.no_name(), functions: [], span: infer.no_name().span, visibility: ast.Public }
    for item in lowering.typed.resolved.program.items {
        found = match item {
            ast.Process(declaration) => if is_declared_at(origin, declaration.name.span) {
                declaration
            } else {
                found
            }
            _ => found
        }
    }
    found
}

// example: !is_declared_at(resolver.InPrelude, infer.no_name().span)
fn is_declared_at(origin: resolver.Origin, written: lexer.Span) -> Bool {
    match origin {
        resolver.InPrelude => false
        resolver.Declared(at) => infer.span_key(at) == infer.span_key(written)
    }
}

// example: held_key(written_list(little_builder(""), []).held) == "prelude.List"
fn written_list(builder: Builder, elements: List<ast.Expr>) -> Left {
    var writing = emits(builder, [IntegerOf(list.length(elements)), NewArray(Anything)])
    var at = 0
    for element in elements {
        writing = emit(handed(emits(writing, [Copy, IntegerOf(at)]), element, Some(anything())), StoreInArray)
        at += 1
    }
    Left { builder: emit(writing, Call(list_built())), held: Some(list_value()) }
}

// example: held_key(name_written(little_builder(""), infer.no_name()).held) == "()"
fn name_written(builder: Builder, name: ast.Name) -> Left {
    match value_definition(builder, name).kind {
        resolver.Constructor => builds(builder, built_shape(builder.lowering.shapes, name.text), [])
        _ => loaded_value(builder, name)
    }
}

// example: held_key(unary(little_builder(""), ast.Not, no_expr()).held) == "Truth"
fn unary(builder: Builder, operator: ast.UnaryOperator, operand: ast.Expr) -> Left {
    match operator {
        ast.Not => Left { builder: emit(condition_built(builder, operand), Not), held: Some(Truth) }
        ast.Negate => negated(builder, operand)
    }
}

// example: held_key(binary(builder: little_builder(""), operator: ast.Or, left: no_expr(), right: no_expr()).held) == "Truth"
fn binary(builder: Builder, operator: ast.BinaryOperator, left: ast.Expr, right: ast.Expr) -> Left {
    match operator {
        ast.Or => either(builder: builder, left: left, right: right)
        ast.And => both(builder: builder, left: left, right: right)
        _ => operated(builder: builder, operator: operator, left: left, right: right)
    }
}

// example: held_key(divided(builder: little_builder(""), how: Divide, left: no_expr(), right: no_expr()).held) == "prelude.Option"
fn divided(builder: Builder, how: Arithmetic, left: ast.Expr, right: ast.Expr) -> Left {
    let dividend = put_aside_as(builder, left, Whole)
    let divisor = put_aside_as(dividend.builder, right, Whole)
    let answered = divisor.builder.next_label
    let end = answered + 1
    let dividing = divisor.builder
    let testing = emits(dividing { next_label: end + 1 }, [Load(divisor.local), LongOf(0), CompareLongs(Equal), JumpIfFalse(answered)])
    let none = built_shape(testing.lowering.shapes, "None")
    let absent = constructed(emits(testing, [New(none.class), Copy]), none)
    let answering = emits(absent.builder, [Jump(end), Label(answered)])
    Left { builder: emit(divided_answer(builder: answering, how: how, dividend: dividend.local, divisor: divisor.local), Label(end)), held: absent.held }
}

// example: put_aside_as(little_builder(""), no_expr(), Whole).local == Local { name: "operand#0", of: Whole }
fn put_aside_as(builder: Builder, operand: ast.Expr, of: Value) -> Aside {
    let left = value_built(builder, operand)
    stored_aside(adapt(builder: left.builder, from: left.held, to: Some(of)), "operand", of)
}

// example: list.length(either(builder: little_builder(""), left: no_expr(), right: no_expr()).builder.instructions) == 5
fn either(builder: Builder, left: ast.Expr, right: ast.Expr) -> Left {
    let otherwise = builder.next_label
    let end = otherwise + 1
    let tested = emit(condition_built(builder { next_label: end + 1 }, left), JumpIfFalse(otherwise))
    let other = condition_built(emits(tested, [BooleanOf(true), Jump(end), Label(otherwise)]), right)
    Left { builder: emit(other, Label(end)), held: Some(Truth) }
}

// example: list.length(both(builder: little_builder(""), left: no_expr(), right: no_expr()).builder.instructions) == 5
fn both(builder: Builder, left: ast.Expr, right: ast.Expr) -> Left {
    let otherwise = builder.next_label
    let end = otherwise + 1
    let tested = emit(condition_built(builder { next_label: end + 1 }, left), JumpIfFalse(otherwise))
    let other = condition_built(tested, right)
    Left { builder: emits(other, [Jump(end), Label(otherwise), BooleanOf(false), Label(end)]), held: Some(Truth) }
}

// example: held_key(call(little_builder(""), no_expr(), [], infer.no_name().span).held) == "()"
fn call(builder: Builder, callee: ast.Expr, arguments: List<ast.Expr>, at: lexer.Span) -> Left {
    match reached_inside(builder, callee) {
        Some(through) => inside_module(builder, through, arguments)
        None => call_written(builder, callee_of(callee, arguments), at)
    }
}

// example: held_key(call_written(little_builder(""), Callee { name: infer.no_name(), passed: [] }, infer.no_name().span).held) == "()"
fn call_written(builder: Builder, callee: Callee, at: lexer.Span) -> Left {
    match value_definition(builder, callee.name).kind {
        resolver.Constructor => builds(builder, built_shape(builder.lowering.shapes, callee.name.text), callee.passed)
        _ => invoked(builder, callee.name, callee.passed, at)
    }
}

// example: held_key(invoked(little_builder(""), infer.no_name(), [], infer.no_name().span).held) == "()"
fn invoked(builder: Builder, name: ast.Name, arguments: List<ast.Expr>, written: lexer.Span) -> Left {
    let definition = value_definition(builder, name)
    if definition.kind == resolver.TraitMethod {
        return through_the_instance(builder, name, arguments)
    }
    match definition.origin {
        resolver.InPrelude => supplied(builder, name, arguments, written)
        resolver.Declared(at) => statically(builder, Use { declared: at, at: name.span, within: builder.at }, arguments)
    }
}

// example: held_key(through_the_instance(little_builder(""), infer.no_name(), []).held) == "()"
fn through_the_instance(builder: Builder, name: ast.Name, arguments: List<ast.Expr>) -> Left {
    let at = or(infer.method_type_at(builder.lowering.typed, name.span), unify.Unit)
    let found = found_in(builder, answering_at(builder.lowering, name.text, substituted(builder.at, at)))
    match found.answered_by {
        Some(answerer) => calling(found.builder, answerer, arguments)
        None => written_out_instance(found.builder, name, arguments)
    }
}

// example: held_key(calling(little_builder(""), Instance { home: OfTheProgram("main"), reaching: Reaching { named: "f", signature: Signature { parameters: [], result: Some(Whole) } } }, []).held) == "Whole"
fn calling(builder: Builder, answerer: Instance, arguments: List<ast.Expr>) -> Left {
    let handing = each_handed(builder, arguments, answerer.reaching.signature.parameters)
    Left { builder: emit(handing, instance_called(answerer)), held: answerer.reaching.signature.result }
}

// example: list.length(each_handed(little_builder(""), [no_expr()], []).instructions) == 0
fn each_handed(builder: Builder, arguments: List<ast.Expr>, parameters: List<Option<Value>>) -> Builder {
    var handing = builder
    var at = 0
    for argument in arguments {
        handing = match list.at(parameters, at) {
            Some(wanted) => handed(handing, argument, wanted)
            None => handing
        }
        at += 1
    }
    handing
}

// example: held_key(statically(little_builder(""), Use { declared: infer.no_name().span, at: infer.no_name().span, within: whole() }, []).held) == "()"
fn statically(builder: Builder, use: Use, arguments: List<ast.Expr>) -> Left {
    let reached = use_reached(builder.lowering, use)
    let handing = each_handed(builder { lowering: reached.lowering }, arguments, reached.reaching.signature.parameters)
    let invoking = Call(function_of(owner: ModuleOf(handing.lowering.shapes.home), name: reached.reaching.named, signature: reached.reaching.signature))
    Left { builder: emit(handing, invoking), held: reached.reaching.signature.result }
}

// example: held_key(builds(little_builder(""), no_shape(), []).held) == "Anything"
fn builds(builder: Builder, shape: Shape, arguments: List<ast.Expr>) -> Left {
    var building = emits(builder, [New(shape.class), Copy])
    var at = 0
    for argument in arguments {
        building = match list.at(shape.carries, at) {
            Some(carried) => handed(building, argument, carried.of)
            None => building
        }
        at += 1
    }
    constructed(building, shape)
}

// example: held_key(field_built(little_builder(""), no_expr(), infer.no_name()).held) == "()"
fn field_built(builder: Builder, receiver: ast.Expr, name: ast.Name) -> Left {
    match offered_variant(builder, receiver, name) {
        Some(shape) => builds(builder, shape, [])
        None => field_read(builder, receiver, name)
    }
}

// example: held_key(field_read(little_builder(""), no_expr(), infer.no_name()).held) == "()"
fn field_read(builder: Builder, receiver: ast.Expr, name: ast.Name) -> Left {
    match split_receiver(builder, receiver) {
        Some(binding) => held_field(builder: builder, binding: binding, at: receiver.span, name: name)
        None => field_of_record(builder, receiver, name)
    }
}

// example: held_key(field_of_record(little_builder(""), no_expr(), infer.no_name()).held) == "()"
fn field_of_record(builder: Builder, receiver: ast.Expr, name: ast.Name) -> Left {
    let shape = record_of(builder, receiver.span)
    let left = expr_built(builder, receiver)
    let base = Of(shape.base)
    let reading = adapt(builder: left.builder, from: left.held, to: Some(base))
    match carried_named(shape, name.text) {
        Some(of) => Left { builder: emit(reading, GetField(FieldRef { owner: shape.class, name: name.text, of: of })), held: Some(of) }
        None => Left { builder: adapt(builder: reading, from: Some(base), to: None), held: None }
    }
}

// example: held_key(propagated(little_builder(""), no_expr(), infer.no_name().span).held) == "()"
fn propagated(builder: Builder, inner: ast.Expr, at: lexer.Span) -> Left {
    let named = named_type_at(builder, inner.span)
    let handed_back = if named == "Option" {
        "None"
    } else {
        "Err"
    }
    let carrying = if named == "Option" {
        "Some"
    } else {
        "Ok"
    }
    let failed = built_shape(builder.lowering.shapes, handed_back)
    let worked = built_shape(builder.lowering.shapes, carrying)
    let of = Of(failed.base)
    let left = expr_built(builder, inner)
    let holding = stored_aside(adapt(builder: left.builder, from: left.held, to: Some(of)), "tried", of)
    let held = Load(holding.local)
    let value = holding.builder.next_label
    let tested = emits(label_taken(holding.builder), [held, GetField(FieldRef { owner: failed.base, name: "tag", of: Small }), IntegerOf(or(failed.tag, 0)), CompareIntegers(Equal), JumpIfFalse(value)])
    let reading = emits(tested, [held, Return(tested.result), Label(value), held, Cast(worked.class), GetField(FieldRef { owner: worked.class, name: first_carried_name(worked), of: anything() })])
    let wanted = carried_at(reading, at)
    Left { builder: adapt(builder: reading, from: Some(anything()), to: wanted), held: wanted }
}

// example: held_key(record(little_builder(""), ast.Path { module: None, name: infer.no_name() }, []).held) == "Anything"
fn record(builder: Builder, base: ast.Path, fields: List<ast.FieldValue>) -> Left {
    if !is_unnamed(base.module) || value_definition(builder, base.name).kind == resolver.Constructor {
        return built_with(builder, base, fields)
    }
    updated(builder, base.name, fields)
}

// example: held_key(built_with(little_builder(""), ast.Path { module: None, name: infer.no_name() }, []).held) == "Anything"
fn built_with(builder: Builder, base: ast.Path, fields: List<ast.FieldValue>) -> Left {
    let shape = built_shape(builder.lowering.shapes, path_text(base))
    var building = emits(builder, [New(shape.class), Copy])
    for carried in shape.carries {
        building = given_fields(building, fields, carried)
    }
    constructed(building, shape)
}

// example: list.length(given_fields(little_builder(""), [], Carried { name: "a", of: Some(Whole) }).instructions) == 0
fn given_fields(builder: Builder, fields: List<ast.FieldValue>, carried: Carried) -> Builder {
    for written in fields {
        if written.name.text == carried.name {
            return handed(builder, ast.field_expression(written), carried.of)
        }
    }
    builder
}

// example: held_key(updated(little_builder(""), infer.no_name(), []).held) == "Anything"
fn updated(builder: Builder, base: ast.Name, fields: List<ast.FieldValue>) -> Left {
    let shape = record_updated(builder, base)
    var building = emits(builder, [New(shape.class), Copy])
    for carried in shape.carries {
        building = if is_written_for(fields, carried) {
            given_fields(building, fields, carried)
        } else {
            kept_values(building, base, shape, carried)
        }
    }
    constructed(building, shape)
}

// example: held_key(if_expr(little_builder(""), ast.IfExpr { branches: [], otherwise: None }, infer.no_name().span).held) == "()"
fn if_expr(builder: Builder, chain: ast.IfExpr, at: lexer.Span) -> Left {
    let wanted = carried_at(builder, at)
    let end = builder.next_label
    var writing = label_taken(builder)
    for branch in chain.branches {
        let otherwise = writing.next_label
        let tested = emit(condition_built(label_taken(writing), branch.condition), JumpIfFalse(otherwise))
        let left = block_built(tested, branch.block)
        writing = emits(adapt(builder: left.builder, from: left.held, to: wanted), [Jump(end), Label(otherwise)])
    }
    writing = match chain.otherwise {
        Some(block) => left_as(block_built(writing, block), wanted)
        None => writing
    }
    Left { builder: emit(writing, Label(end)), held: wanted }
}

// example: held_key(operated(builder: little_builder(""), operator: ast.Add, left: no_expr(), right: no_expr()).held) == "()"
fn operated(builder: Builder, operator: ast.BinaryOperator, left: ast.Expr, right: ast.Expr) -> Left {
    let asked = asked_by(operator)
    let found = instance_written(builder, method_of(builder.lowering.library, asked.of), left.span)
    match found.answered_by {
        Some(answerer) => through_the_operator(found.builder, asked, answerer, [left, right])
        None => written_out_operator(builder: found.builder, operator: operator, left: left, right: right)
    }
}

// example: held_key(written_out_instance(little_builder(""), ast.Name { text: "from_literal", span: infer.no_name().span }, [no_expr()]).held) == "()"
fn written_out_instance(builder: Builder, name: ast.Name, arguments: List<ast.Expr>) -> Left {
    let of = trait_of(builder.lowering.library, name.text)
    let first = or(list.at(arguments, 0), no_expr())
    if of == "IntegerLiteral" {
        return expr_built(builder, first)
    }
    if of == "Hash" || of == "Show" {
        return read_one(builder, of, first)
    }
    if of == "Neg" {
        return negated(builder, first)
    }
    written_out_operator(builder: builder, operator: written_as_operator(of), left: first, right: or(list.at(arguments, 1), no_expr()))
}

// example: held_key(read_one(little_builder(""), "Show", no_expr()).held) == "Text"
fn read_one(builder: Builder, of: String, value: ast.Expr) -> Left {
    let left = value_built(builder, value)
    let held = or(left.held, Whole)
    if of == "Hash" {
        return Left { builder: emits(left.builder, hashed_as(held)), held: Some(Whole) }
    }
    Left { builder: emits(left.builder, shown_as(held)), held: Some(text_value()) }
}

// example: held_key(added_to(little_builder(""), Local { name: "x#0", of: Whole }, no_expr()).held) == "Whole"
fn added_to(builder: Builder, local: Local, value: ast.Expr) -> Left {
    let loading = emit(builder, Load(local))
    let found = instance_written(loading, method_of(loading.lowering.library, "Add"), value.span)
    match found.answered_by {
        Some(answerer) => added_through(found.builder, answerer, value)
        None => added_out(found.builder, local, value)
    }
}

// example: held_key(added_through(little_builder(""), Instance { home: OfTheProgram("main"), reaching: Reaching { named: "add", signature: Signature { parameters: [Some(Whole), Some(Whole)], result: Some(Whole) } } }, no_expr()).held) == "Whole"
fn added_through(builder: Builder, answerer: Instance, value: ast.Expr) -> Left {
    let wanted = or(list.at(answerer.reaching.signature.parameters, 1), None)
    Left { builder: emit(handed(builder, value, wanted), instance_called(answerer)), held: answerer.reaching.signature.result }
}

// example: held_key(added_out(little_builder(""), Local { name: "x#0", of: Whole }, no_expr()).held) == "Whole"
fn added_out(builder: Builder, local: Local, value: ast.Expr) -> Left {
    let left = expr_built(builder, value)
    Left { builder: emit(adapt(builder: left.builder, from: left.held, to: Some(local.of)), written_out_add(local.of)), held: Some(local.of) }
}

// example: held_key(negated(little_builder(""), no_expr()).held) == "Whole"
fn negated(builder: Builder, operand: ast.Expr) -> Left {
    let found = instance_written(builder, method_of(builder.lowering.library, "Neg"), operand.span)
    match found.answered_by {
        Some(answerer) => calling(found.builder, answerer, [operand])
        None => negated_out(found.builder, operand)
    }
}

// example: held_key(negated_out(little_builder(""), no_expr()).held) == "Whole"
fn negated_out(builder: Builder, operand: ast.Expr) -> Left {
    let left = expr_built(builder, operand)
    Left { builder: emit(adapt(builder: left.builder, from: left.held, to: Some(Whole)), Arithmetic(Negate)), held: Some(Whole) }
}

// example: held_key(through_the_operator(little_builder(""), asked_by(ast.Add), Instance { home: OfTheProgram("main"), reaching: Reaching { named: "add", signature: Signature { parameters: [], result: Some(Whole) } } }, []).held) == "Whole"
fn through_the_operator(builder: Builder, asked: OperatorAsk, answerer: Instance, operands: List<ast.Expr>) -> Left {
    let given = if asked.reversed {
        the_other_way_round(builder, answerer, operands)
    } else {
        calling(builder, answerer, operands)
    }
    if asked.flipped {
        return Left { builder: emit(given.builder, Not), held: given.held }
    }
    given
}

// example: held_key(the_other_way_round(little_builder(""), Instance { home: OfTheProgram("main"), reaching: Reaching { named: "is_less", signature: Signature { parameters: [], result: Some(Truth) } } }, []).held) == "Truth"
// example: list.length(the_other_way_round(little_builder("fn f() -> () {\n    ()\n}\n"), Instance { home: OfTheProgram("main"), reaching: Reaching { named: "is_less", signature: Signature { parameters: [Some(anything()), Some(anything())], result: Some(Truth) } } }, [first_expr("fn f() -> () {\n    ()\n}\n"), first_expr("fn f() -> () {\n    ()\n}\n")]).builder.instructions) == 11
fn the_other_way_round(builder: Builder, answerer: Instance, operands: List<ast.Expr>) -> Left {
    var writing = builder
    var kept = []
    var at = 0
    for operand in operands {
        let wanted = list.at(answerer.reaching.signature.parameters, at)
        if at < list.length(answerer.reaching.signature.parameters) {
            let aside = operand_aside(writing, operand, or(wanted, None))
            writing = aside.builder
            kept = concatenated(first: aside.locals, second: kept)
        }
        at += 1
    }
    for local in kept {
        writing = emit(writing, Load(local))
    }
    Left { builder: emit(writing, instance_called(answerer)), held: answerer.reaching.signature.result }
}

// example: list.length(operand_aside(little_builder(""), no_expr(), None).locals) == 0
fn operand_aside(builder: Builder, operand: ast.Expr, wanted: Option<Value>) -> Asides {
    match wanted {
        Some(of) => aside_of(handed_aside(builder, operand, of))
        None => Asides { builder: handed(builder, operand, None), locals: [] }
    }
}

// example: handed_aside(little_builder(""), no_expr(), Whole).local == Local { name: "operand#0", of: Whole }
fn handed_aside(builder: Builder, operand: ast.Expr, of: Value) -> Aside {
    if !is_holding_nothing(builder, operand.span) {
        return put_aside_as(builder, operand, of)
    }
    stored_aside(handed(builder, operand, Some(of)), "operand", of)
}

// example: held_key(written_out_operator(builder: little_builder(""), operator: ast.Equal, left: no_expr(), right: no_expr()).held) == "Truth"
fn written_out_operator(builder: Builder, operator: ast.BinaryOperator, left: ast.Expr, right: ast.Expr) -> Left {
    if is_division(operator) {
        return divided(builder: builder, how: counted_by(operator), left: left, right: right)
    }
    let one = value_built(builder, left)
    let other = value_built(one.builder, right)
    let both_held = adapt(builder: other.builder, from: other.held, to: one.held)
    match operator {
        ast.Add => added(both_held, one.held)
        ast.Subtract => Left { builder: emit(both_held, Arithmetic(Subtract)), held: Some(Whole) }
        ast.Multiply => Left { builder: emit(both_held, Arithmetic(Multiply)), held: Some(Whole) }
        _ => Left { builder: emits(both_held, compared(one.held, operator_how(operator))), held: Some(Truth) }
    }
}

// example: held_key(supplied(little_builder(""), infer.no_name(), [], infer.no_name().span).held) == "()"
fn supplied(builder: Builder, name: ast.Name, arguments: List<ast.Expr>, written: lexer.Span) -> Left {
    if name.text == "send" || name.text == "ended" {
        return process_supplied(builder, name.text, arguments, written)
    }
    match held_named(builder, name.text, arguments) {
        Some(left) => left
        None => with_fallback(builder, name.text, arguments, written)
    }
}

// example: held_key(process_supplied(little_builder(""), "ended", [no_expr()], infer.no_name().span).held) == "()"
fn process_supplied(builder: Builder, name: String, arguments: List<ast.Expr>, written: lexer.Span) -> Left {
    let handle = handed(builder, or(list.at(arguments, 0), no_expr()), Some(handle_value()))
    if name == "ended" {
        let wanted = carried_at(builder, written)
        return Left { builder: adapt(builder: emits(handle, [GetField(handle_finished()), Awaited]), from: Some(anything()), to: wanted), held: wanted }
    }
    let waiting = named_value(builder.lowering.shapes, "Waiting")
    let sent = named_value(builder.lowering.shapes, "Sent")
    let handing = handed(handed(handle, or(list.at(arguments, 1), no_expr()), Some(anything())), or(list.at(arguments, 2), no_expr()), Some(waiting))
    let offered = Function { owner: handle_kind(), name: "sent", taken: [handle_value(), anything(), waiting], gives: Some(sent) }
    Left { builder: emit(handing, Call(offered)), held: Some(sent) }
}

// example: is_nothing(signature_of_process(little_lowering(""), ast.ProcessDeclaration { name: infer.no_name(), functions: [], span: infer.no_name().span, visibility: ast.Public }, 0).result)
fn signature_of_process(lowering: Lowering, declaration: ast.ProcessDeclaration, index: Int) -> Signature {
    match list.at(declaration.functions, index) {
        Some(function) => signature_of(lowering, function.name.span, whole())
        None => Signature { parameters: [], result: None }
    }
}

// example: handle_mailbox().name == "mailbox"
fn handle_mailbox() -> FieldRef {
    FieldRef { owner: handle_kind(), name: "mailbox", of: Of(Mailbox) }
}

// example: handle_finished().name == "finished"
fn handle_finished() -> FieldRef {
    FieldRef { owner: handle_kind(), name: "finished", of: Of(End) }
}

// example: held_key(with_fallback(little_builder(""), "", [], infer.no_name().span).held) == "()"
fn with_fallback(builder: Builder, name: String, arguments: List<ast.Expr>, written: lexer.Span) -> Left {
    let carrying = if name == "or" {
        "Some"
    } else {
        "Ok"
    }
    if name != "or" && name != "ok_or" {
        return Left { builder: builder, held: None }
    }
    let wanted = carried_at(builder, written)
    let held = set_aside(builder, or(list.at(arguments, 0), no_expr()))
    let fallback = set_aside_as(held.builder, or(list.at(arguments, 1), no_expr()), wanted)
    let otherwise = fallback.builder.next_label
    let end = otherwise + 1
    let shape = built_shape(builder.lowering.shapes, carrying)
    let falling = fallback.builder
    let tested = emits(falling { next_label: end + 1 }, carrying_tag(shape, held.local, otherwise))
    let read = read_carried(tested, shape, held.local, wanted)
    let reloaded = emits(read, concatenated(first: [Jump(end), Label(otherwise)], second: reloaded_from(fallback.locals)))
    Left { builder: emit(reloaded, Label(end)), held: wanted }
}

// example: set_aside(little_builder(""), no_expr()).local == Local { name: "answer#0", of: anything() }
fn set_aside(builder: Builder, answer: ast.Expr) -> Aside {
    let of = or(carried_at(builder, answer.span), anything())
    let left = expr_built(builder, answer)
    stored_aside(adapt(builder: left.builder, from: left.held, to: Some(of)), "answer", of)
}

// example: list.length(set_aside_as(little_builder(""), no_expr(), None).locals) == 0
fn set_aside_as(builder: Builder, fallback: ast.Expr, wanted: Option<Value>) -> Asides {
    let handing = handed(builder, fallback, wanted)
    match wanted {
        Some(of) => aside_of(stored_aside(handing, "fallback", of))
        None => Asides { builder: handing, locals: [] }
    }
}

// example: is_unwritten(held_by_the_compiler(little_builder(""), Through { module: infer.no_name(), name: infer.no_name(), used: infer.no_name().span }, []))
fn held_by_the_compiler(builder: Builder, through: Through, arguments: List<ast.Expr>) -> Option<Left> {
    if through.module.text != "list" {
        return None
    }
    held_named(builder, through.name.text, arguments)
}

// example: is_unwritten(held_named(little_builder(""), "push", []))
// example: !is_unwritten(held_named(little_builder(""), "length", [no_expr()]))
fn held_named(builder: Builder, name: String, arguments: List<ast.Expr>) -> Option<Left> {
    let values = or(list.at(arguments, 0), no_expr())
    if name == "length" && list.length(arguments) == 1 {
        return Some(read_length(builder: builder, values: values))
    }
    if list.length(arguments) != 2 {
        return None
    }
    let second = or(list.at(arguments, 1), no_expr())
    if name == "push" {
        return Some(list_push_built(builder: builder, values: values, value: second))
    }
    if name == "at" {
        return Some(read_at(builder: builder, values: values, index: second))
    }
    None
}

// example: held_key(read_length(builder: little_builder(""), values: no_expr()).held) == "Whole"
fn read_length(builder: Builder, values: ast.Expr) -> Left {
    let listed = handed(builder, values, Some(list_value()))
    Left { builder: emits(listed, [GetField(list_length()), Widen]), held: Some(Whole) }
}

// example: held_key(list_push_built(builder: little_builder(""), values: no_expr(), value: no_expr()).held) == "prelude.List"
fn list_push_built(builder: Builder, values: ast.Expr, value: ast.Expr) -> Left {
    let handing = handed(handed(builder, values, Some(list_value())), value, Some(anything()))
    Left { builder: emit(handing, Call(list_pushed())), held: Some(list_value()) }
}

// example: held_key(read_at(builder: little_builder(""), values: no_expr(), index: no_expr()).held) == "prelude.Option"
fn read_at(builder: Builder, values: ast.Expr, index: ast.Expr) -> Left {
    let listed = stored_aside(handed(builder, values, Some(list_value())), "list", list_value())
    let indexed = stored_aside(handed(listed.builder, index, Some(Whole)), "index", Whole)
    let stored_at = indexed.builder
    let at = Load(indexed.local)
    let holding = Load(listed.local)
    let empty = stored_at.next_label
    let end = empty + 1
    let within = [at, LongOf(0), CompareLongs(GreaterOrEqual), JumpIfFalse(empty), at, holding, GetField(list_length()), Widen, CompareLongs(Less), JumpIfFalse(empty)]
    let some = built_shape(builder.lowering.shapes, "Some")
    let reading = emits(stored_at { next_label: end + 1 }, concatenated(first: within, second: [New(some.class), Copy, holding, GetField(list_slots()), at, Narrow, LoadFromArray]))
    let held = constructed(reading, some)
    let none = builds(emits(held.builder, [Jump(end), Label(empty)]), built_shape(builder.lowering.shapes, "None"), [])
    Left { builder: emit(none.builder, Label(end)), held: held.held }
}

// example: held_key(inside_module(little_builder(""), Through { module: infer.no_name(), name: infer.no_name(), used: infer.no_name().span }, []).held) == "()"
fn inside_module(builder: Builder, through: Through, arguments: List<ast.Expr>) -> Left {
    match offered_shape(shapes: builder.lowering.shapes, module: through.module.text, name: through.name.text) {
        Some(shape) => builds(builder, shape, arguments)
        None => compiled_or_called(builder, through, arguments)
    }
}

// example: held_key(compiled_or_called(little_builder(""), Through { module: infer.no_name(), name: infer.no_name(), used: infer.no_name().span }, []).held) == "()"
fn compiled_or_called(builder: Builder, through: Through, arguments: List<ast.Expr>) -> Left {
    match held_by_the_compiler(builder, through, arguments) {
        Some(left) => left
        None => in_another_module(builder, through, arguments)
    }
}

// example: held_key(in_another_module(little_builder(""), Through { module: infer.no_name(), name: infer.no_name(), used: infer.no_name().span }, []).held) == "()"
fn in_another_module(builder: Builder, through: Through, arguments: List<ast.Expr>) -> Left {
    let reached = reached_method(builder, through)
    let handing = each_handed(reached.builder, arguments, reached.reaching.signature.parameters)
    let invoking = Call(function_of(owner: ModuleOf(module_named(builder.lowering.shapes.homes, through.module.text)), name: reached.reaching.named, signature: reached.reaching.signature))
    Left { builder: emit(handing, invoking), held: reached.reaching.signature.result }
}

// Where no arm fits, an `AssertionError` is thrown, because the JVM refuses a method that can
// run off its end.
// example: held_key(match_expr(little_builder(""), ast.MatchExpr { scrutinee: no_expr(), arms: [] }, infer.no_name().span).held) == "()"
fn match_expr(builder: Builder, matched: ast.MatchExpr, at: lexer.Span) -> Left {
    let wanted = carried_at(builder, at)
    let held = matched_held(builder, matched.scrutinee)
    let end = held.builder.next_label
    var writing = label_taken(held.builder)
    for arm in matched.arms {
        let next = writing.next_label
        let left = expr_built(tried(label_taken(writing), arm.pattern, held.local, next), arm.body)
        writing = emits(adapt(builder: left.builder, from: left.held, to: wanted), [Jump(end), Label(next)])
    }
    Left { builder: emit(unmatched(writing), Label(end)), held: wanted }
}

// example: is_unheld(matched_held(little_builder(""), no_expr()).local)
fn matched_held(builder: Builder, scrutinee: ast.Expr) -> HeldLocal {
    let of = carried_at(builder, scrutinee.span)
    let left = expr_built(builder, scrutinee)
    let adapted = adapt(builder: left.builder, from: left.held, to: of)
    match of {
        Some(holding) => held_aside(stored_aside(adapted, "matched", holding))
        None => HeldLocal { builder: adapted, local: None }
    }
}

// example: !is_unheld(held_aside(taken_local(little_builder(""), "a", Whole)).local)
fn held_aside(aside: Aside) -> HeldLocal {
    HeldLocal { builder: aside.builder, local: Some(aside.local) }
}

// example: use_reached(little_lowering(""), Use { declared: infer.no_name().span, at: infer.no_name().span, within: whole() }).reaching.named == ""
fn use_reached(lowering: Lowering, use: Use) -> Reachable {
    match generic_source(lowering, use.declared) {
        Some(function) => used_settled(lowering, use, function)
        None => Reachable { lowering: lowering, reaching: plainly(lowering, use.declared) }
    }
}

// example: used_settled(little_lowering(""), Use { declared: infer.no_name().span, at: infer.no_name().span, within: whole() }, no_function()).reaching.named == ""
fn used_settled(lowering: Lowering, use: Use, function: ast.FunctionDeclaration) -> Reachable {
    let at_use = substituted(use.within, used_as(lowering, use.at))
    let settled = instantiation_of(function: function, written_at: used_as(lowering, use.declared), used: at_use)
    let named = instantiation_names(settled, named_at(lowering, use.declared))
    let reaching = Reaching { named: named, signature: signature_of(lowering, use.declared, settled) }
    Reachable { lowering: owe(lowering, use.declared, named, settled), reaching: reaching }
}

// example: no_expr().span.start == 0
fn no_expr() -> ast.Expr {
    ast.Expr { kind: ast.Unit, span: infer.no_name().span }
}

// example: or(repeat_done(Some(Repeat { again: 1, done: 2 })), 0) == 2
fn repeat_done(repeat: Option<Repeat>) -> Option<Int> {
    match repeat {
        Some(labels) => Some(labels.done)
        None => None
    }
}

// example: or(repeat_again(Some(Repeat { again: 1, done: 2 })), 0) == 1
fn repeat_again(repeat: Option<Repeat>) -> Option<Int> {
    match repeat {
        Some(labels) => Some(labels.again)
        None => None
    }
}

// example: list.length(left_for(little_builder(""), Some(3)).instructions) == 1
fn left_for(builder: Builder, label: Option<Int>) -> Builder {
    match label {
        Some(to) => emit(builder, Jump(to))
        None => builder
    }
}

// example: !is_unheld(map.get(field_held(little_builder(""), "a", Whole).fields, "a"))
fn field_held(builder: Builder, key: String, of: Value) -> Builder {
    let holding = stored_aside(builder, "field", of)
    let held = holding.builder
    held { fields: map.insert(held.fields, key, holding.local) }
}

// example: list.length(left_as(Left { builder: little_builder(""), held: Some(Whole) }, None).instructions) == 1
fn left_as(left: Left, wanted: Option<Value>) -> Builder {
    adapt(builder: left.builder, from: left.held, to: wanted)
}

// example: list.length(walk_stepped(little_builder(""), Walk { walked_list: Local { name: "list#0", of: list_value() }, index: Local { name: "index#1", of: Small }, item: None }, 0).instructions) == 10
fn walk_stepped(builder: Builder, turn: Turn, done: Int) -> Builder {
    match turn {
        Walk { walked_list, index, item } => walked_over(builder: builder, walked_list: walked_list, index: index, item: item, done: done)
        _ => builder
    }
}

// example: list.length(walked_over(builder: little_builder(""), walked_list: Local { name: "list#0", of: list_value() }, index: Local { name: "index#1", of: Small }, item: None, done: 0).instructions) == 10
fn walked_over(builder: Builder, walked_list: Local, index: Local, item: Option<Local>, done: Int) -> Builder {
    let counting = Load(index)
    let walking = Load(walked_list)
    let testing = emits(builder, [counting, walking, GetField(list_length()), CompareIntegers(Less), JumpIfFalse(done)])
    let reading = emits(testing, [walking, GetField(list_slots()), counting, LoadFromArray])
    stored_in(reading, item, Some(anything()))
}

// example: is_nothing(None)
fn is_nothing(held: Option<Value>) -> Bool {
    match held {
        Some(_) => false
        None => true
    }
}

// example: list.length(nothing(little_builder("")).instructions) == 3
fn nothing(builder: Builder) -> Builder {
    emits(builder, as_object(None))
}

// example: list.length(as_object(None)) == 3
fn as_object(held: Option<Value>) -> List<Instruction> {
    match held {
        Some(of) => converted(held: of, wanted: anything())
        None => [New(Anything), Copy, Construct { built: Anything, taken: [] }]
    }
}

// example: !is_holding_nothing(little_builder(""), infer.no_name().span)
fn is_holding_nothing(builder: Builder, written: lexer.Span) -> Bool {
    match infer.type_at(builder.lowering.typed, written) {
        Some(of) => substituted(builder.at, of) == unify.Unit
        None => false
    }
}

// example: list.length(divided_answer(builder: little_builder(""), how: Divide, dividend: Local { name: "operand#0", of: Whole }, divisor: Local { name: "operand#1", of: Whole }).instructions) == 7
fn divided_answer(builder: Builder, how: Arithmetic, dividend: Local, divisor: Local) -> Builder {
    let some = built_shape(builder.lowering.shapes, "Some")
    let computed = emits(builder, [New(some.class), Copy, Load(dividend), Load(divisor), Arithmetic(how)])
    constructed(adapt(builder: computed, from: Some(Whole), to: first_carried(some)), some).builder
}

// example: list.length(added(little_builder(""), Some(Whole)).builder.instructions) == 1
fn added(builder: Builder, held: Option<Value>) -> Left {
    let adding = match held {
        Some(Of(_)) => Concat
        _ => Arithmetic(Add)
    }
    Left { builder: emit(builder, adding), held: held }
}

// example: is_not_through(reached_inside(little_builder(""), no_expr()))
fn reached_inside(builder: Builder, callee: ast.Expr) -> Option<Through> {
    match callee.kind {
        ast.Field { receiver, name } => through_module(builder, receiver, name, callee.span)
        _ => None
    }
}

// example: is_not_through(through_module(little_builder(""), no_expr(), infer.no_name(), infer.no_name().span))
fn through_module(builder: Builder, receiver: ast.Expr, name: ast.Name, used: lexer.Span) -> Option<Through> {
    match module_named_by(builder, receiver) {
        Some(module) => Some(Through { module: module, name: name, used: used })
        None => None
    }
}

// example: list.length(callee_of(no_expr(), [no_expr()]).passed) == 1
fn callee_of(callee: ast.Expr, arguments: List<ast.Expr>) -> Callee {
    match callee.kind {
        ast.NameExpr(name) => Callee { name: name, passed: arguments }
        _ => Callee { name: infer.no_name(), passed: arguments }
    }
}

// example: is_whole(split_receiver(little_builder(""), no_expr()))
fn split_receiver(builder: Builder, receiver: ast.Expr) -> Option<lexer.Span> {
    match receiver.kind {
        ast.NameExpr(held) => split_binding(builder, held)
        _ => None
    }
}

// example: is_whole(split_binding(little_builder(""), infer.no_name()))
fn split_binding(builder: Builder, name: ast.Name) -> Option<lexer.Span> {
    match value_definition(builder, name).origin {
        resolver.InPrelude => None
        resolver.Declared(at) => if set.has_value(builder.splitting, infer.span_key(at)) {
            Some(at)
        } else {
            None
        }
    }
}

// example: is_unshaped(offered_variant(little_builder(""), no_expr(), infer.no_name()))
fn offered_variant(builder: Builder, receiver: ast.Expr, name: ast.Name) -> Option<Shape> {
    match module_named_by(builder, receiver) {
        Some(module) => offered_shape(shapes: builder.lowering.shapes, module: module.text, name: name.text)
        None => None
    }
}

// example: is_unnamed(module_named_by(little_builder(""), no_expr()))
fn module_named_by(builder: Builder, receiver: ast.Expr) -> Option<ast.Name> {
    match receiver.kind {
        ast.NameExpr(module) => if value_definition(builder, module).kind == resolver.Module {
            Some(module)
        } else {
            None
        }
        _ => None
    }
}

// example: held_key(held_field(builder: little_builder(""), binding: infer.no_name().span, at: infer.no_name().span, name: infer.no_name()).held) == "()"
fn held_field(builder: Builder, binding: lexer.Span, at: lexer.Span, name: ast.Name) -> Left {
    match carried_named(record_of(builder, at), name.text) {
        Some(_) => local_loaded(builder, map.get(builder.fields, split_key(binding, name.text)))
        None => Left { builder: builder, held: None }
    }
}

// example: split_key(lexer.Span { start: 1, length: 2 }, "a") == "1048578 a"
fn split_key(binding: lexer.Span, field: String) -> String {
    shown(infer.span_key(binding)) + " " + field
}

// example: named_type_at(little_builder(""), infer.no_name().span) == ""
fn named_type_at(builder: Builder, written: lexer.Span) -> String {
    match infer.type_at(builder.lowering.typed, written) {
        Some(unify.Named { name }) => name
        _ => ""
    }
}

// example: !is_written_for([], Carried { name: "a", of: None })
fn is_written_for(fields: List<ast.FieldValue>, carried: Carried) -> Bool {
    for written in fields {
        if written.name.text == carried.name {
            return true
        }
    }
    false
}

// example: list.length(kept_values(little_builder(""), infer.no_name(), no_shape(), Carried { name: "a", of: None }).instructions) == 0
fn kept_values(builder: Builder, base: ast.Name, shape: Shape, carried: Carried) -> Builder {
    match carried.of {
        Some(of) => field_kept(builder, base, shape, FieldRef { owner: shape.class, name: carried.name, of: of })
        None => builder
    }
}

// example: list.length(field_kept(little_builder(""), infer.no_name(), no_shape(), FieldRef { owner: Anything, name: "a", of: Whole }).instructions) == 1
fn field_kept(builder: Builder, base: ast.Name, shape: Shape, reading: FieldRef) -> Builder {
    let left = loaded_value(builder, base)
    emit(adapt(builder: left.builder, from: left.held, to: Some(Of(shape.class))), GetField(reading))
}

// example: record_updated(little_builder(""), infer.no_name()).class == Anything
fn record_updated(builder: Builder, base: ast.Name) -> Shape {
    match value_definition(builder, base).origin {
        resolver.InPrelude => no_shape()
        resolver.Declared(at) => record_of(builder, at)
    }
}

// example: record_of(little_builder(""), infer.no_name().span).class == Anything
fn record_of(builder: Builder, written: lexer.Span) -> Shape {
    match infer.type_at(builder.lowering.typed, written) {
        Some(unify.Named { name }) => record_shape(builder.lowering.shapes, name)
        _ => no_shape()
    }
}

// example: held_key(constructed(little_builder(""), no_shape()).held) == "Anything"
fn constructed(builder: Builder, shape: Shape) -> Left {
    Left { builder: emit(builder, Construct { built: shape.class, taken: constructor_taken(shape) }), held: Some(Of(shape.base)) }
}

// example: held_key(loaded_value(little_builder(""), infer.no_name()).held) == "()"
fn loaded_value(builder: Builder, name: ast.Name) -> Left {
    local_loaded(builder, bound_local(builder, name))
}

// example: held_key(local_loaded(little_builder(""), Some(Local { name: "a#0", of: Whole })).held) == "Whole"
fn local_loaded(builder: Builder, local: Option<Local>) -> Left {
    match local {
        Some(held) => Left { builder: emit(builder, Load(held)), held: Some(held.of) }
        None => Left { builder: builder, held: None }
    }
}

// example: asked_by(ast.Greater).reversed
fn asked_by(operator: ast.BinaryOperator) -> OperatorAsk {
    match operator {
        ast.Equal => OperatorAsk { of: "Eq", reversed: false, flipped: false }
        ast.NotEqual => OperatorAsk { of: "Eq", reversed: false, flipped: true }
        ast.Less => OperatorAsk { of: "Ord", reversed: false, flipped: false }
        ast.LessOrEqual => OperatorAsk { of: "Ord", reversed: true, flipped: true }
        ast.Greater => OperatorAsk { of: "Ord", reversed: true, flipped: false }
        ast.GreaterOrEqual => OperatorAsk { of: "Ord", reversed: false, flipped: true }
        ast.Subtract => OperatorAsk { of: "Sub", reversed: false, flipped: false }
        ast.Multiply => OperatorAsk { of: "Mul", reversed: false, flipped: false }
        ast.Divide => OperatorAsk { of: "Div", reversed: false, flipped: false }
        ast.Remainder => OperatorAsk { of: "Rem", reversed: false, flipped: false }
        _ => OperatorAsk { of: "Add", reversed: false, flipped: false }
    }
}

// example: method_named(written_out_add(text_value())) == ""
fn written_out_add(of: Value) -> Instruction {
    match of {
        Array(_) => Concat
        Of(_) => Concat
        _ => Arithmetic(Add)
    }
}

// example: list.length(aside_of(put_aside_as(little_builder(""), no_expr(), Whole)).locals) == 1
fn aside_of(aside: Aside) -> Asides {
    Asides { builder: aside.builder, locals: [aside.local] }
}

// example: is_division(ast.Remainder)
fn is_division(operator: ast.BinaryOperator) -> Bool {
    match operator {
        ast.Divide => true
        ast.Remainder => true
        _ => false
    }
}

// example: is_division(written_as_operator("Div"))
fn written_as_operator(of: String) -> ast.BinaryOperator {
    match of {
        "Eq" => ast.Equal
        "Ord" => ast.Less
        "Sub" => ast.Subtract
        "Mul" => ast.Multiply
        "Div" => ast.Divide
        "Rem" => ast.Remainder
        _ => ast.Add
    }
}

// example: operator_how(ast.Less) == Less
fn operator_how(operator: ast.BinaryOperator) -> Comparison {
    match operator {
        ast.NotEqual => NotEqual
        ast.Less => Less
        ast.LessOrEqual => LessOrEqual
        ast.Greater => Greater
        ast.GreaterOrEqual => GreaterOrEqual
        _ => Equal
    }
}

// example: list.length([counted_by(ast.Multiply)]) == 1
fn counted_by(operator: ast.BinaryOperator) -> Arithmetic {
    match operator {
        ast.Subtract => Subtract
        ast.Multiply => Multiply
        ast.Divide => Divide
        ast.Remainder => Remainder
        _ => Add
    }
}

// example: list.length(reloaded_from([Local { name: "a#0", of: Whole }])) == 1
fn reloaded_from(locals: List<Local>) -> List<Instruction> {
    var loads = []
    for local in locals {
        loads = list.push(loads, Load(local))
    }
    loads
}

// example: list.length(read_carried(little_builder(""), no_shape(), Local { name: "a#0", of: Whole }, None).instructions) == 0
fn read_carried(builder: Builder, shape: Shape, held: Local, wanted: Option<Value>) -> Builder {
    match first_carried(shape) {
        Some(of) => adapt(builder: emits(builder, [Load(held), Cast(shape.class), GetField(FieldRef { owner: shape.class, name: first_carried_name(shape), of: of })]), from: Some(of), to: wanted)
        None => builder
    }
}

// example: is_nothing(first_carried(no_shape()))
fn first_carried(shape: Shape) -> Option<Value> {
    match list.at(shape.carries, 0) {
        Some(carried) => carried.of
        None => None
    }
}

// example: first_carried_name(no_shape()) == ""
fn first_carried_name(shape: Shape) -> String {
    match list.at(shape.carries, 0) {
        Some(carried) => carried.name
        None => ""
    }
}

// example: reached_method(little_builder(""), Through { module: infer.no_name(), name: infer.no_name(), used: infer.no_name().span }).reaching.named == ""
fn reached_method(builder: Builder, through: Through) -> Reaches {
    match infer.generic_at(builder.lowering.typed, through.name.span) {
        Some(generic) => generic_reached(builder, through, generic)
        None => Reaches { builder: builder, reaching: Reaching { named: through.name.text, signature: signature_of(builder.lowering, through.used, whole()) } }
    }
}

// example: generic_reached(little_builder(""), Through { module: infer.no_name(), name: infer.no_name(), used: infer.no_name().span }, infer.GenericUse { settled: [], constrained: [], written_as: unify.Unit }).reaching.named == ""
fn generic_reached(builder: Builder, through: Through, generic: infer.GenericUse) -> Reaches {
    var settled = []
    for one in generic.settled {
        settled = list.push(settled, substituted(builder.at, one))
    }
    let owing = each_instance_owed(builder.lowering, generic.constrained, settled)
    let named = asking_named(owing, GenericAsked { module: through.module.text, function: through.name.text, settled: settled, constrained: generic.constrained })
    let signature = written_as(named.lowering, substituted(builder.at, generic.written_as))
    Reaches { builder: builder { lowering: named.lowering }, reaching: Reaching { named: named.named, signature: signature } }
}

// example: asking_named(little_lowering(""), GenericAsked { module: "lexer", function: "pick", settled: [unify.int()], constrained: [[]] }).named == "pick$Int"
fn asking_named(lowering: Lowering, asked: GenericAsked) -> NamedAsked {
    let made = ask(lowering: lowering, module: asked.module, function: asked.function, settled: asked.settled)
    NamedAsked { lowering: made.lowering, named: generic_names(asked.function, made.written, asked.constrained) }
}

// example: list.length(each_instance_owed(little_lowering(""), [], []).owed) == 0
fn each_instance_owed(lowering: Lowering, constrained: List<List<String>>, settled: List<unify.Type>) -> Lowering {
    var owing = lowering
    var at = 0
    for traits in constrained {
        owing = match list.at(settled, at) {
            Some(one) => traits_answered(owing, traits, one)
            None => owing
        }
        at += 1
    }
    owing
}

// example: list.length(traits_answered(little_lowering(""), ["Eq"], unify.int()).owed) == 0
fn traits_answered(lowering: Lowering, traits: List<String>, at: unify.Type) -> Lowering {
    var owing = lowering
    for of in traits {
        owing = answering_at(owing, method_of(owing.library, of), at).lowering
    }
    owing
}

// example: list.length(unmatched(little_builder("")).instructions) == 1
fn unmatched(builder: Builder) -> Builder {
    emit(builder, Unmatched)
}

// example: list.length(tried(little_builder(""), ast.Pattern { kind: ast.Wildcard, span: infer.no_name().span }, None, 0).instructions) == 0
fn tried(builder: Builder, pattern: ast.Pattern, held: Option<Local>, next: Int) -> Builder {
    match held {
        Some(local) => tried_against(builder, pattern, Against { local: local, next: next })
        None => builder
    }
}

// example: list.length(tried_against(little_builder(""), ast.Pattern { kind: ast.TruthPattern(true), span: infer.no_name().span }, Against { local: Local { name: "matched#0", of: Truth }, next: 0 }).instructions) == 4
fn tried_against(builder: Builder, pattern: ast.Pattern, against: Against) -> Builder {
    match pattern.kind {
        ast.NamePattern(path) => tried_name(builder, path, against)
        ast.TuplePattern { path, elements } => tried_tuple(builder, path, elements, against)
        ast.RecordPattern { path, fields } => tried_record(builder, path, fields, against)
        ast.IntegerPattern(value) => tried_number(builder, value, pattern.span, against)
        ast.TextPattern(value) => equal_to(builder, TextOf(value), text_value(), pattern.span, against)
        ast.TruthPattern(value) => equal_to(builder, BooleanOf(value), Truth, pattern.span, against)
        ast.Wildcard => builder
        ast.OrPattern(alternatives) => tried_any_of(builder, alternatives, against)
    }
}

// example: little_builder("").next_label == 0
fn tried_any_of(builder: Builder, alternatives: List<ast.Pattern>, against: Against) -> Builder {
    let matched = builder.next_label
    var writing = label_taken(builder)
    let last = list.length(alternatives) - 1
    if last < 0 {
        return writing
    }
    var at = 0
    for alternative in alternatives {
        if at < last {
            let next = writing.next_label
            writing = emits(tried(label_taken(writing), alternative, Some(against.local), next), [Jump(matched), Label(next)])
        } else {
            writing = tried(writing, alternative, Some(against.local), against.next)
        }
        at += 1
    }
    emit(writing, Label(matched))
}

// example: list.length(tried_tuple(little_builder(""), ast.Path { module: None, name: infer.no_name() }, [], Against { local: Local { name: "matched#0", of: Whole }, next: 0 }).instructions) == 0
fn tried_tuple(builder: Builder, path: ast.Path, elements: List<ast.Pattern>, against: Against) -> Builder {
    let found = tagged(builder, path, against)
    var writing = found.builder
    var at = 0
    for element in elements {
        writing = match list.at(found.shape.carries, at) {
            Some(carried) => element_tried(writing, element, found.shape, carried, against)
            None => writing
        }
        at += 1
    }
    writing
}

// example: list.length(element_tried(little_builder(""), ast.Pattern { kind: ast.Wildcard, span: infer.no_name().span }, no_shape(), Carried { name: "a", of: None }, Against { local: Local { name: "matched#0", of: Whole }, next: 0 }).instructions) == 0
fn element_tried(builder: Builder, element: ast.Pattern, shape: Shape, carried: Carried, against: Against) -> Builder {
    match carried.of {
        Some(of) => tried_aside(stored_aside(pattern_read(builder, shape, carried, against), "element", of), element, against.next)
        None => builder
    }
}

// example: list.length(tried_aside(taken_local(little_builder(""), "a", Whole), ast.Pattern { kind: ast.Wildcard, span: infer.no_name().span }, 0).instructions) == 0
fn tried_aside(aside: Aside, pattern: ast.Pattern, next: Int) -> Builder {
    tried(aside.builder, pattern, Some(aside.local), next)
}

// example: label_taken(little_builder("")).next_label == 1
fn label_taken(builder: Builder) -> Builder {
    builder { next_label: builder.next_label + 1 }
}

// example: list.length(tried_number(little_builder(""), 1, infer.no_name().span, Against { local: Local { name: "matched#0", of: Whole }, next: 0 }).instructions) == 5
fn tried_number(builder: Builder, value: Int, written: lexer.Span, against: Against) -> Builder {
    let of = carried_at(builder, written)
    let loading = adapt(builder: emit(builder, Load(against.local)), from: Some(against.local.of), to: of)
    let pushed = whole_number(loading, value, written)
    same_as(pushed.builder, or(pushed.held, Whole), written, against)
}

// example: held_key(whole_number(little_builder(""), 1, infer.no_name().span).held) == "Whole"
fn whole_number(builder: Builder, value: Int, written: lexer.Span) -> Left {
    let found = instance_written(emit(builder, LongOf(value)), "from_literal", written)
    match found.answered_by {
        Some(answerer) => Left { builder: emit(found.builder, instance_called(answerer)), held: answerer.reaching.signature.result }
        None => Left { builder: found.builder, held: Some(Whole) }
    }
}

// example: list.length(tried_name(little_builder(""), ast.Path { module: None, name: infer.no_name() }, Against { local: Local { name: "matched#0", of: Whole }, next: 0 }).instructions) == 2
fn tried_name(builder: Builder, path: ast.Path, against: Against) -> Builder {
    if !is_unnamed(path.module) || value_definition(builder, path.name).kind == resolver.Constructor {
        return tagged(builder, path, against).builder
    }
    let declaring = declare(builder, path.name)
    stored_value(emit(declaring, Load(against.local)), path.name, Some(against.local.of))
}

// example: is_unnamed(None)
fn is_unnamed(found: Option<ast.Name>) -> Bool {
    match found {
        Some(_) => false
        None => true
    }
}

// example: list.length(tried_record(little_builder(""), ast.Path { module: None, name: infer.no_name() }, [], Against { local: Local { name: "matched#0", of: Whole }, next: 0 }).instructions) == 0
fn tried_record(builder: Builder, path: ast.Path, fields: List<ast.Name>, against: Against) -> Builder {
    let found = tagged(builder, path, against)
    var writing = found.builder
    for field in fields {
        let carried = Carried { name: field.text, of: carried_named(found.shape, field.text) }
        writing = stored_value(pattern_read(declare(writing, field), found.shape, carried, against), field, carried.of)
    }
    writing
}

// example: list.length(stored_value(little_builder(""), infer.no_name(), Some(Whole)).instructions) == 1
fn stored_value(builder: Builder, name: ast.Name, left: Option<Value>) -> Builder {
    stored_in(builder, bound_local(builder, name), left)
}

// example: list.length(stored_in(little_builder(""), Some(Local { name: "a#0", of: Whole }), Some(Whole)).instructions) == 1
fn stored_in(builder: Builder, local: Option<Local>, left: Option<Value>) -> Builder {
    match local {
        Some(into) => emit(adapt(builder: builder, from: left, to: Some(into.of)), Store(into))
        None => adapt(builder: builder, from: left, to: None)
    }
}

// The local has its place after a `#`, so two bindings of one name are two locals.
// example: list.length(declare(little_builder(""), infer.no_name()).locals) == 0
fn declare(builder: Builder, name: ast.Name) -> Builder {
    match carried_at(builder, name.span) {
        Some(of) => bound_aside(taken_local(builder, name.text, of), name)
        None => builder
    }
}

// example: !is_unheld(map.get(bound_aside(taken_local(little_builder(""), "a", Whole), infer.no_name()).bound, infer.span_key(infer.no_name().span)))
fn bound_aside(aside: Aside, name: ast.Name) -> Builder {
    let binding = aside.builder
    binding { bound: map.insert(binding.bound, infer.span_key(name.span), aside.local) }
}

// example: is_unheld(bound_local(little_builder(""), infer.no_name()))
fn bound_local(builder: Builder, name: ast.Name) -> Option<Local> {
    match value_definition(builder, name).origin {
        resolver.InPrelude => None
        resolver.Declared(at) => map.get(builder.bound, infer.span_key(at))
    }
}

// example: is_nothing(carried_at(little_builder(""), infer.no_name().span))
fn carried_at(builder: Builder, written: lexer.Span) -> Option<Value> {
    match infer.type_at(builder.lowering.typed, written) {
        Some(of) => carried_type(builder.lowering.shapes, substituted(builder.at, of))
        None => None
    }
}

// example: value_definition(little_builder(""), infer.no_name()).kind == resolver.Local
fn value_definition(builder: Builder, name: ast.Name) -> resolver.Definition {
    declared.definition_of(builder.lowering.typed.resolved, resolver.ValueNamespace, name)
}

// example: list.length(stored_aside(little_builder(""), "index", Small).builder.instructions) == 1
fn stored_aside(builder: Builder, role: String, of: Value) -> Aside {
    let taken = taken_local(builder, role, of)
    Aside { builder: emit(taken.builder, Store(taken.local)), local: taken.local }
}

// The local has its place after a `#`, so no two locals of one body share a name.
// example: taken_local(little_builder(""), "index", Small).local == Local { name: "index#0", of: Small }
fn taken_local(builder: Builder, role: String, of: Value) -> Aside {
    let taken = Local { name: role + "#" + shown(list.length(builder.locals)), of: of }
    Aside { builder: builder { locals: list.push(builder.locals, taken) }, local: taken }
}

// example: is_nothing(carried_named(no_shape(), "a"))
fn carried_named(shape: Shape, name: String) -> Option<Value> {
    for carried in shape.carries {
        if carried.name == name {
            return carried.of
        }
    }
    None
}

// example: tagged(little_builder(""), ast.Path { module: None, name: infer.no_name() }, Against { local: Local { name: "matched#0", of: Whole }, next: 0 }).shape.class == Anything
fn tagged(builder: Builder, path: ast.Path, against: Against) -> Tagged {
    let shape = built_shape(builder.lowering.shapes, path_text(path))
    match shape.tag {
        Some(_) => Tagged { builder: emits(builder, carrying_tag(shape, against.local, against.next)), shape: shape }
        None => Tagged { builder: builder, shape: shape }
    }
}

// example: list.length(carrying_tag(no_shape(), Local { name: "a#0", of: Whole }, 0)) == 6
fn carrying_tag(shape: Shape, held: Local, otherwise: Int) -> List<Instruction> {
    [Load(held), Cast(shape.base), GetField(FieldRef { owner: shape.base, name: "tag", of: Small }), IntegerOf(or(shape.tag, 0)), CompareIntegers(Equal), JumpIfFalse(otherwise)]
}

// example: list.length(pattern_read(little_builder(""), no_shape(), Carried { name: "a", of: Some(Whole) }, Against { local: Local { name: "matched#0", of: Whole }, next: 0 }).instructions) == 3
fn pattern_read(builder: Builder, shape: Shape, carried: Carried, against: Against) -> Builder {
    match carried.of {
        Some(of) => emits(builder, [Load(against.local), Cast(shape.class), GetField(FieldRef { owner: shape.class, name: carried.name, of: of })])
        None => builder
    }
}

// example: list.length(equal_to(little_builder(""), BooleanOf(true), Truth, infer.no_name().span, Against { local: Local { name: "matched#0", of: Truth }, next: 0 }).instructions) == 4
fn equal_to(builder: Builder, pushed: Instruction, of: Value, written: lexer.Span, against: Against) -> Builder {
    let loading = adapt(builder: emit(builder, Load(against.local)), from: Some(against.local.of), to: Some(of))
    same_as(emit(loading, pushed), of, written, against)
}

// example: list.length(adapt(builder: little_builder(""), from: Some(Whole), to: None).instructions) == 1
fn adapt(builder: Builder, from: Option<Value>, to: Option<Value>) -> Builder {
    match from {
        Some(held) => adapted_to(builder, held, to)
        None => builder
    }
}

// example: list.length(adapted_to(little_builder(""), Whole, Some(anything())).instructions) == 1
fn adapted_to(builder: Builder, held: Value, to: Option<Value>) -> Builder {
    match to {
        Some(wanted) => emits(builder, converted(held: held, wanted: wanted))
        None => emit(builder, Drop(held))
    }
}

// example: list.length(same_as(little_builder(""), Whole, infer.no_name().span, Against { local: Local { name: "matched#0", of: Whole }, next: 0 }).instructions) == 2
fn same_as(builder: Builder, held: Value, written: lexer.Span, against: Against) -> Builder {
    let found = instance_written(builder, "is_equal", written)
    let comparing = match found.answered_by {
        Some(answerer) => emit(found.builder, instance_called(answerer))
        None => emits(found.builder, compared(Some(held), Equal))
    }
    emit(comparing, JumpIfFalse(against.next))
}

// example: list.length(emit(little_builder(""), Copy).instructions) == 1
fn emit(builder: Builder, instruction: Instruction) -> Builder {
    builder { instructions: list.push(builder.instructions, instruction) }
}

// example: list.length(emits(little_builder(""), [Copy, Copy]).instructions) == 2
fn emits(builder: Builder, instructions: List<Instruction>) -> Builder {
    var writing = builder.instructions
    for instruction in instructions {
        writing = list.push(writing, instruction)
    }
    builder { instructions: writing }
}

// example: is_unfound(instance_written(little_builder(""), "is_equal", infer.no_name().span))
fn instance_written(builder: Builder, method: String, of: lexer.Span) -> Found {
    match infer.type_at(builder.lowering.typed, of) {
        Some(at) => found_in(builder, answering_at(builder.lowering, method, substituted(builder.at, at)))
        None => Found { builder: builder, answered_by: None }
    }
}

// example: is_unfound(found_in(little_builder(""), Answered { lowering: little_lowering(""), answered_by: None }))
fn found_in(builder: Builder, answered: Answered) -> Found {
    Found { builder: builder { lowering: answered.lowering }, answered_by: answered.answered_by }
}

// example: is_unshaped(offered_shape(shapes: no_shapes(), module: "lexer", name: "Span"))
fn offered_shape(shapes: Shapes, module: String, name: String) -> Option<Shape> {
    map.get(shapes.built_by, module + "." + name)
}

// example: record_shape(no_shapes(), "Box").class == Anything
fn record_shape(shapes: Shapes, named: String) -> Shape {
    match map.get(shapes.records, named) {
        Some(constructor) => built_shape(shapes, constructor)
        None => no_shape()
    }
}

// example: list_built().name == "of"
fn list_built() -> Function {
    Function { owner: list_kind(), name: "of", taken: [buffer()], gives: Some(list_value()) }
}

// example: list_pushed().name == "push"
fn list_pushed() -> Function {
    Function { owner: list_kind(), name: "push", taken: [list_value(), anything()], gives: Some(list_value()) }
}

// example: list_slots().name == "slots"
fn list_slots() -> FieldRef {
    FieldRef { owner: list_kind(), name: "slots", of: buffer() }
}

// example: list_length().name == "length"
fn list_length() -> FieldRef {
    FieldRef { owner: list_kind(), name: "length", of: Small }
}

// example: value_key(buffer()) == "Array<Anything>"
fn buffer() -> Value {
    Array(anything())
}

// example: list.length(instantiation_of(function: no_function(), written_at: unify.Unit, used: unify.Unit).settled) == 0
fn instantiation_of(function: ast.FunctionDeclaration, written_at: unify.Type, used: unify.Type) -> Instantiation {
    let found = settle(written_at: written_at, used: used, into: [])
    var settled = []
    for written in function.type_parameters {
        settled = list.push(settled, Settled { origin: written.name.span.start, at: or(bound_at(found, written.name.span.start), parameter_itself(written.name)), constrained: list.length(written.constraints) > 0 })
    }
    Instantiation { settled: settled }
}

// example: list.length(settle(written_at: unify.Unit, used: unify.Unit, into: [])) == 0
fn settle(written_at: unify.Type, used: unify.Type, into: List<Settled>) -> List<Settled> {
    match written_at {
        unify.Parameter(parameter) => bound_first(into, origin_of(parameter), used)
        unify.Named { arguments } => each_settled(mine: arguments, theirs: arguments_of(used), into: into)
        unify.Function { parameters, result } => settle(written_at: result, used: result_or_unit(used), into: each_settled(mine: parameters, theirs: parameters_or_none(used), into: into))
        _ => into
    }
}

// example: list.length(each_settled(mine: [], theirs: [], into: [])) == 0
fn each_settled(mine: List<unify.Type>, theirs: List<unify.Type>, into: List<Settled>) -> List<Settled> {
    var settling = into
    var at = 0
    for one in mine {
        settling = match list.at(theirs, at) {
            Some(other) => settle(written_at: one, used: other, into: settling)
            None => settling
        }
        at += 1
    }
    settling
}

// example: list.length(bound_first([], 3, unify.int())) == 1
fn bound_first(into: List<Settled>, origin: Int, at: unify.Type) -> List<Settled> {
    match bound_at(into, origin) {
        Some(_) => into
        None => list.push(into, Settled { origin: origin, at: at, constrained: false })
    }
}

// example: list.length(arguments_of(unify.list_of(unify.int()))) == 1
fn arguments_of(of: unify.Type) -> List<unify.Type> {
    match of {
        unify.Named { arguments } => arguments
        _ => []
    }
}

// example: instantiation_names(whole(), "pick") == "pick"
fn instantiation_names(at: Instantiation, function: String) -> String {
    var named = function
    for settled in at.settled {
        named += "$" + named_at_type(settled)
    }
    named
}

// example: generic_names("pick", [unify.list_of(unify.int())], [[]]) == "pick$List"
// example: generic_names("pick", [unify.list_of(unify.int())], [["Eq"]]) == "pick$List$Int"
fn generic_names(function: String, at: List<unify.Type>, constrained: List<List<String>>) -> String {
    var named = function
    var position = 0
    for one in at {
        named = match list.at(constrained, position) {
            Some(traits) => named + "$" + named_at_type(Settled { origin: 0, at: one, constrained: list.length(traits) > 0 })
            None => named
        }
        position += 1
    }
    named
}

// example: named_at_type(Settled { origin: 0, at: unify.Unit, constrained: false }) == "Unit"
fn named_at_type(settled: Settled) -> String {
    if settled.constrained {
        return wholly(settled.at)
    }
    head_of(settled.at)
}

// example: list.length(record_fields_of(declared.first_type("type Box = Box\n"))) == 0
fn record_fields_of(declaration: ast.TypeDeclaration) -> List<ast.RecordField> {
    match declaration.definition {
        ast.RecordType(fields) => fields
        _ => []
    }
}

// example: list.length(variants_of(declared.first_type("type Box = Box\n"))) == 1
fn variants_of(declaration: ast.TypeDeclaration) -> List<ast.Variant> {
    match declaration.definition {
        ast.Variants(variants) => variants
        _ => []
    }
}

// example: has_variants(declared.first_type("type Box = Box\n"))
fn has_variants(declaration: ast.TypeDeclaration) -> Bool {
    match declaration.definition {
        ast.Variants(_) => true
        _ => false
    }
}

// example: is_record(declared.first_type("type Box = { at: Int }\n"))
fn is_record(declaration: ast.TypeDeclaration) -> Bool {
    match declaration.definition {
        ast.RecordType(_) => true
        _ => false
    }
}

// example: list.length(shown_by_variant(no_writing(), [declared.no_variant()]).instructions) == 2
fn shown_by_variant(writing: Writing, variants: List<ast.Variant>) -> Writing {
    let end = labelled_writing(writing)
    var writes = end.writing
    let last = list.length(variants) - 1
    var position = 0
    for variant in variants {
        writes = if position == last {
            one_variant_shown(writes, variant)
        } else {
            variant_tested(writes, variant, end.label)
        }
        position += 1
    }
    written_out(writes, Label(end.label))
}

// example: list.length(variant_tested(no_writing(), declared.no_variant(), 0).instructions) == 8
fn variant_tested(writing: Writing, variant: ast.Variant, end: Int) -> Writing {
    let next = labelled_writing(writing)
    let tested = unless_it_is(next.writing, built_shape(writing.lowering.shapes, variant.name.text), next.label)
    each_written_out(one_variant_shown(tested, variant), [Jump(end), Label(next.label)])
}

// example: labelled_writing(no_writing()).label == 0
fn labelled_writing(writing: Writing) -> LabelledWriting {
    LabelledWriting { writing: writing { next_label: writing.next_label + 1 }, label: writing.next_label }
}

// example: list.length(unless_it_is(no_writing(), tagged_shape(), 3).instructions) == 5
fn unless_it_is(writing: Writing, shape: Shape, elsewhere: Int) -> Writing {
    let tagged_one = tag_read(writing, shape.base, 0)
    each_written_out(tagged_one, [IntegerOf(or(shape.tag, 0)), CompareIntegers(Equal), JumpIfFalse(elsewhere)])
}

// example: list.length(tag_read(no_writing(), main_box(), 1).instructions) == 2
fn tag_read(writing: Writing, base: Kind, side: Int) -> Writing {
    each_written_out(writing, [Load(side_of(side, base)), GetField(FieldRef { owner: base, name: "tag", of: Small })])
}

// example: list.length(one_variant_shown(no_writing(), declared.no_variant()).instructions) == 1
fn one_variant_shown(writing: Writing, variant: ast.Variant) -> Writing {
    let named = variant.name.text
    let held = variant_holds(writing, variant)
    match variant.payload {
        ast.NoPayload => written_out(writing, TextOf(named))
        ast.TuplePayload(_) => inside_brackets(writing, named, held)
        ast.RecordPayload(_) => inside_braces(writing, named, held)
    }
}

// example: list.length(variant_holds(no_writing(), declared.no_variant())) == 0
fn variant_holds(writing: Writing, variant: ast.Variant) -> List<Holds> {
    let shape = built_shape(writing.lowering.shapes, variant.name.text)
    match variant.payload {
        ast.NoPayload => []
        ast.TuplePayload(written) => held_values(shape, positions_written(written))
        ast.RecordPayload(fields) => held_values(shape, fields_written(fields))
    }
}

// example: list.length(fields_written([])) == 0
fn fields_written(fields: List<ast.RecordField>) -> List<WrittenValue> {
    var written = []
    for field in fields {
        written = list.push(written, WrittenValue { named: Some(field.name.text), written: field.type_ref })
    }
    written
}

// example: list.length(positions_written([])) == 0
fn positions_written(written: List<ast.TypeRef>) -> List<WrittenValue> {
    var values = []
    for type_ref in written {
        values = list.push(values, WrittenValue { named: None, written: type_ref })
    }
    values
}

// example: list.length(held_values(no_shape(), [])) == 0
fn held_values(shape: Shape, written: List<WrittenValue>) -> List<Holds> {
    var held = []
    var position = 0
    for carried in shape.carries {
        held = match list.at(written, position) {
            Some(value) => held_value(held, shape, carried, value)
            None => held
        }
        position += 1
    }
    held
}

// example: list.length(held_value([], no_shape(), Carried { name: "x", of: None }, WrittenValue { named: None, written: unit_written() })) == 0
fn held_value(held: List<Holds>, shape: Shape, carried: Carried, value: WrittenValue) -> List<Holds> {
    match carried.of {
        Some(of) => list.push(held, Holds { shape: shape, carried: carried, of: of, named: value.named, written: value.written })
        None => held
    }
}

// example: list.length(inside_braces(no_writing(), "Box", []).instructions) == 3
fn inside_braces(writing: Writing, named: String, held: List<Holds>) -> Writing {
    var writes = written_out(writing, TextOf(named + " {"))
    var position = 0
    for holds in held {
        let opening = if position == 0 {
            " "
        } else {
            ", "
        }
        writes = showing(each_written_out(writes, [TextOf(opening + or(holds.named, "") + ": "), Concat]), holds)
        position += 1
    }
    let closing = if list.length(held) == 0 {
        "}"
    } else {
        " }"
    }
    each_written_out(writes, [TextOf(closing), Concat])
}

// example: list.length(inside_brackets(no_writing(), "Box", []).instructions) == 3
fn inside_brackets(writing: Writing, named: String, held: List<Holds>) -> Writing {
    var writes = written_out(writing, TextOf(named + "("))
    var position = 0
    for holds in held {
        if position > 0 {
            writes = each_written_out(writes, [TextOf(", "), Concat])
        }
        writes = showing(writes, holds)
        position += 1
    }
    each_written_out(writes, [TextOf(")"), Concat])
}

// example: list.length(showing(no_writing(), Holds { shape: no_shape(), carried: Carried { name: "x", of: Some(Whole) }, of: Whole, named: None, written: unit_written() }).instructions) == 4
fn showing(writing: Writing, holds: Holds) -> Writing {
    written_out(derived_through(value_read(writing, holds, 0), "Show", holds), Concat)
}

// example: list.length(value_read(no_writing(), Holds { shape: no_shape(), carried: Carried { name: "x", of: Some(Whole) }, of: Whole, named: None, written: unit_written() }, 0).instructions) == 2
fn value_read(writing: Writing, holds: Holds, side: Int) -> Writing {
    let shape = holds.shape
    let loaded = written_out(writing, Load(side_of(side, shape.base)))
    let cast = if shape.class != shape.base {
        written_out(loaded, Cast(shape.class))
    } else {
        loaded
    }
    written_out(cast, GetField(FieldRef { owner: shape.class, name: holds.carried.name, of: holds.of }))
}

// example: side_of(1, main_box()) == Local { name: "other", of: Of(main_box()) }
fn side_of(side: Int, base: Kind) -> Local {
    Local { name: side_name(side), of: Of(base) }
}

// example: side_name(0) == "one"
fn side_name(side: Int) -> String {
    if side == 0 {
        return "one"
    }
    "other"
}

// example: list.length(derived_through(no_writing(), "Eq", Holds { shape: no_shape(), carried: Carried { name: "x", of: Some(Whole) }, of: Whole, named: None, written: unit_written() }).instructions) == 1
fn derived_through(writing: Writing, of: String, holds: Holds) -> Writing {
    let answered = answering_at(writing.lowering, method_of(writing.lowering.library, of), type_written_as(holds.written))
    let answering_writing = writing { lowering: answered.lowering }
    match answered.answered_by {
        Some(answerer) => written_out(answering_writing, instance_called(answerer))
        None => each_written_out(answering_writing, derived_supplied(of, holds.of))
    }
}

// `Bool`, `Int`, and `String` answer inside the prelude with instructions rather than a call.
// example: is_unanswered(answering_at(little_lowering(""), "is_equal", unify.int()))
fn answering_at(lowering: Lowering, method: String, at: unify.Type) -> Answered {
    match at {
        unify.Named { name, arguments } => answering_named(lowering, method, at, Home { module: name, name: name }, arguments)
        _ => Answered { lowering: lowering, answered_by: None }
    }
}

// example: is_unanswered(answering_named(little_lowering(""), "is_equal", unify.int(), Home { module: "Int", name: "Int" }, []))
fn answering_named(lowering: Lowering, method: String, at: unify.Type, written: Home, arguments: List<unify.Type>) -> Answered {
    let name = written.name
    if lowering.module == "prelude" && (name == "Bool" || name == "Int" || name == "String") {
        return Answered { lowering: lowering, answered_by: None }
    }
    match declaring_module(lowering, name) {
        Some(home) => answered_elsewhere(lowering, Asking { method: method, at: at, home: home, arguments: arguments })
        None => written_here(lowering: lowering, method: method, named: name, arguments: arguments)
    }
}

// example: or(declaring_module(little_lowering(""), "List"), Home { module: "", name: "" }).module == "prelude"
fn declaring_module(lowering: Lowering, name: String) -> Option<Home> {
    if name == "List" {
        if lowering.module != "prelude" {
            return Some(Home { module: "prelude", name: "List" })
        }
        return None
    }
    split_at_dot(name)
}

// example: is_unanswered(answered_elsewhere(little_lowering(""), Asking { method: "is_equal", at: unify.Unit, home: Home { module: "lexer", name: "Span" }, arguments: [] })) == false
fn answered_elsewhere(lowering: Lowering, asking: Asking) -> Answered {
    let of = trait_of(lowering.library, asking.method)
    let answerer = of + "$" + asking.home.name + "$" + asking.method
    let asked = if list.length(asking.arguments) == 0 {
        AskedOf { lowering: lowering, written: [] }
    } else {
        ask(lowering: lowering, module: asking.home.module, function: answerer, settled: asking.arguments)
    }
    let signature = written_as(lowering, instance_signature(library: lowering.library, of: of, method: asking.method, at: asking.at))
    let reaching = Reaching { named: names_wholly(answerer, asked.written), signature: signature }
    Answered { lowering: asked.lowering, answered_by: Some(Instance { home: module_named(asked.lowering.shapes.homes, asking.home.module), reaching: reaching }) }
}

// example: unify.text_of(instance_signature(library: little_library(), of: "Eq", method: "is_equal", at: unify.int())) == "(Int, Int) -> Bool"
fn instance_signature(library: Library, of: String, method: String, at: unify.Type) -> unify.Type {
    or(declared.method_at(library.prelude.declared, of, method, at), unify.Unit)
}

// example: list.length(ask(lowering: little_lowering(""), module: "lexer", function: "pick", settled: [unify.int()]).lowering.asks.of) == 1
fn ask(lowering: Lowering, module: String, function: String, settled: List<unify.Type>) -> AskedOf {
    let written = each_written_by(lowering.shapes, module, settled)
    let foreign = foreign_written_by(lowering.shapes, module, settled)
    let asks = noted(lowering.asks, Specialisation { module: module, function: function, settled: written, foreign: foreign })
    AskedOf { lowering: lowering { asks: asks }, written: written }
}

// example: list.length(noted(Asked { of: [little_ask()] }, little_ask()).of) == 1
fn noted(asked: Asked, one: Specialisation) -> Asked {
    if list.has_value(asked.of, one) {
        return asked
    }
    Asked { of: list.push(asked.of, one) }
}

// example: is_unanswered(written_here(lowering: little_lowering(""), method: "is_equal", named: "Box", arguments: []))
fn written_here(lowering: Lowering, method: String, named: String, arguments: List<unify.Type>) -> Answered {
    match map.get(lowering.answers, method + " " + named) {
        Some(answers) => answered_here(lowering, answers, arguments)
        None => Answered { lowering: lowering, answered_by: None }
    }
}

// example: answered_here(little_lowering(""), Answers { method: "f", for_type: "Box", arguments: [], declared: infer.no_name().span }, []).lowering.module == "main"
fn answered_here(lowering: Lowering, answers: Answers, arguments: List<unify.Type>) -> Answered {
    let reached = instance_method(lowering, answers, arguments)
    Answered { lowering: reached.lowering, answered_by: Some(Instance { home: lowering.shapes.home, reaching: reached.reaching }) }
}

// example: instance_method(little_lowering(""), Answers { method: "f", for_type: "Box", arguments: [], declared: infer.no_name().span }, []).reaching.named == ""
fn instance_method(lowering: Lowering, answers: Answers, arguments: List<unify.Type>) -> Reachable {
    match generic_source(lowering, answers.declared) {
        Some(function) => instance_settled(lowering, answers, arguments, function)
        None => Reachable { lowering: lowering, reaching: plainly(lowering, answers.declared) }
    }
}

// example: instance_settled(little_lowering(""), Answers { method: "f", for_type: "Box", arguments: [], declared: infer.no_name().span }, [unify.int()], no_function()).reaching.named == "$Int"
fn instance_settled(lowering: Lowering, answers: Answers, arguments: List<unify.Type>, function: ast.FunctionDeclaration) -> Reachable {
    let settled = asked_for(function, settled_by(function, answers, arguments))
    let named = names_wholly(named_at(lowering, answers.declared), arguments)
    let reaching = Reaching { named: named, signature: signature_of(lowering, answers.declared, settled) }
    Reachable { lowering: owe(lowering, answers.declared, named, settled), reaching: reaching }
}

// example: is_plain(generic_source(little_lowering(""), infer.no_name().span))
fn generic_source(lowering: Lowering, written_at: lexer.Span) -> Option<ast.FunctionDeclaration> {
    match map.get(lowering.declared, infer.span_key(written_at)) {
        Some(found) => generic_body(found.body)
        None => None
    }
}

// example: is_plain(generic_body(FromJava(no_extern())))
fn generic_body(written: Written) -> Option<ast.FunctionDeclaration> {
    match written {
        Source(function) => generic_function(function)
        _ => None
    }
}

// example: is_plain(generic_function(no_function()))
fn generic_function(function: ast.FunctionDeclaration) -> Option<ast.FunctionDeclaration> {
    if list.length(function.type_parameters) == 0 {
        return None
    }
    Some(function)
}

// example: plainly(little_lowering(""), infer.no_name().span).named == ""
fn plainly(lowering: Lowering, written_at: lexer.Span) -> Reaching {
    Reaching { named: named_at(lowering, written_at), signature: signature_of(lowering, written_at, whole()) }
}

// example: list.length(owe(little_lowering(""), infer.no_name().span, "f", whole()).owed) == 1
fn owe(lowering: Lowering, written_at: lexer.Span, named: String, at: Instantiation) -> Lowering {
    lowering { owed: list.push(lowering.owed, Owed { declared: written_at, named: named, at: at }) }
}

// example: named_at(little_lowering("fn f() -> Int {\n    1\n}\n"), lexer.Span { start: 3, length: 1 }) == "f"
fn named_at(lowering: Lowering, written_at: lexer.Span) -> String {
    match map.get(lowering.declared, infer.span_key(written_at)) {
        Some(found) => found.named
        None => ""
    }
}

// example: list.length(written_as(little_lowering(""), unify.Function { parameters: [unify.int()], result: unify.Unit }).parameters) == 1
fn written_as(lowering: Lowering, written_at: unify.Type) -> Signature {
    signature_over(lowering.shapes, written_at, whole())
}

// example: list.length(signature_of(little_lowering("fn f(x: Int) -> Int {\n    x\n}\n"), lexer.Span { start: 3, length: 1 }, whole()).parameters) == 1
fn signature_of(lowering: Lowering, written_at: lexer.Span, at: Instantiation) -> Signature {
    signature_over(lowering.shapes, used_as(lowering, written_at), at)
}

// example: is_nothing(signature_over(no_shapes(), unify.Unit, whole()).result)
fn signature_over(shapes: Shapes, written_at: unify.Type, at: Instantiation) -> Signature {
    match written_at {
        unify.Function { parameters, result } => Signature { parameters: each_carried(shapes, parameters, at), result: carried_type(shapes, substituted(at, result)) }
        _ => Signature { parameters: [], result: None }
    }
}

// example: held_key(or(list.at(each_carried(no_shapes(), [unify.int()], whole()), 0), None)) == "Whole"
fn each_carried(shapes: Shapes, several: List<unify.Type>, at: Instantiation) -> List<Option<Value>> {
    var carried = []
    for one in several {
        carried = list.push(carried, carried_type(shapes, substituted(at, one)))
    }
    carried
}

// example: method_named(instance_called(Instance { home: OfTheProgram("main"), reaching: Reaching { named: "f", signature: Signature { parameters: [], result: None } } })) == "f"
fn instance_called(answerer: Instance) -> Instruction {
    Call(function_of(owner: ModuleOf(answerer.home), name: answerer.reaching.named, signature: answerer.reaching.signature))
}

// example: function_of(owner: ModuleOf(OfTheProgram("main")), name: "f", signature: Signature { parameters: [None, Some(Whole)], result: None }).taken == [Whole]
fn function_of(owner: Kind, name: String, signature: Signature) -> Function {
    Function { owner: owner, name: name, taken: taken_values(signature.parameters), gives: signature.result }
}

// example: settled_by(no_function(), Answers { method: "", for_type: "", arguments: [], declared: infer.no_name().span }, []) == []
fn settled_by(function: ast.FunctionDeclaration, answers: Answers, at: List<unify.Type>) -> List<unify.Type> {
    var settled = []
    for written_at in function.type_parameters {
        settled = list.push(settled, settling_of(written_at.name, answers, at))
    }
    settled
}

// example: settling_of(infer.no_name(), Answers { method: "", for_type: "", arguments: [""], declared: infer.no_name().span }, [unify.int()]) == unify.int()
fn settling_of(written_at: ast.Name, answers: Answers, at: List<unify.Type>) -> unify.Type {
    let itself = parameter_itself(written_at)
    match list.index_of(answers.arguments, written_at.text) {
        Some(position) => or(list.at(at, position), itself)
        None => itself
    }
}

// example: method_of(little_library(), "Eq") == "is_equal"
fn method_of(library: Library, of: String) -> String {
    for declaration in library.traits {
        if declaration.name.text == of && list.length(declaration.methods) == 1 {
            return or(list.at(declaration.methods, 0), no_signature()).name.text
        }
    }
    ""
}

// example: trait_of(little_library(), "from_literal") == "IntegerLiteral"
fn trait_of(library: Library, method: String) -> String {
    for declaration in library.traits {
        for signature in declaration.methods {
            if signature.name.text == method {
                return declaration.name.text
            }
        }
    }
    ""
}

// example: no_signature().name.text == ""
fn no_signature() -> ast.Signature {
    ast.Signature { name: infer.no_name(), parameters: [], result: None, span: infer.no_name().span }
}

// example: unify.text_of(as_written_by(main_shapes(), "lexer", unify.Named { name: "Box", arguments: [] })) == "main.Box"
fn as_written_by(shapes: Shapes, by: String, of: unify.Type) -> unify.Type {
    match of {
        unify.Named { name, arguments } => unify.Named { name: written_by(shapes: shapes, by: by, named: name), arguments: each_written_by(shapes, by, arguments) }
        _ => of
    }
}

// example: list.length(each_written_by(no_shapes(), "lexer", [unify.int()])) == 1
fn each_written_by(shapes: Shapes, by: String, several: List<unify.Type>) -> List<unify.Type> {
    var written = []
    for one in several {
        written = list.push(written, as_written_by(shapes, by, one))
    }
    written
}

// example: list.length(foreign_written_by(no_shapes(), "lexer", [unify.int()])) == 0
fn foreign_written_by(shapes: Shapes, by: String, several: List<unify.Type>) -> List<Foreign> {
    var found = []
    for one in several {
        found = match one {
            unify.Named { name, arguments } => concatenated(first: foreign_named(shapes: shapes, by: by, name: name, found: found), second: foreign_written_by(shapes, by, arguments))
            _ => found
        }
    }
    found
}

// example: list.length(foreign_named(shapes: no_shapes(), by: "lexer", name: "Int", found: [])) == 0
fn foreign_named(shapes: Shapes, by: String, name: String, found: List<Foreign>) -> List<Foreign> {
    match map.get(shapes.foreign, name) {
        Some(reached) => list.push(found, Foreign { name: written_by(shapes: shapes, by: by, named: name), reached: reached })
        None => found
    }
}

// example: written_by(shapes: no_shapes(), by: "lexer", named: "lexer.Span") == "Span"
// example: written_by(shapes: no_shapes(), by: "main", named: "lexer.Span") == "lexer.Span"
fn written_by(shapes: Shapes, by: String, named: String) -> String {
    match split_at_dot(named) {
        Some(home) => if home.module == by {
            home.name
        } else {
            named
        }
        None => if set.has_value(shapes.own, named) {
            shapes.module + "." + named
        } else {
            named
        }
    }
}

// example: list.length(whole().settled) == 0
fn whole() -> Instantiation {
    Instantiation { settled: [] }
}

// example: list.length(asked_for(no_function(), []).settled) == 0
fn asked_for(function: ast.FunctionDeclaration, settled: List<unify.Type>) -> Instantiation {
    var over = []
    var position = 0
    for written in function.type_parameters {
        over = list.push(over, Settled { origin: written.name.span.start, at: or(list.at(settled, position), parameter_itself(written.name)), constrained: list.length(written.constraints) > 0 })
        position += 1
    }
    Instantiation { settled: over }
}

// example: unify.text_of(parameter_itself(ast.Name { text: "T", span: infer.no_name().span })) == "T"
fn parameter_itself(written: ast.Name) -> unify.Type {
    unify.Parameter(unify.written_parameter(written.text, written.span.start))
}

// example: substituted(whole(), unify.int()) == unify.int()
fn substituted(at: Instantiation, of: unify.Type) -> unify.Type {
    if list.length(at.settled) == 0 {
        return of
    }
    match of {
        unify.Parameter(parameter) => or(bound_at(at.settled, origin_of(parameter)), of)
        unify.Named { name, arguments } => unify.Named { name: name, arguments: each_substituted(at, arguments) }
        unify.Function { parameters, result } => unify.Function { parameters: each_substituted(at, parameters), result: substituted(at, result) }
        _ => of
    }
}

// example: list.length(each_substituted(whole(), [unify.int()])) == 1
fn each_substituted(at: Instantiation, several: List<unify.Type>) -> List<unify.Type> {
    var replaced = []
    for one in several {
        replaced = list.push(replaced, substituted(at, one))
    }
    replaced
}

// example: origin_of(unify.written_parameter("T", 4)) == 4
fn origin_of(parameter: unify.TypeParameter) -> Int {
    match parameter.origin {
        unify.FromThePrelude => -1
        unify.WrittenAt(start) => start
    }
}

// example: is_unsettled(bound_at([], 3))
fn bound_at(settled: List<Settled>, origin: Int) -> Option<unify.Type> {
    for one in settled {
        if one.origin == origin {
            return Some(one.at)
        }
    }
    None
}

// example: names_wholly("Eq$List$is_equal", [unify.int()]) == "Eq$List$is_equal$Int"
fn names_wholly(named: String, at: List<unify.Type>) -> String {
    var written = named
    for one in at {
        written += "$" + wholly(one)
    }
    written
}

// example: wholly(unify.list_of(unify.list_of(unify.int()))) == "List$List$Int"
fn wholly(at: unify.Type) -> String {
    match at {
        unify.Named { name, arguments } => wholly_named(name, arguments)
        _ => head_of(at)
    }
}

// example: wholly_named("lexer.Span", []) == "lexer$Span"
fn wholly_named(name: String, arguments: List<unify.Type>) -> String {
    var written = dots_replaced(named: name, replacement: "$")
    for argument in arguments {
        written += "$" + wholly(argument)
    }
    written
}

// example: head_of(unify.Unit) == "Unit"
// example: head_of(unify.Var(1)) == "Any"
fn head_of(at: unify.Type) -> String {
    match at {
        unify.Named { name } => dots_replaced(named: name, replacement: "$")
        unify.Unit => "Unit"
        _ => "Any"
    }
}

// example: list.length(written_out(no_writing(), Copy).instructions) == 1
fn written_out(writing: Writing, instruction: Instruction) -> Writing {
    writing { instructions: list.push(writing.instructions, instruction) }
}

// example: list.length(each_written_out(no_writing(), [Copy, Copy]).instructions) == 2
fn each_written_out(writing: Writing, instructions: List<Instruction>) -> Writing {
    writing { instructions: concatenated(first: writing.instructions, second: instructions) }
}

// example: unify.text_of(type_written_as(unit_written())) == "()"
fn type_written_as(written: ast.TypeRef) -> unify.Type {
    match written.kind {
        ast.NamedType { path, arguments } => unify.Named { name: path_text(path), arguments: each_type_written_as(arguments) }
        ast.UnitType => unify.Unit
    }
}

// example: list.length(each_type_written_as([])) == 0
fn each_type_written_as(written: List<ast.TypeRef>) -> List<unify.Type> {
    var several = []
    for one in written {
        several = list.push(several, type_written_as(one))
    }
    several
}

// example: path_text(ast.Path { module: Some(ast.Name { text: "a", span: infer.no_name().span }), name: ast.Name { text: "B", span: infer.no_name().span } }) == "a.B"
fn path_text(path: ast.Path) -> String {
    match path.module {
        Some(module) => module.text + "." + path.name.text
        None => path.name.text
    }
}

// example: list.length(derived_supplied("Hash", Whole)) == 0
fn derived_supplied(of: String, held: Value) -> List<Instruction> {
    if of == "Eq" {
        return compared(Some(held), Equal)
    }
    if of == "Ord" {
        return compared(Some(held), Less)
    }
    if of == "Hash" {
        return hashed_as(held)
    }
    shown_as(held)
}

// example: list.length(compared(Some(text_value()), Less)) == 3
// example: list.length(compared(None, Equal)) == 1
fn compared(held: Option<Value>, how: Comparison) -> List<Instruction> {
    match held {
        Some(Whole) => [CompareLongs(how)]
        Some(Truth) => [CompareIntegers(how)]
        Some(Small) => [CompareIntegers(how)]
        Some(_) => by_value(how)
        None => [BooleanOf(how == Equal)]
    }
}

// example: list.length(by_value(NotEqual)) == 2
fn by_value(how: Comparison) -> List<Instruction> {
    match how {
        Equal => [TextEqual]
        NotEqual => [TextEqual, Not]
        _ => [TextCompared, IntegerOf(0), CompareIntegers(how)]
    }
}

// example: list.length(hashed_as(Whole)) == 0
// example: list.length(hashed_as(text_value())) == 2
fn hashed_as(held: Value) -> List<Instruction> {
    match held {
        Whole => []
        Of(_) => [TextHashed, Widen]
        _ => [Widen]
    }
}

// example: list.length(shown_as(text_value())) == 0
// example: list.length(shown_as(Whole)) == 1
fn shown_as(held: Value) -> List<Instruction> {
    match held {
        Whole => [Shown(Whole)]
        Truth => [Shown(Truth)]
        _ => []
    }
}

// example: list.length(extern_body(little_lowering(""), no_extern(), Signature { parameters: [], result: None }).guards) == 0
fn extern_body(lowering: Lowering, declaration: ast.ExternDeclaration, signature: Signature) -> Body {
    let shapes = lowering.shapes
    let written_at = used_as(lowering, declaration.name.span)
    let answer = answer_of(shapes, written_at, declaration.gives)
    let arguments = arguments_of_extern(signature, declaration)
    let reached = Reach { reaches: declaration.reaches, arguments: arguments, gives: answer.member, called: called_by(shapes, received_by(written_at)) }
    var instructions = list.push(list.push(fitting(arguments), Label(0)), reached)
    instructions = list.push(instructions, Label(1))
    if !is_held_alike(one: answer.member, other: answer.widened) {
        instructions = list.push(instructions, Widen)
    }
    instructions = concatenated(first: instructions, second: given_back(answer, shapes))
    if has_narrowed(arguments) {
        instructions = concatenated(first: list.push(instructions, Label(4)), second: none_of(answer, shapes))
    }
    if answer.guarded {
        instructions = concatenated(first: list.push(instructions, Label(2)), second: caught(shapes))
    }
    Body { instructions: instructions, locals: [answer_local(or(answer.widened, anything()))], guards: guards_of(answer) }
}

// example: extern_parameters(Signature { parameters: [None, Some(Whole)], result: None }) == ["argument#0"]
fn extern_parameters(signature: Signature) -> List<String> {
    var names = []
    for _ in taken_values(signature.parameters) {
        names = list.push(names, "argument#" + shown(list.length(names)))
    }
    names
}

// example: used_as(little_lowering(""), infer.no_name().span) == unify.Unit
fn used_as(lowering: Lowering, written: lexer.Span) -> unify.Type {
    or(infer.type_at(lowering.typed, written), unify.Unit)
}

// example: called_by(no_shapes(), unify.int()) == ThroughItsClass
fn called_by(shapes: Shapes, of: unify.Type) -> CalledAs {
    match of {
        unify.Named { name } => foreign_called(map.get(shapes.foreign, name))
        _ => ThroughItsClass
    }
}

// example: foreign_called(None) == ThroughItsClass
fn foreign_called(found: Option<JavaClass>) -> CalledAs {
    match found {
        Some(reached) => reached.called
        None => ThroughItsClass
    }
}

// example: list.length(arguments_of_extern(Signature { parameters: [Some(Whole), None], result: None }, no_extern())) == 0
fn arguments_of_extern(signature: Signature, declaration: ast.ExternDeclaration) -> List<Argument> {
    var arguments = []
    var position = 0
    for of in taken_values(signature.parameters) {
        arguments = match list.at(declaration.parameters, position) {
            Some(parameter) => list.push(arguments, Argument { local: Local { name: "argument#" + shown(position), of: of }, crossing: crossing_of(of, parameter.takes) })
            None => arguments
        }
        position += 1
    }
    arguments
}

// example: taken_values([None, Some(Whole)]) == [Whole]
fn taken_values(parameters: List<Option<Value>>) -> List<Value> {
    var taken = []
    for parameter in parameters {
        taken = match parameter {
            Some(of) => list.push(taken, of)
            None => taken
        }
    }
    taken
}

// example: crossing_of(list_value(), ast.TakesAsDeclared) == Listed
// example: crossing_of(Whole, ast.TakesInt) == Narrowed
fn crossing_of(of: Value, takes: ast.Takes) -> Crossing {
    match takes {
        ast.TakesAsDeclared => if of == list_value() {
            Listed
        } else {
            AsItIs
        }
        ast.TakesInt => Narrowed
    }
}

// example: has_narrowed([Argument { local: Local { name: "argument#0", of: Whole }, crossing: Narrowed }])
fn has_narrowed(arguments: List<Argument>) -> Bool {
    for argument in arguments {
        if argument.crossing == Narrowed {
            return true
        }
    }
    false
}

// example: list.length(fitting([Argument { local: Local { name: "argument#0", of: Whole }, crossing: Narrowed }])) == 8
fn fitting(arguments: List<Argument>) -> List<Instruction> {
    var instructions = []
    for argument in arguments {
        if argument.crossing == Narrowed {
            instructions = concatenated(first: instructions, second: within_bound(local: argument.local, bound: -2147483648, how: GreaterOrEqual))
            instructions = concatenated(first: instructions, second: within_bound(local: argument.local, bound: 2147483647, how: LessOrEqual))
        }
    }
    instructions
}

// example: list.length(within_bound(local: Local { name: "argument#0", of: Whole }, bound: 1, how: Less)) == 4
fn within_bound(local: Local, bound: Int, how: Comparison) -> List<Instruction> {
    [Load(local), LongOf(bound), CompareLongs(how), JumpIfFalse(4)]
}

// example: answer_of(no_shapes(), unify.Unit, ast.GivesAsDeclared).guarded == false
fn answer_of(shapes: Shapes, written_at: unify.Type, gives: ast.Gives) -> Answer {
    let result = result_or_unit(written_at)
    let guarded = is_wrapped_in("Result", result)
    let inside_result = peeled("Result", result)
    let widened = carried_type(shapes, peeled("Option", inside_result))
    Answer { member: reached_for(widened, gives), widened: widened, optional: is_wrapped_in("Option", inside_result), guarded: guarded }
}

// example: value_key(or(carried_type(no_shapes(), unify.int()), Character)) == "Whole"
// example: is_nothing(carried_type(no_shapes(), unify.Unit))
fn carried_type(shapes: Shapes, of: unify.Type) -> Option<Value> {
    match of {
        unify.Named { name } => Some(named_value(shapes, name))
        unify.Unit => None
        _ => Some(anything())
    }
}

// example: named_value(no_shapes(), "String") == Of(Text)
// example: named_value(main_shapes(), "Box") == Of(main_box())
fn named_value(shapes: Shapes, named: String) -> Value {
    match map.get(shapes.foreign, named) {
        Some(reached) => Of(ForeignClass(reached.class))
        None => plain_value(shapes, named)
    }
}

// example: plain_value(no_shapes(), "Bool") == Truth
fn plain_value(shapes: Shapes, named: String) -> Value {
    if named == "Int" {
        return Whole
    }
    if named == "Bool" {
        return Truth
    }
    if named == "String" {
        return text_value()
    }
    if named == "List" {
        return list_value()
    }
    if named == "Process" {
        return handle_value()
    }
    if set.has_value(shapes.prelude_types, named) {
        return Of(TypeOf { module: ThePrelude, name: named })
    }
    Of(declared_class(shapes, named))
}

// example: handle_value() == Of(handle_kind())
fn handle_value() -> Value {
    Of(handle_kind())
}

// example: handle_kind() == TypeOf { module: ThePrelude, name: "Process" }
fn handle_kind() -> Kind {
    TypeOf { module: ThePrelude, name: "Process" }
}

// example: declared_class(main_shapes(), "Box") == main_box()
// example: declared_class(no_shapes(), "lexer.Span") == TypeOf { module: OfTheProgram("lexer"), name: "Span" }
fn declared_class(shapes: Shapes, written_at: String) -> Kind {
    TypeOf { module: home_of_type(shapes, written_at), name: simple(written_at) }
}

// example: simple("lexer.Span") == "Span"
// example: simple("Span") == "Span"
fn simple(reached: String) -> String {
    match split_at_dot(reached) {
        Some(home) => home.name
        None => reached
    }
}

// example: home_of_type(main_shapes(), "Box") == OfTheProgram("main")
// example: home_of_type(main_shapes(), "prelude.Box") == ThePrelude
fn home_of_type(shapes: Shapes, written_at: String) -> Module {
    match split_at_dot(written_at) {
        Some(home) => module_named(shapes.homes, home.module)
        None => shapes.home
    }
}

// example: module_named(only_the_prelude(), "prelude") == ThePrelude
// example: module_named(only_the_prelude(), "lexer") == OfTheProgram("lexer")
fn module_named(homes: map.Map<String, Module>, module: String) -> Module {
    or(map.get(homes, module), OfTheProgram(module))
}

// example: or(split_at_dot("a.b.c"), Home { module: "", name: "" }).name == "b.c"
// example: is_undotted(split_at_dot("abc"))
fn split_at_dot(named: String) -> Option<Home> {
    match first_dot(named) {
        Some(at) => Some(Home { module: or(strings.cut(named, 0, at), ""), name: or(strings.cut(named, at + 1, strings.length(named)), "") })
        None => None
    }
}

// example: or(first_dot("a.b.c"), 0) == 1
fn first_dot(named: String) -> Option<Int> {
    var at = strings.length(named) - 1
    var found = None
    for at >= 0 {
        found = match strings.at(named, at) {
            Some(46) => Some(at)
            _ => found
        }
        at = at - 1
    }
    found
}

// example: result_or_unit(unify.Unit) == unify.Unit
fn result_or_unit(of: unify.Type) -> unify.Type {
    match of {
        unify.Function { result } => result
        _ => unify.Unit
    }
}

// example: is_wrapped_in("Option", unify.Named { name: "Option", arguments: [unify.int()] })
fn is_wrapped_in(wrapper: String, held: unify.Type) -> Bool {
    match held {
        unify.Named { name, arguments } => name == wrapper && list.length(arguments) > 0
        _ => false
    }
}

// example: peeled("Option", unify.Named { name: "Option", arguments: [unify.int()] }) == unify.int()
fn peeled(wrapper: String, held: unify.Type) -> unify.Type {
    match held {
        unify.Named { name, arguments } => if name == wrapper {
            or(list.at(arguments, 0), held)
        } else {
            held
        }
        _ => held
    }
}

// example: held_key(reached_for(Some(Whole), ast.GivesInt)) == "Small"
fn reached_for(widened: Option<Value>, gives: ast.Gives) -> Option<Value> {
    match widened {
        Some(of) => Some(member_gives(of, gives))
        None => None
    }
}

// example: member_gives(Whole, ast.GivesChar) == Character
fn member_gives(of: Value, gives: ast.Gives) -> Value {
    match gives {
        ast.GivesAsDeclared => of
        ast.GivesInt => Small
        ast.GivesChar => Character
    }
}

// example: received_by(unify.Unit) == unify.Unit
fn received_by(written_at: unify.Type) -> unify.Type {
    or(list.at(parameters_or_none(written_at), 0), unify.Unit)
}

// example: list.length(parameters_or_none(unify.Unit)) == 0
fn parameters_or_none(of: unify.Type) -> List<unify.Type> {
    match of {
        unify.Function { parameters } => parameters
        _ => []
    }
}

// example: list.length(guards_of(Answer { member: None, widened: None, optional: false, guarded: true })) == 1
fn guards_of(answer: Answer) -> List<Guard> {
    if answer.guarded {
        return [Guard { from: 0, to: 1, handler: 2, catching: Failure }]
    }
    []
}

// example: list.length(given_back(Answer { member: None, widened: None, optional: false, guarded: false }, no_shapes())) == 1
fn given_back(answer: Answer, shapes: Shapes) -> List<Instruction> {
    match answer.widened {
        Some(of) => if answer.optional {
            optional_given_back(answer, shapes, of)
        } else {
            handed_on(answer, shapes, answer.widened)
        }
        None => handed_on(answer, shapes, answer.widened)
    }
}

// example: list.length(optional_given_back(Answer { member: Some(Whole), widened: Some(Whole), optional: true, guarded: false }, no_shapes(), Whole)) == 6
fn optional_given_back(answer: Answer, shapes: Shapes, of: Value) -> List<Instruction> {
    let stored = [Store(answer_local(of))]
    if !is_reference(of) {
        return concatenated(first: stored, second: some_of(answer, shapes, of))
    }
    let tested = concatenated(first: stored, second: [Load(answer_local(of)), JumpIfNull(3)])
    concatenated(first: list.push(concatenated(first: tested, second: some_of(answer, shapes, of)), Label(3)), second: none_of(answer, shapes))
}

// example: list.length(some_of(Answer { member: None, widened: None, optional: true, guarded: false }, no_shapes(), Whole)) == 5
fn some_of(answer: Answer, shapes: Shapes, of: Value) -> List<Instruction> {
    concatenated(first: variant_built(built_shape(shapes, "Some"), [answer_local(of)]), second: handed_on(answer, shapes, Some(optional(shapes))))
}

// example: list.length(none_of(Answer { member: None, widened: None, optional: true, guarded: false }, no_shapes())) == 4
fn none_of(answer: Answer, shapes: Shapes) -> List<Instruction> {
    concatenated(first: variant_built(built_shape(shapes, "None"), []), second: handed_on(answer, shapes, Some(optional(shapes))))
}

// example: list.length(handed_on(Answer { member: None, widened: None, optional: false, guarded: true }, no_shapes(), Some(Whole))) == 6
fn handed_on(answer: Answer, shapes: Shapes, on_the_stack: Option<Value>) -> List<Instruction> {
    if !answer.guarded {
        return [Return(on_the_stack)]
    }
    let held = answer_local(or(on_the_stack, anything()))
    let ok = built_shape(shapes, "Ok")
    list.push(concatenated(first: [Store(held)], second: variant_built(ok, [held])), Return(Some(Of(ok.base))))
}

// example: optional(no_shapes()) == anything()
fn optional(shapes: Shapes) -> Value {
    Of(built_shape(shapes, "Some").base)
}

// example: list.length(caught(no_shapes())) == 7
fn caught(shapes: Shapes) -> List<Instruction> {
    let err = built_shape(shapes, "Err")
    let says = answer_local(text_value())
    list.push(concatenated(first: [FailureText, Store(says)], second: variant_built(err, [says])), Return(Some(Of(err.base))))
}

// example: is_held_alike(one: None, other: None)
// example: !is_held_alike(one: Some(Small), other: Some(Whole))
fn is_held_alike(one: Option<Value>, other: Option<Value>) -> Bool {
    held_key(one) == held_key(other)
}

// example: held_key(Some(Whole)) == "Whole"
// example: held_key(None) == "()"
fn held_key(held: Option<Value>) -> String {
    match held {
        Some(of) => value_key(of)
        None => "()"
    }
}

// example: value_key(Array(Of(Text))) == "Array<Text>"
// example: value_key(Of(TypeOf { module: OfTheProgram("main"), name: "Box" })) == "program main.Box"
fn value_key(of: Value) -> String {
    match of {
        Whole => "Whole"
        Truth => "Truth"
        Small => "Small"
        Character => "Character"
        Array(held) => "Array<" + value_key(held) + ">"
        Of(kind) => kind_key(kind)
    }
}

// example: kind_key(VariantOf { module: ThePrelude, of: "Option", variant: "Some" }) == "prelude.Option.Some"
// example: kind_key(ForeignClass("java.lang.Object")) == "java java.lang.Object"
fn kind_key(kind: Kind) -> String {
    match kind {
        Anything => "Anything"
        Text => "Text"
        TypeOf { module, name } => module_key(module) + "." + name
        VariantOf { module, of, variant } => module_key(module) + "." + of + "." + variant
        ModuleOf(module) => module_key(module)
        ProcessOf { module, name } => module_key(module) + " process " + name
        ForeignClass(class) => "java " + class
        Mailbox => "Mailbox"
        End => "End"
        Envelope => "Envelope"
        Task => "Task"
        Failure => "Failure"
        JavaList => "JavaList"
    }
}

// example: module_key(OfTheLibrary("strings")) == "library strings"
fn module_key(module: Module) -> String {
    match module {
        ThePrelude => "prelude"
        OfTheLibrary(name) => "library " + name
        OfTheProgram(name) => "program " + name
    }
}

// example: answer_local(Whole).name == "answer"
fn answer_local(of: Value) -> Local {
    Local { name: "answer", of: of }
}

// example: built_shape(no_shapes(), "Nothing").class == Anything
fn built_shape(shapes: Shapes, constructor: String) -> Shape {
    or(map.get(shapes.built_by, constructor), no_shape())
}

// example: main_shapes().module == "main"
private fn main_shapes() -> Shapes {
    let shapes = no_shapes()
    shapes { module: "main", home: OfTheProgram("main"), own: set.insert(set.empty(), "Box") }
}

// example: main_naming().home == OfTheProgram("main")
private fn main_naming() -> Naming {
    Naming { module: "main", home: OfTheProgram("main"), homes: only_the_prelude() }
}

// example: no_shapes().module == ""
private fn no_shapes() -> Shapes {
    Shapes { module: "", home: OfTheProgram(""), homes: only_the_prelude(), declarations: [], built_by: map.empty(), records: map.empty(), record_builders: set.empty(), own: set.empty(), foreign: map.empty(), prelude_types: set.empty() }
}

// example: main_box() == TypeOf { module: OfTheProgram("main"), name: "Box" }
private fn main_box() -> Kind {
    main_kind("Box")
}

// example: main_kind("User") == TypeOf { module: OfTheProgram("main"), name: "User" }
private fn main_kind(named: String) -> Kind {
    TypeOf { module: OfTheProgram("main"), name: named }
}

// example: module_named(only_the_prelude(), "prelude") == ThePrelude
fn only_the_prelude() -> map.Map<String, Module> {
    map.insert(map.empty(), "prelude", ThePrelude)
}

// A module of the library is a class of the package `bux/library`, so a program may use its name.
// example: module_named(library_module_added(map.empty(), "strings"), "strings") == OfTheLibrary("strings")
fn library_module_added(homes: map.Map<String, Module>, name: String) -> map.Map<String, Module> {
    map.insert(homes, name, OfTheLibrary(name))
}

// example: tagged_shape().class == VariantOf { module: OfTheProgram("a"), of: "B", variant: "C" }
private fn tagged_shape() -> Shape {
    let module = OfTheProgram("a")
    Shape { class: VariantOf { module: module, of: "B", variant: "C" }, base: TypeOf { module: module, name: "B" }, tag: Some(1), carries: [] }
}

// example: list.length(no_shape().carries) == 0
fn no_shape() -> Shape {
    Shape { class: Anything, base: Anything, tag: None, carries: [] }
}

// example: text_value() == Of(Text)
fn text_value() -> Value {
    Of(Text)
}

// example: list.length(variant_built(no_shape(), [])) == 3
fn variant_built(shape: Shape, around: List<Local>) -> List<Instruction> {
    var instructions = [New(shape.class), Copy]
    for one in around {
        instructions = list.push(instructions, Load(one))
        if list.length(shape.carries) == 1 && is_carrying_a_reference(shape) {
            instructions = concatenated(first: instructions, second: converted(held: one.of, wanted: anything()))
        }
    }
    list.push(instructions, Construct { built: shape.class, taken: constructor_taken(shape) })
}

// example: list.length(converted(held: Whole, wanted: anything())) == 1
// example: list.length(converted(held: Whole, wanted: Whole)) == 0
fn converted(held: Value, wanted: Value) -> List<Instruction> {
    if held == wanted {
        return []
    }
    [Convert { from: held, to: wanted }]
}

// example: constructor_taken(list_shape()) == [buffer(), Small]
fn constructor_taken(shape: Shape) -> List<Value> {
    var taken = []
    for carried in shape.carries {
        taken = match carried.of {
            Some(of) => list.push(taken, of)
            None => taken
        }
    }
    taken
}

// example: !is_carrying_a_reference(no_shape())
fn is_carrying_a_reference(shape: Shape) -> Bool {
    match list.at(shape.carries, 0) {
        Some(carried) => match carried.of {
            Some(of) => is_reference(of)
            None => false
        }
        None => false
    }
}

// example: is_reference(anything())
fn is_reference(of: Value) -> Bool {
    match of {
        Of(_) => true
        _ => false
    }
}

// example: anything() == Of(Anything)
fn anything() -> Value {
    Of(Anything)
}

// example: or(list.at(concatenated(first: [1], second: [2]), 1), 0) == 2
fn concatenated<T>(first: List<T>, second: List<T>) -> List<T> {
    var all = first
    for value in second {
        all = list.push(all, value)
    }
    all
}

// example: dots_replaced(named: "a.b.c", replacement: "$") == "a$b$c"
fn dots_replaced(named: String, replacement: String) -> String {
    var written = ""
    var at = 0
    var from = 0
    for at < strings.length(named) {
        if is_dot_at(named, at) {
            written += or(strings.cut(named, from, at), "") + replacement
            from = at + 1
        }
        at += 1
    }
    written + or(strings.cut(named, from, strings.length(named)), "")
}

// example: is_dot_at("a.b", 1)
fn is_dot_at(named: String, at: Int) -> Bool {
    match strings.at(named, at) {
        Some(46) => true
        _ => false
    }
}

// example: list_crossed().name == "listed"
fn list_crossed() -> Function {
    Function { owner: list_kind(), name: "listed", taken: [list_value()], gives: Some(Of(JavaList)) }
}

// example: list_value() == Of(list_kind())
fn list_value() -> Value {
    Of(list_kind())
}

// example: list_kind() == TypeOf { module: ThePrelude, name: "List" }
fn list_kind() -> Kind {
    TypeOf { module: ThePrelude, name: "List" }
}

type Pass = {
    lowered: List<Lowered>
    asked: Asked
    knew: List<Knew>
}

type Lowered = {
    classes: List<Class>
    asks: Asked
}

type Knew = {
    module: String
    asked: Asked
}

type Reachable = {
    lowering: Lowering
    reaching: Reaching
}

type Answered = {
    lowering: Lowering
    answered_by: Option<Instance>
}

type AskedOf = {
    lowering: Lowering
    written: List<unify.Type>
}

type Classed = {
    lowering: Lowering
    class: Class
}

type MethodsWritten = {
    lowering: Lowering
    methods: List<Method>
}

type MethodMade = {
    lowering: Lowering
    method: Method
}

type BodyMade = {
    lowering: Lowering
    body: Body
    parameters: List<String>
}

type Asking = {
    method: String
    at: unify.Type
    home: Home
    arguments: List<unify.Type>
}

type Home = {
    module: String
    name: String
}

type GenericAsked = {
    module: String
    function: String
    settled: List<unify.Type>
    constrained: List<List<String>>
}

type NamedAsked = {
    lowering: Lowering
    named: String
}

type Use = {
    declared: lexer.Span
    at: lexer.Span
    within: Instantiation
}

type DerivedName = {
    named: ast.Name
    deriving: ast.DeriveDeclaration
}

type Left = {
    builder: Builder
    held: Option<Value>
}

type Class = {
    of: Kind
    extends: Kind
    extending: Extending
    implements: List<Kind>
    fields: List<Field>
    methods: List<Method>
}

type Extending =
    | Never
    | ByItsVariants

type Field = {
    name: String
    of: Value
}

type Method = {
    name: String
    parameters: List<Local>
    result: Option<Value>
    reached: Reached
    body: Body
}

type Reached =
    | ThroughTheClass
    | ThroughAnInstance
    | AsItsConstructor

type Body = {
    instructions: List<Instruction>
    locals: List<Local>
    guards: List<Guard>
}

type Guard = {
    from: Int
    to: Int
    handler: Int
    catching: Kind
}

type Entered = {
    builder: Builder
    turn: Turn
}

type Turn =
    | Forever
    | While(ast.Expr)
    | Walk {
        walked_list: Local
        index: Local
        item: Option<Local>
    }

type Found = {
    builder: Builder
    answered_by: Option<Instance>
}

type Instance = {
    home: Module
    reaching: Reaching
}

type Aside = {
    builder: Builder
    local: Local
}

type Asides = {
    builder: Builder
    locals: List<Local>
}

type Callee = {
    name: ast.Name
    passed: List<ast.Expr>
}

type Spawning = {
    callee: ast.Expr
    passed: List<ast.Expr>
}

type SpawnedProcess = {
    spawned: Kind
    parameters: List<Option<Value>>
}

type Through = {
    module: ast.Name
    name: ast.Name
    used: lexer.Span
}

type OperatorAsk = {
    of: String
    reversed: Bool
    flipped: Bool
}

type Reaches = {
    builder: Builder
    reaching: Reaching
}

type Reaching = {
    named: String
    signature: Signature
}

type Ran = {
    module: Module
    named: String
    started: Signature
    received: Signature
}

type Signature = {
    parameters: List<Option<Value>>
    result: Option<Value>
}

type HeldLocal = {
    builder: Builder
    local: Option<Local>
}

type Against = {
    local: Local
    next: Int
}

type Tagged = {
    builder: Builder
    shape: Shape
}

type Builder = {
    lowering: Lowering
    instructions: List<Instruction>
    bound: map.Map<Int, Local>
    locals: List<Local>
    parameters: Int
    next_label: Int
    repeat: Option<Repeat>
    splitting: set.Set<Int>
    fields: map.Map<String, Local>
    result: Option<Value>
    at: Instantiation
}

type Repeat = {
    again: Int
    done: Int
}

type Escape = {
    built: List<Int>
    escaped: set.Set<Int>
}

type LabelledWriting = {
    writing: Writing
    label: Int
}

type Writing = {
    lowering: Lowering
    instructions: List<Instruction>
    next_label: Int
}

type Lowering = {
    typed: infer.Inference
    library: Library
    module: String
    shapes: Shapes
    declared: map.Map<Int, Declared>
    answers: map.Map<String, Answers>
    instances: List<Answers>
    owed: List<Owed>
    next_owed: Int
    asks: Asked
}

type Asked = {
    of: List<Specialisation>
}

// `foreign` names each Java class of the types, because the asked module has no import of it.
derive Eq for Specialisation

type Specialisation = {
    module: String
    function: String
    settled: List<unify.Type>
    foreign: List<Foreign>
}

derive Eq for Foreign

type Foreign = {
    name: String
    reached: JavaClass
}

type Library = {
    prelude: types.Prelude
    typed: infer.Inference
    traits: List<ast.TraitDeclaration>
    types: set.Set<String>
}

type Declared = {
    named: String
    body: Written
}

type Written =
    | Source(ast.FunctionDeclaration)
    | FromJava(ast.ExternDeclaration)
    | Derived {
        of: String
        declaration: ast.TypeDeclaration
    }

type Answers = {
    method: String
    for_type: String
    arguments: List<String>
    declared: lexer.Span
}

type Owed = {
    declared: lexer.Span
    named: String
    at: Instantiation
}

type Instantiation = {
    settled: List<Settled>
}

type Settled = {
    origin: Int
    at: unify.Type
    constrained: Bool
}

type Shapes = {
    module: String
    home: Module
    homes: map.Map<String, Module>
    declarations: List<ShapeDeclared>
    built_by: map.Map<String, Shape>
    records: map.Map<String, String>
    record_builders: set.Set<String>
    own: set.Set<String>
    foreign: map.Map<String, JavaClass>
    prelude_types: set.Set<String>
}

type Naming = {
    module: String
    home: Module
    homes: map.Map<String, Module>
}

derive Eq for JavaClass

type JavaClass = {
    class: String
    called: CalledAs
}

type ShapeDeclared =
    | RecordDeclared(String)
    | VariantsDeclared {
        base: Kind
        constructors: List<String>
    }

type Instruction =
    | LongOf(Int)
    | BooleanOf(Bool)
    | IntegerOf(Int)
    | TextOf(String)
    | Load(Local)
    | Store(Local)
    | Drop(Value)
    | Copy
    | Convert {
        from: Value
        to: Value
    }
    | Arithmetic(Arithmetic)
    | Concat
    | CompareLongs(Comparison)
    | CompareIntegers(Comparison)
    | Not
    | Widen
    | Narrow
    | LowEightBits
    | Label(Int)
    | Jump(Int)
    | JumpIfFalse(Int)
    | JumpIfNull(Int)
    | New(Kind)
    | NewArray(Kind)
    | StoreInArray
    | LoadFromArray
    | ArrayLength
    | Construct {
        built: Kind
        taken: List<Value>
    }
    | GetField(FieldRef)
    | PutField(FieldRef)
    | Call(Function)
    | Cast(Kind)
    | InstanceOf(Kind)
    | Increment(Local)
    | Return(Option<Value>)
    | Reach {
        reaches: ast.Reaches
        arguments: List<Argument>
        gives: Option<Value>
        called: CalledAs
    }
    | TextEqual
    | TextCompared
    | TextHashed
    | Shown(Value)
    | Unmatched
    | Exited
    | ArrayCopied
    | JavaListOf
    | Started
    | Taken
    | Opened
    | Offered
    | Removed
    | IsEnded
    | Awaited
    | Completed
    | CompletedWithFailure
    | FailureWritten
    | FailureText

derive Eq for CalledAs

type CalledAs =
    | ThroughItsClass
    | ThroughItsInterface

type FieldRef = {
    owner: Kind
    name: String
    of: Value
}

type Function = {
    owner: Kind
    name: String
    taken: List<Value>
    gives: Option<Value>
}

derive Eq for Comparison

type Comparison =
    | Equal
    | NotEqual
    | Less
    | LessOrEqual
    | Greater
    | GreaterOrEqual

type Arithmetic =
    | Add
    | Subtract
    | Multiply
    | Divide
    | Remainder
    | Negate

type Decided = {
    less: Int
    not_less: Int
}

type Holds = {
    shape: Shape
    carried: Carried
    of: Value
    named: Option<String>
    written: ast.TypeRef
}

type Shape = {
    class: Kind
    base: Kind
    tag: Option<Int>
    carries: List<Carried>
}

type Carried = {
    name: String
    of: Option<Value>
}

type WrittenValue = {
    named: Option<String>
    written: ast.TypeRef
}

type Answer = {
    member: Option<Value>
    widened: Option<Value>
    optional: Bool
    guarded: Bool
}

type Argument = {
    local: Local
    crossing: Crossing
}

derive Eq for Local

type Local = {
    name: String
    of: Value
}

derive Eq for Value

type Value =
    | Whole
    | Truth
    | Small
    | Character
    | Array(Value)
    | Of(Kind)

derive Eq for Kind

type Kind =
    | Anything
    | Text
    | TypeOf {
        module: Module
        name: String
    }
    | VariantOf {
        module: Module
        of: String
        variant: String
    }
    | ModuleOf(Module)
    | ProcessOf {
        module: Module
        name: String
    }
    | ForeignClass(String)
    | Mailbox
    | End
    | Envelope
    | Task
    | Failure
    | JavaList

derive Eq for Module

type Module =
    | ThePrelude
    | OfTheLibrary(String)
    | OfTheProgram(String)

derive Eq for Crossing

type Crossing =
    | AsItIs
    | Narrowed
    | Listed
