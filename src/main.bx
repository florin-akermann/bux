// The `bux` command line, written in Bux: `bin/bux` starts it on a JVM.
//
// `src/command.bx` holds every command, because a module named `main` cannot be imported.
// This file only writes the answer out.
import command
import io

fn main(arguments: List<String>) -> Int {
    let said = command.said_by(command.answered(arguments))
    io.put(io.out(), said.output)
    io.put(io.err(), said.errors)
    said.status
}
