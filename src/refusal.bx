// What type inference refuses a module with, and the words each refusal is written in.
//
// `docs/specs/types.md` and `docs/specs/diagnostics.md` state the codes and the wording.
// A refusal carries the types it names, so this module reads types and knows no program.
import lexer
import list
import strings
import unify

/// `found`, or the refusal at `at` where `found` is `Option<()>`, which no program may write.
// example: code_given(unit_refused(unify.option_of(unify.Unit), lexer.Span { start: 3, length: 10 })) == "L0432 3..13"
// example: code_given(unit_refused(unify.option_of(unify.truth()), lexer.Span { start: 3, length: 12 })) == ""
fn unit_refused(found: unify.Type, at: lexer.Span) -> Result<unify.Type, TypeError> {
    if found == unify.option_of(unify.Unit) {
        return Err(TypeError { kind: UnitInOption, span: at })
    }
    Ok(found)
}

/// A refusal as the harness compares it: the code, the span, and the message, then the help.
// example: printed(TypeError { kind: DivisorIsZero, span: lexer.Span { start: 4, length: 1 } }) == "L0407 4..5 this divisor is zero, so there is no answer\nhelp: a zero written here is never anything else; drop the division\n"
private fn printed(refused: TypeError) -> String {
    code_of(refused.kind) + " " + shown(refused.span) + " " + message(refused.kind) + "\nhelp: " + help_of(refused.kind) + "\n"
}

/// The code and the span of what `answer` was refused with, and nothing where it holds.
// example: code_given(Ok(1)) == ""
// example: code_given(Err(TypeError { kind: InfiniteType, span: lexer.Span { start: 2, length: 3 } })) == "L0403 2..5"
fn code_given<T>(answer: Result<T, TypeError>) -> String {
    match answer {
        Ok(_) => ""
        Err(refused) => code_of(refused.kind) + " " + shown(refused.span)
    }
}

/// The code a refusal of this kind is refused with, which `docs/specs/diagnostics.md` lists.
// example: code_of(InfiniteType) == "L0403"
// example: code_of(NarrowsWithoutOption(unify.Unit)) == "L0431"
fn code_of(kind: TypeErrorKind) -> String {
    match kind {
        Mismatched {} => "L0400"
        WrongArgumentCount(_) => "L0401"
        WrongTypeArgumentCount(_) => "L0401"
        UnknownField {} => "L0402"
        UnknownReceiver(_) => "L0402"
        InfiniteType => "L0403"
        MissingField {} => "L0404"
        FieldWrittenTwice {} => "L0405"
        NoOperator {} => "L0406"
        DivisorIsZero => "L0407"
        Discarded(_) => "L0408"
        Unnamed {} => "L0409"
        Misnamed {} => "L0410"
        _ => later_code(kind)
    }
}

/// The code of a refusal numbered after `L0410`, which [`code_of`] leaves to this.
// example: later_code(HoldsItself(["A"])) == "L0415"
fn later_code(kind: TypeErrorKind) -> String {
    match kind {
        NamedConstructor(_) => "L0411"
        NamedPrelude(_) => "L0411"
        NamedThroughModule(_) => "L0411"
        FlagParameter(_) => "L0412"
        NotAPredicate(_) => "L0413"
        NotInModule {} => "L0414"
        HoldsItself(_) => "L0415"
        NoInstance {} => "L0418"
        SignatureWithoutType(_) => "L0419"
        LiteralDoesNotFit {} => "L0420"
        BoundIsNotAWholeNumber {} => "L0421"
        HeldTypeHasNoInstance {} => "L0422"
        CalledOnAValue {} => "L0433"
        UnitInOption => "L0432"
        _ => boundary_code(kind)
    }
}

/// The code of a refusal about a module reached or an `extern` boundary.
// example: boundary_code(NotCalled { module: "io", name: "print" }) == "L0304"
fn boundary_code(kind: TypeErrorKind) -> String {
    match kind {
        KeptInModule {} => "L0322"
        NotCalled {} => "L0304"
        TraitStaysInItsModule {} => "L0424"
        DoesNotCross {} => "L0425"
        NotAJavaName(_) => "L0426"
        DerivesAForeignType(_) => "L0427"
        ReachesNoClass(_) => "L0428"
        WidensNoInt {} => "L0429"
        NarrowsNoInt(_) => "L0429"
        BuildsAnInterface(_) => "L0430"
        NarrowsWithoutOption(_) => "L0431"
        Unaccounted(_) => "L0434"
        LeftOutMember(_) => "L0434"
        Escapes {} => "L0435"
        SignatureLeftOut(_) => "L0436"
        _ => process_code(kind)
    }
}

/// The code of a refusal of a process, which `docs/specs/concurrency.md` states.
// example: process_code(ReceivesAnotherState { state: unify.int(), receive: unify.Unit }) == "L0810"
// example: process_code(SpawnsNoProcess("demo.count")) == "L0800"
fn process_code(kind: TypeErrorKind) -> String {
    match kind {
        SpawnsNoProcess(_) => "L0800"
        ProcessNotSpawned(_) => "L0801"
        StartsWithoutStart(_) => "L0802"
        ReceivesNothing(_) => "L0803"
        DeclaresMore(_) => "L0804"
        GenericProcess(_) => "L0805"
        UnwrittenProcessType(_) => "L0806"
        ReceivesTwoValues(_) => "L0807"
        ReceivesWithoutAMatch(_) => "L0808"
        ArmDoesTheWork(_) => "L0809"
        HoldsAForeignReference {} => "L0811"
        _ => "L0810"
    }
}

/// The `error:` line, without its prefix.
// example: message(Mismatched { expected: unify.int(), found: unify.text_type() }) == "expected `Int`, found `String`"
// example: message(WrongArgumentCount(Count { name: "f", takes: 1, given: 2 })) == "`f` takes 1 argument but 2 were given"
fn message(kind: TypeErrorKind) -> String {
    match kind {
        Mismatched { expected, found } => "expected `" + unify.text_of(expected) + "`, found `" + unify.text_of(found) + "`"
        WrongArgumentCount(count) => count_text(count, "argument")
        WrongTypeArgumentCount(count) => count_text(count, "type argument")
        UnknownField { of, field } => "`" + unify.text_of(of) + "` has no field named `" + field + "`"
        UnknownReceiver(field) => "the type here is not known, so `" + field + "` cannot be found"
        InfiniteType => "this would have a type that contains itself"
        MissingField { of, field } => "`" + of + "` needs a field named `" + field + "`"
        FieldWrittenTwice { of, field } => "`" + of + "` is given `" + field + "` twice"
        NoOperator { written_as, of, at } => "`" + unify.text_of(at) + "` has no `" + of + "`, so `" + written_as + "` is not written over it"
        DivisorIsZero => "this divisor is zero, so there is no answer"
        Discarded(left) => "`" + unify.text_of(left) + "` is left here and nothing takes it"
        HoldsItself(ring) => ring_text(ring)
        UnitInOption => "`Option` never carries `()`, because `Some(())` says no more than `true`"
        _ => how_it_is_written(kind)
    }
}

/// The message of a refusal about how a call, a declaration, or a module reach is written.
// example: how_it_is_written(NotAPredicate("full")) == "`full` gives back a `Bool`, so its name asks the question it answers"
fn how_it_is_written(kind: TypeErrorKind) -> String {
    match kind {
        Unnamed { function, repeated } => "`" + function + "` gives two parameters the type `" + unify.text_of(repeated) + "`, so this call names its arguments"
        Misnamed { written, parameter } => "this argument is named `" + written + "`, and the parameter here is `" + parameter + "`"
        NamedConstructor(called) => "`" + called + "` is a constructor, so it carries its values in order and names none"
        NamedPrelude(called) => "`" + called + "` comes from the prelude, which declares no parameter names to write"
        NamedThroughModule(called) => "`" + called + "` is reached through a module, so it carries its values in order and names none"
        FlagParameter(function) => "this parameter is a `Bool`, so a call of `" + function + "` passes `true` and says no more"
        NotAPredicate(function) => "`" + function + "` gives back a `Bool`, so its name asks the question it answers"
        NotInModule { module, name } => "`" + module + "` declares no `" + name + "`"
        KeptInModule { module, name } => "`" + name + "` is private to `" + module + "`"
        CalledOnAValue { function } => "a dot after a value reads a field, so this call of `" + function + "` is written plainly"
        NotCalled { module, name } => "`" + module + "." + name + "` is a function, so it is written as a call"
        TraitStaysInItsModule { module, name, of } => "`" + module + "." + name + "` requires `" + of + "`, which `" + module + "` declares and nothing here names"
        _ => what_is_declared(kind)
    }
}

/// The message of a refusal about a declaration: a trait, a derive, a bound, or an instance.
// example: what_is_declared(SignatureWithoutType("value")) == "`value` states no type, and a signature is never inferred"
fn what_is_declared(kind: TypeErrorKind) -> String {
    match kind {
        NoInstance { of, at } => "`" + unify.text_of(at) + "` has no instance of `" + of + "`"
        SignatureWithoutType(name) => "`" + name + "` states no type, and a signature is never inferred"
        LiteralDoesNotFit { value, at, least, most } => "`" + shown(value) + "` does not fit `" + unify.text_of(at) + "`, which holds `" + shown(least) + "` to `" + shown(most) + "`"
        BoundIsNotAWholeNumber { bound, of } => "`" + bound + "` of `" + of + "` is read rather than run, so it is one whole number"
        HeldTypeHasNoInstance { of, deriving, held, held_as } => "`" + deriving + "` derives `" + of + "`, and the `" + unify.text_of(held) + "` it holds as `" + held_as + "` has none"
        _ => what_java_is_not(kind)
    }
}

/// The message of a refusal about an `extern`, which `docs/specs/interop.md` states.
// example: what_java_is_not(NotAJavaName("a..b")) == "`a..b` is no Java name"
fn what_java_is_not(kind: TypeErrorKind) -> String {
    match kind {
        DoesNotCross { written, crossing } => "`" + unify.text_of(written) + "` is no type a Java member " + crossing_word(crossing)
        NotAJavaName(written) => "`" + written + "` is no Java name"
        DerivesAForeignType(named) => "`" + named + "` is an extern type, and a derive reads what a type holds"
        ReachesNoClass(reaches) => "a `" + reaches + "` reaches a class, and this signature names none"
        WidensNoInt { width, written } => "`" + width + "` widens to an `Int`, and this signature gives back `" + unify.text_of(written) + "`"
        NarrowsNoInt(written) => "`int` narrows an `Int`, and this parameter takes `" + unify.text_of(written) + "`"
        BuildsAnInterface(built) => "a `new` builds a class, and `" + unify.text_of(built) + "` is an interface"
        NarrowsWithoutOption(written) => "an `int` parameter narrows an `Int`, and this signature gives back `" + unify.text_of(written) + "`"
        Unaccounted(class) => "`" + class + "` is a class this build cannot account for"
        LeftOutMember(member) => "the member `" + member + "` is one the list of `java.base` leaves out"
        Escapes { place, held, foreign } => escape_text(place) + " `" + unify.text_of(held) + "`, and the `extern` type `" + foreign + "` is a foreign reference"
        SignatureLeftOut(unwritten) => unwritten_text(unwritten)
        _ => what_a_process_is_not(kind)
    }
}

/// The message of a refusal of a process: its shape, or how it is reached.
// example: what_a_process_is_not(DeclaresMore("Counter")) == "`Counter` declares a function after `receive`"
// example: what_a_process_is_not(ProcessNotSpawned("demo.Counter")) == "`demo.Counter` is a process, so `spawn` starts it"
fn what_a_process_is_not(kind: TypeErrorKind) -> String {
    match kind {
        SpawnsNoProcess(written) => "`spawn` starts a process, and `" + written + "` is not one"
        ProcessNotSpawned(written) => "`" + written + "` is a process, so `spawn` starts it"
        StartsWithoutStart(called) => "the first function of `" + called + "` is not `start`"
        ReceivesNothing(called) => "the second function of `" + called + "` is not `receive`"
        DeclaresMore(called) => "`" + called + "` declares a function after `receive`"
        GenericProcess(function) => "`" + function + "` of a process declares a type parameter"
        UnwrittenProcessType(function) => "`" + function + "` of a process leaves a type unwritten"
        ReceivesTwoValues(called) => "`receive` of `" + called + "` does not take a state and a message"
        ReceivesWithoutAMatch(named) => "the body of `receive` is not one `match` on `" + named + "`"
        ArmDoesTheWork(named) => "this arm of the `match` on `" + named + "` is not one call or one name"
        ReceivesAnotherState { state, receive } => "`start` gives `" + unify.text_of(state) + "`, and `receive` is `" + unify.text_of(receive) + "`"
        HoldsAForeignReference { called, held, foreign } => "`" + called + "` holds `" + unify.text_of(held) + "`, and the `extern` type `" + foreign + "` is a foreign reference"
        _ => ""
    }
}

/// Where a foreign reference would escape to, as the message says it.
// example: escape_text(GivenBackBy("opened")) == "`opened` gives back"
// example: escape_text(HeldAt("Box.value")) == "`Box.value` holds"
// example: escape_text(GivenBackByACall("same")) == "this call of `same` gives back"
// example: escape_text(BuiltAs("Box")) == "this `Box` is"
fn escape_text(place: Escape) -> String {
    match place {
        GivenBackBy(function) => "`" + function + "` gives back"
        HeldAt(field) => "`" + field + "` holds"
        GivenBackByACall(callee) => "this call of `" + callee + "` gives back"
        BuiltAs(record) => "this `" + record + "` is"
    }
}

/// What a signature leaves out, as the message says it.
// example: unwritten_text(Unwritten { function: "same", omitted: TypeOfParameter("value"), settled: "" }) == "`value` of `same` states no type, and a function writes its whole signature"
// example: unwritten_text(Unwritten { function: "count", omitted: ResultType, settled: "" }) == "`count` states no result type, and a function writes its whole signature"
fn unwritten_text(unwritten: Unwritten) -> String {
    let left_out = match unwritten.omitted {
        TypeOfParameter(parameter) => "`" + parameter + "` of `" + unwritten.function + "` states no type"
        ResultType => "`" + unwritten.function + "` states no result type"
    }
    left_out + ", and a function writes its whole signature"
}

/// What a member does with a type where it sits in the signature.
// example: crossing_word(Narrowed) == "gives back"
fn crossing_word(crossing: Crossing) -> String {
    match crossing {
        Taken => "takes"
        GivenBack => "gives back"
        Narrowed => "gives back"
        Held => "holds"
    }
}

/// `` `f` takes 2 arguments but 1 was given ``, with `what` as the word for what is counted.
// example: count_text(Count { name: "Box", takes: 1, given: 0 }, "type argument") == "`Box` takes 1 type argument but 0 were given"
fn count_text(count: Count, what: String) -> String {
    let plural = if count.takes == 1 {
        ""
    } else {
        "s"
    }
    let was_or_were = if count.given == 1 {
        "was"
    } else {
        "were"
    }
    "`" + count.name + "` takes " + shown(count.takes) + " " + what + plural + " but " + shown(count.given) + " " + was_or_were + " given"
}

/// `` `A` holds `B`, which holds `A` ``: the ring a type holds itself around.
// example: ring_text(["A", "B"]) == "`A` holds `B`, which holds `A`"
// example: ring_text(["A"]) == "`A` holds `A`"
fn ring_text(ring: List<String>) -> String {
    let first = or(list.at(ring, 0), "")
    var written = "`" + first + "` holds "
    var position = 0
    for held in ring {
        if position > 0 {
            written += "`" + held + "`, which holds "
        }
        position += 1
    }
    written + "`" + first + "`"
}

/// The `help:` line, which every refusal has.
///
/// An operator over a type of this module with no instance of a derivable trait names the derive.
// example: help_of(NoOperator { written_as: "==", of: "Eq", at: unify.Named { name: "Point", arguments: [] } }) == "`Point` gets one by deriving it: write `derive Eq for Point`"
// example: help_of(InfiniteType) == "one of these two is being used where the other was meant"
fn help_of(kind: TypeErrorKind) -> String {
    match kind {
        NoOperator { of, at } => operator_help(of, at)
        _ => stated(kind)
    }
}

/// The help of a refused operator, which names the derive where one would give the instance.
// example: operator_help("Eq", unify.Named { name: "demo.Point", arguments: [] }) == "an operator is a trait method, so a type gets one by writing that trait's instance"
// example: operator_help("Add", unify.Named { name: "Point", arguments: [] }) == "an operator is a trait method, so a type gets one by writing that trait's instance"
fn operator_help(of: String, at: unify.Type) -> String {
    if list.has_value(["Eq", "Ord", "Hash", "Show"], of) && is_derivable_here(at) {
        let written = unify.text_of(at)
        return "`" + written + "` gets one by deriving it: write `derive " + of + " for " + written + "`"
    }
    "an operator is a trait method, so a type gets one by writing that trait's instance"
}

/// Whether a derive here could name `at`: a type with no arguments that no other module declares.
// example: is_derivable_here(unify.Named { name: "Point", arguments: [] })
// example: !is_derivable_here(unify.list_of(unify.int()))
fn is_derivable_here(at: unify.Type) -> Bool {
    match at {
        unify.Named { name, arguments } => list.length(arguments) == 0 && !has_dot(name)
        _ => false
    }
}

/// Whether `name` holds a dot, which the name of a type another module declares does.
// example: has_dot("demo.Point")
// example: !has_dot("Point")
fn has_dot(name: String) -> Bool {
    var index = 0
    for index < strings.length(name) {
        if or(strings.at(name, index), 0) == 46 {
            return true
        }
        index += 1
    }
    false
}

/// The rule a refusal is said against, which is its `help:` line.
// example: stated(DivisorIsZero) == "a zero written here is never anything else; drop the division"
fn stated(kind: TypeErrorKind) -> String {
    match kind {
        Mismatched {} => "one type is not another, however alike they are held"
        WrongArgumentCount(_) => "a call passes one argument for each the declaration lists"
        WrongTypeArgumentCount(_) => "a type is written with one argument for each the declaration lists"
        UnknownField {} => "a field is looked up in the record its type declares"
        UnknownReceiver(_) => "declare the type of a parameter or a result so the field can be found"
        InfiniteType => "one of these two is being used where the other was meant"
        MissingField {} => "building a record gives every field a value; update one to change only some"
        FieldWrittenTwice {} => "a record gives each of its fields one value"
        NoInstance {} => "write the instance, or constrain the type parameter the call is made at"
        LiteralDoesNotFit {} => "write a whole number the type holds, or widen what its instance says it holds"
        BoundIsNotAWholeNumber {} => "a bound is read rather than run, so write it as one whole number and nothing else"
        HeldTypeHasNoInstance {} => "a derived instance reads what it holds by that type's own; give the held one"
        TraitStaysInItsModule {} => "a trait has no name outside its module, so write the loop here instead"
        _ => stated_of_a_use(kind)
    }
}

/// The rule of a refusal about how a value, a call, or a name is written.
// example: stated_of_a_use(FlagParameter("go")) == "declare a two-variant type and take that instead, so the call says which of the two"
fn stated_of_a_use(kind: TypeErrorKind) -> String {
    match kind {
        DivisorIsZero => "a zero written here is never anything else; drop the division"
        Discarded(_) => "write `_ = ` in front of it to throw the value away on purpose"
        Unnamed {} => "a call names its arguments when the declaration gives two parameters one type"
        Misnamed {} => "arguments are named in the order the declaration lists its parameters"
        NamedConstructor(_) => "a variant whose values want names declares them as fields and is built as a record"
        NamedPrelude(_) => "only a call of a function this module declares names its arguments"
        NamedThroughModule(_) => "only a call of a function this module declares names its arguments"
        FlagParameter(_) => "declare a two-variant type and take that instead, so the call says which of the two"
        NotAPredicate(_) => "begin the name with `is_`, `has_`, `can_`, or `should_`"
        NotInModule {} => "a module offers the functions and the types it declares, and nothing else"
        KeptInModule { module } => "a private name is reached only in `" + module + "`, the module that declares it"
        HoldsItself(_) => "hold an `Option` of it, which is how a type holds another of its own kind"
        SignatureWithoutType(_) => "a signature has no body to read a type off, so it writes each one out"
        CalledOnAValue { plain } => "write `" + plain + "`"
        NotCalled {} => "version 0.1 reaches a function by calling it; write the call"
        UnitInOption => "use `Bool` for a flag, and `Result<(), E>` for a failure with a reason"
        _ => the_rule_of_java(kind)
    }
}

/// The rule of a refusal about an `extern`, which `docs/specs/interop.md` states.
// example: the_rule_of_java(NotAJavaName("")) == "a Java name is its segments, each a name, with a dot between two of them"
fn the_rule_of_java(kind: TypeErrorKind) -> String {
    match kind {
        DoesNotCross {} => "a boundary carries `Bool`, `Int`, `String`, a `List`, and a type an `extern` names"
        NotAJavaName(_) => "a Java name is its segments, each a name, with a dot between two of them"
        DerivesAForeignType(_) => "write an `instance` over `extern` declarations instead"
        ReachesNoClass(_) => "a class is `String`, or a type an `extern type` declares"
        WidensNoInt {} => "a width widens to an `Int`; drop the word, or give an `Int` back"
        NarrowsNoInt(_) => "an `int` narrows an `Int`; drop the word, or take an `Int`"
        BuildsAnInterface(_) => "a `new` builds a class; reach one through a member of a class instead"
        NarrowsWithoutOption(_) => "give back an `Option`, which is `None` where an argument does not fit"
        Unaccounted(_) => "a class is in an archive a `jar` line states, or on the list of `java.base` in `docs/specs/interop.md`, and this one is in neither"
        LeftOutMember(_) => "the list in `docs/specs/interop.md` leaves this member out; reach another member"
        Escapes {} => "a foreign reference stays in the function that reaches it; bind it, and pass it as an argument"
        SignatureLeftOut(unwritten) => "write the signature `" + unwritten.settled + "`"
        _ => the_shape_of_a_process(kind)
    }
}

/// The rule of a refusal of a process: its shape, or how it is reached.
// example: the_shape_of_a_process(GenericProcess("start")) == "a process has one type of state and one type of message; write them out"
fn the_shape_of_a_process(kind: TypeErrorKind) -> String {
    match kind {
        SpawnsNoProcess(_) => "declare a `process`, or import the module that declares one, and name it after `spawn`"
        ProcessNotSpawned(_) => "write `spawn` before the call; a process is never called or held as a value"
        StartsWithoutStart(_) => "a process declares `start`, then `receive`, and nothing else"
        ReceivesNothing(_) => "a process declares `start`, then `receive`, and nothing else"
        DeclaresMore(_) => "a process declares `start`, then `receive`, and nothing else; move the function out"
        GenericProcess(_) => "a process has one type of state and one type of message; write them out"
        UnwrittenProcessType(_) => "write the type of each parameter and the result, because a process is never inferred"
        ReceivesTwoValues(_) => "write `fn receive(state: S, message: M) -> Next<S>`"
        ReceivesWithoutAMatch(_) => "write the body as one `match` on the message, and move other work into a function"
        ArmDoesTheWork(_) => "move the work into a function, give it a name, and call it here"
        HoldsAForeignReference {} => "a process holds values only, and a foreign reference stays with the function that reaches it"
        _ => "`receive` takes the state `start` gives and one message, and gives `Next` of that state"
    }
}

/// Why inference refused a module, and where.
type TypeError = {
    kind: TypeErrorKind
    span: lexer.Span
}

/// What went wrong, in the words the reader sees.
type TypeErrorKind =
    | Mismatched {
        expected: unify.Type
        found: unify.Type
    }
    | WrongArgumentCount(Count)
    | WrongTypeArgumentCount(Count)
    | UnknownField {
        of: unify.Type
        field: String
    }
    | UnknownReceiver(String)
    | InfiniteType
    | MissingField {
        of: String
        field: String
    }
    | FieldWrittenTwice {
        of: String
        field: String
    }
    | NoOperator {
        written_as: String
        of: String
        at: unify.Type
    }
    | DivisorIsZero
    | Discarded(unify.Type)
    | Unnamed {
        function: String
        repeated: unify.Type
    }
    | Misnamed {
        written: String
        parameter: String
    }
    | NamedConstructor(String)
    | NamedPrelude(String)
    | NamedThroughModule(String)
    | FlagParameter(String)
    | NotAPredicate(String)
    | NotInModule {
        module: String
        name: String
    }
    | KeptInModule {
        module: String
        name: String
    }
    | HoldsItself(List<String>)
    | NoInstance {
        of: String
        at: unify.Type
    }
    | SignatureWithoutType(String)
    | LiteralDoesNotFit {
        value: Int
        at: unify.Type
        least: Int
        most: Int
    }
    | BoundIsNotAWholeNumber {
        bound: String
        of: String
    }
    | HeldTypeHasNoInstance {
        of: String
        deriving: String
        held: unify.Type
        held_as: String
    }
    | CalledOnAValue {
        function: String
        plain: String
    }
    | NotCalled {
        module: String
        name: String
    }
    | TraitStaysInItsModule {
        module: String
        name: String
        of: String
    }
    | DoesNotCross {
        written: unify.Type
        crossing: Crossing
    }
    | NotAJavaName(String)
    | DerivesAForeignType(String)
    | ReachesNoClass(String)
    | WidensNoInt {
        width: String
        written: unify.Type
    }
    | NarrowsNoInt(unify.Type)
    | BuildsAnInterface(unify.Type)
    | NarrowsWithoutOption(unify.Type)
    | Unaccounted(String)
    | LeftOutMember(String)
    | UnitInOption
    | SpawnsNoProcess(String)
    | ProcessNotSpawned(String)
    | StartsWithoutStart(String)
    | ReceivesNothing(String)
    | DeclaresMore(String)
    | GenericProcess(String)
    | UnwrittenProcessType(String)
    | ReceivesTwoValues(String)
    | ReceivesWithoutAMatch(String)
    | ArmDoesTheWork(String)
    | ReceivesAnotherState {
        state: unify.Type
        receive: unify.Type
    }
    | HoldsAForeignReference {
        called: String
        held: unify.Type
        foreign: String
    }
    | Escapes {
        place: Escape
        held: unify.Type
        foreign: String
    }
    | SignatureLeftOut(Unwritten)

/// A function whose signature leaves a type out, with the signature inference settled for it.
type Unwritten = {
    function: String
    omitted: Omission
    settled: String
}

/// Which type a signature leaves out, which `L0436` names.
type Omission =
    | TypeOfParameter(String)
    | ResultType

/// The place a foreign reference would escape its function to, which `L0435` names.
type Escape =
    | GivenBackBy(String)
    | HeldAt(String)
    | GivenBackByACall(String)
    | BuiltAs(String)

/// What a declaration takes and what a use of it gave, for the two counts that can be wrong.
type Count = {
    name: String
    takes: Int
    given: Int
}

derive Eq for Crossing

/// Where a type sits in an `extern` signature, which decides whether it may be there.
type Crossing =
    | Taken
    | GivenBack
    | Narrowed
    | Held
