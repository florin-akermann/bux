// Type inference for a whole program: each module checked in order, and what it offers passed on.
//
// `docs/specs/types.md` states the rules, and `tests/typing.bx` holds them on drawn modules.
// A module is checked against the prelude and against what every module loaded before it offers.
// A module that types gives its API page, which `docs/specs/api-surface.md` states.
import ast
import carried
import declared
import escapes
import format
import infer
import lexer
import list
import map
import parser
import processes
import refusal
import resolver
import set
import strings
import surface
import unify

// example: !has_names(prelude_read("fn ("))
fn prelude_read(source: String) -> Prelude {
    let program = ok_or(parser.parse(source), ast.Program { items: [] })
    let names = resolver.prelude_of(program)
    match resolver.prelude_resolved(program) {
        Ok(resolved) => Prelude { names: names, declared: declared.prelude_environment(resolved) }
        Err(_) => Prelude { names: names, declared: declared.prelude_environment(resolver.Resolved { module: "prelude", program: program, found: map.empty() }) }
    }
}

// example: list.length(surface_of(checked_of("fn count() -> Int {\n    1\n}\n")).functions) == 1
fn surface_of(checked: infer.Inference) -> surface.Surface {
    let environment = checked.environment
    let program = checked.resolved.program
    surface.Surface { functions: declared.offered_functions(environment, program), processes: declared.offered_processes(environment, program), types: declared.offered_types(environment, program), instances: declared.given_instances(environment, checked.resolved), kept: declared.kept_by(program) }
}

// example: page_of(checked_of("fn count() -> Int {\n    1\n}\n\ntype Box = Box\n")) == "fn count() -> Int\n\ntype Box = Box\n"
// example: page_of(checked_of("private fn count() -> Int {\n    1\n}\n\ntype Box = Box\n")) == "type Box = Box\n"
fn page_of(checked: infer.Inference) -> String {
    var page = ""
    let kept = declared.kept_by(checked.resolved.program)
    for item in checked.resolved.program.items {
        let stanza = stanza_of(checked, item, kept)
        if stanza != "" && page != "" {
            page += "\n"
        }
        page += stanza
    }
    page
}

// example: stanza_of(checked_of(""), declared.first_item("derive Eq, Ord for Box\n"), []) == "instance Eq<Box>\ninstance Ord<Box>\n"
fn stanza_of(checked: infer.Inference, item: ast.Item, kept: List<surface.KeptName>) -> String {
    if ast.is_kept(item) || is_about_kept(item, kept) {
        return ""
    }
    match item {
        ast.Import(_) => ""
        ast.Type(declaration) => format.type_declaration(format.printer_of(""), declaration).text
        ast.Trait(declaration) => format.trait_declaration(format.printer_of(""), declaration).text
        ast.Instance(declaration) => format.instance_head(declaration) + "\n"
        ast.Derive(declaration) => derived_heads(declaration)
        ast.Function(declaration) => signature_of(checked, declaration) + "\n"
        ast.Extern(declaration) => format.extern_text(declaration) + "\n"
        ast.Process(declaration) => "process " + declaration.name.text + "\n"
        ast.Test(_) => ""
    }
}

// example: is_about_kept(declared.first_item("derive Eq for Box\n"), [surface.KeptType("Box")])
// example: !is_about_kept(declared.first_item("derive Eq for Box\n"), [surface.KeptValue("Box")])
fn is_about_kept(item: ast.Item, kept: List<surface.KeptName>) -> Bool {
    match item {
        ast.Instance(declaration) => list.has_value(kept, surface.KeptType(declaration.trait_name.text)) || list.has_value(kept, surface.KeptType(declaration.for_type.text))
        ast.Derive(declaration) => list.has_value(kept, surface.KeptType(declaration.for_type.text))
        _ => false
    }
}

// example: derived_heads(ast.DeriveDeclaration { traits: [], for_type: ast.Name { text: "Box", span: lexer.Span { start: 0, length: 3 } }, span: lexer.Span { start: 0, length: 3 } }) == ""
fn derived_heads(declaration: ast.DeriveDeclaration) -> String {
    var page = ""
    for trait_name in declaration.traits {
        page += "instance " + trait_name.text + "<" + declaration.for_type.text + ">\n"
    }
    page
}

// example: !has_names(Prelude { names: resolver.prelude_of(ast.Program { items: [] }), declared: declared.little_environment() })
private fn has_names(prelude: Prelude) -> Bool {
    has_value_named(prelude.names, "Some")
}

// example: has_value_named(little_prelude().names, "or")
private fn has_value_named(names: resolver.Prelude, named: String) -> Bool {
    match map.get(names.values, named) {
        Some(_) => true
        None => false
    }
}

// example: list.length(checked_of("fn count() -> Int {\n    1\n}\n").functions) == 1
fn checked_of(source: String) -> infer.Inference {
    let resolved = declared.resolved_of(source)
    let empty = infer.inference_of(resolved, surface.nothing_imported(), infer.no_declaring())
    ok_or(check(resolved, surface.nothing_imported(), little_prelude()), empty)
}

// example: page_code("fn count() -> Int {\n    1\n}\n") == ""
private fn page_code(source: String) -> String {
    refusal.code_given(check(declared.resolved_of(source), surface.nothing_imported(), little_prelude()))
}

// example: page_code("fn count() -> Int {\n    \"one\"\n}\n") == "L0400 18..31"
// example: page_code("fn is_there() -> Bool {\n    _ = Some(())\n    true\n}\n") == "L0432 32..40"
fn check(resolved: resolver.Resolved, imported: surface.Imported, prelude: Prelude) -> Result<infer.Inference, refusal.TypeError> {
    _ = declared.nothing_holds_itself(resolved)?
    _ = processes.every_process_shaped(resolved.program)?
    let declaring = declared.environment_of(declared.with_kept(prelude.declared, imported.kept), resolved, surface.every_type(imported), surface.every_instance(imported), unify.empty_table())?
    _ = processes.nothing_foreign_held(declaring.environment, resolved.program, surface.every_type(imported))?
    let inference = infer.module_inferred(resolved, imported, declaring)?
    _ = every_signature_written(inference)?
    _ = escapes.nothing_declared_escapes(inference)?
    carried.nothing_carried(inference)
}

// The check runs after inference, so the help spells the signature that inference settled,
// with `_` where it settled none.
// example: page_code("fn same<T>(value) -> T {\n    value\n}\n") == "L0436 11..16"
// example: page_code("fn count() {\n    1\n}\n") == "L0436 3..8"
// example: page_code("test \"a\" {\n    true\n}\n") == ""
fn every_signature_written(checked: infer.Inference) -> Result<(), refusal.TypeError> {
    for function in infer.functions_of(checked.resolved.program) {
        _ = signature_written(checked, function)?
    }
    Ok(())
}

// example: page_code("fn count(held: Int, more) -> Int {\n    held + more\n}\n") == "L0436 20..24"
fn signature_written(checked: infer.Inference, function: ast.FunctionDeclaration) -> Result<(), refusal.TypeError> {
    for parameter in function.parameters {
        if !processes.is_written(parameter.type_ref) {
            return Err(left_out(checked, function, refusal.TypeOfParameter(parameter.name.text), parameter.span))
        }
    }
    if !processes.is_written(function.result) {
        return Err(left_out(checked, function, refusal.ResultType, function.name.span))
    }
    Ok(())
}

// example: page_code("instance Eq<Box> {\n    fn is_equal(one: Box, other: Box) {\n        true\n    }\n}\n\ntype Box = Box\n") == "L0436 26..34"
fn left_out(checked: infer.Inference, function: ast.FunctionDeclaration, omitted: refusal.Omission, at: lexer.Span) -> refusal.TypeError {
    let unwritten = refusal.Unwritten { function: function.name.text, omitted: omitted, settled: signature_of(checked, function) }
    refusal.TypeError { kind: refusal.SignatureLeftOut(unwritten), span: at }
}

// example: page_of(checked_of("fn pick<T>(first: T, second: Int) -> T {\n    _ = second\n    first\n}\n")) == "fn pick<T>(first: T, second: Int) -> T\n"
fn signature_of(checked: infer.Inference, function: ast.FunctionDeclaration) -> String {
    let whole = unify.solved(checked.table, or(map.get(checked.named, function.name.span.start), unify.Unit))
    let taken = unify.parameters_of(whole)
    var takes = []
    var index = 0
    for parameter in function.parameters {
        takes = list.push(takes, parameter.name.text + ": " + unify.text_of(or(list.at(taken, index), unify.Unit)))
        index += 1
    }
    "fn " + function.name.text + format.constrained_text(function.type_parameters) + "(" + strings.join(takes, ", ") + ") -> " + unify.text_of(unify.result_of(whole))
}

// example: page_code("extern type Clock = \"com.example.Clock\"\n") == "L0434 20..39"
fn with_archived(prelude: Prelude, archived: set.Set<String>) -> Prelude {
    prelude { declared: declared.with_archived(prelude.declared, archived) }
}

// example: has_names(little_prelude())
fn little_prelude() -> Prelude {
    Prelude { names: resolver.prelude_of(declared.little_prelude()), declared: declared.little_environment() }
}

type Prelude = {
    names: resolver.Prelude
    declared: declared.Environment
}
