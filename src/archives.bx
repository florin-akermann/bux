// The Java archives a package states, each held to its line before a run can reach it.
//
// `docs/specs/packages.md` states the `jar` line and each refusal, and `docs/specs/run.md` states
// the class path the archives go on. `docs/specs/interop.md` states the classes an `extern` may
// name, which are the classes these archives hold and the classes on its list. The manifest is
// read by `modules`, which also reads it for the dependencies. An archive is read with `files`,
// hashed with `digest`, and opened with `jars`.
import digest
import files
import jars
import lexer
import list
import modules
import set
import strings

// Each archive opens once for all the names, and no archive opens where `named` is empty.
// example: set.has_value(ok_or(classes_held("no-such-directory", ["a.B"]), set.insert(set.empty(), "a.B")), "a.B") == false
fn classes_held(directory: String, named: List<String>) -> Result<set.Set<String>, Unreached> {
    if list.length(named) == 0 {
        return Ok(set.empty())
    }
    let files_held = reached(directory)?
    var found = set.empty()
    for file in files_held {
        found = held_in(file: file, named: named, known: found)
    }
    Ok(found)
}

// example: set.has_value(held_in(file: "no-such-directory/x.jar", named: ["a.B"], known: set.empty()), "a.B") == false
fn held_in(file: String, named: List<String>, known: set.Set<String>) -> set.Set<String> {
    match jars.opened(file) {
        Ok(archive) => entries_held(archive: archive, named: named, known: known)
        Err(_) => known
    }
}

// example: set.has_value(held_in(file: "no-such-directory/x.jar", named: [], known: set.insert(set.empty(), "a.B")), "a.B")
fn entries_held(archive: jars.JarFile, named: List<String>, known: set.Set<String>) -> set.Set<String> {
    var found = known
    for class in named {
        if has_entry(archive, entry_name(class)) {
            found = set.insert(found, class)
        }
    }
    jars.closed(archive)
    found
}

// example: set.has_value(held_in(file: "no-such-directory/x.jar", named: ["a.B"], known: set.empty()), "a.B") == false
fn has_entry(archive: jars.JarFile, name: String) -> Bool {
    match jars.entry_of(archive, name) {
        Some(_) => true
        None => false
    }
}

// example: entry_name("com.example.Clock$Tick") == "com/example/Clock$Tick.class"
fn entry_name(class: String) -> String {
    var name = ""
    var from = 0
    var index = 0
    for index < strings.length(class) {
        if or(strings.at(class, index), 0) == 46 {
            name += or(strings.cut(class, from, index), "") + "/"
            from = index + 1
        }
        index += 1
    }
    name + or(strings.cut(class, from, strings.length(class)), "") + ".class"
}

// example: list.length(ok_or(reached("no-such-directory"), ["x"])) == 0
fn reached(directory: String) -> Result<List<String>, Unreached> {
    match modules.archives_reached(directory) {
        Ok(stated) => each_held(stated)
        Err(not) => Err(Unread(not))
    }
}

// example: list.length(ok_or(each_held([]), ["x"])) == 0
fn each_held(stated: List<modules.Reached>) -> Result<List<String>, Unreached> {
    var found = []
    for one in stated {
        found = list.push(found, held(one)?)
    }
    Ok(found)
}

// example: code_of(refused_kind(held(one_at("no-such-directory/x.jar")))) == "L0606"
fn held(one: modules.Reached) -> Result<String, Unreached> {
    if !files.is_file(files.named(one.file)) {
        return Err(refused(one, Missing(one.archive.path)))
    }
    let bytes = read_of(one)?
    let hash = digest.sha256(bytes)
    if modules.Digest(hash) != one.archive.digest {
        return Err(refused(one, HashDiffers { path: one.archive.path, found: hash }))
    }
    opened_held(one)
}

// example: is_unread(read_of(one_at("no-such-directory/x.jar")))
fn read_of(one: modules.Reached) -> Result<List<Int>, Unreached> {
    match files.read_bytes(one.file) {
        Ok(bytes) => Ok(bytes)
        Err(why) => Err(Unread(modules.Unreadable { path: one.file, why: why }))
    }
}

// example: code_of(refused_kind(opened_held(one_at("no-such-directory/x.jar")))) == "L0609"
fn opened_held(one: modules.Reached) -> Result<String, Unreached> {
    match jars.opened(one.file) {
        Ok(archive) => class_path_held(one, archive)
        Err(_) => Err(refused(one, NotAnArchive(one.archive.path)))
    }
}

// A `Class-Path` in the manifest names more archives, and a JVM reaches each of them.
// example: code_of(refused_kind(opened_held(one_at("no-such-directory/x.jar")))) == "L0609"
fn class_path_held(one: modules.Reached, archive: jars.JarFile) -> Result<String, Unreached> {
    let named = more_named(archive)
    jars.closed(archive)
    match named {
        Ok(false) => Ok(one.file)
        Ok(true) => Err(refused(one, NamesMore(one.archive.path)))
        Err(_) => Err(refused(one, NotAnArchive(one.archive.path)))
    }
}

// example: code_of(refused_kind(opened_held(one_at("no-such-directory/x.jar")))) == "L0609"
fn more_named(archive: jars.JarFile) -> Result<Bool, String> {
    match jars.manifest_of(archive) {
        Ok(Some(manifest)) => Ok(has_class_path(jars.main_attributes(manifest)))
        Ok(None) => Ok(false)
        Err(why) => Err(why)
    }
}

// example: code_of(refused_kind(opened_held(one_at("no-such-directory/x.jar")))) == "L0609"
fn has_class_path(attributes: jars.Attributes) -> Bool {
    match jars.value_of(attributes, "Class-Path") {
        Some(_) => true
        None => false
    }
}

// example: code_of(refused_kind(Err(refused(one_at("x.jar"), Missing("x.jar"))))) == "L0606"
fn refused(one: modules.Reached, kind: ArchiveErrorKind) -> Unreached {
    Refused { manifest: one.manifest, error: ArchiveError { kind: kind, span: one.archive.span } }
}

// example: code_of(NamesMore("x.jar")) == "L0608"
fn code_of(kind: ArchiveErrorKind) -> String {
    match kind {
        Missing(_) => "L0606"
        HashDiffers {} => "L0607"
        NamesMore(_) => "L0608"
        NotAnArchive(_) => "L0609"
    }
}

// example: message(Missing("lib/x.jar")) == "`lib/x.jar` is not there"
fn message(kind: ArchiveErrorKind) -> String {
    match kind {
        Missing(path) => "`" + path + "` is not there"
        HashDiffers { path, found } => "`" + path + "` has the hash `sha256:" + found + "`, and this line states another"
        NamesMore(path) => "`" + path + "` names more archives in its `Class-Path`"
        NotAnArchive(path) => "`" + path + "` is no Java archive"
    }
}

// example: help_of(Missing("x.jar")) == "a `jar` line names a file on disk already, and nothing is fetched"
fn help_of(kind: ArchiveErrorKind) -> String {
    match kind {
        Missing(_) => "a `jar` line names a file on disk already, and nothing is fetched"
        HashDiffers {} => "a hash pins the bytes of an archive; state the hash of the archive the package uses"
        NamesMore(_) => "a run reaches only the archives a manifest states; use an archive with no `Class-Path`"
        NotAnArchive(_) => "a `jar` line names a zip file of classes, as the `jar` tool of the JDK writes one"
    }
}

// example: code_of(refused_kind(Ok("x.jar"))) == "L0606"
private fn refused_kind<T>(answer: Result<T, Unreached>) -> ArchiveErrorKind {
    match answer {
        Err(Refused { error }) => error.kind
        _ => Missing("")
    }
}

// example: !is_unread(Ok(1))
private fn is_unread<T>(answer: Result<T, Unreached>) -> Bool {
    match answer {
        Err(Unread(_)) => true
        _ => false
    }
}

// example: one_at("x.jar").file == "x.jar"
private fn one_at(file: String) -> modules.Reached {
    let archive = modules.Archive { path: file, digest: modules.Digest(modules.repeated_zero(64)), span: lexer.Span { start: 0, length: 0 } }
    modules.Reached { file: file, archive: archive, manifest: modules.Manifest { path: "bux.package", source: "" } }
}

type Unreached =
    | Unread(modules.NotLoaded)
    | Refused {
        manifest: modules.Manifest
        error: ArchiveError
    }

type ArchiveError = {
    kind: ArchiveErrorKind
    span: lexer.Span
}

type ArchiveErrorKind =
    | Missing(String)
    | HashDiffers {
        path: String
        found: String
    }
    | NamesMore(String)
    | NotAnArchive(String)
