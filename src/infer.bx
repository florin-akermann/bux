// The walk: every expression of a module given the type it has.
//
// `docs/specs/types.md` states the rules. The
// walk holds one `Inference`, which each step takes and gives back changed, so the table, the
// names in scope, and what still waits on a type are values rather than places that change.
import ast
import declared
import format
import lexer
import list
import map
import refusal
import resolver
import set
import strings
import surface
import unify

// example: nothing_inferred().table.made == 0
fn nothing_inferred() -> Inference {
    inference_of(declared.resolved_of(""), surface.nothing_imported(), no_declaring())
}

// example: found_after(Ok(Typed { inference: nothing_inferred(), found: unify.int() })) == unify.int()
private fn found_after(walked: Result<Typed, refusal.TypeError>) -> unify.Type {
    match walked {
        Ok(typed) => typed.found
        Err(_) => unify.Unit
    }
}

// example: no_declaring().table.made == 0
fn no_declaring() -> declared.Declaring {
    declared.Declaring { environment: declared.little_environment(), table: unify.empty_table() }
}

// example: no_name().text == ""
fn no_name() -> ast.Name {
    ast.Name { text: "", span: lexer.Span { start: 0, length: 0 } }
}

// example: !is_named(None)
private fn is_named(found: Option<ast.Name>) -> Bool {
    match found {
        Some(_) => true
        None => false
    }
}

// example: !is_declared(None)
private fn is_declared(found: Option<ast.FunctionDeclaration>) -> Bool {
    match found {
        Some(_) => true
        None => false
    }
}

// example: !is_reached(None)
private fn is_reached(found: Option<Typed>) -> Bool {
    match found {
        Some(_) => true
        None => false
    }
}

// example: is_propagating(Some(Absence))
private fn is_propagating(found: Option<Propagated>) -> Bool {
    match found {
        Some(_) => true
        None => false
    }
}

// example: typed_code("fn count() -> Int {\n    1\n}\n") == ""
private fn typed_code(source: String) -> String {
    let program = declared.first_program(source)
    match resolver.resolve(program, "main", resolver.prelude_of(declared.little_prelude()), set.empty()) {
        Ok(resolved) => declared_and_typed(resolved)
        Err(_) => "unresolved"
    }
}

// example: declared_and_typed(declared.resolved_of("fn count() -> Int {\n    1\n}\n")) == ""
private fn declared_and_typed(resolved: resolver.Resolved) -> String {
    match declared.environment_of(declared.little_environment(), resolved, [], [], unify.empty_table()) {
        Ok(declaring) => refusal.code_given(module_inferred(resolved, surface.nothing_imported(), declaring))
        Err(refused) => code_of_error(refused)
    }
}

// A module reads top down, so a walk from the bottom mostly finds each signature already inferred.
// example: typed_code("fn count() -> Int {\n    1\n}\n") == ""
// example: typed_code("fn count() -> Int {\n    \"one\"\n}\n") == "L0400 18..31"
fn module_inferred(resolved: resolver.Resolved, imported: surface.Imported, declaring: declared.Declaring) -> Result<Inference, refusal.TypeError> {
    var walking = derives_typed(inference_of(resolved, imported, declaring))
    for item in resolved.program.items {
        walking = trait_settled(walking, item)?
    }
    walking = externs_typed(walking)
    let written = functions_of(resolved.program)
    var index = list.length(written) - 1
    for index >= 0 {
        walking = function_at(walking, written, index)?
        index = index - 1
    }
    for stated in ast.tests_of(resolved.program) {
        walking = test_walked(walking, stated)?
    }
    settle_positional(walking)
}

// Lowering reads the method of a derive at the name of its trait, as it reads a function.
// example: unify.text_of(or(type_at(derives_typed(inference_of(declared.resolved_of("derive Eq for Box\n\ntype Box = Box\n"), surface.nothing_imported(), no_declaring())), lexer.Span { start: 7, length: 2 }), unify.Unit)) == "(Box, Box) -> Bool"
fn derives_typed(inference: Inference) -> Inference {
    var walking = inference
    for item in inference.resolved.program.items {
        walking = derive_typed(walking, item)
    }
    walking
}

// example: derive_typed(nothing_inferred(), declared.first_item("type Box = Box\n")).table.made == 0
fn derive_typed(inference: Inference, item: ast.Item) -> Inference {
    match item {
        ast.Derive(declaration) => each_derived(inference, declaration)
        _ => inference
    }
}

// example: each_derived(nothing_inferred(), ast.DeriveDeclaration { traits: [], for_type: no_name(), span: no_name().span }).table.made == 0
fn each_derived(inference: Inference, declaration: ast.DeriveDeclaration) -> Inference {
    var walking = inference
    let at = unify.Named { name: declaration.for_type.text, arguments: [] }
    for of in declaration.traits {
        let method = or(declared.method_at(inference.environment, of.text, derived_method(of.text), at), unify.Unit)
        walking = typed_at(walking, of.span, method)
    }
    walking
}

// example: derived_method("Ord") == "is_less"
fn derived_method(of: String) -> String {
    match of {
        "Eq" => "is_equal"
        "Ord" => "is_less"
        "Hash" => "hashed"
        _ => "shown"
    }
}

// example: list.length(externs_typed(nothing_inferred()).functions) == 0
fn externs_typed(inference: Inference) -> Inference {
    var walking = inference
    for item in inference.resolved.program.items {
        walking = extern_typed(walking, item)
    }
    walking
}

// example: extern_typed(nothing_inferred(), declared.first_item("type Box = Box\n")).table.made == 0
fn extern_typed(inference: Inference, item: ast.Item) -> Inference {
    match item {
        ast.Extern(declaration) => typed_at(inference, declaration.name.span, scheme_at(inference, declared.at_key(declaration.name.span.start)).body)
        _ => inference
    }
}

// example: list.length(inference_of(declared.resolved_of(""), surface.nothing_imported(), no_declaring()).functions) == 0
fn inference_of(resolved: resolver.Resolved, imported: surface.Imported, declaring: declared.Declaring) -> Inference {
    let environment = declaring.environment
    let table = declaring.table
    var keys = []
    for function in functions_of(resolved.program) {
        keys = list.push(keys, declared.at_key(function.name.span.start))
    }
    Inference { resolved: resolved, imported: imported, environment: environment, table: table { written_at: environment.written_at }, named: map.empty(), result: unify.Unit, introduced: [], operated: [], literals: [], discards: [], lookups: [], propagations: [], requirements: [], promised: [], positional: [], functions: keys, types: map.empty(), methods: map.empty(), generics_reached: map.empty() }
}

// example: typed_code("fn total() -> Int {\n    count()\n}\n\nfn count() -> Int {\n    1\n}\n") == ""
fn function_at(inference: Inference, written: List<ast.FunctionDeclaration>, index: Int) -> Result<Inference, refusal.TypeError> {
    match list.at(written, index) {
        Some(function) => function_walked(inference, function)
        None => Ok(inference)
    }
}

// example: typed_code("trait Sized<T> {\n    fn size(value: T) -> Bool\n}\n") == "L0413 24..28"
fn trait_settled(inference: Inference, item: ast.Item) -> Result<Inference, refusal.TypeError> {
    match item {
        ast.Trait(declaration) => methods_settled(inference, declaration.methods)
        _ => Ok(inference)
    }
}

// example: typed_code("trait Sized<T> {\n    fn is_sized(value: T, whole: Bool) -> Int\n}\n") == "L0412 43..54"
fn methods_settled(inference: Inference, methods: List<ast.Signature>) -> Result<Inference, refusal.TypeError> {
    for method in methods {
        let signature = scheme_at(inference, declared.at_key(method.name.span.start)).body
        _ = flags_refused(unify.parameters_of(signature), unify.result_of(signature), method.parameters, method.name)?
        _ = named_for(method.name, unify.result_of(signature))?
    }
    Ok(inference)
}

// example: typed_code("fn count(held) -> Int {\n    held\n}\n") == ""
fn function_walked(inference: Inference, function: ast.FunctionDeclaration) -> Result<Inference, refusal.TypeError> {
    let key = declared.at_key(function.name.span.start)
    let scheme = scheme_at(inference, key)
    let started = typed_at(inference { promised: scheme.required, named: map.insert(inference.named, function.name.span.start, scheme.body) }, function.name.span, scheme.body)
    var walking = writes_the_method(started, key, scheme.body, function.name.span)?
    let taken = unify.parameters_of(scheme.body)
    var index = 0
    for parameter in function.parameters {
        walking = introduced_at(walking, parameter.name, list.at(taken, index))
        index += 1
    }
    let given_back = unify.result_of(scheme.body)
    let body = block_walked(walking { result: given_back }, function.body, GivesItsValue)?
    let looked = look_up_fields(body.inference)?
    let met = expect(inference: looked, expected: given_back, found: body.found, at: function.body.span)?
    let settled = function_settled(met, function, taken)?
    Ok(generalise(settled { introduced: [] }, key))
}

// A test has no signature, so inference generalises nothing of it and names nothing of it.
// example: typed_code("test \"a\" {\n    true\n}\n") == ""
// example: typed_code("test \"a\" {\n    1\n}\n") == "L0400 9..18"
fn test_walked(inference: Inference, stated: ast.TestDeclaration) -> Result<Inference, refusal.TypeError> {
    let body = block_walked(inference { promised: [], result: unify.truth() }, stated.body, GivesItsValue)?
    let looked = look_up_fields(body.inference)?
    let met = expect(inference: looked, expected: unify.truth(), found: body.found, at: stated.body.span)?
    let propagated_all = settle_propagations(met)?
    let literals_settled = settle_literals(propagated_all)?
    let operators_settled = settle_operators(literals_settled)?
    let requirements_settled = settle_requirements(operators_settled)?
    let discards_settled = settle_discards(requirements_settled)?
    Ok(discards_settled { introduced: [] })
}

// example: list.length(introduced_at(nothing_inferred(), no_name(), None).introduced) == 0
fn introduced_at(inference: Inference, named: ast.Name, declared_one: Option<unify.Type>) -> Inference {
    match declared_one {
        Some(one) => introduce(inference, named, unify.monomorphic(one))
        None => inference
    }
}

// example: typed_code("fn count() -> Int {\n    1 + 1\n}\n") == ""
fn function_settled(inference: Inference, function: ast.FunctionDeclaration, taken: List<unify.Type>) -> Result<Inference, refusal.TypeError> {
    let propagated_all = settle_propagations(inference)?
    let literals_settled = settle_literals(propagated_all)?
    let operators_settled = settle_operators(literals_settled)?
    let requirements_settled = settle_requirements(operators_settled)?
    let discards_settled = settle_discards(requirements_settled)?
    let parameters_settled = settle_parameters(discards_settled, function, taken)?
    _ = named_for(function.name, unify.solved(parameters_settled.table, parameters_settled.result))?
    Ok(parameters_settled)
}

// example: typed_code("instance Eq<Box> {\n    fn is_equal(one: Box, other: Box) -> Int {\n        1\n    }\n}\n\ntype Box = Box\n") == "L0400 26..34"
fn writes_the_method(inference: Inference, key: String, found: unify.Type, at: lexer.Span) -> Result<Inference, refusal.TypeError> {
    match map.get(inference.environment.written_as, key) {
        Some(declared_one) => expect(inference: inference, expected: declared_one, found: found, at: at)
        None => Ok(inference)
    }
}

// example: typed_code("fn count() -> Int {\n    1 == 1\n    1\n}\n") == "L0408 24..30"
fn block_walked(inference: Inference, block: ast.Block, gives: BlockGives) -> Result<Typed, refusal.TypeError> {
    var walking = inference
    var left_behind = unify.Unit
    let last = list.length(block.statements) - 1
    var index = 0
    for statement in block.statements {
        let walked = statement_walked(walking, statement)?
        walking = walked.inference
        left_behind = walked.found
        if index < last || is_given_to_nothing(gives) {
            walking = discarded(walking, statement, left_behind)
        }
        index += 1
    }
    Ok(Typed { inference: walking, found: left_behind })
}

// example: typed_code("fn count() -> Int {\n    for {\n        break\n    }\n    1\n}\n") == ""
fn statement_walked(inference: Inference, statement: ast.Statement) -> Result<Typed, refusal.TypeError> {
    match statement.kind {
        ast.Binding { mutability, name, value } => binding_walked(inference, mutability, name, value)
        ast.Assign { target, operator, value } => assign_walked(inference, target, operator, value)
        ast.Return(given) => returned(inference, given, statement.span)
        ast.Break => Ok(fresh(inference))
        ast.ContinueLoop => Ok(fresh(inference))
        ast.For(walked) => nothing_left(loop_walked(inference, walked))
        ast.Discard(thrown) => nothing_left(thrown_away(inference, thrown))
        ast.Evaluated(written) => walked_expr(inference, written)
    }
}

// example: typed_code("fn count() -> Int {\n    _ = 1\n    1\n}\n") == ""
fn thrown_away(inference: Inference, thrown: ast.Expr) -> Result<Inference, refusal.TypeError> {
    let walked = walked_expr(inference, thrown)?
    Ok(walked.inference)
}

// example: typed_code("fn count() -> Int {\n    var held = 1\n    held = \"one\"\n    held\n}\n") == "L0400 48..53"
fn binding_walked(inference: Inference, mutability: ast.Mutability, named: ast.Name, bound_to: ast.Expr) -> Result<Typed, refusal.TypeError> {
    let bound = walked_expr(inference, bound_to)?
    let scheme = match mutability {
        ast.Immutable => generalised(bound.inference, bound.found)
        ast.Mutable => unify.monomorphic(bound.found)
    }
    Ok(Typed { inference: introduce(bound.inference, named, scheme), found: unify.Unit })
}

// example: typed_code("fn count() -> Int {\n    var held = 1\n    held += 2\n    held\n}\n") == ""
fn assign_walked(inference: Inference, target: ast.Name, operator: ast.AssignOperator, assigned_from: ast.Expr) -> Result<Typed, refusal.TypeError> {
    let assigned = value_of_name(inference, target)
    let found = walked_expr(assigned.inference, assigned_from)?
    let met = expect(inference: found.inference, expected: assigned.found, found: found.found, at: assigned_from.span)?
    let added = match operator {
        ast.SetTo => met
        ast.AddTo => operating(met, Operated { of: "Add", written_as: "+=", at: assigned.found, written: target.span })
    }
    Ok(Typed { inference: added, found: unify.Unit })
}

// A `return` leaves the block, so what follows it can be any type.
// example: typed_code("fn count() -> Int {\n    return \"one\"\n}\n") == "L0400 31..36"
fn returned(inference: Inference, given: Option<ast.Expr>, at: lexer.Span) -> Result<Typed, refusal.TypeError> {
    let met = match given {
        Some(written) => returned_value(inference, written)
        None => expect(inference: inference, expected: inference.result, found: unify.Unit, at: at)
    }
    Ok(fresh(met?))
}

// example: typed_code("fn count() -> Int {\n    return 1\n}\n") == ""
fn returned_value(inference: Inference, written: ast.Expr) -> Result<Inference, refusal.TypeError> {
    let found = walked_expr(inference, written)?
    expect(inference: found.inference, expected: found.inference.result, found: found.found, at: written.span)
}

// example: typed_code("fn count() -> Int {\n    for 1 {\n        break\n    }\n    1\n}\n") == "L0400 28..29"
fn loop_walked(inference: Inference, walked: ast.ForLoop) -> Result<Inference, refusal.TypeError> {
    let headed = match walked.header {
        ast.Forever => Ok(inference)
        ast.While(condition) => condition_walked(inference, condition)
        ast.Over { binding, iterable } => over_walked(inference, binding, iterable)
    }
    let body = block_walked(headed?, walked.body, GivesNothing)?
    Ok(body.inference)
}

// example: typed_code("fn count() -> Int {\n    for item in 1 {\n        _ = item\n    }\n    1\n}\n") == "L0400 36..37"
fn over_walked(inference: Inference, binding: ast.Name, iterable: ast.Expr) -> Result<Inference, refusal.TypeError> {
    let over = walked_expr(inference, iterable)?
    let item = fresh(over.inference)
    let met = expect(inference: item.inference, expected: unify.list_of(item.found), found: over.found, at: iterable.span)?
    Ok(introduce(met, binding, unify.monomorphic(item.found)))
}

// example: typed_code("fn count() -> Int {\n    ()\n}\n") == "L0400 18..28"
fn walked_expr(inference: Inference, written: ast.Expr) -> Result<Typed, refusal.TypeError> {
    let walked = expr_written(inference, written)?
    Ok(Typed { inference: typed_at(walked.inference, written.span, walked.found), found: walked.found })
}

// example: typed_code("fn count() -> Int {\n    \"one\"\n}\n") == "L0400 18..31"
fn expr_written(inference: Inference, written: ast.Expr) -> Result<Typed, refusal.TypeError> {
    match written.kind {
        ast.NameExpr(named) => Ok(value_of_name(inference, named))
        ast.Integer(number) => Ok(literal(inference, number, written.span))
        ast.Text(_) => Ok(Typed { inference: inference, found: unify.text_type() })
        ast.Truth(_) => Ok(Typed { inference: inference, found: unify.truth() })
        ast.Unit => Ok(Typed { inference: inference, found: unify.Unit })
        ast.Unary { operator, operand } => unary_walked(inference, operator, operand, written.span)
        ast.Binary { operator, left, right } => binary_walked(inference, operator, Operands { left: left, right: right, at: written.span })
        ast.Call { callee, arguments } => call_walked(inference, callee, arguments, written.span)
        ast.Field { receiver, name } => field_walked(inference, receiver, name, AsAValue)
        ast.Try(inner) => propagated(inference, inner, written.span)
        ast.Written(elements) => list_walked(inference, elements)
        ast.Record { base, fields } => record_walked(inference, base, fields, written.span)
        ast.If(chain) => if_walked(inference, chain)
        ast.Match(matched) => match_walked(inference, matched)
        ast.Spawn(started) => spawn_walked(inference, started)
    }
}

// The resolver already holds the operand of `spawn` to a call, so inference types it as a call.
// example: typed_code("import demo\n\nfn count() -> Int {\n    _ = spawn demo.Counter()\n    1\n}\n") == "L0800 52..59"
fn spawn_walked(inference: Inference, started: ast.Expr) -> Result<Typed, refusal.TypeError> {
    match started.kind {
        ast.Call { callee, arguments } => call_typed(callee_type(inference, callee, AsASpawn)?, callee, arguments, started.span)
        _ => walked_expr(inference, started)
    }
}

// example: typed_code("fn count() -> Int {\n    _ = [1, \"one\"]\n    1\n}\n") == "L0400 32..37"
fn list_walked(inference: Inference, elements: List<ast.Expr>) -> Result<Typed, refusal.TypeError> {
    let item = fresh(inference)
    var walking = item.inference
    for element in elements {
        let found = walked_expr(walking, element)?
        walking = expect(inference: found.inference, expected: item.found, found: found.found, at: element.span)?
    }
    Ok(Typed { inference: walking, found: unify.list_of(item.found) })
}

// example: typed_code("fn count() -> Int {\n    _ = !1\n    1\n}\n") == "L0400 29..30"
fn unary_walked(inference: Inference, operator: ast.UnaryOperator, operand: ast.Expr, at: lexer.Span) -> Result<Typed, refusal.TypeError> {
    let found = walked_expr(inference, operand)?
    match operator {
        ast.Not => truth_after(expect(inference: found.inference, expected: unify.truth(), found: found.found, at: operand.span))
        ast.Negate => Ok(Typed { inference: operating(found.inference, Operated { of: "Neg", written_as: "-", at: found.found, written: at }), found: found.found })
    }
}

// `&&` and `||` are for `Bool` only, because each decides whether the other side runs.
// example: typed_code("fn count() -> Int {\n    1 + \"one\"\n}\n") == "L0400 28..33"
fn binary_walked(inference: Inference, operator: ast.BinaryOperator, operands: Operands) -> Result<Typed, refusal.TypeError> {
    let found = walked_expr(inference, operands.left)?
    let other = walked_expr(found.inference, operands.right)?
    match asked_by(operator) {
        Some(asked) => operator_asked(other.inference, asked, Sides { left: found.found, right: other.found, operator: operator }, operands)
        None => both_true(other.inference, Sides { left: found.found, right: other.found, operator: operator }, operands)
    }
}

// example: typed_code("fn count(held: Int) -> Int {\n    count(held, 2)\n}\n") == "L0401 33..38"
fn call_walked(inference: Inference, callee: ast.Expr, arguments: ast.Arguments, at: lexer.Span) -> Result<Typed, refusal.TypeError> {
    _ = called_plainly(inference, callee, arguments, at)?
    call_typed(callee_type(inference, callee, AsACall)?, callee, arguments, at)
}

// example: typed_code("fn count(held: Int) -> Int {\n    count(\"one\") + held\n}\n") == "L0400 39..44"
fn call_typed(signature: Typed, callee: ast.Expr, arguments: ast.Arguments, at: lexer.Span) -> Result<Typed, refusal.TypeError> {
    let passed = values_of(arguments)
    var walking = signature.inference
    var given = []
    for argument in passed {
        let one = walked_expr(walking, argument)?
        walking = one.inference
        given = list.push(given, one.found)
    }
    let shape = unify.shallow(walking.table, signature.found)
    if !unify.is_function(shape) {
        return applied(walking, signature.found, given, at)
    }
    let taken = unify.parameters_of(shape)
    if list.length(taken) != list.length(given) {
        return miscounted_call(walking, callee, Applied { called: signature.found, given: given, takes: list.length(taken) }, at)
    }
    let met = each_expected(inference: walking, taken: taken, given: given, passed: passed)?
    let named = named_as_declared(met, callee, arguments, at)?
    Ok(Typed { inference: named, found: unify.result_of(shape) })
}

// example: typed_code("import demo\n\nfn count() -> Int {\n    demo.total()\n}\n") == "L0414 42..47"
fn callee_type(inference: Inference, callee: ast.Expr, how: ReachedAs) -> Result<Typed, refusal.TypeError> {
    match callee.kind {
        ast.Field { receiver, name } => kept_at(field_walked(inference, receiver, name, how), callee.span)
        _ => walked_expr(inference, callee)
    }
}

// example: found_after(kept_at(Ok(Typed { inference: nothing_inferred(), found: unify.int() }), no_name().span)) == unify.int()
fn kept_at(walked: Result<Typed, refusal.TypeError>, span: lexer.Span) -> Result<Typed, refusal.TypeError> {
    let one = walked?
    Ok(Typed { inference: typed_at(one.inference, span, one.found), found: one.found })
}

// example: typed_code("fn count(held) -> Int {\n    held.size\n}\n") == "L0402 33..37"
fn field_walked(inference: Inference, receiver: ast.Expr, named: ast.Name, how: ReachedAs) -> Result<Typed, refusal.TypeError> {
    let through = walked_expr(inference, receiver)?
    let found = fresh(through.inference)
    let lookup = Lookup { through: through.found, field: named, found: found.found, how: how }
    if unify.is_var(unify.shallow(found.inference.table, through.found)) {
        return Ok(Typed { inference: looking(found.inference, lookup), found: found.found })
    }
    let looked = look_up(found.inference, lookup)?
    Ok(Typed { inference: looked, found: found.found })
}

// example: typed_code("fn count(held: Option<Int>) -> Option<Int> {\n    held?\n}\n") == "L0400 43..56"
fn propagated(inference: Inference, inner: ast.Expr, at: lexer.Span) -> Result<Typed, refusal.TypeError> {
    let found = walked_expr(inference, inner)?
    let held = fresh(found.inference)
    let waiting = Propagation { found: found.found, held: held.found, inner: inner.span, at: at }
    match propagates(held.inference, found.found) {
        Some(kind) => held_after(propagate(held.inference, waiting, kind), held.found)
        None => Ok(Typed { inference: propagating(held.inference, waiting), found: held.found })
    }
}

// example: typed_code("fn count() -> Int {\n    if true {\n        1\n    } else {\n        \"one\"\n    }\n}\n") == "L0400 32..49"
fn if_walked(inference: Inference, chain: ast.IfExpr) -> Result<Typed, refusal.TypeError> {
    var walking = inference
    var blocks = []
    for branch in chain.branches {
        walking = condition_walked(walking, branch.condition)?
        let block = block_walked(walking, branch.block, GivesItsValue)?
        walking = block.inference
        blocks = list.push(blocks, Branched { found: block.found, span: branch.block.span })
    }
    let otherwise = otherwise_walked(walking, chain.otherwise)?
    walking = otherwise.inference
    for one in blocks {
        walking = expect(inference: walking, expected: otherwise.found, found: one.found, at: one.span)?
    }
    Ok(Typed { inference: walking, found: otherwise.found })
}

// example: found_after(otherwise_walked(nothing_inferred(), None)) == unify.Unit
fn otherwise_walked(inference: Inference, otherwise: Option<ast.Block>) -> Result<Typed, refusal.TypeError> {
    match otherwise {
        Some(block) => block_walked(inference, block, GivesItsValue)
        None => Ok(Typed { inference: inference, found: unify.Unit })
    }
}

// example: typed_code("fn count(held: Int) -> Int {\n    match held {\n        1 => 1\n        _ => \"one\"\n    }\n}\n") == "L0400 74..79"
fn match_walked(inference: Inference, matched: ast.MatchExpr) -> Result<Typed, refusal.TypeError> {
    let scrutinee = walked_expr(inference, matched.scrutinee)?
    let made = fresh(scrutinee.inference)
    var walking = made.inference
    for arm in matched.arms {
        walking = pattern_walked(walking, arm.pattern, scrutinee.found)?
        let found = walked_expr(walking, arm.body)?
        walking = expect(inference: found.inference, expected: made.found, found: found.found, at: arm.body.span)?
    }
    Ok(Typed { inference: walking, found: made.found })
}

// example: typed_code("fn count() -> Int {\n    if 1 {\n        1\n    } else {\n        2\n    }\n}\n") == "L0400 27..28"
fn condition_walked(inference: Inference, condition: ast.Expr) -> Result<Inference, refusal.TypeError> {
    let found = walked_expr(inference, condition)?
    expect(inference: found.inference, expected: unify.truth(), found: found.found, at: condition.span)
}

// example: typed_code("fn made() -> Box {\n    Box { count: 1, count: 2 }\n}\n\ntype Box = {\n    count: Int\n}\n") == "L0405 39..44"
fn record_walked(inference: Inference, base: ast.Path, fields: List<ast.FieldValue>, at: lexer.Span) -> Result<Typed, refusal.TypeError> {
    _ = written_once(base, fields)?
    if is_built(inference, base) {
        return build(inference, base, fields, at)
    }
    let updated = value_of_name(inference, base.name)
    var walking = updated.inference
    for field in fields {
        let found = walked_expr(walking, ast.field_expression(field))?
        walking = looking(found.inference, Lookup { through: updated.found, field: field.name, found: found.found, how: AsAValue })
    }
    Ok(Typed { inference: walking, found: updated.found })
}

// example: typed_code("fn made() -> Box {\n    Box {}\n}\n\ntype Box = {\n    count: Int\n}\n") == "L0404 23..29"
fn build(inference: Inference, base: ast.Path, fields: List<ast.FieldValue>, at: lexer.Span) -> Result<Typed, refusal.TypeError> {
    let built = built_by(inference, base)?
    let labels = or(map.get(built.inference.environment.labels, built.key), [])
    if !unify.is_function(built.found) {
        return Ok(Typed { inference: built.inference, found: build_without_fields(built.found, fields)? })
    }
    let taken = unify.parameters_of(built.found)
    let made = unify.result_of(built.found)
    if list.length(labels) != list.length(taken) {
        return Err(built_without_labels(base, fields, list.length(taken), made))
    }
    var walking = built.inference
    for field in fields {
        let value = ast.field_expression(field)
        let found = walked_expr(walking, value)?
        let index = labelled(labels, field.name, made)?
        walking = expect(inference: found.inference, expected: or(list.at(taken, index), unify.Unit), found: found.found, at: value.span)?
    }
    _ = every_field_given(base, fields, labels, at)?
    Ok(Typed { inference: walking, found: made })
}

// example: is_given_to_nothing(GivesNothing)
fn is_given_to_nothing(gives: BlockGives) -> Bool {
    match gives {
        GivesItsValue => false
        GivesNothing => true
    }
}

// example: list.length(discarded(nothing_inferred(), ast.Statement { kind: ast.Break, span: lexer.Span { start: 0, length: 5 } }, unify.Unit).discards) == 0
fn discarded(inference: Inference, statement: ast.Statement, left_behind: unify.Type) -> Inference {
    match statement.kind {
        ast.Evaluated(written) => inference { discards: list.push(inference.discards, Discard { found: left_behind, at: written.span }) }
        _ => inference
    }
}

// example: found_after(nothing_left(Ok(nothing_inferred()))) == unify.Unit
fn nothing_left(walked: Result<Inference, refusal.TypeError>) -> Result<Typed, refusal.TypeError> {
    let left = walked?
    Ok(Typed { inference: left, found: unify.Unit })
}

// example: typed_code("fn is_both() -> Bool {\n    true && 1\n}\n") == "L0400 35..36"
fn both_true(inference: Inference, sides: Sides, operands: Operands) -> Result<Typed, refusal.TypeError> {
    let left_met = expect(inference: inference, expected: unify.truth(), found: sides.left, at: operands.left.span)?
    truth_after(expect(inference: left_met, expected: unify.truth(), found: sides.right, at: operands.right.span))
}

// example: found_after(truth_after(Ok(nothing_inferred()))) == unify.truth()
fn truth_after(walked: Result<Inference, refusal.TypeError>) -> Result<Typed, refusal.TypeError> {
    let left = walked?
    Ok(Typed { inference: left, found: unify.truth() })
}

// example: typed_code("fn count() -> Option<Int> {\n    1 / 0\n}\n") == "L0407 36..37"
fn operator_asked(inference: Inference, asked: Asking, sides: Sides, operands: Operands) -> Result<Typed, refusal.TypeError> {
    let met = expect(inference: inference, expected: sides.left, found: sides.right, at: operands.right.span)?
    if asked.of == "Div" || asked.of == "Rem" {
        _ = divides_by_zero(operands.right)?
    }
    let waiting = operating(met, Operated { of: asked.of, written_as: asked.written_as, at: sides.left, written: operands.at })
    Ok(Typed { inference: waiting, found: gives_back(sides.operator, sides.left) })
}

// example: or(asked_by(ast.Less), Asking { of: "", written_as: "" }).of == "Ord"
fn asked_by(operator: ast.BinaryOperator) -> Option<Asking> {
    match operator {
        ast.Or => None
        ast.And => None
        ast.Equal => Some(Asking { of: "Eq", written_as: "==" })
        ast.NotEqual => Some(Asking { of: "Eq", written_as: "!=" })
        ast.Less => Some(Asking { of: "Ord", written_as: "<" })
        ast.LessOrEqual => Some(Asking { of: "Ord", written_as: "<=" })
        ast.Greater => Some(Asking { of: "Ord", written_as: ">" })
        ast.GreaterOrEqual => Some(Asking { of: "Ord", written_as: ">=" })
        ast.Add => Some(Asking { of: "Add", written_as: "+" })
        ast.Subtract => Some(Asking { of: "Sub", written_as: "-" })
        ast.Multiply => Some(Asking { of: "Mul", written_as: "*" })
        ast.Divide => Some(Asking { of: "Div", written_as: "/" })
        ast.Remainder => Some(Asking { of: "Rem", written_as: "%" })
    }
}

// example: gives_back(ast.Divide, unify.int()) == unify.option_of(unify.int())
fn gives_back(operator: ast.BinaryOperator, found: unify.Type) -> unify.Type {
    match operator {
        ast.Equal => unify.truth()
        ast.NotEqual => unify.truth()
        ast.Less => unify.truth()
        ast.LessOrEqual => unify.truth()
        ast.Greater => unify.truth()
        ast.GreaterOrEqual => unify.truth()
        ast.Divide => unify.option_of(found)
        ast.Remainder => unify.option_of(found)
        _ => found
    }
}

// example: refusal.code_given(divides_by_zero(ast.Expr { kind: ast.Integer(0), span: lexer.Span { start: 4, length: 1 } })) == "L0407 4..5"
fn divides_by_zero(divisor: ast.Expr) -> Result<(), refusal.TypeError> {
    match divisor.kind {
        ast.Integer(number) => zero_refused(number, divisor.span)
        _ => Ok(())
    }
}

// example: refusal.code_given(zero_refused(2, lexer.Span { start: 0, length: 1 })) == ""
fn zero_refused(number: Int, at: lexer.Span) -> Result<(), refusal.TypeError> {
    if number != 0 {
        return Ok(())
    }
    Err(refusal.TypeError { kind: refusal.DivisorIsZero, span: at })
}

// example: typed_code("fn count() -> Int {\n    1(2)\n}\n") == "L0400 24..28"
fn miscounted_call(inference: Inference, callee: ast.Expr, applying: Applied, at: lexer.Span) -> Result<Typed, refusal.TypeError> {
    match name_of(callee) {
        Some(named) => Err(miscounted(named: named, takes: applying.takes, given: list.length(applying.given)))
        None => applied(inference, applying.called, applying.given, at)
    }
}

// example: typed_code("fn count(held: Int) -> Int {\n    count(\"one\") + held\n}\n") == "L0400 39..44"
fn each_expected(inference: Inference, taken: List<unify.Type>, given: List<unify.Type>, passed: List<ast.Expr>) -> Result<Inference, refusal.TypeError> {
    var walking = inference
    var index = 0
    for wanted in taken {
        walking = expect(inference: walking, expected: wanted, found: or(list.at(given, index), unify.Unit), at: span_at(passed, index))?
        index += 1
    }
    Ok(walking)
}

// example: shown(span_at([], 0)) == "0..0"
fn span_at(passed: List<ast.Expr>, index: Int) -> lexer.Span {
    match list.at(passed, index) {
        Some(written) => written.span
        None => lexer.Span { start: 0, length: 0 }
    }
}

// example: typed_code("fn count(held: Int) -> Int {\n    held.count()\n}\n") == "L0433 33..45"
// example: typed_code("fn count(held: Int) -> Int {\n    count(held)\n}\n") == ""
fn called_plainly(inference: Inference, callee: ast.Expr, arguments: ast.Arguments, at: lexer.Span) -> Result<(), refusal.TypeError> {
    match callee.kind {
        ast.Field { receiver, name } => if is_a_module(inference, receiver) {
            Ok(())
        } else {
            Err(refusal.TypeError { kind: refusal.CalledOnAValue { function: name.text, plain: plain_call(inference, Moved { receiver: receiver, called: name, arguments: arguments }) }, span: at })
        }
        _ => Ok(())
    }
}

// example: plain_call(nothing_inferred(), Moved { receiver: format.expression_of("maybe"), called: ast.Name { text: "or", span: lexer.Span { start: 0, length: 2 } }, arguments: ast.Positional([format.expression_of("0")]) }) == "or(maybe, 0)"
fn plain_call(inference: Inference, moved: Moved) -> String {
    let callee = ast.Expr { kind: ast.NameExpr(moved.called), span: moved.called.span }
    let written = ast.Expr { kind: ast.Call { callee: callee, arguments: passed_first(inference, moved) }, span: moved.receiver.span }
    format.nested(format.printer_of(""), written, 0, format.Allowed).text
}

// Only a function that this module declares has parameter names, so other calls pass in order.
// example: plain_call(nothing_inferred(), Moved { receiver: format.expression_of("old"), called: ast.Name { text: "rename", span: lexer.Span { start: 0, length: 6 } }, arguments: ast.Named([]) }) == "rename(old)"
fn passed_first(inference: Inference, moved: Moved) -> ast.Arguments {
    match moved.arguments {
        ast.Positional(values) => ast.Positional(pushed_before(moved.receiver, values))
        ast.Named(written) => named_first(moved.receiver, parameter_names(inference.resolved.program, moved.called), written)
    }
}

// example: list.length(values_of(named_first(format.expression_of("old"), [], []))) == 1
fn named_first(value: ast.Expr, names: List<ast.Name>, written: List<ast.NamedArgument>) -> ast.Arguments {
    match list.at(names, 0) {
        Some(first) => if is_named_among(first, written) {
            ast.Positional(pushed_before(value, named_values(written)))
        } else {
            ast.Named(pushed_before(ast.NamedArgument { name: first, value: value }, written))
        }
        None => ast.Positional(pushed_before(value, named_values(written)))
    }
}

// example: !is_named_among(no_name(), [])
fn is_named_among(parameter: ast.Name, written: List<ast.NamedArgument>) -> Bool {
    for argument in written {
        if argument.name.text == parameter.text {
            return true
        }
    }
    false
}

// example: pushed_before(1, [2, 3]) == [1, 2, 3]
fn pushed_before<T>(first: T, rest: List<T>) -> List<T> {
    var together = [first]
    for one in rest {
        together = list.push(together, one)
    }
    together
}

// example: list.length(parameter_names(declared.first_program("fn rename(from: String, to: String) -> String {\n    from + to\n}\n"), ast.Name { text: "rename", span: lexer.Span { start: 0, length: 6 } })) == 2
fn parameter_names(program: ast.Program, called: ast.Name) -> List<ast.Name> {
    var names = []
    for item in program.items {
        for function in declared_as(item, called) {
            for parameter in function.parameters {
                names = list.push(names, parameter.name)
            }
        }
    }
    names
}

// example: list.length(declared_as(declared.first_item("type Box = Box\n"), no_name())) == 0
fn declared_as(item: ast.Item, called: ast.Name) -> List<ast.FunctionDeclaration> {
    match item {
        ast.Function(function) => if function.name.text == called.text {
            [function]
        } else {
            []
        }
        _ => []
    }
}

// example: list.length(values_of(ast.Named([]))) == 0
fn values_of(arguments: ast.Arguments) -> List<ast.Expr> {
    match arguments {
        ast.Positional(values) => values
        ast.Named(written) => named_values(written)
    }
}

// example: list.length(named_values([])) == 0
fn named_values(written: List<ast.NamedArgument>) -> List<ast.Expr> {
    var values = []
    for argument in written {
        values = list.push(values, argument.value)
    }
    values
}

// example: typed_code("fn count(held) -> Int {\n    held(1)\n}\n") == ""
fn applied(inference: Inference, calling: unify.Type, given: List<unify.Type>, at: lexer.Span) -> Result<Typed, refusal.TypeError> {
    let made = fresh(inference)
    let met = expect(inference: made.inference, expected: calling, found: unify.Function { parameters: given, result: made.found }, at: at)?
    Ok(Typed { inference: met, found: made.found })
}

// example: typed_code("fn count(held: Int) -> Int {\n    count(other: 1) + held\n}\n") == "L0410 39..47"
fn named_as_declared(inference: Inference, callee: ast.Expr, arguments: ast.Arguments, at: lexer.Span) -> Result<Inference, refusal.TypeError> {
    match name_of(callee) {
        Some(reached) => named_as_written(inference, Calling { callee: callee, reached: reached, at: at }, declaration_of(inference, reached), arguments)
        None => Ok(inference)
    }
}

// example: is_named(name_of(ast.Expr { kind: ast.NameExpr(no_name()), span: lexer.Span { start: 0, length: 0 } }))
fn name_of(callee: ast.Expr) -> Option<ast.Name> {
    match callee.kind {
        ast.NameExpr(named) => Some(named)
        ast.Field { name } => Some(name)
        _ => None
    }
}

// example: typed_code("fn count() -> Option<Int> {\n    Some(value: 1)\n}\n") == "L0411 32..46"
fn named_as_written(inference: Inference, calling: Calling, declaration: Option<ast.FunctionDeclaration>, arguments: ast.Arguments) -> Result<Inference, refusal.TypeError> {
    match declaration {
        Some(function) => declared_call(inference, function, calling.at, arguments)
        None => undeclared_call(inference, calling, arguments)
    }
}

// example: typed_code("fn count(held: Int, more: Int) -> Int {\n    count(held, more)\n}\n") == "L0409 44..61"
fn declared_call(inference: Inference, function: ast.FunctionDeclaration, at: lexer.Span, arguments: ast.Arguments) -> Result<Inference, refusal.TypeError> {
    match arguments {
        ast.Positional(_) => Ok(inference { positional: list.push(inference.positional, Positional { function: function.name, at: at }) })
        ast.Named(written) => in_order(inference, function, written)
    }
}

// example: typed_code("fn count() -> Option<Int> {\n    or(maybe: None, fallback: 1)\n}\n") == "L0411 32..60"
fn undeclared_call(inference: Inference, calling: Calling, arguments: ast.Arguments) -> Result<Inference, refusal.TypeError> {
    match arguments {
        ast.Positional(_) => Ok(inference)
        ast.Named(_) => Err(refusal.TypeError { kind: unnameable(inference, calling.callee, calling.reached), span: calling.at })
    }
}

// example: refusal.message(unnameable(nothing_inferred(), ast.Expr { kind: ast.Unit, span: lexer.Span { start: 0, length: 2 } }, no_name())) == refusal.message(refusal.NamedPrelude(""))
fn unnameable(inference: Inference, callee: ast.Expr, written: ast.Name) -> refusal.TypeErrorKind {
    for reached in through_a_module(inference, callee) {
        return refusal.NamedThroughModule(reached)
    }
    if declared.definition_of(inference.resolved, resolver.ValueNamespace, written).kind == resolver.Constructor {
        return refusal.NamedConstructor(written.text)
    }
    refusal.NamedPrelude(written.text)
}

// example: list.length(through_a_module(nothing_inferred(), ast.Expr { kind: ast.Unit, span: lexer.Span { start: 0, length: 2 } })) == 0
fn through_a_module(inference: Inference, callee: ast.Expr) -> List<String> {
    match callee.kind {
        ast.Field { receiver, name } => module_path(inference, receiver, name)
        _ => []
    }
}

// example: list.length(module_path(nothing_inferred(), ast.Expr { kind: ast.Unit, span: lexer.Span { start: 0, length: 2 } }, no_name())) == 0
fn module_path(inference: Inference, receiver: ast.Expr, named: ast.Name) -> List<String> {
    if !is_a_module(inference, receiver) {
        return []
    }
    match receiver.kind {
        ast.NameExpr(module) => [module.text + "." + named.text]
        _ => []
    }
}

// example: !is_a_module(nothing_inferred(), ast.Expr { kind: ast.Unit, span: lexer.Span { start: 0, length: 2 } })
fn is_a_module(inference: Inference, receiver: ast.Expr) -> Bool {
    match receiver.kind {
        ast.NameExpr(named) => declared.definition_of(inference.resolved, resolver.ValueNamespace, named).kind == resolver.Module
        _ => false
    }
}

// example: !is_declared(declaration_of(nothing_inferred(), no_name()))
fn declaration_of(inference: Inference, called: ast.Name) -> Option<ast.FunctionDeclaration> {
    match declared.definition_of(inference.resolved, resolver.ValueNamespace, called).origin {
        resolver.InPrelude => None
        resolver.Declared(span) => function_written_at(inference.resolved.program, span.start)
    }
}

// A process name gives its `start` function, because `spawn` passes its values to that function.
// example: !is_declared(function_written_at(ast.Program { items: [] }, 0))
// example: is_declared(function_written_at(declared.first_program("process Counter {\n    fn start() -> Int {\n        0\n    }\n}\n"), 8))
fn function_written_at(program: ast.Program, start: Int) -> Option<ast.FunctionDeclaration> {
    for function in functions_of(program) {
        if function.name.span.start == start {
            return Some(function)
        }
    }
    for item in program.items {
        for function in started_by(item, start) {
            return Some(function)
        }
    }
    None
}

// example: list.length(started_by(declared.first_item("type Box = Box\n"), 5)) == 0
fn started_by(item: ast.Item, at: Int) -> List<ast.FunctionDeclaration> {
    match item {
        ast.Process(declaration) => if declaration.name.span.start == at {
            first_function(declaration)
        } else {
            []
        }
        _ => []
    }
}

// The shape check holds the first function of a process to be `start`.
// example: list.length(first_function(ast.ProcessDeclaration { name: no_name(), functions: [], span: no_name().span, visibility: ast.Public })) == 0
fn first_function(declaration: ast.ProcessDeclaration) -> List<ast.FunctionDeclaration> {
    match list.at(declaration.functions, 0) {
        Some(function) => [function]
        None => []
    }
}

// example: list.length(functions_of(declared.first_program("fn count() -> Int {\n    1\n}\n"))) == 1
fn functions_of(program: ast.Program) -> List<ast.FunctionDeclaration> {
    var written = []
    for item in program.items {
        for function in bodies_of(item) {
            written = list.push(written, function)
        }
    }
    written
}

// example: list.length(bodies_of(declared.first_item("type Box = Box\n"))) == 0
fn bodies_of(item: ast.Item) -> List<ast.FunctionDeclaration> {
    match item {
        ast.Instance(declaration) => declaration.methods
        ast.Function(function) => [function]
        ast.Process(declaration) => declaration.functions
        _ => []
    }
}

// example: typed_code("fn count(held: Int, more: Int) -> Int {\n    count(more: 1, held: 2) + held + more\n}\n") == "L0410 50..57"
fn in_order(inference: Inference, function: ast.FunctionDeclaration, written: List<ast.NamedArgument>) -> Result<Inference, refusal.TypeError> {
    var index = 0
    for argument in written {
        _ = named_at(argument, list.at(function.parameters, index))?
        index += 1
    }
    Ok(inference)
}

// example: refusal.code_given(named_at(ast.NamedArgument { name: no_name(), value: ast.Expr { kind: ast.Unit, span: lexer.Span { start: 3, length: 2 } } }, None)) == ""
fn named_at(argument: ast.NamedArgument, parameter: Option<ast.Parameter>) -> Result<(), refusal.TypeError> {
    match parameter {
        Some(one) => named_in_order(argument, one)
        None => Ok(())
    }
}

// example: refusal.code_given(named_in_order(ast.NamedArgument { name: no_name(), value: ast.Expr { kind: ast.Unit, span: lexer.Span { start: 3, length: 2 } } }, ast.Parameter { name: no_name(), type_ref: None, span: lexer.Span { start: 0, length: 0 } })) == ""
fn named_in_order(argument: ast.NamedArgument, parameter: ast.Parameter) -> Result<(), refusal.TypeError> {
    if argument.name.text == parameter.name.text {
        return Ok(())
    }
    let start = argument.name.span.start
    Err(refusal.TypeError { kind: refusal.Misnamed { written: argument.name.text, parameter: parameter.name.text }, span: lexer.Span { start: start, length: argument.value.span.start + argument.value.span.length - start } })
}

// example: typed_code("fn count(held: Int, more: String) -> Int {\n    count(held, more)\n}\n") == ""
fn settle_positional(inference: Inference) -> Result<Inference, refusal.TypeError> {
    for call in inference.positional {
        _ = held_apart(call.function, takes_of(inference, call.function), call.at)?
    }
    Ok(inference { positional: [] })
}

// example: list.length(takes_of(nothing_inferred(), no_name())) == 0
fn takes_of(inference: Inference, function: ast.Name) -> List<unify.Type> {
    let signature = scheme_at(inference, declared.at_key(function.span.start)).body
    if !unify.is_function(signature) {
        return []
    }
    var taken = []
    for one in unify.parameters_of(signature) {
        taken = list.push(taken, unify.solved(inference.table, one))
    }
    taken
}

// example: refusal.code_given(held_apart(no_name(), [unify.int(), unify.int()], lexer.Span { start: 1, length: 2 })) == "L0409 1..3"
fn held_apart(function: ast.Name, taken: List<unify.Type>, at: lexer.Span) -> Result<(), refusal.TypeError> {
    var before = []
    for one in taken {
        if list.has_value(before, one) {
            return Err(refusal.TypeError { kind: refusal.Unnamed { function: function.text, repeated: one }, span: at })
        }
        before = list.push(before, one)
    }
    Ok(())
}

// example: typed_code("fn count(held) -> Int {\n    _ = held.size\n    1\n}\n") == "L0402 37..41"
fn look_up_fields(inference: Inference) -> Result<Inference, refusal.TypeError> {
    var walking = inference { lookups: [] }
    for lookup in inference.lookups {
        walking = look_up(walking, lookup)?
    }
    Ok(walking)
}

// example: typed_code("fn count(held: Int) -> Int {\n    held.size\n}\n") == "L0402 38..42"
fn look_up(inference: Inference, lookup: Lookup) -> Result<Inference, refusal.TypeError> {
    let through = unify.solved(inference.table, lookup.through)
    match through {
        unify.Named { name } => record_looked_up(inference, name, through, lookup)
        unify.Module(module) => inside(inference, module, lookup)
        _ => Err(unreachable_field(through, lookup.field))
    }
}

// example: typed_code("fn count(held: Box) -> Int {\n    held.size\n}\n\ntype Box = {\n    count: Int\n}\n") == "L0402 38..42"
fn record_looked_up(inference: Inference, named: String, through: unify.Type, lookup: Lookup) -> Result<Inference, refusal.TypeError> {
    match map.get(inference.environment.records, named) {
        Some(key) => field_of_record(inference, key, through, lookup)
        None => Err(unreachable_field(through, lookup.field))
    }
}

// example: typed_code("fn count(held: Box) -> Int {\n    held.count\n}\n\ntype Box = {\n    count: String\n}\n") == "L0400 27..45"
fn field_of_record(inference: Inference, key: String, through: unify.Type, lookup: Lookup) -> Result<Inference, refusal.TypeError> {
    let labels = or(map.get(inference.environment.labels, key), [])
    let made = unify.at_one_use(inference.table, scheme_at(inference, key))
    if !unify.is_function(made.found) {
        return Err(unreachable_field(through, lookup.field))
    }
    let built = unify.result_of(made.found)
    let met = expect(inference: inference { table: made.table }, expected: through, found: built, at: lookup.field.span)?
    let index = labelled(labels, lookup.field, unify.solved(met.table, built))?
    expect(inference: met, expected: lookup.found, found: or(list.at(unify.parameters_of(made.found), index), unify.Unit), at: lookup.field.span)
}

// example: refusal.code_given(Err(unreachable_field(unify.Var(0), no_name()))) == "L0402 0..0"
fn unreachable_field(through: unify.Type, field: ast.Name) -> refusal.TypeError {
    if unify.is_var(through) {
        return refusal.TypeError { kind: refusal.UnknownReceiver(field.text), span: field.span }
    }
    refusal.TypeError { kind: refusal.UnknownField { of: through, field: field.text }, span: field.span }
}

// example: typed_code("import demo\n\nfn count() -> Int {\n    demo.total\n}\n") == "L0414 42..47"
fn inside(inference: Inference, module: String, lookup: Lookup) -> Result<Inference, refusal.TypeError> {
    _ = declared.value_reachable(inference.environment, module, lookup.field)?
    let offering = or(surface.surface_of(inference.imported, module), surface.no_surface())
    let spawnable = map.get(offering.processes, lookup.field.text)
    match lookup.how {
        AsASpawn => process_inside(inference, spawnable, Reaching { module: module, field: lookup.field }, lookup)
        _ => match offered_inside(inference, offering, module, lookup.field) {
            Some(reached) => found_inside(reached, module, lookup)
            None => Err(refusal.TypeError { kind: unoffered(spawnable, module, lookup.field), span: lookup.field.span })
        }
    }
}

// example: refusal.code_of(unoffered(None, "demo", no_name())) == "L0414"
// example: refusal.code_of(unoffered(Some(surface.Plain(unify.monomorphic(unify.int()))), "demo", no_name())) == "L0801"
fn unoffered(spawnable: Option<surface.Offered>, module: String, field: ast.Name) -> refusal.TypeErrorKind {
    match spawnable {
        Some(_) => refusal.ProcessNotSpawned(module + "." + field.text)
        None => refusal.NotInModule { module: module, name: field.text }
    }
}

// example: refusal.code_given(process_inside(nothing_inferred(), None, Reaching { module: "demo", field: no_name() }, Lookup { through: unify.Unit, field: no_name(), found: unify.Unit, how: AsASpawn })) == "L0800 0..0"
fn process_inside(inference: Inference, spawnable: Option<surface.Offered>, reaching: Reaching, lookup: Lookup) -> Result<Inference, refusal.TypeError> {
    match spawnable {
        Some(offered) => found_inside(offered_use(inference, offered, reaching), reaching.module, lookup)
        None => Err(refusal.TypeError { kind: refusal.SpawnsNoProcess(reaching.module + "." + reaching.field.text), span: lookup.field.span })
    }
}

// example: typed_code("import demo\n\nfn count() -> Int {\n    demo.total()\n}\n") == "L0414 42..47"
fn found_inside(reached: Typed, module: String, lookup: Lookup) -> Result<Inference, refusal.TypeError> {
    if is_a_value(lookup.how) && unify.is_function(reached.found) {
        return Err(refusal.TypeError { kind: refusal.NotCalled { module: module, name: lookup.field.text }, span: lookup.field.span })
    }
    expect(inference: reached.inference, expected: lookup.found, found: reached.found, at: lookup.field.span)
}

// example: is_a_value(AsAValue)
fn is_a_value(how: ReachedAs) -> Bool {
    match how {
        AsACall => false
        AsASpawn => false
        AsAValue => true
    }
}

// example: !is_reached(offered_inside(nothing_inferred(), surface.no_surface(), "demo", no_name()))
fn offered_inside(inference: Inference, reached: surface.Reached, module: String, field: ast.Name) -> Option<Typed> {
    match map.get(reached.functions, field.text) {
        Some(offered) => Some(offered_use(inference, offered, Reaching { module: module, field: field }))
        None => built_inside(inference, module, field)
    }
}

// The module that declares a generic writes it, so inference asks its constraints for that module.
// example: offered_use(nothing_inferred(), surface.Plain(unify.monomorphic(unify.int())), Reaching { module: "demo", field: no_name() }).found == unify.int()
fn offered_use(inference: Inference, offered: surface.Offered, reaching: Reaching) -> Typed {
    let scheme = surface.scheme_offered(offered)
    let made = unify.at_one_use(inference.table, scheme)
    if !surface.is_generic(offered) {
        return Typed { inference: asking(inference { table: made.table }, made.required, reaching.field.span, ByConstraint), found: made.found }
    }
    let how = ByAnotherModule { module: reaching.module, name: reaching.field.text }
    let asked = asking(inference { table: made.table }, made.required, reaching.field.span, how)
    let reached = map.insert(asked.generics_reached, span_key(reaching.field.span), generic_use(scheme, made.given))
    Typed { inference: asked { generics_reached: reached }, found: made.found }
}

// Inference erases each stand-in that it made, because the other module writes the method
// over its declared type parameters only.
// example: generic_use(unify.monomorphic(unify.int()), []).written_as == unify.int()
fn generic_use(scheme: unify.Scheme, given: List<unify.Given>) -> GenericUse {
    var settled = []
    var constrained = []
    var erasing = []
    for one in given {
        settled = with_written(settled, one)
        constrained = with_constraints(scheme: scheme, one: one, constrained: constrained)
        erasing = list.push(erasing, erased(one))
    }
    GenericUse { settled: settled, constrained: constrained, written_as: unify.replaced(scheme.body, erasing) }
}

// example: with_written([], unify.Given { one: unify.Generalised(0), at: unify.int() }) == []
fn with_written(settled: List<unify.Type>, one: unify.Given) -> List<unify.Type> {
    match one.one {
        unify.Generalised(_) => settled
        unify.Written(_) => list.push(settled, one.at)
    }
}

// example: with_constraints(scheme: unify.monomorphic(unify.int()), one: unify.Given { one: unify.Generalised(0), at: unify.int() }, constrained: []) == []
fn with_constraints(scheme: unify.Scheme, one: unify.Given, constrained: List<List<String>>) -> List<List<String>> {
    match one.one {
        unify.Generalised(_) => constrained
        unify.Written(parameter) => list.push(constrained, constraints_on(scheme, parameter))
    }
}

// example: erased(unify.Given { one: unify.Generalised(0), at: unify.int() }).at == unify.Parameter(unify.prelude_parameter("_"))
fn erased(one: unify.Given) -> unify.Given {
    match one.one {
        unify.Generalised(_) => one { at: unify.Parameter(unify.prelude_parameter("_")) }
        unify.Written(_) => one
    }
}

// example: constraints_on(unify.monomorphic(unify.int()), unify.prelude_parameter("T")) == []
fn constraints_on(scheme: unify.Scheme, parameter: unify.TypeParameter) -> List<String> {
    var traits = []
    for required in scheme.required {
        if required.at == unify.Parameter(parameter) {
            traits = list.push(traits, required.trait_name)
        }
    }
    traits
}

// example: !is_reached(built_inside(nothing_inferred(), "demo", no_name()))
fn built_inside(inference: Inference, module: String, field: ast.Name) -> Option<Typed> {
    match map.get(inference.environment.values, module + "." + field.text) {
        Some(scheme) => Some(instantiated(inference, scheme))
        None => None
    }
}

// example: found_after(held_after(Ok(nothing_inferred()), unify.int())) == unify.int()
fn held_after(walked: Result<Inference, refusal.TypeError>, found: unify.Type) -> Result<Typed, refusal.TypeError> {
    let left = walked?
    Ok(Typed { inference: left, found: found })
}

// example: refusal.code_given(every_field_given(ast.Path { module: None, name: no_name() }, [], ["count"], lexer.Span { start: 1, length: 2 })) == "L0404 1..3"
fn every_field_given(base: ast.Path, fields: List<ast.FieldValue>, labels: List<String>, at: lexer.Span) -> Result<(), refusal.TypeError> {
    var given = []
    for field in fields {
        given = list.push(given, field.name.text)
    }
    for label in labels {
        if !list.has_value(given, label) {
            return Err(refusal.TypeError { kind: refusal.MissingField { of: ast.path_text(base), field: label }, span: at })
        }
    }
    Ok(())
}

// example: refusal.code_given(build_without_fields(unify.int(), [])) == ""
fn build_without_fields(built: unify.Type, fields: List<ast.FieldValue>) -> Result<unify.Type, refusal.TypeError> {
    match list.at(fields, 0) {
        Some(field) => Err(refusal.TypeError { kind: refusal.UnknownField { of: built, field: field.name.text }, span: field.name.span })
        None => Ok(built)
    }
}

// example: refusal.code_given(written_once(ast.Path { module: None, name: no_name() }, [])) == ""
fn written_once(base: ast.Path, fields: List<ast.FieldValue>) -> Result<(), refusal.TypeError> {
    var given = []
    for field in fields {
        if list.has_value(given, field.name.text) {
            return Err(refusal.TypeError { kind: refusal.FieldWrittenTwice { of: ast.path_text(base), field: field.name.text }, span: field.name.span })
        }
        given = list.push(given, field.name.text)
    }
    Ok(())
}

// example: refusal.code_given(Err(built_without_labels(ast.Path { module: None, name: no_name() }, [], 1, unify.int()))) == "L0401 0..0"
fn built_without_labels(base: ast.Path, fields: List<ast.FieldValue>, carries: Int, built: unify.Type) -> refusal.TypeError {
    match list.at(fields, 0) {
        Some(field) => refusal.TypeError { kind: refusal.UnknownField { of: built, field: field.name.text }, span: field.name.span }
        None => miscounted(named: base.name, takes: carries, given: 0)
    }
}

// example: typed_code("fn count(held: Int) -> Int {\n    match held {\n        \"one\" => 1\n        _ => 2\n    }\n}\n") == "L0400 54..59"
fn pattern_walked(inference: Inference, pattern: ast.Pattern, expected: unify.Type) -> Result<Inference, refusal.TypeError> {
    match pattern.kind {
        ast.NamePattern(path) => bare_pattern(inference, path, expected)
        ast.TuplePattern { path, elements } => tuple_pattern(inference, TupleWritten { path: path, elements: elements }, expected)
        ast.RecordPattern { path, fields } => record_pattern(inference, RecordWritten { path: path, fields: fields }, expected)
        ast.IntegerPattern(number) => number_pattern(inference, number, expected, pattern.span)
        ast.TextPattern(_) => literal_pattern(inference, Matched { written: unify.text_type(), expected: expected }, pattern.span)
        ast.TruthPattern(_) => literal_pattern(inference, Matched { written: unify.truth(), expected: expected }, pattern.span)
        ast.Wildcard => Ok(inference)
        ast.OrPattern(alternatives) => any_of(inference, alternatives, expected)
    }
}

// example: typed_code("fn count(held: Int) -> Int {\n    match held {\n        1 | \"two\" => 1\n        _ => 2\n    }\n}\n") == "L0400 58..63"
fn any_of(inference: Inference, alternatives: List<ast.Pattern>, expected: unify.Type) -> Result<Inference, refusal.TypeError> {
    var walking = inference
    for alternative in alternatives {
        walking = pattern_walked(walking, alternative, expected)?
    }
    Ok(walking)
}

// example: typed_code("fn count(held: Option<Int>) -> Int {\n    match held {\n        Some(_, _) => 1\n        _ => 2\n    }\n}\n") == "L0401 62..66"
fn tuple_pattern(inference: Inference, written: TupleWritten, expected: unify.Type) -> Result<Inference, refusal.TypeError> {
    let named = written.path.name
    let built = built_by(inference, written.path)?
    if !unify.is_function(built.found) {
        return Err(miscounted(named: named, takes: 0, given: list.length(written.elements)))
    }
    let taken = unify.parameters_of(built.found)
    if list.length(taken) != list.length(written.elements) {
        return Err(miscounted(named: named, takes: list.length(taken), given: list.length(written.elements)))
    }
    var walking = expect(inference: built.inference, expected: expected, found: unify.result_of(built.found), at: named.span)?
    var index = 0
    for element in written.elements {
        walking = pattern_walked(walking, element, or(list.at(taken, index), unify.Unit))?
        index += 1
    }
    Ok(walking)
}

// example: typed_code("fn count(held: Int) -> Int {\n    match held {\n        1 => 1\n        _ => 2\n    }\n}\n") == ""
fn number_pattern(inference: Inference, number: Int, expected: unify.Type, at: lexer.Span) -> Result<Inference, refusal.TypeError> {
    let written = literal(inference, number, at)
    literal_pattern(written.inference, Matched { written: written.found, expected: expected }, at)
}

// example: list.length(literal(nothing_inferred(), 5, lexer.Span { start: 0, length: 1 }).inference.literals) == 1
fn literal(inference: Inference, number: Int, written: lexer.Span) -> Typed {
    let made = unify.whole_number(inference.table)
    Typed { inference: inference { table: made.table, literals: list.push(inference.literals, Literal { number: number, at: made.made, span: written }) }, found: made.made }
}

// example: typed_code("fn count(held: Box) -> Int {\n    match held {\n        1 => 1\n        _ => 2\n    }\n}\n\ntype Box = Box\n") == "L0400 54..55"
fn literal_pattern(inference: Inference, matched: Matched, at: lexer.Span) -> Result<Inference, refusal.TypeError> {
    let met = expect(inference: inference, expected: matched.expected, found: matched.written, at: at)?
    Ok(typed_at(asking(met, [unify.Required { trait_name: "Eq", at: matched.expected }], at, ByConstraint), at, matched.expected))
}

// example: typed_code("fn count(held: Option<Int>) -> Int {\n    match held {\n        None => 1\n        other => or(other, 2)\n    }\n}\n") == ""
fn bare_pattern(inference: Inference, path: ast.Path, expected: unify.Type) -> Result<Inference, refusal.TypeError> {
    if !is_built(inference, path) {
        return Ok(introduce(inference, path.name, unify.monomorphic(expected)))
    }
    let built = built_by(inference, path)?
    expect(inference: built.inference, expected: expected, found: built.found, at: path.name.span)
}

// example: !is_built(nothing_inferred(), ast.Path { module: None, name: no_name() })
fn is_built(inference: Inference, base: ast.Path) -> Bool {
    match base.module {
        Some(_) => true
        None => declared.definition_of(inference.resolved, resolver.ValueNamespace, base.name).kind == resolver.Constructor
    }
}

// A variant that carries its values in order has no field to name,
// so the pattern `Some {}` is refused as the expression `Some {}` is.
// example: typed_code("fn count(held: Box) -> Int {\n    match held {\n        Box { size } => size\n    }\n}\n\ntype Box = {\n    count: Int\n}\n") == "L0402 60..64"
// example: typed_code("fn f(held: Option<Int>) -> Int {\n    match held {\n        Some {} => 1\n        None => 0\n    }\n}\n") == "L0401 58..62"
fn record_pattern(inference: Inference, written: RecordWritten, expected: unify.Type) -> Result<Inference, refusal.TypeError> {
    let named = written.path.name
    let built = built_by(inference, written.path)?
    let labels = or(map.get(built.inference.environment.labels, built.key), [])
    if !unify.is_function(built.found) {
        return carrying_nothing(built, written, expected)
    }
    let taken = unify.parameters_of(built.found)
    let made = unify.result_of(built.found)
    if list.length(labels) != list.length(taken) && list.length(written.fields) == 0 {
        return Err(miscounted(named: named, takes: list.length(taken), given: 0))
    }
    var walking = expect(inference: built.inference, expected: expected, found: made, at: named.span)?
    for field in written.fields {
        let index = labelled(labels, field, made)?
        walking = introduce(walking, field, unify.monomorphic(or(list.at(taken, index), unify.Unit)))
    }
    Ok(walking)
}

// example: typed_code("fn f(held: Shape) -> Int {\n    match held {\n        Dot {} => 1\n    }\n}\n\ntype Shape =\n    | Dot\n") == ""
fn carrying_nothing(built: BuiltUse, written: RecordWritten, expected: unify.Type) -> Result<Inference, refusal.TypeError> {
    if list.length(written.fields) > 0 {
        return Err(miscounted(named: written.path.name, takes: 0, given: list.length(written.fields)))
    }
    expect(inference: built.inference, expected: expected, found: built.found, at: written.path.name.span)
}

// example: refusal.code_given(Err(miscounted(named: no_name(), takes: 1, given: 2))) == "L0401 0..0"
fn miscounted(named: ast.Name, takes: Int, given: Int) -> refusal.TypeError {
    refusal.TypeError { kind: refusal.WrongArgumentCount(refusal.Count { name: named.text, takes: takes, given: given }), span: named.span }
}

// example: ok_or(labelled(["count", "size"], ast.Name { text: "size", span: lexer.Span { start: 0, length: 4 } }, unify.Unit), 9) == 1
fn labelled(labels: List<String>, field: ast.Name, of: unify.Type) -> Result<Int, refusal.TypeError> {
    match list.index_of(labels, field.text) {
        Some(index) => Ok(index)
        None => Err(refusal.TypeError { kind: refusal.UnknownField { of: of, field: field.text }, span: field.span })
    }
}

// example: refusal.code_given(built_by(nothing_inferred(), ast.Path { module: Some(no_name()), name: no_name() })) == "L0414 0..0"
fn built_by(inference: Inference, path: ast.Path) -> Result<BuiltUse, refusal.TypeError> {
    match path.module {
        Some(module) => reached_constructor(inference, module, path)
        None => Ok(bare_constructor(inference, path.name))
    }
}

// example: bare_constructor(nothing_inferred(), no_name()).key == ""
fn bare_constructor(inference: Inference, named: ast.Name) -> BuiltUse {
    let found = value_of_name(inference, named)
    BuiltUse { inference: found.inference, key: key_of_name(inference, named), found: found.found }
}

// example: refusal.code_given(reached_constructor(nothing_inferred(), no_name(), ast.Path { module: None, name: no_name() })) == "L0414 0..0"
fn reached_constructor(inference: Inference, module: ast.Name, path: ast.Path) -> Result<BuiltUse, refusal.TypeError> {
    _ = declared.value_reachable(inference.environment, module.text, path.name)?
    let key = ast.path_text(path)
    match map.get(inference.environment.values, key) {
        Some(scheme) => Ok(built_use(instantiated(inference, scheme), key))
        None => Err(refusal.TypeError { kind: refusal.NotInModule { module: module.text, name: path.name.text }, span: path.name.span })
    }
}

// example: instantiated(nothing_inferred(), unify.monomorphic(unify.int())).found == unify.int()
fn instantiated(inference: Inference, scheme: unify.Scheme) -> Typed {
    let made = unify.at_one_use(inference.table, scheme)
    Typed { inference: inference { table: made.table }, found: made.found }
}

// example: built_use(instantiated(nothing_inferred(), unify.monomorphic(unify.int())), "demo.Box").key == "demo.Box"
fn built_use(used: Typed, key: String) -> BuiltUse {
    BuiltUse { inference: used.inference, key: key, found: used.found }
}

// A `?` that nothing settled propagates a `Result`.
// example: typed_code("fn count(held) {\n    _ = held?\n}\n") == "L0400 25..30"
fn settle_propagations(inference: Inference) -> Result<Inference, refusal.TypeError> {
    var walking = inference { propagations: [] }
    for waiting in inference.propagations {
        walking = propagate(walking, waiting, or(propagates(walking, waiting.found), Failure))?
    }
    Ok(walking)
}

// example: !is_propagating(propagates(nothing_inferred(), unify.int()))
fn propagates(inference: Inference, found: unify.Type) -> Option<Propagated> {
    match kind_of(unify.solved(inference.table, inference.result)) {
        Some(kind) => Some(kind)
        None => kind_of(unify.solved(inference.table, found))
    }
}

// example: is_propagating(kind_of(unify.option_of(unify.int())))
fn kind_of(settled: unify.Type) -> Option<Propagated> {
    match settled {
        unify.Named { name } => kind_named(name)
        _ => None
    }
}

// example: !is_propagating(kind_named("Int"))
fn kind_named(named: String) -> Option<Propagated> {
    if named == "Option" {
        return Some(Absence)
    }
    if named == "Result" {
        return Some(Failure)
    }
    None
}

// example: typed_code("fn count(held: Result<Int, String>) -> Option<Int> {\n    held?\n}\n") == "L0400 57..61"
fn propagate(inference: Inference, waiting: Propagation, kind: Propagated) -> Result<Inference, refusal.TypeError> {
    let sides = match kind {
        Absence => absence_sides(inference, waiting.held)
        Failure => failure_sides(inference, waiting.held)
    }
    let met = expect(inference: sides.inference, expected: sides.written_on, found: waiting.found, at: waiting.inner)?
    expect(inference: met, expected: met.result, found: sides.given_back, at: waiting.at)
}

// example: absence_sides(nothing_inferred(), unify.int()).written_on == unify.option_of(unify.int())
fn absence_sides(inference: Inference, held: unify.Type) -> PropagatedSides {
    let made = fresh(inference)
    PropagatedSides { inference: made.inference, written_on: unify.option_of(held), given_back: unify.option_of(made.found) }
}

// example: unify.text_of(failure_sides(nothing_inferred(), unify.int()).written_on) == "Result<Int, _>"
fn failure_sides(inference: Inference, held: unify.Type) -> PropagatedSides {
    let failed = fresh(inference)
    let other = fresh(failed.inference)
    PropagatedSides { inference: other.inference, written_on: unify.result_type(held, failed.found), given_back: unify.result_type(other.found, failed.found) }
}

// example: typed_code("fn count() -> Int {\n    300\n}\n") == "L0420 24..27"
fn settle_literals(inference: Inference) -> Result<Inference, refusal.TypeError> {
    var walking = inference { literals: [] }
    for written in inference.literals {
        walking = settle_literal(walking, written)?
    }
    Ok(walking)
}

// example: typed_code("fn count() -> Int {\n    255\n}\n") == ""
fn settle_literal(inference: Inference, written: Literal) -> Result<Inference, refusal.TypeError> {
    var walking = inference
    if unify.is_var(unify.shallow(walking.table, written.at)) {
        walking = expect(inference: walking, expected: unify.int(), found: written.at, at: written.span)?
    }
    let at = unify.solved(walking.table, written.at)
    match map.get(walking.environment.holds, named_of(at)) {
        Some(bounds) => fits(walking, written, at, bounds)
        None => Ok(walking)
    }
}

// A type with arguments holds the bounds of its name, whatever the arguments are.
// example: named_of(unify.list_of(unify.int())) == "List"
// example: named_of(unify.Unit) == ""
fn named_of(at: unify.Type) -> String {
    match at {
        unify.Named { name } => name
        _ => ""
    }
}

// example: refusal.code_given(fits(nothing_inferred(), Literal { number: 3, at: unify.int(), span: lexer.Span { start: 0, length: 1 } }, unify.int(), surface.Bounds { least: 0, most: 2 })) == "L0420 0..1"
fn fits(inference: Inference, written: Literal, at: unify.Type, bounds: surface.Bounds) -> Result<Inference, refusal.TypeError> {
    if bounds.least <= written.number && written.number <= bounds.most {
        return Ok(inference)
    }
    Err(refusal.TypeError { kind: refusal.LiteralDoesNotFit { value: written.number, at: at, least: bounds.least, most: bounds.most }, span: written.span })
}

// An operator that is still not typed here is over `Int`, the one default that the language keeps.
// example: typed_code("fn count(held) -> Int {\n    _ = held + held\n    1\n}\n") == ""
fn settle_operators(inference: Inference) -> Result<Inference, refusal.TypeError> {
    var walking = inference { operated: [] }
    for operated in inference.operated {
        if unify.is_var(unify.shallow(walking.table, operated.at)) {
            walking = expect(inference: walking, expected: unify.int(), found: operated.at, at: operated.written)?
        }
        walking = asking(walking, [unify.Required { trait_name: operated.of, at: operated.at }], operated.written, ByOperator(operated.written_as))
    }
    Ok(walking)
}

// example: typed_code("fn is_same(one: String, other: String) -> Bool {\n    one == other\n}\n") == "L0406 53..65"
fn settle_requirements(inference: Inference) -> Result<Inference, refusal.TypeError> {
    var methods = inference.methods
    for requirement in inference.requirements {
        _ = requirement_answered(inference, requirement)?
        if is_by_method(requirement.how) {
            methods = map.insert(methods, span_key(requirement.written), unify.solved(inference.table, requirement.required.at))
        }
    }
    Ok(inference { requirements: [], methods: methods })
}

// example: is_by_method(ByMethod)
fn is_by_method(how: Asked) -> Bool {
    match how {
        ByMethod => true
        _ => false
    }
}

// example: typed_code("fn is_same(one: Int, other: Int) -> Bool {\n    one == other\n}\n") == ""
fn requirement_answered(inference: Inference, requirement: Requirement) -> Result<(), refusal.TypeError> {
    let at = unify.solved(inference.table, requirement.required.at)
    let of = requirement.required.trait_name
    _ = left_behind_by(inference, requirement.how, of, requirement.written)?
    if declared.is_answered(inference.environment, of, at, inference.promised) {
        return Ok(())
    }
    Err(unanswered(requirement, at))
}

// example: refusal.code_given(left_behind_by(nothing_inferred(), ByAnotherModule { module: "demo", name: "total" }, "Sized", lexer.Span { start: 1, length: 2 })) == "L0424 1..3"
fn left_behind_by(inference: Inference, how: Asked, of: String, written: lexer.Span) -> Result<(), refusal.TypeError> {
    match how {
        ByAnotherModule { module, name } => trait_reached(inference, refusal.TraitStaysInItsModule { module: module, name: name, of: of }, of, written)
        _ => Ok(())
    }
}

// example: refusal.code_given(trait_reached(nothing_inferred(), refusal.DivisorIsZero, "Eq", lexer.Span { start: 1, length: 2 })) == ""
fn trait_reached(inference: Inference, kind: refusal.TypeErrorKind, of: String, written: lexer.Span) -> Result<(), refusal.TypeError> {
    if set.has_value(inference.environment.traits, of) {
        return Ok(())
    }
    Err(refusal.TypeError { kind: kind, span: written })
}

// example: refusal.code_given(Err(unanswered(Requirement { required: unify.Required { trait_name: "Eq", at: unify.Unit }, written: lexer.Span { start: 1, length: 2 }, how: ByMethod }, unify.Unit))) == "L0418 1..3"
fn unanswered(requirement: Requirement, at: unify.Type) -> refusal.TypeError {
    let of = requirement.required.trait_name
    let kind = match requirement.how {
        ByOperator(written_as) => refusal.NoOperator { written_as: written_as, of: of, at: at }
        _ => refusal.NoInstance { of: of, at: at }
    }
    refusal.TypeError { kind: kind, span: requirement.written }
}

// A statement that inference did not settle takes `()`, so `todo("not yet")` can be a statement.
// example: typed_code("fn count() -> Int {\n    todo(\"not yet\")\n    1\n}\n") == ""
fn settle_discards(inference: Inference) -> Result<Inference, refusal.TypeError> {
    var walking = inference { discards: [] }
    for discard in inference.discards {
        walking = settle_discard(walking, discard)?
    }
    Ok(walking)
}

// example: typed_code("fn count() -> Int {\n    \"one\"\n    1\n}\n") == "L0408 24..29"
fn settle_discard(inference: Inference, discard: Discard) -> Result<Inference, refusal.TypeError> {
    let settled = unify.shallow(inference.table, discard.found)
    if unify.is_var(settled) {
        return expect(inference: inference, expected: unify.Unit, found: discard.found, at: discard.at)
    }
    let solved = unify.solved(inference.table, settled)
    if solved == unify.Unit {
        return Ok(inference)
    }
    Err(refusal.TypeError { kind: refusal.Discarded(solved), span: discard.at })
}

// An instance method has no parameters to answer for, because its trait wrote them.
// example: typed_code("fn count(whole: Bool) -> Int {\n    _ = whole\n    1\n}\n") == "L0412 9..20"
fn settle_parameters(inference: Inference, function: ast.FunctionDeclaration, taken: List<unify.Type>) -> Result<Inference, refusal.TypeError> {
    match map.get(inference.environment.written_as, declared.at_key(function.name.span.start)) {
        Some(_) => Ok(inference)
        None => flags_settled(inference, function, taken)
    }
}

// example: typed_code("fn is_both(one: Bool, other: Bool) -> Bool {\n    one && other\n}\n") == ""
fn flags_settled(inference: Inference, function: ast.FunctionDeclaration, taken: List<unify.Type>) -> Result<Inference, refusal.TypeError> {
    var solved = []
    for one in taken {
        solved = list.push(solved, unify.solved(inference.table, one))
    }
    _ = flags_refused(solved, unify.solved(inference.table, inference.result), function.parameters, function.name)?
    Ok(inference)
}

// example: refusal.code_given(flags_refused([unify.truth()], unify.int(), [], no_name())) == ""
fn flags_refused(taken: List<unify.Type>, gives: unify.Type, parameters: List<ast.Parameter>, named: ast.Name) -> Result<(), refusal.TypeError> {
    if is_a_boolean_operation(taken, gives) {
        return Ok(())
    }
    var index = 0
    for parameter in parameters {
        if or(list.at(taken, index), unify.Unit) == unify.truth() {
            return Err(refusal.TypeError { kind: refusal.FlagParameter(named.text), span: parameter.span })
        }
        index += 1
    }
    Ok(())
}

// example: is_a_boolean_operation([unify.truth()], unify.truth())
fn is_a_boolean_operation(taken: List<unify.Type>, gives: unify.Type) -> Bool {
    if gives != unify.truth() {
        return false
    }
    for one in taken {
        if one != unify.truth() {
            return false
        }
    }
    true
}

// example: refusal.code_given(named_for(ast.Name { text: "size", span: lexer.Span { start: 1, length: 4 } }, unify.truth())) == "L0413 1..5"
fn named_for(named: ast.Name, found: unify.Type) -> Result<(), refusal.TypeError> {
    if found != unify.truth() || is_a_question(named.text) {
        return Ok(())
    }
    Err(refusal.TypeError { kind: refusal.NotAPredicate(named.text), span: named.span })
}

// example: is_a_question("has_value")
// example: !is_a_question("value")
fn is_a_question(named: String) -> Bool {
    for opener in ["is_", "has_", "can_", "should_"] {
        if or(strings.cut(named, 0, strings.length(opener)), "") == opener {
            return true
        }
    }
    false
}

// example: list.length(operating(nothing_inferred(), Operated { of: "Neg", written_as: "-", at: unify.int(), written: lexer.Span { start: 0, length: 1 } }).operated) == 1
fn operating(inference: Inference, operated: Operated) -> Inference {
    inference { operated: list.push(inference.operated, operated) }
}

// example: list.length(looking(nothing_inferred(), Lookup { through: unify.Unit, field: no_name(), found: unify.Unit, how: AsAValue }).lookups) == 1
fn looking(inference: Inference, lookup: Lookup) -> Inference {
    inference { lookups: list.push(inference.lookups, lookup) }
}

// example: list.length(propagating(nothing_inferred(), Propagation { found: unify.Unit, held: unify.Unit, inner: lexer.Span { start: 0, length: 1 }, at: lexer.Span { start: 0, length: 2 } }).propagations) == 1
fn propagating(inference: Inference, waiting: Propagation) -> Inference {
    inference { propagations: list.push(inference.propagations, waiting) }
}

// example: refusal.code_given(expect(inference: nothing_inferred(), expected: unify.int(), found: unify.truth(), at: lexer.Span { start: 1, length: 2 })) == "L0400 1..3"
fn expect(inference: Inference, expected: unify.Type, found: unify.Type, at: lexer.Span) -> Result<Inference, refusal.TypeError> {
    match unify.unify(inference.table, expected, found) {
        Ok(table) => Ok(inference { table: table })
        Err(clash) => Err(clashed(clash, Met { expected: expected, found: found }, at))
    }
}

// example: refusal.code_given(Err(clashed(unify.Infinite, Met { expected: unify.Unit, found: unify.Unit }, lexer.Span { start: 1, length: 2 }))) == "L0403 1..3"
fn clashed(clash: unify.Clash, met: Met, at: lexer.Span) -> refusal.TypeError {
    match clash {
        unify.Mismatch(table) => refusal.TypeError { kind: refusal.Mismatched { expected: unify.read(table, met.expected), found: unify.read(table, met.found) }, span: at }
        unify.Infinite => refusal.TypeError { kind: refusal.InfiniteType, span: at }
    }
}

// example: fresh(nothing_inferred()).found == unify.Var(0)
fn fresh(inference: Inference) -> Typed {
    let made = unify.fresh(inference.table)
    Typed { inference: inference { table: made.table }, found: made.made }
}

// example: list.length(introduce(nothing_inferred(), no_name(), unify.monomorphic(unify.int())).introduced) == 1
fn introduce(inference: Inference, named: ast.Name, scheme: unify.Scheme) -> Inference {
    let key = declared.at_key(named.span.start)
    typed_at(inference { environment: declared.bound(inference.environment, key, scheme), introduced: list.push(inference.introduced, key) }, named.span, scheme.body)
}

// example: typed_code("fn is_same(one: Int, other: Int) -> Bool {\n    is_equal(one, other)\n}\n") == ""
fn value_of_name(inference: Inference, named: ast.Name) -> Typed {
    let key = key_of_name(inference, named)
    let made = unify.at_one_use(inference.table, scheme_at(inference, key))
    let how = match map.get(inference.environment.methods, key) {
        Some(_) => ByMethod
        None => ByConstraint
    }
    Typed { inference: asking(inference { table: made.table }, made.required, named.span, how), found: made.found }
}

// example: list.length(asking(nothing_inferred(), [], lexer.Span { start: 0, length: 0 }, ByConstraint).requirements) == 0
fn asking(inference: Inference, required: List<unify.Required>, written: lexer.Span, how: Asked) -> Inference {
    var requirements = inference.requirements
    for one in required {
        requirements = list.push(requirements, Requirement { required: one, written: written, how: how })
    }
    inference { requirements: requirements }
}

// example: key_of_name(nothing_inferred(), no_name()) == ""
fn key_of_name(inference: Inference, named: ast.Name) -> String {
    declared.key_of(inference.environment, declared.definition_of(inference.resolved, resolver.ValueNamespace, named), named)
}

// example: generalise(nothing_inferred(), "none").table.made == 0
fn generalise(inference: Inference, key: String) -> Inference {
    match map.get(inference.environment.values, key) {
        Some(shell) => inference { environment: declared.bound(inference.environment, key, generalised_shell(inference, shell, key)) }
        None => inference
    }
}

// example: generalised_shell(nothing_inferred(), unify.monomorphic(unify.Var(0)), "none").quantified == [unify.Generalised(0)]
fn generalised_shell(inference: Inference, shell: unify.Scheme, key: String) -> unify.Scheme {
    let body = unify.solved(inference.table, shell.body)
    var quantified = shell.quantified
    for variable in free_in(inference, body, key) {
        quantified = list.push(quantified, unify.Generalised(variable))
    }
    unify.Scheme { quantified: quantified, body: body, required: shell.required }
}

// example: generalised(nothing_inferred(), unify.int()).quantified == []
fn generalised(inference: Inference, bound: unify.Type) -> unify.Scheme {
    let body = unify.solved(inference.table, bound)
    var quantified = []
    for variable in free_in(inference, body, "") {
        quantified = list.push(quantified, unify.Generalised(variable))
    }
    unify.Scheme { quantified: quantified, body: body, required: [] }
}

// The function under `leaving` is the one to generalise, so it holds no variable of its own here.
// example: free_in(nothing_inferred(), unify.Var(3), "") == [3]
fn free_in(inference: Inference, body: unify.Type, leaving: String) -> List<Int> {
    let free = unify.unsettled(inference.table, body, [])
    if list.length(free) == 0 {
        return free
    }
    let held = held_elsewhere(inference, leaving)
    var kept = []
    for variable in free {
        if !list.has_value(held, variable) {
            kept = list.push(kept, variable)
        }
    }
    kept
}

// example: held_elsewhere(nothing_inferred(), "") == []
fn held_elsewhere(inference: Inference, leaving: String) -> List<Int> {
    let table = inference.table
    var held = []
    for key in inference.functions {
        if key != leaving {
            held = unify.unsettled(table, scheme_at(inference, key).body, held)
        }
    }
    for key in inference.introduced {
        held = unify.unsettled(table, scheme_at(inference, key).body, held)
    }
    for lookup in inference.lookups {
        held = unify.unsettled(table, lookup.found, unify.unsettled(table, lookup.through, held))
    }
    for operated in inference.operated {
        held = unify.unsettled(table, operated.at, held)
    }
    for requirement in inference.requirements {
        held = unify.unsettled(table, requirement.required.at, held)
    }
    for written in inference.literals {
        held = unify.unsettled(table, written.at, held)
    }
    held
}

// Every phase before inference makes sure that a scheme is at `key`.
// example: scheme_at(nothing_inferred(), "none").body == unify.Unit
fn scheme_at(inference: Inference, key: String) -> unify.Scheme {
    or(map.get(inference.environment.values, key), unify.monomorphic(unify.Unit))
}

// example: code_of_error(refusal.TypeError { kind: refusal.DivisorIsZero, span: lexer.Span { start: 1, length: 2 } }) == "L0407 1..3"
fn code_of_error(refused: refusal.TypeError) -> String {
    refusal.code_of(refused.kind) + " " + shown(refused.span)
}

// example: or(type_at(typed_at(nothing_inferred(), no_name().span, unify.int()), no_name().span), unify.Unit) == unify.int()
fn typed_at(inference: Inference, span: lexer.Span, found: unify.Type) -> Inference {
    inference { types: map.insert(inference.types, span_key(span), found) }
}

// example: or(type_at(nothing_inferred(), no_name().span), unify.int()) == unify.int()
fn type_at(inference: Inference, span: lexer.Span) -> Option<unify.Type> {
    match map.get(inference.types, span_key(span)) {
        Some(found) => Some(unify.solved(inference.table, found))
        None => None
    }
}

// example: or(method_type_at(nothing_inferred(), no_name().span), unify.int()) == unify.int()
fn method_type_at(inference: Inference, span: lexer.Span) -> Option<unify.Type> {
    map.get(inference.methods, span_key(span))
}

// example: list.length(or(generic_at(nothing_inferred(), no_name().span), GenericUse { settled: [], constrained: [], written_as: unify.Unit }).settled) == 0
fn generic_at(inference: Inference, span: lexer.Span) -> Option<GenericUse> {
    match map.get(inference.generics_reached, span_key(span)) {
        Some(reaching) => Some(reaching { settled: each_solved(inference.table, reaching.settled), written_as: unify.solved(inference.table, reaching.written_as) })
        None => None
    }
}

// example: each_solved(unify.empty_table(), [unify.int()]) == [unify.int()]
fn each_solved(table: unify.Table, types: List<unify.Type>) -> List<unify.Type> {
    var solved = []
    for one in types {
        solved = list.push(solved, unify.solved(table, one))
    }
    solved
}

// No source file that this compiler reads is a mebibyte long, so no two spans share a number.
// example: span_key(lexer.Span { start: 1, length: 2 }) == 1048578
fn span_key(span: lexer.Span) -> Int {
    span.start * 1048576 + span.length
}

type Typed = {
    inference: Inference
    found: unify.Type
}

type Operands = {
    left: ast.Expr
    right: ast.Expr
    at: lexer.Span
}

type Sides = {
    left: unify.Type
    right: unify.Type
    operator: ast.BinaryOperator
}

type Asking = {
    of: String
    written_as: String
}

type PropagatedSides = {
    inference: Inference
    written_on: unify.Type
    given_back: unify.Type
}

type Calling = {
    callee: ast.Expr
    reached: ast.Name
    at: lexer.Span
}

type Moved = {
    receiver: ast.Expr
    called: ast.Name
    arguments: ast.Arguments
}

type Applied = {
    called: unify.Type
    given: List<unify.Type>
    takes: Int
}

type Reaching = {
    module: String
    field: ast.Name
}

type BuiltUse = {
    inference: Inference
    key: String
    found: unify.Type
}

type Inference = {
    resolved: resolver.Resolved
    imported: surface.Imported
    environment: declared.Environment
    table: unify.Table
    named: map.Map<Int, unify.Type>
    result: unify.Type
    introduced: List<String>
    operated: List<Operated>
    literals: List<Literal>
    discards: List<Discard>
    lookups: List<Lookup>
    propagations: List<Propagation>
    requirements: List<Requirement>
    promised: List<unify.Required>
    positional: List<Positional>
    functions: List<String>
    types: map.Map<Int, unify.Type>
    methods: map.Map<Int, unify.Type>
    generics_reached: map.Map<Int, GenericUse>
}

type GenericUse = {
    settled: List<unify.Type>
    constrained: List<List<String>>
    written_as: unify.Type
}

type Operated = {
    of: String
    written_as: String
    at: unify.Type
    written: lexer.Span
}

type Literal = {
    number: Int
    at: unify.Type
    span: lexer.Span
}

type Discard = {
    found: unify.Type
    at: lexer.Span
}

type Lookup = {
    through: unify.Type
    field: ast.Name
    found: unify.Type
    how: ReachedAs
}

type Propagation = {
    found: unify.Type
    held: unify.Type
    inner: lexer.Span
    at: lexer.Span
}

type Requirement = {
    required: unify.Required
    written: lexer.Span
    how: Asked
}

type Positional = {
    function: ast.Name
    at: lexer.Span
}

type TupleWritten = {
    path: ast.Path
    elements: List<ast.Pattern>
}

type RecordWritten = {
    path: ast.Path
    fields: List<ast.Name>
}

type Matched = {
    written: unify.Type
    expected: unify.Type
}

type Met = {
    expected: unify.Type
    found: unify.Type
}

type Branched = {
    found: unify.Type
    span: lexer.Span
}

type Asked =
    | ByMethod
    | ByConstraint
    | ByOperator(String)
    | ByAnotherModule {
        module: String
        name: String
    }

type ReachedAs =
    | AsACall
    | AsASpawn
    | AsAValue

type Propagated =
    | Absence
    | Failure

type BlockGives =
    | GivesItsValue
    | GivesNothing
