#!/bin/sh
set -e

# `.cargo/config.toml` sets `-D warnings` for every cargo call in this repo, so the commands below
# share one set of compiled artifacts with ordinary development builds.

# Formatting is a compile error in Lumen; the compiler's own tree holds itself to the same bar.
cargo fmt --all --check

# clippy --all-targets compile-checks every target (lib, bin, tests) with warnings denied, so it is
# the single gate for compile errors and lints.
cargo clippy --all-targets -- -D warnings

cargo nextest run

# Dependency-advisory gate. Policy lives in `.cargo/audit.toml`: offline against the cached
# advisory database, vulnerabilities block, informational warnings are surfaced only.
cargo audit

mycs_fail() {
    echo "mycs check failed. Fix the violation; never suppress it without a reason beside it."
    exit 1
}

# Gate staged content (what this commit records), then sweep the whole working tree so a
# blocking finding anywhere the walk reads refuses the commit. Nothing is grandfathered.
mycs check --staged || mycs_fail
mycs check || mycs_fail
