#!/bin/sh
set -e

# The seed builds the compiler, and the compiler builds itself again: stage 2 must be stage 1 byte
# for byte. `docs/specs/run.md` states the bootstrap.
bin/bootstrap

# The runner holds the compiler to every example, every example line, every drawn property, and
# the command line. `docs/implementation.md` section 7 states it. It ends with status 0 only when
# nothing failed.
bin/runner

mycs_fail() {
    echo "mycs check failed. Fix the violation; never suppress it without a reason beside it."
    exit 1
}

# Gate staged content (what this commit records), then sweep the whole working tree so a
# blocking finding anywhere the walk reads refuses the commit. Nothing is grandfathered.
mycs check --staged || mycs_fail
mycs check || mycs_fail
