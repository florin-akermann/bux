#!/bin/sh
set -e

# The seed builds the compiler, and the compiler builds itself again: stage 2 must be stage 1 byte
# for byte. `docs/specs/run.md` states the bootstrap.
bin/bootstrap

# The tests of `tests/` hold the compiler to every example, every example line, every drawn
# property, and the command line. `docs/implementation.md` section 7 states them. The run ends
# with status 0 only when nothing failed.
bin/bux test tests

mycs_fail() {
    echo "mycs check failed. Fix the violation; never suppress it without a reason beside it."
    exit 1
}

# Gate staged content (what this commit records), then sweep the whole working tree so a
# blocking finding anywhere the walk reads refuses the commit. Nothing is grandfathered.
# mycs is optional: the sweep runs where it is installed, and the commit proceeds where it is not.
if command -v mycs >/dev/null 2>&1; then
    mycs check --staged || mycs_fail
    mycs check || mycs_fail
else
    echo "mycs is not installed, so the commit proceeds without its sweep" >&2
fi
