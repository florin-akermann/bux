// The files the runner reads, the copies it works in, and the programs it starts in a copy.
//
// `docs/implementation.md` section 7 states the runner. A walk is in the order names sort, so two
// runs report the same failures in the same order.
import command

import files

import list

import modules

import strings

/// Every file under `directory` whose name ends in `ending`, at any depth, in the order names sort.
// example: list.length(every_file(directory: "no-such-directory", ending: ".lm")) == 0
fn every_file(directory: String, ending: String) -> List<String> {
    var found = []
    for name in ok_or(files.listed(directory), []) {
        path := modules.joined(directory, name)
        if command.is_folder(command.place_at(path)) {
            for below in every_file(directory: path, ending: ending) {
                found = list.push(found, below)
            }
        } else if is_ending_in(text: name, ending: ending) {
            found = list.push(found, path)
        }
    }
    found
}

/// Every file directly in `directory` whose name ends in `ending`, in the order names sort.
// example: list.length(files_in(directory: "no-such-directory", ending: ".lm")) == 0
fn files_in(directory: String, ending: String) -> List<String> {
    var found = []
    for name in ok_or(files.listed(directory), []) {
        path := modules.joined(directory, name)
        if is_ending_in(text: name, ending: ending) && !command.is_folder(command.place_at(path)) {
            found = list.push(found, path)
        }
    }
    found
}

/// `path` with the extension after its last dot put in place of `extension`.
// example: sibling(path: "a/b.lm", extension: "tokens") == "a/b.tokens"
fn sibling(path: String, extension: String) -> String {
    dot := command.last_dot(path)
    if dot < 0 {
        return path + "." + extension
    }
    or(strings.cut(path, 0, dot + 1), "") + extension
}

/// Whether `text` ends with `ending`.
// example: is_ending_in(text: "a.lm", ending: ".lm")
// example: !is_ending_in(text: "a.lmx", ending: ".lm")
fn is_ending_in(text: String, ending: String) -> Bool {
    from := strings.length(text) - strings.length(ending)
    from >= 0 && or(strings.cut(text, from, strings.length(text)), "") == ending
}

/// Every line of `text`, each without its line break, the empty ones kept.
// example: list.length(lines_of("a\n\nb\n")) == 3
fn lines_of(text: String) -> List<String> {
    var lines = []
    var start = 0
    var index = 0
    for index < strings.length(text) {
        if or(strings.at(text, index), 0) == 10 {
            lines = list.push(lines, or(strings.cut(text, start, index), ""))
            start = index + 1
        }
        index += 1
    }
    if start < strings.length(text) {
        lines = list.push(lines, or(strings.cut(text, start, strings.length(text)), ""))
    }
    lines
}

/// Starts `line` in `directory` with no input, and gives back what it wrote and its status.
///
/// What the program writes goes into two files of the directory, so a program writing much on one
/// stream never waits on a reader of the other.
// example: or(ended(line: ["no-such-program-at-all"], directory: "no-such-directory"), Ended { output: "", errors: "", status: 7 }).status == 7
fn ended(line: List<String>, directory: String) -> Option<Ended> {
    output := modules.joined(directory, ".output")
    errors := modules.joined(directory, ".errors")
    starting := errors_to(output_to(input_from(within(starter(line), place(directory)), place("/dev/null")), place(output)), place(errors))
    match started(starting) {
        Ok(running) => Some(read_after(status: ok_or(waited(running), -1), output: output, errors: errors))
        Err(_) => None
    }
}

/// What a program that ended with `status` wrote into the files `output` and `errors` name.
///
/// The status is taken first, because a program has written all it writes only once it has ended.
// example: read_after(status: 3, output: "no-such-directory/a", errors: "no-such-directory/b").status == 3
fn read_after(status: Int, output: String, errors: String) -> Ended {
    Ended { output: ok_or(files.read(output), ""), errors: ok_or(files.read(errors), ""), status: status }
}

/// A builder of the program `line` names, given every word after the first.
extern new starter(line: List<String>) -> Starter

/// The same builder, starting the program in `directory`.
extern method within(builder: Starter, directory: Place) -> Starter = "directory"

/// The same builder, with the program reading `file` as its standard input.
extern method input_from(builder: Starter, file: Place) -> Starter = "redirectInput"

/// The same builder, with the program writing its standard output into `file`.
extern method output_to(builder: Starter, file: Place) -> Starter = "redirectOutput"

/// The same builder, with the program writing its standard error into `file`.
extern method errors_to(builder: Starter, file: Place) -> Starter = "redirectError"

/// The program started, or why it could not be.
extern method started(builder: Starter) -> Result<Running, String> = "start"

/// The status the program ends with, once it has ended.
extern method int waited(running: Running) -> Result<Int, String> = "waitFor"

/// The file or directory `path` names.
extern new place(path: String) -> Place

/// What a started program wrote on each stream, and the status it ended with.
type Ended = {
    output: String
    errors: String
    status: Int
}

/// A program to start, with where it starts and what it reads and writes.
extern type Starter = "java.lang.ProcessBuilder"

/// A program that was started.
extern type Running = "java.lang.Process"

/// A place in the file system, named rather than opened.
extern type Place = "java.io.File"
