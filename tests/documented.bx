// Every `// example:` line of every module, each module's run written as `bux test <file>` writes
// it, and every run started in one JVM.
//
// `docs/specs/doc-examples.md` states what an example line is and what running one amounts to.
// The modules are those under `tests/spec`, `library/`, `compiler/`, and `tests/` itself. An example
// under `tests/spec` that its header says is refused cannot be run, so its lines are not either.
// `docs/implementation.md` section 7 states how the runs share one memo of typed modules, and how
// `examined.bx` starts each run in turn.
import command
import files
import header
import held
import ir
import jvm
import list
import modules
import programs
import strings
import walk

/// Every example line of every module `paths` names, each module typed once, in one JVM.
// example: every_line_held(paths: ["no-such-directory/a.bx"], library: ir.little_library(), memo: command.no_memo(), limit: 1).cases == 0
fn every_line_held(paths: List<String>, library: ir.Library, memo: command.Memo, limit: Int) -> held.Held {
    match command.somewhere_of_its_own() {
        Ok(directory) => held_within(paths, Setting { library: library, limit: limit, directory: directory }, memo)
        Err(said) => with_failures(held.nothing_failed(0), reported(errors: said.errors, path: entry_path()))
    }
}

/// Every example line of every module `paths` names, the classes of each run written into the
/// directory `setting` names, which is removed after the runs.
// example: with_failures(held.nothing_failed(1), ["a.bx: error: gone"]).failures == ["a.bx: error: gone"]
fn held_within(paths: List<String>, setting: Setting, memo: command.Memo) -> held.Held {
    staging := every_run_staged(paths, setting, memo)
    found := held.added(staging.found, runs_held(staging, setting))
    command.removed_whole(setting.directory)
    found
}

/// Every module the runner tests: those under `spec` at any depth, and those directly in each of
/// `directories`, which are the library, the compiler, and the runner.
// example: list.length(modules_of(spec: "no-such-directory", directories: ["no-such-directory"])) == 0
fn modules_of(spec: String, directories: List<String>) -> List<String> {
    var found = walk.every_file(spec, ".bx")
    for directory in directories {
        for path in walk.files_in(directory, ".bx") {
            found = list.push(found, path)
        }
    }
    found
}

/// The run of every module of `paths` that states example lines, each written into a directory of
/// its own, with the lines counted and every module that has no run reported.
// example: list.length(every_run_staged(["no-such-directory/a.bx"], Setting { library: ir.little_library(), limit: 1, directory: "no-such-directory" }, command.no_memo()).runs) == 0
fn every_run_staged(paths: List<String>, setting: Setting, memo: command.Memo) -> Staging {
    var staging = Staging { found: held.nothing_failed(0), runs: [], memo: memo }
    var number = 0
    for path in paths {
        beside := modules.joined(setting.directory, shown(number))
        staging = staged_one(staging, Place { path: path, beside: beside }, setting.library)
        number += 1
    }
    staging
}

/// `staging` with the module `place.path` names: its lines counted, and its run or its failures.
// example: staged_one(Staging { found: held.nothing_failed(0), runs: [], memo: command.no_memo() }, Place { path: "no-such-directory/a.bx", beside: "no-such-directory/0" }, ir.little_library()).found.cases == 0
fn staged_one(staging: Staging, place: Place, library: ir.Library) -> Staging {
    source := ok_or(files.read(place.path), "")
    count := lines_stated(source)
    if count == 0 || is_refused(header.expectation_of(source)) {
        return staging
    }
    why := why_skipped(place.path)
    if why != "" {
        return staging { found: held.added(staging.found, held.with_skip(held.nothing_failed(0), place.path + ": " + why)) }
    }
    readied := module_readied(place, Typing { library: library, memo: staging.memo })
    match readied.found {
        Ok(staged) => Staging { found: held.added(staging.found, held.nothing_failed(count)), runs: list.push(staging.runs, staged), memo: readied.memo }
        Err(failures) => Staging { found: held.added(staging.found, with_failures(held.nothing_failed(count), failures)), runs: staging.runs, memo: readied.memo }
    }
}

/// Why the examples of the module at `path` are not run, and `""` where they are.
///
/// Each reason is a limit of `bux test` itself, which the same command shows for that module.
// example: why_skipped("a.bx") == ""
fn why_skipped(path: String) -> String {
    if path == "library/prelude.bx" {
        return "the run of its examples declares `or` beside the prelude's own, which `bux test` refuses as L0302"
    }
    ""
}

/// The run of the module `place.path` names, its classes written into `place.beside`, or what
/// `bux test` would report of it.
// example: failed_as(command.not_compiled_said(command.Unusable("error: gone\n"), command.AsPage), "a.bx") == ["a.bx: error: gone"]
fn module_readied(place: Place, typing: Typing) -> Readied {
    checked := command.checked_once(place.path, typing.library, typing.memo)
    match checked.found {
        Ok(program) => run_readied(program.root, place.beside, typing { memo: checked.memo })
        Err(not) => Readied { found: Err(reported(errors: command.not_compiled_said(not, command.AsPage).errors, path: place.path)), memo: checked.memo }
    }
}

/// The run of the examples `root` states, its classes written into `beside`, or why there is none.
// example: failed_as(command.Said { output: "", errors: "error: gone\n", status: 2 }, "a.bx") == ["a.bx: error: gone"]
fn run_readied(root: command.Typed, beside: String, typing: Typing) -> Readied {
    path := root.module.path
    match command.stated_in(root) {
        Ok(Some(run)) => class_readied(Staged { path: path, run: run, root: root, beside: beside, class: "" }, typing)
        Ok(None) => Readied { found: Err([]), memo: typing.memo }
        Err(refusals) => Readied { found: Err(failed_as(command.refused_each(refusals, command.page_of(root)), path)), memo: typing.memo }
    }
}

/// `staged` with the class its module is named by, lowered and written, or why it cannot be.
// example: failed_as(command.Said { output: "", errors: "", status: 0 }, "a.bx") == []
fn class_readied(staged: Staged, typing: Typing) -> Readied {
    match command.named_module(staged.path) {
        Ok(class) => lowered_readied(staged { class: class }, typing)
        Err(said) => Readied { found: Err(failed_as(said, staged.path)), memo: typing.memo }
    }
}

/// The run `staged` holds, lowered with the modules `typing.memo` holds, and its classes written.
// example: failed_as(command.Said { output: "", errors: "error: a\nerror: b\n", status: 1 }, "a.bx") == ["a.bx: error: a", "a.bx: error: b"]
fn lowered_readied(staged: Staged, typing: Typing) -> Readied {
    classes := command.run_classes_once(staged.run, staged.root, typing.library, typing.memo)
    Readied { found: written_staged(classes.found, staged), memo: classes.memo }
}

/// `staged`, once the classes `found` holds are written into its directory, or its failures.
// example: failed_as(command.Said { output: "", errors: "error: gone\n", status: 2 }, "b.bx") == ["b.bx: error: gone"]
fn written_staged(found: Result<List<jvm.ClassFile>, command.NotCompiled>, staged: Staged) -> Result<Staged, List<String>> {
    match found {
        Ok(classes) => written_as(command.classes_written(classes, staged.beside), staged)
        Err(not) => Err(failed_as(command.run_refused(not, staged.run, staged.root), staged.path))
    }
}

/// `staged` where its classes were written, and what went wrong where they were not.
// example: failed_as(command.Said { output: "", errors: "error: x: no room\n", status: 2 }, "c.bx") == ["c.bx: error: x: no room"]
fn written_as(written: Result<(), command.Said>, staged: Staged) -> Result<Staged, List<String>> {
    match written {
        Ok(_) => Ok(staged)
        Err(said) => Err(failed_as(said, staged.path))
    }
}

/// Every run of `staging`, started through the entry program, and every example that failed.
// example: runs_held(Staging { found: held.nothing_failed(0), runs: [], memo: command.no_memo() }, Setting { library: ir.little_library(), limit: 1, directory: "no-such-directory" }).failures == []
fn runs_held(staging: Staging, setting: Setting) -> held.Held {
    if list.length(staging.runs) == 0 {
        return held.nothing_failed(0)
    }
    match entry_line(staging.memo, setting) {
        Ok(line) => every_run_held(staging.runs, line, setting)
        Err(failures) => with_failures(held.nothing_failed(0), failures)
    }
}

/// The command line that starts the entry program, once its classes are written, or why not.
///
/// Its classes go into a directory of their own, so none of them is on the path of any run.
// example: entry_path() == "tests/examined.bx"
fn entry_line(memo: command.Memo, setting: Setting) -> Result<List<String>, List<String>> {
    java := failing(command.java_found(), entry_path())?
    beside := modules.joined(setting.directory, "entry")
    checked := command.checked_once(entry_path(), setting.library, memo)
    program := refused_as(checked.found, entry_path())?
    classes := refused_as(command.classes_once(program, setting.library, checked.memo).found, entry_path())?
    _ = failing(command.classes_written(classes, beside), entry_path())?
    Ok([java, "--enable-preview", "-cp", beside, "examined"])
}

/// Every run of `runs` started through the entry program that `line` starts, and every failure.
///
/// A run past the limit of `setting` is reported, and the entry program starts again with the
/// runs after it, so one run that never ends does not stop the others.
// example: every_run_held([], ["no-such-program-at-all"], Setting { library: ir.little_library(), limit: 1, directory: "no-such-directory" }).failures == []
fn every_run_held(runs: List<Staged>, line: List<String>, setting: Setting) -> held.Held {
    var found = held.nothing_failed(0)
    var rest = runs
    for list.length(rest) > 0 {
        ran := entry_ran(rest, line, setting)
        found = with_failures(found, ran.failures)
        rest = ran.rest
    }
    found
}

/// The entry program started once over `runs`: what failed, and the runs it did not reach.
// example: arguments_of(line: ["java"], runs: []) == ["java"]
fn entry_ran(runs: List<Staged>, line: List<String>, setting: Setting) -> Ran {
    match walk.completed(arguments_of(line: line, runs: runs), setting.directory, setting.limit) {
        Ok(completion) => ended_read(runs, Outcome { output: completion.output, why: why_ended(completion.status) })
        Err(walk.NotStarted) => Ran { failures: each_failed(runs, "error: the JVM that runs the examples could not be started"), rest: [] }
        Err(walk.PastLimit(limit, output)) => ended_read(runs, Outcome { output: output, why: "error: the run of its examples did not end within " + shown(limit) + " s, and was stopped" })
    }
}

/// `line`, followed by the directory and the class of each of `runs`.
// example: arguments_of(line: ["java", "examined"], runs: []) == ["java", "examined"]
fn arguments_of(line: List<String>, runs: List<Staged>) -> List<String> {
    var found = line
    for staged in runs {
        found = list.push(list.push(found, staged.beside), staged.class)
    }
    found
}

/// What stopped the entry program where it ended with `status`, and `""` where nothing did.
// example: why_ended(0) == ""
// example: why_ended(1) == "error: the JVM that runs the examples ended with status 1"
fn why_ended(status: Int) -> String {
    if status == 0 {
        return ""
    }
    "error: the JVM that runs the examples ended with status " + shown(status)
}

/// What the entry program wrote, read for each run it opened, and the runs it did not open.
///
/// The last run it opened is the one `outcome.why` names, where the entry program was stopped.
// example: segments_of("bux: run 0\na\nbux: run 1\n") == ["a\n", ""]
fn ended_read(runs: List<Staged>, outcome: Outcome) -> Ran {
    segments := segments_of(outcome.output)
    opened := list.length(segments)
    if opened == 0 {
        return Ran { failures: each_failed(runs, never_opened(outcome.why)), rest: [] }
    }
    var failures = []
    var rest = []
    var number = 0
    for staged in runs {
        if number >= opened {
            rest = list.push(rest, staged)
        } else if number == opened - 1 && outcome.why != "" {
            failures = held.both(failures, reported(errors: outcome.why + "\n", path: staged.path))
        } else {
            failures = held.both(failures, segment_read(or(list.at(segments, number), ""), staged))
        }
        number += 1
    }
    Ran { failures: failures, rest: rest }
}

/// Why no run was opened: what `why` says, or that the entry program opened none.
// example: never_opened("") == "error: the JVM that runs the examples ran none of them"
// example: never_opened("error: gone") == "error: gone"
fn never_opened(why: String) -> String {
    if why == "" {
        return "error: the JVM that runs the examples ran none of them"
    }
    why
}

/// The line `why` gives, said about each of `runs`.
// example: each_failed([], "error: gone") == []
fn each_failed(runs: List<Staged>, why: String) -> List<String> {
    var failures = []
    for staged in runs {
        failures = held.both(failures, reported(errors: why + "\n", path: staged.path))
    }
    failures
}

/// What one run wrote, read as `bux test` reads it, with a line for each example that failed.
// example: stopped_in("bux: stopped java.lang.StackOverflowError\n") == "java.lang.StackOverflowError"
fn segment_read(segment: String, staged: Staged) -> List<String> {
    stopped := stopped_in(segment)
    var finished = programs.Finished { code: 0, output: segment, errors: "" }
    if stopped != "" {
        finished = programs.Finished { code: 1, output: "", errors: "error: the run of its examples stopped: " + stopped + "\n" }
    }
    failed_as(command.finished_read(finished, staged.run, staged.root), staged.path)
}

/// What the entry program wrote, cut into what each run wrote, in the order it opened them.
// example: segments_of("") == []
// example: segments_of("bux: run 0\nbux: example 2\n") == ["bux: example 2\n"]
fn segments_of(output: String) -> List<String> {
    var segments = []
    var current = ""
    var is_open = false
    for line in walk.lines_of(output) {
        if command.has_prefix(line, "bux: run ") {
            if is_open {
                segments = list.push(segments, current)
            }
            current = ""
            is_open = true
        } else {
            current = current + line + "\n"
        }
    }
    if is_open {
        segments = list.push(segments, current)
    }
    segments
}

/// What stopped a run, as the entry program wrote it after the run, and `""` where nothing did.
// example: stopped_in("bux: example 1\n") == ""
fn stopped_in(segment: String) -> String {
    marker := "bux: stopped "
    for line in walk.lines_of(segment) {
        if command.has_prefix(line, marker) {
            return or(strings.cut(line, strings.length(marker), strings.length(line)), "")
        }
    }
    ""
}

/// The module the runner starts every run through.
// example: entry_path() == "tests/examined.bx"
fn entry_path() -> String {
    "tests/examined.bx"
}

/// The value `answer` holds, or a line for each refusal of the module at `path`.
// example: ok_or(refused_as(Ok(1), "a.bx"), 0) == 1
fn refused_as<T>(answer: Result<T, command.NotCompiled>, path: String) -> Result<T, List<String>> {
    match answer {
        Ok(value) => Ok(value)
        Err(not) => Err(reported(errors: command.not_compiled_said(not, command.AsPage).errors, path: path))
    }
}

/// The value `answer` holds, or a line for each error it says about the module at `path`.
// example: ok_or(failing(Ok(1), "a.bx"), 0) == 1
fn failing<T>(answer: Result<T, command.Said>, path: String) -> Result<T, List<String>> {
    match answer {
        Ok(value) => Ok(value)
        Err(said) => Err(failed_as(said, path))
    }
}

/// A line for each error `said` holds about the module at `path`.
// example: failed_as(command.Said { output: "", errors: "error: gone\n", status: 2 }, "a.bx") == ["a.bx: error: gone"]
fn failed_as(said: command.Said, path: String) -> List<String> {
    reported(errors: said.errors, path: path)
}

/// `found` with each of `failures` after its own.
// example: with_failures(held.nothing_failed(0), []).failures == []
fn with_failures(found: held.Held, failures: List<String>) -> held.Held {
    var kept = found
    for failure in failures {
        kept = held.with_failure(kept, failure)
    }
    kept
}

/// Whether an example says the compiler refuses it, which leaves nothing to run.
// example: is_refused(header.Refused("L0100"))
// example: !is_refused(header.Compiles)
fn is_refused(expectation: header.Expectation) -> Bool {
    match expectation {
        header.Refused(_) => true
        header.Misstated(_) => true
        _ => false
    }
}

/// How many example lines `source` states: comment lines whose text opens with `example:`.
// example: lines_stated("/// a\n// example: f() == 1\n    // example: g()\n") == 2
fn lines_stated(source: String) -> Int {
    var count = 0
    for line in walk.lines_of(source) {
        if is_an_example_line(command.trimmed_start(line)) {
            count += 1
        }
    }
    count
}

/// Whether `line` is a comment of one run of slashes whose text opens with `example:`.
// example: is_an_example_line("/// example: f()")
// example: !is_an_example_line("// an example: f()")
fn is_an_example_line(line: String) -> Bool {
    var index = 0
    for or(strings.at(line, index), 0) == 47 {
        index += 1
    }
    index >= 2 && command.has_prefix(or(strings.cut(line, index, strings.length(line)), ""), " example:")
}

/// One line for each refusal `errors` holds, naming where it points and what it says.
///
/// A refusal is its `error` line and, where it points somewhere, the `-->` line under it. One that
/// points nowhere is reported against `path`.
// example: reported(errors: "error[L0603]: the example of `f` does not hold\n  --> a.bx:3:1\n", path: "a.bx") == ["a.bx:3:1: error[L0603]: the example of `f` does not hold"]
// example: reported(errors: "error: gone\n", path: "a.bx") == ["a.bx: error: gone"]
fn reported(errors: String, path: String) -> List<String> {
    var lines = []
    var message = ""
    for line in walk.lines_of(errors) {
        pointed := command.trimmed_start(line)
        if command.has_prefix(line, "error") {
            lines = with_message(lines: lines, at: path, message: message)
            message = line
        } else if command.has_prefix(pointed, "--> ") && message != "" {
            lines = with_message(lines: lines, at: or(strings.cut(pointed, 4, strings.length(pointed)), path), message: message)
            message = ""
        }
    }
    with_message(lines: lines, at: path, message: message)
}

/// `lines` with `message` after them, said about `at`, where there is a message.
// example: with_message(lines: [], at: "a.bx", message: "") == []
fn with_message(lines: List<String>, at: String, message: String) -> List<String> {
    if message == "" {
        return lines
    }
    list.push(lines, at + ": " + message)
}

/// What the runs found so far: the lines counted and failed, each run staged, and the memo.
type Staging = {
    found: held.Held
    runs: List<Staged>
    memo: command.Memo
}

/// One module's run, staged, or a line for each failure that leaves it with none, and the memo.
type Readied = {
    found: Result<Staged, List<String>>
    memo: command.Memo
}

/// What one start of the entry program found, and the runs it did not reach.
type Ran = {
    failures: List<String>
    rest: List<Staged>
}

/// The run of one module: the module, its run, where its classes are, and the class it starts at.
type Staged = {
    path: String
    run: command.Run
    root: command.Typed
    beside: String
    class: String
}

/// A module to stage: its path, and the directory its run's classes go into.
type Place = {
    path: String
    beside: String
}

/// What every run shares: the library, the limit of a start, and the directory made for the runs.
type Setting = {
    library: ir.Library
    limit: Int
    directory: String
}

/// What a module is typed with: the library, and the modules typed already.
type Typing = {
    library: ir.Library
    memo: command.Memo
}

/// What the entry program wrote, and what stopped it, which is `""` where nothing did.
type Outcome = {
    output: String
    why: String
}
