// Every `// example:` line and every test of every module, each module's run written as
// `bux test <file>` writes it, and every run started in a JVM of its own.
//
// `docs/specs/doc-examples.md` states what an example line is and what running one amounts to, and
// `docs/specs/testing.md` states a test. The modules are those under `tests/spec` and `library/`,
// because `bin/bux test` runs those of `src/` and of `tests/` itself. An example under
// `tests/spec` that its header says is refused cannot be run, so its lines are not either.
// The tests of an example under `tests/spec` are left out, because a golden answer of `bux test`
// holds what is said of them.
// `docs/implementation.md` section 7 states how the runs share one memo of typed modules, and how
// each run starts as `bux test` starts it.
import ast
import checking
import command
import files
import header
import held
import ir
import jvm
import list
import modules
import parser
import programs
import strings
import walk

/// Every module whose example lines a test runs, one list for each place: those directly in each
/// of `directories`, then those under `spec` at any depth.
// example: list.length(module_groups(spec: "no-such-directory", directories: ["no-such-directory"])) == 2
fn module_groups(spec: String, directories: List<String>) -> List<List<String>> {
    var groups = []
    for directory in directories {
        groups = list.push(groups, walk.files_in(directory, ".bx"))
    }
    list.push(groups, walk.every_file(spec, ".bx"))
}

// example: is_every_line_held([])
fn is_every_line_held(paths: List<String>) -> Bool {
    held.is_held_reported(held.together(every_line_held(paths: paths, library: checking.carried_library(), memo: command.no_memo(), limit: walk.start_limit())))
}

/// Every example line and every test of every module `paths` names, each module typed once, each
/// run in a JVM of its own: what the example lines held, then how many tests there were.
///
/// A test that did not hold is a failure of the first, because a run reports both kinds alike.
// example: list.length(every_line_held(paths: ["no-such-directory/a.bx"], library: ir.little_library(), memo: command.no_memo(), limit: 1)) == 2
fn every_line_held(paths: List<String>, library: ir.Library, memo: command.Memo, limit: Int) -> List<held.Held> {
    match command.somewhere_of_its_own() {
        Ok(directory) => held_within(paths, Setting { library: library, limit: limit, directory: directory }, memo)
        Err(said) => [with_failures(held.nothing_failed(0), reported(errors: said.errors, path: own_path())), held.nothing_failed(0)]
    }
}

/// Every example line and every test of every module `paths` names, the classes of each run
/// written into the directory `setting` names, which is removed after the runs.
// example: with_failures(held.nothing_failed(1), ["a.bx: error: gone"]).failures == ["a.bx: error: gone"]
fn held_within(paths: List<String>, setting: Setting, memo: command.Memo) -> List<held.Held> {
    let staging = every_run_staged(paths, setting, memo)
    let found = held.added(staging.found, runs_held(staging, setting.limit))
    command.removed_whole(setting.directory)
    [found, held.nothing_failed(staging.tests)]
}

/// The run of every module of `paths` that states example lines, each written into a directory of
/// its own, with the lines counted and every module that has no run reported.
// example: list.length(every_run_staged(["no-such-directory/a.bx"], Setting { library: ir.little_library(), limit: 1, directory: "no-such-directory" }, command.no_memo()).runs) == 0
fn every_run_staged(paths: List<String>, setting: Setting, memo: command.Memo) -> Staging {
    var staging = Staging { found: held.nothing_failed(0), tests: 0, runs: [], memo: memo }
    var number = 0
    for path in paths {
        let beside = modules.joined(setting.directory, shown(number))
        staging = staged_one(staging, Place { path: path, beside: beside }, setting.library)
        number += 1
    }
    staging
}

/// `staging` with the module `place.path` names: its lines and its tests counted, and its run or
/// its failures.
// example: staged_one(Staging { found: held.nothing_failed(0), tests: 0, runs: [], memo: command.no_memo() }, Place { path: "no-such-directory/a.bx", beside: "no-such-directory/0" }, ir.little_library()).found.cases == 0
fn staged_one(staging: Staging, place: Place, library: ir.Library) -> Staging {
    let source = ok_or(files.read(place.path), "")
    let count = lines_stated(source)
    let tests = list.length(tests_kept(place.path, ok_or(parser.parse(source), ast.Program { items: [] })))
    if count == 0 && tests == 0 || is_refused(header.expectation_of(source)) {
        return staging
    }
    let why = why_skipped(place.path)
    if why != "" {
        return staging { found: held.added(staging.found, held.with_skip(held.nothing_failed(0), place.path + ": " + why)) }
    }
    let readied = module_readied(place, Typing { library: library, memo: staging.memo })
    match readied.found {
        Ok(staged) => Staging { found: held.added(staging.found, held.nothing_failed(count)), tests: staging.tests + tests, runs: list.push(staging.runs, staged), memo: readied.memo }
        Err(failures) => Staging { found: held.added(staging.found, with_failures(held.nothing_failed(count), failures)), tests: staging.tests + tests, runs: staging.runs, memo: readied.memo }
    }
}

/// Why the examples of the module at `path` are not run, and `""` where they are.
///
/// Each reason is a limit of `bux test` itself, which the same command shows for that module.
// example: why_skipped("a.bx") == ""
fn why_skipped(path: String) -> String {
    if path == "library/prelude.bx" {
        return "the run of its examples declares `or` beside the prelude's own, which `bux test` refuses as L0302"
    }
    ""
}

/// The run of the module `place.path` names, its classes written into `place.beside`, or what
/// `bux test` would report of it.
// example: failed_as(command.not_compiled_said(command.Unusable("error: gone\n"), command.AsPage), "a.bx") == ["a.bx: error: gone"]
fn module_readied(place: Place, typing: Typing) -> Readied {
    let checked = command.checked_once(place.path, typing.library, typing.memo)
    match checked.found {
        Ok(program) => run_readied(program.root, place.beside, typing { memo: checked.memo })
        Err(not) => Readied { found: Err(reported(errors: command.not_compiled_said(not, command.AsPage).errors, path: place.path)), memo: checked.memo }
    }
}

/// The run of the examples and the tests `root` states, its classes written into `beside`, or why
/// there is none.
// example: failed_as(command.Said { output: "", errors: "error: gone\n", status: 2 }, "a.bx") == ["a.bx: error: gone"]
fn run_readied(root: command.Typed, beside: String, typing: Typing) -> Readied {
    let path = root.module.path
    match command.stated_in(root, tests_kept(path, root.inferred.resolved.program)) {
        Ok(Some(run)) => class_readied(Staged { path: path, run: run, root: root, beside: beside, class: "" }, typing)
        Ok(None) => Readied { found: Err([]), memo: typing.memo }
        Err(refusals) => Readied { found: Err(failed_as(command.refused_each(refusals, command.page_of(root)), path)), memo: typing.memo }
    }
}

/// The tests of `program`, the module at `path`, that a test here runs: every one, and none of an
/// example under `tests/spec`.
// example: list.length(tests_kept("tests/spec/testing/holds.bx", ok_or(parser.parse("test \"a\" {\n    true\n}\n"), ast.Program { items: [] }))) == 0
// example: list.length(tests_kept("tests/a.bx", ok_or(parser.parse("test \"a\" {\n    true\n}\n"), ast.Program { items: [] }))) == 1
fn tests_kept(path: String, program: ast.Program) -> List<ast.TestDeclaration> {
    if command.has_prefix(path, "tests/spec/") {
        return []
    }
    ast.tests_of(program)
}

/// `staged` with the class its module is named by, lowered and written, or why it cannot be.
// example: failed_as(command.Said { output: "", errors: "", status: 0 }, "a.bx") == []
fn class_readied(staged: Staged, typing: Typing) -> Readied {
    match command.named_module(staged.path) {
        Ok(class) => lowered_readied(staged { class: class }, typing)
        Err(said) => Readied { found: Err(failed_as(said, staged.path)), memo: typing.memo }
    }
}

/// The run `staged` holds, lowered with the modules `typing.memo` holds, and its classes written.
// example: failed_as(command.Said { output: "", errors: "error: a\nerror: b\n", status: 1 }, "a.bx") == ["a.bx: error: a", "a.bx: error: b"]
fn lowered_readied(staged: Staged, typing: Typing) -> Readied {
    let classes = command.run_classes_once(staged.run, staged.root, typing.library, typing.memo)
    Readied { found: written_staged(classes.found, staged), memo: classes.memo }
}

/// `staged`, once the classes `found` holds and the resources are written into its directory, as
/// `bux test` writes them, or its failures.
// example: failed_as(command.Said { output: "", errors: "error: gone\n", status: 2 }, "b.bx") == ["b.bx: error: gone"]
fn written_staged(found: Result<List<jvm.ClassFile>, command.NotCompiled>, staged: Staged) -> Result<Staged, List<String>> {
    match found {
        Ok(classes) => written_as(command.written_whole(classes, staged.beside), staged)
        Err(not) => Err(failed_as(command.run_refused(not, staged.run, staged.root), staged.path))
    }
}

/// `staged` where its classes were written, and what went wrong where they were not.
// example: failed_as(command.Said { output: "", errors: "error: x: no room\n", status: 2 }, "c.bx") == ["c.bx: error: x: no room"]
fn written_as(written: Result<(), command.Said>, staged: Staged) -> Result<Staged, List<String>> {
    match written {
        Ok(_) => Ok(staged)
        Err(said) => Err(failed_as(said, staged.path))
    }
}

/// Every run of `staging`, each started in a JVM of its own, and every example that failed.
// example: runs_held(Staging { found: held.nothing_failed(0), tests: 0, runs: [], memo: command.no_memo() }, 1).failures == []
fn runs_held(staging: Staging, limit: Int) -> held.Held {
    if list.length(staging.runs) == 0 {
        return held.nothing_failed(0)
    }
    match command.java_found() {
        Ok(java) => every_run_held(runs: staging.runs, java: java, limit: limit)
        Err(said) => with_failures(held.nothing_failed(0), failed_as(said, own_path()))
    }
}

/// Every run of `runs`, each started in turn by `java`, and every failure.
///
/// A run past `limit` is stopped and reported, so one run that never ends does not stop the others.
// example: every_run_held(runs: [], java: "no-such-java", limit: 1).failures == []
fn every_run_held(runs: List<Staged>, java: String, limit: Int) -> held.Held {
    var found = held.nothing_failed(0)
    for staged in runs {
        found = with_failures(found, run_held(staged: staged, java: java, limit: limit))
    }
    found
}

/// What the run `staged` found, started as `bux test` starts it, and a line for each failure.
///
/// The JVM starts in the directory of the test, so a run finds a file where `bux test` finds it.
/// What the JVM writes goes into the directory of the run, which no other run writes into.
// example: unended_line(walk.NotStarted) == "error: the run of its examples could not be started\n"
fn run_held(staged: Staged, java: String, limit: Int) -> List<String> {
    let line = command.examples_line(java, [staged.beside], staged.class)
    match walk.completed_from(line, ".", staged.beside, limit) {
        Ok(completion) => ended_read(programs.Finished { code: completion.status, output: completion.output, errors: completion.errors }, staged)
        Err(unended) => reported(errors: unended_line(unended), path: staged.path)
    }
}

/// The line that says why a run gave no status back.
// example: unended_line(walk.PastLimit(2, "")) == "error: the run of its examples did not end within 2 s, and was stopped\n"
fn unended_line(unended: walk.Unended) -> String {
    "error: " + walk.unended_said(unended, "the run of its examples") + "\n"
}

/// What one run wrote, read as `bux test` reads it, with a line for each example that failed.
///
/// A run that ended with a status other than 0 stopped before its end, which is a failure too.
// example: stopped_line(1) == "error: the run of its examples ended with status 1\n"
fn ended_read(finished: programs.Finished, staged: Staged) -> List<String> {
    let failures = failed_as(command.finished_read(finished, staged.run, staged.root).said, staged.path)
    if finished.code == 0 {
        return failures
    }
    held.both(reported(errors: stopped_line(finished.code), path: staged.path), failures)
}

/// The line that says a run ended with `status`, which is not 0.
// example: stopped_line(134) == "error: the run of its examples ended with status 134\n"
fn stopped_line(status: Int) -> String {
    "error: the run of its examples ended with status " + shown(status) + "\n"
}

/// The module that starts the runs, which a failure that belongs to no run names.
// example: own_path() == "tests/documented.bx"
fn own_path() -> String {
    "tests/documented.bx"
}

/// A line for each error `said` holds about the module at `path`.
// example: failed_as(command.Said { output: "", errors: "error: gone\n", status: 2 }, "a.bx") == ["a.bx: error: gone"]
fn failed_as(said: command.Said, path: String) -> List<String> {
    reported(errors: said.errors, path: path)
}

/// `found` with each of `failures` after its own.
// example: with_failures(held.nothing_failed(0), []).failures == []
fn with_failures(found: held.Held, failures: List<String>) -> held.Held {
    var kept = found
    for failure in failures {
        kept = held.with_failure(kept, failure)
    }
    kept
}

/// Whether an example says the compiler refuses it, which leaves nothing to run.
// example: is_refused(header.Refused("L0100"))
// example: !is_refused(header.Compiles)
fn is_refused(expectation: header.Expectation) -> Bool {
    match expectation {
        header.Refused(_) => true
        header.Misstated(_) => true
        _ => false
    }
}

/// How many example lines `source` states: comment lines whose text opens with `example:`.
// example: lines_stated("/// a\n// example: f() == 1\n    // example: g()\n") == 2
fn lines_stated(source: String) -> Int {
    var count = 0
    for line in walk.lines_of(source) {
        if is_an_example_line(command.trimmed_start(line)) {
            count += 1
        }
    }
    count
}

/// Whether `line` is a comment of one run of slashes whose text opens with `example:`.
// example: is_an_example_line("/// example: f()")
// example: !is_an_example_line("// an example: f()")
fn is_an_example_line(line: String) -> Bool {
    var index = 0
    for or(strings.at(line, index), 0) == 47 {
        index += 1
    }
    index >= 2 && command.has_prefix(or(strings.cut(line, index, strings.length(line)), ""), " example:")
}

/// One line for each refusal `errors` holds, naming where it points and what it says.
///
/// A refusal is its `error` line and, where it points somewhere, the `-->` line under it. One that
/// points nowhere is reported against `path`.
// example: reported(errors: "error[L0603]: the example of `f` does not hold\n  --> a.bx:3:1\n", path: "a.bx") == ["a.bx:3:1: error[L0603]: the example of `f` does not hold"]
// example: reported(errors: "error: gone\n", path: "a.bx") == ["a.bx: error: gone"]
fn reported(errors: String, path: String) -> List<String> {
    var lines = []
    var message = ""
    for line in walk.lines_of(errors) {
        let pointed = command.trimmed_start(line)
        if command.has_prefix(line, "error") {
            lines = with_message(lines: lines, at: path, message: message)
            message = line
        } else if command.has_prefix(pointed, "--> ") && message != "" {
            lines = with_message(lines: lines, at: or(strings.cut(pointed, 4, strings.length(pointed)), path), message: message)
            message = ""
        }
    }
    with_message(lines: lines, at: path, message: message)
}

/// `lines` with `message` after them, said about `at`, where there is a message.
// example: with_message(lines: [], at: "a.bx", message: "") == []
fn with_message(lines: List<String>, at: String, message: String) -> List<String> {
    if message == "" {
        return lines
    }
    list.push(lines, at + ": " + message)
}

/// What the runs found so far: the lines counted and failed, the tests counted, each run staged,
/// and the memo.
type Staging = {
    found: held.Held
    tests: Int
    runs: List<Staged>
    memo: command.Memo
}

/// One module's run, staged, or a line for each failure that leaves it with none, and the memo.
type Readied = {
    found: Result<Staged, List<String>>
    memo: command.Memo
}

/// The run of one module: the module, its run, where its classes are, and the class it starts at.
type Staged = {
    path: String
    run: command.Run
    root: command.Typed
    beside: String
    class: String
}

/// A module to stage: its path, and the directory its run's classes go into.
type Place = {
    path: String
    beside: String
}

/// What every run shares: the library, the limit of a run, and the directory made for the runs.
type Setting = {
    library: ir.Library
    limit: Int
    directory: String
}

/// What a module is typed with: the library, and the modules typed already.
type Typing = {
    library: ir.Library
    memo: command.Memo
}

test "every example line of library/ holds" {
    is_every_line_held(walk.files_in("library", ".bx"))
}
