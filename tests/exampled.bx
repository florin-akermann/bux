// The `// example:` lines of a module, found, taken at their word, and placed back where written.
//
// `docs/specs/doc-examples.md` states the properties. Each case draws how many functions a module
// declares, each of which states one example of itself, and reads the examples out of it with the
// compiler's own functions in the JVM of its test.
import ast
import command
import drawn
import held
import lexer
import list
import parser
import strings

/// `property` tried on `cases` cases, each drawn from a seed of its own.
// example: held.is_held(held_over(EveryOneFound, 2))
fn held_over(property: Property, cases: Int) -> held.Held {
    var found = held.nothing_failed(cases)
    var index = 0
    for index < cases {
        let seed = drawn.seed_of(index)
        let tried = tried_by(property, drawn.seeded(seed))
        if tried.why != "" {
            found = held.with_failure(found, held.drawn_failure(name_of(property), seed, tried.case, tried.why))
        }
        index += 1
    }
    found
}

/// One case of `property`, drawn from `draw`.
// example: tried_by(EveryOneAccepted, drawn.seeded(1)).why == ""
fn tried_by(property: Property, draw: drawn.Draw) -> Tried {
    let many = 1 + drawn.number(draw, 5)
    let source = documented(many)
    match property {
        EveryOneFound => every_example_a_module_states_is_found_however_many_functions_it_declares(many)
        EveryOneAccepted => a_module_whose_every_function_states_an_example_is_accepted(source)
        TextAfterTheMarker => the_text_of_an_example_is_the_text_of_its_line_after_the_marker(source)
        SpanInTheFile => a_span_a_run_reports_is_a_span_of_the_file_the_examples_were_read_out_of(source: source, draw: drawn.next(draw))
    }
}

/// The name a failure of `property` is reported with.
// example: name_of(EveryOneAccepted) == "a_module_whose_every_function_states_an_example_is_accepted"
fn name_of(property: Property) -> String {
    match property {
        EveryOneFound => "every_example_a_module_states_is_found_however_many_functions_it_declares"
        EveryOneAccepted => "a_module_whose_every_function_states_an_example_is_accepted"
        TextAfterTheMarker => "the_text_of_an_example_is_the_text_of_its_line_after_the_marker"
        SpanInTheFile => "a_span_a_run_reports_is_a_span_of_the_file_the_examples_were_read_out_of"
    }
}

/// There are as many examples as there are functions, each of which states one.
// example: every_example_a_module_states_is_found_however_many_functions_it_declares(2).why == ""
fn every_example_a_module_states_is_found_however_many_functions_it_declares(many: Int) -> Tried {
    let source = documented(many)
    let found = list.length(ok_or(stated_in(source), []))
    var why = ""
    if found != many {
        why = shown(found) + " examples are found"
    }
    Tried { case: source, why: why }
}

/// A module whose every function states an example earns no refusal.
// example: a_module_whose_every_function_states_an_example_is_accepted(documented(2)).why == ""
fn a_module_whose_every_function_states_an_example_is_accepted(source: String) -> Tried {
    let why = match stated_in(source) {
        Ok(_) => ""
        Err(refusals) => shown(list.length(refusals)) + " refusals are earned"
    }
    Tried { case: source, why: why }
}

/// The text an example's span covers is its line: the marker, then the expression it states.
// example: the_text_of_an_example_is_the_text_of_its_line_after_the_marker(documented(2)).why == ""
fn the_text_of_an_example_is_the_text_of_its_line_after_the_marker(source: String) -> Tried {
    var why = ""
    for example in ok_or(stated_in(source), []) {
        let line = or(strings.cut(source, example.span.start, example.span.start + example.span.length), "")
        if why == "" && line != "// example: " + example.expression {
            why = "the span covers " + held.quoted(line)
        }
    }
    Tried { case: source, why: why }
}

/// A span anywhere in what a run writes is placed back inside the file the examples came from.
// example: a_span_a_run_reports_is_a_span_of_the_file_the_examples_were_read_out_of(source: documented(2), draw: drawn.seeded(1)).why == ""
fn a_span_a_run_reports_is_a_span_of_the_file_the_examples_were_read_out_of(source: String, draw: drawn.Draw) -> Tried {
    let program = parsed(source)
    let empty_run = command.Run { source: "", stretches: [], examples: [], tests: [], module: lexer.Span { start: 0, length: 0 } }
    let run = ok_or(command.run_of(command.Page { source: source, path: "demo.bx" }, program, command.Trying { examples: ok_or(stated_in(source), []), tests: ast.tests_of(program) }), empty_run)
    let offset = drawn.number(draw, command.byte_count(run.source) + 1)
    let points = command.in_original(run, lexer.Span { start: offset, length: 1 })
    var why = ""
    if run.source == "" || points.start + points.length > command.byte_count(source) {
        why = "offset " + shown(offset) + " of the run is placed at " + shown(points)
    }
    Tried { case: source, why: why }
}

/// A module of `many` functions, each stating one example of itself.
// example: documented(1) == "// example: held(total: 7) == 7\nfn held(total: Int) -> Int {\n    total\n}\n"
fn documented(many: Int) -> String {
    var declared = []
    for named in ["held", "shared", "counted", "named", "carried"] {
        if list.length(declared) < many {
            declared = list.push(declared, "// example: " + named + "(total: 7) == 7\nfn " + named + "(total: Int) -> Int {\n    total\n}\n")
        }
    }
    strings.join(declared, "\n")
}

/// Every example `source` states, or every refusal of how it states them.
// example: list.length(ok_or(stated_in(documented(3)), [])) == 3
fn stated_in(source: String) -> Result<List<command.Example>, List<command.Diagnostic>> {
    command.stated_by(source, parsed(source))
}

/// The tree of `source`, and no items where it does not parse.
// example: list.length(parsed(documented(2)).items) == 2
fn parsed(source: String) -> ast.Program {
    ok_or(parser.parse(source), ast.Program { items: [] })
}

/// One case of a property: the drawn input as text, and why it failed, which is `""` where it held.
type Tried = {
    case: String
    why: String
}

/// Each property of the example lines.
type Property =
    | EveryOneFound
    | EveryOneAccepted
    | TextAfterTheMarker
    | SpanInTheFile

test "every example a module states is found however many functions it declares" {
    held.is_held_reported(held_over(EveryOneFound, held.drawn_cases()))
}

test "a module whose every function states an example is accepted" {
    held.is_held_reported(held_over(EveryOneAccepted, held.drawn_cases()))
}

test "the text of an example is the text of its line after the marker" {
    held.is_held_reported(held_over(TextAfterTheMarker, held.drawn_cases()))
}

test "a span a run reports is a span of the file the examples were read out of" {
    held.is_held_reported(held_over(SpanInTheFile, held.drawn_cases()))
}
