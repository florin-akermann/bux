// What the drawn properties of the type inference share: a module checked in-process through
// every phase up to inference, the type inference gave what is written at a place, and the loop
// that tries a property on each drawn case.
//
// `docs/specs/types.md` states the inference. A module is checked as `bux check` checks it,
// but in the JVM of its test, against the prelude the compiler carries.
import ast
import command
import drawn
import held
import infer
import ir
import lexer
import list
import modules
import parser
import resolver
import set
import strings
import surface
import types
import unify

// example: is_accepted("fn one() -> Int {\n    or(Some(1), 0)\n}\n", carried_library())
fn carried_library() -> ir.Library {
    ir.library_read(or(modules.carried("prelude"), ""))
}

// example: seeds(3) == [1, 2, 3]
fn seeds(cases: Int) -> List<Int> {
    var found = []
    for list.length(found) < cases {
        found = list.push(found, drawn.seed_of(list.length(found)))
    }
    found
}

// example: held.is_held(noted(found: held.nothing_failed(1), property: "p", seed: 1, tried: Tried { input: "", why: "" }))
// example: !held.is_held(noted(found: held.nothing_failed(1), property: "p", seed: 1, tried: Tried { input: "", why: "gone" }))
fn noted(found: held.Held, property: String, seed: Int, tried: Tried) -> held.Held {
    if tried.why == "" {
        return found
    }
    held.with_failure(found, held.drawn_failure(property, seed, tried.input, tried.why))
}

// example: is_accepted("fn one() -> Int {\n    1\n}\n", ir.little_library())
// example: !is_accepted("fn one() -> Int {\n    \"one\"\n}\n", ir.little_library())
fn is_accepted(source: String, library: ir.Library) -> Bool {
    code_of(checked(source, library)) == ""
}

// A refusal or a missing type gives a text that is not a type, so a comparison fails and says why.
// example: type_written(source: "fn one() -> Int {\n    1\n}\n", written: "1", count: 1, library: ir.little_library()) == "Int"
fn type_written(source: String, written: String, count: Int, library: ir.Library) -> String {
    type_in(checked(source, library), occurrence(source: source, written: written, count: count))
}

// example: code_of(checked("fn one() -> Int {\n    1\n}\n", ir.little_library())) == ""
// example: code_of(checked("fn one() -> Int {\n    \"one\"\n}\n", ir.little_library())) == "L0400"
fn checked(source: String, library: ir.Library) -> Result<infer.Inference, command.Diagnostic> {
    let program = parsed(source)?
    let resolved = command.resolved_of(resolver.resolve(program, "demo", library.prelude.names, set.empty()))?
    command.inferred_of(types.check(resolved, surface.nothing_imported(), library.prelude))
}

// example: code_of(parsed("fn (")) == "L0100"
fn parsed(source: String) -> Result<ast.Program, command.Diagnostic> {
    match parser.parse(source) {
        Ok(program) => Ok(program)
        Err(error) => Err(command.parse_diagnostic(error))
    }
}

// example: code_of(reaching(source: "fn one() -> Int {\n    1\n}\n", directory: "no-such-directory", library: ir.little_library())) == ""
fn reaching(source: String, directory: String, library: ir.Library) -> Result<infer.Inference, command.Diagnostic> {
    match command.checked_as_written(command.Page { source: source, path: modules.joined(directory, "demo.bx") }, library) {
        Ok(done) => Ok(done.root.inferred)
        Err(not) => Err(first_diagnostic(not))
    }
}

// example: first_diagnostic(command.Unusable("error: gone\n")).message == "error: gone\n"
fn first_diagnostic(not: command.NotCompiled) -> command.Diagnostic {
    match not {
        command.Unusable(said) => said_as_diagnostic(said)
        command.Refused(refusal) => or(list.at(refusal.diagnostics, 0), said_as_diagnostic("refused"))
    }
}

// example: said_as_diagnostic("gone").code == ""
fn said_as_diagnostic(said: String) -> command.Diagnostic {
    command.Diagnostic { code: "", message: said, span: lexer.Span { start: 0, length: 0 }, help: None, fix: None }
}

// example: code_of(Ok(1)) == ""
fn code_of<T>(answer: Result<T, command.Diagnostic>) -> String {
    match answer {
        Ok(_) => ""
        Err(refused) => refused.code
    }
}

// example: message_of(Ok(1)) == "accepted"
fn message_of<T>(answer: Result<T, command.Diagnostic>) -> String {
    match answer {
        Ok(_) => "accepted"
        Err(refused) => refused.message
    }
}

// example: help_of(Ok(1)) == "accepted"
fn help_of<T>(answer: Result<T, command.Diagnostic>) -> String {
    match answer {
        Ok(_) => "accepted"
        Err(refused) => or(refused.help, "")
    }
}

// example: type_in(Err(said_as_diagnostic("gone")), lexer.Span { start: 0, length: 1 }) == "refused: gone"
fn type_in(answer: Result<infer.Inference, command.Diagnostic>, at: lexer.Span) -> String {
    match answer {
        Ok(inference) => type_text(infer.type_at(inference, at))
        Err(refused) => "refused: " + refused.message
    }
}

// example: instance_in(Err(said_as_diagnostic("gone")), lexer.Span { start: 0, length: 1 }) == "refused: gone"
fn instance_in(answer: Result<infer.Inference, command.Diagnostic>, at: lexer.Span) -> String {
    match answer {
        Ok(inference) => type_text(infer.method_type_at(inference, at))
        Err(refused) => "refused: " + refused.message
    }
}

// example: type_text(None) == "no type"
// example: type_text(Some(unify.int())) == "Int"
fn type_text(found: Option<unify.Type>) -> String {
    match found {
        Some(one) => unify.text_of(one)
        None => "no type"
    }
}

// example: occurrence(source: "a b a", written: "a", count: 2).start == 4
// example: occurrence(source: "a b a", written: "a", count: 3).start == -1
fn occurrence(source: String, written: String, count: Int) -> lexer.Span {
    let length = strings.length(written)
    var seen = 0
    var index = 0
    for index + length <= strings.length(source) {
        if or(strings.cut(source, index, index + length), "") == written {
            seen += 1
            if seen == count {
                return lexer.Span { start: index, length: length }
            }
        }
        index += 1
    }
    lexer.Span { start: -1, length: length }
}

// example: outside(at: lexer.Span { start: 1, length: 2 }, source: "abc") == ""
// example: outside(at: lexer.Span { start: 1, length: 0 }, source: "abc") == "the refusal points at 1..1"
fn outside(at: lexer.Span, source: String) -> String {
    if at.length > 0 && at.start >= 0 && at.start + at.length <= strings.length(source) {
        return ""
    }
    "the refusal points at " + shown(at.start) + ".." + shown(at.start + at.length)
}

// example: list.has_value(["a", ""], module_of(drawn.seeded(1), ["a"]))
fn module_of(draw: drawn.Draw, among: List<String>) -> String {
    let count = drawn.number(draw, list.length(among) + 2)
    var at = drawn.next(draw)
    var chosen = []
    for _ in numbers_below(count) {
        let piece = drawn.picked(at, among, "")
        if !list.has_value(chosen, piece) {
            chosen = list.push(chosen, piece)
        }
        at = drawn.next(at)
    }
    strings.join(chosen, "\n\n")
}

// example: after(drawn.seeded(1), 2).state == drawn.next(drawn.next(drawn.seeded(1))).state
fn after(draw: drawn.Draw, steps: Int) -> drawn.Draw {
    var at = draw
    for _ in numbers_below(steps) {
        at = drawn.next(at)
    }
    at
}

// example: numbers_below(3) == [0, 1, 2]
fn numbers_below(count: Int) -> List<Int> {
    var found = []
    for list.length(found) < count {
        found = list.push(found, list.length(found))
    }
    found
}

type Tried = {
    input: String
    why: String
}
