// What an example under `tests/spec` says about itself, read out of the lines it opens with.
//
// `docs/specs/executable-examples.md` states the header. An example with none compiles, one headed
// `// expect-error:` is refused with the code it names, and one headed `// expect-run` runs as the
// lines under the header state. A header the runner cannot hold an example to is itself a failure.
import command

import list

import strings

import walk

/// What the example `source` says about itself.
// example: expectation_of("import io\n") == Compiles
// example: expectation_of("// expect-error: L9999\n") == Misstated("there is no diagnostic L9999")
// example: expectation_of("// > one\nimport io\n") == Misstated("only an example that is run states what it writes")
fn expectation_of(source: String) -> Expectation {
    lines := walk.lines_of(source)
    first := command.trimmed_end(or(list.at(lines, 0), ""))
    match run_with(first) {
        Some(arguments) => ran(lines: lines, arguments: arguments)
        None => not_run(lines, first)
    }
}

/// What an example that is not run says: it compiles, or it is refused with the code it names.
// example: not_run(["// expect-error: L9999"], "// expect-error: L9999") == Misstated("there is no diagnostic L9999")
// example: not_run(["// a note"], "// a note") == Compiles
fn not_run(lines: List<String>, first: String) -> Expectation {
    for line in lines {
        if is_marked(line) {
            return Misstated("only an example that is run states what it writes")
        }
    }
    if !command.has_prefix(first, "// expect-error:") {
        return Compiles
    }
    code := command.trimmed_start(or(strings.cut(first, 16, strings.length(first)), ""))
    match command.explanation_of(code) {
        Some(_) => Refused(code)
        None => Misstated("there is no diagnostic " + code)
    }
}

/// The words `first` says the program is run with, where `first` is the run header at all.
// example: or(run_with("// expect-run one two"), []) == ["one", "two"]
// example: or(run_with("// expect-running"), ["none"]) == ["none"]
fn run_with(first: String) -> Option<List<String>> {
    if !command.has_prefix(first, "// expect-run") {
        return None
    }
    rest := or(strings.cut(first, 13, strings.length(first)), "")
    if rest != "" && !command.has_prefix(rest, " ") {
        return None
    }
    Some(words_of(rest))
}

/// The words of `text`, each a run of what is not a space.
// example: words_of(" one  two ") == ["one", "two"]
fn words_of(text: String) -> List<String> {
    var words = []
    var word = ""
    var index = 0
    for index < strings.length(text) {
        unit := or(strings.cut(text, index, index + 1), "")
        if command.is_white(or(strings.at(text, index), 0)) {
            words = with_word(words, word)
            word = ""
        } else {
            word += unit
        }
        index += 1
    }
    with_word(words, word)
}

/// `words` with `word` after them, where it holds anything.
// example: with_word(["a"], "") == ["a"]
fn with_word(words: List<String>, word: String) -> List<String> {
    if word == "" {
        return words
    }
    list.push(words, word)
}

/// What the lines under the run header say the run amounts to.
///
/// They come directly under the header, so the first line that states nothing ends them. A line
/// below that still opens with a marker is one the author meant to state, and it is a failure.
// example: ran(lines: ["// expect-run", "// > one", "// status 3"], arguments: []) == Runs(Ran { arguments: [], output: "one\n", errors: "", status: 3 })
// example: ran(lines: ["// expect-run", "// a note", "// > two"], arguments: []) == Misstated("a line stating a run comes directly under the header, and this one does not")
fn ran(lines: List<String>, arguments: List<String>) -> Expectation {
    var stated = Ran { arguments: arguments, output: "", errors: "", status: 0 }
    var index = 1
    var stating = true
    for index < list.length(lines) {
        line := or(list.at(lines, index), "")
        found := states(line)
        stating = stating && is_stating(found)
        if stating {
            stated = added(stated, or(found, Status(0)))
        } else if is_marked(line) {
            return Misstated("a line stating a run comes directly under the header, and this one does not")
        }
        index += 1
    }
    Runs(stated)
}

/// Whether a line stated anything about the run.
// example: is_stating(Some(Status(0)))
// example: !is_stating(None)
fn is_stating(found: Option<Stated>) -> Bool {
    match found {
        Some(_) => true
        None => false
    }
}

/// `stated` with what `one` states added to it.
// example: added(Ran { arguments: [], output: "a\n", errors: "", status: 0 }, Output("b")).output == "a\nb\n"
fn added(stated: Ran, one: Stated) -> Ran {
    match one {
        Output(line) => stated { output: stated.output + line + "\n" }
        Errors(line) => stated { errors: stated.errors + line + "\n" }
        Status(status) => stated { status: status }
    }
}

/// What `line` states about the run, where it states anything at all.
// example: or(states("// > held"), Status(99)) == Output("held")
// example: or(states("// >"), Status(99)) == Output("")
// example: or(states("// ! gone"), Status(99)) == Errors("gone")
// example: or(states("// status 3"), Status(99)) == Status(3)
// example: !is_stating(states("// status soon"))
// example: !is_stating(states("// >one"))
fn states(line: String) -> Option<Stated> {
    match after_the_marker(line: line, marker: "// >") {
        Some(rest) => Some(Output(rest))
        None => errors_or_status(line)
    }
}

/// What `line` states about standard error or the status, where it states either.
// example: or(errors_or_status("// ! gone"), Status(99)) == Errors("gone")
fn errors_or_status(line: String) -> Option<Stated> {
    match after_the_marker(line: line, marker: "// !") {
        Some(rest) => Some(Errors(rest))
        None => status_of(line)
    }
}

/// The status `line` states, where it states one as a whole number.
// example: or(status_of("// status 3"), Status(99)) == Status(3)
// example: !is_stating(status_of("// status soon"))
fn status_of(line: String) -> Option<Stated> {
    if !command.has_prefix(line, "// status ") {
        return None
    }
    match command.ordinal_read(or(strings.cut(line, 10, strings.length(line)), "")) {
        Some(status) => Some(Status(status))
        None => None
    }
}

/// Whether `line` opens the way a line stating a run does, however it goes on.
///
/// A marker ends at the end of the line or at a space, so a comment whose first word merely opens
/// with one, such as `// statuses are read elsewhere`, states nothing about a run.
// example: is_marked("// status soon")
// example: !is_marked("// statuses are read elsewhere")
fn is_marked(line: String) -> Bool {
    for marker in ["// >", "// !", "// status"] {
        if is_after(after_the_marker(line: line, marker: marker)) {
            return true
        }
    }
    false
}

/// Whether a marker was found, with a line after it.
// example: is_after(Some(""))
// example: !is_after(None)
fn is_after(found: Option<String>) -> Bool {
    match found {
        Some(_) => true
        None => false
    }
}

/// The line written after `marker`, where `line` opens with it and a space or nothing follows.
// example: or(after_the_marker(line: "// > a", marker: "// >"), "none") == "a"
// example: !is_after(after_the_marker(line: "// >a", marker: "// >"))
fn after_the_marker(line: String, marker: String) -> Option<String> {
    if !command.has_prefix(line, marker) {
        return None
    }
    rest := or(strings.cut(line, strings.length(marker), strings.length(line)), "")
    if rest == "" {
        return Some(rest)
    }
    if !command.has_prefix(rest, " ") {
        return None
    }
    strings.cut(rest, 1, strings.length(rest))
}

derive Eq for Expectation

derive Eq for Ran

derive Eq for Stated

/// What an example says about itself.
type Expectation =
    | Compiles
    | Refused(String)
    | Runs(Ran)
    | Misstated(String)

/// What an example headed `// expect-run` says its run amounts to.
type Ran = {
    arguments: List<String>
    output: String
    errors: String
    status: Int
}

/// One line under the run header, as what it says about the run.
type Stated =
    | Output(String)
    | Errors(String)
    | Status(Int)
