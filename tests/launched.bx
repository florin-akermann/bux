// The launcher `bin/bux`, held to what it says when it starts the compiler and when it cannot, and
// the limit every started program has.
//
// `docs/specs/run.md` states the launcher. Each check starts it through `sh` in a directory of its
// own, so what it writes lands there, and `env` sets or clears `JAVA_HOME` for that start alone.
// `docs/implementation.md` section 7 states the limit.
import clock
import command
import files
import held
import modules
import strings
import walk

// example: every_start_held(root: "no-such-directory", limit: 1).cases == 5
fn every_start_held(root: String, limit: Int) -> held.Held {
    let launcher = modules.joined(modules.joined(root, "bin"), "bux")
    var found = start_held(["sh", launcher, "--version"], limit, Expected { status: 0, output: "bux 0.1.0\n", errors: "" })
    found = held.added(found, start_held(["env", "-u", "JAVA_HOME", "sh", launcher, "--version"], limit, Expected { status: 2, output: "", errors: "error: JAVA_HOME is not set, and the bux compiler runs on the JDK it names\n" }))
    found = held.added(found, start_held(["env", "JAVA_HOME=/no/such/jdk", "sh", launcher, "--version"], limit, Expected { status: 2, output: "", errors: "error: /no/such/jdk/bin/java: JAVA_HOME names no JDK\n" }))
    found = held.added(found, unbuilt_held(launcher, limit))
    held.added(found, stopped_held())
}

// example: forever_text() == "while :; do :; done\n"
fn stopped_held() -> held.Held {
    match command.somewhere_of_its_own() {
        Ok(directory) => stopped_in(directory)
        Err(said) => held.with_failure(held.nothing_failed(1), "a program that never ends: " + said.errors)
    }
}

// example: stopped_in("no-such-directory").cases == 1
fn stopped_in(directory: String) -> held.Held {
    _ = files.write(modules.joined(directory, "forever.sh"), forever_text())
    let from = clock.nanoseconds()
    let completion = walk.completed(["sh", "forever.sh"], directory, 1)
    let milliseconds = or((clock.nanoseconds() - from) / 1000000, 0)
    command.removed_whole(directory)
    stopped_compared(completion, milliseconds)
}

// The window is wide, because a full pool holds back the worker that waits for the program.
// `docs/implementation.md` section 7 gives the time measured under such a load.
// example: stopped_compared(Err(walk.PastLimit(1, "")), 1100).failures == []
// example: stopped_compared(Err(walk.PastLimit(1, "")), 60000).failures == ["a program that never ends: milliseconds until it was reported: expected \"1000 to 59999\", found \"60000\""]
// example: stopped_compared(Err(walk.PastLimit(1, "")), 999).failures == ["a program that never ends: milliseconds until it was reported: expected \"1000 to 59999\", found \"999\""]
// example: stopped_compared(Err(walk.NotStarted), 1100).failures == ["a program that never ends: expected \"the program did not end within 1 s, and was stopped\", found \"the program could not be started\""]
fn stopped_compared(completion: Result<walk.Ended, walk.Unended>, milliseconds: Int) -> held.Held {
    var found = held.nothing_failed(1)
    let said = ended_said(completion)
    let expected = walk.unended_said(walk.PastLimit(1, ""), "the program")
    if said != expected {
        found = held.with_failure(found, held.failure("a program that never ends", expected, said))
    }
    if milliseconds < 1000 || milliseconds >= 60000 {
        found = held.with_failure(found, held.failure("a program that never ends: milliseconds until it was reported", "1000 to 59999", shown(milliseconds)))
    }
    found
}

// example: strings.length(forever_text()) == 20
fn forever_text() -> String {
    "while :; do :; done\n"
}

// example: ended_said(Ok(walk.Ended { output: "", errors: "", status: 3 })) == "status 3"
fn ended_said(completion: Result<walk.Ended, walk.Unended>) -> String {
    match completion {
        Ok(done) => "status " + shown(done.status)
        Err(unended) => walk.unended_said(unended, "the program")
    }
}

// example: unbuilt_held("no-such-directory/bux", 1).cases == 1
fn unbuilt_held(launcher: String, limit: Int) -> held.Held {
    match command.somewhere_of_its_own() {
        Ok(directory) => unbuilt_in(launcher: launcher, directory: directory, limit: limit)
        Err(said) => held.with_failure(held.nothing_failed(1), launcher + ": " + said.errors)
    }
}

// example: unbuilt_in(launcher: "no-such-directory/bux", directory: "no-such-directory", limit: 1).cases == 1
fn unbuilt_in(launcher: String, directory: String, limit: Int) -> held.Held {
    let bin = modules.joined(directory, "bin")
    let copy = modules.joined(bin, "bux")
    _ = files.made(bin)
    _ = files.write(copy, ok_or(files.read(launcher), ""))
    let expected = Expected { status: 2, output: "", errors: "the compiler is not built; bin/bootstrap builds it\n" }
    let line = ["sh", copy, "--version"]
    let found = ended_held(line, walk.completed(line, directory, limit), expected)
    command.removed_whole(directory)
    found
}

// example: start_held(["no-such-program-at-all"], 1, Expected { status: 0, output: "", errors: "" }).cases == 1
fn start_held(line: List<String>, limit: Int, expected: Expected) -> held.Held {
    match command.somewhere_of_its_own() {
        Ok(directory) => started_in(line, directory, limit, expected)
        Err(said) => held.with_failure(held.nothing_failed(1), strings.join(line, " ") + ": " + said.errors)
    }
}

// example: started_in(["no-such-program-at-all"], "no-such-directory", 1, Expected { status: 0, output: "", errors: "" }).cases == 1
fn started_in(line: List<String>, directory: String, limit: Int, expected: Expected) -> held.Held {
    let completion = walk.completed(line, directory, limit)
    command.removed_whole(directory)
    ended_held(line, completion, expected)
}

// example: ended_held(["x"], Err(walk.NotStarted), Expected { status: 0, output: "", errors: "" }).failures == ["x: the launcher could not be started"]
// example: ended_held(["x"], Err(walk.PastLimit(9, "")), Expected { status: 0, output: "", errors: "" }).failures == ["x: the launcher did not end within 9 s, and was stopped"]
fn ended_held(line: List<String>, completion: Result<walk.Ended, walk.Unended>, expected: Expected) -> held.Held {
    let name = strings.join(line, " ")
    match completion {
        Ok(done) => compared(name, done, expected)
        Err(unended) => held.with_failure(held.nothing_failed(1), name + ": " + walk.unended_said(unended, "the launcher"))
    }
}

// example: compared("x", walk.Ended { output: "", errors: "error: a\n", status: 2 }, Expected { status: 2, output: "", errors: "a\n" }).failures == []
// example: compared("x", walk.Ended { output: "", errors: "", status: 1 }, Expected { status: 2, output: "", errors: "" }).failures == ["x: status: expected \"2\", found \"1\""]
fn compared(name: String, done: walk.Ended, expected: Expected) -> held.Held {
    var found = held.nothing_failed(1)
    if done.status != expected.status {
        found = held.with_failure(found, held.failure(name + ": status", shown(expected.status), shown(done.status)))
    }
    if done.output != expected.output {
        found = held.with_failure(found, held.failure(name + ": standard output", expected.output, done.output))
    }
    if !walk.is_ending_in(done.errors, expected.errors) {
        found = held.with_failure(found, held.failure(name + ": the end of standard error", expected.errors, done.errors))
    }
    found
}

type Expected = {
    status: Int
    output: String
    errors: String
}

test "the launcher starts the compiler where it can and names what is missing where it cannot" {
    held.is_held_reported(every_start_held(root: ok_or(files.canonical_path(files.named(".")), "."), limit: walk.start_limit()))
}
