// The drawn properties of name resolution, which `docs/specs/modules.md` states.
//
// Each property draws a module from a fixed seed and resolves it with `compiler/resolver.bx`
// against the prelude the runner reads. A failure names the seed and the module it drew.
import ast
import drawn
import held
import ir
import lexer
import list
import map
import parser
import resolver
import strings

/// One `Held` for each property of name resolution, in a fixed order.
// example: list.length(every_property(1, ir.little_library())) == 4
fn every_property(cases: Int, library: ir.Library) -> List<held.Held> {
    names := library.prelude.names
    [resolving_is_deterministic(cases, names), a_module_of_pieces_resolves(cases, names), a_refusal_points_inside_the_source(cases, names), every_declared_name_is_declared_there(cases, names)]
}

/// A drawn module that parses resolves to one answer, however many times it is resolved.
// example: held.is_held(resolving_is_deterministic(2, ir.little_library().prelude.names))
fn resolving_is_deterministic(cases: Int, names: resolver.Prelude) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        source := drawn_source(drawn.seeded(drawn.seed_of(case)))
        first := resolver.printed(source, names)
        if first != resolver.printed(source, names) {
            found = held.with_failure(found, held.drawn_failure("resolving_is_deterministic", drawn.seed_of(case), source, "two answers"))
        }
        case += 1
    }
    found
}

/// A module of distinct pieces, each of which resolves on its own, resolves.
// example: held.is_held(a_module_of_pieces_resolves(2, ir.little_library().prelude.names))
fn a_module_of_pieces_resolves(cases: Int, names: resolver.Prelude) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        source := module_of(drawn.seeded(drawn.seed_of(case)), pieces())
        answer := resolver.printed(source, names)
        if !is_resolved(answer) {
            found = held.with_failure(found, held.drawn_failure("a_module_of_pieces_resolves", drawn.seed_of(case), source, answer))
        }
        case += 1
    }
    found
}

/// A piece that is refused however sound the module around it is gives a refusal that points
/// at a stretch of at least one byte inside the source.
// example: held.is_held(a_refusal_points_inside_the_source(2, ir.little_library().prelude.names))
fn a_refusal_points_inside_the_source(cases: Int, names: resolver.Prelude) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        start := drawn.seeded(drawn.seed_of(case))
        refused := drawn.picked(start, refusals(), "")
        source := module_of(drawn.next(start), pieces()) + "\n\n" + refused + "\n"
        why := refusal_outside(source, names)
        if why != "" {
            found = held.with_failure(found, held.drawn_failure("a_refusal_points_inside_the_source", drawn.seed_of(case), source, why))
        }
        case += 1
    }
    found
}

/// Why the refusal of `source` does not point inside it, and `""` where it does.
// example: refusal_outside("fn f() -> Int {\n    gone\n}\n", ir.little_library().prelude.names) == ""
// example: refusal_outside("fn f() -> Int {\n    1\n}\n", ir.little_library().prelude.names) == "it resolves"
fn refusal_outside(source: String, names: resolver.Prelude) -> String {
    match parser.parse(source) {
        Ok(program) => span_outside(resolver.resolve(program, "demo", names), strings.length(source))
        Err(_) => "it does not parse"
    }
}

/// Why the refusal `answer` holds is not a stretch of at least one byte within `length` bytes.
// example: span_outside(Err(resolver.ResolveError { kind: resolver.NoValue("x"), span: stretch(start: 2, length: 0) }), 5) == "the refusal points at 2..2"
fn span_outside(answer: Result<resolver.Resolved, resolver.ResolveError>, length: Int) -> String {
    match answer {
        Ok(_) => "it resolves"
        Err(refused) => stretch_outside(refused.span, length)
    }
}

/// Why `span` is not a stretch of at least one byte within `length` bytes, and `""` where it is.
// example: stretch_outside(stretch(start: 1, length: 2), 3) == ""
// example: stretch_outside(stretch(start: 1, length: 3), 3) == "the refusal points at 1..4"
fn stretch_outside(span: lexer.Span, length: Int) -> String {
    if span.length > 0 && span.start >= 0 && span.start + span.length <= length {
        return ""
    }
    "the refusal points at " + shown(span.start) + ".." + shown(span.start + span.length)
}

/// Every name a drawn module of pieces declares is resolved, at the place it is written, to the
/// definition that place declares.
// example: held.is_held(every_declared_name_is_declared_there(2, ir.little_library().prelude.names))
fn every_declared_name_is_declared_there(cases: Int, names: resolver.Prelude) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        source := module_of(drawn.seeded(drawn.seed_of(case)), pieces())
        why := undeclared_name(source, names)
        if why != "" {
            found = held.with_failure(found, held.drawn_failure("every_declared_name_is_declared_there", drawn.seed_of(case), source, why))
        }
        case += 1
    }
    found
}

/// The first name `source` declares that is not resolved to its own declaration, and `""`.
// example: undeclared_name("fn f() -> Int {\n    1\n}\n", ir.little_library().prelude.names) == ""
// example: undeclared_name("fn (", ir.little_library().prelude.names) == "it does not parse"
fn undeclared_name(source: String, names: resolver.Prelude) -> String {
    match parser.parse(source) {
        Ok(program) => resolved_undeclared(resolver.resolve(program, "demo", names), source)
        Err(_) => "it does not parse"
    }
}

/// The first declared name `answer` does not resolve to its own declaration, and `""`.
// example: resolved_undeclared(Err(resolver.ResolveError { kind: resolver.NoValue("x"), span: stretch(start: 2, length: 0) }), "") == "it does not resolve"
fn resolved_undeclared(answer: Result<resolver.Resolved, resolver.ResolveError>, source: String) -> String {
    match answer {
        Ok(resolved) => first_undeclared(resolved, source)
        Err(_) => "it does not resolve"
    }
}

/// The first declared name of `resolved` that its own place does not declare, and `""`.
// example: first_undeclared(resolver.Resolved { module: "demo", program: ast.Program { items: [] }, found: map.empty() }, "") == ""
fn first_undeclared(resolved: resolver.Resolved, source: String) -> String {
    for one in declared_names(resolved.program) {
        why := declared_elsewhere(resolved, one, source)
        if why != "" {
            return why
        }
    }
    ""
}

/// Why `one` is not declared at the place it is written in `source`, and `""` where it is.
// example: declared_elsewhere(resolver.Resolved { module: "demo", program: ast.Program { items: [] }, found: map.empty() }, Declaring { namespace: resolver.ValueNamespace, name: ast.Name { text: "f", span: stretch(start: 0, length: 1) } }, "f") == "`f` resolves to nothing"
fn declared_elsewhere(resolved: resolver.Resolved, one: Declaring, source: String) -> String {
    name := one.name
    if or(strings.cut(source, name.span.start, name.span.start + name.span.length), "") != name.text {
        return "`" + name.text + "` is not the text at its span"
    }
    match map.get(resolved.found, resolver.key_of(one.namespace, name.span.start)) {
        Some(resolution) => origin_elsewhere(resolution.definition.origin, name)
        None => "`" + name.text + "` resolves to nothing"
    }
}

/// Why `origin` is not the declaration at `name`, and `""` where it is.
// example: origin_elsewhere(resolver.Declared(stretch(start: 0, length: 1)), ast.Name { text: "f", span: stretch(start: 0, length: 1) }) == ""
// example: origin_elsewhere(resolver.InPrelude, ast.Name { text: "f", span: stretch(start: 0, length: 1) }) == "`f` is declared elsewhere"
fn origin_elsewhere(origin: resolver.Origin, name: ast.Name) -> String {
    match origin {
        resolver.InPrelude => "`" + name.text + "` is declared elsewhere"
        resolver.Declared(span) => same_place(span, name)
    }
}

/// `""` where `span` is where `name` is written, and why not otherwise.
// example: same_place(stretch(start: 0, length: 1), ast.Name { text: "f", span: stretch(start: 0, length: 1) }) == ""
// example: same_place(stretch(start: 1, length: 1), ast.Name { text: "f", span: stretch(start: 0, length: 1) }) == "`f` is declared elsewhere"
fn same_place(span: lexer.Span, name: ast.Name) -> String {
    if span.start == name.span.start && span.length == name.span.length {
        return ""
    }
    "`" + name.text + "` is declared elsewhere"
}

/// Every name `program` writes as a declaration, with the namespace it declares into.
///
/// Neither an instance nor a derive declares a name: the trait declares the one its methods
/// answer for.
// example: list.length(declared_names(ok_or(parser.parse("import io\n\ntrait Area<T> {\n    fn covered(shape: T) -> Int\n}\n"), ast.Program { items: [] }))) == 3
fn declared_names(program: ast.Program) -> List<Declaring> {
    var found = []
    for item in program.items {
        for one in names_of(item) {
            found = list.push(found, one)
        }
    }
    found
}

/// The names one item declares.
// example: list.length(names_of(ast.Import(ast.ImportDeclaration { module: ast.Name { text: "io", span: stretch(start: 7, length: 2) }, span: stretch(start: 0, length: 9) }))) == 1
fn names_of(item: ast.Item) -> List<Declaring> {
    match item {
        ast.Import(imported) => [value_named(imported.module)]
        ast.Type(declaration) => [Declaring { namespace: resolver.TypeNamespace, name: declaration.name }]
        ast.Trait(declaration) => trait_names(declaration)
        ast.Function(function) => [value_named(function.name)]
        ast.Extern(declaration) => [value_named(declaration.name)]
        ast.Process(declaration) => [value_named(declaration.name)]
        _ => []
    }
}

/// The trait's own name, then the name of each method it declares.
// example: list.length(trait_names(ast.TraitDeclaration { name: ast.Name { text: "A", span: stretch(start: 6, length: 1) }, parameter: ast.Name { text: "T", span: stretch(start: 8, length: 1) }, methods: [], span: stretch(start: 0, length: 9) })) == 1
fn trait_names(declaration: ast.TraitDeclaration) -> List<Declaring> {
    var found = [Declaring { namespace: resolver.TypeNamespace, name: declaration.name }]
    for method in declaration.methods {
        found = list.push(found, value_named(method.name))
    }
    found
}

/// `name`, declared into the value namespace.
// example: value_named(ast.Name { text: "f", span: stretch(start: 0, length: 1) }).name.text == "f"
fn value_named(name: ast.Name) -> Declaring {
    Declaring { namespace: resolver.ValueNamespace, name: name }
}

/// Whether the resolver's printed answer is that the module resolved.
// example: is_resolved("resolved\n")
// example: !is_resolved("refused\n")
fn is_resolved(answer: String) -> Bool {
    or(strings.cut(answer, 0, 9), "") == "resolved\n"
}

/// A module of the distinct pieces drawn from `among`; a piece drawn twice is written once.
// example: list.has_value(["a", ""], module_of(drawn.seeded(1), ["a"]))
fn module_of(draw: drawn.Draw, among: List<String>) -> String {
    count := drawn.number(draw, list.length(among) + 2)
    var at = drawn.next(draw)
    var chosen = []
    var index = 0
    for index < count {
        piece := drawn.picked(at, among, "")
        if !list.has_value(chosen, piece) {
            chosen = list.push(chosen, piece)
        }
        at = drawn.next(at)
        index += 1
    }
    strings.join(chosen, "\n\n")
}

/// The pieces a drawn module is built from, each of which resolves on its own and declares its
/// own names, so any set of them is a module that resolves.
// example: list.length(pieces()) == 6
fn pieces() -> List<String> {
    ["import io", "type UserId = UserId(Int)", "type User = {\n    id: Int\n}", "fn identity<T>(value: T) -> T {\n    value\n}", "fn total(counts: List<Int>) -> Int {\n    var sum = 0\n    for count in counts {\n        sum += 1\n    }\n    sum\n}", "fn describe(payment: Payment) -> String {\n    match payment {\n        Pending => \"waiting\"\n        Failed(reason) => reason\n    }\n}\n\ntype Payment =\n    | Pending\n    | Failed(String)\n"]
}

/// The pieces that are refused however sound the module around them is.
// example: list.length(refusals()) == 4
fn refusals() -> List<String> {
    ["fn refused() -> Int {\n    nothing_names_this\n}", "fn refused() -> Missing {\n    1\n}", "fn refused(seen: Int) -> Int {\n    seen := 1\n    seen\n}", "fn Ok() -> Int {\n    1\n}"]
}

/// A module of one to five drawn declarations, written as the grammar writes them.
///
/// The names clash, hide, and go missing often, so a drawn module is refused as often as not.
// example: strings.length(drawn_source(drawn.seeded(1))) > 0
fn drawn_source(draw: drawn.Draw) -> String {
    count := drawn.number(draw, 5) + 1
    var at = drawn.next(draw)
    var items = []
    for list.length(items) < count {
        items = list.push(items, drawn_item(at))
        at = after(at, 32)
    }
    strings.join(items, "\n\n") + "\n"
}

/// One declaration of a kind the resolver walks, drawn from `draw`.
// example: strings.length(drawn_item(drawn.seeded(3))) > 0
fn drawn_item(draw: drawn.Draw) -> String {
    name := drawn.picked(after(draw, 1), declared(), "f")
    type_name := drawn.picked(after(draw, 2), written_types(), "Int")
    other := drawn.picked(after(draw, 3), declared(), "f")
    match drawn.number(draw, 7) {
        0 => "import " + drawn.picked(after(draw, 4), ["io", "list", "f"], "io")
        1 => "type " + name + " = {\n    held: " + type_name + "\n}"
        2 => "type " + name + "<T> =\n    | " + other + "\n    | Held(" + type_name + ")"
        3 => "trait " + drawn.picked(after(draw, 4), ["Area", "Sized"], "Area") + "<T> {\n    fn " + name + "(value: T) -> " + type_name + "\n}"
        4 => "instance " + trait_drawn(after(draw, 4)) + "<" + name + "> {\n    fn " + other + "(value: " + name + ") -> Int {\n        1\n    }\n}"
        5 => "derive " + trait_drawn(after(draw, 4)) + " for " + name
        _ => drawn_function(draw: after(draw, 4), name: name, type_name: type_name)
    }
}

/// A function whose body binds, assigns, loops, calls, and matches drawn names.
// example: strings.length(drawn_function(draw: drawn.seeded(1), name: "f", type_name: "Int")) > 0
fn drawn_function(draw: drawn.Draw, name: String, type_name: String) -> String {
    count := drawn.number(draw, 4)
    var body = ""
    var at = drawn.next(draw)
    var index = 0
    for index < count {
        body += "    " + drawn_statement(at) + "\n"
        at = after(at, 8)
        index += 1
    }
    "fn " + name + "<T: " + trait_drawn(at) + "<T>>(held: " + type_name + ") -> Int {\n" + body + "    " + drawn_expression(drawn.next(at)) + "\n}"
}

/// One statement of a drawn body.
// example: strings.length(drawn_statement(drawn.seeded(1))) > 0
fn drawn_statement(draw: drawn.Draw) -> String {
    bound := drawn.picked(after(draw, 1), written(), "held")
    value := drawn_expression(after(draw, 2))
    match drawn.number(draw, 6) {
        0 => bound + " := " + value
        1 => "var " + bound + " = " + value
        2 => bound + " = " + value
        3 => "for " + bound + " in " + value + " {\n        " + drawn_expression(after(draw, 5)) + "\n    }"
        4 => "_ = match " + bound + " {\n        " + drawn_pattern(after(draw, 5)) + " => 1\n        _ => 2\n    }"
        _ => "return " + value
    }
}

/// A name, a call, a dotted call, a dotted name, or a record, over drawn names.
// example: strings.length(drawn_expression(drawn.seeded(1))) > 0
fn drawn_expression(draw: drawn.Draw) -> String {
    one := drawn.picked(after(draw, 1), written(), "held")
    other := drawn.picked(after(draw, 2), written(), "held")
    match drawn.number(draw, 5) {
        0 => one
        1 => one + "(" + other + ")"
        2 => one + "." + other + "()"
        3 => one + "." + other
        _ => one + " { held: " + other + " }"
    }
}

/// A binding, a constructor, an or-pattern, a record, or a dotted name, over a drawn name.
// example: strings.length(drawn_pattern(drawn.seeded(1))) > 0
fn drawn_pattern(draw: drawn.Draw) -> String {
    one := drawn.picked(after(draw, 1), written(), "held")
    match drawn.number(draw, 5) {
        0 => one
        1 => "Some(" + one + ")"
        2 => "1 | " + one
        3 => one + " { held }"
        _ => "io." + one
    }
}

/// A trait a drawn declaration names: from the prelude, from the module, or from nowhere.
// example: strings.length(trait_drawn(drawn.seeded(1))) > 0
fn trait_drawn(draw: drawn.Draw) -> String {
    drawn.picked(draw, ["Eq", "Show", "Area", "Sized", "Add"], "Eq")
}

/// The names a drawn declaration is called.
// example: list.length(declared()) == 7
fn declared() -> List<String> {
    ["f", "g", "h", "Id", "Box", "Pair", "Some"]
}

/// The names a drawn body writes, which are declared, supplied by the prelude, or nowhere.
// example: list.length(written()) == 10
fn written() -> List<String> {
    ["held", "total", "f", "g", "Id", "Box", "io", "None", "or", "missing"]
}

/// The types a drawn declaration writes.
// example: list.length(written_types()) == 7
fn written_types() -> List<String> {
    ["Int", "Id", "Box", "Eq", "T", "io.Box", "Missing"]
}

/// The draw `steps` draws after `draw`.
// example: after(drawn.seeded(1), 0).state == drawn.seeded(1).state
// example: after(drawn.seeded(1), 2).state == drawn.next(drawn.next(drawn.seeded(1))).state
fn after(draw: drawn.Draw, steps: Int) -> drawn.Draw {
    var at = draw
    var index = 0
    for index < steps {
        at = drawn.next(at)
        index += 1
    }
    at
}

/// A stretch of `length` bytes from `start`.
// example: stretch(start: 1, length: 2).length == 2
fn stretch(start: Int, length: Int) -> lexer.Span {
    lexer.Span { start: start, length: length }
}

/// One name a module declares, and the namespace it declares it into.
type Declaring = {
    namespace: resolver.Namespace
    name: ast.Name
}
