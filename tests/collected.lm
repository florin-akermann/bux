// The map, the set, and the list of the library, each given back exactly what went into it.
//
// `docs/specs/collections.md` and `docs/specs/library.md` state the properties. Each case draws
// what goes in, puts it into the map, the set, or the list of the library in the runner's JVM, and
// reads it all back out. What a read must give is worked out again from the draw, not from a map.
import drawn

import held

import ir

import list

import map

import set

import strings

/// Every property of the collections over `cases` drawn cases each, in a fixed order.
///
/// The collections are read in the runner's JVM, so no property needs the prelude it is handed.
// example: list.length(every_property(1, ir.little_library())) == 5
fn every_property(cases: Int, library: ir.Library) -> List<held.Held> {
    var found = []
    for property in [MapReadsBack, SetHoldsWhatWentIn, WideKeysReadBack, ListReadsBack, PushLeavesTheList] {
        found = list.push(found, held_over(property, cases))
    }
    found
}

/// `property` tried on `cases` cases, each drawn from a seed of its own.
// example: held.is_held(held_over(MapReadsBack, 2))
fn held_over(property: Property, cases: Int) -> held.Held {
    var found = held.nothing_failed(cases)
    var index = 0
    for index < cases {
        seed := drawn.seed_of(index)
        tried := tried_by(property, drawn.seeded(seed))
        if tried.why != "" {
            found = held.with_failure(found, held.drawn_failure(name_of(property), seed, tried.case, tried.why))
        }
        index += 1
    }
    found
}

/// One case of `property`, drawn from `draw`.
// example: tried_by(ListReadsBack, drawn.seeded(1)).why == ""
fn tried_by(property: Property, draw: drawn.Draw) -> Tried {
    match property {
        MapReadsBack => a_map_gives_back_the_value_last_put_in_at_each_key(draw)
        SetHoldsWhatWentIn => a_set_holds_every_value_put_into_it_and_no_other(draw)
        WideKeysReadBack => hundreds_of_keys_read_back_out_of_a_map_and_a_set(draw)
        ListReadsBack => a_list_grown_by_push_reads_back_at_every_index_it_holds(draw)
        PushLeavesTheList => a_push_leaves_the_list_it_was_handed_holding_what_it_held(draw)
    }
}

/// The name a failure of `property` is reported with.
// example: name_of(MapReadsBack) == "a_map_gives_back_the_value_last_put_in_at_each_key"
fn name_of(property: Property) -> String {
    match property {
        MapReadsBack => "a_map_gives_back_the_value_last_put_in_at_each_key"
        SetHoldsWhatWentIn => "a_set_holds_every_value_put_into_it_and_no_other"
        WideKeysReadBack => "hundreds_of_keys_read_back_out_of_a_map_and_a_set"
        ListReadsBack => "a_list_grown_by_push_reads_back_at_every_index_it_holds"
        PushLeavesTheList => "a_push_leaves_the_list_it_was_handed_holding_what_it_held"
    }
}

/// `docs/specs/collections.md` properties 1 and 2: a key reads back as what last went in at it.
///
/// The keys are drawn from a handful, so most cases put two values in at one key.
// example: a_map_gives_back_the_value_last_put_in_at_each_key(drawn.seeded(3)).why == ""
fn a_map_gives_back_the_value_last_put_in_at_each_key(draw: drawn.Draw) -> Tried {
    put_in := puts_of(draw)
    var held_map = map.empty()
    for put in put_in {
        held_map = map.insert(held_map, put.key, put.value)
    }
    var why = ""
    for key in [0, 1, 2, 3, 4] {
        read := or(map.get(held_map, key), missing())
        if why == "" && read != last_put_at(put_in, key) {
            why = "key " + shown(key) + " reads back as " + shown(read)
        }
    }
    Tried { case: puts_shown(put_in), why: why }
}

/// Up to six keys from 0 to 4, each with a value from -99 to 99 to put in at it.
// example: list.length(puts_of(drawn.seeded(1))) < 7
fn puts_of(draw: drawn.Draw) -> List<Put> {
    var puts = []
    var at = drawn.next(draw)
    for list.length(puts) < drawn.number(draw, 7) {
        puts = list.push(puts, Put { key: drawn.number(at, 5), value: small(drawn.next(at)) })
        at = drawn.next(drawn.next(at))
    }
    puts
}

/// The value put in last at `key`, and `missing()` where none was.
// example: last_put_at([Put { key: 1, value: 5 }, Put { key: 1, value: 6 }], 1) == 6
// example: last_put_at([], 1) == missing()
fn last_put_at(put_in: List<Put>, key: Int) -> Int {
    var last = missing()
    for put in put_in {
        if put.key == key {
            last = put.value
        }
    }
    last
}

/// Each put as `key=value`, one after another.
// example: puts_shown([Put { key: 1, value: -5 }]) == "1=-5"
fn puts_shown(put_in: List<Put>) -> String {
    var written = []
    for put in put_in {
        written = list.push(written, shown(put.key) + "=" + shown(put.value))
    }
    strings.join(written, " ")
}

/// `docs/specs/collections.md` property 3: a set holds what went into it and nothing else.
///
/// The set is asked about every value put in, which catches a lost one, and about other values
/// beside them, which catches a set that holds everything.
// example: a_set_holds_every_value_put_into_it_and_no_other(drawn.seeded(3)).why == ""
fn a_set_holds_every_value_put_into_it_and_no_other(draw: drawn.Draw) -> Tried {
    put_in := smalls_of(draw, 7)
    var seen = set.empty()
    for value in put_in {
        seen = set.insert(seen, value)
    }
    var why = ""
    for value in joined(first: put_in, second: smalls_of(drawn.next(draw), 5)) {
        if why == "" && set.has_value(seen, value) != list.has_value(put_in, value) {
            why = "the set says " + shown(set.has_value(seen, value)) + " of " + shown(value)
        }
    }
    Tried { case: shown(put_in), why: why }
}

/// The values of `first`, then those of `second`.
// example: joined(first: [1], second: [2]) == [1, 2]
fn joined(first: List<Int>, second: List<Int>) -> List<Int> {
    var values = first
    for value in second {
        values = list.push(values, value)
    }
    values
}

/// `docs/specs/collections.md` property 4: hundreds of keys, some hashing alike, all read back.
///
/// Each drawn number `one` puts the keys `[one, 31]` and `[one + 1, 0]` in, which hash alike, at
/// the index each has among the keys. A key written with `30` never goes in.
// example: hundreds_of_keys_read_back_out_of_a_map_and_a_set(drawn.seeded(3)).why == ""
fn hundreds_of_keys_read_back_out_of_a_map_and_a_set(draw: drawn.Draw) -> Tried {
    drawn_numbers := drawn.numbers(draw, 150, 1000)
    keys := wide_keys(drawn_numbers)
    var held_map = map.empty()
    var seen = set.empty()
    var index = 0
    for key in keys {
        held_map = map.insert(held_map, key, index)
        seen = set.insert(seen, key)
        index += 1
    }
    Tried { case: shown(drawn_numbers), why: wide_misread(Wide { keys: keys, held_map: held_map, seen: seen }) }
}

/// Two keys that hash alike for each of `drawn_numbers`, in the order they were drawn.
// example: wide_keys([4]) == [[4, 31], [5, 0]]
fn wide_keys(drawn_numbers: List<Int>) -> List<List<Int>> {
    var keys = []
    for one in drawn_numbers {
        keys = list.push(list.push(keys, [one, 31]), [one + 1, 0])
    }
    keys
}

/// Why the map or the set of `wide` reads a key back wrong, and `""` where each reads right.
// example: wide_misread(Wide { keys: [], held_map: map.empty(), seen: set.empty() }) == ""
fn wide_misread(wide: Wide) -> String {
    for key in wide.keys {
        index := last_index_of(wide.keys, key)
        if or(map.get(wide.held_map, key), missing()) != index || !set.has_value(wide.seen, key) {
            return "key " + shown(key) + " does not read back as " + shown(index)
        }
        absent := [or(list.at(key, 0), 0), 30]
        if or(map.get(wide.held_map, absent), missing()) != missing() || set.has_value(wide.seen, absent) {
            return "key " + shown(absent) + " is held, and it never went in"
        }
    }
    ""
}

/// The last index `keys` holds `key` at, and `missing()` where it holds none.
// example: last_index_of([[1], [2], [1]], [1]) == 2
fn last_index_of(keys: List<List<Int>>, key: List<Int>) -> Int {
    var index = list.length(keys) - 1
    for index >= 0 && or(list.at(keys, index), []) != key {
        index = index - 1
    }
    if index < 0 {
        return missing()
    }
    index
}

/// `docs/specs/library.md` properties 5 and 6: what was pushed on reads back where it went.
///
/// The list is read at every index it holds, and at two past each end of them.
// example: a_list_grown_by_push_reads_back_at_every_index_it_holds(drawn.seeded(3)).why == ""
fn a_list_grown_by_push_reads_back_at_every_index_it_holds(draw: drawn.Draw) -> Tried {
    grown := smalls_of(draw, 7)
    count := drawn.number(draw, 7)
    var why = ""
    var index = -2
    for index <= count + 1 {
        read := or(list.at(grown, index), missing())
        if why == "" && read != drawn_at(draw: draw, index: index, count: count) {
            why = "index " + shown(index) + " reads back as " + shown(read)
        }
        index += 1
    }
    Tried { case: shown(grown), why: why }
}

/// The value `smalls_of` draws at `index` of `count`, drawn again, and `missing()` past an end.
// example: drawn_at(draw: drawn.seeded(1), index: -1, count: 3) == missing()
fn drawn_at(draw: drawn.Draw, index: Int, count: Int) -> Int {
    if index < 0 || index >= count {
        return missing()
    }
    var at = drawn.next(drawn.next(draw))
    var step = 0
    for step < index {
        at = drawn.next(at)
        step += 1
    }
    small(at)
}

/// `docs/specs/library.md` property 6: a list is a value, so a push reaches into none.
///
/// Both pushes are made before any list is read, so the second cannot write over the first.
// example: a_push_leaves_the_list_it_was_handed_holding_what_it_held(drawn.seeded(3)).why == ""
fn a_push_leaves_the_list_it_was_handed_holding_what_it_held(draw: drawn.Draw) -> Tried {
    handed := smalls_of(draw, 7)
    first := list.push(handed, 101)
    second := list.push(handed, 202)
    count := list.length(first) - 1
    read := [list.length(handed), or(list.at(handed, count), missing()), or(list.at(first, count), missing()), or(list.at(second, count), missing()), or(list.at(handed, count), missing())]
    expected := [drawn.number(draw, 7), missing(), 101, 202, missing()]
    var why = ""
    if read != expected {
        why = "the lists read back as " + shown(read)
    }
    Tried { case: shown(handed), why: why }
}

/// Fewer than `bound` whole numbers from -99 to 99.
// example: list.length(smalls_of(drawn.seeded(1), 3)) < 3
fn smalls_of(draw: drawn.Draw, bound: Int) -> List<Int> {
    var values = []
    var at = drawn.next(drawn.next(draw))
    for list.length(values) < drawn.number(draw, bound) {
        values = list.push(values, small(at))
        at = drawn.next(at)
    }
    values
}

/// A whole number from -99 to 99.
// example: small(drawn.seeded(1)) >= -99
fn small(draw: drawn.Draw) -> Int {
    drawn.number(draw, 199) - 99
}

/// What a read of a key or an index that holds nothing gives, which no drawn value is.
// example: missing() == -1000
fn missing() -> Int {
    -1000
}

/// One case of a property: the drawn input as text, and why it failed, which is `""` where it held.
type Tried = {
    case: String
    why: String
}

/// One key to put a value in at, and the value.
type Put = {
    key: Int
    value: Int
}

/// The keys of a wide case, and the map and the set they went into.
type Wide = {
    keys: List<List<Int>>
    held_map: map.Map<List<Int>, Int>
    seen: set.Set<List<Int>>
}

/// Each property of the collections.
type Property =
    | MapReadsBack
    | SetHoldsWhatWentIn
    | WideKeysReadBack
    | ListReadsBack
    | PushLeavesTheList
