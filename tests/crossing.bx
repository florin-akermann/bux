// The invariants of a declaration that reaches a JVM member, checked on drawn modules.
//
// `docs/specs/interop.md` states what an `extern` may say and what each spelling reaches,
// and `docs/specs/io.md` names every class the library modules reach.
import checking
import compiled
import drawn
import held
import ir
import jvm
import list
import strings

// example: held.is_held(a_call_into_a_library_module_reaches_that_module_s_class_and_nothing_else(0, ir.little_library()))
fn a_call_into_a_library_module_reaches_that_module_s_class_and_nothing_else(cases: Int, library: ir.Library) -> held.Held {
    checked(property: IntoTheLibrary, cases: cases, library: library)
}

// example: held.is_held(every_class_a_library_module_reaches_is_one_the_spec_names(0, ir.little_library()))
fn every_class_a_library_module_reaches_is_one_the_spec_names(cases: Int, library: ir.Library) -> held.Held {
    checked(property: SpecNamed, cases: cases, library: library)
}

// example: held.is_held(a_declaration_guards_a_span_exactly_where_it_gives_back_a_result(0, ir.little_library()))
fn a_declaration_guards_a_span_exactly_where_it_gives_back_a_result(cases: Int, library: ir.Library) -> held.Held {
    checked(property: Guarded, cases: cases, library: library)
}

// example: held.is_held(a_result_leaves_an_ok_down_the_path_taken_and_an_err_down_the_one_thrown(0, ir.little_library()))
fn a_result_leaves_an_ok_down_the_path_taken_and_an_err_down_the_one_thrown(cases: Int, library: ir.Library) -> held.Held {
    checked(property: BothPaths, cases: cases, library: library)
}

// example: held.is_held(a_declaration_written_with_a_width_reaches_its_member_for_one_and_leaves_a_long(0, ir.little_library()))
fn a_declaration_written_with_a_width_reaches_its_member_for_one_and_leaves_a_long(cases: Int, library: ir.Library) -> held.Held {
    checked(property: Widened, cases: cases, library: library)
}

// example: held.is_held(a_narrowed_argument_outside_the_int_range_answers_none_and_reaches_no_member(0, ir.little_library()))
fn a_narrowed_argument_outside_the_int_range_answers_none_and_reaches_no_member(cases: Int, library: ir.Library) -> held.Held {
    checked(property: Narrowed, cases: cases, library: library)
}

// example: held.is_held(a_method_on_a_type_written_interface_is_called_the_way_the_jvm_calls_an_interface_s(0, ir.little_library()))
fn a_method_on_a_type_written_interface_is_called_the_way_the_jvm_calls_an_interface_s(cases: Int, library: ir.Library) -> held.Held {
    checked(property: Interface, cases: cases, library: library)
}

// example: checked(property: Guarded, cases: 0, library: ir.little_library()).cases == 0
fn checked(property: Property, cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        let seed = drawn.seed_of(case)
        let one = drawing(property: property, draw: drawn.seeded(seed), library: library)
        found = compiled.noted(found, one.why, held.drawn_failure(name_of(property), seed, one.source, one.why))
        case += 1
    }
    found
}

// example: drawing(property: Guarded, draw: drawn.seeded(1), library: ir.little_library()).source != ""
fn drawing(property: Property, draw: drawn.Draw, library: ir.Library) -> Drawing {
    match property {
        IntoTheLibrary => into_the_library(draw, library)
        SpecNamed => spec_named(draw, library)
        Guarded => guarded(draw, library)
        BothPaths => both_paths(draw, library)
        Widened => widened(draw, library)
        Narrowed => narrowed(draw, library)
        Interface => interface(draw, library)
    }
}

// example: name_of(Guarded) == "a_declaration_guards_a_span_exactly_where_it_gives_back_a_result"
fn name_of(property: Property) -> String {
    match property {
        IntoTheLibrary => "a_call_into_a_library_module_reaches_that_module_s_class_and_nothing_else"
        SpecNamed => "every_class_a_library_module_reaches_is_one_the_spec_names"
        Guarded => "a_declaration_guards_a_span_exactly_where_it_gives_back_a_result"
        BothPaths => "a_result_leaves_an_ok_down_the_path_taken_and_an_err_down_the_one_thrown"
        Widened => "a_declaration_written_with_a_width_reaches_its_member_for_one_and_leaves_a_long"
        Narrowed => "a_narrowed_argument_outside_the_int_range_answers_none_and_reaches_no_member"
        Interface => "a_method_on_a_type_written_interface_is_called_the_way_the_jvm_calls_an_interface_s"
    }
}

// example: into_the_library(drawn.seeded(1), ir.little_library()).source != ""
fn into_the_library(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let at = drawn.number(draw, 8)
    let call = or(list.at(["io.print(text)", "io.println(text)", "_ = files.read(text)", "_ = files.write(text, text)", "_ = files.listed(text)", "_ = files.made(text)", "_ = files.removed(text)", "_ = environment.read(text)"], at), "")
    let module = or(list.at(["io", "io", "files", "files", "files", "files", "files", "environment"], at), "")
    let source = "import " + module + "\n\nfn go(text: String) -> () {\n    " + call + "\n}\n"
    let lowered = compiled.lowered_alone(source, library)
    var why = refused(lowered)
    for reached in compiled.reached_in(compiled.instructions_of(lowered, "go")) {
        if !list.has_value(["bux/library/environment", "bux/library/files", "bux/library/io"], reached) {
            why = "it reaches " + reached + ", which is no library module"
        }
    }
    Drawing { source: source, why: why }
}

// example: refused([]) == "the compiler refused it"
fn refused(lowered: List<ir.Lowered>) -> String {
    if list.length(lowered) == 0 {
        return "the compiler refused it"
    }
    ""
}

// example: spec_named(drawn.seeded(1), ir.little_library()).source != ""
fn spec_named(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let at = drawn.number(draw, 3)
    let module = or(list.at(["environment", "files", "io"], at), "")
    let call = or(list.at(["_ = environment.read(text)", "_ = files.read(text)", "io.println(text)"], at), "")
    let source = "import " + module + "\n\nfn go(text: String) -> () {\n    " + call + "\n}\n"
    let classes = compiled.module_classes(compiled.lowered_alone(source, library), "bux/library/" + module)
    var why = ""
    if list.length(classes) == 0 {
        why = "it writes no class of " + module
    }
    for class in classes {
        for method in class.methods {
            why = unnamed_why(compiled.reached_in(compiled.spelled_of(method, class).instructions), why)
        }
    }
    Drawing { source: source, why: why }
}

// example: unnamed_why(["java/lang/String", "bux/library/files"], "") == ""
// example: unnamed_why(["java/net/Socket"], "") == "it reaches java/net/Socket, which the spec does not name"
fn unnamed_why(reached: List<String>, why: String) -> String {
    for class in reached {
        if is_java(class) && !list.has_value(spec_classes(), class) {
            return "it reaches " + class + ", which the spec does not name"
        }
    }
    why
}

// example: is_java("java/io/File")
// example: !is_java("bux/List")
fn is_java(class: String) -> Bool {
    or(strings.cut(class, 0, 5), "") == "java/"
}

// The last classes are parts of the class file itself: a boxed `Bool`, the catch type of a guard,
// the arm that no value reaches, and the boxes of a character and of a whole number.
// example: list.length(spec_classes()) == 24
fn spec_classes() -> List<String> {
    ["java/lang/String", "java/lang/System", "java/io/PrintStream", "java/io/PrintWriter", "java/io/File", "java/nio/file/Path", "java/nio/file/Files", "java/nio/charset/Charset", "java/nio/charset/StandardCharsets", "java/util/stream/Stream", "java/util/List", "java/util/Iterator", "java/io/FileInputStream", "java/io/FileOutputStream", "java/nio/channels/FileChannel", "java/nio/ByteBuffer", "java/nio/CharBuffer", "java/lang/Object", "java/lang/Boolean", "java/lang/Throwable", "java/lang/AssertionError", "java/lang/Character", "java/lang/Long", "java/lang/Runtime"]
}

// example: guarded(drawn.seeded(1), ir.little_library()).source != ""
fn guarded(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let at = drawn.number(draw, 4)
    let wrap = drawn.picked(drawn.next(draw), ["{held}", "Option<{held}>", "Result<{held}, String>"], "")
    let result = compiled.replaced(wrap, "{held}", or(list.at(reached_types(), at), ""))
    let source = declaring(declared: or(list.at(reaching(), at), ""), result: result)
    let body = or(compiled.body_of(compiled.lowered_alone(source, library), or(list.at(reaching_names(), at), "")), compiled.no_spelled())
    var guards = 0
    if or(strings.cut(result, 0, 7), "") == "Result<" {
        guards = 1
    }
    var why = ""
    if list.length(body.guards) != guards {
        why = "it guards " + shown(list.length(body.guards)) + " spans, not " + shown(guards)
    }
    for guard in body.guards {
        if jvm.class_of(guard.catching) != "java/lang/Throwable" {
            why = "a guard catches " + jvm.class_of(guard.catching)
        }
    }
    Drawing { source: source, why: why }
}

// example: both_paths(drawn.seeded(1), ir.little_library()).source != ""
fn both_paths(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let at = drawn.number(draw, 4)
    let result = "Result<" + or(list.at(reached_types(), at), "") + ", String>"
    let source = declaring(declared: or(list.at(reaching(), at), ""), result: result)
    let body = or(compiled.body_of(compiled.lowered_alone(source, library), or(list.at(reaching_names(), at), "")), compiled.no_spelled())
    Drawing { source: source, why: paths_why(body) }
}

// example: list.length(reaching()) == 4
fn reaching() -> List<String> {
    ["extern field held() -> {result} = \"java.lang.System.out\"", "extern static worded(value: Int) -> {result} = \"java.lang.String.valueOf\"", "extern method trimmed(text: String) -> {result} = \"trim\"", "extern new named(path: String) -> {result}"]
}

// example: list.length(reached_types()) == 4
fn reached_types() -> List<String> {
    ["PrintStream", "String", "String", "File"]
}

// example: list.length(reaching_names()) == 4
fn reaching_names() -> List<String> {
    ["held", "worded", "trimmed", "named"]
}

// example: paths_why(compiled.no_spelled()) == "it guards 0 spans, not one"
fn paths_why(body: jvm.Spelled) -> String {
    if list.length(body.guards) != 1 {
        return "it guards " + shown(list.length(body.guards)) + " spans, not one"
    }
    let handler = or(list.at(body.guards, 0), ir.Guard { from: 0, to: 0, handler: 0, catching: ir.Anything }).handler
    let at = label_at(body.instructions, handler)
    let taken = results_built(compiled.part(body.instructions, 0, at))
    let thrown = results_built(compiled.part(body.instructions, at, list.length(body.instructions)))
    if at < 0 || taken != ["bux/Result$Ok"] || thrown != ["bux/Result$Err"] {
        return "it builds " + strings.join(taken, ", ") + " on the path taken, and " + strings.join(thrown, ", ") + " on the one thrown"
    }
    ""
}

// example: results_built([jvm.New("bux/Result$Ok"), jvm.New("bux/Option$None")]) == ["bux/Result$Ok"]
fn results_built(instructions: List<jvm.Instruction>) -> List<String> {
    var built = []
    for instruction in instructions {
        let class = class_made(instruction)
        if or(strings.cut(class, 0, 11), "") == "bux/Result$" {
            built = list.push(built, class)
        }
    }
    built
}

// example: class_made(jvm.New("a/B")) == "a/B"
// example: class_made(jvm.Copy) == ""
fn class_made(instruction: jvm.Instruction) -> String {
    match instruction {
        jvm.New(class) => class
        _ => ""
    }
}

// example: widened(drawn.seeded(1), ir.little_library()).source != ""
fn widened(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let at = drawn.number(draw, 3)
    let width = drawn.picked(drawn.next(draw), ["", "int ", "char "], "")
    let result = drawn.picked(drawn.next(drawn.next(draw)), ["Int", "Result<Int, String>"], "")
    let written = compiled.replaced(or(list.at(numbers(), at), ""), "{width}", width)
    let source = declaring(declared: written, result: result)
    let body = compiled.instructions_of(compiled.lowered_alone(source, library), or(list.at(["held", "worded", "trimmed"], at), ""))
    var gives = jvm.Long
    if width == "int " {
        gives = jvm.Integer
    }
    if width == "char " {
        gives = jvm.Character
    }
    Drawing { source: source, why: width_why(body: body, gives: gives, width: width) }
}

// example: list.length(numbers()) == 3
fn numbers() -> List<String> {
    ["extern field {width}held() -> {result} = \"java.lang.Integer.MAX_VALUE\"", "extern static {width}worded(text: String) -> {result} = \"java.lang.String.length\"", "extern method {width}trimmed(text: String) -> {result} = \"length\""]
}

// example: width_why(body: [], gives: jvm.Long, width: "") == "it reaches no member"
fn width_why(body: List<jvm.Instruction>, gives: jvm.Descriptor, width: String) -> String {
    let given = gives_back(body)
    if compiled.is_none(given) {
        return "it reaches no member"
    }
    if or(given, jvm.Array(jvm.Long)) != gives {
        return "it reaches a member for what it does not say that member gives back"
    }
    let widens = width != ""
    if has_widen(body) != widens {
        return "it widens: " + shown(has_widen(body)) + ", and a width is written: " + shown(widens)
    }
    ""
}

// example: has_widen([jvm.Widen])
// example: !has_widen([jvm.Narrow])
fn has_widen(body: List<jvm.Instruction>) -> Bool {
    for instruction in body {
        if is_widen(instruction) {
            return true
        }
    }
    false
}

// example: is_widen(jvm.Widen)
fn is_widen(instruction: jvm.Instruction) -> Bool {
    match instruction {
        jvm.Widen => true
        _ => false
    }
}

// example: narrowed(drawn.seeded(1), ir.little_library()).source != ""
fn narrowed(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let at = drawn.number(draw, 2)
    let taken = drawn.picked(drawn.next(draw), ["", "int "], "")
    let result = drawn.picked(drawn.next(drawn.next(draw)), ["Option<String>", "Result<Option<String>, String>"], "")
    let written = compiled.replaced(or(list.at(taking(), at), ""), "{taken}", taken)
    let source = declaring(declared: written, result: result)
    let body = compiled.instructions_of(compiled.lowered_alone(source, library), or(list.at(["worded", "charred"], at), ""))
    Drawing { source: source, why: narrowing_why(body: body, taken: taken) }
}

// example: declaring(declared: "a {result}", result: "Int") == "a Int\n\nextern type PrintStream = \"java.io.PrintStream\"\n\nextern type File = \"java.io.File\"\n"
fn declaring(declared: String, result: String) -> String {
    compiled.replaced(declared, "{result}", result) + "\n\nextern type PrintStream = \"java.io.PrintStream\"\n\nextern type File = \"java.io.File\"\n"
}

// example: list.length(taking()) == 2
fn taking() -> List<String> {
    ["extern static worded({taken}index: Int) -> {result} = \"java.lang.String.valueOf\"", "extern method charred(text: String, {taken}index: Int) -> {result} = \"substring\""]
}

// example: narrowing_why(body: [], taken: "") == "it reaches no member"
fn narrowing_why(body: List<jvm.Instruction>, taken: String) -> String {
    let narrows = taken != ""
    if compiled.is_none(gives_back(body)) {
        return "it reaches no member"
    }
    if has_narrow(body) != narrows {
        return "it narrows: " + shown(has_narrow(body)) + ", and a narrowing is written: " + shown(narrows)
    }
    let unfit = label_at(body, 4)
    if (unfit >= 0) != narrows {
        return "an unfit argument lands somewhere: " + shown(unfit >= 0) + ", and a narrowing is written: " + shown(narrows)
    }
    for reached in compiled.reached_in(answered_from(body, unfit)) {
        if or(strings.cut(reached, 0, 4), "") != "bux/" {
            return "an argument outside the `int` range reaches " + reached
        }
    }
    ""
}

// example: label_at([jvm.Copy, jvm.Label(3)], 3) == 1
// example: label_at([], 3) == -1
fn label_at(instructions: List<jvm.Instruction>, label: Int) -> Int {
    var at = 0
    for instruction in instructions {
        if is_label(instruction, label) {
            return at
        }
        at += 1
    }
    -1
}

// example: is_label(jvm.Label(2), 2)
// example: !is_label(jvm.Jump(2), 2)
fn is_label(instruction: jvm.Instruction, label: Int) -> Bool {
    match instruction {
        jvm.Label(written) => written == label
        _ => false
    }
}

// example: compiled.is_none(gives_back([jvm.Copy]))
fn gives_back(body: List<jvm.Instruction>) -> Option<jvm.Descriptor> {
    for instruction in body {
        let given = member_gives(instruction)
        if !compiled.is_none(given) {
            return given
        }
    }
    None
}

// example: compiled.is_none(member_gives(jvm.Copy))
fn member_gives(instruction: jvm.Instruction) -> Option<jvm.Descriptor> {
    match instruction {
        jvm.GetStatic(field) => Some(field.of)
        _ => result_of(compiled.called(instruction))
    }
}

// example: compiled.is_none(result_of(None))
fn result_of(reference: Option<jvm.MethodRef>) -> Option<jvm.Descriptor> {
    match reference {
        Some(one) => one.descriptor.result
        None => None
    }
}

// example: has_narrow([jvm.Narrow])
// example: !has_narrow([jvm.Widen])
fn has_narrow(body: List<jvm.Instruction>) -> Bool {
    for instruction in body {
        if is_narrow(instruction) {
            return true
        }
    }
    false
}

// example: is_narrow(jvm.Narrow)
fn is_narrow(instruction: jvm.Instruction) -> Bool {
    match instruction {
        jvm.Narrow => true
        _ => false
    }
}

// example: list.length(answered_from([jvm.Copy, jvm.Return(None), jvm.Copy], 0)) == 2
// example: list.length(answered_from([jvm.Copy], -1)) == 0
fn answered_from(body: List<jvm.Instruction>, from: Int) -> List<jvm.Instruction> {
    if from < 0 {
        return []
    }
    var path = []
    for instruction in compiled.part(body, from, list.length(body)) {
        path = list.push(path, instruction)
        if is_return(instruction) {
            return path
        }
    }
    path
}

// example: is_return(jvm.Return(None))
fn is_return(instruction: jvm.Instruction) -> Bool {
    match instruction {
        jvm.Return(_) => true
        _ => false
    }
}

// example: interface(drawn.seeded(1), ir.little_library()).source != ""
fn interface(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let class = drawn.picked(draw, ["", "interface "], "")
    let source = "extern method to_path(file: File) -> File = \"toPath\"\n\nextern type " + class + "File = \"java.io.File\"\n"
    let body = compiled.instructions_of(compiled.lowered_alone(source, library), "to_path")
    var why = "it calls no member"
    for instruction in body {
        if why == "it calls no member" && !compiled.is_none(compiled.called(instruction)) {
            why = interface_why(instruction, class)
        }
    }
    Drawing { source: source, why: why }
}

// example: interface_why(jvm.InvokeInterface(jvm.MethodRef { class: "a", name: "b", descriptor: jvm.MethodDescriptor { parameters: [], result: None } }), "interface ") == ""
fn interface_why(call: jvm.Instruction, class: String) -> String {
    let is_an_interface = class != ""
    if is_interface_call(call) != is_an_interface {
        return "it is called as an interface: " + shown(is_interface_call(call)) + ", and the type is one: " + shown(is_an_interface)
    }
    ""
}

// example: !is_interface_call(jvm.Copy)
fn is_interface_call(instruction: jvm.Instruction) -> Bool {
    match instruction {
        jvm.InvokeInterface(_) => true
        _ => false
    }
}

type Drawing = {
    source: String
    why: String
}

type Property =
    | IntoTheLibrary
    | SpecNamed
    | Guarded
    | BothPaths
    | Widened
    | Narrowed
    | Interface

test "a call into a library module reaches that module's class and nothing else" {
    held.is_held_reported(a_call_into_a_library_module_reaches_that_module_s_class_and_nothing_else(held.drawn_cases(), checking.carried_library()))
}

test "every class a library module reaches is one the spec names" {
    held.is_held_reported(every_class_a_library_module_reaches_is_one_the_spec_names(held.drawn_cases(), checking.carried_library()))
}

test "a declaration guards a span exactly where it gives back a result" {
    held.is_held_reported(a_declaration_guards_a_span_exactly_where_it_gives_back_a_result(held.drawn_cases(), checking.carried_library()))
}

test "a result leaves an ok down the path taken and an err down the one thrown" {
    held.is_held_reported(a_result_leaves_an_ok_down_the_path_taken_and_an_err_down_the_one_thrown(held.drawn_cases(), checking.carried_library()))
}

test "a declaration written with a width reaches its member for one and leaves a long" {
    held.is_held_reported(a_declaration_written_with_a_width_reaches_its_member_for_one_and_leaves_a_long(held.drawn_cases(), checking.carried_library()))
}

test "a narrowed argument outside the int range answers none and reaches no member" {
    held.is_held_reported(a_narrowed_argument_outside_the_int_range_answers_none_and_reaches_no_member(held.drawn_cases(), checking.carried_library()))
}

test "a method on a type written interface is called the way the jvm calls an interface's" {
    held.is_held_reported(a_method_on_a_type_written_interface_is_called_the_way_the_jvm_calls_an_interface_s(held.drawn_cases(), checking.carried_library()))
}
