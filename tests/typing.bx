// The drawn properties of the type inference over whole modules, which `docs/specs/types.md` and
// `docs/specs/arguments.md` state.
//
// Each case draws a module from a fixed seed and checks it in-process with `src/types.bx`
// against the prelude the compiler carries. A failure names the seed and the module it drew.
import ast
import checking
import command
import drawn
import held
import infer
import ir
import lexer
import list
import strings
import types

// example: held.is_held(inference_is_deterministic(2, ir.little_library()))
fn inference_is_deterministic(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "inference_is_deterministic", seed, deterministic_tried(drawn.seeded(seed), library))
    }
    found
}

// example: deterministic_tried(drawn.seeded(1), ir.little_library()).why == ""
fn deterministic_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    let source = drawn_module(draw)
    let once = answer_text(checking.checked(source, library))
    let again = answer_text(checking.checked(source, library))
    if once != again {
        return checking.Tried { input: source, why: "one check gave " + held.quoted(once) + " and the next gave " + held.quoted(again) }
    }
    checking.Tried { input: source, why: "" }
}

// example: answer_text(checking.checked("fn one() -> Int {\n    1\n}\n", ir.little_library())) == "fn one() -> Int\n"
fn answer_text(answer: Result<infer.Inference, command.Diagnostic>) -> String {
    match answer {
        Ok(inference) => types.page_of(inference)
        Err(refused) => refused.code + " " + shown(refused.span.start) + " " + refused.message
    }
}

// example: held.is_held(a_call_in_front_is_refused_for_the_plain_call(2, ir.little_library()))
fn a_call_in_front_is_refused_for_the_plain_call(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "a_call_in_front_is_refused_for_the_plain_call", seed, call_tried(drawn.seeded(seed), library))
    }
    found
}

// example: call_tried(drawn.seeded(1), ir.little_library()).why == ""
fn call_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    let first = drawn.picked(draw, ["count", "1", "twice(count)"], "count")
    let rest = drawn.picked(drawn.next(draw), ["said", "\"hi\""], "said")
    let in_front = first + ".held(" + rest + ")"
    let plain = "held(" + first + ", " + rest + ")"
    let refused = checking.checked(calling(in_front), library)
    let said = checking.code_of(refused) + " " + help_given(refused)
    if said != "L0433 write `" + plain + "`" {
        return checking.Tried { input: in_front, why: "in front it gives " + held.quoted(said) }
    }
    checking.Tried { input: in_front, why: checking.code_of(checking.checked(calling(plain), library)) }
}

// example: help_given(checking.checked("fn one() -> Int {\n    1\n}\n", ir.little_library())) == ""
fn help_given(answer: Result<infer.Inference, command.Diagnostic>) -> String {
    match answer {
        Ok(_) => ""
        Err(refused) => or(refused.help, "")
    }
}

// example: strings.length(calling("held(1, said)")) > 0
fn calling(call: String) -> String {
    "fn go(count: Int, said: String) -> String {\n    let answer = " + call + "\n    _ = count\n    _ = said\n    answer\n}\n\nfn held(count: Int, said: String) -> String {\n    _ = count\n    said\n}\n\nfn twice(count: Int) -> Int {\n    count + count\n}\n"
}

// example: held.is_held(a_module_of_pieces_infers(2, ir.little_library()))
fn a_module_of_pieces_infers(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        let source = checking.module_of(drawn.seeded(seed), pieces())
        found = checking.noted(found, "a_module_of_pieces_infers", seed, checking.Tried { input: source, why: refusal_text(checking.checked(source, library)) })
    }
    found
}

// example: held.is_held(a_refusal_points_inside_the_source(2, ir.little_library()))
fn a_refusal_points_inside_the_source(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "a_refusal_points_inside_the_source", seed, refusal_tried(drawn.seeded(seed), library))
    }
    found
}

// example: refusal_tried(drawn.seeded(1), ir.little_library()).why == ""
fn refusal_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    let refused = drawn.picked(draw, refusals(), "")
    let source = checking.module_of(drawn.next(draw), pieces()) + "\n\n" + refused + "\n"
    match checking.checked(source, library) {
        Ok(_) => checking.Tried { input: source, why: "it is accepted" }
        Err(refusal) => checking.Tried { input: source, why: checking.outside(refusal.span, source) }
    }
}

// example: held.is_held(every_expression_has_a_type(2, ir.little_library()))
fn every_expression_has_a_type(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        let source = checking.module_of(drawn.seeded(seed), pieces())
        found = checking.noted(found, "every_expression_has_a_type", seed, checking.Tried { input: source, why: first_untyped(source, library) })
    }
    found
}

// example: first_untyped("fn one() -> Int {\n    1\n}\n", ir.little_library()) == ""
fn first_untyped(source: String, library: ir.Library) -> String {
    match checking.checked(source, library) {
        Ok(inference) => untyped_in(inference, source)
        Err(refused) => "refused: " + refused.message
    }
}

// example: untyped_in(or_nothing(checking.checked("fn one() -> Int {\n    1\n}\n", ir.little_library())), "fn one() -> Int {\n    1\n}\n") == ""
fn untyped_in(inference: infer.Inference, source: String) -> String {
    for written in expressions(inference.resolved.program) {
        if checking.type_in(Ok(inference), written.span) == "no type" {
            return held.quoted(text_at(source, written)) + " has no type"
        }
    }
    ""
}

// example: held.is_held(no_expression_is_left_unsettled(2, ir.little_library()))
fn no_expression_is_left_unsettled(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        let source = checking.module_of(drawn.seeded(seed), pieces())
        found = checking.noted(found, "no_expression_is_left_unsettled", seed, checking.Tried { input: source, why: first_unsettled(source, library) })
    }
    found
}

// example: first_unsettled("fn one() -> Int {\n    1\n}\n", ir.little_library()) == ""
fn first_unsettled(source: String, library: ir.Library) -> String {
    match checking.checked(source, library) {
        Ok(inference) => unsettled_in(inference, source)
        Err(refused) => "refused: " + refused.message
    }
}

// example: unsettled_in(or_nothing(checking.checked("fn one() -> Int {\n    1\n}\n", ir.little_library())), "fn one() -> Int {\n    1\n}\n") == ""
fn unsettled_in(inference: infer.Inference, source: String) -> String {
    for written in expressions(inference.resolved.program) {
        let found = checking.type_in(Ok(inference), written.span)
        if checking.occurrence(found, "_", 1).start >= 0 {
            return held.quoted(text_at(source, written)) + " was left unsettled as " + found
        }
    }
    ""
}

// example: list.length(or_nothing(checking.checked("fn (", ir.little_library())).resolved.program.items) == 0
fn or_nothing(answer: Result<infer.Inference, command.Diagnostic>) -> infer.Inference {
    ok_or(answer, infer.nothing_inferred())
}

// example: text_at("ab", ast.Expr { kind: ast.Unit, span: checking.occurrence("ab", "b", 1) }) == "b"
fn text_at(source: String, written: ast.Expr) -> String {
    or(strings.cut(source, written.span.start, written.span.start + written.span.length), "")
}

// example: held.is_held(a_generic_is_general_enough_for_any_two_uses(2, ir.little_library()))
fn a_generic_is_general_enough_for_any_two_uses(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "a_generic_is_general_enough_for_any_two_uses", seed, generic_tried(drawn.seeded(seed), library))
    }
    found
}

// example: generic_tried(drawn.seeded(1), ir.little_library()).why == ""
fn generic_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    let first = drawn.picked(draw, values(), Valued { written: "1", of: "Int" })
    let second = drawn.picked(drawn.next(draw), values(), Valued { written: "1", of: "Int" })
    let source = "fn is_general() -> " + second.of + " {\n    _ = given(" + first.written + ")\n    given(" + second.written + ")\n}\n\nfn given<T>(value: T) -> T {\n    value\n}\n"
    let once = checking.type_written(source, "given(" + first.written + ")", 1, library)
    let twice = checking.type_written(source, "given(" + second.written + ")", 1, library)
    if once != first.of || twice != second.of {
        return checking.Tried { input: source, why: "the uses are " + once + " and " + twice }
    }
    checking.Tried { input: source, why: "" }
}

// example: list.length(values()) == 3
fn values() -> List<Valued> {
    [Valued { written: "1", of: "Int" }, Valued { written: "\"two\"", of: "String" }, Valued { written: "true", of: "Bool" }]
}

// example: held.is_held(a_ring_of_records_is_refused_whatever_its_length(2, ir.little_library()))
fn a_ring_of_records_is_refused_whatever_its_length(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "a_ring_of_records_is_refused_whatever_its_length", seed, ring_tried(drawn.seeded(seed), library))
    }
    found
}

// example: ring_tried(drawn.seeded(1), ir.little_library()).why == ""
fn ring_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    let many = drawn.number(draw, 5) + 1
    let source = along(many: many, last: "Room")
    let message = checking.message_of(checking.checked(source, library))
    let opens = checking.occurrence(message, "`Room` holds ", 1).start == 0
    let closes = is_ending_in(text: message, ending: "`Room`")
    if !opens || !closes || times_written(text: message, piece: ", which holds ") != many - 1 {
        return checking.Tried { input: source, why: "the refusal says " + held.quoted(message) }
    }
    checking.Tried { input: source, why: "" }
}

// example: held.is_held(a_chain_of_records_is_accepted(2, ir.little_library()))
fn a_chain_of_records_is_accepted(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        let source = along(many: drawn.number(drawn.seeded(seed), 5) + 1, last: "Int")
        found = checking.noted(found, "a_chain_of_records_is_accepted", seed, checking.Tried { input: source, why: refusal_text(checking.checked(source, library)) })
    }
    found
}

// example: held.is_held(an_option_of_unit_is_refused_where_it_is_reached(2, ir.little_library()))
fn an_option_of_unit_is_refused_where_it_is_reached(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "an_option_of_unit_is_refused_where_it_is_reached", seed, carrying_tried(drawn.seeded(seed), library))
    }
    found
}

// example: carrying_tried(drawn.seeded(1), ir.little_library()).why == ""
fn carrying_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    let shape = drawn.picked(draw, carryings(), Carrying { refused: "", accepted: "", at: "" })
    let above = checking.module_of(drawn.next(draw), pieces()) + "\n\n"
    let source = above + shape.refused + "\n"
    let answer = checking.checked(source, library)
    let at = checking.occurrence(source, shape.at, 1)
    let span = refused_span(answer)
    if checking.code_of(answer) != "L0432" || span.start != at.start || span.length != at.length {
        return checking.Tried { input: source, why: "the refusal is " + refusal_text(answer) + " at " + shown(span) + ", not at " + shown(at) }
    }
    let accepted = above + shape.accepted + "\n"
    if !checking.is_accepted(accepted, library) {
        return checking.Tried { input: accepted, why: "the shape with `Bool` is refused: " + refusal_text(checking.checked(accepted, library)) }
    }
    checking.Tried { input: source, why: "" }
}

// example: refused_span(Ok(1)).start == -1
fn refused_span<T>(answer: Result<T, command.Diagnostic>) -> lexer.Span {
    match answer {
        Ok(_) => lexer.Span { start: -1, length: 0 }
        Err(refused) => refused.span
    }
}

// example: list.length(carryings()) == 6
fn carryings() -> List<Carrying> {
    let given = "\n\nfn is_given(given: ()) -> Bool {\n    _ = given\n    true\n}"
    let given_flag = "\n\nfn is_given(given: Bool) -> Bool {\n    given\n}"
    let matched = " {\n        Some(inside) => is_given(inside)\n        None => false\n    }\n}"
    let first = "\n\nfn first<T>(items: List<T>) -> Option<T> {\n    for item in items {\n        return Some(item)\n    }\n    None\n}"
    [Carrying { refused: "fn is_held(maybe: Option<()>) -> Bool {\n    match maybe {\n        Some(_) => true\n        None => false\n    }\n}", accepted: "fn is_held(maybe: Option<Bool>) -> Bool {\n    match maybe {\n        Some(_) => true\n        None => false\n    }\n}", at: "Option<()>" }, Carrying { refused: "type Held = {\n    maybe: Option<()>\n}", accepted: "type Held = {\n    maybe: Option<Bool>\n}", at: "Option<()>" }, Carrying { refused: "fn held() -> List<Option<()>> {\n    []\n}", accepted: "fn held() -> List<Option<Bool>> {\n    []\n}", at: "Option<()>" }, Carrying { refused: "fn is_there() -> Bool {\n    match Some(()) {\n        Some(_) => true\n        None => false\n    }\n}", accepted: "fn is_there() -> Bool {\n    match Some(true) {\n        Some(_) => true\n        None => false\n    }\n}", at: "Some(())" }, Carrying { refused: "fn is_there() -> Bool {\n    match None" + matched + given, accepted: "fn is_there() -> Bool {\n    match None" + matched + given_flag, at: "None" }, Carrying { refused: "fn is_first_given(all: List<()>) -> Bool {\n    match first(all)" + matched + first + given, accepted: "fn is_first_given(all: List<Bool>) -> Bool {\n    match first(all)" + matched + first + given_flag, at: "first(all)" }]
}

// example: refusal_text(Ok(1)) == ""
fn refusal_text<T>(answer: Result<T, command.Diagnostic>) -> String {
    match answer {
        Ok(_) => ""
        Err(refused) => refused.code + " " + refused.message
    }
}

// example: along(many: 1, last: "Int") == "fn counted(held: Room) -> Int {\n    held.count\n}\n\ntype Room = {\n    count: Int\n    next: Int\n}\n"
fn along(many: Int, last: String) -> String {
    var source = "fn counted(held: Room) -> Int {\n    held.count\n}\n"
    var at = 0
    for at < many {
        var holds = last
        if at + 1 < many {
            holds = or(list.at(ringed(), at + 1), last)
        }
        source += "\ntype " + or(list.at(ringed(), at), "") + " = {\n    count: Int\n    next: " + holds + "\n}\n"
        at += 1
    }
    source
}

// example: list.length(ringed()) == 5
fn ringed() -> List<String> {
    ["Room", "Wing", "Floor", "Plan", "Site"]
}

// example: times_written(text: "a, b, c", piece: ", ") == 2
fn times_written(text: String, piece: String) -> Int {
    var count = 0
    for checking.occurrence(text, piece, count + 1).start >= 0 {
        count += 1
    }
    count
}

// example: is_ending_in(text: "ab", ending: "b")
// example: !is_ending_in(text: "ab", ending: "a")
fn is_ending_in(text: String, ending: String) -> Bool {
    let from = strings.length(text) - strings.length(ending)
    from >= 0 && or(strings.cut(text, from, strings.length(text)), "") == ending
}

// example: strings.length(drawn_module(drawn.seeded(1))) > 0
fn drawn_module(draw: drawn.Draw) -> String {
    let one = drawn_parameter(draw: draw, named: "one")
    let other = drawn_parameter(draw: checking.after(draw, 2), named: "other")
    let result = drawn.picked(checking.after(draw, 4), drawn_types(), "Int")
    let body = drawn_body(checking.after(draw, 5))
    "fn check(" + one + ", " + other + ") -> " + result + " {\n" + body + "}\n\nfn pick<T>(first: T, second: T) -> T {\n    first\n}\n\ntype Box = {\n    held: Int\n}\n"
}

// example: drawn_parameter(draw: drawn.seeded(1), named: "one") != ""
fn drawn_parameter(draw: drawn.Draw, named: String) -> String {
    named + ": " + drawn.picked(drawn.next(draw), drawn_types(), "Int")
}

// example: strings.length(drawn_body(drawn.seeded(1))) > 0
fn drawn_body(draw: drawn.Draw) -> String {
    var body = ""
    var at = drawn.next(draw)
    for index in checking.numbers_below(drawn.number(draw, 3)) {
        body += "    let held" + shown(index) + " = " + drawn_expression(at) + "\n"
        at = drawn.next(at)
    }
    if drawn.number(at, 2) == 0 {
        return body + "    " + drawn_expression(drawn.next(at)) + "\n"
    }
    body + "    match " + drawn_expression(checking.after(at, 1)) + " {\n        1 => " + drawn_expression(checking.after(at, 2)) + "\n        _ => " + drawn_expression(checking.after(at, 3)) + "\n    }\n"
}

// example: strings.length(drawn_expression(drawn.seeded(1))) > 0
fn drawn_expression(draw: drawn.Draw) -> String {
    drawn.picked(draw, ["one", "other", "1", "\"text\"", "one + other", "one == other", "one < 2", "one / 0", "one / other", "Some(one)", "[one, other]", "one?", "Box { held: one }", "one.held", "pick(one, other)", "!one"], "one")
}

// example: list.length(drawn_types()) == 6
fn drawn_types() -> List<String> {
    ["Int", "Bool", "String", "Option<Int>", "List<Int>", "Box"]
}

// Each piece infers alone and declares its own names, so any set of pieces is a module that infers.
// example: list.length(pieces()) == 6
fn pieces() -> List<String> {
    ["type UserId = UserId(Int)", "fn is_open(user: User) -> Bool {\n    user.active\n}\n\ntype User = {\n    id: Int\n    active: Bool\n}\n", "fn identity<T>(value: T) -> T {\n    value\n}", "fn total(counts: List<Int>) -> Int {\n    var sum = 0\n    for count in counts {\n        sum += count\n    }\n    sum\n}", "fn shout(word: String) -> String {\n    word + \"!\"\n}", "fn describe(payment: Payment) -> String {\n    match payment {\n        Pending => \"waiting\"\n        Failed(reason) => reason\n    }\n}\n\ntype Payment =\n    | Pending\n    | Failed(String)\n"]
}

// example: list.length(refusals()) == 4
fn refusals() -> List<String> {
    ["fn refused() -> Int {\n    \"seven\"\n}", "fn refused<T>(value: T) -> T {\n    1\n}", "fn is_refused(flag: Bool) -> Bool {\n    flag + flag\n}", "fn refused(value: Int) -> Int {\n    value.missing\n}"]
}

// example: list.length(expressions(or_nothing(checking.checked("fn one() -> Int {\n    1 + 2\n}\n", ir.little_library())).resolved.program)) == 3
fn expressions(program: ast.Program) -> List<ast.Expr> {
    var found = []
    for item in program.items {
        found = both(first: found, second: in_function(item))
    }
    found
}

// example: list.length(in_function(ast.Import(ast.ImportDeclaration { module: ast.Name { text: "io", span: checking.occurrence("io", "io", 1) }, span: checking.occurrence("io", "io", 1) }))) == 0
fn in_function(item: ast.Item) -> List<ast.Expr> {
    match item {
        ast.Function(function) => in_block(function.body)
        _ => []
    }
}

// example: list.length(in_block(ast.Block { statements: [], span: checking.occurrence("", "", 1) })) == 0
fn in_block(block: ast.Block) -> List<ast.Expr> {
    var found = []
    for statement in block.statements {
        found = both(first: found, second: in_statement(statement))
    }
    found
}

// example: list.length(in_statement(ast.Statement { kind: ast.Break, span: checking.occurrence("", "", 1) })) == 0
fn in_statement(statement: ast.Statement) -> List<ast.Expr> {
    match statement.kind {
        ast.Binding { value } => from_expr(value)
        ast.Assign { value } => from_expr(value)
        ast.Return(value) => from_option(value)
        ast.For(looped) => both(first: in_header(looped.header), second: in_block(looped.body))
        ast.Discard(value) => from_expr(value)
        ast.Evaluated(value) => from_expr(value)
        _ => []
    }
}

// example: list.length(in_header(ast.Forever)) == 0
fn in_header(header: ast.ForHeader) -> List<ast.Expr> {
    match header {
        ast.Forever => []
        ast.While(condition) => from_expr(condition)
        ast.Over { iterable } => from_expr(iterable)
    }
}

// example: list.length(from_option(None)) == 0
fn from_option(value: Option<ast.Expr>) -> List<ast.Expr> {
    match value {
        Some(one) => from_expr(one)
        None => []
    }
}

// example: list.length(from_expr(ast.Expr { kind: ast.Unit, span: checking.occurrence("", "", 1) })) == 1
fn from_expr(written: ast.Expr) -> List<ast.Expr> {
    both(first: [written], second: inside(written))
}

// example: list.length(inside(ast.Expr { kind: ast.Unit, span: checking.occurrence("", "", 1) })) == 0
fn inside(written: ast.Expr) -> List<ast.Expr> {
    match written.kind {
        ast.Unary { operand } => from_expr(operand)
        ast.Binary { left, right } => both(first: from_expr(left), second: from_expr(right))
        ast.Call { callee, arguments } => both(first: from_expr(callee), second: from_all(passed(arguments)))
        ast.Field { receiver } => from_expr(receiver)
        ast.Try(inner) => from_expr(inner)
        ast.Written(elements) => from_all(elements)
        ast.Record { fields } => from_all(field_values(fields))
        ast.If(chain) => in_if(chain)
        ast.Match(matched) => both(first: from_expr(matched.scrutinee), second: from_all(arm_bodies(matched.arms)))
        ast.Spawn(started) => from_expr(started)
        _ => []
    }
}

// example: list.length(in_if(ast.IfExpr { branches: [], otherwise: None })) == 0
fn in_if(chain: ast.IfExpr) -> List<ast.Expr> {
    var found = []
    for branch in chain.branches {
        found = both(first: found, second: both(first: from_expr(branch.condition), second: in_block(branch.block)))
    }
    match chain.otherwise {
        Some(block) => both(first: found, second: in_block(block))
        None => found
    }
}

// example: list.length(from_all([])) == 0
fn from_all(written_ones: List<ast.Expr>) -> List<ast.Expr> {
    var found = []
    for value in written_ones {
        found = both(first: found, second: from_expr(value))
    }
    found
}

// example: list.length(passed(ast.Positional([]))) == 0
fn passed(arguments: ast.Arguments) -> List<ast.Expr> {
    match arguments {
        ast.Positional(given) => given
        ast.Named(named) => named_values(named)
    }
}

// example: list.length(named_values([])) == 0
fn named_values(named: List<ast.NamedArgument>) -> List<ast.Expr> {
    var found = []
    for one in named {
        found = list.push(found, one.value)
    }
    found
}

// example: list.length(field_values([])) == 0
fn field_values(fields: List<ast.FieldValue>) -> List<ast.Expr> {
    var found = []
    for one in fields {
        found = list.push(found, ast.field_expression(one))
    }
    found
}

// example: list.length(arm_bodies([])) == 0
fn arm_bodies(arms: List<ast.MatchArm>) -> List<ast.Expr> {
    var found = []
    for arm in arms {
        found = list.push(found, arm.body)
    }
    found
}

// example: list.length(both(first: [], second: [])) == 0
fn both(first: List<ast.Expr>, second: List<ast.Expr>) -> List<ast.Expr> {
    var found = first
    for one in second {
        found = list.push(found, one)
    }
    found
}

type Valued = {
    written: String
    of: String
}

// `at` is the first text in the module that the refusal points at.
type Carrying = {
    refused: String
    accepted: String
    at: String
}

