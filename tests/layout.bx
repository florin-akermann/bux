// The drawn properties of the formatter, which `docs/specs/formatting.md` states.
//
// Three kinds of input are drawn: a program of canonical items and one drawn expression, a file
// of items a person wrote out of canonical form, and one `extern` declaration. A tree is compared
// as `ast.printed` writes it, with each span taken out, because formatting moves every offset.
import drawn
import format
import held
import ir
import lexer
import list
import parser
import parsing
import strings
import walk

/// Every property of the formatter, each tried on `cases` drawn cases, in a fixed order.
// example: list.length(every_property(1, ir.little_library())) == 7
fn every_property(cases: Int, library: ir.Library) -> List<held.Held> {
    [every_extern_declaration_round_trips(cases), formatting_is_deterministic_and_idempotent(cases), formatting_keeps_the_tree(cases), every_comment_survives_in_source_order(cases), the_canonical_text_of_a_refusal_is_canonical(cases), every_spelling_canonical_form_advises_is_one_it_accepts(cases), a_declaration_below_a_test_is_out_of_place(cases)]
}

/// A drawn `extern` declaration is in canonical form: formatting writes it as it is written.
// example: held.is_held(every_extern_declaration_round_trips(3))
fn every_extern_declaration_round_trips(cases: Int) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        let source = declaration(drawn.seed_of(case))
        let canonical = ok_or(format.format(source), "refused")
        if canonical != source {
            found = held.with_failure(found, held.drawn_failure("every_extern_declaration_round_trips", drawn.seed_of(case), source, "formatting writes " + held.quoted(canonical)))
        }
        case += 1
    }
    found
}

/// One `extern` declaration, drawn from `seed`, under a name and giving back a type the boundary
/// carries, after the declaration of the type it reaches.
// example: strings.length(declaration(1)) > 0
fn declaration(seed: Int) -> String {
    let kind = drawn.number(stepped(seed: seed, steps: 0), 4)
    let width = drawn.picked(stepped(seed: seed, steps: 1), ["", "int ", "char "], "")
    let name = drawn.picked(stepped(seed: seed, steps: 2), ["reached", "held_by", "opened", "int"], "")
    let result = drawn.picked(stepped(seed: seed, steps: 3), ["Bool", "Int", "String", "File", "()", "Option<File>", "Option<Int>", "Result<File, String>"], "")
    let class = drawn.picked(stepped(seed: seed, steps: 4), ["", "interface "], "")
    let taken = drawn.picked(stepped(seed: seed, steps: 5), ["", "int "], "") + drawn.picked(stepped(seed: seed, steps: 6), ["held", "int"], "")
    let member = or(list.at(["field ", "static ", "method ", "new "], kind), "") + width + name + extern_parameters(kind, taken)
    let reached = or(list.at([" = \"java.lang.System.out\"", " = \"java.lang.System.identityHashCode\"", " = \"toPath\"", ""], kind), "")
    "extern type " + class + "File = \"java.io.File\"\n\nextern " + member + " -> " + result + reached + "\n"
}

/// The parameters of a declaration of `kind`, the last one written `taken`, where it takes any.
// example: extern_parameters(0, "held") == "()"
// example: extern_parameters(3, "int held") == "(path: String, int held: Int)"
fn extern_parameters(kind: Int, taken: String) -> String {
    if kind == 0 {
        return "()"
    }
    or(list.at(["(", "(path: File, ", "(file: File, ", "(path: String, "], kind), "(") + taken + ": Int)"
}

/// Formatting a drawn program twice gives one text, and formatting that text gives it again.
// example: held.is_held(formatting_is_deterministic_and_idempotent(3))
fn formatting_is_deterministic_and_idempotent(cases: Int) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        let source = drawn_program(drawn.seed_of(case))
        let written = person_written(drawn.seed_of(case))
        let why = first_of(first: first_of(first: unparsed(source), second: idempotence_fault(source)), second: idempotence_fault(written))
        if why != "" {
            found = held.with_failure(found, held.drawn_failure("formatting_is_deterministic_and_idempotent", drawn.seed_of(case), source + "\n---\n" + written, why))
        }
        case += 1
    }
    found
}

/// Why formatting `source` twice, or formatting its canonical text, does not give one text.
///
/// A source the parser refuses has no canonical text, so nothing is said of it.
// example: idempotence_fault("fn main( )  {}") == ""
// example: idempotence_fault("fn (") == ""
fn idempotence_fault(source: String) -> String {
    let once = ok_or(format.format(source), "")
    if !parsing.is_parsed(source) {
        return ""
    }
    if ok_or(format.format(source), "") != once {
        return "two formattings of " + held.quoted(source) + " disagree"
    }
    let again = ok_or(format.format(once), "refused")
    if again != once {
        return "formatting " + held.quoted(once) + " again writes " + held.quoted(again)
    }
    ""
}

/// The canonical text of a drawn program parses to the tree the program parses to.
// example: held.is_held(formatting_keeps_the_tree(3))
fn formatting_keeps_the_tree(cases: Int) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        let source = drawn_program(drawn.seed_of(case))
        let written = person_written(drawn.seed_of(case))
        let why = first_of(first: first_of(first: unparsed(source), second: tree_fault(source)), second: tree_fault(written))
        if why != "" {
            found = held.with_failure(found, held.drawn_failure("formatting_keeps_the_tree", drawn.seed_of(case), source + "\n---\n" + written, why))
        }
        case += 1
    }
    found
}

/// Why the canonical text of `source` parses to another tree, and `""` where it parses to the same.
// example: tree_fault("fn main( )  {  -(7.abs())\n}") == ""
// example: tree_fault("fn (") == ""
fn tree_fault(source: String) -> String {
    let canonical = ok_or(format.format(source), "")
    if !parsing.is_parsed(source) {
        return ""
    }
    let before = tree(source)
    let after = tree(canonical)
    if before != after {
        return "the tree " + held.quoted(before) + " becomes " + held.quoted(after)
    }
    ""
}

/// The tree `source` parses to, as `ast.printed` writes it, with each span taken out.
// example: tree("import io\n") == "import io\n"
// example: tree(" import io") == "import io\n"
fn tree(source: String) -> String {
    var written = ""
    for line in walk.lines_of(parser.printed(source)) {
        written += without_span(line) + "\n"
    }
    written
}

/// `line` without the span it ends with, where it ends with one.
// example: without_span("  integer 7 4..5") == "  integer 7"
// example: without_span("  result") == "  result"
fn without_span(line: String) -> String {
    var index = strings.length(line) - 1
    for index >= 0 && or(strings.at(line, index), 0) != 32 {
        index = index - 1
    }
    let last = or(strings.cut(line, index + 1, strings.length(line)), "")
    if index < 0 || !is_span_text(last) {
        return line
    }
    or(strings.cut(line, 0, index), line)
}

/// Whether `text` is a span as `shown` writes one: digits, two dots, and digits.
// example: is_span_text("12..140")
// example: !is_span_text("result")
// example: !is_span_text("..")
fn is_span_text(text: String) -> Bool {
    var dots = 0
    var digits = 0
    var index = 0
    for index < strings.length(text) {
        let unit = or(strings.at(text, index), 0)
        if unit == 46 {
            dots += 1
        } else if unit >= 48 && unit <= 57 {
            digits += 1
        } else {
            return false
        }
        index += 1
    }
    dots == 2 && digits >= 2
}

/// Every comment of a drawn program is in its canonical text, in the same order.
// example: held.is_held(every_comment_survives_in_source_order(3))
fn every_comment_survives_in_source_order(cases: Int) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        let source = drawn_program(drawn.seed_of(case))
        let written = person_written(drawn.seed_of(case))
        let why = first_of(first: first_of(first: unparsed(source), second: comment_fault(source)), second: comment_fault(written))
        if why != "" {
            found = held.with_failure(found, held.drawn_failure("every_comment_survives_in_source_order", drawn.seed_of(case), source + "\n---\n" + written, why))
        }
        case += 1
    }
    found
}

/// Why the canonical text of `source` holds other comments, and `""` where it holds the same.
// example: comment_fault("fn main( )  {  // why\n1 // one   \n}") == ""
// example: comment_fault("fn (") == ""
fn comment_fault(source: String) -> String {
    let canonical = ok_or(format.format(source), "")
    if !parsing.is_parsed(source) {
        return ""
    }
    let before = comments(source)
    let after = comments(canonical)
    if before != after {
        return "the comments " + shown(before) + " become " + shown(after)
    }
    ""
}

/// The text of each comment of `source`, in order, without the blanks it ends with.
// example: comments("a // one  \n// two\n") == ["// one", "// two"]
fn comments(source: String) -> List<String> {
    var texts = []
    for token in lexer.lex(source) {
        if token.kind == lexer.LineComment {
            texts = list.push(texts, without_trailing_blanks(token.text))
        }
    }
    texts
}

/// `text` without the spaces and tabs it ends with.
// example: without_trailing_blanks("// a \t ") == "// a"
fn without_trailing_blanks(text: String) -> String {
    var end = strings.length(text)
    for end > 0 && is_blank(or(strings.at(text, end - 1), 0)) {
        end = end - 1
    }
    or(strings.cut(text, 0, end), text)
}

/// Whether `unit` is a space or a tab.
// example: is_blank(32)
// example: !is_blank(47)
fn is_blank(unit: Int) -> Bool {
    unit == 32 || unit == 9
}

/// A drawn program written as a person might is refused as not canonical, and the canonical text
/// the refusal carries is in canonical form.
// example: held.is_held(the_canonical_text_of_a_refusal_is_canonical(3))
fn the_canonical_text_of_a_refusal_is_canonical(cases: Int) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        let written = spaced_as_a_person_might(drawn.seed_of(case))
        let why = refusal_fault(written)
        if why != "" {
            found = held.with_failure(found, held.drawn_failure("the_canonical_text_of_a_refusal_is_canonical", drawn.seed_of(case), written, why))
        }
        case += 1
    }
    found
}

/// Why `written` is not refused as not canonical, or the text of the refusal is not canonical.
// example: refusal_fault("fn main() {\n\n}\n") == ""
// example: refusal_fault("fn main() {\n}\n") == "it is not refused as not canonical: \"\""
fn refusal_fault(written: String) -> String {
    match format.check(written) {
        Err(format.NotCanonical { deviation, canonical }) => canonical_fault(canonical)
        answer => "it is not refused as not canonical: " + held.quoted(format.check_code(answer))
    }
}

/// Why `text` is not in canonical form, and `""` where it is.
// example: canonical_fault("fn main() {\n}\n") == ""
fn canonical_fault(text: String) -> String {
    let again = ok_or(format.format(text), "refused")
    if again != text {
        return "the canonical text " + held.quoted(text) + " formats to " + held.quoted(again)
    }
    ""
}

/// A drawn program with the break after each line spaced as a person might, one always wrongly.
///
/// Blank lines and indentation are what a person gets wrong, so they are what is drawn wrong, at
/// any line break: a run of blank lines deep in a file is the case the first line would not show.
// example: strings.length(spaced_as_a_person_might(1)) > 0
fn spaced_as_a_person_might(seed: Int) -> String {
    let lines = walk.lines_of(drawn_program(seed))
    let wrong = drawn.number(stepped(seed: seed, steps: 7), list.length(lines) - 1) + 1
    var draw = stepped(seed: seed, steps: 8)
    var written = or(list.at(lines, 0), "")
    var index = 1
    for index < list.length(lines) {
        let spacing = drawn.picked(draw, ["\n", "\n\n", "\n\n\n", "\n   \n", "  \n", "\n\t"], "\n")
        written += spacing_at(index: index, wrong: wrong, drawn_spacing: spacing, seed: seed) + or(list.at(lines, index), "")
        draw = drawn.next(draw)
        index += 1
    }
    written + "\n"
}

/// The spacing before line `index`, which is spelled wrongly where it is the line `wrong`.
// example: spacing_at(index: 1, wrong: 2, drawn_spacing: "\n", seed: 1) == "\n"
// example: spacing_at(index: 2, wrong: 2, drawn_spacing: "\n", seed: 1) != "\n"
fn spacing_at(index: Int, wrong: Int, drawn_spacing: String, seed: Int) -> String {
    if index != wrong {
        return drawn_spacing
    }
    drawn.picked(stepped(seed: seed, steps: 9), ["\n\n", "\n\n\n", "\n   \n", "  \n", "\n\t"], "\n\n")
}

/// Canonical form accepts the spelling it advises for a drawn name.
// example: held.is_held(every_spelling_canonical_form_advises_is_one_it_accepts(3))
fn every_spelling_canonical_form_advises_is_one_it_accepts(cases: Int) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        let name = drawn_name(drawn.seed_of(case))
        let spelled = spelling(name)
        if spelled != "" && !format.is_canonical(format.check(declaring(spelled))) {
            found = held.with_failure(found, held.drawn_failure("every_spelling_canonical_form_advises_is_one_it_accepts", drawn.seed_of(case), name, "canonical form refuses its own spelling " + held.quoted(spelled)))
        }
        case += 1
    }
    found
}

/// The spelling canonical form advises for `name`, and `""` where it advises none.
///
/// A name already canonical is its own spelling. A name that is an initial has none, because the
/// word it should have named is the author's to choose and no rewrite can guess it.
// example: spelling("counted") == "counted"
// example: spelling("Counted") == "counted"
// example: spelling("c") == ""
fn spelling(name: String) -> String {
    match format.check(declaring(name)) {
        Ok(_) => name
        Err(format.Misspelled(format.Miscased { written, kind, canonical })) => canonical
        Err(_) => ""
    }
}

/// A module declaring one function called `name`, which is the only thing about it that varies.
// example: declaring("f") == "fn f(count: Int) -> Int {\n    count\n}\n"
fn declaring(name: String) -> String {
    "fn " + name + "(count: Int) -> Int {\n    count\n}\n"
}

/// A name a person might write, in any mixture of case, underscore, and digit, drawn from `seed`.
///
/// An underscore never stands alone, because `_` is a keyword rather than a name.
// example: strings.length(drawn_name(1)) > 0
fn drawn_name(seed: Int) -> String {
    let opener = drawn.picked(stepped(seed: seed, steps: 0), ["a", "A", "u", "U", "_a", "_U"], "a")
    let count = drawn.number(stepped(seed: seed, steps: 1), 6)
    opener + drawn.text_of(stepped(seed: seed, steps: 2), ["a", "b", "U", "I", "_", "2"], count)
}

/// A test written anywhere among canonical declarations is out of place, as `L0201`, exactly
/// where a declaration is written below it, and a test written last is in place.
// example: held.is_held(a_declaration_below_a_test_is_out_of_place(3))
fn a_declaration_below_a_test_is_out_of_place(cases: Int) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        let placed = declarations_with_a_test(drawn.seed_of(case))
        var expected = ""
        if !placed.is_last {
            expected = "L0201"
        }
        let code = format.check_code(format.check(placed.source))
        if code != expected {
            found = held.with_failure(found, held.drawn_failure("a_declaration_below_a_test_is_out_of_place", drawn.seed_of(case), placed.source, "the check gives " + held.quoted(code) + ", not " + held.quoted(expected)))
        }
        case += 1
    }
    found
}

/// Up to 6 canonical declarations and a test, drawn from `seed`, and whether the test is last.
// example: strings.length(declarations_with_a_test(1).source) > 0
fn declarations_with_a_test(seed: Int) -> Placed {
    var chosen = []
    for index in drawn.numbers(stepped(seed: seed, steps: 1), drawn.number(stepped(seed: seed, steps: 0), 7), list.length(canonical_items()) - 1) {
        chosen = list.push(chosen, or(list.at(canonical_items(), index + 1), ""))
    }
    let at = drawn.number(stepped(seed: seed, steps: 2), list.length(chosen) + 1)
    var written = []
    var index = 0
    for item in chosen {
        if index == at {
            written = list.push(written, test_item())
        }
        written = list.push(written, item)
        index += 1
    }
    if at == list.length(chosen) {
        written = list.push(written, test_item())
    }
    Placed { source: strings.join(written, "\n\n") + "\n", is_last: at == list.length(chosen) }
}

/// The test a drawn program is written with, already in canonical form.
// example: parsing.is_parsed(test_item())
fn test_item() -> String {
    "test \"adds\" {\n    let total = 1 + 1\n    total == 2\n}"
}

/// A program of up to 6 canonical items and one function of a drawn expression, drawn from `seed`.
// example: parsing.is_parsed(drawn_program(1))
fn drawn_program(seed: Int) -> String {
    var chosen = []
    for index in drawn.numbers(stepped(seed: seed, steps: 1), drawn.number(stepped(seed: seed, steps: 0), 7), list.length(canonical_items())) {
        chosen = list.push(chosen, or(list.at(canonical_items(), index), ""))
    }
    chosen = list.push(chosen, "fn held() {\n    " + expression(seed) + "\n}")
    strings.join(chosen, "\n\n") + "\n"
}

/// An expression built by wrapping an atom in up to 12 layers, spelled as a person might rather
/// than canonically, so that the printer has parentheses and blanks to decide about.
///
/// A `-` in front of a number is the pair that matters most: the grammar reads `-7` as one
/// number, so a printer that drops the parentheses of `-(7.abs())` writes another program.
// example: strings.length(expression(1)) > 0
fn expression(seed: Int) -> String {
    var written = drawn.picked(stepped(seed: seed, steps: 20), ["a", "7", "0", "f(1, b)", "[]"], "a")
    let count = drawn.number(stepped(seed: seed, steps: 21), 13)
    for layer in drawn.numbers(stepped(seed: seed, steps: 22), count, list.length(wrappers())) {
        written = wrapped(wrapper: or(list.at(wrappers(), layer), "_"), inner: written)
    }
    written
}

/// `wrapper` with `inner` written in place of its one `_`.
// example: wrapped(wrapper: "[b, _]", inner: "7") == "[b, 7]"
fn wrapped(wrapper: String, inner: String) -> String {
    var index = 0
    for or(strings.at(wrapper, index), 95) != 95 {
        index += 1
    }
    or(strings.cut(wrapper, 0, index), "") + inner + or(strings.cut(wrapper, index + 1, strings.length(wrapper)), "")
}

/// The ways a drawn expression wraps the one inside it, `_` standing for that one.
// example: list.length(wrappers()) == 12
fn wrappers() -> List<String> {
    ["-_", "- _", "!_", "(_)", "_.abs()", "_?", "_ + b", "b * _", "(_) == b", "g( _ )", "[ _ ]", "[b, _]"]
}

/// The item shapes a drawn program is built from, each already in canonical form.
// example: list.length(canonical_items()) == 14
fn canonical_items() -> List<String> {
    ["import io", "type UserId = UserId(Int)", "type User = {\n    id: UserId\n}", "type Payment =\n    | Pending\n    | Failed(String)", "fn added(count: Int) -> Int {\n    // why this is here\n    count + 1 * (2 - 3)\n}", "fn dropped(count: Int) -> Int {\n    _ = added(count)\n    count\n}", "fn named(count: Int) -> Int {\n    joined(first: count, second: count)\n}", "fn matched(payment: Payment) -> Int {\n    match payment {\n        Pending => 1\n        Failed(reason) => 2\n    }\n}", "fn answered(payment: Payment) -> Int {\n    match payment {\n        Pending | Failed(_) => 1\n        _ => 2\n    }\n}", "trait Area<T> {\n    fn covered(shape: T) -> Int\n}", "instance Area<User> {\n    fn covered(shape: User) -> Int {\n        1\n    }\n}", "instance<T: Area<T>> Area<List<T>> {\n    fn covered(shape: List<T>) -> Int {\n        1\n    }\n}", "derive Eq for User", "derive Eq, Ord for Payment"]
}

/// A file of 1 to 6 items written out of canonical form, and what a person writes between them.
// example: strings.length(person_written(1)) > 0
fn person_written(seed: Int) -> String {
    var written = ""
    var draw = stepped(seed: seed, steps: 31)
    for index in drawn.numbers(stepped(seed: seed, steps: 30), drawn.number(draw, 6) + 1, list.length(person_items())) {
        draw = drawn.next(draw)
        written += or(list.at(person_items(), index), "") + drawn.picked(draw, ["\n", "\n\n", "\n\n\n", "\n// between\n", "   \n"], "\n")
    }
    written
}

/// What a person-written file is made of: items out of canonical form, most of which parse.
// example: list.length(person_items()) == 13
fn person_items() -> List<String> {
    ["import  io", "test   \"adds\"{ let total=1+1\n total==2 }", "// a comment alone   ", "type   Id = Id(Int)", "type Shape = | Dot // a dot\n| Line { length: Int\nwidth:Int }", "type Empty = {}", "extern static read(int at: Int,path:Path)->String = \"a.B.c\"", "derive Eq ,Hash for Id", "trait Named<T> {\n// the name\nfn name(value: T)->String\n}", "fn main( ) -> Int {\n  var total = 0 // start\n   total += -(7.abs())\n\n  total // done\n}", "fn pick(x: Int) -> String {\n match x {\n 1 | 2 => \"few\" // small\n _ => if x > 9 { \"many\" } else if (User {}).on { \"on\" } else { \"some\" }\n }\n}", "fn go<T:Eq<T>>(users: List<T>) {\nfor user in users { _ = f(a: (1 + 2) * 3, b: !(a && b)) }\nfor { break }\n}", "fn broken( {"]
}

/// The draw `steps` steps after the one `seed` starts.
// example: stepped(seed: 1, steps: 1).state == drawn.next(drawn.seeded(1)).state
fn stepped(seed: Int, steps: Int) -> drawn.Draw {
    var draw = drawn.seeded(seed)
    var step = 0
    for step < steps {
        draw = drawn.next(draw)
        step += 1
    }
    draw
}

/// `first` where it says something, and `second` otherwise.
// example: first_of(first: "", second: "b") == "b"
// example: first_of(first: "a", second: "b") == "a"
fn first_of(first: String, second: String) -> String {
    if first != "" {
        return first
    }
    second
}

/// Why `source` does not parse, and `""` where it does.
// example: unparsed("import io\n") == ""
fn unparsed(source: String) -> String {
    if parsing.is_parsed(source) {
        return ""
    }
    "the program " + held.quoted(source) + " does not parse: " + held.quoted(parser.printed(source))
}

/// A drawn program, and whether the test it holds is its last item.
type Placed = {
    source: String
    is_last: Bool
}
