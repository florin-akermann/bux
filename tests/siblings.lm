// Every sibling file under `tests/spec`: one phase's view of the example beside it.
//
// `docs/specs/executable-examples.md` states what a sibling is. A `.tokens` file is what the lexer
// makes of the example, `.ast` or `.error` what the parser makes of it, `.api` its page, and a
// `.unformatted` file formats to the example. `docs/specs/lexer.md`, `grammar.md`, `api-surface.md`,
// and `formatting.md` each state the form of theirs.
import command
import files
import format
import held
import ir
import lexer
import list
import parser
import walk

/// Every sibling under `spec`, each held to what its phase makes of the example beside it.
// example: list.length(every_sibling_held(ir.little_library(), "no-such-directory").failures) == 4
fn every_sibling_held(library: ir.Library, spec: String) -> held.Held {
    var found = each_held(spec + "/lexer", Tokens, library)
    found = held.added(found, each_held(spec + "/parser", Tree, library))
    found = held.added(found, each_held(spec + "/api", Surface, library))
    held.added(found, each_held(spec + "/format", Unformatted, library))
}

/// Every example of `directory` held to the sibling `phase` names, where there is at least one.
// example: each_held("no-such-directory", Tokens, ir.little_library()).failures == ["no-such-directory: holds no example with a sibling"]
fn each_held(directory: String, phase: Phase, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(0)
    for path in walk.files_in(directory, opened_by(phase)) {
        found = held.added(found, one_held(path, phase, library))
    }
    if found.cases == 0 {
        return held.with_failure(found, directory + ": holds no example with a sibling")
    }
    found
}

/// The ending of the files a phase's sibling is checked from.
// example: opened_by(Unformatted) == ".unformatted"
// example: opened_by(Tokens) == ".lm"
fn opened_by(phase: Phase) -> String {
    match phase {
        Unformatted => ".unformatted"
        _ => ".lm"
    }
}

/// The file at `path` held to its sibling, which is what `phase` makes of it.
// example: list.length(one_held("no-such-directory/a.lm", Tokens, ir.little_library()).failures) == 1
fn one_held(path: String, phase: Phase, library: ir.Library) -> held.Held {
    source := ok_or(files.read(path), "")
    match sibling_of(path, phase) {
        Ok(sibling) => compared(path: sibling.path, expected: sibling.text, found: seen_by(Made { path: path, source: source }, phase, library))
        Err(why) => held.with_failure(held.nothing_failed(1), path + ": " + why)
    }
}

/// The sibling `phase` reads beside `path`, or why there is not exactly one.
///
/// A parser example has a tree or an error beside it, and never both.
// example: or_path(sibling_of("no-such-directory/a.lm", Tokens)) == "no .tokens beside it"
fn sibling_of(path: String, phase: Phase) -> Result<Sibling, String> {
    match phase {
        Tokens => read_sibling(path: path, extension: "tokens")
        Tree => tree_or_error(path)
        Surface => read_sibling(path: path, extension: "api")
        Unformatted => read_sibling(path: path, extension: "lm")
    }
}

/// The path of a sibling that was read, or why none was, which is how an example reads one.
// example: or_path(Err("gone")) == "gone"
fn or_path(read: Result<Sibling, String>) -> String {
    match read {
        Ok(sibling) => sibling.path
        Err(why) => why
    }
}

/// The `.ast` or the `.error` beside `path`, where exactly one of the two is there.
// example: or_path(tree_or_error("no-such-directory/a.lm")) == "needs exactly one of .ast and .error beside it"
fn tree_or_error(path: String) -> Result<Sibling, String> {
    tree := read_sibling(path: path, extension: "ast")
    error := read_sibling(path: path, extension: "error")
    match tree {
        Ok(found) => only(found, error)
        Err(_) => only_error(error)
    }
}

/// `tree`, where there is no `.error` beside it too.
// example: or_path(only(Sibling { path: "a.ast", text: "" }, Err("none"))) == "a.ast"
fn only(tree: Sibling, error: Result<Sibling, String>) -> Result<Sibling, String> {
    match error {
        Ok(_) => Err("needs exactly one of .ast and .error beside it")
        Err(_) => Ok(tree)
    }
}

/// The `.error` beside an example with no `.ast`, where there is one.
// example: or_path(only_error(Err("none"))) == "needs exactly one of .ast and .error beside it"
fn only_error(error: Result<Sibling, String>) -> Result<Sibling, String> {
    match error {
        Ok(found) => Ok(found)
        Err(_) => Err("needs exactly one of .ast and .error beside it")
    }
}

/// The sibling of `path` with `extension`, read whole.
// example: or_path(read_sibling(path: "no-such-directory/a.lm", extension: "api")) == "no .api beside it"
fn read_sibling(path: String, extension: String) -> Result<Sibling, String> {
    beside := walk.sibling(path, extension)
    match files.read(beside) {
        Ok(text) => Ok(Sibling { path: beside, text: text })
        Err(_) => Err("no ." + extension + " beside it")
    }
}

/// What `phase` makes of `file`.
// example: seen_by(Made { path: "a.lm", source: "fn" }, Tokens, ir.little_library()) == "Keyword(fn) 0..2 \"fn\"\n"
// example: seen_by(Made { path: "a.lm", source: "fn (" }, Tree, ir.little_library()) == parser.printed("fn (")
fn seen_by(file: Made, phase: Phase, library: ir.Library) -> String {
    match phase {
        Tokens => tokens_listed(file.source)
        Tree => parser.printed(file.source)
        Surface => command.said_by(command.answered_within(["api", file.path], library)).output
        Unformatted => formatted(file.source)
    }
}

/// Every token of `source` on a line of its own: its kind, its span, and its text quoted.
// example: tokens_listed("x := 1") == "Identifier 0..1 \"x\"\nPunct(:=) 2..4 \":=\"\nInteger 5..6 \"1\"\n"
fn tokens_listed(source: String) -> String {
    var written = ""
    for token in lexer.lex(source) {
        written += shown(token) + " " + held.quoted(token.text) + "\n"
    }
    written
}

/// The canonical text of `source`, or the error it is refused with, as the parser prints one.
// example: formatted("fn f() {\n  1\n}\n") == "fn f() {\n    1\n}\n"
fn formatted(source: String) -> String {
    match format.format(source) {
        Ok(canonical) => canonical
        Err(refused) => parser.error_printed(refused)
    }
}

/// One case that held where `found` is `expected`, and failed naming the sibling where it is not.
// example: compared(path: "a.tokens", expected: "a", found: "a").cases == 1
// example: compared(path: "a.tokens", expected: "a", found: "b").failures == ["a.tokens: expected \"a\", found \"b\""]
fn compared(path: String, expected: String, found: String) -> held.Held {
    if expected == found {
        return held.nothing_failed(1)
    }
    held.with_failure(held.nothing_failed(1), held.failure(path, expected, found))
}

/// Which phase a sibling is the view of.
type Phase =
    | Tokens
    | Tree
    | Surface
    | Unformatted

/// A sibling file: where it is, and what it holds.
type Sibling = {
    path: String
    text: String
}

/// The file a phase makes something of: where it is, and what it holds.
type Made = {
    path: String
    source: String
}
