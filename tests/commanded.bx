// The command line, held line by line to the answers written down under `tests/commands`.
//
// `docs/specs/run.md` states the command line. A golden file holds command lines, and under each
// one the answer it gets: its status, each line of standard output, then each line of standard
// error. Each line of a golden file is one of these:
//
// - `$ <words>`: a command line, split into words at each space; `$` alone gives no words.
// - `status <n>`: the status the command line ends with.
// - `> <line>`, or `>` for an empty line: one line of standard output, with its line break.
// - `! <line>`, or `!` for an empty line: one line of standard error, with its line break.
// - `>~ <line>` or `!~ <line>`: the last line of a stream, which has no line break after it.
// - A blank line, which comes between two command lines and says nothing.
//
// Each golden file is answered in a stage: a directory of its own that holds a copy of every file
// of `tests/spec`, the files of `library`, `echo.bx`, and a small package in `demo`, whose
// manifest has `src/` and `tests/` under it. It also holds `echo.lm`, the text of `echo.bx` in a
// file that no Bux source is named as. A word whose first part names an entry of the stage is
// read there, so no command writes into the tree, and the path of the stage is taken out of each
// answer again. A program that `run` starts is started in the stage. A command line that opens
// with `run` or `test` needs a JVM, and it is skipped where `JAVA_HOME` names no JDK.
//
// Each command line sees the sources as they are in the tree. `fmt` is the one command that
// writes a source, so the sources are copied into the stage again after each `fmt`.
//
// `lines.txt` holds the command lines the argument parser is held to. `fixtures.txt` holds each
// command on each example of `tests/spec` and each module of `library`, each command that reads
// a path on each directory of `tests/spec`, and each command on paths it cannot read. An example
// that misses one of its command lines there fails, and so does a word that names no file there.
// `golden_written` gives the text of a golden file for a list of command lines. `tests/golden.bx`
// writes each golden file again with it, which is how an answer changed on purpose is written down.
// It adds each command line that an example misses, and it removes none.
import checking
import command
import enacted
import exemplified
import files
import header
import held
import ir
import list
import modules
import set
import started
import strings
import walk

fn every_golden_written(library: ir.Library, limit: Int) -> () {
    for path in golden_files() {
        var lines = []
        for written in cases_read(ok_or(files.read(path), "")) {
            lines = list.push(lines, written.words)
        }
        for words in lines_missing(path: path, lines: lines) {
            lines = list.push(lines, words)
        }
        _ = files.write(path, golden_written(lines, library, limit))
    }
}

// example: list.length(golden_files()) == 2
fn golden_files() -> List<String> {
    ["tests/commands/lines.txt", "tests/commands/fixtures.txt"]
}

// example: case_written(Case { words: ["a"], said: command.unusable("b") }) == "$ a\nstatus 2\n! error: b\n"
fn golden_written(lines: List<List<String>>, library: ir.Library, limit: Int) -> String {
    let stage = staged()
    var written = ""
    for words in lines {
        if written != "" {
            written += "\n"
        }
        written += case_written(Case { words: words, said: answered_in(words: words, stage: Stage { directory: stage, limit: limit }, library: library) })
    }
    command.removed_whole(stage)
    written
}

// example: list.length(cases_read("")) == 0
fn golden_held(path: String, library: ir.Library, limit: Int) -> held.Held {
    let golden = Golden { path: path, stage: Stage { directory: staged(), limit: limit } }
    var found = held.nothing_failed(0)
    var lines = []
    for written in cases_read(ok_or(files.read(path), "")) {
        found = held.added(found, case_held(golden, written, library))
        lines = list.push(lines, written.words)
    }
    command.removed_whole(golden.stage.directory)
    for words in lines_missing(path: path, lines: lines) {
        found = held.with_failure(found, path + ": " + words_line(words) + ": missing, and `bin/bux run tests/golden.bx` adds it")
    }
    if found.cases == 0 && list.length(found.skipped) == 0 {
        return held.with_failure(found, path + ": holds no command line")
    }
    found
}

// Only `fixtures.txt` holds each example, so no other golden file misses a command line.
// example: list.length(lines_missing(path: "tests/commands/lines.txt", lines: [])) == 0
fn lines_missing(path: String, lines: List<List<String>>) -> List<List<String>> {
    if path != fixtures() {
        return []
    }
    var written = set.empty()
    for words in lines {
        written = set.insert(written, words_line(words))
    }
    var missing = []
    for example in walk.every_file("tests/spec", ".bx") {
        for opening in example_commands() {
            let words = list.push(opening, example)
            if !set.has_value(written, words_line(words)) {
                missing = list.push(missing, words)
            }
        }
    }
    missing
}

// example: list.has_value(golden_files(), fixtures())
fn fixtures() -> String {
    "tests/commands/fixtures.txt"
}

// example: list.length(example_commands()) == 6
fn example_commands() -> List<List<String>> {
    [["check"], ["check", "--json"], ["api"], ["test"], ["fmt"], ["build"]]
}

// example: case_held(Golden { path: "a.txt", stage: Stage { directory: "no-such-directory", limit: 1 } }, Case { words: ["check", "tests/spec/no-such-example.bx"], said: command.nothing_said() }, ir.little_library()).failures == ["a.txt: $ check tests/spec/no-such-example.bx: tests/spec/no-such-example.bx is not there, so the command line is to be taken out"]
fn case_held(golden: Golden, written: Case, library: ir.Library) -> held.Held {
    let at = golden.path + ": " + words_line(written.words)
    match absent_example(written.words) {
        Some(absent) => held.with_failure(held.nothing_failed(1), at + ": " + absent + " is not there, so the command line is to be taken out")
        None => answer_held(golden, written, library)
    }
}

// example: is_jvm_needed(["run", "a.bx"])
fn answer_held(golden: Golden, written: Case, library: ir.Library) -> held.Held {
    let at = golden.path + ": " + words_line(written.words)
    if is_jvm_needed(written.words) && !exemplified.is_a_jdk_named() {
        return held.with_skip(held.nothing_failed(0), at + ": JAVA_HOME names no JDK, and the command line starts a JVM")
    }
    enacted.said_held(at, written.said, answered_in(words: written.words, stage: golden.stage, library: library))
}

// example: or(absent_example(["check", "tests/spec/no-such-example.bx"]), "") == "tests/spec/no-such-example.bx"
// example: or(absent_example(["check", "no/such.bx"]), "none") == "none"
fn absent_example(words: List<String>) -> Option<String> {
    for word in words {
        if command.has_prefix(word, "tests/spec") && !files.is_there(files.named(word)) {
            return Some(word)
        }
    }
    None
}

// example: !is_jvm_needed(["check", "a.bx"])
// example: !is_jvm_needed([])
fn is_jvm_needed(words: List<String>) -> Bool {
    let first = or(list.at(words, 0), "")
    first == "run" || first == "test"
}

// `fmt` can change a source, so the stage copies it again from the tree for the next command line.
// example: placed_in(word: "-h", stage: "no-such-directory") == "-h"
fn answered_in(words: List<String>, stage: Stage, library: ir.Library) -> command.Said {
    var placed = []
    for word in words {
        placed = list.push(placed, placed_in(word: word, stage: stage.directory))
    }
    let said = ended_in(command.answered_within(placed, library), stage)
    if or(list.at(words, 0), "") == "fmt" {
        sources_copied(stage.directory)
    }
    command.Said { output: enacted.unstaged(said.output, stage.directory), errors: enacted.unstaged(said.errors, stage.directory), status: said.status }
}

// example: placed_in(word: "a/b", stage: "no-such-directory") == "a/b"
fn placed_in(word: String, stage: String) -> String {
    let first = first_part(word)
    if first == "" || command.has_prefix(word, "-") || !files.is_there(files.named(modules.joined(stage, first))) {
        return word
    }
    stage + "/" + word
}

// example: first_part("a/b/c") == "a"
// example: first_part("a") == "a"
fn first_part(path: String) -> String {
    var index = 0
    for index < strings.length(path) && or(strings.at(path, index), 0) != 47 {
        index += 1
    }
    or(strings.cut(path, 0, index), "")
}

// example: ended_in(command.Spoken(command.unusable("a")), Stage { directory: "no-such-directory", limit: 1 }).status == 2
fn ended_in(answer: command.Answer, stage: Stage) -> command.Said {
    match answer {
        command.Spoken(said) => said
        command.Starts(line) => started.program_said(walk.completed(line, stage.directory, stage.limit))
    }
}

// example: strings.length(echo_text()) > 0
fn staged() -> String {
    let stage = ok_or(command.somewhere_of_its_own(), "/no-such-directory-for-a-stage")
    sources_copied(stage)
    _ = files.has_made_all(files.named(modules.joined(stage, "demo/src")))
    _ = files.has_made_all(files.named(modules.joined(stage, "demo/tests")))
    _ = files.write(modules.joined(stage, "demo/bux.package"), "package demo\nversion 0.1.0\n")
    _ = files.write(modules.joined(stage, "demo/tests/held.bx"), "test \"a test module of the package runs\" {\n    true\n}\n")
    _ = files.write(modules.joined(stage, "demo/src/main.bx"), "fn main(arguments: List<String>) -> Int {\n    0\n}\n")
    _ = files.write(modules.joined(stage, "echo.bx"), echo_text())
    _ = files.write(modules.joined(stage, "echo.lm"), echo_text())
    stage
}

fn sources_copied(stage: String) -> () {
    copied(from: "tests/spec", to: modules.joined(stage, "tests/spec"))
    copied(from: "library", to: modules.joined(stage, "library"))
}

fn copied(from: String, to: String) -> () {
    _ = files.has_made_all(files.named(to))
    for name in ok_or(files.listed(from), []) {
        let path = modules.joined(from, name)
        if files.is_directory(files.named(path)) {
            copied(from: path, to: modules.joined(to, name))
        } else if is_carried(name) {
            _ = files.write(modules.joined(to, name), ok_or(files.read(path), ""))
        }
    }
}

// example: is_carried("a.bx")
// example: !is_carried("a.class")
// example: !is_carried(".output")
fn is_carried(name: String) -> Bool {
    !command.has_prefix(name, ".") && !walk.is_ending_in(name, ".class")
}

// example: enacted.first_line_of(echo_text()) == "import io"
fn echo_text() -> String {
    "import io\n\nfn main(arguments: List<String>) -> Int {\n    for argument in arguments {\n        io.println(argument)\n    }\n    0\n}\n"
}

// example: explanation_held("no-such-directory/L0100.md", ir.little_library()).cases == 1
fn every_explanation_held(library: ir.Library) -> held.Held {
    var found = held.nothing_failed(0)
    for path in walk.files_in("explanations", ".md") {
        found = held.added(found, explanation_held(path, library))
    }
    if found.cases == 0 {
        return held.with_failure(found, "explanations: holds no explanation")
    }
    found
}

// example: list.length(explanation_held("no-such-directory/L0100.md", ir.little_library()).failures) == 1
fn explanation_held(path: String, library: ir.Library) -> held.Held {
    let code = modules.stem_of(path)
    let expected = command.Said { output: ok_or(files.read(path), ""), errors: "", status: 0 }
    enacted.said_held("explain " + code, expected, command.said_by(command.answered_within(["explain", code], library)))
}

// example: case_written(or(list.at(cases_read("$ a b\nstatus 1\n> x\n!~ y\n"), 0), Case { words: [], said: command.nothing_said() })) == "$ a b\nstatus 1\n> x\n!~ y\n"
fn cases_read(text: String) -> List<Case> {
    var cases = []
    var current = Case { words: [], said: command.nothing_said() }
    var count = 0
    for line in walk.lines_of(text) {
        if command.has_prefix(line, "$") {
            cases = closed(cases: cases, current: current, count: count)
            current = Case { words: header.words_of(or(strings.cut(line, 1, strings.length(line)), "")), said: command.nothing_said() }
            count += 1
        } else {
            current = with_line(current, line)
        }
    }
    closed(cases: cases, current: current, count: count)
}

// example: list.length(closed(cases: [], current: Case { words: [], said: command.nothing_said() }, count: 0)) == 0
fn closed(cases: List<Case>, current: Case, count: Int) -> List<Case> {
    if count == 0 {
        return cases
    }
    list.push(cases, current)
}

// example: with_line(Case { words: [], said: command.nothing_said() }, "status 2").said.status == 2
// example: with_line(Case { words: [], said: command.nothing_said() }, "! a").said.errors == "a\n"
fn with_line(written: Case, line: String) -> Case {
    let said = written.said
    let kind = or(strings.cut(line, 0, 1), "")
    if kind == ">" {
        return written { said: said { output: said.output + stream_line(line) } }
    }
    if kind == "!" {
        return written { said: said { errors: said.errors + stream_line(line) } }
    }
    if command.has_prefix(line, "status ") {
        return written { said: said { status: or(command.ordinal_read(or(strings.cut(line, 7, strings.length(line)), "")), -1) } }
    }
    written
}

// example: stream_line(">") == "\n"
// example: stream_line("> a") == "a\n"
// example: stream_line(">~ a") == "a"
fn stream_line(line: String) -> String {
    let rest = or(strings.cut(line, 1, strings.length(line)), "")
    if command.has_prefix(rest, "~ ") {
        return or(strings.cut(rest, 2, strings.length(rest)), "")
    }
    if command.has_prefix(rest, " ") {
        return or(strings.cut(rest, 1, strings.length(rest)), "") + "\n"
    }
    rest + "\n"
}

// example: case_written(Case { words: [], said: command.nothing_said() }) == "$\nstatus 0\n"
fn case_written(written: Case) -> String {
    let said = written.said
    words_line(written.words) + "\nstatus " + shown(said.status) + "\n" + stream_written(mark: ">", text: said.output) + stream_written(mark: "!", text: said.errors)
}

// example: words_line(["a", "b"]) == "$ a b"
// example: words_line([]) == "$"
fn words_line(words: List<String>) -> String {
    if list.length(words) == 0 {
        return "$"
    }
    "$ " + strings.join(words, " ")
}

// example: stream_written(mark: ">", text: "a\n\nb") == "> a\n>\n>~ b\n"
// example: stream_written(mark: "!", text: "") == ""
fn stream_written(mark: String, text: String) -> String {
    let lines = walk.lines_of(text)
    let is_open = text != "" && !walk.is_ending_in(text, "\n")
    var written = ""
    var index = 0
    for index < list.length(lines) {
        let line = or(list.at(lines, index), "")
        if is_open && index + 1 == list.length(lines) {
            written += mark + "~ " + line + "\n"
        } else {
            written += marked(mark: mark, line: line)
        }
        index += 1
    }
    written
}

// example: marked(mark: ">", line: "") == ">\n"
// example: marked(mark: ">", line: "a") == "> a\n"
fn marked(mark: String, line: String) -> String {
    if line == "" {
        return mark + "\n"
    }
    mark + " " + line + "\n"
}

type Golden = {
    path: String
    stage: Stage
}

type Stage = {
    directory: String
    limit: Int
}

type Case = {
    words: List<String>
    said: command.Said
}

test "bux help process prints the topic from the copy beside the classes" {
    let said = command.said_by(command.answered(["help", "process"]))
    said.status == 0 && said.output == ok_or(files.read("help/process.md"), "")
}

test "bux explain prints the long form of a code from the copy beside the classes" {
    let said = command.said_by(command.answered(["explain", "L0100"]))
    said.status == 0 && said.output == ok_or(files.read("explanations/L0100.md"), "")
}

test "every command line of tests/commands/lines.txt gets the answer written under it" {
    held.is_held_reported(golden_held("tests/commands/lines.txt", checking.carried_library(), walk.start_limit()))
}

test "every code there is an explanation of is explained as the file of the explanation reads" {
    held.is_held_reported(every_explanation_held(checking.carried_library()))
}
