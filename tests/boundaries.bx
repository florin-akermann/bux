// The drawn properties of what crosses into a module: a name a library module declares, and a
// type a Java member takes or gives, which `docs/specs/io.md` and `docs/specs/interop.md` state.
//
// A module that imports a library module is checked as the file `demo.bx` in a directory of its
// own under the temporary directory, which is removed whole when every property has run.
import checking
import command
import drawn
import held
import ir
import list
import strings

/// One `Held` for each property of what crosses into a module, in a fixed order.
///
/// Where no directory of its own can be made, the two properties that need one are skipped.
// example: list.length(every_property(0, ir.little_library())) == 4
fn every_property(cases: Int, library: ir.Library) -> List<held.Held> {
    let library_ones = library_reached(cases, library)
    [or(list.at(library_ones, 0), held.nothing_failed(0)), or(list.at(library_ones, 1), held.nothing_failed(0)), a_type_that_does_not_cross_is_refused_in_every_position(cases, library), a_list_crosses_only_where_a_member_takes_one(cases, library)]
}

/// The two properties of the names a library module declares, each case written under a
/// directory of its own, which is removed whole afterwards.
// example: list.length(library_reached(0, ir.little_library())) == 2
fn library_reached(cases: Int, library: ir.Library) -> List<held.Held> {
    match command.somewhere_of_its_own() {
        Ok(directory) => reached_in(cases: cases, library: library, directory: directory)
        Err(said) => [held.with_skip(held.nothing_failed(0), "boundaries: " + said.errors), held.with_skip(held.nothing_failed(0), "boundaries: " + said.errors)]
    }
}

/// The two properties of the names a library module declares, run in `directory`.
// example: list.length(reached_in(cases: 0, library: ir.little_library(), directory: "no-such-directory")) == 2
fn reached_in(cases: Int, library: ir.Library, directory: String) -> List<held.Held> {
    let found = [a_declared_name_has_one_type_wherever_it_is_written(cases: cases, library: library, directory: directory), an_undeclared_name_is_refused_naming_the_module(cases: cases, library: library, directory: directory)]
    command.removed_whole(directory)
    found
}

/// A name a library module declares has the type the spec gives it, wherever the call is written.
// example: held.is_held(a_declared_name_has_one_type_wherever_it_is_written(cases: 0, library: ir.little_library(), directory: "no-such-directory"))
fn a_declared_name_has_one_type_wherever_it_is_written(cases: Int, library: ir.Library, directory: String) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "a_declared_name_has_one_type_wherever_it_is_written", seed, declared_tried(drawn.seeded(seed), Reaching { library: library, directory: directory }))
    }
    found
}

/// A drawn call of a declared name, written in a drawn place.
// example: declared_tried(drawn.seeded(1), Reaching { library: ir.little_library(), directory: "no-such-directory" }).why != ""
fn declared_tried(draw: drawn.Draw, reaching: Reaching) -> checking.Tried {
    let row = drawn.picked(draw, reached(), Reached { module: "io", name: "print", arguments: "\"text\"", result: "()" })
    let call = row.module + "." + row.name + "(" + row.arguments + ")"
    let place = drawn.picked(drawn.next(draw), places(), "")
    let source = "import " + row.module + "\n\nfn go() -> () {\n" + place_of(place: place, call: call) + "}\n"
    let found = checking.type_in(checking.reaching(source, reaching.directory, reaching.library), checking.occurrence(source, call, 1))
    if found != row.result {
        return checking.Tried { input: source, why: call + " gives back " + found + ", not " + row.result }
    }
    checking.Tried { input: source, why: "" }
}

/// A name a library module does not declare is refused naming the module and the name.
// example: held.is_held(an_undeclared_name_is_refused_naming_the_module(cases: 0, library: ir.little_library(), directory: "no-such-directory"))
fn an_undeclared_name_is_refused_naming_the_module(cases: Int, library: ir.Library, directory: String) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "an_undeclared_name_is_refused_naming_the_module", seed, undeclared_tried(drawn.seeded(seed), Reaching { library: library, directory: directory }))
    }
    found
}

/// A call of a drawn name that the drawn module does not declare.
///
/// A drawn name that one of the rows declares holds, because it says nothing of the rule.
// example: undeclared_tried(drawn.seeded(1), Reaching { library: ir.little_library(), directory: "no-such-directory" }).why != ""
fn undeclared_tried(draw: drawn.Draw, reaching: Reaching) -> checking.Tried {
    let module = drawn.picked(draw, reached(), Reached { module: "io", name: "print", arguments: "", result: "" }).module
    let name = drawn.picked(drawn.next(draw), ["a", "w", "r"], "a") + drawn.text_of(checking.after(draw, 3), ["a", "d", "e", "n", "o", "p", "r", "s", "t", "u", "w"], drawn.number(checking.after(draw, 2), 7))
    let source = "import " + module + "\n\nfn go() -> () {\n    _ = " + module + "." + name + "()\n}\n"
    if is_declared(name) {
        return checking.Tried { input: source, why: "" }
    }
    let message = checking.message_of(checking.reaching(source, reaching.directory, reaching.library))
    if message != "`" + module + "` declares no `" + name + "`" {
        return checking.Tried { input: source, why: "the refusal says " + held.quoted(message) }
    }
    checking.Tried { input: source, why: "" }
}

/// A type that does not cross is refused whichever position of a Java member it is written in.
// example: a_type_that_does_not_cross_is_refused_in_every_position(2, ir.little_library()).cases == 2
fn a_type_that_does_not_cross_is_refused_in_every_position(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "a_type_that_does_not_cross_is_refused_in_every_position", seed, crossing_tried(drawn.seeded(seed), library))
    }
    found
}

/// A drawn type that does not cross, written in a drawn position.
// example: crossing_tried(drawn.seeded(1), ir.little_library()).input != ""
fn crossing_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    let written = drawn.picked(draw, ["User", "Paid", "Option<Int>", "List<Option<Int>>"], "User")
    let position = drawn.picked(drawn.next(draw), positions(), Position { written: "", is_taken: IsGiven })
    let source = "extern " + place_of(place: position.written, call: written) + "\n\nextern type File = \"java.io.File\"\n\ntype User = {\n    paid: Paid\n}\n\ntype Paid = Paid(Int)\n"
    let answer = checking.checked(source, library)
    let message = checking.message_of(answer)
    if checking.code_of(answer) != "L0425" || checking.occurrence(message, "`" + written + "` is no type", 1).start != 0 {
        return checking.Tried { input: source, why: "the refusal is " + checking.code_of(answer) + " " + held.quoted(message) }
    }
    checking.Tried { input: source, why: "" }
}

/// A list crosses where a Java member takes one, and nowhere else.
// example: a_list_crosses_only_where_a_member_takes_one(2, ir.little_library()).cases == 2
fn a_list_crosses_only_where_a_member_takes_one(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "a_list_crosses_only_where_a_member_takes_one", seed, list_tried(drawn.seeded(seed), library))
    }
    found
}

/// A list of a drawn element type, written in a drawn position.
// example: list_tried(drawn.seeded(1), ir.little_library()).input != ""
fn list_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    let element = drawn.picked(draw, ["Bool", "Int", "String", "File"], "Int")
    let position = drawn.picked(drawn.next(draw), positions(), Position { written: "", is_taken: IsGiven })
    let source = "extern " + place_of(place: position.written, call: "List<" + element + ">") + "\n\nextern type File = \"java.io.File\"\n"
    let is_accepted = checking.is_accepted(source, library)
    if is_accepted != (position.is_taken == IsTaken) {
        return checking.Tried { input: source, why: "accepted is " + shown(is_accepted) + ": " + checking.message_of(checking.checked(source, library)) }
    }
    checking.Tried { input: source, why: "" }
}

/// Whether one of the rows declares `name`.
// example: is_declared("print")
// example: !is_declared("printed")
fn is_declared(name: String) -> Bool {
    for row in reached() {
        if row.name == name {
            return true
        }
    }
    false
}

/// `place` with `call` written where it writes `CALL`.
// example: place_of(place: "    _ = CALL\n", call: "f()") == "    _ = f()\n"
fn place_of(place: String, call: String) -> String {
    let at = checking.occurrence(place, "CALL", 1)
    or(strings.cut(place, 0, at.start), "") + call + or(strings.cut(place, at.start + at.length, strings.length(place)), "")
}

/// Every name a library module declares, with the arguments a call writes and what it gives.
// example: list.length(reached()) == 9
fn reached() -> List<Reached> {
    [Reached { module: "io", name: "print", arguments: "\"text\"", result: "()" }, Reached { module: "io", name: "println", arguments: "\"text\"", result: "()" }, Reached { module: "files", name: "read", arguments: "\"text\"", result: "Result<String, String>" }, Reached { module: "files", name: "write", arguments: "\"text\", \"text\"", result: "Result<String, String>" }, Reached { module: "files", name: "listed", arguments: "\"text\"", result: "Result<List<String>, String>" }, Reached { module: "files", name: "made", arguments: "\"text\"", result: "Result<String, String>" }, Reached { module: "files", name: "removed", arguments: "\"text\"", result: "Result<Bool, String>" }, Reached { module: "environment", name: "read", arguments: "\"text\"", result: "Option<String>" }, Reached { module: "programs", name: "run", arguments: "\"text\", []", result: "Result<programs.Finished, String>" }]
}

/// Every place a call is written, which is every place an expression of its type may go.
// example: list.length(places()) == 3
fn places() -> List<String> {
    ["    let held = CALL\n    _ = held\n", "    _ = CALL\n", "    if true {\n        _ = CALL\n    }\n"]
}

/// Every place a Java member's signature writes a type, and whether the member takes it there.
// example: list.length(positions()) == 5
fn positions() -> List<Position> {
    [Position { written: "static held(one: CALL) -> String = \"java.lang.String.valueOf\"", is_taken: IsTaken }, Position { written: "static held(one: String, two: CALL) -> String = \"java.lang.String.valueOf\"", is_taken: IsTaken }, Position { written: "static held(one: String) -> CALL = \"java.lang.String.valueOf\"", is_taken: IsGiven }, Position { written: "method held(file: File, one: CALL) -> String = \"toString\"", is_taken: IsTaken }, Position { written: "field held() -> CALL = \"java.lang.System.out\"", is_taken: IsGiven }]
}

/// Where a module that imports a library module is checked, and against what prelude.
type Reaching = {
    library: ir.Library
    directory: String
}

/// One name a library module declares: the module, the name, what a call passes, and its type.
type Reached = {
    module: String
    name: String
    arguments: String
    result: String
}

/// One place a Java member writes a type, with `CALL` standing for the type.
type Position = {
    written: String
    is_taken: Taken
}

derive Eq for Taken

/// Whether a member takes what is written at a place, or gives it back.
type Taken =
    | IsTaken
    | IsGiven
