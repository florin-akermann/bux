// The map, the set, and the list of the library, each given back exactly what went into it.
//
// `docs/specs/collections.md` and `docs/specs/library.md` state the properties. Each case draws
// what goes in, puts it into the map, the set, or the list of the library in the JVM of its test,
// and reads it all back out. What a read must give is worked out again from the draw, not from a map.
import drawn
import held
import list
import map
import set
import strings

// example: held.is_held(held_over(MapReadsBack, 2))
fn held_over(property: Property, cases: Int) -> held.Held {
    var found = held.nothing_failed(cases)
    var index = 0
    for index < cases {
        let seed = drawn.seed_of(index)
        let tried = tried_by(property, drawn.seeded(seed))
        if tried.why != "" {
            found = held.with_failure(found, held.drawn_failure(name_of(property), seed, tried.case, tried.why))
        }
        index += 1
    }
    found
}

// example: tried_by(ListReadsBack, drawn.seeded(1)).why == ""
fn tried_by(property: Property, draw: drawn.Draw) -> Tried {
    match property {
        MapReadsBack => a_map_gives_back_the_value_last_put_in_at_each_key(draw)
        SetHoldsWhatWentIn => a_set_holds_every_value_put_into_it_and_no_other(draw)
        WideKeysReadBack => hundreds_of_keys_read_back_out_of_a_map_and_a_set(draw)
        ListReadsBack => a_list_grown_by_push_reads_back_at_every_index_it_holds(draw)
        PushLeavesTheList => a_push_leaves_the_list_it_was_handed_holding_what_it_held(draw)
        LengthCountsPushes => the_length_of_a_list_is_the_number_of_pushes_that_built_it(draw)
        SortedInOrder => a_sorted_list_holds_what_it_was_handed_in_order(draw)
    }
}

// example: name_of(MapReadsBack) == "a_map_gives_back_the_value_last_put_in_at_each_key"
fn name_of(property: Property) -> String {
    match property {
        MapReadsBack => "a_map_gives_back_the_value_last_put_in_at_each_key"
        SetHoldsWhatWentIn => "a_set_holds_every_value_put_into_it_and_no_other"
        WideKeysReadBack => "hundreds_of_keys_read_back_out_of_a_map_and_a_set"
        ListReadsBack => "a_list_grown_by_push_reads_back_at_every_index_it_holds"
        PushLeavesTheList => "a_push_leaves_the_list_it_was_handed_holding_what_it_held"
        LengthCountsPushes => "the_length_of_a_list_is_the_number_of_pushes_that_built_it"
        SortedInOrder => "a_sorted_list_holds_what_it_was_handed_in_order"
    }
}

// The keys come from a small set, so most cases put two values at one key.
// example: a_map_gives_back_the_value_last_put_in_at_each_key(drawn.seeded(3)).why == ""
fn a_map_gives_back_the_value_last_put_in_at_each_key(draw: drawn.Draw) -> Tried {
    let put_in = puts_of(draw)
    var held_map = map.empty()
    for put in put_in {
        held_map = map.insert(held_map, put.key, put.value)
    }
    var why = ""
    for key in [0, 1, 2, 3, 4] {
        let read = or(map.get(held_map, key), missing())
        if why == "" && read != last_put_at(put_in, key) {
            why = "key " + shown(key) + " reads back as " + shown(read)
        }
    }
    Tried { case: puts_shown(put_in), why: why }
}

// example: list.length(puts_of(drawn.seeded(1))) < 7
fn puts_of(draw: drawn.Draw) -> List<Put> {
    var puts = []
    var at = drawn.next(draw)
    for list.length(puts) < drawn.number(draw, 7) {
        puts = list.push(puts, Put { key: drawn.number(at, 5), value: small(drawn.next(at)) })
        at = drawn.next(drawn.next(at))
    }
    puts
}

// example: last_put_at([Put { key: 1, value: 5 }, Put { key: 1, value: 6 }], 1) == 6
// example: last_put_at([], 1) == missing()
fn last_put_at(put_in: List<Put>, key: Int) -> Int {
    var last = missing()
    for put in put_in {
        if put.key == key {
            last = put.value
        }
    }
    last
}

// example: puts_shown([Put { key: 1, value: -5 }]) == "1=-5"
fn puts_shown(put_in: List<Put>) -> String {
    var written = []
    for put in put_in {
        written = list.push(written, shown(put.key) + "=" + shown(put.value))
    }
    strings.join(written, " ")
}

// Values put in find a lost value, and other values find a set that holds everything.
// example: a_set_holds_every_value_put_into_it_and_no_other(drawn.seeded(3)).why == ""
fn a_set_holds_every_value_put_into_it_and_no_other(draw: drawn.Draw) -> Tried {
    let put_in = smalls_of(draw, 7)
    var seen = set.empty()
    for value in put_in {
        seen = set.insert(seen, value)
    }
    var why = ""
    for value in joined(first: put_in, second: smalls_of(drawn.next(draw), 5)) {
        if why == "" && set.has_value(seen, value) != list.has_value(put_in, value) {
            why = "the set says " + shown(set.has_value(seen, value)) + " of " + shown(value)
        }
    }
    Tried { case: shown(put_in), why: why }
}

// example: joined(first: [1], second: [2]) == [1, 2]
fn joined(first: List<Int>, second: List<Int>) -> List<Int> {
    var values = first
    for value in second {
        values = list.push(values, value)
    }
    values
}

// The keys `[one, 31]` and `[one + 1, 0]` have the same hash, so the map must keep both apart.
// No key has `30` in it, so a read of such a key must find nothing.
// example: hundreds_of_keys_read_back_out_of_a_map_and_a_set(drawn.seeded(3)).why == ""
fn hundreds_of_keys_read_back_out_of_a_map_and_a_set(draw: drawn.Draw) -> Tried {
    let drawn_numbers = drawn.numbers(draw, 150, 1000)
    let keys = wide_keys(drawn_numbers)
    var held_map = map.empty()
    var seen = set.empty()
    var index = 0
    for key in keys {
        held_map = map.insert(held_map, key, index)
        seen = set.insert(seen, key)
        index += 1
    }
    Tried { case: shown(drawn_numbers), why: wide_misread(Wide { keys: keys, held_map: held_map, seen: seen }) }
}

// example: wide_keys([4]) == [[4, 31], [5, 0]]
fn wide_keys(drawn_numbers: List<Int>) -> List<List<Int>> {
    var keys = []
    for one in drawn_numbers {
        keys = list.push(list.push(keys, [one, 31]), [one + 1, 0])
    }
    keys
}

// example: wide_misread(Wide { keys: [], held_map: map.empty(), seen: set.empty() }) == ""
fn wide_misread(wide: Wide) -> String {
    for key in wide.keys {
        let index = last_index_of(wide.keys, key)
        if or(map.get(wide.held_map, key), missing()) != index || !set.has_value(wide.seen, key) {
            return "key " + shown(key) + " does not read back as " + shown(index)
        }
        let absent = [or(list.at(key, 0), 0), 30]
        if or(map.get(wide.held_map, absent), missing()) != missing() || set.has_value(wide.seen, absent) {
            return "key " + shown(absent) + " is held, and it never went in"
        }
    }
    ""
}

// example: last_index_of([[1], [2], [1]], [1]) == 2
fn last_index_of(keys: List<List<Int>>, key: List<Int>) -> Int {
    var index = list.length(keys) - 1
    for index >= 0 && or(list.at(keys, index), []) != key {
        index = index - 1
    }
    if index < 0 {
        return missing()
    }
    index
}

// example: a_list_grown_by_push_reads_back_at_every_index_it_holds(drawn.seeded(3)).why == ""
fn a_list_grown_by_push_reads_back_at_every_index_it_holds(draw: drawn.Draw) -> Tried {
    let grown = smalls_of(draw, 7)
    let count = drawn.number(draw, 7)
    var why = ""
    var index = -2
    for index <= count + 1 {
        let read = or(list.at(grown, index), missing())
        if why == "" && read != drawn_at(draw: draw, index: index, count: count) {
            why = "index " + shown(index) + " reads back as " + shown(read)
        }
        index += 1
    }
    Tried { case: shown(grown), why: why }
}

// example: drawn_at(draw: drawn.seeded(1), index: -1, count: 3) == missing()
fn drawn_at(draw: drawn.Draw, index: Int, count: Int) -> Int {
    if index < 0 || index >= count {
        return missing()
    }
    var at = drawn.next(drawn.next(draw))
    var step = 0
    for step < index {
        at = drawn.next(at)
        step += 1
    }
    small(at)
}

// Both pushes come before any read, so a second push that writes over the first shows in the read.
// example: a_push_leaves_the_list_it_was_handed_holding_what_it_held(drawn.seeded(3)).why == ""
fn a_push_leaves_the_list_it_was_handed_holding_what_it_held(draw: drawn.Draw) -> Tried {
    let handed = smalls_of(draw, 7)
    let first = list.push(handed, 101)
    let second = list.push(handed, 202)
    let count = list.length(first) - 1
    let read = [list.length(handed), or(list.at(handed, count), missing()), or(list.at(first, count), missing()), or(list.at(second, count), missing()), or(list.at(handed, count), missing())]
    let expected = [drawn.number(draw, 7), missing(), 101, 202, missing()]
    var why = ""
    if read != expected {
        why = "the lists read back as " + shown(read)
    }
    Tried { case: shown(handed), why: why }
}

// All the kept lists share one buffer, so a later push must not change an earlier length.
// One more push onto a drawn earlier list must copy it.
// example: the_length_of_a_list_is_the_number_of_pushes_that_built_it(drawn.seeded(3)).why == ""
fn the_length_of_a_list_is_the_number_of_pushes_that_built_it(draw: drawn.Draw) -> Tried {
    let count = drawn.number(draw, 9)
    var built = [[]]
    var newest = []
    var at = drawn.next(draw)
    for list.length(built) <= count {
        newest = list.push(newest, small(at))
        built = list.push(built, newest)
        at = drawn.next(at)
    }
    let branched = drawn.number(at, count + 1)
    let branch = list.push(or(list.at(built, branched), []), 0)
    Tried { case: shown(count) + " pushes, then one onto list " + shown(branched), why: miscounted(built: built, branch: branch, branched: branched) }
}

// example: miscounted(built: [[], [1]], branch: [0], branched: 0) == ""
// example: miscounted(built: [[1]], branch: [0], branched: 0) == "list 0 holds 1 values"
fn miscounted(built: List<List<Int>>, branch: List<Int>, branched: Int) -> String {
    var index = 0
    for values in built {
        if list.length(values) != index {
            return "list " + shown(index) + " holds " + shown(list.length(values)) + " values"
        }
        index += 1
    }
    if list.length(branch) != branched + 1 {
        return "the push onto list " + shown(branched) + " holds " + shown(list.length(branch)) + " values"
    }
    ""
}

// example: a_sorted_list_holds_what_it_was_handed_in_order(drawn.seeded(3)).why == ""
fn a_sorted_list_holds_what_it_was_handed_in_order(draw: drawn.Draw) -> Tried {
    let handed = smalls_of(draw, 40)
    Tried { case: shown(handed), why: unsorted(handed: handed, ordered: list.sorted(handed)) }
}

// example: unsorted(handed: [2, 1, 2], ordered: [1, 2, 2]) == ""
// example: unsorted(handed: [2, 1], ordered: [2, 1]) == "2 is ahead of 1"
// example: unsorted(handed: [2, 1], ordered: [1, 1]) == "2 is held 1 times, and 0 times once sorted"
fn unsorted(handed: List<Int>, ordered: List<Int>) -> String {
    var last = missing()
    for value in ordered {
        if value < last {
            return shown(last) + " is ahead of " + shown(value)
        }
        last = value
    }
    for value in handed {
        let before = times_held(values: handed, value: value)
        let after = times_held(values: ordered, value: value)
        if before != after {
            return shown(value) + " is held " + shown(before) + " times, and " + shown(after) + " times once sorted"
        }
    }
    ""
}

// example: times_held(values: [1, 2, 1], value: 1) == 2
fn times_held(values: List<Int>, value: Int) -> Int {
    var count = 0
    for held_value in values {
        if held_value == value {
            count += 1
        }
    }
    count
}

// example: list.length(smalls_of(drawn.seeded(1), 3)) < 3
fn smalls_of(draw: drawn.Draw, bound: Int) -> List<Int> {
    var values = []
    var at = drawn.next(drawn.next(draw))
    for list.length(values) < drawn.number(draw, bound) {
        values = list.push(values, small(at))
        at = drawn.next(at)
    }
    values
}

// example: small(drawn.seeded(1)) >= -99
fn small(draw: drawn.Draw) -> Int {
    drawn.number(draw, 199) - 99
}

// No drawn value is equal to this value.
// example: missing() == -1000
fn missing() -> Int {
    -1000
}

type Tried = {
    case: String
    why: String
}

type Put = {
    key: Int
    value: Int
}

type Wide = {
    keys: List<List<Int>>
    held_map: map.Map<List<Int>, Int>
    seen: set.Set<List<Int>>
}

type Property =
    | MapReadsBack
    | SetHoldsWhatWentIn
    | WideKeysReadBack
    | ListReadsBack
    | PushLeavesTheList
    | LengthCountsPushes
    | SortedInOrder

test "a map gives back the value last put in at each key" {
    held.is_held_reported(held_over(MapReadsBack, held.drawn_cases()))
}

test "a set holds every value put into it and no other" {
    held.is_held_reported(held_over(SetHoldsWhatWentIn, held.drawn_cases()))
}

test "hundreds of keys read back out of a map and a set" {
    held.is_held_reported(held_over(WideKeysReadBack, held.drawn_cases()))
}

test "a list grown by push reads back at every index it holds" {
    held.is_held_reported(held_over(ListReadsBack, held.drawn_cases()))
}

test "a push leaves the list it was handed holding what it held" {
    held.is_held_reported(held_over(PushLeavesTheList, held.drawn_cases()))
}

test "the length of a list is the number of pushes that built it" {
    held.is_held_reported(held_over(LengthCountsPushes, held.drawn_cases()))
}

test "a sorted list holds what it was handed in order" {
    held.is_held_reported(held_over(SortedInOrder, held.drawn_cases()))
}
