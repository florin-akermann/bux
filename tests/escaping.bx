// A record kept in locals works out what the same record built on the heap works out.
//
// `docs/specs/codegen.md` keeps a record that never leaves the function it is built in as one
// local for each field, and builds it only where a second name lets it go. The property runs both
// bodies on a small stack machine, which knows only the instructions such a body is made of.
import checking
import compiled
import drawn
import held
import ir
import jvm
import list
import map
import strings

// example: held.is_held(a_record_kept_in_locals_computes_what_the_same_record_built_on_the_heap_computes(0, ir.little_library()))
fn a_record_kept_in_locals_computes_what_the_same_record_built_on_the_heap_computes(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        let seed = drawn.seed_of(case)
        let one = drawing(drawn.seeded(seed), library)
        found = compiled.noted(found, one.why, held.drawn_failure("a_record_kept_in_locals_computes_what_the_same_record_built_on_the_heap_computes", seed, one.source, one.why))
        case += 1
    }
    found
}

// example: drawing(drawn.seeded(1), ir.little_library()).source != ""
fn drawing(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let many = drawn.number(draw, 3) + 1
    let given = drawn.numbers(drawn.next(draw), many, 5)
    let count = drawn.number(drawn.next(drawn.next(draw)), 2001) - 1000
    let kept = module(given: given, through: "point")
    let whole = module(given: given, through: "other")
    let kept_lowered = compiled.lowered_alone(kept, library)
    let whole_lowered = compiled.lowered_alone(whole, library)
    var why = ""
    if has_new(kept_lowered) || !has_new(whole_lowered) {
        why = "the record is built where it is kept: " + shown(has_new(kept_lowered)) + ", and where it lets go: " + shown(has_new(whole_lowered))
    }
    let kept_answer = answer_text(computed(lowered: kept_lowered, count: count))
    let whole_answer = answer_text(computed(lowered: whole_lowered, count: count))
    if why == "" && kept_answer != whole_answer {
        why = "at " + shown(count) + " the kept record works out " + kept_answer + ", and the built one " + whole_answer
    }
    Drawing { source: kept, why: why }
}

// The name the record is built for keeps the record in locals.
// A second name for the record puts it on the heap.
// example: module(given: [1], through: "point") == "fn held(count: Int) -> Int {\n    _ = count\n    let point = Point { across: 7 }\n    point.across\n}\n\ntype Point = {\n    across: Int\n}\n"
fn module(given: List<Int>, through: String) -> String {
    var literal = []
    var reads = []
    var declared = ""
    var at = 0
    for value in given {
        let field = or(list.at(["across", "down", "along"], at), "")
        literal = list.push(literal, field + ": " + or(list.at(["count", "7", "count * 2", "count + -1", "3 - count"], value), ""))
        reads = list.push(reads, through + "." + field)
        declared += "    " + field + ": Int\n"
        at += 1
    }
    var second = ""
    if through != "point" {
        second = "    let " + through + " = point\n"
    }
    "fn held(count: Int) -> Int {\n    _ = count\n    let point = Point { " + strings.join(literal, ", ") + " }\n" + second + "    " + strings.join(reads, " + ") + "\n}\n\ntype Point = {\n" + declared + "}\n"
}

// example: !has_new([])
fn has_new(lowered: List<ir.Lowered>) -> Bool {
    for instruction in compiled.instructions_of(lowered, "held") {
        if is_new(instruction) {
            return true
        }
    }
    false
}

// example: is_new(jvm.New("a/B"))
// example: !is_new(jvm.Copy)
fn is_new(instruction: jvm.Instruction) -> Bool {
    match instruction {
        jvm.New(_) => true
        _ => false
    }
}

// example: answer_text(Ok(3)) == "3"
// example: answer_text(Err("gone")) == "nothing, because gone"
fn answer_text(answer: Result<Int, String>) -> String {
    match answer {
        Ok(value) => shown(value)
        Err(why) => "nothing, because " + why
    }
}

// example: answer_text(computed(lowered: [], count: 1)) == "nothing, because the body gives nothing back"
fn computed(lowered: List<ir.Lowered>, count: Int) -> Result<Int, String> {
    let classes = compiled.demo_classes(lowered)
    var machine = Machine { stack: [], locals: map.insert(map.empty(), 0, Number(count)), broken: "" }
    for instruction in compiled.instructions_of(lowered, "held") {
        if is_return(instruction) {
            return answer_of(machine)
        }
        machine = stepped(machine: machine, instruction: instruction, classes: classes)
        if machine.broken != "" {
            return Err(machine.broken)
        }
    }
    Err("the body gives nothing back")
}

// example: is_return(jvm.Return(None))
// example: !is_return(jvm.Copy)
fn is_return(instruction: jvm.Instruction) -> Bool {
    match instruction {
        jvm.Return(_) => true
        _ => false
    }
}

// example: answer_text(answer_of(Machine { stack: [Number(2)], locals: map.empty(), broken: "" })) == "2"
fn answer_of(machine: Machine) -> Result<Int, String> {
    match top(machine) {
        Number(value) => Ok(value)
        _ => Err("the body gives back no whole number")
    }
}

// example: stepped(machine: Machine { stack: [], locals: map.empty(), broken: "" }, instruction: jvm.LongOf(4), classes: []).stack == [Number(4)]
fn stepped(machine: Machine, instruction: jvm.Instruction, classes: List<ir.Class>) -> Machine {
    match instruction {
        jvm.LongOf(value) => pushed(machine, Number(value))
        jvm.Load { slot } => loaded(machine, slot)
        jvm.Store { slot } => stored(machine, slot)
        jvm.Copy => pushed(machine, top(machine))
        jvm.Arithmetic(how) => worked_out(machine, how)
        jvm.New(_) => pushed(machine, Fresh)
        jvm.Construct(reference) => constructed(machine, list.length(fields_of(classes, reference.class)))
        jvm.GetField(field) => read(machine, or(list.index_of(fields_of(classes, field.class), field.name), -1))
        _ => machine { broken: "a drawn body holds an instruction the machine does not know" }
    }
}

// example: loaded(Machine { stack: [], locals: map.empty(), broken: "" }, 3).broken != ""
fn loaded(machine: Machine, slot: Int) -> Machine {
    match map.get(machine.locals, slot) {
        Some(value) => pushed(machine, value)
        None => machine { broken: "a drawn body loads slot " + shown(slot) + ", which holds nothing" }
    }
}

// example: stored(Machine { stack: [Number(1)], locals: map.empty(), broken: "" }, 3).stack == []
fn stored(machine: Machine, slot: Int) -> Machine {
    let kept = popped(machine)
    kept { locals: map.insert(kept.locals, slot, top(machine)) }
}

// example: worked_out(Machine { stack: [Number(5), Number(3)], locals: map.empty(), broken: "" }, ir.Subtract).stack == [Number(2)]
fn worked_out(machine: Machine, how: ir.Arithmetic) -> Machine {
    let right = number_of(top(machine))
    let left = number_of(top(popped(machine)))
    let rest = popped(popped(machine))
    match how {
        ir.Add => pushed(rest, Number(left + right))
        ir.Subtract => pushed(rest, Number(left - right))
        ir.Multiply => pushed(rest, Number(left * right))
        _ => machine { broken: "a drawn body works out what the machine does not know" }
    }
}

// A constructor takes the values it carries and the copy that `new` left.
// So it makes the instance below them the record.
// example: constructed(Machine { stack: [Fresh, Fresh, Number(4)], locals: map.empty(), broken: "" }, 1).stack == [Instance([4])]
fn constructed(machine: Machine, carried: Int) -> Machine {
    let at = list.length(machine.stack) - carried
    var fields = []
    for value in compiled.part(machine.stack, at, list.length(machine.stack)) {
        fields = list.push(fields, number_of(value))
    }
    let below = machine { stack: compiled.part(machine.stack, 0, at - 2) }
    pushed(below, Instance(fields))
}

// example: number_of(Number(3)) == 3
// example: number_of(Fresh) == 0
fn number_of(value: Value) -> Int {
    match value {
        Number(whole) => whole
        _ => 0
    }
}

// example: read(Machine { stack: [Instance([4, 5])], locals: map.empty(), broken: "" }, 1).stack == [Number(5)]
fn read(machine: Machine, at: Int) -> Machine {
    match top(machine) {
        Instance(fields) => pushed(popped(machine), Number(or(list.at(fields, at), 0)))
        _ => machine { broken: "a drawn body reads a field off what is no record" }
    }
}

// example: pushed(Machine { stack: [], locals: map.empty(), broken: "" }, Fresh).stack == [Fresh]
fn pushed(machine: Machine, value: Value) -> Machine {
    machine { stack: list.push(machine.stack, value) }
}

// example: top(Machine { stack: [Number(1), Number(2)], locals: map.empty(), broken: "" }) == Number(2)
fn top(machine: Machine) -> Value {
    or(list.at(machine.stack, list.length(machine.stack) - 1), Fresh)
}

// example: popped(Machine { stack: [Number(1), Number(2)], locals: map.empty(), broken: "" }).stack == [Number(1)]
fn popped(machine: Machine) -> Machine {
    machine { stack: compiled.part(machine.stack, 0, list.length(machine.stack) - 1) }
}

// example: fields_of([], "demo/Point") == []
fn fields_of(classes: List<ir.Class>, class: String) -> List<String> {
    var names = []
    for one in classes {
        if jvm.class_of(one.of) == class {
            for field in one.fields {
                names = list.push(names, field.name)
            }
        }
    }
    names
}

derive Eq for Value

type Drawing = {
    source: String
    why: String
}

type Machine = {
    stack: List<Value>
    locals: map.Map<Int, Value>
    broken: String
}

type Value =
    | Number(Int)
    | Instance(List<Int>)
    | Fresh

test "a record kept in locals computes what the same record built on the heap computes" {
    held.is_held_reported(a_record_kept_in_locals_computes_what_the_same_record_built_on_the_heap_computes(held.drawn_cases(), checking.carried_library()))
}
