// The drawn properties of processes: the shape check over drawn processes, and two programs that
// spawn processes on a JVM and hold what the mailboxes and the ends of them do.
//
// `docs/specs/concurrency.md` states processes. The shape check is tried in the JVM of its test,
// as `bux check` tries it. The two programs draw their cases themselves, with `tests/drawn.bx`
// beside them, so one JVM tries every case, and each line the program writes is one case.
import checking
import command
import drawn
import enacted
import exemplified
import files
import held
import ir
import list
import modules
import started
import strings
import walk

/// A drawn process of the one shape passes every phase up to inference.
// example: held.is_held(each_well_formed_process_is_accepted(0, ir.little_library()))
fn each_well_formed_process_is_accepted(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        let source = written(drawn_process(drawn.seeded(seed)), Whole)
        found = checking.noted(found, "each_well_formed_process_is_accepted", seed, refused_as(source: source, code: "", library: library))
    }
    found
}

/// A drawn process with one drawn break of the shape is refused with the code of that break.
// example: held.is_held(each_break_of_the_shape_is_refused(0, ir.little_library()))
fn each_break_of_the_shape_is_refused(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        let draw = drawn.seeded(seed)
        let broken = drawn.picked(checking.after(draw, 5), every_break(), Whole)
        let source = written(drawn_process(draw), broken)
        found = checking.noted(found, "each_break_of_the_shape_is_refused", seed, refused_as(source: source, code: code_of_break(broken), library: library))
    }
    found
}

/// Why `source` is not refused with `code`, which is `""` for a source that is accepted.
// example: refused_as(source: "fn one() -> Int {\n    1\n}\n", code: "", library: ir.little_library()).why == ""
fn refused_as(source: String, code: String, library: ir.Library) -> checking.Tried {
    let answer = checking.checked(source, library)
    let found = checking.code_of(answer)
    if found == code {
        return checking.Tried { input: source, why: "" }
    }
    checking.Tried { input: source, why: "expected " + shown_code(code) + ", found " + shown_code(found) + ": " + checking.message_of(answer) }
}

/// A code as a failure names it, and `accepted` for no code.
// example: shown_code("") == "accepted"
// example: shown_code("L0802") == "L0802"
fn shown_code(code: String) -> String {
    if code == "" {
        return "accepted"
    }
    code
}

/// Each break of the shape a drawn process can be written with.
// example: list.length(every_break()) == 12
fn every_break() -> List<Break> {
    [SpawnOfAFunction, CallOfAProcess, StartNotFirst, ReceiveNotSecond, FunctionAfterReceive, GenericStart, UnwrittenParameter, ReceiveOfThreeValues, ReceiveNotAMatch, ArmDoesWork, ReceiveOfAnotherState, MessageHoldsAFile]
}

/// The code the compiler refuses `broken` with, and `""` for a whole process.
// example: code_of_break(Whole) == ""
// example: code_of_break(ArmDoesWork) == "L0809"
fn code_of_break(broken: Break) -> String {
    match broken {
        Whole => ""
        SpawnOfAFunction => "L0800"
        CallOfAProcess => "L0801"
        StartNotFirst => "L0802"
        ReceiveNotSecond => "L0803"
        FunctionAfterReceive => "L0804"
        GenericStart => "L0805"
        UnwrittenParameter => "L0806"
        ReceiveOfThreeValues => "L0807"
        ReceiveNotAMatch => "L0808"
        ArmDoesWork => "L0809"
        ReceiveOfAnotherState => "L0810"
        MessageHoldsAFile => "L0811"
    }
}

/// A process drawn from `draw`: its name, the type of its state, and the kinds of its messages.
// example: list.length(drawn_process(drawn.seeded(1)).kinds) > 0
fn drawn_process(draw: drawn.Draw) -> Drawing {
    let state = drawn.picked(checking.after(draw, 1), ["Int", "String", "List<Int>"], "Int")
    let count = drawn.number(checking.after(draw, 2), 3) + 1
    var kinds = []
    for index in checking.numbers_below(count) {
        kinds = list.push(kinds, Kind { name: or(list.at(["Add", "Keep", "Take"], index), "Add"), carries: drawn.number(checking.after(draw, 3 + index), 2) == 1 })
    }
    let named = drawn.picked(checking.after(draw, 6), ["Counter", "Keeper", "Tally"], "Counter")
    Drawing { named: named, state: state, kinds: kinds }
}

/// The module that declares the process `drawing`, written with `broken`.
// example: strings.length(written(drawn_process(drawn.seeded(1)), Whole)) > 0
fn written(drawing: Drawing, broken: Break) -> String {
    let entry = main_written(drawing, broken)
    let functions = start_written(drawing, broken) + "\n" + receive_written(drawing, broken) + extra_written(broken)
    let helper = "fn kept(state: " + drawing.state + ", amount: Int) -> Next<" + drawing.state + "> {\n    _ = amount\n    Continue(state)\n}\n"
    entry + "\nprocess " + drawing.named + " {\n" + functions + "}\n\n" + helper + "\n" + message_type(drawing, broken) + file_written(broken)
}

/// `main`, which spawns the process, or breaks the shape where `broken` is a break of `spawn`.
// example: main_written(Drawing { named: "Counter", state: "Int", kinds: [] }, Whole) == "fn main(arguments: List<String>) -> Int {\n    _ = spawn Counter(0)\n    0\n}\n"
fn main_written(drawing: Drawing, broken: Break) -> String {
    let started_as = match broken {
        SpawnOfAFunction => "spawn kept(" + first_state(drawing.state) + ", 1)"
        CallOfAProcess => drawing.named + "(" + first_state(drawing.state) + ")"
        _ => "spawn " + drawing.named + "(" + first_state(drawing.state) + ")"
    }
    "fn main(arguments: List<String>) -> Int {\n    _ = " + started_as + "\n    0\n}\n"
}

/// A value of the type `state` names, written as a literal.
// example: first_state("List<Int>") == "[]"
fn first_state(state: String) -> String {
    if state == "String" {
        return "\"\""
    }
    if state == "List<Int>" {
        return "[]"
    }
    "0"
}

/// `start`, which gives back what it takes, written with `broken`.
// example: start_written(Drawing { named: "Counter", state: "Int", kinds: [] }, UnwrittenParameter) == "    fn start(initial) -> Int {\n        initial\n    }\n"
fn start_written(drawing: Drawing, broken: Break) -> String {
    let head = match broken {
        StartNotFirst => "begin(initial: " + drawing.state + ")"
        GenericStart => "start<Held>(initial: " + drawing.state + ")"
        UnwrittenParameter => "start(initial)"
        _ => "start(initial: " + drawing.state + ")"
    }
    "    fn " + head + " -> " + drawing.state + " {\n        initial\n    }\n"
}

/// `receive`, which matches the message, written with `broken`.
// example: strings.length(receive_written(Drawing { named: "Counter", state: "Int", kinds: [] }, ReceiveNotAMatch)) > 0
fn receive_written(drawing: Drawing, broken: Break) -> String {
    let state = match broken {
        ReceiveOfAnotherState => other_state(drawing.state)
        _ => drawing.state
    }
    let name = match broken {
        ReceiveNotSecond => "handle"
        _ => "receive"
    }
    let extra = match broken {
        ReceiveOfThreeValues => ", extra: Int"
        _ => ""
    }
    "    fn " + name + "(state: " + state + ", message: Asked" + extra + ") -> Next<" + state + "> {\n" + receive_body(drawing, broken) + "    }\n"
}

/// A type of state other than `state`.
// example: other_state("Int") == "String"
// example: other_state("String") == "Int"
fn other_state(state: String) -> String {
    if state == "Int" {
        return "String"
    }
    "Int"
}

/// The body of `receive`: one `match` on the message, or what `broken` writes instead.
// example: receive_body(Drawing { named: "Counter", state: "Int", kinds: [] }, ReceiveNotAMatch) == "        Continue(state)\n"
fn receive_body(drawing: Drawing, broken: Break) -> String {
    if broken == ReceiveNotAMatch {
        return "        Continue(state)\n"
    }
    var arms = ""
    var place = 0
    for kind in drawing.kinds {
        arms += "            " + arm_written(kind: kind, broken: broken, place: place) + "\n"
        place += 1
    }
    if broken == MessageHoldsAFile {
        arms += "            Opened(_) => Continue(state)\n"
    }
    "        match message {\n" + arms + "            Stop => Done\n        }\n"
}

/// The arm of `kind` at `place`: a call of `kept`, `Continue` of the state, or work where `broken` is.
// example: arm_written(kind: Kind { name: "Add", carries: true }, broken: Whole, place: 0) == "Add(amount) => kept(state: state, amount: amount)"
// example: arm_written(kind: Kind { name: "Keep", carries: false }, broken: Whole, place: 0) == "Keep => Continue(state)"
fn arm_written(kind: Kind, broken: Break, place: Int) -> String {
    if broken == ArmDoesWork && place == 0 {
        return ignored(kind) + " => if true {\n                Continue(state)\n            } else {\n                Done\n            }"
    }
    if kind.carries && broken != ReceiveOfAnotherState {
        return pattern_of(kind) + " => kept(state: state, amount: amount)"
    }
    ignored(kind) + " => Continue(state)"
}

/// The pattern of `kind`, which binds `amount` where it carries a number.
// example: pattern_of(Kind { name: "Add", carries: true }) == "Add(amount)"
fn pattern_of(kind: Kind) -> String {
    if kind.carries {
        return kind.name + "(amount)"
    }
    kind.name
}

/// The pattern of `kind`, which binds nothing, for an arm that reads no number.
// example: ignored(Kind { name: "Add", carries: true }) == "Add(_)"
fn ignored(kind: Kind) -> String {
    if kind.carries {
        return kind.name + "(_)"
    }
    kind.name
}

/// A function after `receive` where `broken` writes one, and nothing where it does not.
// example: extra_written(Whole) == ""
fn extra_written(broken: Break) -> String {
    if broken == FunctionAfterReceive {
        return "\n    fn reset() -> Int {\n        0\n    }\n"
    }
    ""
}

/// The type of the messages of `drawing`: each kind it draws, `Opened` where `broken` writes it,
/// and `Stop`.
// example: message_type(Drawing { named: "Counter", state: "Int", kinds: [Kind { name: "Add", carries: true }] }, Whole) == "type Asked =\n    | Add(Int)\n    | Stop\n"
fn message_type(drawing: Drawing, broken: Break) -> String {
    var variants = ""
    for kind in drawing.kinds {
        variants += "    | " + variant_of(kind) + "\n"
    }
    if broken == MessageHoldsAFile {
        variants += "    | Opened(Handle)\n"
    }
    "type Asked =\n" + variants + "    | Stop\n"
}

/// A record that holds a file, which `Opened` carries, where `broken` writes it.
// example: file_written(Whole) == ""
fn file_written(broken: Break) -> String {
    if broken == MessageHoldsAFile {
        return "\ntype Handle = {\n    file: File\n}\n\nextern type File = \"java.io.File\"\n"
    }
    ""
}

/// The variant of `kind`, which carries an `Int` where the kind carries a number.
// example: variant_of(Kind { name: "Keep", carries: false }) == "Keep"
fn variant_of(kind: Kind) -> String {
    if kind.carries {
        return kind.name + "(Int)"
    }
    kind.name
}

/// A drawn list of messages, sent to one process and ended, comes back from `ended` as it was sent.
///
/// Messages sent after the one that ends the process are not read, so the last state is the one
/// `receive` held when it gave `Done`.
// example: held.is_held(messages_arrive_in_order_and_ended_gives_the_last_state(0, ir.little_library()))
fn messages_arrive_in_order_and_ended_gives_the_last_state(cases: Int, library: ir.Library) -> held.Held {
    run_held(property: "messages_arrive_in_order_and_ended_gives_the_last_state", source: ordered_program(cases), cases: cases, library: library)
}

/// A drawn number of messages sent to a process that never takes one: the mailbox takes 64.
// example: held.is_held(a_mailbox_never_holds_more_than_its_bound(0, ir.little_library()))
fn a_mailbox_never_holds_more_than_its_bound(cases: Int, library: ir.Library) -> held.Held {
    run_held(property: "a_mailbox_never_holds_more_than_its_bound", source: bounded_program(cases), cases: cases, library: library)
}

/// Drawn sends race the end of a process, and after `ended` gives back, every `send` gives
/// `ProcessEnded`, whatever it waits.
// example: held.is_held(no_send_after_the_end_is_delivered(0, ir.little_library()))
fn no_send_after_the_end_is_delivered(cases: Int, library: ir.Library) -> held.Held {
    run_held(property: "no_send_after_the_end_is_delivered", source: closed_program(cases), cases: cases, library: library)
}

/// What `source` writes when it is run beside `tests/drawn.bx`, each line held as one case.
///
/// A property of no cases starts no JVM, and a property is skipped where no JDK is named.
// example: held.is_held(run_held(property: "p", source: "", cases: 0, library: ir.little_library()))
fn run_held(property: String, source: String, cases: Int, library: ir.Library) -> held.Held {
    if cases == 0 {
        return held.nothing_failed(0)
    }
    if !exemplified.is_a_jdk_named() {
        return held.with_skip(held.nothing_failed(0), "tests/spawned.bx: " + property + ": JAVA_HOME names no JDK")
    }
    let scene = enacted.scene_of([enacted.Written { at: "main.bx", text: source }, enacted.Written { at: "drawn.bx", text: ok_or(files.read("tests/drawn.bx"), "") }])
    let said = started.ended_said(command.answered_within(["run", modules.joined(scene, "main.bx")], library), scene, 60)
    command.removed_whole(scene)
    lines_held(property: property, said: said, cases: cases)
}

/// Each line of what a program said held as one case: `<seed> held`, or the seed and what failed.
// example: held.is_held(lines_held(property: "p", said: command.Said { output: "1 held\n", errors: "", status: 0 }, cases: 1))
// example: !held.is_held(lines_held(property: "p", said: command.Said { output: "1 gave 2\n", errors: "", status: 0 }, cases: 1))
fn lines_held(property: String, said: command.Said, cases: Int) -> held.Held {
    var found = held.nothing_failed(cases)
    let lines = command.lines_of(said.output)
    var count = 0
    for line in lines {
        if line != "" {
            count += 1
            if !walk.is_ending_in(line, " held") {
                found = held.with_failure(found, "tests/spawned.bx: " + property + ": seed " + line)
            }
        }
    }
    if count != cases || said.status != 0 {
        found = held.with_failure(found, "tests/spawned.bx: " + property + ": " + shown(count) + " of " + shown(cases) + " cases said, status " + shown(said.status) + ": " + said.errors)
    }
    found
}

/// The program that sends each case its drawn messages, ends it, and compares what `ended` gives.
// example: strings.length(ordered_program(1)) > 0
fn ordered_program(cases: Int) -> String {
    let entry = "fn main(arguments: List<String>) -> Int {\n    var case = 0\n    for case < " + shown(cases) + " {\n        io.println(recorded(drawn.seed_of(case)))\n        case += 1\n    }\n    0\n}\n"
    let recorded = "// example: recorded(1) == \"1 held\"\nfn recorded(seed: Int) -> String {\n    let draw = drawn.seeded(seed)\n    let sent = drawn.numbers(draw, drawn.number(drawn.next(draw), 150), 1000)\n    let recording = spawn Recorder()\n    for value in sent {\n        _ = send(recording, Record(value), NoLimit)\n    }\n    _ = send(recording, Stop, NoLimit)\n    for value in sent {\n        _ = send(recording, Record(value), NoWait)\n    }\n    let found = ended(recording)\n    if found == sent {\n        return shown(seed) + \" held\"\n    }\n    shown(seed) + \" gave \" + shown(found)\n}\n"
    let recorder = "process Recorder {\n    fn start() -> List<Int> {\n        []\n    }\n\n    fn receive(values: List<Int>, message: Recorded) -> Next<List<Int>> {\n        match message {\n            Record(value) => Continue(list.push(values, value))\n            Stop => Done\n        }\n    }\n}\n"
    "import drawn\nimport io\nimport list\n\n" + entry + "\n" + recorded + "\n" + recorder + "\ntype Recorded =\n    | Record(Int)\n    | Stop\n"
}

/// The program that ends each case's process while drawn sends race the end, then sends again.
// example: strings.length(closed_program(1)) > 0
fn closed_program(cases: Int) -> String {
    let entry = "fn main(arguments: List<String>) -> Int {\n    var case = 0\n    for case < " + shown(cases) + " {\n        io.println(closed(drawn.seed_of(case)))\n        case += 1\n    }\n    0\n}\n"
    let closed = "// example: closed(1) == \"1 held\"\nfn closed(seed: Int) -> String {\n    let draw = drawn.seeded(seed)\n    let racing = drawn.number(draw, 100)\n    let later = drawn.number(drawn.next(draw), 100) + 1\n    let closing = spawn Closer()\n    _ = send(closing, Close, NoLimit)\n    var sent = 0\n    for sent < racing {\n        _ = send(closing, Tick, NoWait)\n        sent += 1\n    }\n    _ = ended(closing)\n    var delivered = 0\n    sent = 0\n    for sent < later {\n        delivered += taken(send(closing, Tick, NoWait)) + taken(send(closing, Tick, Milliseconds(1))) + taken(send(closing, Tick, NoLimit))\n        sent += 1\n    }\n    if delivered == 0 {\n        return shown(seed) + \" held\"\n    }\n    shown(seed) + \" delivered \" + shown(delivered) + \" after the end\"\n}\n"
    let helpers = "// example: taken(ProcessEnded) == 0\nfn taken(sent: Sent) -> Int {\n    match sent {\n        ProcessEnded => 0\n        _ => 1\n    }\n}\n"
    let closer = "process Closer {\n    fn start() -> Int {\n        0\n    }\n\n    fn receive(held: Int, message: Closing) -> Next<Int> {\n        match message {\n            Tick => Continue(held)\n            Close => Done\n        }\n    }\n}\n"
    "import drawn\nimport io\n\n" + entry + "\n" + closed + "\n" + helpers + "\n" + closer + "\ntype Closing =\n    | Tick\n    | Close\n"
}

/// The program that sends each case a drawn number of messages to a process that takes none.
///
/// `start` of the holder waits for a process that never ends, so the holder never takes one.
// example: strings.length(bounded_program(1)) > 0
fn bounded_program(cases: Int) -> String {
    let entry = "fn main(arguments: List<String>) -> Int {\n    var case = 0\n    for case < " + shown(cases) + " {\n        io.println(bounded(drawn.seed_of(case)))\n        case += 1\n    }\n    0\n}\n"
    let bounded = "// example: strings.length(bounded(1)) > 0\nfn bounded(seed: Int) -> String {\n    let count = drawn.number(drawn.seeded(seed), 200)\n    let holding = spawn Holder(spawn Idle())\n    var delivered = 0\n    var sent = 0\n    for sent < count {\n        delivered += taken(send(holding, Wake, NoWait))\n        sent += 1\n    }\n    if delivered == expected(count) {\n        return shown(seed) + \" held\"\n    }\n    shown(seed) + \" took \" + shown(delivered) + \" of \" + shown(count)\n}\n"
    let helpers = "// example: expected(70) == 64\nfn expected(count: Int) -> Int {\n    if count < 64 {\n        return count\n    }\n    64\n}\n\n// example: taken(Delivered) == 1\nfn taken(sent: Sent) -> Int {\n    match sent {\n        Delivered => 1\n        MailboxFull => 0\n        ProcessEnded => 0\n    }\n}\n"
    let holder = "process Holder {\n    fn start(idle: Process<Stopped, Int>) -> Int {\n        ended(idle)\n    }\n\n    fn receive(held: Int, message: Woken) -> Next<Int> {\n        match message {\n            Wake => Done\n        }\n    }\n}\n"
    let idle = "process Idle {\n    fn start() -> Int {\n        0\n    }\n\n    fn receive(held: Int, message: Stopped) -> Next<Int> {\n        match message {\n            Stop => Done\n        }\n    }\n}\n"
    "import drawn\nimport io\nimport strings\n\n" + entry + "\n" + bounded + "\n" + helpers + "\n" + holder + "\n" + idle + "\ntype Woken = Wake\n\ntype Stopped = Stop\n"
}

/// A drawn process: its name, the type of its state, and the kinds of message it takes.
type Drawing = {
    named: String
    state: String
    kinds: List<Kind>
}

/// One kind of message, and whether it carries a number.
type Kind = {
    name: String
    carries: Bool
}

/// How a drawn process is written: whole, or with one break of the shape.
derive Eq for Break

type Break =
    | Whole
    | SpawnOfAFunction
    | CallOfAProcess
    | StartNotFirst
    | ReceiveNotSecond
    | FunctionAfterReceive
    | GenericStart
    | UnwrittenParameter
    | ReceiveOfThreeValues
    | ReceiveNotAMatch
    | ArmDoesWork
    | ReceiveOfAnotherState
    | MessageHoldsAFile

test "each well formed process is accepted" {
    held.is_held_reported(each_well_formed_process_is_accepted(held.drawn_cases(), checking.carried_library()))
}

test "each break of the shape is refused" {
    held.is_held_reported(each_break_of_the_shape_is_refused(held.drawn_cases(), checking.carried_library()))
}

test "messages arrive in order and ended gives the last state" {
    held.is_held_reported(messages_arrive_in_order_and_ended_gives_the_last_state(held.drawn_cases(), checking.carried_library()))
}

test "a mailbox never holds more than its bound" {
    held.is_held_reported(a_mailbox_never_holds_more_than_its_bound(held.drawn_cases(), checking.carried_library()))
}

test "no send after the end is delivered" {
    held.is_held_reported(no_send_after_the_end_is_delivered(held.drawn_cases(), checking.carried_library()))
}
