// The invariants of what an instance becomes when it is lowered, checked on drawn modules.
//
// An operator over a type with an instance calls that instance, a literal at a declared type calls
// its `from_literal`, a derive reads every field, and a generic asked for by another module is
// written as it was asked for. `docs/specs/operators.md` and `docs/specs/codegen.md` state these.
import command

import compiled

import drawn

import files

import held

import ir

import list

import modules

import strings

/// Every property of what an instance becomes, each over `cases` drawn modules, in a fixed order.
// example: list.length(every_property(0, ir.little_library())) == 7
fn every_property(cases: Int, library: ir.Library) -> List<held.Held> {
    [an_operator_over_a_type_with_an_instance_calls_that_instance_and_no_other(cases, library), a_comparison_is_one_call_of_is_less_whichever_way_round_it_is_written(cases, library), a_literal_at_a_declared_type_is_one_call_of_its_from_literal(cases, library), a_whole_number_where_an_int_is_expected_is_that_number_and_nothing_more(cases, library), a_record_of_any_shape_derives_a_body_that_reads_every_field_in_order(cases, library), a_method_written_for_a_set_calls_the_instance_each_type_in_that_set_has(cases, library), every_method_a_use_asks_for_is_one_the_module_asked_writes(cases, library)]
}

/// An operator over a type with an instance calls that instance's method, and no other.
// example: held.is_held(an_operator_over_a_type_with_an_instance_calls_that_instance_and_no_other(0, ir.little_library()))
fn an_operator_over_a_type_with_an_instance_calls_that_instance_and_no_other(cases: Int, library: ir.Library) -> held.Held {
    checked(property: Operator, cases: cases, library: library)
}

/// Each of the four comparisons is one call of the instance's `is_less`, however it is written.
// example: held.is_held(a_comparison_is_one_call_of_is_less_whichever_way_round_it_is_written(0, ir.little_library()))
fn a_comparison_is_one_call_of_is_less_whichever_way_round_it_is_written(cases: Int, library: ir.Library) -> held.Held {
    checked(property: Comparison, cases: cases, library: library)
}

/// A literal at a type whose instance a module wrote is one call of that instance, wherever it is.
// example: held.is_held(a_literal_at_a_declared_type_is_one_call_of_its_from_literal(0, ir.little_library()))
fn a_literal_at_a_declared_type_is_one_call_of_its_from_literal(cases: Int, library: ir.Library) -> held.Held {
    checked(property: Literal, cases: cases, library: library)
}

/// A whole number written where an `Int` is expected is pushed as it is, and calls nothing.
// example: held.is_held(a_whole_number_where_an_int_is_expected_is_that_number_and_nothing_more(0, ir.little_library()))
fn a_whole_number_where_an_int_is_expected_is_that_number_and_nothing_more(cases: Int, library: ir.Library) -> held.Held {
    checked(property: WholeNumber, cases: cases, library: library)
}

/// For each derived trait, a record of any shape reads every field in the order it declares.
// example: held.is_held(a_record_of_any_shape_derives_a_body_that_reads_every_field_in_order(0, ir.little_library()))
fn a_record_of_any_shape_derives_a_body_that_reads_every_field_in_order(cases: Int, library: ir.Library) -> held.Held {
    checked(property: Derived, cases: cases, library: library)
}

/// A generic constrained by `Eq`, written for a set, calls the instance each type of the set has.
///
/// The method is written into the module that declares the generic, and it calls the instance in
/// the module that declares the type. A type the JVM holds has no instance method to call.
// example: held.is_held(a_method_written_for_a_set_calls_the_instance_each_type_in_that_set_has(0, ir.little_library()))
fn a_method_written_for_a_set_calls_the_instance_each_type_in_that_set_has(cases: Int, library: ir.Library) -> held.Held {
    beside(property: Constrained, cases: cases, library: library)
}

/// The module declaring a generic writes each method a use in another module asks it for.
// example: held.is_held(every_method_a_use_asks_for_is_one_the_module_asked_writes(0, ir.little_library()))
fn every_method_a_use_asks_for_is_one_the_module_asked_writes(cases: Int, library: ir.Library) -> held.Held {
    beside(property: Specialised, cases: cases, library: library)
}

/// `property` checked over `cases` drawn modules, each drawn from a seed of its own.
// example: checked(property: Literal, cases: 0, library: ir.little_library()).cases == 0
fn checked(property: Property, cases: Int, library: ir.Library) -> held.Held {
    checked_beside(property: property, cases: cases, place: Place { directory: "no-such-directory", library: library })
}

/// `property` checked with the module `holder` in a directory of its own, which is removed after.
// example: held.is_held(beside(property: Specialised, cases: 0, library: ir.little_library()))
fn beside(property: Property, cases: Int, library: ir.Library) -> held.Held {
    if cases == 0 {
        return held.nothing_failed(0)
    }
    match command.somewhere_of_its_own() {
        Ok(directory) => held_beside(property: property, cases: cases, place: Place { directory: directory, library: library })
        Err(_) => held.with_failure(held.nothing_failed(cases), "property " + name_of(property) + ": no directory of its own to write `holder` in")
    }
}

/// `property` checked with `holder` written in `place`, which is removed once it has been checked.
// example: list.length(held_beside(property: Specialised, cases: 1, place: Place { directory: "no-such-directory", library: ir.little_library() }).failures) == 1
fn held_beside(property: Property, cases: Int, place: Place) -> held.Held {
    _ = files.write(modules.joined(place.directory, "holder.lm"), holder())
    found := checked_beside(property: property, cases: cases, place: place)
    command.removed_whole(place.directory)
    found
}

/// A module declaring generics, which a drawn module reaches through an import.
///
/// `held` writes its type parameter out, `passed` lets inference find it, `counted` writes one that
/// reaches no further than the inside of a `List`, and `is_same` constrains one by `Eq`.
// example: holder() != ""
fn holder() -> String {
    "fn held<T>(value: T) -> T {\n    value\n}\n\nfn passed(value) {\n    value\n}\n\nfn counted<T>(values: List<T>) -> Int {\n    1\n}\n\nfn is_same<T: Eq<T>>(one: T, other: T) -> Bool {\n    one == other\n}\n"
}

/// `property` checked over `cases` modules drawn beside `place`.
// example: checked_beside(property: Literal, cases: 0, place: Place { directory: "no-such-directory", library: ir.little_library() }).cases == 0
fn checked_beside(property: Property, cases: Int, place: Place) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        seed := drawn.seed_of(case)
        one := drawing(property: property, draw: drawn.seeded(seed), place: place)
        found = compiled.noted(found, one.why, held.drawn_failure(name_of(property), seed, one.source, one.why))
        case += 1
    }
    found
}

/// The module `property` draws with `draw`, and what went wrong with it, which is empty if nothing.
// example: drawing(property: Literal, draw: drawn.seeded(1), place: Place { directory: "no-such-directory", library: ir.little_library() }).source != ""
fn drawing(property: Property, draw: drawn.Draw, place: Place) -> Drawing {
    match property {
        Operator => operator(draw, place.library)
        Comparison => comparison(draw, place.library)
        Literal => literal(draw, place.library)
        WholeNumber => whole_number(draw, place.library)
        Derived => derived(draw, place.library)
        Constrained => constrained(draw, place)
        Specialised => specialised(draw, place)
    }
}

/// The name a failure of `property` is reported with.
// example: name_of(Literal) == "a_literal_at_a_declared_type_is_one_call_of_its_from_literal"
fn name_of(property: Property) -> String {
    match property {
        Operator => "an_operator_over_a_type_with_an_instance_calls_that_instance_and_no_other"
        Comparison => "a_comparison_is_one_call_of_is_less_whichever_way_round_it_is_written"
        Literal => "a_literal_at_a_declared_type_is_one_call_of_its_from_literal"
        WholeNumber => "a_whole_number_where_an_int_is_expected_is_that_number_and_nothing_more"
        Derived => "a_record_of_any_shape_derives_a_body_that_reads_every_field_in_order"
        Constrained => "a_method_written_for_a_set_calls_the_instance_each_type_in_that_set_has"
        Specialised => "every_method_a_use_asks_for_is_one_the_module_asked_writes"
    }
}

/// A drawn operator over `Money`, which calls the one instance method it is written for.
// example: operator(drawn.seeded(1), ir.little_library()).source != ""
fn operator(draw: drawn.Draw, library: ir.Library) -> Drawing {
    at := drawn.number(draw, 10)
    written := or(list.at(["one + other", "one - other", "one * other", "one / other", "one % other", "-one", "one < other", "one <= other", "one > other", "one >= other"], at), "")
    called := or(list.at(["Add$Money$add", "Sub$Money$subtract", "Mul$Money$multiply", "Div$Money$divide", "Rem$Money$remainder", "Neg$Money$negate", "Ord$Money$is_less", "Ord$Money$is_less", "Ord$Money$is_less", "Ord$Money$is_less"], at), "")
    source := owning(written)
    Drawing { source: source, why: instances_why(found: instances_called(compiled.lowered_alone(source, library)), wanted: called) }
}

/// A drawn comparison over `Money`, which is one call of `is_less` whichever way round it is.
// example: comparison(drawn.seeded(1), ir.little_library()).source != ""
fn comparison(draw: drawn.Draw, library: ir.Library) -> Drawing {
    written := drawn.picked(draw, ["one < other", "one <= other", "one > other", "one >= other"], "")
    source := owning(written)
    Drawing { source: source, why: instances_why(found: instances_called(compiled.lowered_alone(source, library)), wanted: "Ord$Money$is_less") }
}

/// A module writing `written` over `Money`, which has an instance of every operator's trait.
// example: owning("-one") != ""
fn owning(written: String) -> String {
    "fn worked_out(one: Money, other: Money) -> () {\n    _ = " + written + "\n    ()\n}\n" + money_owns()
}

/// `Money` with an instance of every trait an operator is, so any operator may be written over it.
// example: money_owns() != ""
fn money_owns() -> String {
    "\ninstance Add<Money> {\n    fn add(one: Money, other: Money) -> Money {\n        one\n    }\n}\n\ninstance Sub<Money> {\n    fn subtract(one: Money, other: Money) -> Money {\n        one\n    }\n}\n\ninstance Mul<Money> {\n    fn multiply(one: Money, other: Money) -> Money {\n        one\n    }\n}\n\ninstance Div<Money> {\n    fn divide(one: Money, other: Money) -> Option<Money> {\n        Some(one)\n    }\n}\n\ninstance Rem<Money> {\n    fn remainder(one: Money, other: Money) -> Option<Money> {\n        Some(one)\n    }\n}\n\ninstance Neg<Money> {\n    fn negate(value: Money) -> Money {\n        value\n    }\n}\n\ninstance Ord<Money> {\n    fn is_less(one: Money, other: Money) -> Bool {\n        one.cents < other.cents\n    }\n}\n\ntype Money = {\n    cents: Int\n}\n"
}

/// The instance methods `worked_out` calls, in the order it calls them.
// example: instances_called([]) == []
fn instances_called(lowered: List<ir.Lowered>) -> List<String> {
    var names = []
    for name in compiled.calls_named(compiled.instructions_of(lowered, "worked_out")) {
        if compiled.is_holding(name, "$") {
            names = list.push(names, name)
        }
    }
    names
}

/// A drawn literal at `Int32`, which is one call of the `from_literal` of its instance.
// example: literal(drawn.seeded(1), ir.little_library()).source != ""
fn literal(draw: drawn.Draw, library: ir.Library) -> Drawing {
    written := drawn.picked(draw, ["42", "-1", "2147483647"], "")
    source := "fn counted() -> Int32 {\n    " + written + "\n}\n" + int32()
    calls := compiled.calls_named(compiled.instructions_of(compiled.lowered_alone(source, library), "counted"))
    Drawing { source: source, why: instances_why(found: calls, wanted: "IntegerLiteral$Int32$from_literal") }
}

/// What is wrong where `found` is not the one call `wanted`, which is empty where it is.
// example: instances_why(found: ["a"], wanted: "a") == ""
// example: instances_why(found: [], wanted: "a") == "it calls [], not a"
fn instances_why(found: List<String>, wanted: String) -> String {
    if found == [wanted] {
        return ""
    }
    "it calls " + shown(found) + ", not " + wanted
}

/// A type of its own with an instance of `IntegerLiteral`, so a whole number may be written at it.
// example: int32() != ""
fn int32() -> String {
    "\ninstance IntegerLiteral<Int32> {\n    fn lowest() -> Int {\n        -2147483648\n    }\n\n    fn highest() -> Int {\n        2147483647\n    }\n\n    fn from_literal(literal: Int) -> Int32 {\n        Int32(literal)\n    }\n}\n\ntype Int32 = Int32(Int)\n"
}

/// A drawn whole number at `Int`, which is pushed as it is written and calls nothing.
// example: whole_number(drawn.seeded(1), ir.little_library()).why == ""
fn whole_number(draw: drawn.Draw, library: ir.Library) -> Drawing {
    value := whole_drawn(draw)
    source := "fn counted() -> Int {\n    " + shown(value) + "\n}\n"
    body := compiled.instructions_of(compiled.lowered_alone(source, library), "counted")
    var why = ""
    if !has_long(body, value) {
        why = "it pushes no long " + shown(value)
    }
    if list.length(compiled.calls_named(body)) != 0 {
        why = "it calls " + shown(compiled.calls_named(body))
    }
    Drawing { source: source, why: why }
}

/// A whole number from 0 up to the largest `Int`, of a drawn number of digits.
// example: whole_drawn(drawn.seeded(1)) >= 0
fn whole_drawn(draw: drawn.Draw) -> Int {
    digits := drawn.number(draw, 19)
    high := drawn.number(drawn.next(draw), 2147483647)
    low := drawn.number(drawn.next(drawn.next(draw)), 2147483647)
    whole := high * 4294967296 + low
    or(whole % power_of_ten(digits), 0)
}

/// Ten times itself `digits` times, the least of which is one.
// example: power_of_ten(0) == 1
// example: power_of_ten(3) == 1000
fn power_of_ten(digits: Int) -> Int {
    var power = 1
    var counted = 0
    for counted < digits {
        power = power * 10
        counted += 1
    }
    power
}

/// Whether `body` pushes the `long` `value`.
// example: has_long([ir.LongOf(3)], 3)
// example: !has_long([ir.IntegerOf(3)], 3)
fn has_long(body: List<ir.Instruction>, value: Int) -> Bool {
    for instruction in body {
        if is_long_of(instruction, value) {
            return true
        }
    }
    false
}

/// Whether `instruction` pushes the `long` `value`.
// example: is_long_of(ir.LongOf(3), 3)
// example: !is_long_of(ir.LongOf(4), 3)
fn is_long_of(instruction: ir.Instruction, value: Int) -> Bool {
    match instruction {
        ir.LongOf(pushed) => pushed == value
        _ => false
    }
}

/// A record of drawn fields deriving a drawn trait, whose method reads every field in order.
// example: derived(drawn.seeded(1), ir.little_library()).source != ""
fn derived(draw: drawn.Draw, library: ir.Library) -> Drawing {
    at := drawn.number(draw, 4)
    of := or(list.at(["Eq", "Ord", "Hash", "Show"], at), "")
    many := drawn.number(drawn.next(draw), 5) + 1
    kinds := drawn.numbers(drawn.next(drawn.next(draw)), many, 3)
    var lines = ""
    var wanted = []
    var position = 0
    for kind in kinds {
        name := "value" + shown(position)
        lines += "    " + name + ": " + or(list.at(["Int", "Bool", "String"], kind), "") + "\n"
        wanted = compiled.both(wanted, repeated(name: name, times: times_read(at)))
        position += 1
    }
    source := "derive " + of + " for Point\n\ntype Point = {\n" + lines + "}\n"
    method := of + "$Point$" + or(list.at(["is_equal", "is_less", "hashed", "shown"], at), "")
    found := fields_read(compiled.instructions_of(compiled.lowered_alone(source, library), method))
    var why = ""
    if found != wanted {
        why = method + " reads " + shown(found) + ", not " + shown(wanted)
    }
    Drawing { source: source, why: why }
}

/// How often a derive of the trait at `at` reads a field: `Eq` reads two values, `Ord` both ways.
// example: times_read(0) == 2
// example: times_read(3) == 1
fn times_read(at: Int) -> Int {
    or(list.at([2, 4, 1, 1], at), 1)
}

/// `name`, `times` times over.
// example: repeated(name: "a", times: 2) == ["a", "a"]
fn repeated(name: String, times: Int) -> List<String> {
    var names = []
    for list.length(names) < times {
        names = list.push(names, name)
    }
    names
}

/// The names of the fields `body` reads, in the order it reads them.
// example: fields_read([ir.GetField(ir.FieldRef { class: "a", name: "b", of: ir.Long })]) == ["b"]
fn fields_read(body: List<ir.Instruction>) -> List<String> {
    var names = []
    for instruction in body {
        names = compiled.both(names, field_named(instruction))
    }
    names
}

/// The field `instruction` reads off an instance, where it reads one.
// example: field_named(ir.Copy) == []
fn field_named(instruction: ir.Instruction) -> List<String> {
    match instruction {
        ir.GetField(field) => [field.name]
        _ => []
    }
}

/// A drawn use of `holder.is_same`, whose method calls the instance of the type it settles.
// example: constrained(drawn.seeded(1), Place { directory: "no-such-directory", library: ir.little_library() }).source != ""
fn constrained(draw: drawn.Draw, place: Place) -> Drawing {
    at := drawn.number(draw, 4)
    written := or(list.at(["1, 2", "\"a\", \"b\"", "true, false", "Kept(\"a\"), Kept(\"b\")"], at), "")
    named := or(list.at(["is_same$Int", "is_same$String", "is_same$Bool", "is_same$demo$Kept"], at), "")
    var wanted = []
    if at == 3 {
        wanted = ["demo.Eq$Kept$is_equal"]
    }
    source := "import holder\n\nfn is_it() -> Bool {\n    holder.is_same(" + written + ")\n}\n\nderive Eq for Kept\n\ntype Kept = Kept(String)\n"
    lowered := compiled.lowered_beside(source, place.directory, place.library)
    body := compiled.method_in(compiled.module_classes(lowered, "holder"), "holder", named)
    var why = "holder writes no " + named
    if !compiled.is_none(body) {
        found := instances_reached(or(body, ir.Body { instructions: [], locals: 0, guards: [] }).instructions)
        why = ""
        if found != wanted {
            why = "holder writes " + named + " calling " + shown(found) + ", not " + shown(wanted)
        }
    }
    Drawing { source: source, why: why }
}

/// Every instance method `body` calls as a static method, as its class and name, in order.
// example: instances_reached([ir.Copy]) == []
fn instances_reached(body: List<ir.Instruction>) -> List<String> {
    var reached = []
    for instruction in body {
        reached = compiled.both(reached, instance_reached(instruction))
    }
    reached
}

/// The class and name of the instance method `instruction` calls as a static method, where it does.
// example: instance_reached(ir.Copy) == []
fn instance_reached(instruction: ir.Instruction) -> List<String> {
    match instruction {
        ir.InvokeStatic(reference) => instance_named(reference)
        _ => []
    }
}

/// The class and name of `reference` where its name says it is an instance method, else nothing.
// example: instance_named(ir.MethodRef { class: "a", name: "Eq$A$is_equal", descriptor: ir.MethodDescriptor { parameters: [], result: None } }) == ["a.Eq$A$is_equal"]
fn instance_named(reference: ir.MethodRef) -> List<String> {
    if compiled.is_holding(reference.name, "$") {
        return [reference.class + "." + reference.name]
    }
    []
}

/// A drawn use of a generic of `holder`, which `holder` writes as the use reaches it.
// example: specialised(drawn.seeded(1), Place { directory: "no-such-directory", library: ir.little_library() }).source != ""
fn specialised(draw: drawn.Draw, place: Place) -> Drawing {
    at := drawn.number(draw, 8)
    use_of_it := or(list.at(["holder.held(1)", "holder.held(\"one\")", "holder.held(Kept(\"a\"))", "holder.held([2])", "holder.passed(1)", "holder.counted([1])", "holder.counted([\"one\"])", "holder.counted([Kept(\"a\")])"], at), "")
    result := or(list.at(["Int", "String", "Kept", "List<Int>", "Int", "Int", "Int", "Int"], at), "")
    source := "import holder\n\nfn go() -> " + result + " {\n    " + use_of_it + "\n}\n\ntype Kept = Kept(String)\n"
    lowered := compiled.lowered_beside(source, place.directory, place.library)
    Drawing { source: source, why: asked_why(lowered) }
}

/// What is wrong where `holder` writes no method as `go` reaches it, which is empty where it does.
// example: asked_why([]) == "go calls nothing of holder"
fn asked_why(lowered: List<ir.Lowered>) -> String {
    for instruction in compiled.instructions_of(lowered, "go") {
        reference := or(compiled.called(instruction), no_call())
        if reference.class == "holder" {
            return written_why(classes: compiled.module_classes(lowered, "holder"), reference: reference)
        }
    }
    "go calls nothing of holder"
}

/// A call of nothing, which stands where an instruction calls no method.
// example: no_call().name == ""
fn no_call() -> ir.MethodRef {
    ir.MethodRef { class: "", name: "", descriptor: ir.MethodDescriptor { parameters: [], result: None } }
}

/// What is wrong where `classes` write no method as `reference` reaches it, or nothing.
// example: written_why(classes: [], reference: no_call()) == "holder writes no "
fn written_why(classes: List<ir.Class>, reference: ir.MethodRef) -> String {
    for class in classes {
        for method in class.methods {
            if class.name == "holder" && method.name == reference.name {
                return descriptor_why(written: method.descriptor, reached: reference.descriptor)
            }
        }
    }
    "holder writes no " + reference.name
}

/// What sets the descriptor `written` apart from the one `reached`, or nothing.
// example: descriptor_why(written: no_call().descriptor, reached: no_call().descriptor) == ""
fn descriptor_why(written: ir.MethodDescriptor, reached: ir.MethodDescriptor) -> String {
    if written.parameters != reached.parameters || !is_same_result(written: written.result, reached: reached.result) {
        return "holder writes the method apart from how the use reaches it"
    }
    ""
}

/// Whether `written` and `reached` give back the same, which may be nothing for both.
// example: is_same_result(written: None, reached: None)
// example: !is_same_result(written: Some(ir.Long), reached: None)
fn is_same_result(written: Option<ir.Descriptor>, reached: Option<ir.Descriptor>) -> Bool {
    if compiled.is_none(written) || compiled.is_none(reached) {
        return compiled.is_none(written) && compiled.is_none(reached)
    }
    or(written, ir.Long) == or(reached, ir.Long)
}

/// Where a drawn module is checked: the directory it is written into, and the library it reaches.
type Place = {
    directory: String
    library: ir.Library
}

/// One drawn module, and what went wrong with it, which is empty where the property held.
type Drawing = {
    source: String
    why: String
}

/// Each property of what an instance becomes.
type Property =
    | Operator
    | Comparison
    | Literal
    | WholeNumber
    | Derived
    | Constrained
    | Specialised
