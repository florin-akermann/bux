// The drawn property of the orders `bux fmt` repairs, which `docs/specs/formatting.md` states.
//
// A module is drawn as a fixed set of items in a drawn order: imports, a type, functions that use
// each other and one pair that calls each other, and tests. What `bux fmt` writes for it is held
// to build, and to be written again as it is.
import checking
import command
import drawn
import held
import ir
import list
import strings

// example: held.is_held(a_module_in_any_order_is_repaired_to_one_that_builds(0, ir.little_library()))
fn a_module_in_any_order_is_repaired_to_one_that_builds(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        let source = strings.join(shuffled(items(), drawn.seeded(seed)), "\n\n") + "\n"
        found = checking.noted(found, "a_module_in_any_order_is_repaired_to_one_that_builds", seed, checking.Tried { input: source, why: repair_fault(source, library) })
    }
    found
}

// example: repair_fault("fn one() -> Int {\n    1\n}\n\nfn two() -> Int {\n    one()\n}\n", ir.little_library()) == ""
fn repair_fault(source: String, library: ir.Library) -> String {
    let once = ok_or(command.repaired(source, library.prelude.names), "")
    let form = checking.code_of(command.in_canonical_form(once))
    if form != "" {
        return "the repaired text " + held.quoted(once) + " is refused as " + form
    }
    let built = checking.code_of(checking.reaching(once, "no-such-directory", library))
    if built != "" {
        return "the repaired text " + held.quoted(once) + " is refused as " + built
    }
    let twice = ok_or(command.repaired(once, library.prelude.names), "")
    if twice != once {
        return "a second repair of " + held.quoted(once) + " writes " + held.quoted(twice)
    }
    ""
}

// example: list.length(shuffled(["a", "b", "c"], drawn.seeded(1))) == 3
fn shuffled(values: List<String>, draw: drawn.Draw) -> List<String> {
    var left = values
    var order = []
    var at = draw
    for _ in values {
        let taken = drawn.number(at, list.length(left))
        order = list.push(order, or(list.at(left, taken), ""))
        left = without(left, taken)
        at = drawn.next(at)
    }
    order
}

// example: without(["a", "b", "c"], 1) == ["a", "c"]
fn without(values: List<String>, index: Int) -> List<String> {
    var kept = []
    var at = 0
    for value in values {
        if at != index {
            kept = list.push(kept, value)
        }
        at += 1
    }
    kept
}

// `total` uses `summed` and `counted`, `is_even` and `is_odd` call each other, and `length_of`
// reads `Shape`, so most orders put a declaration above a declaration that uses it.
// example: list.length(items()) == 12
fn items() -> List<String> {
    ["import list", "import strings", "/// The sum and the count of `values`.\nfn total(values: List<Int>) -> Int {\n    summed(values) + counted(values)\n}", "/// The sum of `values`.\nfn summed(values: List<Int>) -> Int {\n    var sum = 0\n    for value in values {\n        sum += value\n    }\n    sum\n}", "fn counted(values: List<Int>) -> Int {\n    list.length(values)\n}", "fn is_even(count: Int) -> Bool {\n    if count == 0 {\n        return true\n    }\n    is_odd(count - 1)\n}", "fn is_odd(count: Int) -> Bool {\n    if count == 0 {\n        return false\n    }\n    is_even(count - 1)\n}", "type Shape =\n    | Dot\n    | Line(Int)", "fn length_of(shape: Shape) -> Int {\n    match shape {\n        Dot => 0\n        Line(size) => size\n    }\n}", "fn spoken(words: List<String>) -> String {\n    strings.join(words, \" \")\n}", "test \"sums\" {\n    total([1, 2]) == 5\n}", "test \"evens\" {\n    is_even(4)\n}"]
}

test "a module in any order is repaired to one that builds" {
    held.is_held_reported(a_module_in_any_order_is_repaired_to_one_that_builds(held.drawn_cases(), checking.carried_library()))
}
