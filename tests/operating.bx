// The drawn properties of whole-number literals and of operators, which `docs/specs/literals.md`
// and `docs/specs/operators.md` state.
import checking
import command
import drawn
import held
import infer
import ir
import list
import strings

// example: a_literal_nothing_settles_is_an_int(2, ir.little_library()).cases == 2
fn a_literal_nothing_settles_is_an_int(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "a_literal_nothing_settles_is_an_int", seed, unsettled_tried(drawn.seeded(seed), library))
    }
    found
}

// example: unsettled_tried(drawn.seeded(1), ir.little_library()).input != ""
fn unsettled_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    let written = shown(drawn.number(draw, 2000001) - 1000000)
    let source = "fn counted() -> Int {\n    " + written + "\n}\n\n" + int32()
    let typed = checking.type_written(source, written, 1, library)
    if typed != "Int" {
        return checking.Tried { input: source, why: written + " is " + typed }
    }
    checking.Tried { input: source, why: "" }
}

// example: a_literal_is_accepted_exactly_inside_its_range(2, ir.little_library()).cases == 2
fn a_literal_is_accepted_exactly_inside_its_range(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "a_literal_is_accepted_exactly_inside_its_range", seed, edge_tried(drawn.seeded(seed), library))
    }
    found
}

// example: edge_tried(drawn.seeded(1), ir.little_library()).input != ""
fn edge_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    let edge = drawn.picked(draw, at_the_edge(), Edge { written: "0", fits: Fits })
    let source = "fn counted() -> Int32 {\n    " + edge.written + "\n}\n\n" + int32()
    let answer = checking.checked(source, library)
    if fit_of(answer: answer, source: source, written: edge.written) != edge.fits {
        return checking.Tried { input: source, why: edge.written + ": " + checking.message_of(answer) }
    }
    checking.Tried { input: source, why: "" }
}

// example: fit_of(answer: Err(checking.said_as_diagnostic("gone")), source: "", written: "5") == PointsElsewhere
fn fit_of(answer: Result<infer.Inference, command.Diagnostic>, source: String, written: String) -> Fit {
    match answer {
        Ok(_) => Fits
        Err(refused) => refused_at(pointed: or(strings.cut(source, refused.span.start, refused.span.start + refused.span.length), ""), written: written)
    }
}

// example: refused_at(pointed: "5", written: "5") == FitsNot
// example: refused_at(pointed: "", written: "5") == PointsElsewhere
fn refused_at(pointed: String, written: String) -> Fit {
    if pointed == written {
        return FitsNot
    }
    PointsElsewhere
}

// example: a_whole_number_where_an_int_is_expected_is_an_int(2, ir.little_library()).cases == 2
fn a_whole_number_where_an_int_is_expected_is_an_int(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "a_whole_number_where_an_int_is_expected_is_an_int", seed, whole_tried(drawn.seeded(seed), library))
    }
    found
}

// example: whole_tried(drawn.seeded(1), ir.little_library()).input != ""
fn whole_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    let written = shown(whole_number(draw))
    let source = "fn counted(number: Int) -> Int {\n    number + " + written + "\n}\n"
    let typed = checking.type_written(source, written, 1, library)
    if typed != "Int" {
        return checking.Tried { input: source, why: written + " is " + typed }
    }
    checking.Tried { input: source, why: "" }
}

// example: whole_number(drawn.seeded(1)) >= 0
fn whole_number(draw: drawn.Draw) -> Int {
    var value = drawn.number(draw, 2147483648) * 4294967296 + drawn.number(drawn.next(draw), 4294967296)
    for _ in checking.numbers_below(drawn.number(checking.after(draw, 2), 19)) {
        value = or(value / 10, 0)
    }
    value
}

// example: an_operator_over_ints_gives_back_what_it_always_gave(2, ir.little_library()).cases == 2
fn an_operator_over_ints_gives_back_what_it_always_gave(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "an_operator_over_ints_gives_back_what_it_always_gave", seed, over_ints_tried(drawn.seeded(seed), library))
    }
    found
}

// example: over_ints_tried(drawn.seeded(1), ir.little_library()).input != ""
fn over_ints_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    let operator = drawn.picked(draw, over_ints(), Operator { written: "one + other", gives: "Int" })
    let source = written_over(written: operator.written, over: "Int", declares: "")
    let typed = checking.type_written(source, operator.written, 1, library)
    if typed != operator.gives {
        return checking.Tried { input: source, why: operator.written + " is " + typed }
    }
    checking.Tried { input: source, why: "" }
}

// example: an_operator_over_a_type_with_no_instance_is_refused(2, ir.little_library()).cases == 2
fn an_operator_over_a_type_with_no_instance_is_refused(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "an_operator_over_a_type_with_no_instance_is_refused", seed, over_point_tried(drawn.seeded(seed), library))
    }
    found
}

// example: over_point_tried(drawn.seeded(1), ir.little_library()).input != ""
fn over_point_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    let operator = drawn.picked(draw, over_ints(), Operator { written: "one + other", gives: "Int" })
    let source = written_over(written: operator.written, over: "Point", declares: "\ntype Point = {\n    across: Int\n}\n")
    let message = checking.message_of(checking.checked(source, library))
    if checking.occurrence(message, "`Point` has no `", 1).start != 0 {
        return checking.Tried { input: source, why: "the refusal says " + held.quoted(message) }
    }
    checking.Tried { input: source, why: "" }
}

// The module discards the value of the operator, so it says nothing about its type.
// example: written_over(written: "one", over: "Int", declares: "") == "fn worked_out(one: Int, other: Int) -> () {\n    _ = one\n    ()\n}\n"
fn written_over(written: String, over: String, declares: String) -> String {
    "fn worked_out(one: " + over + ", other: " + over + ") -> () {\n    _ = " + written + "\n    ()\n}\n" + declares
}

// example: list.length(over_ints()) == 9
fn over_ints() -> List<Operator> {
    [Operator { written: "one + other", gives: "Int" }, Operator { written: "one - other", gives: "Int" }, Operator { written: "one * other", gives: "Int" }, Operator { written: "one / other", gives: "Option<Int>" }, Operator { written: "one % other", gives: "Option<Int>" }, Operator { written: "one < other", gives: "Bool" }, Operator { written: "one <= other", gives: "Bool" }, Operator { written: "one > other", gives: "Bool" }, Operator { written: "one >= other", gives: "Bool" }]
}

// example: list.length(at_the_edge()) == 6
fn at_the_edge() -> List<Edge> {
    [Edge { written: "-2147483649", fits: FitsNot }, Edge { written: "-2147483648", fits: Fits }, Edge { written: "-1", fits: Fits }, Edge { written: "0", fits: Fits }, Edge { written: "2147483647", fits: Fits }, Edge { written: "2147483648", fits: FitsNot }]
}

// example: strings.length(int32()) > 0
fn int32() -> String {
    "instance IntegerLiteral<Int32> {\n    fn lowest() -> Int {\n        -2147483648\n    }\n\n    fn highest() -> Int {\n        2147483647\n    }\n\n    fn from_literal(literal: Int) -> Int32 {\n        Int32(literal)\n    }\n}\n\ntype Int32 = Int32(Int)\n"
}

type Operator = {
    written: String
    gives: String
}

type Edge = {
    written: String
    fits: Fit
}

derive Eq for Fit

type Fit =
    | Fits
    | FitsNot
    | PointsElsewhere

test "a literal nothing settles is an int" {
    held.is_held_reported(a_literal_nothing_settles_is_an_int(held.drawn_cases(), checking.carried_library()))
}

test "a literal is accepted exactly inside its range" {
    held.is_held_reported(a_literal_is_accepted_exactly_inside_its_range(held.drawn_cases(), checking.carried_library()))
}

test "a whole number where an int is expected is an int" {
    held.is_held_reported(a_whole_number_where_an_int_is_expected_is_an_int(held.drawn_cases(), checking.carried_library()))
}

test "an operator over ints gives back what it always gave" {
    held.is_held_reported(an_operator_over_ints_gives_back_what_it_always_gave(held.drawn_cases(), checking.carried_library()))
}

test "an operator over a type with no instance is refused" {
    held.is_held_reported(an_operator_over_a_type_with_no_instance_is_refused(held.drawn_cases(), checking.carried_library()))
}
