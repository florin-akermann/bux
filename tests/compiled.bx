// A drawn source compiled in the JVM of its test: checked, lowered, and written as class files.
//
// The drawn properties of the lowering and of the class-file writer read what those phases give
// back through these. A drawn source is checked as the module `demo`, so its own class is `demo`.
import command
import held
import infer
import ir
import jvm
import list
import strings

// example: list.length(written_alone("fn (", ir.little_library())) == 0
fn written_alone(source: String, library: ir.Library) -> List<jvm.ClassFile> {
    classes_of(lowered_alone(source, library))
}

// example: list.length(classes_of([])) == 0
fn classes_of(program: List<ir.Lowered>) -> List<jvm.ClassFile> {
    ok_or(jvm.program_written(program), [])
}

// example: list.length(lowered_alone("fn (", ir.little_library())) == 0
fn lowered_alone(source: String, library: ir.Library) -> List<ir.Lowered> {
    lowered_beside(source: source, directory: "no-such-directory", library: library)
}

// A drawn source states no example, so a function here need not state one, as in a build it must.
// example: list.length(lowered_beside(source: "fn (", directory: "no-such-directory", library: ir.little_library())) == 0
fn lowered_beside(source: String, directory: String, library: ir.Library) -> List<ir.Lowered> {
    match command.checked_as_written(command.Page { source: source, path: directory + "/demo.bx" }, library) {
        Ok(program) => spelled_whole(ir.passes_lowered(inferred_of(program), library))
        Err(_) => []
    }
}

// A property reads each method as the writer spells it, so a method that the writer cannot spell
// refuses the whole source, and does not stay as a method with no instruction.
// example: list.length(spelled_whole([])) == 0
fn spelled_whole(lowered: List<ir.Lowered>) -> List<ir.Lowered> {
    for class in every_class(lowered) {
        for method in class.methods {
            if !is_spelled(jvm.method_spelled(method, jvm.class_of(class.of))) {
                return []
            }
        }
    }
    lowered
}

// example: !is_spelled(Err(jvm.Defect("")))
fn is_spelled(spelled: Result<jvm.Spelled, jvm.Why>) -> Bool {
    match spelled {
        Ok(_) => true
        Err(_) => false
    }
}

// example: list.length(lowered_alone("fn f() -> Int {\n    1\n}\n", ir.little_library())) == 2
fn inferred_of(program: command.Checked) -> List<infer.Inference> {
    var typed = []
    for one in program.modules {
        typed = list.push(typed, one.inferred)
    }
    typed
}

// example: differing(first: [], second: []) == "the compiler refused it"
fn differing(first: List<jvm.ClassFile>, second: List<jvm.ClassFile>) -> String {
    if list.length(first) == 0 {
        return "the compiler refused it"
    }
    if list.length(first) != list.length(second) {
        return "one writes " + shown(list.length(first)) + " classes, the other " + shown(list.length(second))
    }
    var index = 0
    for file in first {
        let other = or(list.at(second, index), jvm.ClassFile { path: "", bytes: [] })
        if file.path != other.path || file.bytes != other.bytes {
            return file.path + " is written apart from " + other.path
        }
        index += 1
    }
    ""
}

// example: list.length(noted(found: held.nothing_failed(1), why: "", line: "a").failures) == 0
// example: list.length(noted(found: held.nothing_failed(1), why: "gone", line: "a").failures) == 1
fn noted(found: held.Held, why: String, line: String) -> held.Held {
    if why == "" {
        return found
    }
    held.with_failure(found, line)
}

// example: list.length(every_class([ir.no_lowered()])) == 0
fn every_class(lowered: List<ir.Lowered>) -> List<ir.Class> {
    var classes = []
    for module in lowered {
        classes = both(first: classes, second: module.classes)
    }
    classes
}

// example: list.length(demo_bodies([])) == 0
fn demo_bodies(lowered: List<ir.Lowered>) -> List<List<jvm.Instruction>> {
    var bodies = []
    for class in demo_classes(lowered) {
        for method in class.methods {
            bodies = list.push(bodies, spelled_of(method: method, class: class).instructions)
        }
    }
    bodies
}

// example: list.length(instructions_of(lowered: [], named: "go")) == 0
fn instructions_of(lowered: List<ir.Lowered>, named: String) -> List<jvm.Instruction> {
    match body_of(lowered: lowered, named: named) {
        Some(body) => body.instructions
        None => []
    }
}

// example: is_none(body_of(lowered: [], named: "go"))
fn body_of(lowered: List<ir.Lowered>, named: String) -> Option<jvm.Spelled> {
    method_in(classes: demo_classes(lowered), class: "demo", named: named)
}

// example: list.length(demo_classes([])) == 0
fn demo_classes(lowered: List<ir.Lowered>) -> List<ir.Class> {
    module_classes(lowered: lowered, named: "demo")
}

// example: list.length(module_classes(lowered: [], named: "demo")) == 0
fn module_classes(lowered: List<ir.Lowered>, named: String) -> List<ir.Class> {
    for module in lowered {
        if jvm.class_of(or(list.at(module.classes, 0), no_class()).of) == named {
            return module.classes
        }
    }
    []
}

// example: is_none(method_in(classes: [], class: "demo", named: "go"))
fn method_in(classes: List<ir.Class>, class: String, named: String) -> Option<jvm.Spelled> {
    for one in classes {
        if jvm.class_of(one.of) == class {
            return body_named(one, named)
        }
    }
    None
}

// example: is_none(body_named(no_class(), "go"))
fn body_named(class: ir.Class, named: String) -> Option<jvm.Spelled> {
    for method in class.methods {
        if method.name == named {
            return Some(spelled_of(method: method, class: class))
        }
    }
    None
}

// `lowered_beside` gives no class that the writer refuses, so the empty method is only for a class
// that a test builds itself.
// example: list.length(spelled_of(method: ir.Method { name: "go", parameters: [], result: None, reached: ir.ThroughTheClass, body: ir.Body { instructions: [ir.Return(None)], locals: [], guards: [] } }, class: no_class()).instructions) == 1
fn spelled_of(method: ir.Method, class: ir.Class) -> jvm.Spelled {
    match jvm.method_spelled(method, jvm.class_of(class.of)) {
        Ok(spelled) => spelled
        Err(_) => no_spelled()
    }
}

// example: list.length(no_spelled().guards) == 0
fn no_spelled() -> jvm.Spelled {
    jvm.Spelled { name: "", descriptor: jvm.MethodDescriptor { parameters: [], result: None }, receiver: None, instructions: [], slots: 0, guards: [] }
}

// example: is_none(None)
// example: !is_none(Some(1))
fn is_none<T>(maybe: Option<T>) -> Bool {
    match maybe {
        Some(_) => false
        None => true
    }
}

// example: jvm.class_of(no_class().of) == ""
fn no_class() -> ir.Class {
    ir.Class { of: ir.ModuleOf(ir.OfTheProgram("")), extends: ir.Anything, extending: ir.Never, implements: [], fields: [], methods: [] }
}

// example: calls_named([jvm.Copy]) == []
fn calls_named(instructions: List<jvm.Instruction>) -> List<String> {
    var names = []
    for instruction in instructions {
        names = both(first: names, second: name_called(called(instruction)))
    }
    names
}

// example: name_called(None) == []
fn name_called(reference: Option<jvm.MethodRef>) -> List<String> {
    match reference {
        Some(one) => [one.name]
        None => []
    }
}

// example: reached_in([jvm.New("a/B"), jvm.Copy]) == ["a/B"]
fn reached_in(instructions: List<jvm.Instruction>) -> List<String> {
    var reached = []
    for instruction in instructions {
        reached = both(first: reached, second: class_reached(instruction))
    }
    reached
}

// example: class_reached(jvm.Cast("a/B")) == ["a/B"]
// example: class_reached(jvm.Copy) == []
fn class_reached(instruction: jvm.Instruction) -> List<String> {
    match instruction {
        jvm.New(class) => [class]
        jvm.GetStatic(field) => [field.class]
        jvm.Cast(class) => [class]
        _ => class_called(called(instruction))
    }
}

// example: class_called(None) == []
fn class_called(reference: Option<jvm.MethodRef>) -> List<String> {
    match reference {
        Some(one) => [one.class]
        None => []
    }
}

// example: is_none(called(jvm.Copy))
fn called(instruction: jvm.Instruction) -> Option<jvm.MethodRef> {
    match instruction {
        jvm.Construct(reference) => Some(reference)
        jvm.InvokeStatic(reference) => Some(reference)
        jvm.InvokeVirtual(reference) => Some(reference)
        jvm.InvokeInterface(reference) => Some(reference)
        jvm.InvokeStaticOfInterface(reference) => Some(reference)
        _ => None
    }
}

// example: both(first: [1], second: [2]) == [1, 2]
fn both<T>(first: List<T>, second: List<T>) -> List<T> {
    var joined = first
    for value in second {
        joined = list.push(joined, value)
    }
    joined
}

// example: part(values: [1, 2, 3, 4], from: 1, to: 3) == [2, 3]
// example: part(values: [1, 2], from: -1, to: 1) == [1]
fn part<T>(values: List<T>, from: Int, to: Int) -> List<T> {
    var taken = []
    var at = 0
    for value in values {
        if at >= from && at < to {
            taken = list.push(taken, value)
        }
        at += 1
    }
    taken
}

// example: is_holding(text: "a main b", piece: "main")
// example: !is_holding(text: "a b", piece: "main")
fn is_holding(text: String, piece: String) -> Bool {
    var from = 0
    for from + strings.length(piece) <= strings.length(text) {
        if or(strings.cut(text, from, from + strings.length(piece)), "") == piece {
            return true
        }
        from += 1
    }
    false
}

// example: replaced(text: "a {} b", from: "{}", to: "x") == "a x b"
fn replaced(text: String, from: String, to: String) -> String {
    var written = ""
    var at = 0
    for at < strings.length(text) {
        if or(strings.cut(text, at, at + strings.length(from)), "") == from {
            written += to
            at += strings.length(from)
        } else {
            written += or(strings.cut(text, at, at + 1), "")
            at += 1
        }
    }
    written
}
