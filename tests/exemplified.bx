// Every example under `tests/spec`, held to what its header says.
//
// `docs/specs/executable-examples.md` states what an example is and what its header means. Checking
// goes through the compiler's own functions in the JVM of its test, and a JVM is started only to
// run an example headed `// expect-run`, from the line `bux run` would start it with.
import checking
import command
import environment
import files
import format
import header
import held
import ir
import list
import modules
import strings
import walk

// No example at all is a failure, because the specification must never be empty.
// example: every_example_held("no-such-directory", [], ir.little_library(), 1).failures == ["no-such-directory: holds no example"]
fn every_example_held(directory: String, paths: List<String>, library: ir.Library, limit: Int) -> held.Held {
    if list.length(paths) == 0 {
        return held.with_failure(held.nothing_failed(0), directory + ": holds no example")
    }
    var found = held.nothing_failed(0)
    for path in paths {
        found = held.added(found, example_held(path, library, limit))
    }
    found
}

// example: example_held("no-such-directory/a.bx", ir.little_library(), 1).failures == ["no-such-directory/a.bx: expected \"accepted\", found \"error: no-such-directory/a.bx: No such file or directory (os error 2)\""]
fn example_held(path: String, library: ir.Library, limit: Int) -> held.Held {
    let source = ok_or(files.read(path), "")
    let found = stated_held(Opened { path: path, source: source }, library, limit)
    if is_departing(source) && !is_stated_departing(header.expectation_of(source)) {
        return held.with_failure(found, path + ": not in canonical form, which `bux fmt` writes")
    }
    found
}

// example: is_departing("fn f() {\n  1\n}\n")
// example: !is_departing("fn (")
fn is_departing(source: String) -> Bool {
    match format.format(source) {
        Ok(canonical) => canonical != source
        Err(_) => false
    }
}

// example: is_stated_departing(header.Refused("L0200"))
// example: is_stated_departing(header.Refused("L0201"))
// example: !is_stated_departing(header.Refused("L0303"))
fn is_stated_departing(expected: header.Expectation) -> Bool {
    match expected {
        header.Refused(code) => code == "L0200" || code == "L0201"
        _ => false
    }
}

// example: stated_held(Opened { path: "a.bx", source: "// > one\n" }, ir.little_library(), 1).failures == ["a.bx: only an example that is run states what it writes"]
fn stated_held(opened: Opened, library: ir.Library, limit: Int) -> held.Held {
    match header.expectation_of(opened.source) {
        header.Compiles => compiled(opened.path, library)
        header.Refused(code) => refused(opened: opened, code: code, library: library)
        header.Runs(ran) => run(opened: opened, ran: ran, library: library, limit: limit)
        header.Misstated(why) => held.with_failure(held.nothing_failed(1), opened.path + ": " + why)
    }
}

// example: list.length(compiled("no-such-directory/a.bx", ir.little_library()).failures) == 1
fn compiled(path: String, library: ir.Library) -> held.Held {
    match command.checked(path, library) {
        Ok(_) => held.nothing_failed(1)
        Err(not) => held.with_failure(held.nothing_failed(1), held.failure(path, "accepted", first_line(command.not_compiled_said(not, command.AsPage).errors)))
    }
}

// example: list.length(refused(opened: Opened { path: "no-such-directory/a.bx", source: "" }, code: "L0100", library: ir.little_library()).failures) == 1
fn refused(opened: Opened, code: String, library: ir.Library) -> held.Held {
    let expected = "error[" + code + "] and no other"
    match command.checked(opened.path, library) {
        Ok(_) => held.with_failure(held.nothing_failed(1), held.failure(opened.path, expected, "accepted"))
        Err(command.Unusable(errors)) => held.with_failure(held.nothing_failed(1), held.failure(opened.path, expected, first_line(errors)))
        Err(command.Refused(refusal)) => refused_with(opened: opened, code: code, refusal: refusal)
    }
}

// example: refused_with(opened: Opened { path: "a.bx", source: "" }, code: "L0100", refusal: command.Refusal { diagnostics: [], page: command.Page { source: "", path: "a.bx" } }).failures == ["a.bx: expected \"error[L0100] and no other\", found \"\""]
fn refused_with(opened: Opened, code: String, refusal: command.Refusal) -> held.Held {
    var codes = ""
    var is_other = list.length(refusal.diagnostics) == 0
    for diagnostic in refusal.diagnostics {
        if codes != "" {
            codes += ", "
        }
        codes += "error[" + diagnostic.code + "]"
        is_other = is_other || diagnostic.code != code
    }
    if !is_other {
        return held.nothing_failed(1)
    }
    held.with_failure(held.nothing_failed(1), held.failure(opened.path, "error[" + code + "] and no other", codes))
}

// The copy holds the example and each module beside it, so a run writes nothing into the tree.
// The run starts in the copy, so a file that the example names with its own path goes there.
// example: list.length(run(opened: Opened { path: "no-such-directory/a.bx", source: "" }, ran: header.Ran { arguments: [], output: "", errors: "", status: 0 }, library: ir.little_library(), limit: 1).failures) == 1
fn run(opened: Opened, ran: header.Ran, library: ir.Library, limit: Int) -> held.Held {
    if !is_a_jdk_named() {
        return held.with_skip(held.nothing_failed(0), opened.path + ": JAVA_HOME names no JDK, and an example that is run needs one")
    }
    match command.somewhere_of_its_own() {
        Ok(copy) => run_in(Copied { opened: opened, copy: copy, limit: limit }, ran, library)
        Err(said) => held.with_failure(held.nothing_failed(1), opened.path + ": " + first_line(said.errors))
    }
}

// The copy keeps the name of the example, so an example named as a library module runs so named.
// example: list.length(run_in(Copied { opened: Opened { path: "no-such-directory/a.bx", source: "" }, copy: "no-such-directory", limit: 1 }, header.Ran { arguments: [], output: "", errors: "", status: 0 }, ir.little_library()).failures) == 1
fn run_in(copied: Copied, ran: header.Ran, library: ir.Library) -> held.Held {
    let example = modules.joined(copied.copy, modules.stem_of(copied.opened.path) + ".bx")
    _ = files.write(example, copied.opened.source)
    for beside in walk.files_in(modules.directory_of(copied.opened.path), ".bx") {
        if beside != copied.opened.path {
            _ = files.write(modules.joined(copied.copy, modules.stem_of(beside) + ".bx"), ok_or(files.read(beside), ""))
        }
    }
    let found = started(copied, ran, command.answered_within(command.all_of(["run", example], ran.arguments), library))
    command.removed_whole(copied.copy)
    found
}

// example: list.length(started(Copied { opened: Opened { path: "a.bx", source: "" }, copy: "no-such-directory", limit: 1 }, header.Ran { arguments: [], output: "", errors: "", status: 0 }, command.Spoken(command.nothing_said())).failures) == 1
fn started(copied: Copied, ran: header.Ran, answer: command.Answer) -> held.Held {
    match answer {
        command.Spoken(said) => held.with_failure(held.nothing_failed(1), held.failure(copied.opened.path, "a program to run", first_line(said.errors)))
        command.Starts(line) => ended_held(copied.opened.path, ran, walk.completed(line, copied.copy, copied.limit))
    }
}

// example: ended_held("a.bx", header.Ran { arguments: [], output: "", errors: "", status: 0 }, Err(walk.NotStarted)).failures == ["a.bx: the program could not be started"]
fn ended_held(path: String, ran: header.Ran, completion: Result<walk.Ended, walk.Unended>) -> held.Held {
    match completion {
        Ok(done) => compared(path, ran, done)
        Err(unended) => held.with_failure(held.nothing_failed(1), path + ": " + walk.unended_said(unended, "the program"))
    }
}

// example: compared("a.bx", header.Ran { arguments: [], output: "x\n", errors: "", status: 0 }, walk.Ended { output: "y\n", errors: "", status: 0 }).failures == ["a.bx: standard output: expected \"x\\n\", found \"y\\n\""]
fn compared(path: String, ran: header.Ran, done: walk.Ended) -> held.Held {
    var found = held.nothing_failed(1)
    if done.status != ran.status {
        found = held.with_failure(found, held.failure(path + ": status", shown(ran.status), shown(done.status)))
    }
    if done.output != ran.output {
        found = held.with_failure(found, held.failure(path + ": standard output", ran.output, done.output))
    }
    let errors = without_frames(done.errors)
    if errors != ran.errors {
        found = held.with_failure(found, held.failure(path + ": standard error", ran.errors, errors))
    }
    found
}

// The JVM sets the depth of a trace, so only the first line, which names the error, is compared.
// example: without_frames("java.lang.StackOverflowError\n\tat main.depth(Unknown Source)\n") == "java.lang.StackOverflowError\n"
// example: without_frames("no break") == "no break"
fn without_frames(errors: String) -> String {
    var kept = []
    for line in walk.lines_of(errors) {
        if or(strings.at(line, 0), 0) != 9 {
            kept = list.push(kept, line)
        }
    }
    let joined = strings.join(kept, "\n")
    if list.length(kept) > 0 && walk.is_ending_in(errors, "\n") {
        return joined + "\n"
    }
    joined
}

// example: first_line("a\nb\n") == "a"
// example: first_line("") == ""
fn first_line(text: String) -> String {
    or(list.at(walk.lines_of(text), 0), "")
}

// example: is_a_jdk_named() || !is_a_jdk_named()
fn is_a_jdk_named() -> Bool {
    let home = or(environment.read("JAVA_HOME"), "")
    home != "" && files.is_file(files.named(modules.joined(modules.joined(home, "bin"), "java")))
}

type Copied = {
    opened: Opened
    copy: String
    limit: Int
}

type Opened = {
    path: String
    source: String
}

test "every example under tests/spec holds to its header and to canonical form" {
    held.is_held_reported(every_example_held("tests/spec", walk.every_file("tests/spec", ".bx"), checking.carried_library(), walk.start_limit()))
}
