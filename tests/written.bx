// A disk that ignores case holds two such classes as one file.
// example: held.is_held(two_classes_whose_names_differ_only_in_case_are_refused(0, ir.little_library()))
fn two_classes_whose_names_differ_only_in_case_are_refused(cases: Int, library: ir.Library) -> held.Held {
    checked(property: NamedInCase, cases: cases, library: library)
}

// example: held.is_held(the_deepest_stack_a_method_declares_counts_two_words_for_each_long(0, ir.little_library()))
