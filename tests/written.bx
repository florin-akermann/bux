    checked(property: LongStack, cases: cases, library: library)
}

// example: checked(property: CompiledTwice, cases: 0, library: ir.little_library()).cases == 0
fn checked(property: Property, cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        let seed = drawn.seed_of(case)
        let one = drawing(property: property, draw: drawn.seeded(seed), library: library)
        found = compiled.noted(found, one.why, held.drawn_failure(name_of(property), seed, one.source, one.why))
        case += 1
    }
    found
}

// example: drawing(property: WrittenTwice, draw: drawn.seeded(1), library: ir.little_library()).why == ""
fn drawing(property: Property, draw: drawn.Draw, library: ir.Library) -> Drawing {
    match property {
        CompiledTwice => compiled_twice(draw, library)
        CompiledVersion => compiled_version(draw, library)
        CompiledPool => compiled_pool(draw, library)
        Loadable => loadable(draw, library)
        WrittenTwice => written_twice(draw)
        WrittenVersion => written_version(draw)
        NoObject => no_object(draw, library)
        Specialised => specialised(draw, library)
        Declared => declared(draw)
        WrittenPool => written_pool(draw)
        ReadsWhole => reads_whole(draw, library)
        FarBranch => far_branch(draw)
        LongText => long_text(draw)
        NamedTwice => named_twice(draw)
        NamedInCase => named_in_case(draw)
        LongStack => long_stack(draw)
    }
}

// example: name_of(Declared) == "every_method_a_module_declares_is_written_as_a_method_of_it"
fn name_of(property: Property) -> String {
    match property {
        CompiledTwice => "compiling_one_source_twice_gives_byte_identical_class_files"
        CompiledVersion => "every_class_a_module_compiles_to_begins_with_the_magic_and_the_current_version"
        CompiledPool => "every_constant_a_compiled_class_names_is_one_its_own_pool_holds"
        Loadable => "every_descriptor_a_class_asks_to_load_first_names_another_class_the_build_writes"
        WrittenTwice => "writing_a_class_twice_gives_the_same_bytes"
        WrittenVersion => "every_class_written_begins_with_the_magic_and_the_current_version"
        NoObject => "no_method_written_for_a_function_a_module_declares_names_object"
        Specialised => "a_generic_used_at_a_whole_number_is_written_taking_and_giving_back_a_long"
        Declared => "every_method_a_module_declares_is_written_as_a_method_of_it"
        WrittenPool => "every_constant_a_class_names_is_one_the_pool_holds"
        ReadsWhole => "every_class_a_drawn_program_compiles_to_reads_back_whole"
        FarBranch => "a_branch_past_what_two_bytes_reach_is_refused_as_too_large"
        LongText => "a_text_past_what_the_pool_holds_is_refused_as_too_long"
        NamedTwice => "two_modules_that_write_one_class_name_write_it_once_or_are_refused"
        NamedInCase => "two_classes_whose_names_differ_only_in_case_are_refused"
        LongStack => "the_deepest_stack_a_method_declares_counts_two_words_for_each_long"
    }
}

// example: compiled_twice(drawn.seeded(1), ir.little_library()).source != ""
fn compiled_twice(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let source = drawn.picked(draw, sources(), "")
    Drawing { source: source, why: compiled.differing(compiled.written_alone(source, library), compiled.written_alone(source, library)) }
}

// example: compiled_version(drawn.seeded(1), ir.little_library()).source != ""
fn compiled_version(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let source = drawn.picked(draw, sources(), "")
    Drawing { source: source, why: version_why(compiled.written_alone(source, library)) }
}

// example: compiled_pool(drawn.seeded(1), ir.little_library()).source != ""
fn compiled_pool(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let source = drawn.picked(draw, sources(), "")
    Drawing { source: source, why: pool_why(compiled.written_alone(source, library)) }
}

// example: loadable(drawn.seeded(1), ir.little_library()).source != ""
fn loadable(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let source = drawn.picked(draw, sources(), "")
    Drawing { source: source, why: loadable_why(compiled.written_alone(source, library)) }
}

// example: written_twice(drawn.seeded(1)).why == ""
fn written_twice(draw: drawn.Draw) -> Drawing {
    let module = a_module(draw)
    Drawing { source: shown_module(module), why: compiled.differing(compiled.classes_of([module]), compiled.classes_of([module])) }
}

// example: written_version(drawn.seeded(1)).why == ""
fn written_version(draw: drawn.Draw) -> Drawing {
    let module = a_module(draw)
    Drawing { source: shown_module(module), why: version_why(compiled.classes_of([module])) }
}

// example: no_object(drawn.seeded(1), ir.little_library()).source != ""
fn no_object(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let source = drawn.picked(draw, sources(), "")
    var why = compiled_why(compiled.written_alone(source, library))
    for method in reader.read(module_bytes(compiled.written_alone(source, library))).methods {
        if compiled.is_holding(method.descriptor, "java/lang/Object") {
            why = method.name + " is written " + method.descriptor
        }
    }
    Drawing { source: source, why: why }
}

// example: specialised(drawn.seeded(1), ir.little_library()).source != ""
fn specialised(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let through = drawn.picked(draw, ["identity", "through"], "")
    let source = "fn kept(count: Int) -> Int {\n    " + through + "(count)\n}\n\nfn through<T>(value: T) -> T {\n    identity(value)\n}\n\nfn identity<T>(value: T) -> T {\n    value\n}\n"
    let contents = reader.read(module_bytes(compiled.written_alone(source, library)))
    var why = through + " is not written at `Int`"
    for method in contents.methods {
        if method.name == through + "$Int" {
            why = descriptor_why(method.descriptor)
        }
    }
    if why == "" && list.has_value(reader.texts(contents), "java/lang/Long") {
        why = "a whole number that crosses a generic is boxed as a java/lang/Long"
    }
    Drawing { source: source, why: why }
}

// example: descriptor_why("(J)J") == ""
fn descriptor_why(descriptor: String) -> String {
    if descriptor == "(J)J" {
        return ""
    }
    "the use at `Int` is written " + descriptor
}

// example: declared(drawn.seeded(1)).why == ""
fn declared(draw: drawn.Draw) -> Drawing {
    let module = a_module(draw)
    var names = []
    for method in reader.read(module_bytes(compiled.classes_of([module]))).methods {
        names = list.push(names, method.name)
    }
    var why = ""
    if names != method_names(module) {
        why = "the class file writes the methods " + strings.join(names, ", ")
    }
    Drawing { source: shown_module(module), why: why }
}

// example: written_pool(drawn.seeded(1)).why == ""
fn written_pool(draw: drawn.Draw) -> Drawing {
    let module = a_module(draw)
    let files = compiled.classes_of([module])
    var why = pool_why(files)
    for method in reader.read(module_bytes(files)).methods {
        if method.name == "" {
            why = "a method is written with no name"
        }
    }
    Drawing { source: shown_module(module), why: why }
}

// example: reads_whole(drawn.seeded(1), ir.little_library()).source != ""
fn reads_whole(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let source = drawn_program(draw)
    let files = compiled.written_alone(source, library)
    var why = version_why(files)
    for file in files {
        if !reader.is_whole(reader.read(file.bytes), file.bytes) {
            why = file.path + " does not read back whole"
        }
    }
    Drawing { source: source, why: why }
}

// example: drawn_program(drawn.seeded(1)) != ""
fn drawn_program(draw: drawn.Draw) -> String {
    let many = drawn.number(draw, 5)
    var body = ""
    for which in drawn.numbers(drawn.next(draw), many, 9) {
        body += "    " + or(list.at(statements(), which), "") + "\n"
    }
    "import list\nimport strings\n\nfn main(arguments: List<String>) -> Int {\n    let count = list.length(arguments)\n    var total = strings.length(shown(count))\n" + body + "    total\n}\n\n/// Whether `total` is even.\n// example: is_even(2)\nfn is_even(total: Int) -> Bool {\n    or(total % 2, 1) == 0\n}\n\ntype Box = {\n    held: Int\n}\n"
}

// example: list.length(statements()) == 9
fn statements() -> List<String> {
    ["total += count", "total = total * 3 - count", "total = or(total / count, 7)", "if is_even(total) {\n        total += 1\n    }", "for index in [1, 2, 3] {\n        total += index\n    }", "total = match total {\n        0 => 1\n        other => other\n    }", "total = Box { held: total }.held", "total = total + strings.length(\"é€\" + shown(count))", "total = or(list.at([total, 2147483648, -40000], count), 128)"]
}

// The branch is at offset 1, and it lands 3 bytes after itself and 6 bytes for each increment.
// example: far_branch(drawn.seeded(1)).why == ""
fn far_branch(draw: drawn.Draw) -> Drawing {
    let many = 5455 + drawn.number(draw, 12)
    var instructions = [ir.BooleanOf(true), ir.JumpIfFalse(0)]
    for list.length(instructions) < many + 2 {
        instructions = list.push(instructions, ir.Increment(small_local(300)))
    }
    instructions = list.push(list.push(list.push(instructions, ir.Label(0)), ir.LongOf(1)), ir.Return(Some(ir.Whole)))
    Drawing { source: "a branch over " + shown(many) + " increments", why: refusal_why(answer: jvm.program_written([one_body(instructions, small_locals(302))]), code: "L0700", side: side_of(amount: 3 + 6 * many, limit: 32767)) }
}

// example: list.length(small_locals(3)) == 3
fn small_locals(many: Int) -> List<ir.Local> {
    var locals = []
    for list.length(locals) < many {
        locals = list.push(locals, small_local(list.length(locals)))
    }
    locals
}

// example: small_local(3).name == "small3"
fn small_local(at: Int) -> ir.Local {
    ir.Local { name: "small" + shown(at), of: ir.Small }
}

// example: long_text(drawn.seeded(1)).why == ""
fn long_text(draw: drawn.Draw) -> Drawing {
    let many = 21840 + drawn.number(draw, 12)
    let text = or(strings.cut(doubled("€", 15), 0, many), "")
    let instructions = [ir.TextOf(text), ir.Drop(ir.Of(ir.Text)), ir.LongOf(1), ir.Return(Some(ir.Whole))]
    Drawing { source: "a text of " + shown(many) + " characters of three bytes", why: refusal_why(answer: jvm.program_written([one_body(instructions, [])]), code: "L0701", side: side_of(amount: 3 * many, limit: 65535)) }
}

// example: doubled("ab", 2) == "abababab"
fn doubled(text: String, times: Int) -> String {
    var joined = text
    var left = times
    for left > 0 {
        joined += joined
        left = left - 1
    }
    joined
}

// example: named_twice(drawn.seeded(1)).why == ""
fn named_twice(draw: drawn.Draw) -> Drawing {
    let first = drawn.picked(draw, ["held", "kept"], "")
    let second = drawn.picked(drawn.next(draw), ["held", "kept"], "")
    let written = jvm.program_written([jvm.one_class(boxed(first)), jvm.one_class(boxed(second))])
    let side = if first == second {
        Within
    } else {
        Past
    }
    var why = refusal_why(answer: written, code: "L0702", side: side)
    if why == "" && first == second && list.length(ok_or(written, [])) != 1 {
        why = "the one class is written " + shown(list.length(ok_or(written, []))) + " times"
    }
    Drawing { source: "two modules write `demo/Box` holding `" + first + "` and `" + second + "`", why: why }
}

// example: named_in_case(drawn.seeded(1)).why == ""
fn named_in_case(draw: drawn.Draw) -> Drawing {
    let second = drawn.picked(draw, ["demo/box", "Demo/Box", "DEMO/BOX", "demo/Bag", "demo/Box1", "other/Box"], "")
    let written = jvm.program_written([jvm.one_class(boxed("held")), jvm.one_class(named_box(name: second, field: "held"))])
    let side = if is_box_in_other_case(second) {
        Past
    } else {
        Within
    }
    var why = refusal_why(answer: written, code: "L0702", side: side)
    if why == "" && side == Within && list.length(ok_or(written, [])) != 2 {
        why = "the two classes are written as " + shown(list.length(ok_or(written, []))) + " files"
    }
    if why == "" && side == Past && !is_refused_in_case(written) {
        why = "it is refused as two parts of one name, and not as two names that differ in case"
    }
    Drawing { source: "two modules write `demo/Box` and `" + second + "`, each holding `held`", why: why }
}

// example: !is_refused_in_case(Ok([]))
fn is_refused_in_case(answer: Result<List<jvm.ClassFile>, jvm.Unwritten>) -> Bool {
    match answer {
        Ok(_) => false
        Err(unwritten) => jvm.help_of(unwritten.why) == jvm.help_of(jvm.NamedInCase(""))
    }
}

// example: is_box_in_other_case("demo/box")
// example: !is_box_in_other_case("demo/Bag")
fn is_box_in_other_case(name: String) -> Bool {
    list.has_value(["demo/box", "Demo/Box", "DEMO/BOX"], name)
}

// example: jvm.class_of(boxed("held").of) == "demo/Box"
fn boxed(field: String) -> ir.Class {
    named_box(name: "demo/Box", field: field)
}

// example: jvm.class_of(named_box(name: "demo/box", field: "held").of) == "demo/box"
fn named_box(name: String, field: String) -> ir.Class {
    ir.Class { of: program_type(name), extends: ir.Anything, extending: ir.Never, implements: [], fields: [ir.Field { name: field, of: ir.Whole }], methods: [] }
}

// A call takes `taken` values and leaves one, and each of `added` goes on it alone, so two at most.
// A constructor takes `taken` values above the two copies of what it builds.
// example: long_stack(drawn.seeded(1)).why == ""
fn long_stack(draw: drawn.Draw) -> Drawing {
    let taken = 1 + drawn.number(draw, 4)
    let added = drawn.number(drawn.next(draw), 4)
    let is_built = drawn.number(drawn.next(drawn.next(draw)), 2) == 0
    let box = program_type("demo/Box")
    var longs = []
    for list.length(longs) < taken {
        longs = list.push(longs, ir.Whole)
    }
    var instructions = []
    var needed = 2 * taken
    if added > 0 {
        needed = greater(one: needed, other: 4)
    }
    if is_built {
        instructions = [ir.New(box), ir.Copy]
        needed = 2 + 2 * taken
    }
    for longs_pushed(instructions) < taken {
        instructions = list.push(instructions, ir.LongOf(7))
    }
    if is_built {
        instructions = list.push(list.push(instructions, ir.Construct { built: box, taken: longs }), ir.Drop(ir.Of(box)))
        instructions = list.push(instructions, ir.LongOf(1))
    } else {
        instructions = list.push(instructions, ir.Call(ir.Function { owner: ir.ModuleOf(ir.OfTheProgram("demo")), name: "taking", taken: longs, gives: Some(ir.Whole) }))
        var more = 0
        for more < added {
            instructions = list.push(list.push(instructions, ir.LongOf(1)), ir.Arithmetic(ir.Add))
            more += 1
        }
    }
    instructions = list.push(instructions, ir.Return(Some(ir.Whole)))
    var why = compiled_why(compiled.classes_of([one_body(instructions, [])]))
    for method in reader.read(module_bytes(compiled.classes_of([one_body(instructions, [])]))).methods {
        if method.stack != needed {
            why = "the method declares a stack of " + shown(method.stack) + ", and it needs " + shown(needed)
        }
    }
    Drawing { source: shown(taken) + " values taken, " + shown(added) + " added, built: " + shown(is_built), why: why }
}

// example: jvm.class_of(program_type("Demo/Box")) == "Demo/Box"
fn program_type(name: String) -> ir.Kind {
    var at = 0
    for at < strings.length(name) && or(strings.at(name, at), 47) != 47 {
        at += 1
    }
    ir.TypeOf { module: ir.OfTheProgram(or(strings.cut(name, 0, at), "")), name: or(strings.cut(name, at + 1, strings.length(name)), "") }
}

// example: longs_pushed([ir.New(program_type("demo/Box")), ir.LongOf(7)]) == 1
fn longs_pushed(instructions: List<ir.Instruction>) -> Int {
    var count = 0
    for instruction in instructions {
        count += match instruction {
            ir.LongOf(_) => 1
            _ => 0
        }
    }
    count
}

// example: greater(one: 2, other: 3) == 3
fn greater(one: Int, other: Int) -> Int {
    if one > other {
        return one
    }
    other
}

// example: list.length(one_body([ir.LongOf(1), ir.Return(Some(ir.Whole))], []).classes) == 1
fn one_body(instructions: List<ir.Instruction>, locals: List<ir.Local>) -> ir.Lowered {
    let body = ir.Body { instructions: instructions, locals: locals, guards: [] }
    let method = ir.Method { name: "answer0", parameters: [], result: Some(ir.Whole), reached: ir.ThroughTheClass, body: body }
    jvm.one_class(demo_class([method]))
}

// example: refusal_why(answer: Ok([]), code: "L0700", side: Within) == ""
// example: refusal_why(answer: Ok([]), code: "L0700", side: Past) == "it is written, and it is past the limit"
fn refusal_why(answer: Result<List<jvm.ClassFile>, jvm.Unwritten>, code: String, side: Side) -> String {
    let refused = jvm.refused_code(answer)
    match side {
        Within => if refused == "" {
            ""
        } else {
            "it is refused as " + refused + ", and it is within the limit"
        }
        Past => if refused == code {
            ""
        } else if refused == "" {
            "it is written, and it is past the limit"
        } else {
            "it is refused as " + refused + ", not as " + code
        }
    }
}

// example: side_of(amount: 32768, limit: 32767) == Past
fn side_of(amount: Int, limit: Int) -> Side {
    if amount > limit {
        return Past
    }
    Within
}

// example: version_why([]) == "the compiler refused it"
fn version_why(files: List<jvm.ClassFile>) -> String {
    var why = compiled_why(files)
    for file in files {
        let contents = reader.read(file.bytes)
        if contents.magic != 3405691582 || contents.major != 72 || contents.minor != 65535 {
            why = file.path + " begins " + shown(contents.magic) + ", version " + shown(contents.major) + "." + shown(contents.minor)
        }
    }
    why
}

// example: pool_why([]) == "the compiler refused it"
fn pool_why(files: List<jvm.ClassFile>) -> String {
    var why = compiled_why(files)
    for file in files {
        let contents = reader.read(file.bytes)
        let size = list.length(contents.pool)
        if contents.this > size || contents.extends > size {
            why = file.path + " names " + shown(contents.this) + " and " + shown(contents.extends) + " of a pool of " + shown(size)
        }
    }
    why
}

// example: loadable_why([]) == "the compiler refused it"
fn loadable_why(files: List<jvm.ClassFile>) -> String {
    var written = []
    for file in files {
        written = list.push(written, descriptor_of(file.path))
    }
    var why = compiled_why(files)
    for file in files {
        for wanted in reader.read(file.bytes).loadable {
            if !list.has_value(written, wanted) || wanted == descriptor_of(file.path) {
                why = file.path + " asks for " + wanted
            }
        }
    }
    why
}

// example: descriptor_of("demo/Box.class") == "Ldemo/Box;"
fn descriptor_of(path: String) -> String {
    "L" + compiled.replaced(path, ".class", "") + ";"
}

// example: compiled_why([]) == "the compiler refused it"
fn compiled_why(files: List<jvm.ClassFile>) -> String {
    if list.length(files) == 0 {
        return "the compiler refused it"
    }
    ""
}

// example: module_bytes([jvm.ClassFile { path: "demo.class", bytes: [1] }]) == [1]
fn module_bytes(files: List<jvm.ClassFile>) -> List<Int> {
    for file in files {
        if file.path == "demo.class" {
            return file.bytes
        }
    }
    []
}

// example: list.length(method_names(a_module(drawn.seeded(1)))) >= 1
fn a_module(draw: drawn.Draw) -> ir.Lowered {
    let many = drawn.number(draw, 5)
    let chosen = list.push(drawn.numbers(drawn.next(draw), many, 4), 0)
    var methods = []
    for which in chosen {
        let body = ir.Body { instructions: list.push(body_of_kind(which), ir.Return(Some(ir.Whole))), locals: [], guards: [] }
        methods = list.push(methods, ir.Method { name: "answer" + shown(list.length(methods)), parameters: [], result: Some(ir.Whole), reached: ir.ThroughTheClass, body: body })
    }
    jvm.one_class(demo_class(methods))
}

// example: jvm.class_of(demo_class([]).of) == "demo"
fn demo_class(methods: List<ir.Method>) -> ir.Class {
    ir.Class { of: ir.ModuleOf(ir.OfTheProgram("demo")), extends: ir.Anything, extending: ir.Never, implements: [], fields: [], methods: methods }
}

// example: list.length(body_of_kind(2)) == 3
fn body_of_kind(which: Int) -> List<ir.Instruction> {
    match which {
        0 => [ir.LongOf(0)]
        1 => [ir.LongOf(-9000000000)]
        2 => [ir.LongOf(2), ir.LongOf(3), ir.Arithmetic(ir.Add)]
        _ => [ir.BooleanOf(true), ir.JumpIfFalse(0), ir.LongOf(1), ir.Return(Some(ir.Whole)), ir.Label(0), ir.LongOf(2)]
    }
}

// example: shown_module(ir.no_lowered()) == "a module that declares "
fn shown_module(module: ir.Lowered) -> String {
    "a module that declares " + strings.join(method_names(module), ", ")
}

// example: method_names(ir.no_lowered()) == []
fn method_names(module: ir.Lowered) -> List<String> {
    var names = []
    for class in module.classes {
        for method in class.methods {
            names = list.push(names, method.name)
        }
    }
    names
}

// example: list.length(sources()) == 8
fn sources() -> List<String> {
    ["fn answer() -> Int {\n    7\n}\n", "fn held(user: User) -> Int {\n    user.id\n}\n\ntype User = {\n    id: Int\n}\n", "fn told(payment: Payment) -> String {\n    match payment {\n        Pending => \"waiting\"\n        Failed(reason) => reason\n    }\n}\n\ntype Payment =\n    | Pending\n    | Failed(String)\n", "fn walked(counts: List<Int>) -> Int {\n    var total = 0\n    for count in counts {\n        total += count\n    }\n    total\n}\n", "fn used() -> Result<Int, String> {\n    let value = held()?\n    Ok(value + 1)\n}\n\nfn held() -> Result<Int, String> {\n    Ok(1)\n}\n", "fn number(user: User) -> Int {\n    user.home.number\n}\n\ntype User = {\n    id: Int\n    home: Address\n}\n\ntype Address = {\n    number: Int\n}\n", "fn kept(count: Int) -> Int {\n    identity(count)\n}\n\nfn is_kept(flag: Bool) -> Bool {\n    identity(flag)\n}\n\nfn identity<T>(value: T) -> T {\n    value\n}\n", "fn kept(count: Int) -> Int {\n    through(count)\n}\n\nfn through<T>(value: T) -> T {\n    identity(value)\n}\n\nfn identity<T>(value: T) -> T {\n    value\n}\n"]
}

type Drawing = {
    source: String
    why: String
}

derive Eq for Side

type Side =
    | Within
    | Past

type Property =
    | CompiledTwice
    | CompiledVersion
    | CompiledPool
    | Loadable
    | WrittenTwice
    | WrittenVersion
    | NoObject
    | Specialised
    | Declared
    | WrittenPool
    | ReadsWhole
    | FarBranch
    | LongText
    | NamedTwice
    | NamedInCase
    | LongStack

