// The invariants of a written class file, checked on drawn modules and read back byte by byte.
//
// `docs/specs/codegen.md` states what the writer writes. Some properties compile a drawn source,
// some write a module built here out of drawn bodies, and `reader` reads the bytes back.
import checking
import compiled
import drawn
import held
import ir
import jvm
import list
import reader
import strings

// example: held.is_held(compiling_one_source_twice_gives_byte_identical_class_files(0, ir.little_library()))
fn compiling_one_source_twice_gives_byte_identical_class_files(cases: Int, library: ir.Library) -> held.Held {
    checked(property: CompiledTwice, cases: cases, library: library)
}

