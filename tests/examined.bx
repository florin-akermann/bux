// The one program that runs the example lines of every module, each in turn, in one JVM.
//
// `docs/implementation.md` section 7 states it. `documented.bx` writes the run of each module's
// examples, as `bux test` writes it, into a directory of that module's own, and starts this
// program once with each directory and the class of each run. The classes of two runs can share a
// name and still differ, because each run lowers its own program, so each run is loaded by a class
// loader of its own over its own directory. That loader reaches no class of this program.
//
// Before each run, this program writes a line that names the run by its number. A run that stops
// with an error is followed by one more line, which says what stopped it.
import io
import list
import strings

/// Runs the examples of each run that `arguments` names: a directory, then the class in it.
fn main(arguments: List<String>) -> Int {
    var index = 0
    for index + 1 < list.length(arguments) {
        io.println(opened_line(or(index / 2, 0)))
        stopped := stopped_by(directory: or(list.at(arguments, index), ""), class: or(list.at(arguments, index + 1), ""))
        if stopped != "" {
            io.println(stopped_line(stopped))
        }
        index += 2
    }
    0
}

/// The line written before the run numbered `number`.
// example: opened_line(3) == "bux: run 3"
fn opened_line(number: Int) -> String {
    "bux: run " + shown(number)
}

/// The line written after a run that `why` stopped.
// example: stopped_line("java.lang.StackOverflowError") == "bux: stopped java.lang.StackOverflowError"
fn stopped_line(why: String) -> String {
    "bux: stopped " + why
}

/// What stopped the run of `class` in `directory`, and `""` where it came to its end.
// example: stopped_by(directory: "no-such-directory", class: "a") != ""
fn stopped_by(directory: String, class: String) -> String {
    match main_called(directory: directory, class: class) {
        Ok(_) => ""
        Err(why) => one_line(why)
    }
}

/// `text` up to its first line break, so that what stopped a run stays on one line.
// example: one_line("a\nb") == "a"
fn one_line(text: String) -> String {
    var index = 0
    for or(strings.at(text, index), 10) != 10 {
        index += 1
    }
    or(strings.cut(text, 0, index), text)
}

/// The run of `class` in `directory`: its `main`, called with no arguments, as its own loader
/// loads it.
// example: is_stopped(main_called(directory: "no-such-directory", class: "a"))
fn main_called(directory: String, class: String) -> Result<Int, String> {
    loader := loader_over(directory)?
    started := static_of(public_lookup(), class_in(class, true, loader)?, "main", method_type("(Lbux/List;)J", loader)?)?
    listed := static_of(public_lookup(), class_in("bux.List", true, loader)?, "of", method_type("([Ljava/lang/Object;)Lbux/List;", loader)?)?
    empty := or_stopped(collecting(listed, class_named("[Ljava.lang.Object;")?, 0), "no empty list")?
    whole := or_stopped(collected(started, 0, empty), "no call of main")?
    invoked(whole)
}

/// Whether a run was stopped.
// example: is_stopped(Err("a"))
fn is_stopped<T>(ran: Result<T, String>) -> Bool {
    match ran {
        Ok(_) => false
        Err(_) => true
    }
}

/// A class loader over `directory` alone, whose parent reaches only the platform's classes.
// example: stopped_by(directory: "no-such-directory", class: "a") != ""
fn loader_over(directory: String) -> Result<Loader, String> {
    made := method_type("([Ljava/net/URL;Ljava/lang/ClassLoader;)V", platform_loader())?
    building := constructor_of(public_lookup(), class_named("java.net.URLClassLoader")?, made)?
    one := or_stopped(collecting_at(building, 0, class_named("[Ljava.net.URL;")?, 1), "no loader")?
    loader_made(one, url_of(address_of(file_of(directory)))?, platform_loader())
}

/// The value `found` holds, or a run stopped by `why` where it holds none.
// example: is_stopped(or_stopped(None, "a"))
fn or_stopped(found: Option<Handle>, why: String) -> Result<Handle, String> {
    match found {
        Some(handle) => Ok(handle)
        None => Err(why)
    }
}

/// The loader of the platform's own classes, which holds no class of any program.
extern static platform_loader() -> Loader = "java.lang.ClassLoader.getPlatformClassLoader"

/// The lookup that reaches every public member of every public class.
extern static public_lookup() -> Lookup = "java.lang.invoke.MethodHandles.publicLookup"

/// The class named `name`, as the loader of this program finds it.
extern static class_named(name: String) -> Result<Class, String> = "java.lang.Class.forName"

/// The class named `name`, as `loader` finds it, made ready to run where `ready` says so.
extern static class_in(name: String, ready: Bool, loader: Loader) -> Result<Class, String> = "java.lang.Class.forName"

/// The type a method descriptor names, with its classes as `loader` finds them.
extern static method_type(descriptor: String, loader: Loader) -> Result<Kind, String> = "java.lang.invoke.MethodType.fromMethodDescriptorString"

/// The static method `name` of `class`, of the type `kind`.
extern method static_of(lookup: Lookup, class: Class, name: String, kind: Kind) -> Result<Handle, String> = "findStatic"

/// The constructor of `class` of the type `kind`.
extern method constructor_of(lookup: Lookup, class: Class, kind: Kind) -> Result<Handle, String> = "findConstructor"

/// `handle`, taking `length` values in place of its last parameter, which is an array of `array`.
extern method collecting(handle: Handle, array: Class, int length: Int) -> Option<Handle> = "asCollector"

/// `handle`, taking `length` values in place of its parameter at `position`, an array of `array`.
extern method collecting_at(handle: Handle, int position: Int, array: Class, int length: Int) -> Option<Handle> = "asCollector"

/// `target`, with its parameter at `position` given by what `filter` gives back.
extern static collected(target: Handle, int position: Int, filter: Handle) -> Option<Handle> = "java.lang.invoke.MethodHandles.collectArguments"

/// The loader that `handle` builds over `place`, under `parent`.
extern method loader_made(handle: Handle, place: Url, parent: Loader) -> Result<Loader, String> = "invoke"

/// What the method `handle` reaches gives back, called with no arguments.
extern method invoked(handle: Handle) -> Result<Int, String> = "invoke"

/// The file or directory `path` names.
extern new file_of(path: String) -> File

/// The address of `file`, which ends with a slash where it is a directory.
extern method address_of(file: File) -> Address = "toURI"

/// The address as a URL, which a class loader reads.
extern method url_of(address: Address) -> Result<Url, String> = "toURL"

/// A loader of classes.
extern type Loader = "java.lang.ClassLoader"

/// A way to find a method or a constructor.
extern type Lookup = "java.lang.invoke.MethodHandles$Lookup"

/// A class, as the JVM loaded it.
extern type Class = "java.lang.Class"

/// The type of a method: what it takes and what it gives back.
extern type Kind = "java.lang.invoke.MethodType"

/// A method or a constructor that can be called.
extern type Handle = "java.lang.invoke.MethodHandle"

/// A file or a directory, named rather than opened.
extern type File = "java.io.File"

/// An address, which a URL is made from.
extern type Address = "java.net.URI"

/// An address a class loader reads classes from.
extern type Url = "java.net.URL"
