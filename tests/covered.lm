// The exhaustiveness check, over drawn `match` expressions and drawn text.
//
// `docs/specs/exhaustiveness.md` states the properties. Each case writes a module of one `match`
// out of drawn arms, types it against the prelude, and checks it with the compiler's own check in
// the runner's JVM. The drawn `match` of many patterns is the one the Rust comparison drew.
import command

import drawn

import exhaustiveness

import held

import infer

import ir

import lexer

import list

import strings

import typed

import types

/// Every property of the exhaustiveness check over `cases` drawn cases each, in a fixed order.
// example: list.length(every_property(0, ir.little_library())) == 7
fn every_property(cases: Int, library: ir.Library) -> List<held.Held> {
    var found = []
    for property in [Deterministic, RotatedRefused, LeftOutRefused, BindingCovers, RefusalInside, AlternativesCoverAlike, DrawnMatchAlike] {
        found = list.push(found, held_over(property: property, cases: cases, prelude: library.prelude))
    }
    found
}

/// `property` tried on `cases` cases, each drawn from a seed of its own.
// example: held.is_held(held_over(property: Deterministic, cases: 2, prelude: types.little_prelude()))
fn held_over(property: Property, cases: Int, prelude: types.Prelude) -> held.Held {
    var found = held.nothing_failed(cases)
    var index = 0
    for index < cases {
        seed := drawn.seed_of(index)
        tried := tried_by(property: property, draw: drawn.seeded(seed), prelude: prelude)
        if tried.why != "" {
            found = held.with_failure(found, held.drawn_failure(name_of(property), seed, tried.case, tried.why))
        }
        index += 1
    }
    found
}

/// One case of `property`, drawn from `draw`, typed against `prelude`.
// example: tried_by(property: Deterministic, draw: drawn.seeded(1), prelude: types.little_prelude()).why == ""
fn tried_by(property: Property, draw: drawn.Draw, prelude: types.Prelude) -> Tried {
    match property {
        Deterministic => checking_never_panics_and_is_deterministic(draw, prelude)
        RotatedRefused => a_match_whose_arms_are_rotated_out_of_the_declared_order_is_refused(draw, prelude)
        LeftOutRefused => a_match_with_one_of_its_variants_left_out_is_refused(draw, prelude)
        BindingCovers => a_name_that_binds_covers_whatever_else_is_written(draw, prelude)
        RefusalInside => a_refusal_points_inside_the_source(draw, prelude)
        AlternativesCoverAlike => one_arm_of_alternatives_covers_what_the_same_arms_cover_separately(draw, prelude)
        DrawnMatchAlike => a_drawn_match_is_checked_alike_twice_and_a_refusal_points_inside_it(draw, prelude)
    }
}

/// The name a failure of `property` is reported with.
// example: name_of(Deterministic) == "checking_never_panics_and_is_deterministic"
fn name_of(property: Property) -> String {
    match property {
        Deterministic => "checking_never_panics_and_is_deterministic"
        RotatedRefused => "a_match_whose_arms_are_rotated_out_of_the_declared_order_is_refused"
        LeftOutRefused => "a_match_with_one_of_its_variants_left_out_is_refused"
        BindingCovers => "a_name_that_binds_covers_whatever_else_is_written"
        RefusalInside => "a_refusal_points_inside_the_source"
        AlternativesCoverAlike => "one_arm_of_alternatives_covers_what_the_same_arms_cover_separately"
        DrawnMatchAlike => "a_drawn_match_is_checked_alike_twice_and_a_refusal_points_inside_it"
    }
}

/// A `match` of drawn arms and drawn text that types is checked to one answer, the same each time.
///
/// The arms are whole lines, so most cases type. Drawn text between them is written so that some
/// cases do not parse, and a case that does not type holds at once.
// example: checking_never_panics_and_is_deterministic(drawn.seeded(1), types.little_prelude()).why == ""
fn checking_never_panics_and_is_deterministic(draw: drawn.Draw, prelude: types.Prelude) -> Tried {
    pieces := [payment_arm(0), payment_arm(1), payment_arm(2), "        other => \"else\"\n", "        _ => \"any\"\n", "        Pending | Failed(_) => \"two\"\n", "        Failed(\"no\") => \"no\"\n", "é", "(", "=> "]
    source := payments(drawn.text_of(drawn.next(draw), pieces, drawn.number(draw, 6)))
    Tried { case: source, why: answered_alike(source, prelude) }
}

/// A `match` whose arms are rotated out of the order the type declares its variants is refused.
// example: a_match_whose_arms_are_rotated_out_of_the_declared_order_is_refused(drawn.seeded(1), types.little_prelude()).why == ""
fn a_match_whose_arms_are_rotated_out_of_the_declared_order_is_refused(draw: drawn.Draw, prelude: types.Prelude) -> Tried {
    rotation := 1 + drawn.number(draw, 2)
    var arms = ""
    var index = 0
    for index < 3 {
        arms += payment_arm(or((index + rotation) % 3, 0))
        index += 1
    }
    source := payments(arms)
    answer := answer_of(source, prelude)
    var why = ""
    if !is_opening(text: answer, opening: "L0501 ") || !has_text(text: answer, piece: " this `match` writes ") {
        why = "the check says " + held.quoted(answer)
    }
    Tried { case: source, why: why }
}

/// A `match` with one variant of the payment left out is refused.
// example: a_match_with_one_of_its_variants_left_out_is_refused(drawn.seeded(1), types.little_prelude()).why == ""
fn a_match_with_one_of_its_variants_left_out_is_refused(draw: drawn.Draw, prelude: types.Prelude) -> Tried {
    source := payments(all_but(drawn.number(draw, 3)))
    answer := answer_of(source, prelude)
    var why = ""
    if !is_opening(text: answer, opening: "L0500 ") {
        why = "the check says " + held.quoted(answer)
    }
    Tried { case: source, why: why }
}

/// A name that binds, written after any of the arms in order, covers every payment.
// example: a_name_that_binds_covers_whatever_else_is_written(drawn.seeded(1), types.little_prelude()).why == ""
fn a_name_that_binds_covers_whatever_else_is_written(draw: drawn.Draw, prelude: types.Prelude) -> Tried {
    var arms = ""
    var index = 0
    for index < drawn.number(draw, 4) {
        arms += payment_arm(index)
        index += 1
    }
    source := payments(arms + "        other => \"something else\"\n")
    answer := answer_of(source, prelude)
    var why = ""
    if answer != "" {
        why = "the check says " + held.quoted(answer)
    }
    Tried { case: source, why: why }
}

/// The refusal of a `match` with a variant left out points at a stretch inside the source.
// example: a_refusal_points_inside_the_source(drawn.seeded(1), types.little_prelude()).why == ""
fn a_refusal_points_inside_the_source(draw: drawn.Draw, prelude: types.Prelude) -> Tried {
    source := payments(all_but(drawn.number(draw, 3)))
    Tried { case: source, why: pointed_inside(source, prelude) }
}

/// `A | B` in one arm covers exactly what `A` and `B` cover in two arms.
// example: one_arm_of_alternatives_covers_what_the_same_arms_cover_separately(drawn.seeded(1), types.little_prelude()).why == ""
fn one_arm_of_alternatives_covers_what_the_same_arms_cover_separately(draw: drawn.Draw, prelude: types.Prelude) -> Tried {
    named := first_colours(1 + drawn.number(draw, 3))
    var apart = ""
    for name in named {
        apart += "        " + name + " => \"seen\"\n"
    }
    together := "        " + strings.join(named, " | ") + " => \"seen\"\n"
    apart_answer := answer_of(colours(apart), prelude)
    together_answer := answer_of(colours(together), prelude)
    var why = ""
    if !is_typed_answer(apart_answer) || is_accepted(apart_answer) != is_accepted(together_answer) {
        why = "apart the check says " + held.quoted(apart_answer) + ", together " + held.quoted(together_answer)
    }
    Tried { case: strings.join(named, " | "), why: why }
}

/// The first `count` colours, in the order the type declares them.
// example: first_colours(2) == ["Red", "Green"]
fn first_colours(count: Int) -> List<String> {
    var named = []
    for name in ["Red", "Green", "Blue"] {
        if list.length(named) < count {
            named = list.push(named, name)
        }
    }
    named
}

/// A module matching on a colour, each variant of which carries nothing, with `arms` as the arms.
// example: has_text(text: colours(""), piece: "type Colour")
fn colours(arms: String) -> String {
    "fn described(colour: Colour) -> String {\n    match colour {\n" + arms + "    }\n}\n\ntype Colour =\n    | Red\n    | Green\n    | Blue\n"
}

/// A drawn `match` of up to four arms over one of four parameters is checked alike twice, and a
/// refusal of it points at a stretch inside it.
///
/// The patterns are the ones the comparison of the two checks drew, so the arms cover some of
/// the values, all of them, or all of them out of order.
// example: has_text(text: a_drawn_match_is_checked_alike_twice_and_a_refusal_points_inside_it(drawn.seeded(1), types.little_prelude()).case, piece: "match ")
fn a_drawn_match_is_checked_alike_twice_and_a_refusal_points_inside_it(draw: drawn.Draw, prelude: types.Prelude) -> Tried {
    source := drawn_match(draw)
    var why = answered_alike(source, prelude)
    if why == "" && answer_of(source, prelude) != "" {
        why = pointed_inside(source, prelude)
    }
    if answer_of(source, prelude) == "does not type" {
        why = "the drawn module does not type"
    }
    Tried { case: source, why: why }
}

/// Why two checks of `source` differ, and `""` where they agree or `source` does not type.
// example: answered_alike("fn f() -> Int {\n    1\n}\n", types.little_prelude()) == ""
fn answered_alike(source: String, prelude: types.Prelude) -> String {
    first := answer_of(source, prelude)
    second := answer_of(source, prelude)
    if first != second {
        return "one check says " + held.quoted(first) + ", the other " + held.quoted(second)
    }
    ""
}

/// Why the refusal of `source` does not point at a stretch inside it, and `""` where it does.
// example: pointed_inside("fn f() -> Int {\n    1\n}\n", types.little_prelude()) == "the check refuses nothing"
fn pointed_inside(source: String, prelude: types.Prelude) -> String {
    match checked(source, prelude) {
        Some(Err(refused)) => span_outside(span: exhaustiveness.span_of(refused), bytes: command.byte_count(source))
        _ => "the check refuses nothing"
    }
}

/// Why `span` is empty or runs past `bytes`, and `""` where it is neither.
// example: span_outside(span: lexer.Span { start: 1, length: 0 }, bytes: 3) == "1..1 is empty"
// example: span_outside(span: lexer.Span { start: 1, length: 2 }, bytes: 3) == ""
fn span_outside(span: lexer.Span, bytes: Int) -> String {
    if span.length <= 0 {
        return shown(span) + " is empty"
    }
    if span.start < 0 || span.start + span.length > bytes {
        return shown(span) + " runs past the source"
    }
    ""
}

/// A module of one `match` of up to four drawn arms over one of four values.
///
/// The truth is a field of a record, because a `Bool` parameter is refused before the check.
// example: has_text(text: drawn_match(drawn.seeded(1)), piece: "type Status")
fn drawn_match(draw: drawn.Draw) -> String {
    over := drawn.number(draw, 4)
    scrutinee := or(list.at(["status", "maybe", "count", "given.flag"], over), "given.flag")
    patterns := or(list.at(patterns_over(), over), ["_"])
    var body = ""
    var at = drawn.next(draw)
    for index in [0, 1, 2, 3] {
        if index <= drawn.number(drawn.next(at), 4) {
            body += "        " + drawn.picked(at, patterns, "_") + " => 1\n"
        }
        at = drawn.next(drawn.next(at))
    }
    "fn check(status: Status, maybe: Option<Status>, count: Int, given: Given) -> Int {\n    match " + scrutinee + " {\n" + body + "    }\n}\n\ntype Status =\n    | Pending\n    | Running(Int)\n    | Failed(Int, Bool)\n\ntype Given = {\n    flag: Bool\n}\n"
}

/// The patterns an arm over each parameter of a drawn `match` writes, in the order of the four.
// example: list.length(patterns_over()) == 4
fn patterns_over() -> List<List<String>> {
    status := ["Pending", "Running(_)", "Running(1)", "Failed(_, true)", "Failed(0, _)", "Failed(_, _)", "Pending | Running(_)", "Running(_) | Pending", "Failed(_, false) | Pending", "other", "_"]
    maybe := ["Some(Pending)", "Some(Running(_))", "Some(Failed(_, _))", "Some(Pending | Failed(_, _))", "Some(Failed(_, _) | Running(2))", "None", "Some(other)", "Some(_) | None", "None | Some(_)", "_"]
    [status, maybe, ["0", "1 | 2", "other", "_"], ["true", "false", "false | true", "_"]]
}

/// Every arm of the payment in declared order but the one at `left_out`.
// example: all_but(1) == payment_arm(0) + payment_arm(2)
fn all_but(left_out: Int) -> String {
    var arms = ""
    for index in [0, 1, 2] {
        if index != left_out {
            arms += payment_arm(index)
        }
    }
    arms
}

/// The arm for the variant of the payment at `index`, in the order the type declares them.
// example: payment_arm(0) == "        Pending => \"waiting\"\n"
fn payment_arm(index: Int) -> String {
    arms := ["        Pending => \"waiting\"\n", "        Authorized { authorization_id } => authorization_id\n", "        Failed(reason) => reason\n"]
    or(list.at(arms, index), "")
}

/// A module declaring the payment type of `docs/design.md`, and a `match` on one with `arms`.
// example: has_text(text: payments(""), piece: "type Payment")
fn payments(arms: String) -> String {
    "fn describe(payment: Payment) -> String {\n    match payment {\n" + arms + "    }\n}\n\ntype Payment =\n    | Pending\n    | Authorized {\n        authorization_id: String\n    }\n    | Failed(String)\n"
}

/// What the check says of `source`: `""` where it accepts, the refusal printed where it does
/// not, and `does not type` where a phase before it refuses.
// example: is_opening(text: answer_of(payments(all_but(0)), types.little_prelude()), opening: "L0500 ")
fn answer_of(source: String, prelude: types.Prelude) -> String {
    match checked(source, prelude) {
        Some(answer) => exhaustiveness.said(answer)
        None => "does not type"
    }
}

/// Whether the check accepted a module that typed.
// example: is_accepted("")
fn is_accepted(answer: String) -> Bool {
    answer == ""
}

/// Whether a module typed, which every module but drawn text does.
// example: !is_typed_answer("does not type")
fn is_typed_answer(answer: String) -> Bool {
    answer != "does not type"
}

/// The answer of the check of `source`, and nothing where `source` does not type.
// example: is_checked(checked("fn f() -> Int {\n    1\n}\n", types.little_prelude()))
fn checked(source: String, prelude: types.Prelude) -> Option<Result<(), exhaustiveness.MatchError>> {
    match typed.inferred(source, prelude) {
        Some(inferred) => Some(exhaustiveness.check(inferred))
        None => None
    }
}

/// Whether a module typed and was checked.
// example: !is_checked(None)
fn is_checked(found: Option<Result<(), exhaustiveness.MatchError>>) -> Bool {
    match found {
        Some(_) => true
        None => false
    }
}

/// Whether `text` opens with `opening`.
// example: is_opening(text: "ab", opening: "a")
fn is_opening(text: String, opening: String) -> Bool {
    or(strings.cut(text, 0, strings.length(opening)), "") == opening
}

/// Whether `piece` is somewhere in `text`.
// example: has_text(text: "abc", piece: "bc")
// example: !has_text(text: "abc", piece: "ca")
fn has_text(text: String, piece: String) -> Bool {
    var at = 0
    for at + strings.length(piece) <= strings.length(text) {
        if or(strings.cut(text, at, at + strings.length(piece)), "") == piece {
            return true
        }
        at += 1
    }
    false
}

/// One case of a property: the drawn input as text, and why it failed, which is `""` where it held.
type Tried = {
    case: String
    why: String
}

/// Each property of the exhaustiveness check.
type Property =
    | Deterministic
    | RotatedRefused
    | LeftOutRefused
    | BindingCovers
    | RefusalInside
    | AlternativesCoverAlike
    | DrawnMatchAlike
