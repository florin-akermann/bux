// The invariants of `docs/specs/codegen.md` that the lowering holds, checked on drawn modules.
//
// Each property draws a module out of a fixed set of constructs, lowers it as a build lowers it,
// and holds what the lowering gives back to one invariant.
import checking
import compiled
import drawn
import held
import ir
import jvm
import list
import strings

// example: held.is_held(lowering_one_module_twice_gives_the_same_classes(0, ir.little_library()))
fn lowering_one_module_twice_gives_the_same_classes(cases: Int, library: ir.Library) -> held.Held {
    checked(property: Twice, cases: cases, library: library)
}

// example: held.is_held(every_class_a_module_writes_is_named_once(0, ir.little_library()))
fn every_class_a_module_writes_is_named_once(cases: Int, library: ir.Library) -> held.Held {
    checked(property: NamedOnce, cases: cases, library: library)
}

// example: held.is_held(every_method_ends_by_leaving_it(0, ir.little_library()))
fn every_method_ends_by_leaving_it(cases: Int, library: ir.Library) -> held.Held {
    checked(property: Leaving, cases: cases, library: library)
}

// example: held.is_held(a_module_has_an_entry_point_exactly_when_it_declares_main(0, ir.little_library()))
fn a_module_has_an_entry_point_exactly_when_it_declares_main(cases: Int, library: ir.Library) -> held.Held {
    checked(property: EntryPoint, cases: cases, library: library)
}

// example: held.is_held(no_class_declares_a_method_the_object_model_gives_it(0, ir.little_library()))
fn no_class_declares_a_method_the_object_model_gives_it(cases: Int, library: ir.Library) -> held.Held {
    checked(property: Inherited, cases: cases, library: library)
}

// example: held.is_held(the_one_equality_a_module_calls_is_the_one_string_declares(0, ir.little_library()))
fn the_one_equality_a_module_calls_is_the_one_string_declares(cases: Int, library: ir.Library) -> held.Held {
    checked(property: StringEquality, cases: cases, library: library)
}

// example: held.is_held(a_written_list_stores_each_element_and_builds_one_list(0, ir.little_library()))
fn a_written_list_stores_each_element_and_builds_one_list(cases: Int, library: ir.Library) -> held.Held {
    checked(property: ListWritten, cases: cases, library: library)
}

// example: held.is_held(as_many_values_stand_for_nothing_as_a_list_writes_units(0, ir.little_library()))
fn as_many_values_stand_for_nothing_as_a_list_writes_units(cases: Int, library: ir.Library) -> held.Held {
    checked(property: Units, cases: cases, library: library)
}

// example: held.is_held(a_bare_field_lowers_as_the_field_written_whole(0, ir.little_library()))
fn a_bare_field_lowers_as_the_field_written_whole(cases: Int, library: ir.Library) -> held.Held {
    checked(property: BareField, cases: cases, library: library)
}

// example: checked(property: Twice, cases: 0, library: ir.little_library()).cases == 0
fn checked(property: Property, cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        let seed = drawn.seed_of(case)
        let one = drawing(property: property, draw: drawn.seeded(seed), library: library)
        found = compiled.noted(found, one.why, held.drawn_failure(name_of(property), seed, one.source, one.why))
        case += 1
    }
    found
}

// example: drawing(property: Units, draw: drawn.seeded(1), library: ir.little_library()).why == ""
fn drawing(property: Property, draw: drawn.Draw, library: ir.Library) -> Drawing {
    match property {
        Twice => twice(draw, library)
        NamedOnce => named_once(draw, library)
        Leaving => leaving(draw, library)
        EntryPoint => entry_point(draw, library)
        Inherited => inherited(draw, library)
        StringEquality => string_equality(draw, library)
        ListWritten => list_written(draw, library)
        Units => units(draw, library)
        BareField => bare_field(draw, library)
    }
}

// example: name_of(Twice) == "lowering_one_module_twice_gives_the_same_classes"
fn name_of(property: Property) -> String {
    match property {
        Twice => "lowering_one_module_twice_gives_the_same_classes"
        NamedOnce => "every_class_a_module_writes_is_named_once"
        Leaving => "every_method_ends_by_leaving_it"
        EntryPoint => "a_module_has_an_entry_point_exactly_when_it_declares_main"
        Inherited => "no_class_declares_a_method_the_object_model_gives_it"
        StringEquality => "the_one_equality_a_module_calls_is_the_one_string_declares"
        ListWritten => "a_written_list_stores_each_element_and_builds_one_list"
        Units => "as_many_values_stand_for_nothing_as_a_list_writes_units"
        BareField => "a_bare_field_lowers_as_the_field_written_whole"
    }
}

// example: twice(drawn.seeded(1), ir.little_library()).source != ""
fn twice(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let source = drawn.picked(draw, sources(), "")
    Drawing { source: source, why: compiled.differing(compiled.written_alone(source, library), compiled.written_alone(source, library)) }
}

// example: named_once(drawn.seeded(1), ir.little_library()).source != ""
fn named_once(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let source = drawn.picked(draw, sources(), "")
    let lowered = compiled.lowered_alone(source, library)
    var why = refused(lowered)
    for module in lowered {
        var names = []
        for class in module.classes {
            let name = jvm.class_of(class.of)
            if list.has_value(names, name) {
                why = "two classes are named " + name
            }
            names = list.push(names, name)
        }
    }
    Drawing { source: source, why: why }
}

// example: leaving(drawn.seeded(1), ir.little_library()).source != ""
fn leaving(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let source = drawn.picked(draw, sources(), "")
    let lowered = compiled.lowered_alone(source, library)
    var why = refused(lowered)
    for class in compiled.every_class(lowered) {
        for method in class.methods {
            let instructions = compiled.spelled_of(method, class).instructions
            let last = list.at(instructions, list.length(instructions) - 1)
            if !is_return(or(last, jvm.Copy)) {
                why = jvm.class_of(class.of) + "." + method.name + " ends with no return"
            }
        }
    }
    Drawing { source: source, why: why }
}

// example: is_return(jvm.Return(None))
// example: !is_return(jvm.Copy)
fn is_return(instruction: jvm.Instruction) -> Bool {
    match instruction {
        jvm.Return(_) => true
        _ => false
    }
}

// example: entry_point(drawn.seeded(1), ir.little_library()).source != ""
fn entry_point(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let source = drawn.picked(draw, sources(), "")
    let lowered = compiled.lowered_alone(source, library)
    let declared = compiled.is_holding(source, "fn main(arguments: List<String>) -> Int {")
    var why = refused(lowered)
    if why == "" && is_entered(lowered) != declared {
        why = "an entry point is written: " + shown(is_entered(lowered)) + ", and `main` is declared: " + shown(declared)
    }
    Drawing { source: source, why: why }
}

// example: !is_entered([])
fn is_entered(lowered: List<ir.Lowered>) -> Bool {
    for class in compiled.demo_classes(lowered) {
        for method in class.methods {
            if method.name == "main" && compiled.is_none(method.result) {
                return true
            }
        }
    }
    false
}

// example: inherited(drawn.seeded(1), ir.little_library()).source != ""
fn inherited(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let source = drawn.picked(draw, sources(), "")
    let lowered = compiled.lowered_alone(source, library)
    let object = ["equals", "hashCode", "getClass", "toString", "clone", "finalize", "wait", "notify", "notifyAll"]
    var why = refused(lowered)
    for class in compiled.every_class(lowered) {
        for method in class.methods {
            if list.has_value(object, method.name) {
                why = jvm.class_of(class.of) + " declares " + method.name + ", which the object model gives it"
            }
        }
    }
    Drawing { source: source, why: why }
}

// example: string_equality(drawn.seeded(1), ir.little_library()).source != ""
fn string_equality(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let source = drawn.picked(draw, sources(), "")
    let lowered = compiled.lowered_alone(source, library)
    var why = refused(lowered)
    for class in compiled.every_class(lowered) {
        for method in class.methods {
            for instruction in compiled.spelled_of(method, class).instructions {
                why = equality_why(or(compiled.called(instruction), no_call()), why)
            }
        }
    }
    Drawing { source: source, why: why }
}

// example: equality_why(no_call(), "") == ""
fn equality_why(reference: jvm.MethodRef, why: String) -> String {
    if reference.name == "equals" && reference.class != "java/lang/String" {
        return "it calls equals of " + reference.class + ", which answers by identity"
    }
    why
}

// example: list_written(drawn.seeded(1), ir.little_library()).why == ""
fn list_written(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let many = drawn.picked(draw, [0, 1, 2, 3, 7], 0)
    var elements = []
    for list.length(elements) < many {
        elements = list.push(elements, list.length(elements))
    }
    let source = "fn written() -> List<Int> {\n    " + shown(elements) + "\n}\n"
    let lowered = compiled.lowered_alone(source, library)
    let body = compiled.instructions_of(lowered, "written")
    Drawing { source: source, why: listing_why(body, many) }
}

// example: listing_why([], 0) == "it makes no array of 0"
fn listing_why(body: List<jvm.Instruction>, many: Int) -> String {
    if !is_integer(or(list.at(body, 0), jvm.Copy), many) {
        return "it makes no array of " + shown(many)
    }
    var stored = 0
    for instruction in body {
        if is_stored_in_array(instruction) {
            stored += 1
        }
    }
    if stored != many {
        return "it stores " + shown(stored) + " elements"
    }
    let built = list.length(listed_calls(body))
    if built != 1 {
        return "it builds " + shown(built) + " lists"
    }
    ""
}

// example: is_integer(jvm.IntegerOf(2), 2)
// example: !is_integer(jvm.LongOf(2), 2)
fn is_integer(instruction: jvm.Instruction, value: Int) -> Bool {
    match instruction {
        jvm.IntegerOf(pushed) => pushed == value
        _ => false
    }
}

// example: is_stored_in_array(jvm.StoreInArray)
// example: !is_stored_in_array(jvm.Copy)
fn is_stored_in_array(instruction: jvm.Instruction) -> Bool {
    match instruction {
        jvm.StoreInArray => true
        _ => false
    }
}

// example: listed_calls([jvm.Copy]) == []
fn listed_calls(body: List<jvm.Instruction>) -> List<String> {
    var calls = []
    for instruction in body {
        let reference = or(compiled.called(instruction), no_call())
        if reference.class == "bux/List" && reference.name == "of" {
            calls = list.push(calls, reference.name)
        }
    }
    calls
}

// example: no_call().name == ""
fn no_call() -> jvm.MethodRef {
    jvm.MethodRef { class: "", name: "", descriptor: jvm.MethodDescriptor { parameters: [], result: None } }
}

// example: units(drawn.seeded(1), ir.little_library()).why == ""
fn units(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let many = drawn.picked(draw, [0, 1, 2, 3, 7], 0)
    var written = []
    for list.length(written) < many {
        written = list.push(written, "()")
    }
    let source = "fn written() -> List<()> {\n    [" + strings.join(written, ", ") + "]\n}\n"
    let lowered = compiled.lowered_alone(source, library)
    var standing = 0
    for instruction in compiled.instructions_of(lowered, "written") {
        if list.has_value(compiled.class_reached(instruction), "java/lang/Object") && is_new(instruction) {
            standing += 1
        }
    }
    var why = refused(lowered)
    if why == "" && standing != many {
        why = shown(standing) + " values stand for " + shown(many) + " units"
    }
    Drawing { source: source, why: why }
}

// example: is_new(jvm.New("a/B"))
// example: !is_new(jvm.Copy)
fn is_new(instruction: jvm.Instruction) -> Bool {
    match instruction {
        jvm.New(_) => true
        _ => false
    }
}

// example: bare_field(drawn.seeded(1), ir.little_library()).why == ""
fn bare_field(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let many = drawn.picked(draw, [1, 2, 3, 4], 1)
    var forms = []
    for number in drawn.numbers(drawn.next(draw), many, 2) {
        forms = list.push(forms, or(list.at([Whole, Bare], number), Whole))
    }
    let source = record_built(many, forms)
    let whole = record_built(many, [])
    Drawing { source: source, why: compiled.differing(compiled.written_alone(source, library), compiled.written_alone(whole, library)) }
}

// example: record_built(1, [Bare]) == "fn built(first: Int) -> Record {\n    let made = Record { first }\n    made { first }\n}\n\ntype Record = {\n    first: Int\n}\n"
fn record_built(many: Int, forms: List<FieldForm>) -> String {
    var parameters = []
    var given = []
    var declared = ""
    for list.length(given) < many {
        let index = list.length(given)
        let name = or(list.at(["first", "second", "third", "fourth"], index), "")
        let field = name + ": " + or(list.at(["Int", "String", "List<Int>", "List<String>"], index), "")
        parameters = list.push(parameters, field)
        given = list.push(given, field_given(name, or(list.at(forms, index), Whole)))
        declared += "    " + field + "\n"
    }
    "fn built(" + strings.join(parameters, ", ") + ") -> Record {\n    let made = Record { " + strings.join(given, ", ") + " }\n    made { " + or(list.at(given, 0), "") + " }\n}\n\ntype Record = {\n" + declared + "}\n"
}

// example: field_given("id", Bare) == "id"
// example: field_given("id", Whole) == "id: id"
fn field_given(name: String, form: FieldForm) -> String {
    match form {
        Bare => name
        Whole => name + ": " + name
    }
}

// example: list.length(sources()) == 10
fn sources() -> List<String> {
    ["fn written() -> List<Int> {\n    [1, 2, 3]\n}\n", "fn saved() -> Result<(), String> {\n    Ok(())\n}\n", "fn answer() -> Int {\n    7\n}\n", "fn held(user: User) -> Int {\n    user.id\n}\n\ntype User = {\n    id: Int\n    active: Bool\n}\n", "fn told(payment: Payment) -> String {\n    match payment {\n        Pending => \"waiting\"\n        Failed(reason) => reason\n    }\n}\n\ntype Payment =\n    | Pending\n    | Failed(String)\n", "fn walked(counts: List<Int>) -> Int {\n    var total = 0\n    for count in counts {\n        total += count\n    }\n    total\n}\n", "fn used() -> Result<Int, String> {\n    let value = held()?\n    Ok(value + 1)\n}\n\nfn held() -> Result<Int, String> {\n    Ok(1)\n}\n", "fn wrapped() -> Option<Int> {\n    Some(identity(2))\n}\n\nfn identity<T>(value: T) -> T {\n    value\n}\n", "fn counted() -> Int {\n    2\n}\n\nfn main(arguments: List<String>) -> Int {\n    0\n}\n", "fn is_same(word: String, count: Int) -> Bool {\n    word == \"one\" && count != 2\n}\n"]
}

// example: refused([]) == "the compiler refused it"
fn refused(lowered: List<ir.Lowered>) -> String {
    if list.length(lowered) == 0 {
        return "the compiler refused it"
    }
    ""
}

type Drawing = {
    source: String
    why: String
}

type FieldForm =
    | Bare
    | Whole

type Property =
    | Twice
    | NamedOnce
    | Leaving
    | EntryPoint
    | Inherited
    | StringEquality
    | ListWritten
    | Units
    | BareField

test "lowering one module twice gives the same classes" {
    held.is_held_reported(lowering_one_module_twice_gives_the_same_classes(held.drawn_cases(), checking.carried_library()))
}

test "every class a module writes is named once" {
    held.is_held_reported(every_class_a_module_writes_is_named_once(held.drawn_cases(), checking.carried_library()))
}

test "every method ends by leaving it" {
    held.is_held_reported(every_method_ends_by_leaving_it(held.drawn_cases(), checking.carried_library()))
}

test "a module has an entry point exactly when it declares main" {
    held.is_held_reported(a_module_has_an_entry_point_exactly_when_it_declares_main(held.drawn_cases(), checking.carried_library()))
}

test "no class declares a method the object model gives it" {
    held.is_held_reported(no_class_declares_a_method_the_object_model_gives_it(held.drawn_cases(), checking.carried_library()))
}

test "the one equality a module calls is the one string declares" {
    held.is_held_reported(the_one_equality_a_module_calls_is_the_one_string_declares(held.drawn_cases(), checking.carried_library()))
}

test "a written list stores each element and builds one list" {
    held.is_held_reported(a_written_list_stores_each_element_and_builds_one_list(held.drawn_cases(), checking.carried_library()))
}

test "as many values stand for nothing as a list writes units" {
    held.is_held_reported(as_many_values_stand_for_nothing_as_a_list_writes_units(held.drawn_cases(), checking.carried_library()))
}

test "a bare field lowers as the field written whole" {
    held.is_held_reported(a_bare_field_lowers_as_the_field_written_whole(held.drawn_cases(), checking.carried_library()))
}
