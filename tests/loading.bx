// The drawn properties of loading modules and packages, which `docs/specs/modules.md` and
// `docs/specs/packages.md` state.
//
// Each case draws a set of modules from a fixed seed, writes it into a directory of its own under
// the temporary directory, and loads it with `src/modules.bx`. The directory is removed whole
// when every property has run, and nothing is written into the repository.
import ast
import command
import drawn
import files
import held
import lexer
import list
import modules
import strings
import walk

/// One `Held` for each property of loading, in a fixed order.
///
/// Where no directory of its own can be made, each property is skipped with the reason.
// example: list.length(every_property(1)) == 9
fn every_property(cases: Int) -> List<held.Held> {
    match command.somewhere_of_its_own() {
        Ok(directory) => every_property_in(cases, directory)
        Err(said) => every_skipped(said.errors)
    }
}

/// Every property, each case written under `directory`, which is removed whole afterwards.
// example: list.length(every_skipped("no directory")) == 9
fn every_property_in(cases: Int, directory: String) -> List<held.Held> {
    let found = [a_downward_set_loads(cases, directory), each_module_is_below_its_imports(cases, directory), no_module_is_loaded_twice(cases, directory), loading_is_deterministic(cases, directory), a_refusal_points_inside_its_file(cases, directory), two_packages_load_dependencies_first(cases, directory), a_module_beside_the_file_wins(cases, directory), a_manifest_is_read_or_refused_against_its_text(cases, directory), a_package_in_the_layout_loads(cases, directory)]
    command.removed_whole(directory)
    found
}

/// One skipped `Held` for each property, each with `why`.
// example: list.length(or(list.at(every_skipped("no directory"), 0), held.nothing_failed(0)).skipped) == 1
fn every_skipped(why: String) -> List<held.Held> {
    var found = []
    for list.length(found) < 9 {
        found = list.push(found, held.with_skip(held.nothing_failed(0), "loading: " + why))
    }
    found
}

/// A set of modules where each imports only modules drawn after it loads.
// example: held.is_held(a_downward_set_loads(0, "no-such-directory"))
fn a_downward_set_loads(cases: Int, directory: String) -> held.Held {
    held_over(cases, DownwardLoads, directory)
}

/// Every module loaded is handed over after each module it imports.
// example: held.is_held(each_module_is_below_its_imports(0, "no-such-directory"))
fn each_module_is_below_its_imports(cases: Int, directory: String) -> held.Held {
    held_over(cases, BelowItsImports, directory)
}

/// No module is loaded twice, however many modules import it.
// example: held.is_held(no_module_is_loaded_twice(0, "no-such-directory"))
fn no_module_is_loaded_twice(cases: Int, directory: String) -> held.Held {
    held_over(cases, LoadedOnce, directory)
}

/// Loading one file twice hands over the same modules from the same files in the same order.
// example: held.is_held(loading_is_deterministic(0, "no-such-directory"))
fn loading_is_deterministic(cases: Int, directory: String) -> held.Held {
    held_over(cases, Deterministic, directory)
}

/// An import of nothing is refused at a stretch of at least one byte inside the file shown.
// example: held.is_held(a_refusal_points_inside_its_file(0, "no-such-directory"))
fn a_refusal_points_inside_its_file(cases: Int, directory: String) -> held.Held {
    held_over(cases, RefusalInside, directory)
}

/// A set split across two packages loads each module after every module it imports.
// example: held.is_held(two_packages_load_dependencies_first(0, "no-such-directory"))
fn two_packages_load_dependencies_first(cases: Int, directory: String) -> held.Held {
    held_over(cases, TwoPackages, directory)
}

/// A module beside the importing file is reached however many dependencies hold one.
// example: held.is_held(a_module_beside_the_file_wins(0, "no-such-directory"))
fn a_module_beside_the_file_wins(cases: Int, directory: String) -> held.Held {
    held_over(cases, BesideWins, directory)
}

/// A drawn manifest is read or refused, and a refusal of it points into the text it is.
// example: held.is_held(a_manifest_is_read_or_refused_against_its_text(0, "no-such-directory"))
fn a_manifest_is_read_or_refused_against_its_text(cases: Int, directory: String) -> held.Held {
    held_over(cases, ManifestRead, directory)
}

// A test module of a drawn package reaches the modules of its `src/`, and each module of `src/`
// reaches no test module.
// example: held.is_held(a_package_in_the_layout_loads(0, "no-such-directory"))
fn a_package_in_the_layout_loads(cases: Int, directory: String) -> held.Held {
    held_over(cases, LayoutLoads, directory)
}

/// `property` tried on `cases` drawn cases, each written into a directory of its own.
// example: held_over(0, DownwardLoads, "no-such-directory").cases == 0
fn held_over(cases: Int, property: Property, directory: String) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        let seed = drawn.seed_of(case)
        let within = modules.joined(directory, name_of(property) + "-" + shown(seed))
        let tried = tried_in(property, drawn.seeded(seed), made_at(within))
        if tried.why != "" {
            found = held.with_failure(found, held.drawn_failure(name_of(property), seed, tried.input, tried.why))
        }
        case += 1
    }
    found
}

/// One case of `property`, drawn from `draw` and written under `directory`.
// example: tried_in(DownwardLoads, drawn.seeded(1), "no-such-directory").why != ""
fn tried_in(property: Property, draw: drawn.Draw, directory: String) -> Tried {
    match property {
        DownwardLoads => downward_tried(draw, directory)
        BelowItsImports => order_tried(draw, directory)
        LoadedOnce => once_tried(draw, directory)
        Deterministic => again_tried(draw, directory)
        RefusalInside => refusal_tried(draw, directory)
        TwoPackages => packages_tried(draw, directory)
        BesideWins => beside_tried(draw, directory)
        ManifestRead => manifest_tried(draw, directory)
        LayoutLoads => layout_tried(draw, directory)
    }
}

/// The name a failure of `property` is reported under.
// example: name_of(BesideWins) == "a_module_beside_the_file_wins"
fn name_of(property: Property) -> String {
    match property {
        DownwardLoads => "a_downward_set_loads"
        BelowItsImports => "each_module_is_below_its_imports"
        LoadedOnce => "no_module_is_loaded_twice"
        Deterministic => "loading_is_deterministic"
        RefusalInside => "a_refusal_points_inside_its_file"
        TwoPackages => "two_packages_load_dependencies_first"
        BesideWins => "a_module_beside_the_file_wins"
        ManifestRead => "a_manifest_is_read_or_refused_against_its_text"
        LayoutLoads => "a_package_in_the_layout_loads"
    }
}

/// A drawn downward set, loaded from its first module, which loads.
// example: downward_tried(drawn.seeded(1), "no-such-directory").why != ""
fn downward_tried(draw: drawn.Draw, directory: String) -> Tried {
    let set = layered(draw)
    Tried { input: set_text(set), why: refusal_of(load_first(set, directory)) }
}

/// A drawn downward set, whose modules are each loaded after every module they import.
// example: order_tried(drawn.seeded(1), "no-such-directory").why != ""
fn order_tried(draw: drawn.Draw, directory: String) -> Tried {
    let set = layered(draw)
    Tried { input: set_text(set), why: misordered(load_first(set, directory)) }
}

/// A drawn downward set, whose modules are each loaded once.
// example: once_tried(drawn.seeded(1), "no-such-directory").why != ""
fn once_tried(draw: drawn.Draw, directory: String) -> Tried {
    let set = layered(draw)
    Tried { input: set_text(set), why: twice_loaded(load_first(set, directory)) }
}

/// A drawn downward set, loaded twice from its first module.
// example: again_tried(drawn.seeded(1), "no-such-directory").why != ""
fn again_tried(draw: drawn.Draw, directory: String) -> Tried {
    let set = layered(draw)
    written_into(directory, set)
    let once = modules.printed(file_of(directory: directory, name: "alpha"))
    let again = modules.printed(file_of(directory: directory, name: "alpha"))
    Tried { input: set_text(set), why: differing(once: once, again: again) }
}

/// Why two loads differ, or why the first did not load, and `""` where neither is so.
// example: differing(once: "loaded\n", again: "loaded\n") == ""
// example: differing(once: "unreadable a\n", again: "unreadable a\n") == "unreadable a\n"
// example: differing(once: "loaded\n", again: "loaded\na\n") == "one load gave \"loaded\\n\" and the next gave \"loaded\\na\\n\""
fn differing(once: String, again: String) -> String {
    if or(strings.cut(once, 0, 7), "") != "loaded\n" {
        return once
    }
    if once != again {
        return "one load gave " + held.quoted(once) + " and the next gave " + held.quoted(again)
    }
    ""
}

/// A drawn downward set whose first module imports nothing there is, which is refused there.
// example: refusal_tried(drawn.seeded(1), "no-such-directory").why != ""
fn refusal_tried(draw: drawn.Draw, directory: String) -> Tried {
    let set = with_first_importing_nowhere(layered(draw))
    Tried { input: set_text(set), why: refusal_outside(load_first(set, directory)) }
}

/// `set` with its first module written to import `nowhere`, which no file is.
// example: set_text(with_first_importing_nowhere([Written { name: "alpha", source: "" }])) == "alpha.bx:\nimport nowhere\n\nfn held() -> Int {\n    1\n}\n"
fn with_first_importing_nowhere(set: List<Written>) -> List<Written> {
    var changed = []
    for one in set {
        if list.length(changed) == 0 {
            changed = list.push(changed, one { source: importing(["nowhere"]) })
        } else {
            changed = list.push(changed, one)
        }
    }
    changed
}

/// Why a load is not refused at a stretch of at least one byte of the file it is shown against.
// example: refusal_outside(Ok([])) == "it loads"
fn refusal_outside(answer: Result<List<modules.Module>, modules.NotLoaded>) -> String {
    match answer {
        Ok(_) => "it loads"
        Err(refused) => refused_outside(refused)
    }
}

/// Why `refused` is not at a stretch of at least one byte of the file it is shown against.
// example: refused_outside(modules.Unreadable { path: "a.bx", why: "" }) == "unreadable a.bx\n"
fn refused_outside(refused: modules.NotLoaded) -> String {
    match refused {
        modules.Refused { source, error } => outside(start: error.span.start, length: error.span.length, within: strings.length(source))
        _ => modules.refusal_printed(refused)
    }
}

/// Why `length` bytes from `start` are not a stretch of at least one byte of `within` bytes.
// example: outside(start: 1, length: 2, within: 3) == ""
// example: outside(start: 1, length: 0, within: 3) == "the refusal points at 1..1"
fn outside(start: Int, length: Int, within: Int) -> String {
    if length > 0 && start >= 0 && start + length <= within {
        return ""
    }
    "the refusal points at " + shown(start) + ".." + shown(start + length)
}

/// A drawn downward set, its first module in one package and the rest in a package it depends on.
// example: packages_tried(drawn.seeded(1), "no-such-directory").why != ""
fn packages_tried(draw: drawn.Draw, directory: String) -> Tried {
    let set = layered(draw)
    let app = made_at(modules.joined(directory, "app"))
    let below = made_at(modules.joined(directory, "below"))
    written_into(sources_of(app), first_of(set))
    written_into(sources_of(below), rest_of(set))
    stated(directory: app, manifest: "package app\nversion 0.2.0\ndepends ../below\n")
    stated(directory: below, manifest: "package below\nversion 0.2.0\n")
    Tried { input: set_text(set), why: misordered(modules.load(file_of(directory: modules.joined(app, "src"), name: "alpha"))) }
}

// The first module of a drawn downward set is a test module, and the rest are modules of `src/`.
// The test module loads, each module after what it imports. Where the set has a second module,
// that module of `src/` imports the test module too, and the import is refused as `L0306`.
// example: layout_tried(drawn.seeded(1), "no-such-directory").why != ""
fn layout_tried(draw: drawn.Draw, directory: String) -> Tried {
    let set = layered(draw)
    let package = made_at(modules.joined(directory, "package"))
    written_into(tests_of(package), first_of(set))
    written_into(sources_of(package), rest_of(set))
    stated(directory: package, manifest: "package drawn\nversion 0.1.0\n")
    let loaded = misordered(modules.load(file_of(directory: modules.joined(package, "tests"), name: "alpha")))
    if loaded != "" || list.length(set) < 2 {
        return Tried { input: set_text(set), why: loaded }
    }
    let beta = file_of(directory: modules.joined(package, "src"), name: "beta")
    _ = files.write(beta, importing(["alpha"]))
    Tried { input: set_text(set), why: unless_missing(printed: modules.printed(beta), path: beta) }
}

// example: unless_missing(printed: "refused a.bx\nL0306 7..12 there is no module named `alpha`\nhelp: x\n", path: "a.bx") == ""
// example: unless_missing(printed: "loaded\n", path: "a.bx") == "the module of src/ that imports alpha gave \"loaded\\n\""
fn unless_missing(printed: String, path: String) -> String {
    let refusal = "refused " + path + "\nL0306 7..12 there is no module named `alpha`\n"
    if or(strings.cut(printed, 0, strings.length(refusal)), "") == refusal {
        return ""
    }
    "the module of src/ that imports alpha gave " + held.quoted(printed)
}

/// A module beside the importing file, and one to three dependencies that each hold one too.
// example: beside_tried(drawn.seeded(1), "no-such-directory").why != ""
fn beside_tried(draw: drawn.Draw, directory: String) -> Tried {
    let count = drawn.number(draw, 3) + 1
    var depends = ""
    var index = 0
    for index < count {
        let holder = made_at(modules.joined(directory, "holder" + shown(index)))
        written_into(sources_of(holder), [Written { name: "alpha", source: importing([]) }])
        stated(directory: holder, manifest: "package holder" + shown(index) + "\nversion 0.2.0\n")
        depends += "depends ../holder" + shown(index) + "\n"
        index += 1
    }
    let app = made_at(modules.joined(directory, "app"))
    let sources = sources_of(app)
    written_into(sources, [Written { name: "main", source: importing(["alpha"]) }, Written { name: "alpha", source: importing([]) }])
    stated(directory: app, manifest: "package app\nversion 0.2.0\n" + depends)
    Tried { input: shown(count) + " dependencies holding alpha", why: first_not_at(modules.load(file_of(directory: sources, name: "main")), file_of(directory: sources, name: "alpha")) }
}

/// Why the first module loaded is not the one at `path`, and `""` where it is.
// example: first_not_at(Ok([]), "a.bx") == "nothing was loaded"
fn first_not_at(answer: Result<List<modules.Module>, modules.NotLoaded>, path: String) -> String {
    let loaded = ok_or(answer, [])
    match list.at(loaded, 0) {
        Some(first) => same_path(found: first.path, path: path)
        None => "nothing was loaded"
    }
}

/// `""` where `found` is `path`, and why not otherwise.
// example: same_path(found: "a.bx", path: "a.bx") == ""
// example: same_path(found: "b.bx", path: "a.bx") == "the module loaded first is b.bx, not a.bx"
fn same_path(found: String, path: String) -> String {
    if found == path {
        return ""
    }
    "the module loaded first is " + found + ", not " + path
}

/// A manifest of up to five drawn lines, beside a module that imports nothing.
// example: manifest_tried(drawn.seeded(1), "no-such-directory").why == ""
fn manifest_tried(draw: drawn.Draw, directory: String) -> Tried {
    let manifest = drawn.text_of(drawn.next(draw), manifest_lines(), drawn.number(draw, 6))
    written_into(sources_of(directory), [Written { name: "main", source: importing([]) }])
    stated(directory: directory, manifest: manifest)
    let at = modules.joined(directory, "bux.package")
    Tried { input: manifest, why: manifest_outside(modules.load(file_of(directory: modules.joined(directory, "src"), name: "main")), Manifest { path: at, source: manifest }) }
}

/// Why a refusal of the manifest does not point into its text, and `""` where it does.
///
/// A load that is not refused, or is refused about another file, says nothing about the manifest.
// example: manifest_outside(Ok([]), Manifest { path: "bux.package", source: "" }) == ""
// example: manifest_outside(Err(modules.Refused { path: "bux.package", source: "x", error: modules.LoadError { kind: modules.NoSuchModule(""), span: drawn_span() } }), Manifest { path: "bux.package", source: "" }) == "the refusal is shown against \"x\""
fn manifest_outside(answer: Result<List<modules.Module>, modules.NotLoaded>, manifest: Manifest) -> String {
    match answer {
        Ok(_) => ""
        Err(refused) => manifest_refusal(refused, manifest)
    }
}

/// Why `refused` does not point into `manifest`, where it is a refusal of a file that was read.
// example: manifest_refusal(modules.Unreadable { path: "a.bx", why: "" }, Manifest { path: "bux.package", source: "" }) == ""
fn manifest_refusal(refused: modules.NotLoaded, manifest: Manifest) -> String {
    match refused {
        modules.Refused { path, source, error } => refused_manifest(Refusing { path: path, source: source, end: error.span.start + error.span.length }, manifest)
        _ => ""
    }
}

/// Why `refusing` does not point into `manifest`, where it is about the manifest at all.
// example: refused_manifest(Refusing { path: "a.bx", source: "", end: 9 }, Manifest { path: "bux.package", source: "" }) == ""
fn refused_manifest(refusing: Refusing, manifest: Manifest) -> String {
    if refusing.path != manifest.path {
        return ""
    }
    if refusing.source != manifest.source {
        return "the refusal is shown against " + held.quoted(refusing.source)
    }
    if refusing.end > strings.length(manifest.source) {
        return "the refusal ends at " + shown(refusing.end)
    }
    ""
}

/// A stretch of no bytes at the start, which an example refusal points at.
// example: drawn_span().length == 0
fn drawn_span() -> lexer.Span {
    lexer.Span { start: 0, length: 0 }
}

/// The first module of `set`, which is the one loading starts from.
// example: list.length(first_of([Written { name: "a", source: "" }, Written { name: "b", source: "" }])) == 1
fn first_of(set: List<Written>) -> List<Written> {
    match list.at(set, 0) {
        Some(first) => [first]
        None => []
    }
}

/// Every module of `set` but the first.
// example: list.length(rest_of([Written { name: "alpha", source: "" }, Written { name: "b", source: "" }])) == 1
fn rest_of(set: List<Written>) -> List<Written> {
    var rest = []
    for one in set {
        if one.name != "alpha" {
            rest = list.push(rest, one)
        }
    }
    rest
}

/// `set`, written into `directory`, and loaded from its first module.
// example: refusal_of(load_first([Written { name: "alpha", source: "" }], "no-such-directory")) != ""
fn load_first(set: List<Written>, directory: String) -> Result<List<modules.Module>, modules.NotLoaded> {
    written_into(directory, set)
    modules.load(file_of(directory: directory, name: "alpha"))
}

/// The first module loaded before a module it imports, or why nothing loaded, and `""`.
// example: misordered(Ok([module_of(name: "alpha", source: "import beta\n"), module_of(name: "beta", source: "")])) == "beta is imported by alpha, which is loaded before it"
// example: misordered(Ok([module_of(name: "beta", source: ""), module_of(name: "alpha", source: "import beta\n")])) == ""
fn misordered(answer: Result<List<modules.Module>, modules.NotLoaded>) -> String {
    let loaded = ok_or(answer, [])
    if list.length(loaded) == 0 {
        return "nothing loaded: " + refusal_of(answer)
    }
    let order = names_of(loaded)
    for module in loaded {
        let at = or(list.index_of(order, module.name), 0)
        for imported in imported_by(module.source) {
            if or(list.index_of(order, imported), at) >= at {
                return imported + " is imported by " + module.name + ", which is loaded before it"
            }
        }
    }
    ""
}

/// The first module loaded twice, or why nothing loaded, and `""`.
// example: twice_loaded(Ok([module_of(name: "alpha", source: ""), module_of(name: "alpha", source: "")])) == "alpha is loaded twice"
// example: twice_loaded(Ok([module_of(name: "alpha", source: "")])) == ""
fn twice_loaded(answer: Result<List<modules.Module>, modules.NotLoaded>) -> String {
    let loaded = ok_or(answer, [])
    if list.length(loaded) == 0 {
        return "nothing loaded: " + refusal_of(answer)
    }
    var seen = []
    for name in names_of(loaded) {
        if list.has_value(seen, name) {
            return name + " is loaded twice"
        }
        seen = list.push(seen, name)
    }
    ""
}

/// Why `answer` did not load, and `""` where it did.
// example: refusal_of(Ok([])) == ""
fn refusal_of(answer: Result<List<modules.Module>, modules.NotLoaded>) -> String {
    match answer {
        Ok(_) => ""
        Err(refused) => modules.refusal_printed(refused)
    }
}

/// The name of each module of `loaded`, in the order it was handed over.
// example: names_of([module_of(name: "alpha", source: "")]) == ["alpha"]
fn names_of(loaded: List<modules.Module>) -> List<String> {
    var found = []
    for module in loaded {
        found = list.push(found, module.name)
    }
    found
}

/// Every module `source` imports, read back out of the text it was written as.
// example: imported_by("import beta\n\nimport gamma\n\nfn held() -> Int {\n    1\n}\n") == ["beta", "gamma"]
fn imported_by(source: String) -> List<String> {
    var found = []
    for line in walk.lines_of(source) {
        if or(strings.cut(line, 0, 7), "") == "import " {
            found = list.push(found, or(strings.cut(line, 7, strings.length(line)), ""))
        }
    }
    found
}

/// A module of no program, called `name` and written as `source`, which an example loads.
// example: module_of(name: "a", source: "").name == "a"
fn module_of(name: String, source: String) -> modules.Module {
    modules.Module { name: name, path: name + ".bx", source: source, program: ast.Program { items: [] } }
}

/// A set of one to five modules, each importing only modules drawn after it, which is no ring.
// example: list.length(layered(drawn.seeded(1))) >= 1
fn layered(draw: drawn.Draw) -> List<Written> {
    let count = drawn.number(draw, 5) + 1
    var at = drawn.next(draw)
    var set = []
    for list.length(set) < count {
        var below = []
        var later = list.length(set) + 1
        for later < count {
            if drawn.number(at, 2) == 1 {
                below = list.push(below, or(list.at(names(), later), ""))
            }
            at = drawn.next(at)
            later += 1
        }
        set = list.push(set, Written { name: or(list.at(names(), list.length(set)), ""), source: importing(below) })
    }
    set
}

/// The names a drawn set of modules is called, in the order they are drawn.
// example: list.length(names()) == 5
fn names() -> List<String> {
    ["alpha", "beta", "gamma", "delta", "epsilon"]
}

/// A module that imports each of `imports` and declares a function of its own.
// example: importing([]) == "fn held() -> Int {\n    1\n}\n"
fn importing(imports: List<String>) -> String {
    var written = ""
    for module in imports {
        written += "import " + module + "\n\n"
    }
    written + "fn held() -> Int {\n    1\n}\n"
}

/// The lines a drawn manifest is built out of, well formed and otherwise.
// example: list.length(manifest_lines()) == 8
fn manifest_lines() -> List<String> {
    ["package app\n", "version 0.2.0\n", "depends ../nowhere\n", "\n", "author nobody\n", "package\n", "package a b\n", "packageapp\n"]
}

/// `set` as the text a failure shows: each module's name, then its source.
// example: set_text([Written { name: "a", source: "x\n" }]) == "a.bx:\nx\n"
fn set_text(set: List<Written>) -> String {
    var text = ""
    for one in set {
        text += one.name + ".bx:\n" + one.source
    }
    text
}

// example: sources_of("no-such-directory") == "no-such-directory/src"
fn sources_of(directory: String) -> String {
    made_at(modules.joined(directory, "src"))
}

// example: tests_of("no-such-directory") == "no-such-directory/tests"
fn tests_of(directory: String) -> String {
    made_at(modules.joined(directory, "tests"))
}

/// The directory at `path`, made where it is not there yet.
// example: made_at("") == ""
fn made_at(path: String) -> String {
    _ = files.made(path)
    path
}

/// Writes each module of `set` into its own file in `directory`.
fn written_into(directory: String, set: List<Written>) -> () {
    for one in set {
        _ = files.write(file_of(directory: directory, name: one.name), one.source)
    }
}

/// Writes `manifest` as the manifest of the package in `directory`.
fn stated(directory: String, manifest: String) -> () {
    _ = files.write(modules.joined(directory, "bux.package"), manifest)
}

/// The file the module called `name` is written in, in `directory`.
// example: file_of(directory: "a", name: "b") == "a/b.bx"
fn file_of(directory: String, name: String) -> String {
    modules.module_in(directory, name)
}

/// One case of a property: the input it drew, as text, and why it failed, which is `""` where
/// it held.
type Tried = {
    input: String
    why: String
}

/// One module of a drawn set: its name, and the source it is written as.
type Written = {
    name: String
    source: String
}

/// A manifest as it was written: the file it is, and its text.
type Manifest = {
    path: String
    source: String
}

/// A refusal of a file: the file, its text, and where the stretch it points at ends.
type Refusing = {
    path: String
    source: String
    end: Int
}

/// The properties of loading, each named by what it holds.
type Property =
    | DownwardLoads
    | BelowItsImports
    | LoadedOnce
    | Deterministic
    | RefusalInside
    | TwoPackages
    | BesideWins
    | ManifestRead
    | LayoutLoads

test "every property of loading holds" {
    held.is_held_reported(held.together(every_property(held.drawn_cases())))
}
