// The invariants of a lowered body that takes one path or another, checked on drawn modules.
//
// A division tests its divisor, an `or` works its fallback out, and a `?` hands a `None` back:
// each writes two paths, and `docs/specs/codegen.md` states what each path holds.
import checking
import compiled
import drawn
import held
import ir
import jvm
import list

// example: held.is_held(every_division_tests_its_divisor_before_it_divides(0, ir.little_library()))
fn every_division_tests_its_divisor_before_it_divides(cases: Int, library: ir.Library) -> held.Held {
    checked(property: Tested, cases: cases, library: library)
}

// example: held.is_held(every_division_builds_both_answers_a_divisor_can_have(0, ir.little_library()))
fn every_division_builds_both_answers_a_divisor_can_have(cases: Int, library: ir.Library) -> held.Held {
    checked(property: BothAnswers, cases: cases, library: library)
}

// example: held.is_held(or_is_written_out_where_it_is_used_rather_than_called(0, ir.little_library()))
fn or_is_written_out_where_it_is_used_rather_than_called(cases: Int, library: ir.Library) -> held.Held {
    checked(property: WrittenOut, cases: cases, library: library)
}

// example: held.is_held(or_works_out_its_fallback_before_it_asks_which_variant_it_was_handed(0, ir.little_library()))
fn or_works_out_its_fallback_before_it_asks_which_variant_it_was_handed(cases: Int, library: ir.Library) -> held.Held {
    checked(property: FallbackFirst, cases: cases, library: library)
}

// example: held.is_held(every_question_mark_on_an_option_gives_the_none_it_was_handed_back_unchanged(0, ir.little_library()))
fn every_question_mark_on_an_option_gives_the_none_it_was_handed_back_unchanged(cases: Int, library: ir.Library) -> held.Held {
    checked(property: HandedBack, cases: cases, library: library)
}

// example: checked(property: Tested, cases: 0, library: ir.little_library()).cases == 0
fn checked(property: Property, cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        let seed = drawn.seed_of(case)
        let one = drawing(property: property, draw: drawn.seeded(seed), library: library)
        found = compiled.noted(found, one.why, held.drawn_failure(name_of(property), seed, one.source, one.why))
        case += 1
    }
    found
}

// example: drawing(property: Tested, draw: drawn.seeded(1), library: ir.little_library()).source != ""
fn drawing(property: Property, draw: drawn.Draw, library: ir.Library) -> Drawing {
    match property {
        Tested => tested(draw, library)
        BothAnswers => both_answers(draw, library)
        WrittenOut => written_out(draw, library)
        FallbackFirst => fallback_first(draw, library)
        HandedBack => handed_back(draw, library)
    }
}

// example: name_of(Tested) == "every_division_tests_its_divisor_before_it_divides"
fn name_of(property: Property) -> String {
    match property {
        Tested => "every_division_tests_its_divisor_before_it_divides"
        BothAnswers => "every_division_builds_both_answers_a_divisor_can_have"
        WrittenOut => "or_is_written_out_where_it_is_used_rather_than_called"
        FallbackFirst => "or_works_out_its_fallback_before_it_asks_which_variant_it_was_handed"
        HandedBack => "every_question_mark_on_an_option_gives_the_none_it_was_handed_back_unchanged"
    }
}

// example: tested(drawn.seeded(1), ir.little_library()).source != ""
fn tested(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let source = dividing(draw)
    let lowered = compiled.lowered_alone(source, library)
    var why = refused(lowered)
    for body in compiled.demo_bodies(lowered) {
        why = untested(body, why)
    }
    Drawing { source: source, why: why }
}

// example: untested([jvm.Load { slot: 2, of: jvm.Long }, jvm.Arithmetic(ir.Divide)], "") == "it divides by slot 2 untested"
// example: untested([jvm.Load { slot: 2, of: jvm.Long }, jvm.LongOf(0), jvm.CompareLongs(ir.Equal), jvm.Load { slot: 2, of: jvm.Long }, jvm.Arithmetic(ir.Divide)], "") == ""
fn untested(body: List<jvm.Instruction>, why: String) -> String {
    var at = 0
    var said = why
    for instruction in body {
        if is_dividing(instruction) {
            let divisor = slot_loaded(or(list.at(body, at - 1), jvm.Copy))
            if divisor < 0 || !is_tested_before(body: body, at: at, divisor: divisor) {
                said = "it divides by slot " + shown(divisor) + " untested"
            }
        }
        at += 1
    }
    said
}

// example: is_dividing(jvm.Arithmetic(ir.Remainder))
// example: !is_dividing(jvm.Arithmetic(ir.Add))
fn is_dividing(instruction: jvm.Instruction) -> Bool {
    match instruction {
        jvm.Arithmetic(ir.Divide) => true
        jvm.Arithmetic(ir.Remainder) => true
        _ => false
    }
}

// example: !is_tested_before(body: [], at: 0, divisor: 1)
fn is_tested_before(body: List<jvm.Instruction>, at: Int, divisor: Int) -> Bool {
    var from = 0
    for from + 2 < at {
        let loaded = is_long_loaded(or(list.at(body, from), jvm.Copy), divisor)
        if loaded && is_long_zero(or(list.at(body, from + 1), jvm.Copy)) && is_long_equality(or(list.at(body, from + 2), jvm.Copy)) {
            return true
        }
        from += 1
    }
    false
}

// example: is_long_loaded(jvm.Load { slot: 1, of: jvm.Long }, 1)
// example: !is_long_loaded(jvm.Load { slot: 1, of: jvm.Integer }, 1)
fn is_long_loaded(instruction: jvm.Instruction, wanted: Int) -> Bool {
    match instruction {
        jvm.Load { slot, of } => slot == wanted && of == jvm.Long
        _ => false
    }
}

// example: is_long_zero(jvm.LongOf(0))
// example: !is_long_zero(jvm.LongOf(1))
fn is_long_zero(instruction: jvm.Instruction) -> Bool {
    match instruction {
        jvm.LongOf(value) => value == 0
        _ => false
    }
}

// example: is_long_equality(jvm.CompareLongs(ir.Equal))
// example: !is_long_equality(jvm.CompareLongs(ir.Less))
fn is_long_equality(instruction: jvm.Instruction) -> Bool {
    match instruction {
        jvm.CompareLongs(how) => how == ir.Equal
        _ => false
    }
}

// example: both_answers(drawn.seeded(1), ir.little_library()).source != ""
fn both_answers(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let source = dividing(draw)
    let lowered = compiled.lowered_alone(source, library)
    var built = []
    for body in compiled.demo_bodies(lowered) {
        built = compiled.both(built, compiled.reached_in(body))
    }
    var why = refused(lowered)
    for variant in ["bux/Option$Some", "bux/Option$None"] {
        if !list.has_value(built, variant) {
            why = "it builds no " + variant
        }
    }
    Drawing { source: source, why: why }
}

// example: dividing(drawn.seeded(1)) != ""
fn dividing(draw: drawn.Draw) -> String {
    let operator = drawn.picked(draw, ["/", "%"], "")
    let dividend = drawn.picked(drawn.next(draw), operands(), "")
    let divisor = drawn.picked(drawn.next(drawn.next(draw)), operands(), "")
    let context = drawn.picked(drawn.next(drawn.next(drawn.next(draw))), contexts(), "")
    compiled.replaced(context, "{}", dividend + " " + operator + " " + divisor)
}

// example: list.length(contexts()) == 4
fn contexts() -> List<String> {
    ["fn go(a: Int, b: Int) -> Option<Int> {\n    _ = a + b\n    {}\n}\n", "fn go(a: Int, b: Int) -> Int {\n    _ = a + b\n    or({}, 0)\n}\n", "fn go(a: Int, b: Int) -> Option<Int> {\n    _ = a + b\n    let held = {}\n    held\n}\n", "fn is_same(a: Int, b: Int) -> Bool {\n    _ = a + b\n    or({}, 0) == a\n}\n"]
}

// example: written_out(drawn.seeded(1), ir.little_library()).source != ""
fn written_out(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let fallback = drawn.picked(draw, operands(), "")
    let source = "fn go(a: Int, b: Int) -> Int {\n    or(a / b, " + fallback + ")\n}\n"
    let body = compiled.instructions_of(compiled.lowered_alone(source, library), "go")
    Drawing { source: source, why: called_or_why(body) }
}

// example: called_or_why([]) == "it never asks which variant it was handed"
fn called_or_why(body: List<jvm.Instruction>) -> String {
    if list.has_value(compiled.calls_named(body), "or") {
        return "it calls `or`, which has no class to be called on"
    }
    if position_of_equality(body) < 0 {
        return "it never asks which variant it was handed"
    }
    for instruction in body {
        if field_read(instruction) == "value0" {
            return ""
        }
    }
    "it never reads what a `Some` holds"
}

// example: field_read(jvm.Copy) == ""
fn field_read(instruction: jvm.Instruction) -> String {
    match instruction {
        jvm.GetField(field) => field.name
        _ => ""
    }
}

// example: fallback_first(drawn.seeded(1), ir.little_library()).source != ""
fn fallback_first(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let operator = drawn.picked(draw, ["+", "-", "*"], "")
    let source = "fn go(a: Int, b: Int) -> Int {\n    or(a / b, a " + operator + " b)\n}\n"
    let body = compiled.instructions_of(compiled.lowered_alone(source, library), "go")
    let worked_out = position_of_arithmetic(body, operator)
    let asked = position_of_equality(body)
    var why = ""
    if worked_out < 0 || asked < 0 || worked_out > asked {
        why = "the fallback is worked out at " + shown(worked_out) + ", and the variant asked for at " + shown(asked)
    }
    Drawing { source: source, why: why }
}

// example: position_of_equality([jvm.Copy, jvm.CompareIntegers(ir.Equal)]) == 1
// example: position_of_equality([]) == -1
fn position_of_equality(body: List<jvm.Instruction>) -> Int {
    var at = 0
    for instruction in body {
        if is_integer_equality(instruction) {
            return at
        }
        at += 1
    }
    -1
}

// example: position_of_arithmetic([jvm.Arithmetic(ir.Multiply)], "*") == 0
// example: position_of_arithmetic([jvm.Arithmetic(ir.Multiply)], "+") == -1
fn position_of_arithmetic(body: List<jvm.Instruction>, operator: String) -> Int {
    var at = 0
    for instruction in body {
        if arithmetic_written(instruction) == operator {
            return at
        }
        at += 1
    }
    -1
}

// example: arithmetic_written(jvm.Arithmetic(ir.Subtract)) == "-"
// example: arithmetic_written(jvm.Copy) == ""
fn arithmetic_written(instruction: jvm.Instruction) -> String {
    match instruction {
        jvm.Arithmetic(ir.Add) => "+"
        jvm.Arithmetic(ir.Subtract) => "-"
        jvm.Arithmetic(ir.Multiply) => "*"
        _ => ""
    }
}

// example: handed_back(drawn.seeded(1), ir.little_library()).source != ""
fn handed_back(draw: drawn.Draw, library: ir.Library) -> Drawing {
    let dividend = drawn.picked(draw, operands(), "")
    let divisor = drawn.picked(drawn.next(draw), operands(), "")
    let context = drawn.picked(drawn.next(drawn.next(draw)), propagating(), "")
    let source = compiled.replaced(context, "{}", dividend + " / " + divisor)
    let lowered = compiled.lowered_alone(source, library)
    var why = refused(lowered)
    var propagated = 0
    for body in compiled.demo_bodies(lowered) {
        for at in none_tests(body) {
            propagated += 1
            why = propagation_why(body: body, at: at, why: why)
        }
    }
    if why == "" && propagated == 0 {
        why = "it writes no `?` on an `Option`"
    }
    Drawing { source: source, why: why }
}

// example: list.length(operands()) == 3
fn operands() -> List<String> {
    ["a", "b", "17"]
}

// example: refused([]) == "the compiler refused it"
fn refused(lowered: List<ir.Lowered>) -> String {
    if list.length(lowered) == 0 {
        return "the compiler refused it"
    }
    ""
}

// example: list.length(propagating()) == 5
fn propagating() -> List<String> {
    ["fn go(a: Int, b: Int) -> Option<Int> {\n    _ = a + b\n    Some(({})?)\n}\n", "fn go(a: Int, b: Int) -> Option<Int> {\n    _ = a + b\n    let held = ({})?\n    Some(held)\n}\n", "fn go(a: Int, b: Int) -> Option<Int> {\n    _ = a + b\n    Some((({})? / 2)? + 2 * 5)\n}\n", "fn is_same(a: Int, b: Int) -> Option<Bool> {\n    _ = a + b\n    Some(({})? == a)\n}\n", "fn go(a: Int, b: Int) -> Option<Int> {\n    _ = a + b\n    if a == b {\n        return Some(({})?)\n    }\n    Some(0)\n}\n"]
}

// example: none_tests([jvm.GetField(jvm.FieldRef { class: "bux/Option", name: "tag", of: jvm.Integer }), jvm.IntegerOf(1), jvm.CompareIntegers(ir.Equal), jvm.JumpIfFalse(2)]) == [0]
fn none_tests(body: List<jvm.Instruction>) -> List<Int> {
    var found = []
    var at = 0
    for at + 3 < list.length(body) {
        let tag = is_option_tag(or(list.at(body, at), jvm.Copy)) && is_none_tag(or(list.at(body, at + 1), jvm.Copy))
        if tag && is_integer_equality(or(list.at(body, at + 2), jvm.Copy)) && is_jump_if_false(or(list.at(body, at + 3), jvm.Copy)) {
            found = list.push(found, at)
        }
        at += 1
    }
    found
}

// example: is_integer_equality(jvm.CompareIntegers(ir.Equal))
// example: !is_integer_equality(jvm.CompareLongs(ir.Equal))
fn is_integer_equality(instruction: jvm.Instruction) -> Bool {
    match instruction {
        jvm.CompareIntegers(how) => how == ir.Equal
        _ => false
    }
}

// example: !is_option_tag(jvm.Copy)
fn is_option_tag(instruction: jvm.Instruction) -> Bool {
    match instruction {
        jvm.GetField(field) => field.class == "bux/Option" && field.name == "tag"
        _ => false
    }
}

// example: is_none_tag(jvm.IntegerOf(1))
// example: !is_none_tag(jvm.IntegerOf(0))
fn is_none_tag(instruction: jvm.Instruction) -> Bool {
    match instruction {
        jvm.IntegerOf(value) => value == 1
        _ => false
    }
}

// example: is_jump_if_false(jvm.JumpIfFalse(0))
// example: !is_jump_if_false(jvm.Jump(0))
fn is_jump_if_false(instruction: jvm.Instruction) -> Bool {
    match instruction {
        jvm.JumpIfFalse(_) => true
        _ => false
    }
}

// example: propagation_why(body: [], at: 0, why: "") == "a `?` reads the tag of what it did not load"
fn propagation_why(body: List<jvm.Instruction>, at: Int, why: String) -> String {
    let slot = slot_loaded(or(list.at(body, at - 1), jvm.Copy))
    if slot < 0 {
        return "a `?` reads the tag of what it did not load"
    }
    let loaded = is_option_loaded(or(list.at(body, at + 4), jvm.Copy), slot)
    if !loaded || !is_option_returned(or(list.at(body, at + 5), jvm.Copy)) {
        return "a `?` builds a `None` rather than give back the one in slot " + shown(slot)
    }
    why
}

// example: slot_loaded(jvm.Load { slot: 3, of: jvm.Long }) == 3
// example: slot_loaded(jvm.Copy) == -1
fn slot_loaded(instruction: jvm.Instruction) -> Int {
    match instruction {
        jvm.Load { slot } => slot
        _ => -1
    }
}

// example: is_option_loaded(jvm.Load { slot: 2, of: jvm.Reference("bux/Option") }, 2)
// example: !is_option_loaded(jvm.Load { slot: 2, of: jvm.Long }, 2)
fn is_option_loaded(instruction: jvm.Instruction, wanted: Int) -> Bool {
    match instruction {
        jvm.Load { slot, of } => slot == wanted && of == jvm.Reference("bux/Option")
        _ => false
    }
}

// example: is_option_returned(jvm.Return(Some(jvm.Reference("bux/Option"))))
// example: !is_option_returned(jvm.Return(None))
fn is_option_returned(instruction: jvm.Instruction) -> Bool {
    match instruction {
        jvm.Return(Some(of)) => of == jvm.Reference("bux/Option")
        _ => false
    }
}

type Drawing = {
    source: String
    why: String
}

type Property =
    | Tested
    | BothAnswers
    | WrittenOut
    | FallbackFirst
    | HandedBack

test "every division tests its divisor before it divides" {
    held.is_held_reported(every_division_tests_its_divisor_before_it_divides(held.drawn_cases(), checking.carried_library()))
}

test "every division builds both answers a divisor can have" {
    held.is_held_reported(every_division_builds_both_answers_a_divisor_can_have(held.drawn_cases(), checking.carried_library()))
}

test "or is written out where it is used rather than called" {
    held.is_held_reported(or_is_written_out_where_it_is_used_rather_than_called(held.drawn_cases(), checking.carried_library()))
}

test "or works out its fallback before it asks which variant it was handed" {
    held.is_held_reported(or_works_out_its_fallback_before_it_asks_which_variant_it_was_handed(held.drawn_cases(), checking.carried_library()))
}

test "every question mark on an option gives the none it was handed back unchanged" {
    held.is_held_reported(every_question_mark_on_an_option_gives_the_none_it_was_handed_back_unchanged(held.drawn_cases(), checking.carried_library()))
}
