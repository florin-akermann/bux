// The drawn properties of the rule that every name a module introduces is read.
//
// `docs/specs/unused.md` states the rule. Each property draws a shape and a name to put in it,
// and resolves the module with `src/resolver.bx` against the prelude the compiler carries,
// with the imports its examples read. A failure names the seed and the module it drew.
import checking
import command
import compiled
import drawn
import held
import ir
import list
import parser
import resolver
import strings

// example: held.is_held(a_name_read_by_nothing_is_refused_naming_its_kind(2, ir.little_library().prelude.names))
fn a_name_read_by_nothing_is_refused_naming_its_kind(cases: Int, names: resolver.Prelude) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        let draw = drawn.seeded(seed)
        let shape = drawn.picked(draw, shapes(), no_shape())
        let name = drawn.picked(drawn.next(draw), names_for(shape), "")
        let source = compiled.replaced(shape.unread, "{}", name)
        let answer = answered(source, names)
        let wanted = refusal_of(shape: shape, name: name, source: source)
        if or(strings.cut(answer, 0, strings.length(wanted)), "") != wanted {
            found = held.with_failure(found, held.drawn_failure("a_name_read_by_nothing_is_refused_naming_its_kind", seed, source, "the answer is " + held.quoted(answer)))
        }
    }
    found
}

// example: held.is_held(a_module_whose_every_name_is_read_is_accepted(2, ir.little_library().prelude.names))
fn a_module_whose_every_name_is_read_is_accepted(cases: Int, names: resolver.Prelude) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        let draw = drawn.seeded(seed)
        let shape = drawn.picked(draw, shapes(), no_shape())
        let name = drawn.picked(drawn.next(draw), names_for(shape), "")
        let source = compiled.replaced(shape.read, "{}", name)
        let answer = answered(source, names)
        if or(strings.cut(answer, 0, 9), "") != "resolved\n" {
            found = held.with_failure(found, held.drawn_failure("a_module_whose_every_name_is_read_is_accepted", seed, source, "the answer is " + held.quoted(answer)))
        }
    }
    found
}

// example: refusal_of(shape: Shape { unread: "", read: "", kind: "binding", code: "L0321" }, name: "tally", source: "fn f() -> Int {\n    let tally = 1\n    2\n}\n") == "refused\nL0321 24..29 the binding `tally` is read by nothing\n"
fn refusal_of(shape: Shape, name: String, source: String) -> String {
    let at = checking.occurrence(source, name, 1)
    "refused\n" + shape.code + " " + shown(at.start) + ".." + shown(at.start + at.length) + " the " + shape.kind + " `" + name + "` is read by nothing\n"
}

// example: answered("fn (", ir.little_library().prelude.names) == "unparsed\n"
fn answered(source: String, names: resolver.Prelude) -> String {
    match parser.parse(source) {
        Ok(program) => resolver.answer_printed(resolver.resolve(program, "demo", names, command.examples_read(source)))
        Err(_) => "unparsed\n"
    }
}

// example: names_for(no_shape()) == ["tally", "parcel", "label", "weight"]
fn names_for(shape: Shape) -> List<String> {
    if shape.kind == "import" {
        return ["io", "list", "strings", "files"]
    }
    ["tally", "parcel", "label", "weight"]
}

// An assignment is no read, a hole reads only the names above it, and an example reads an import.
// example: list.length(shapes()) == 8
fn shapes() -> List<Shape> {
    let bound = "L0321"
    [Shape { unread: "import {}\n\nfn f() -> Int {\n    1\n}\n", read: "import {}\n\nfn f() -> Int {\n    {}.counted()\n}\n", kind: "import", code: "L0320" }, Shape { unread: "import {}\n\n// example: f() == 1\nfn f() -> Int {\n    1\n}\n", read: "import {}\n\n// example: {}.counted(f()) == 1\nfn f() -> Int {\n    1\n}\n", kind: "import", code: "L0320" }, Shape { unread: "fn f() -> Int {\n    let {} = 1\n    2\n}\n", read: "fn f() -> Int {\n    let {} = 1\n    {}\n}\n", kind: "binding", code: bound }, Shape { unread: "fn f() -> Int {\n    var {} = 1\n    {} = 2\n    3\n}\n", read: "fn f() -> Int {\n    var {} = 1\n    {} = 2\n    {}\n}\n", kind: "binding", code: bound }, Shape { unread: "fn f(values: List<Int>) -> Int {\n    var sum = 0\n    for {} in values {\n        sum += 1\n    }\n    sum\n}\n", read: "fn f(values: List<Int>) -> Int {\n    var sum = 0\n    for {} in values {\n        sum += {}\n    }\n    sum\n}\n", kind: "binding", code: bound }, Shape { unread: "fn f(maybe: Option<Int>) -> Int {\n    match maybe {\n        Some({}) => 1\n        None => 0\n    }\n}\n", read: "fn f(maybe: Option<Int>) -> Int {\n    match maybe {\n        Some({}) => {}\n        None => 0\n    }\n}\n", kind: "binding", code: bound }, Shape { unread: "fn f({}: Int, other: Int) -> Int {\n    other\n}\n", read: "fn f({}: Int, other: Int) -> Int {\n    {} + other\n}\n", kind: "parameter", code: bound }, Shape { unread: "fn f() -> Int {\n    _ = todo(\"later\")\n    let {} = 1\n    2\n}\n", read: "fn f() -> Int {\n    let {} = 1\n    todo(\"later\")\n}\n", kind: "binding", code: bound }]
}

// example: no_shape().kind == ""
fn no_shape() -> Shape {
    Shape { unread: "", read: "", kind: "", code: "" }
}

type Shape = {
    unread: String
    read: String
    kind: String
    code: String
}

test "a name read by nothing is refused naming its kind" {
    held.is_held_reported(a_name_read_by_nothing_is_refused_naming_its_kind(held.drawn_cases(), checking.carried_library().prelude.names))
}

test "a module whose every name is read is accepted" {
    held.is_held_reported(a_module_whose_every_name_is_read_is_accepted(held.drawn_cases(), checking.carried_library().prelude.names))
}
