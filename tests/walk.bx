// The files the tests read, the copies it works in, and the programs it starts in a copy.
//
// `docs/implementation.md` section 7 states the tests. A walk is in the order names sort, so two
// runs report the same failures in the same order.
import command
import files
import list
import modules
import programs
import strings

// example: list.length(every_file(directory: "no-such-directory", ending: ".bx")) == 0
fn every_file(directory: String, ending: String) -> List<String> {
    var found = []
    for name in ok_or(files.listed(directory), []) {
        let path = modules.joined(directory, name)
        if files.is_directory(files.named(path)) {
            for below in every_file(directory: path, ending: ending) {
                found = list.push(found, below)
            }
        } else if is_ending_in(text: name, ending: ending) {
            found = list.push(found, path)
        }
    }
    found
}

// example: list.length(files_in(directory: "no-such-directory", ending: ".bx")) == 0
fn files_in(directory: String, ending: String) -> List<String> {
    var found = []
    for name in ok_or(files.listed(directory), []) {
        let path = modules.joined(directory, name)
        if is_ending_in(text: name, ending: ending) && !files.is_directory(files.named(path)) {
            found = list.push(found, path)
        }
    }
    found
}

// `docs/implementation.md` section 7 states why it is this number.
// example: start_limit() == 60
fn start_limit() -> Int {
    60
}

// example: sibling(path: "a/b.bx", extension: "tokens") == "a/b.tokens"
fn sibling(path: String, extension: String) -> String {
    let dot = modules.last_unit(path, 46)
    if dot < 0 {
        return path + "." + extension
    }
    or(strings.cut(path, 0, dot + 1), "") + extension
}

// example: is_ending_in(text: "a.bx", ending: ".bx")
// example: !is_ending_in(text: "a.bxx", ending: ".bx")
fn is_ending_in(text: String, ending: String) -> Bool {
    let from = strings.length(text) - strings.length(ending)
    from >= 0 && or(strings.cut(text, from, strings.length(text)), "") == ending
}

// example: list.length(lines_of("a\n\nb\n")) == 3
fn lines_of(text: String) -> List<String> {
    var lines = []
    var start = 0
    var index = 0
    for index < strings.length(text) {
        if or(strings.at(text, index), 0) == 10 {
            lines = list.push(lines, or(strings.cut(text, start, index), ""))
            start = index + 1
        }
        index += 1
    }
    if start < strings.length(text) {
        lines = list.push(lines, or(strings.cut(text, start, strings.length(text)), ""))
    }
    lines
}

// The output goes into two files, so a program that writes much on one stream never waits.
// The limit stops a program that never ends, so that program cannot stop its test.
// example: ok_or(completed(line: ["no-such-program-at-all"], directory: "no-such-directory", limit: 1), Ended { output: "", errors: "", status: 7 }).status == 7
fn completed(line: List<String>, directory: String, limit: Int) -> Result<Ended, Unended> {
    completed_from(line: line, directory: directory, written: directory, limit: limit)
}

// Programs that start in one directory at the same time each write into a directory of their own.
// Each starts with the environment that `command.cleared` leaves, as a run of `bux test` starts.
// example: ok_or(completed_from(line: ["no-such-program-at-all"], directory: ".", written: "no-such-directory", limit: 1), Ended { output: "", errors: "", status: 7 }).status == 7
fn completed_from(line: List<String>, directory: String, written: String, limit: Int) -> Result<Ended, Unended> {
    let output = modules.joined(written, ".output")
    let errors = modules.joined(written, ".errors")
    let builder = programs.of_command(line)
    command.cleared(builder)
    let starting = programs.errors_to(programs.output_to(programs.input_from(programs.within(builder, files.named(directory)), files.named("/dev/null")), files.named(output)), files.named(errors))
    match programs.started(starting) {
        Ok(running) => ended_or_stopped(running, limit, Streams { output: output, errors: errors })
        Err(_) => Err(NotStarted)
    }
}

// The standard output until the stop stays, so a caller can see how far the program came.
// example: unended_said(PastLimit(2, ""), "the program") == "the program did not end within 2 s, and was stopped"
fn ended_or_stopped(running: programs.Running, limit: Int, streams: Streams) -> Result<Ended, Unended> {
    if ok_or(programs.is_ended_within(running, limit, programs.seconds()), false) {
        return Ok(read_after(status: ok_or(programs.waited_for(running), -1), output: streams.output, errors: streams.errors))
    }
    _ = programs.stopped(running)
    _ = programs.waited_for(running)
    Err(PastLimit(limit, ok_or(files.read(streams.output), "")))
}

// example: unended_said(NotStarted, "the launcher") == "the launcher could not be started"
fn unended_said(unended: Unended, program: String) -> String {
    match unended {
        NotStarted => program + " could not be started"
        PastLimit(limit, _) => program + " did not end within " + shown(limit) + " s, and was stopped"
    }
}

// The status comes first, because a program has written all its output only when it has ended.
// example: read_after(status: 3, output: "no-such-directory/a", errors: "no-such-directory/b").status == 3
fn read_after(status: Int, output: String, errors: String) -> Ended {
    Ended { output: ok_or(files.read(output), ""), errors: ok_or(files.read(errors), ""), status: status }
}

type Ended = {
    output: String
    errors: String
    status: Int
}

type Unended =
    | NotStarted
    | PastLimit(Int, String)

type Streams = {
    output: String
    errors: String
}
