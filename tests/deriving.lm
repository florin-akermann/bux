// The drawn properties of traits, their instances, and what a derive gives a type, which
// `docs/specs/traits.md`, `docs/specs/derive.md`, and `docs/specs/library.md` state.
import ast
import checking
import drawn
import held
import ir
import lexer
import list
import strings

/// One `Held` for each property of traits and derives, in a fixed order.
// example: list.length(every_property(0, ir.little_library())) == 7
fn every_property(cases: Int, library: ir.Library) -> List<held.Held> {
    [a_record_whose_every_field_has_the_trait_derives_it(cases, library), a_field_without_the_trait_is_refused_naming_both(cases, library), a_trait_method_reaches_the_instance_of_its_type(cases, library), a_type_with_no_instance_is_refused_where_the_trait_is_asked(cases, library), each_standard_method_is_accepted_over_every_supplied_type(cases, library), each_standard_method_is_refused_over_a_type_with_no_instance(cases, library), every_instance_body_of_the_prelude_has_the_type_its_trait_gives(cases, library)]
}

/// Whichever trait is derived, a record of fields that all have it derives it too.
// example: a_record_whose_every_field_has_the_trait_derives_it(2, ir.little_library()).cases == 2
fn a_record_whose_every_field_has_the_trait_derives_it(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "a_record_whose_every_field_has_the_trait_derives_it", seed, derived_tried(drawn.seeded(seed), library))
    }
    found
}

/// A drawn standard trait, derived for a record of one to four drawn fields that have it.
// example: derived_tried(drawn.seeded(1), ir.little_library()).input != ""
fn derived_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    standard := drawn.picked(draw, standards(), eq())
    fields := drawn_fields(draw: drawn.next(draw), count: drawn.number(checking.after(draw, 2), 4) + 1)
    source := deriving(standard: standard, declared: record(fields))
    typed := checking.type_written(source, called(standard: standard, one: "one", other: "other"), 1, library)
    if typed != standard.gives {
        return checking.Tried { input: source, why: standard.of + " gives " + typed }
    }
    checking.Tried { input: source, why: "" }
}

/// Whichever trait is derived, a field without it is refused naming the field and the trait.
// example: a_field_without_the_trait_is_refused_naming_both(2, ir.little_library()).cases == 2
fn a_field_without_the_trait_is_refused_naming_both(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "a_field_without_the_trait_is_refused_naming_both", seed, underived_tried(drawn.seeded(seed), library))
    }
    found
}

/// A drawn standard trait, derived for a record with one field without it at a drawn place.
// example: underived_tried(drawn.seeded(1), ir.little_library()).input != ""
fn underived_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    standard := drawn.picked(draw, standards(), eq())
    fields := drawn_fields(draw: drawn.next(draw), count: drawn.number(checking.after(draw, 2), 4))
    without := drawn.picked(checking.after(draw, 3), ["List<Option<Int>>", "()", "Option<Int>"], "()")
    at := drawn.number(checking.after(draw, 4), list.length(fields) + 1)
    source := deriving(standard: standard, declared: record(inserted(fields: fields, at: at, field: without)))
    message := checking.message_of(checking.checked(source, library))
    if message != "`Held` derives `" + standard.of + "`, and the `" + without + "` it holds as `value" + shown(at) + "` has none" {
        return checking.Tried { input: source, why: "the refusal says " + held.quoted(message) }
    }
    checking.Tried { input: source, why: "" }
}

/// A trait method resolves to the instance of the type its use settled on, and to no other.
// example: a_trait_method_reaches_the_instance_of_its_type(2, ir.little_library()).cases == 2
fn a_trait_method_reaches_the_instance_of_its_type(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "a_trait_method_reaches_the_instance_of_its_type", seed, reached_tried(drawn.seeded(seed), library))
    }
    found
}

/// A comparison of two values of a drawn type through `Eq`.
// example: reached_tried(drawn.seeded(1), ir.little_library()).input != ""
fn reached_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    of := drawn.picked(draw, ["Bool", "Int", "String", "Point"], "Int")
    source := comparing(of)
    answered := checking.instance_in(checking.checked(source, library), checking.occurrence(source, "is_equal", 1))
    if answered != of {
        return checking.Tried { input: source, why: "is_equal reaches the instance for " + answered }
    }
    checking.Tried { input: source, why: "" }
}

/// A trait with no instance for a type is refused there, whatever else the module says.
// example: a_type_with_no_instance_is_refused_where_the_trait_is_asked(2, ir.little_library()).cases == 2
fn a_type_with_no_instance_is_refused_where_the_trait_is_asked(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "a_type_with_no_instance_is_refused_where_the_trait_is_asked", seed, circle_tried(drawn.seeded(seed), library))
    }
    found
}

/// A comparison of two circles, beside a comparison of two values of a drawn type.
// example: circle_tried(drawn.seeded(1), ir.little_library()).input != ""
fn circle_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    of := drawn.picked(draw, ["Bool", "Int", "String", "Point"], "Int")
    source := "fn is_matching() -> Bool {\n    is_equal(Circle { radius: 1 }, Circle { radius: 1 })\n}\n\n" + comparing(of) + "\ntype Circle = {\n    radius: Int\n}\n"
    message := checking.message_of(checking.checked(source, library))
    if message != "`Circle` has no instance of `Eq`" {
        return checking.Tried { input: source, why: "the refusal says " + held.quoted(message) }
    }
    checking.Tried { input: source, why: "" }
}

/// Every standard trait's method is accepted over each of the three types the prelude supplies.
// example: each_standard_method_is_accepted_over_every_supplied_type(2, ir.little_library()).cases == 2
fn each_standard_method_is_accepted_over_every_supplied_type(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "each_standard_method_is_accepted_over_every_supplied_type", seed, supplied_tried(drawn.seeded(seed), library))
    }
    found
}

/// A drawn standard method, asked of two values of a drawn type the prelude supplies.
// example: supplied_tried(drawn.seeded(1), ir.little_library()).input != ""
fn supplied_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    standard := drawn.picked(draw, standards(), eq())
    values := drawn.picked(drawn.next(draw), supplied(), Supplied { one: "1", other: "2" })
    written := called(standard: standard, one: values.one, other: values.other)
    source := asking(standard: standard, written: written)
    typed := checking.type_written(source, written, 1, library)
    if typed != standard.gives {
        return checking.Tried { input: source, why: written + " is " + typed }
    }
    checking.Tried { input: source, why: "" }
}

/// A declared type without an instance is refused wherever a standard method is asked of it.
// example: each_standard_method_is_refused_over_a_type_with_no_instance(2, ir.little_library()).cases == 2
fn each_standard_method_is_refused_over_a_type_with_no_instance(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "each_standard_method_is_refused_over_a_type_with_no_instance", seed, unsupplied_tried(drawn.seeded(seed), library))
    }
    found
}

/// A drawn standard method, asked of two circles.
// example: unsupplied_tried(drawn.seeded(1), ir.little_library()).input != ""
fn unsupplied_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    standard := drawn.picked(draw, standards(), eq())
    circle := "Circle { radius: 1 }"
    source := asking(standard: standard, written: called(standard: standard, one: circle, other: circle)) + "\ntype Circle = {\n    radius: Int\n}\n"
    message := checking.message_of(checking.checked(source, library))
    if message != "`Circle` has no instance of `" + standard.of + "`" {
        return checking.Tried { input: source, why: "the refusal says " + held.quoted(message) }
    }
    checking.Tried { input: source, why: "" }
}

/// Every instance body the prelude writes has the type its trait gives it, and so does its name.
///
/// The methods are read once, and each case draws one of them.
// example: every_instance_body_of_the_prelude_has_the_type_its_trait_gives(2, ir.little_library()).cases == 2
fn every_instance_body_of_the_prelude_has_the_type_its_trait_gives(cases: Int, library: ir.Library) -> held.Held {
    methods := instance_methods(library)
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "every_instance_body_of_the_prelude_has_the_type_its_trait_gives", seed, method_tried(draw: drawn.seeded(seed), methods: methods, library: library))
    }
    found
}

/// A drawn instance method of the prelude, read where it writes its name and its value.
// example: method_tried(draw: drawn.seeded(1), methods: [], library: ir.little_library()).why == ""
fn method_tried(draw: drawn.Draw, methods: List<Method>, library: ir.Library) -> checking.Tried {
    if list.length(methods) == 0 {
        return checking.Tried { input: "", why: "" }
    }
    method := or(list.at(methods, drawn.number(draw, list.length(methods))), Method { written: nowhere(), leaves: nowhere(), declared: "", reads_as: "" })
    signature := checking.type_in(Ok(library.typed), method.written)
    value := checking.type_in(Ok(library.typed), method.leaves)
    if signature != method.declared || value != gives(method.declared) {
        return checking.Tried { input: method.reads_as, why: "the signature is " + signature + " and the value is " + value + ", not " + method.declared }
    }
    checking.Tried { input: method.reads_as, why: "" }
}

/// Every method every instance of the prelude writes, in the order the prelude writes them.
// example: list.length(instance_methods(ir.little_library())) >= 0
fn instance_methods(library: ir.Library) -> List<Method> {
    var found = []
    for item in library.typed.resolved.program.items {
        found = both(first: found, second: item_methods(item: item, traits: library.traits))
    }
    found
}

/// Each method `item` writes, where it is an instance, and none where it is not.
// example: list.length(item_methods(item: ast.Instance(ast.InstanceDeclaration { trait_name: named("Eq"), type_parameters: [], for_type: named("Int"), arguments: [], methods: [], span: nowhere() }), traits: [])) == 0
fn item_methods(item: ast.Item, traits: List<ast.TraitDeclaration>) -> List<Method> {
    match item {
        ast.Instance(of) => methods_of(of: of, traits: traits)
        _ => []
    }
}

/// Each method one instance writes: where it is, what its trait gives it, and what it reads as.
// example: list.length(methods_of(of: ast.InstanceDeclaration { trait_name: named("Eq"), type_parameters: [], for_type: named("Int"), arguments: [], methods: [], span: nowhere() }, traits: [])) == 0
fn methods_of(of: ast.InstanceDeclaration, traits: List<ast.TraitDeclaration>) -> List<Method> {
    standing := Standing { parameter: trait_parameter(of: of, traits: traits), settled: written_over(of) }
    var found = []
    for method in of.methods {
        declared := signature_text(signature: signature_of(of: of, traits: traits, method: method.name.text), standing: standing)
        found = list.push(found, Method { written: method.name.span, leaves: leaves(method), declared: declared, reads_as: of.trait_name.text + "<" + standing.settled + ">." + method.name.text })
    }
    found
}

/// The parameter of the trait `of` answers for, or `""` where the prelude declares no such trait.
// example: trait_parameter(of: ast.InstanceDeclaration { trait_name: named("Eq"), type_parameters: [], for_type: named("Int"), arguments: [], methods: [], span: nowhere() }, traits: []) == ""
fn trait_parameter(of: ast.InstanceDeclaration, traits: List<ast.TraitDeclaration>) -> String {
    for declaration in traits {
        if declaration.name.text == of.trait_name.text {
            return declaration.parameter.text
        }
    }
    ""
}

/// The signature the trait `of` answers for gives the method called `method`, where it has one.
// example: signature_text(signature: signature_of(of: ast.InstanceDeclaration { trait_name: named("Eq"), type_parameters: [], for_type: named("Int"), arguments: [], methods: [], span: nowhere() }, traits: [], method: "is_equal"), standing: Standing { parameter: "T", settled: "Int" }) == "no signature"
fn signature_of(of: ast.InstanceDeclaration, traits: List<ast.TraitDeclaration>, method: String) -> Option<ast.Signature> {
    for declaration in traits {
        if declaration.name.text == of.trait_name.text {
            return method_named(declaration: declaration, method: method)
        }
    }
    None
}

/// The signature `declaration` gives the method called `method`, where it declares one.
// example: signature_text(signature: method_named(declaration: ast.TraitDeclaration { name: named("Eq"), parameter: named("T"), methods: [], span: nowhere() }, method: "is_equal"), standing: Standing { parameter: "T", settled: "Int" }) == "no signature"
fn method_named(declaration: ast.TraitDeclaration, method: String) -> Option<ast.Signature> {
    for one in declaration.methods {
        if one.name.text == method {
            return Some(one)
        }
    }
    None
}

/// The type the instance is for, as it writes it: its name, and the arguments it writes.
// example: written_over(ast.InstanceDeclaration { trait_name: named("Eq"), type_parameters: [], for_type: named("List"), arguments: [named("T")], methods: [], span: nowhere() }) == "List<T>"
fn written_over(of: ast.InstanceDeclaration) -> String {
    if list.length(of.arguments) == 0 {
        return of.for_type.text
    }
    var written = []
    for one in of.arguments {
        written = list.push(written, one.text)
    }
    of.for_type.text + "<" + strings.join(written, ", ") + ">"
}

/// One trait method as text, with the trait's own parameter standing for the instance's type.
///
/// A method its trait does not declare is `no signature`, which no inferred type is.
// example: signature_text(signature: None, standing: Standing { parameter: "T", settled: "Int" }) == "no signature"
fn signature_text(signature: Option<ast.Signature>, standing: Standing) -> String {
    match signature {
        Some(one) => "(" + strings.join(parameter_texts(parameters: one.parameters, standing: standing), ", ") + ") -> " + result_text(result: one.result, standing: standing)
        None => "no signature"
    }
}

/// The type of each parameter as text, with `_` where a parameter states none.
// example: list.length(parameter_texts(parameters: [], standing: Standing { parameter: "T", settled: "Int" })) == 0
fn parameter_texts(parameters: List<ast.Parameter>, standing: Standing) -> List<String> {
    var texts = []
    for one in parameters {
        texts = list.push(texts, result_text(result: one.type_ref, standing: standing))
    }
    texts
}

/// A written type as text, and `()` where nothing is written.
// example: result_text(result: None, standing: Standing { parameter: "T", settled: "Int" }) == "()"
fn result_text(result: Option<ast.TypeRef>, standing: Standing) -> String {
    match result {
        Some(one) => standing_for(written: one, standing: standing)
        None => "()"
    }
}

/// One written type as text, with the trait's parameter standing for the instance's type.
// example: standing_for(written: ast.TypeRef { kind: ast.UnitType, span: nowhere() }, standing: Standing { parameter: "T", settled: "Int" }) == "()"
fn standing_for(written: ast.TypeRef, standing: Standing) -> String {
    match written.kind {
        ast.NamedType { path, arguments } => applied(name: name_standing(name: path.name.text, standing: standing), arguments: arguments, standing: standing)
        ast.UnitType => "()"
    }
}

/// The instance's type where `name` is the trait's parameter, and `name` where it is not.
// example: name_standing(name: "T", standing: Standing { parameter: "T", settled: "Int" }) == "Int"
// example: name_standing(name: "Bool", standing: Standing { parameter: "T", settled: "Int" }) == "Bool"
fn name_standing(name: String, standing: Standing) -> String {
    if name == standing.parameter {
        return standing.settled
    }
    name
}

/// `name` with `arguments` written after it in angle brackets, where it has any.
// example: applied(name: "Int", arguments: [], standing: Standing { parameter: "T", settled: "Int" }) == "Int"
fn applied(name: String, arguments: List<ast.TypeRef>, standing: Standing) -> String {
    if list.length(arguments) == 0 {
        return name
    }
    var texts = []
    for one in arguments {
        texts = list.push(texts, standing_for(written: one, standing: standing))
    }
    name + "<" + strings.join(texts, ", ") + ">"
}

/// Where the value `method` gives back is written, which is its last statement.
///
/// Every method the prelude writes leaves one expression, so where one does not, the stretch is
/// the method's name, which has the signature's type and not the value's.
// example: leaves(ast.FunctionDeclaration { name: named("f"), type_parameters: [], parameters: [], result: None, body: ast.Block { statements: [], span: nowhere() }, span: nowhere() }).start == -1
fn leaves(method: ast.FunctionDeclaration) -> lexer.Span {
    last := list.at(method.body.statements, list.length(method.body.statements) - 1)
    match last {
        Some(statement) => left_by(statement: statement, fallback: method.name.span)
        None => method.name.span
    }
}

/// The stretch of the value `statement` leaves, or `fallback` where it leaves none.
// example: left_by(statement: ast.Statement { kind: ast.Break, span: nowhere() }, fallback: nowhere()).start == -1
fn left_by(statement: ast.Statement, fallback: lexer.Span) -> lexer.Span {
    match statement.kind {
        ast.Evaluated(value) => value.span
        _ => fallback
    }
}

/// What a signature written as text gives back, which is the text after its first arrow.
// example: gives("(Bool) -> Int") == "Int"
fn gives(signature: String) -> String {
    arrow := checking.occurrence(signature, "-> ", 1)
    or(strings.cut(signature, arrow.start + 3, strings.length(signature)), "")
}

/// The methods of `first`, then those of `second`.
// example: list.length(both(first: [], second: [])) == 0
fn both(first: List<Method>, second: List<Method>) -> List<Method> {
    var found = first
    for one in second {
        found = list.push(found, one)
    }
    found
}

/// A name written nowhere, which a hand-built declaration of an example carries.
// example: named("Eq").text == "Eq"
fn named(text: String) -> ast.Name {
    ast.Name { text: text, span: nowhere() }
}

/// A stretch that is in no source.
// example: nowhere().start == -1
fn nowhere() -> lexer.Span {
    lexer.Span { start: -1, length: 0 }
}

/// A call of `standard`'s method over a module that derives it for the type `declared`.
///
/// A function that gives back a `Bool` is named as the question it answers.
// example: strings.length(deriving(standard: eq(), declared: record(["Int"]))) > 0
fn deriving(standard: Standard, declared: String) -> String {
    "fn " + named_for(standard) + "(one: Held, other: Held) -> " + standard.gives + " {\n    " + called(standard: standard, one: "one", other: "other") + "\n}\n\nderive " + standard.of + " for Held\n\n" + declared + "\n"
}

/// A module whose one function asks `written` of its standard trait, named as its answer asks.
// example: asking(standard: eq(), written: "is_equal(1, 2)") == "fn is_read() -> Bool {\n    is_equal(1, 2)\n}\n"
fn asking(standard: Standard, written: String) -> String {
    "fn " + named_for(standard) + "() -> " + standard.gives + " {\n    " + written + "\n}\n"
}

/// The name of a function that gives back what `standard` gives: a question for a `Bool`.
// example: named_for(eq()) == "is_read"
fn named_for(standard: Standard) -> String {
    if standard.gives == "Bool" {
        return "is_read"
    }
    "read"
}

/// The call of `standard`'s method over `one`, and over `other` where it takes two values.
// example: called(standard: eq(), one: "1", other: "2") == "is_equal(1, 2)"
fn called(standard: Standard, one: String, other: String) -> String {
    if standard.is_taking == TakesTwo {
        return standard.method + "(" + one + ", " + other + ")"
    }
    standard.method + "(" + one + ")"
}

/// The module both trait properties are drawn against, which compares two values of `of`.
///
/// `Point` is the one type it gives an instance to, so every other type is answered by the
/// prelude's instances or by nothing at all.
// example: strings.length(comparing("Int")) > 0
fn comparing(of: String) -> String {
    "fn is_same(one: " + of + ", other: " + of + ") -> Bool {\n    is_equal(one, other)\n}\n\ninstance Eq<Point> {\n    fn is_equal(one, other) -> Bool {\n        one.across == other.across\n    }\n}\n\ntype Point = {\n    across: Int\n}\n"
}

/// A record of the written fields, named `value0`, `value1`, and so on.
// example: record(["Int"]) == "type Held = {\n    value0: Int\n}"
fn record(fields: List<String>) -> String {
    var lines = ""
    var position = 0
    for field in fields {
        lines += "    value" + shown(position) + ": " + field + "\n"
        position += 1
    }
    "type Held = {\n" + lines + "}"
}

/// `count` drawn field types, each of which has every standard trait and needs no declaration.
// example: list.length(drawn_fields(draw: drawn.seeded(1), count: 3)) == 3
fn drawn_fields(draw: drawn.Draw, count: Int) -> List<String> {
    var fields = []
    var at = draw
    for list.length(fields) < count {
        fields = list.push(fields, drawn.picked(at, ["Int", "Bool", "String", "List<Int>"], "Int"))
        at = drawn.next(at)
    }
    fields
}

/// `fields` with `field` put in at the place `at`.
// example: inserted(fields: ["Int"], at: 0, field: "()") == ["()", "Int"]
fn inserted(fields: List<String>, at: Int, field: String) -> List<String> {
    var found = []
    var position = 0
    for one in fields {
        if position == at {
            found = list.push(found, field)
        }
        found = list.push(found, one)
        position += 1
    }
    if at == list.length(fields) {
        found = list.push(found, field)
    }
    found
}

/// The four standard traits, which `docs/specs/traits.md` declares.
// example: list.length(standards()) == 4
fn standards() -> List<Standard> {
    [eq(), Standard { of: "Ord", method: "is_less", is_taking: TakesTwo, gives: "Bool" }, Standard { of: "Hash", method: "hashed", is_taking: TakesOne, gives: "Int" }, Standard { of: "Show", method: "shown", is_taking: TakesOne, gives: "String" }]
}

/// The standard trait `Eq`.
// example: eq().of == "Eq"
fn eq() -> Standard {
    Standard { of: "Eq", method: "is_equal", is_taking: TakesTwo, gives: "Bool" }
}

/// Two values of each type the prelude supplies all four standard instances for.
// example: list.length(supplied()) == 3
fn supplied() -> List<Supplied> {
    [Supplied { one: "true", other: "false" }, Supplied { one: "1", other: "2" }, Supplied { one: "\"one\"", other: "\"two\"" }]
}

/// One standard trait: its name, its one method, how many values it takes, and what it gives.
type Standard = {
    of: String
    method: String
    is_taking: Taking
    gives: String
}

derive Eq for Taking

/// How many values a standard method takes.
type Taking =
    | TakesOne
    | TakesTwo

/// Two values of one type the prelude supplies.
type Supplied = {
    one: String
    other: String
}

/// One method one instance of the prelude writes: where it is, and what its trait says.
type Method = {
    written: lexer.Span
    leaves: lexer.Span
    declared: String
    reads_as: String
}

/// The trait's own parameter, and the type the instance settles it on, as the instance writes it.
type Standing = {
    parameter: String
    settled: String
}
