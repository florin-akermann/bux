// The drawn properties of how a body and a call are written, which `docs/specs/discarding.md`,
// `docs/specs/arguments.md`, and `docs/specs/naming.md` state, and the one rule of the tree.
//
// Each case draws a small module from a fixed seed and asks whether the type inference accepts it,
// in-process, against the prelude the compiler carries. A failure names the seed and the module.
// The rule of the tree is that only `library/` declares an `extern`, which
// `docs/implementation.md` section 3 states, and a failure names each file that breaks it.
import checking
import drawn
import files
import held
import ir
import lexer
import list
import modules
import walk

// `tests/spec/` is exempt: each example of `docs/specs/interop.md` declares an `extern`.
// example: held.is_held(only_the_library_has_an_extern("no-such-directory"))
// example: !held.is_held(only_the_library_has_an_extern("tests/spec/interop"))
fn only_the_library_has_an_extern(root: String) -> held.Held {
    let paths = held_to_the_library_rule(root)
    var found = held.nothing_failed(list.length(paths))
    for path in paths {
        if has_an_extern(ok_or(files.read(path), "")) {
            found = held.with_failure(found, path + " declares an extern, and docs/implementation.md section 3 lets only library/ declare one")
        }
    }
    found
}

// `target/` holds a copy of `library/`, and a dot directory holds no source, so neither is walked.
// example: list.length(held_to_the_library_rule("no-such-directory")) == 0
// example: list.has_value(held_to_the_library_rule("tests"), "tests/walk.bx")
// example: !list.has_value(held_to_the_library_rule("tests"), "tests/spec/interop/optional.bx")
fn held_to_the_library_rule(directory: String) -> List<String> {
    var found = []
    for name in ok_or(files.listed(listing_of(directory)), []) {
        let path = modules.joined(directory, name)
        if !files.is_directory(files.named(path)) {
            if walk.is_ending_in(name, ".bx") {
                found = list.push(found, path)
            }
        } else if is_walked(path: path, name: name) {
            for below in held_to_the_library_rule(path) {
                found = list.push(found, below)
            }
        }
    }
    found
}

// example: listing_of("") == "."
// example: listing_of("tests") == "tests"
fn listing_of(directory: String) -> String {
    if directory == "" {
        return "."
    }
    directory
}

// example: is_walked(path: "src", name: "src")
// example: !is_walked(path: "library", name: "library")
// example: !is_walked(path: "tests/spec", name: "spec")
// example: !is_walked(path: "target", name: "target")
// example: !is_walked(path: ".git", name: ".git")
fn is_walked(path: String, name: String) -> Bool {
    !list.has_value(["library", "tests/spec"], path) && name != "target" && !lexer.has_prefix(lexer.Rest { source: name, start: 0 }, ".")
}

// In canonical form an `extern` starts a line, so a check of each line start is enough.
// example: has_an_extern("fn now() -> Int {\n    1\n}\n\nextern static f() -> Int = \"a.B.c\"\n")
// example: !has_an_extern("// an `extern` is refused here\nfn now() -> Int {\n    1\n}\n")
fn has_an_extern(source: String) -> Bool {
    for line in walk.lines_of(source) {
        if lexer.has_prefix(lexer.Rest { source: line, start: 0 }, "extern ") {
            return true
        }
    }
    false
}

// example: held.is_held(a_statement_that_leaves_a_value_is_refused_above_the_last(2, ir.little_library()))
fn a_statement_that_leaves_a_value_is_refused_above_the_last(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "a_statement_that_leaves_a_value_is_refused_above_the_last", seed, above_tried(drawn.seeded(seed), library))
    }
    found
}

// example: above_tried(drawn.seeded(1), ir.little_library()).why == ""
fn above_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    let above = drawn.picked(draw, statements(), Left { written: "()", leaves: "()" })
    let source = body(result: "()", written: "    " + above.written + "\n    ()")
    let is_refused = !checking.is_accepted(source, library)
    if is_refused != (above.leaves != "()") {
        return checking.Tried { input: source, why: "refused is " + shown(is_refused) + " where it leaves " + above.leaves }
    }
    checking.Tried { input: source, why: "" }
}

// example: held.is_held(the_last_statement_is_the_value_given_back(2, ir.little_library()))
fn the_last_statement_is_the_value_given_back(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        let last = drawn.picked(drawn.seeded(seed), statements(), Left { written: "()", leaves: "()" })
        let source = body(result: last.leaves, written: "    " + last.written)
        found = checking.noted(found, "the_last_statement_is_the_value_given_back", seed, accepted_tried(source, library))
    }
    found
}

// example: held.is_held(an_underscore_makes_any_statement_compile(2, ir.little_library()))
fn an_underscore_makes_any_statement_compile(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        let thrown = drawn.picked(drawn.seeded(seed), statements(), Left { written: "()", leaves: "()" })
        let source = body(result: "()", written: "    _ = " + thrown.written + "\n    ()")
        found = checking.noted(found, "an_underscore_makes_any_statement_compile", seed, accepted_tried(source, library))
    }
    found
}

// example: held.is_held(a_repeated_type_is_called_by_name_only(2, ir.little_library()))
fn a_repeated_type_is_called_by_name_only(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "a_repeated_type_is_called_by_name_only", seed, repeated_tried(drawn.seeded(seed), library))
    }
    found
}

// example: repeated_tried(drawn.seeded(1), ir.little_library()).why == ""
fn repeated_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    let value = drawn.picked(draw, passable(), Left { written: "1", leaves: "Int" })
    let pair = Pair { first: value, second: value }
    let named = accepted_tried(taking(pair, named_call(pair)), library)
    if named.why != "" {
        return named
    }
    refused_tried(taking(pair, in_order_call(pair)), library)
}

// example: held.is_held(differing_types_are_called_either_way(2, ir.little_library()))
fn differing_types_are_called_either_way(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "differing_types_are_called_either_way", seed, differing_tried(drawn.seeded(seed), library))
    }
    found
}

// example: differing_tried(drawn.seeded(1), ir.little_library()).why == ""
fn differing_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    let pair = pair_drawn(draw)
    if pair.first.leaves == pair.second.leaves {
        return checking.Tried { input: pair.first.leaves, why: "" }
    }
    let named = accepted_tried(taking(pair, named_call(pair)), library)
    if named.why != "" {
        return named
    }
    accepted_tried(taking(pair, in_order_call(pair)), library)
}

// example: held.is_held(a_call_that_compiles_compiles_named(2, ir.little_library()))
fn a_call_that_compiles_compiles_named(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "a_call_that_compiles_compiles_named", seed, named_tried(drawn.seeded(seed), library))
    }
    found
}

// example: named_tried(drawn.seeded(1), ir.little_library()).why == ""
fn named_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    let pair = pair_drawn(draw)
    let in_order = taking(pair, in_order_call(pair))
    if !checking.is_accepted(in_order, library) {
        return checking.Tried { input: in_order, why: "" }
    }
    accepted_tried(taking(pair, named_call(pair)), library)
}

// example: pair_drawn(drawn.seeded(1)).first.leaves != ""
fn pair_drawn(draw: drawn.Draw) -> Pair {
    let first = drawn.picked(draw, passable(), Left { written: "1", leaves: "Int" })
    let second = drawn.picked(drawn.next(draw), passable(), Left { written: "1", leaves: "Int" })
    Pair { first: first, second: second }
}

// example: named_call(Pair { first: Left { written: "1", leaves: "Int" }, second: Left { written: "2", leaves: "Int" } }) == "takes(first: 1, second: 2)"
fn named_call(pair: Pair) -> String {
    "takes(first: " + pair.first.written + ", second: " + pair.second.written + ")"
}

// example: in_order_call(Pair { first: Left { written: "1", leaves: "Int" }, second: Left { written: "2", leaves: "Int" } }) == "takes(1, 2)"
fn in_order_call(pair: Pair) -> String {
    "takes(" + pair.first.written + ", " + pair.second.written + ")"
}

// example: taking(Pair { first: Left { written: "1", leaves: "Int" }, second: Left { written: "2", leaves: "Int" } }, "takes(1, 2)") == "fn main() -> Int {\n    takes(1, 2)\n}\n\nfn takes(first: Int, second: Int) -> Int {\n    _ = first\n    _ = second\n    1\n}\n"
fn taking(pair: Pair, call: String) -> String {
    "fn main() -> Int {\n    " + call + "\n}\n\nfn takes(first: " + pair.first.leaves + ", second: " + pair.second.leaves + ") -> Int {\n    _ = first\n    _ = second\n    1\n}\n"
}

// example: held.is_held(a_bool_parameter_compiles_only_in_an_all_bool_signature(2, ir.little_library()))
fn a_bool_parameter_compiles_only_in_an_all_bool_signature(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "a_bool_parameter_compiles_only_in_an_all_bool_signature", seed, flag_tried(drawn.seeded(seed), library))
    }
    found
}

// example: flag_tried(drawn.seeded(1), ir.little_library()).why == ""
fn flag_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    let takes = drawn_takes(draw)
    let gives = drawn.picked(checking.after(draw, 9), ["Bool", "Int"], "Int")
    let source = "fn is_open(" + parameters_of(takes) + ") -> " + gives + " {\n    todo(\"the body is not the point\")\n}\n"
    if !is_a_flag(takes: takes, gives: gives) {
        return accepted_tried(source, library)
    }
    let help = checking.help_of(checking.checked(source, library))
    if help != "declare a two-variant type and take that instead, so the call says which of the two" {
        return checking.Tried { input: source, why: "the help is " + held.quoted(help) }
    }
    checking.Tried { input: source, why: "" }
}

// example: list.length(drawn_takes(drawn.seeded(1))) < 5
fn drawn_takes(draw: drawn.Draw) -> List<String> {
    drawn.picked(draw, [[], ["Bool"], ["Int"]], [])
}

// example: is_a_flag(takes: ["Bool", "Int"], gives: "Bool")
// example: !is_a_flag(takes: ["Bool", "Bool"], gives: "Bool")
// example: !is_a_flag(takes: ["Int"], gives: "Bool")
fn is_a_flag(takes: List<String>, gives: String) -> Bool {
    list.has_value(takes, "Bool") && (list.has_value(takes, "Int") || gives != "Bool")
}

// example: parameters_of(["Bool", "Int"]) == "p0: Bool, p1: Int"
fn parameters_of(takes: List<String>) -> String {
    var written = ""
    for index in checking.numbers_below(list.length(takes)) {
        if index > 0 {
            written += ", "
        }
        written += "p" + shown(index) + ": " + or(list.at(takes, index), "")
    }
    written
}

// example: a_bool_function_compiles_where_its_name_asks(2, ir.little_library()).cases == 2
fn a_bool_function_compiles_where_its_name_asks(cases: Int, library: ir.Library) -> held.Held {
    var found = held.nothing_failed(cases)
    for seed in checking.seeds(cases) {
        found = checking.noted(found, "a_bool_function_compiles_where_its_name_asks", seed, question_tried(drawn.seeded(seed), library))
    }
    found
}

// example: question_tried(drawn.seeded(1), ir.little_library()).input != ""
fn question_tried(draw: drawn.Draw, library: ir.Library) -> checking.Tried {
    let opener = drawn.picked(draw, ["is_", "has_", "can_", "should_", "was_", ""], "")
    let word = drawn.picked(drawn.next(draw), ["active", "paid", "island"], "active")
    let gives = drawn.picked(checking.after(draw, 2), ["Bool", "Int"], "Int")
    var value = "count"
    if gives == "Bool" {
        value = "count > 1"
    }
    let source = "fn " + opener + word + "(count: Int) -> " + gives + " {\n    " + value + "\n}\n"
    let is_asking = list.has_value(["is_", "has_", "can_", "should_"], opener)
    if checking.is_accepted(source, library) != (is_asking || gives != "Bool") {
        return checking.Tried { input: source, why: "accepted is " + shown(checking.is_accepted(source, library)) }
    }
    checking.Tried { input: source, why: "" }
}

// example: accepted_tried("fn one() -> Int {\n    1\n}\n", ir.little_library()).why == ""
fn accepted_tried(source: String, library: ir.Library) -> checking.Tried {
    if checking.is_accepted(source, library) {
        return checking.Tried { input: source, why: "" }
    }
    checking.Tried { input: source, why: "refused: " + checking.message_of(checking.checked(source, library)) }
}

// example: refused_tried("fn one() -> Int {\n    \"one\"\n}\n", ir.little_library()).why == ""
fn refused_tried(source: String, library: ir.Library) -> checking.Tried {
    if checking.is_accepted(source, library) {
        return checking.Tried { input: source, why: "it is accepted" }
    }
    checking.Tried { input: source, why: "" }
}

// example: list.length(statements()) == 4
fn statements() -> List<Left> {
    [Left { written: "log(1)", leaves: "()" }, Left { written: "()", leaves: "()" }, Left { written: "save(1)", leaves: "Result<(), String>" }, Left { written: "1 == 2", leaves: "Bool" }]
}

// A `Bool` is a flag, so no `Bool` value is here.
// example: list.length(passable()) == 3
fn passable() -> List<Left> {
    [Left { written: "1", leaves: "Int" }, Left { written: "\"two\"", leaves: "String" }, Left { written: "Some(1)", leaves: "Option<Int>" }]
}

// The result is drawn and can be a `Bool`, so the function name asks a question.
// example: body(result: "()", written: "    ()") == "fn is_done() -> () {\n    ()\n}\n\nfn log(value: Int) -> () {\n    _ = save(value)\n}\n\nfn save(value: Int) -> Result<(), String> {\n    if value == 0 {\n        return Err(\"nothing to save\")\n    }\n    Ok(())\n}\n"
fn body(result: String, written: String) -> String {
    "fn is_done() -> " + result + " {\n" + written + "\n}\n\nfn log(value: Int) -> () {\n    _ = save(value)\n}\n\nfn save(value: Int) -> Result<(), String> {\n    if value == 0 {\n        return Err(\"nothing to save\")\n    }\n    Ok(())\n}\n"
}

type Pair = {
    first: Left
    second: Left
}

type Left = {
    written: String
    leaves: String
}

test "a statement that leaves a value is refused above the last" {
    held.is_held_reported(a_statement_that_leaves_a_value_is_refused_above_the_last(held.drawn_cases(), checking.carried_library()))
}

test "the last statement is the value given back" {
    held.is_held_reported(the_last_statement_is_the_value_given_back(held.drawn_cases(), checking.carried_library()))
}

test "an underscore makes any statement compile" {
    held.is_held_reported(an_underscore_makes_any_statement_compile(held.drawn_cases(), checking.carried_library()))
}

test "a repeated type is called by name only" {
    held.is_held_reported(a_repeated_type_is_called_by_name_only(held.drawn_cases(), checking.carried_library()))
}

test "differing types are called either way" {
    held.is_held_reported(differing_types_are_called_either_way(held.drawn_cases(), checking.carried_library()))
}

test "a call that compiles compiles named" {
    held.is_held_reported(a_call_that_compiles_compiles_named(held.drawn_cases(), checking.carried_library()))
}

test "a bool parameter compiles only in an all bool signature" {
    held.is_held_reported(a_bool_parameter_compiles_only_in_an_all_bool_signature(held.drawn_cases(), checking.carried_library()))
}

test "a bool function compiles where its name asks" {
    held.is_held_reported(a_bool_function_compiles_where_its_name_asks(held.drawn_cases(), checking.carried_library()))
}

test "only the library has an extern" {
    held.is_held_reported(only_the_library_has_an_extern(""))
}
