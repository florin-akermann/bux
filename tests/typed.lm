// A drawn module, parsed, resolved, and typed against a prelude, as the later phases take it.
//
// The properties of the exhaustiveness check, the holes, and the page each read a module of their
// own that imports nothing. Each is compiled as `demo`, which nothing they state depends on.
import ast

import infer

import lexer

import parser

import refusal

import resolver

import surface

import types

/// `source` typed as the module `demo` against `prelude`, and nothing where a phase refuses it.
// example: is_typed(inferred("fn f() -> Int {\n    1\n}\n", types.little_prelude()))
// example: !is_typed(inferred("fn (", types.little_prelude()))
fn inferred(source: String, prelude: types.Prelude) -> Option<infer.Inference> {
    match parser.parse(source) {
        Ok(program) => resolved_typed(program, prelude)
        Err(_) => None
    }
}

/// `program` resolved and typed, and nothing where either refuses it.
// example: is_typed(resolved_typed(ast.Program { items: [] }, types.little_prelude()))
fn resolved_typed(program: ast.Program, prelude: types.Prelude) -> Option<infer.Inference> {
    match resolver.resolve(program, "demo", prelude.names) {
        Ok(resolved) => typed_only(types.check(resolved, surface.nothing_imported(), prelude))
        Err(_) => None
    }
}

/// The typed module, and nothing where typing refuses it.
// example: !is_typed(typed_only(Err(refusal.TypeError { kind: refusal.DivisorIsZero, span: lexer.Span { start: 0, length: 1 } })))
fn typed_only(answer: Result<infer.Inference, refusal.TypeError>) -> Option<infer.Inference> {
    match answer {
        Ok(checked) => Some(checked)
        Err(_) => None
    }
}

/// Whether a module was typed.
// example: !is_typed(None)
fn is_typed(found: Option<infer.Inference>) -> Bool {
    match found {
        Some(_) => true
        None => false
    }
}
