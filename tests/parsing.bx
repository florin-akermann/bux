// The drawn properties of the parser, which `docs/specs/grammar.md` states, checked on drawn input.
//
// Three kinds of input are drawn: text that mostly fails to parse, a program of well-formed items,
// and one `extern` declaration. A span counts UTF-8 bytes, which `lexing` measures.
import ast
import drawn
import held
import lexer
import lexing
import list
import parser
import strings

// example: held.is_held(no_extern_declaration_writes_a_body(3))
fn no_extern_declaration_writes_a_body(cases: Int) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        let source = declaration(drawn.seed_of(case))
        let why = bodied_fault(source)
        if why != "" {
            found = held.with_failure(found, held.drawn_failure("no_extern_declaration_writes_a_body", drawn.seed_of(case), source, why))
        }
        case += 1
    }
    found
}

// example: bodied_fault("extern new opened(path: String) -> Int\n") == ""
// example: bodied_fault("fn f() {\n}\n") == "a declaration parses to a function"
fn bodied_fault(source: String) -> String {
    let parsed = match parser.parse(source) {
        Ok(program) => program
        Err(_) => ast.Program { items: [] }
    }
    if list.length(parsed.items) == 0 {
        return "a declaration does not parse: " + parser.printed(source)
    }
    if has_function(parsed) {
        return "a declaration parses to a function"
    }
    if is_parsed(without_the_last_line_break(source) + " {\n}\n") {
        return "a body written after a declaration parses"
    }
    ""
}

// example: !has_function(ast.Program { items: [] })
fn has_function(program: ast.Program) -> Bool {
    for declared in program.items {
        let is_function = match declared {
            ast.Function(_) => true
            _ => false
        }
        if is_function {
            return true
        }
    }
    false
}

// example: is_parsed("import io\n")
// example: !is_parsed("fn (")
fn is_parsed(source: String) -> Bool {
    match parser.parse(source) {
        Ok(_) => true
        Err(_) => false
    }
}

// example: without_the_last_line_break("a\n") == "a"
// example: without_the_last_line_break("a") == "a"
fn without_the_last_line_break(text: String) -> String {
    let last = strings.length(text) - 1
    if or(strings.at(text, last), 0) == 10 {
        return or(strings.cut(text, 0, last), text)
    }
    text
}

// example: strings.length(declaration(1)) > 0
fn declaration(seed: Int) -> String {
    let first = drawn.seeded(seed)
    let kind = drawn.number(first, 4)
    let second = drawn.next(first)
    let third = drawn.next(second)
    let fourth = drawn.next(third)
    let width = drawn.picked(second, ["", "int "], "")
    let name = drawn.picked(third, ["reached", "held_by", "opened", "int"], "")
    let result = drawn.picked(fourth, ["Bool", "Int", "String", "File", "()", "Option<File>", "Result<File, String>"], "")
    let class = drawn.picked(drawn.next(fourth), ["", "interface "], "")
    let member = or(list.at(["field ", "static ", "method ", "new "], kind), "") + width + name + or(list.at(["()", "(path: File)", "(file: File)", "(path: String)"], kind), "")
    let reached = or(list.at([" = \"java.lang.System.out\"", " = \"java.nio.file.Files.readString\"", " = \"toPath\"", ""], kind), "")
    "extern type " + class + "File = \"java.io.File\"\n\nextern " + member + " -> " + result + reached + "\n"
}

// example: held.is_held(parsing_is_deterministic(3))
fn parsing_is_deterministic(cases: Int) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        let source = drawn_text(drawn.seed_of(case))
        if parser.printed(source) != parser.printed(source) {
            found = held.with_failure(found, held.drawn_failure("parsing_is_deterministic", drawn.seed_of(case), source, "two parses disagree"))
        }
        case += 1
    }
    found
}

// example: held.is_held(an_error_span_is_not_empty_and_lies_within_the_source(3))
fn an_error_span_is_not_empty_and_lies_within_the_source(cases: Int) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        let source = drawn_text(drawn.seed_of(case))
        let why = error_span_fault(source)
        if why != "" {
            found = held.with_failure(found, held.drawn_failure("an_error_span_is_not_empty_and_lies_within_the_source", drawn.seed_of(case), source, why))
        }
        case += 1
    }
    found
}

// example: error_span_fault("fn (") == ""
// example: error_span_fault("import io\n") == ""
fn error_span_fault(source: String) -> String {
    match parser.parse(source) {
        Ok(_) => ""
        Err(refused) => span_fault(source, refused.span)
    }
}

// example: span_fault("é", lexer.Span { start: 1, length: 1 }) != ""
fn span_fault(source: String, span: lexer.Span) -> String {
    let boundaries = lexing.character_boundaries(source)
    if span.length <= 0 {
        return "the error span " + shown(span) + " is empty"
    }
    if !list.has_value(boundaries, span.start) || !list.has_value(boundaries, span.start + span.length) {
        return "the error span " + shown(span) + " is not on character boundaries"
    }
    ""
}

// example: strings.length(drawn_text(1)) > 0
fn drawn_text(seed: Int) -> String {
    let draw = drawn.seeded(seed)
    let count = drawn.number(draw, 41) + 8
    let opening = drawn.picked(drawn.next(draw), openings(), "")
    opening + drawn.text_of(drawn.next(drawn.next(draw)), pieces(), count)
}

// Each opening starts an item, so most texts go past the first item before they fail.
// example: list.length(openings()) == 8
fn openings() -> List<String> {
    ["", "fn f(a: Int) -> Int {\n", "type T = ", "extern ", "trait T<A> {\n", "fn g() {\n    match x {\n", "fn k() -> Int {\n    9223372036854775807 + ", "fn h() {\n    let x = \"é́​\"\n"]
}

// example: list.length(pieces()) == 47
fn pieces() -> List<String> {
    ["fn", "f", "x", "Int", "demo", "(", ")", "{", "}", "[", "]", "<", ">", ",", ":", "=", "let", "+=", "->", "=>", "|", ".", "?", "!", "-", "+", "*", "==", "&&", "match", "if", "else", "for", "in", "var", "return", "_", "static", "int", "1", "\"a\"", "\"\\q\"", "@", " ", "\n", "\n", "//\n"]
}

// example: held.is_held(a_well_formed_program_parses(3))
fn a_well_formed_program_parses(cases: Int) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        let chosen = chosen_items(drawn.seed_of(case))
        let source = strings.join(chosen, "\n\n")
        let count = list.length(or_nothing(parser.parse(source)).items)
        if count != list.length(chosen) {
            found = held.with_failure(found, held.drawn_failure("a_well_formed_program_parses", drawn.seed_of(case), source, "it parses to " + shown(count) + " items: " + held.quoted(parser.printed(source))))
        }
        case += 1
    }
    found
}

// example: held.is_held(item_spans_are_ordered_and_within_the_source(3))
fn item_spans_are_ordered_and_within_the_source(cases: Int) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        let source = strings.join(chosen_items(drawn.seed_of(case)), "\n\n")
        let why = item_spans_fault(source)
        if why != "" {
            found = held.with_failure(found, held.drawn_failure("item_spans_are_ordered_and_within_the_source", drawn.seed_of(case), source, why))
        }
        case += 1
    }
    found
}

// example: item_spans_fault("import io\n\nimport list") == ""
fn item_spans_fault(source: String) -> String {
    let length = lexing.byte_length(source)
    var previous_end = 0
    for declared in or_nothing(parser.parse(source)).items {
        let span = ast.extent_of(declared)
        let end = span.start + span.length
        if span.start < previous_end || span.length <= 0 || end > length {
            return "the item span " + shown(span) + " does not follow " + shown(previous_end) + " inside " + shown(length) + " bytes"
        }
        previous_end = end
    }
    ""
}

// example: list.length(or_nothing(parser.parse("fn (")).items) == 0
fn or_nothing(parsed: Result<ast.Program, parser.ParseError>) -> ast.Program {
    match parsed {
        Ok(program) => program
        Err(_) => ast.Program { items: [] }
    }
}

// example: held.is_held(a_test_inside_a_body_is_refused_at_its_word(3))
fn a_test_inside_a_body_is_refused_at_its_word(cases: Int) -> held.Held {
    var found = held.nothing_failed(cases)
    var case = 0
    for case < cases {
        let source = body_with_a_test(drawn.seed_of(case))
        let why = inner_test_fault(source)
        if why != "" {
            found = held.with_failure(found, held.drawn_failure("a_test_inside_a_body_is_refused_at_its_word", drawn.seed_of(case), source, why))
        }
        case += 1
    }
    found
}

// example: inner_test_fault("fn f() {\n    test \"a\" {\n        true\n    }\n}\n") == ""
fn inner_test_fault(source: String) -> String {
    let start = lexing.byte_length(before_the_test(source))
    let expected = shown(lexer.Span { start: start, length: 4 }) + " a test is written at the top level of a module, and this one is inside a body\nhelp: a test is an item of its own; write it below every declaration of the module\n"
    let printed = parser.printed(source)
    if printed != expected {
        return "the parser says " + held.quoted(printed)
    }
    ""
}

// example: before_the_test("ab test") == "ab "
fn before_the_test(source: String) -> String {
    var index = 0
    for index < strings.length(source) && !lexer.has_prefix(lexer.Rest { source: source, start: index }, "test") {
        index += 1
    }
    or(strings.cut(source, 0, index), "")
}

// example: strings.length(body_with_a_test(1)) > 0
fn body_with_a_test(seed: Int) -> String {
    let draw = drawn.seeded(seed)
    let statements = drawn.numbers(drawn.next(draw), drawn.number(draw, 5), list.length(statement_shapes()))
    let at = drawn.number(drawn.next(drawn.next(draw)), list.length(statements) + 1)
    var written = "fn f() {\n"
    var index = 0
    for shape in statements {
        if index == at {
            written += "    test \"inner\" {\n        true\n    }\n"
        }
        written += "    " + or(list.at(statement_shapes(), shape), "") + "\n"
        index += 1
    }
    if at == list.length(statements) {
        written += "    test \"inner\" {\n        true\n    }\n"
    }
    written + "}\n"
}

// example: list.length(statement_shapes()) == 4
fn statement_shapes() -> List<String> {
    ["let total = 1", "var count = 2", "count += 1", "_ = f(x: \"é\")"]
}

// example: list.length(chosen_items(1)) < 9
fn chosen_items(seed: Int) -> List<String> {
    let draw = drawn.seeded(seed)
    var chosen = []
    for index in drawn.numbers(drawn.next(draw), drawn.number(draw, 9), list.length(items())) {
        chosen = list.push(chosen, or(list.at(items(), index), ""))
    }
    chosen
}

// example: list.length(items()) == 10
fn items() -> List<String> {
    ["import io", "test \"adds up\" {\n    let total = 1 + 2\n    total == 3\n}", "type UserId = UserId(Int)", "type User = {\n    id: UserId\n}", "type Payment =\n    | Pending\n    | Failed(String)", "fn identity(x) {\n    x\n}", "fn named(a: Int) -> Int {\n    joined(first: a, second: a)\n}", "fn total(users: List<User>) -> Int {\n    var total = 0\n    for user in users {\n        total += 1\n    }\n    total\n}", "fn describe(p: Payment) -> String {\n    match p {\n        Pending =>\n            \"waiting\"\n\n        Failed(reason) =>\n            reason\n    }\n}", "fn pick(a: Int) -> Int {\n    if a > 1 {\n        return a\n    } else {\n        return 0\n    }\n}"]
}

test "no extern declaration writes a body" {
    held.is_held_reported(no_extern_declaration_writes_a_body(held.drawn_cases()))
}

test "parsing is deterministic" {
    held.is_held_reported(parsing_is_deterministic(held.drawn_cases()))
}

test "an error span is not empty and lies within the source" {
    held.is_held_reported(an_error_span_is_not_empty_and_lies_within_the_source(held.drawn_cases()))
}

test "a well formed program parses" {
    held.is_held_reported(a_well_formed_program_parses(held.drawn_cases()))
}

test "item spans are ordered and within the source" {
    held.is_held_reported(item_spans_are_ordered_and_within_the_source(held.drawn_cases()))
}

test "a test inside a body is refused at its word" {
    held.is_held_reported(a_test_inside_a_body_is_refused_at_its_word(held.drawn_cases()))
}
