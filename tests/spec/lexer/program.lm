// Every token class of the version 0.1 surface, in a program shape.
import io

fn describe(payment: Payment) -> String {
    match payment {
        Pending => "Waiting"
        Failed(reason) => "Failed: \"" + reason + "\""
    }
}

type Payment =
    | Pending
    | Failed(String)

fn count_active(users: List<User>, limit: Int) -> Result<Int, String> {
    var total = 0
    for user in users {
        if !user.active || total >= limit {
            continue
        } else {
            total += 1
        }
        if total * 2 % 3 != 1 && total <= 100 {
            break
        }
    }
    first := first_user(users)?
    if first.id == UserId(-7) {
        return Err("bad id")
    }
    Ok(total / 1 - 0)
}

fn first_user(users: List<User>) -> Result<User, String> {
    for user in users {
        return Ok(user)
    }
    Err("no users")
}

fn active(user: User) -> Bool {
    if user.active {
        return true
    }
    false
}

type User = {
    id: UserId
    active: Bool
}

type UserId = UserId(Int)
