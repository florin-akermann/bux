// A module builds what it likes, and offers what the modules importing it can name.
// example: name_of(wrapped(name: "world")) == "world"
fn wrapped(name: String) -> Held {
    Held(name)
}

// `Held` derives no `Eq`, so an example reads the name back out of it.
// example: name_of(Held("world")) == "world"
fn name_of(wrapping: Held) -> String {
    match wrapping {
        Held(name) => name
    }
}

// example: held(value: 1) == 1
fn held<T>(value: T) -> T {
    value
}

// A trait this module declares is this module's own, and so is the constraint written over it.
// example: labelled(value: "a") == "a"
fn labelled<T: Named<T>>(value: T) -> String {
    named_as(value)
}

instance Named<String> {
    fn named_as(value: String) -> String {
        value
    }
}

trait Named<T> {
    fn named_as(value: T) -> String
}

type Held = Held(String)

type User = {
    id: Int
    name: String
}

type Payment =
    | Sent(String)
    | Pending
