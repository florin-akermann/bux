// The version 0.1 grammar in a program shape: items, types, matching, and loops.
import io

fn describe(payment: Payment) -> String {
    match payment {
        Pending => "Waiting"
        Authorized { authorization_id } => "Authorized: " + authorization_id
        Failed(reason) => "Failed: \"" + reason + "\""
    }
}

type Payment =
    | Pending
    | Authorized {
        authorization_id: String
    }
    | Failed(String)

fn count_active<T>(users: List<User>, limit: Int) -> Result<Int, String> {
    var total = 0
    for user in users {
        if !user.active || total >= limit {
            continue
        } else {
            total += 1
        }
        if or(total * 2 % 3, 0) != 1 {
            break
        }
    }
    let first = first_user(users)?
    if identifier(first) == -7 {
        return Err("bad id")
    }
    let renamed = first { active: false }
    if renamed.active {
        io.println("still active")
    }
    Ok(or(total / 1, 0) - 0)
}

fn identifier(user: User) -> Int {
    match user.id {
        UserId(raw) => raw
    }
}

fn first_user(users: List<User>) -> Result<User, String> {
    for user in users {
        return Ok(user)
    }
    Err("no users")
}

type User = {
    id: UserId
    active: Bool
}

type UserId = UserId(Int)

fn forever() -> () {
    for {
        return ()
    }
}
