// Every expression form of version 0.1, each with the type inference gives it.
type UserId = UserId(Int)

type User = {
    id: UserId
    active: Bool
}

type Payment =
    | Pending
    | Authorized {
        authorization_id: String
    }
    | Failed(String)

fn describe(payment: Payment) -> String {
    match payment {
        Pending => "waiting"
        Authorized { authorization_id } => "authorized: " + authorization_id
        Failed(reason) => "failed: " + reason
    }
}

fn first_user(users: List<User>) -> Result<User, String> {
    for user in users {
        return Ok(user)
    }
    Err("no users")
}

fn count_active(users: List<User>, limit: Int) -> Result<Int, String> {
    var total = 0
    for user in users {
        if !user.active || total >= limit {
            continue
        } else {
            total += 1
        }
    }
    first := first_user(users)?
    if first.id == UserId(-7) {
        return Err("bad id")
    }
    renamed := first { active: false }
    if renamed.active {
        return Ok(0)
    }
    Ok(total)
}
