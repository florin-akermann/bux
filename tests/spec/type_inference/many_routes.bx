// Each record here holds the next one twice, so there are two to the power of 24 routes down.
// A search for a ring goes into each record once, rather than once for each route to it.
// Nothing here is a ring, so the module compiles, and it does so at once.
fn counted(held: Held0) -> Int {
    held.count
}

type Held0 = {
    count: Int
    one: Held1
    two: Held1
}

