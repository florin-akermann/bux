// Every expression form of version 0.1, each with the type inference gives it.
fn describe(payment: Payment) -> String {
    match payment {
        Pending => "waiting"
        Authorized { authorization_id } => "authorized: " + authorization_id
        Failed(reason) => "failed: " + reason
    }
}

type Payment =
    | Pending
    | Authorized {
        authorization_id: String
    }
    | Failed(String)

fn count_active(users: List<User>, limit: Int) -> Result<Int, String> {
    var total = 0
    for user in users {
        if !user.active || total >= limit {
            continue
        } else {
            total += 1
        }
    }
    let first = first_user(users)?
    if identifier(first) == -7 {
        return Err("bad id")
    }
    let renamed = first { active: false }
    if renamed.active {
        return Ok(0)
    }
    Ok(total)
}

fn identifier(user: User) -> Int {
    match user.id {
        UserId(raw) => raw
    }
}

fn first_user(users: List<User>) -> Result<User, String> {
    for user in users {
        return Ok(user)
    }
    Err("no users")
}

type User = {
    id: UserId
    active: Bool
}

type UserId = UserId(Int)
