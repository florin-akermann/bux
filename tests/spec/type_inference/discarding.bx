// Throwing a value away is written, so a reader greps `_ = ` for everything a function ignores.
fn main(values: List<Int>) -> () {
    _ = save(0)
    for value in values {
        _ = save(value)
    }
    log(1)
}

fn log(value: Int) -> () {
    _ = save(value)
}

fn save(value: Int) -> Result<(), String> {
    if value < 0 {
        return Err("a count is never below zero")
    }
    Ok(())
}
