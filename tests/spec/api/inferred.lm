// A signature is written where it documents a boundary, and inference does the rest.
// `lumen api` prints the type each name has, so a page reads the same either way.
// `kept` is the one case nothing settles, and the page says so with `_`.
fn go() -> Int {
    twice(3)
}

fn twice(n) {
    n + n
}

fn kept(value) {
    value
}
