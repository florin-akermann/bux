// expect-error: L0418
// A constrained generic used at a type with no instance is refused where it is used.
fn main(arguments: List<String>) -> Int {
    if has_value([Point { across: 1 }], Point { across: 2 }) {
        return 0
    }
    0
}

// example: has_value([1, 2], 2)
fn has_value<T: Eq<T>>(items: List<T>, value: T) -> Bool {
    for item in items {
        if is_equal(item, value) {
            return true
        }
    }
    false
}

type Point = {
    across: Int
}
