// expect-error: L0309
// An instance writes a body for every method its trait declares, and for no other name.
fn main() -> () {
    if covered(Square { side: 2 }) == 4 {
        return ()
    }
    ()
}

instance Area<Square> {
    fn around(shape: Square) -> Int {
        4 * shape.side
    }
}

trait Area<T> {
    fn covered(shape: T) -> Int
}

type Square = {
    side: Int
}
