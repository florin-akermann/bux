// expect-error: L0422
// A type derives `Eq` and holds a `List<Crate>`, whose element type has none, so it is refused.
fn main(arguments: List<String>) -> Int {
    let basket = Basket { crates: [Crate { size: 1 }] }
    if basket == basket {
        return 0
    }
    0
}

derive Eq for Basket

type Basket = {
    crates: List<Crate>
}

type Crate = {
    size: Int
}
