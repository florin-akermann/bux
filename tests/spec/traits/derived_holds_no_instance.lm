// expect-error: L0422
// A type derives `Eq` and holds a `List<Int>`, which has none, so the derive is refused.
fn main(arguments: List<String>) -> Int {
    basket := Basket { tags: [1] }
    if basket == basket {
        return 0
    }
    0
}

derive Eq for Basket

type Basket = {
    tags: List<Int>
}
