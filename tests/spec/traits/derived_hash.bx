// expect-run
// > two users of the same state hash alike
// > two pending payments hash alike
// > two failures with the same reason hash alike
// A record and a variant each derive `Hash`, and equal values hash alike.
import io

fn main(arguments: List<String>) -> Int {
    let ada = User { id: 1, name: "ada" }
    let also_ada = User { id: 1, name: "ada" }
    if hashed(ada) == hashed(also_ada) {
        io.println("two users of the same state hash alike")
    }
    if hashed(Pending) == hashed(Pending) {
        io.println("two pending payments hash alike")
    }
    if hashed(Failed("late")) == hashed(Failed("late")) {
        io.println("two failures with the same reason hash alike")
    }
    0
}

derive Eq, Hash for User

type User = {
    id: Int
    name: String
}

derive Eq, Hash for Payment

type Payment =
    | Pending
    | Failed(String)
