// A module of the package with a test that does not hold, so `bux test` on the package reports it
// after what the modules before it said, and counts the tests and the examples of both modules.
// Three times `number`.
// example: tripled(2) == 6
fn tripled(number: Int) -> Int {
    number * 3
}

test "triples zero" {
    tripled(0) == 0
}

test "triples one" {
    tripled(1) == 4
}
