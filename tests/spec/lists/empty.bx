// expect-run
// > nothing was picked
// A list of nothing is written `[]`, and it takes the type of the place it is written.
// Walking one runs the body no times at all, which is what this program shows.
import io

fn main(arguments: List<String>) -> Int {
    if is_empty(picked()) {
        io.println("nothing was picked")
    }
    0
}

// example: is_empty(picked())
fn picked() -> List<String> {
    []
}

// example: is_empty([])
// example: !is_empty(["a"])
fn is_empty(fruit: List<String>) -> Bool {
    var held = false
    for _ in fruit {
        held = true
    }
    !held
}
