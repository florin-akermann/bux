// expect-run
// > at 0 it holds 1
// > at 4294967296 it holds nothing
// > at -4294967296 it holds nothing
// An index is an `Int`, and a list is never longer than an `int` can count.
// An index past that range holds nothing, however its low 32 bits read.
// `4294967296` is `0` in its low 32 bits, so a read that cut the index would find the `1`.
import io

import list

fn main(arguments: List<String>) -> Int {
    values := [1, 2, 3]
    io.println("at 0 it holds " + read_at(values, 0))
    io.println("at 4294967296 it holds " + read_at(values, 4294967296))
    io.println("at -4294967296 it holds " + read_at(values, -4294967296))
    0
}

/// What the list holds at `index`, as a word, and `nothing` where it holds none there.
// example: read_at([1], 0) == "1"
// example: read_at([1], 4294967296) == "nothing"
fn read_at(values: List<Int>, index: Int) -> String {
    match list.at(values, index) {
        Some(value) => shown(value)
        None => "nothing"
    }
}
