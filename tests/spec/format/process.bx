// Canonical form writes a process as it writes an instance, and one space after `spawn`.
fn main(arguments: List<String>) -> Int {
    let counting = spawn Counter(10)
    _ = send(counting, Add(3), NoLimit)
    _ = send(counting, Stop, NoLimit)
    ended(counting) - 13
}

/// A total that each `Add` grows, and that `Stop` ends.
process Counter {
    fn start(initial: Int) -> Int {
        initial
    }

    fn receive(total: Int, message: Counted) -> Next<Int> {
        match message {
            Add(amount) => Continue(total + amount)
            Stop => Done
        }
    }
}

/// What a counter is sent.
type Counted =
    | Add(Int)
    | Stop
