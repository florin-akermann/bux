import   io
import files
type UserId=UserId(Int)
type Payment = | Pending | Authorized { id: String } | Failed(String)
type User = { id:UserId
active:Bool }
fn describe(payment:Payment)->String{

    match payment{
        Pending =>
            "Waiting"

        Authorized{id} => "Authorized: "+id
        Failed(reason)=>reason
    }

}
fn total(users:List<User>,limit:Int,current:User)->Int{
var seen=0
for user in users{
if !user.active||seen>=limit{continue}else{seen+=1}
}
if (current { active: true }).active {
seen = (seen + 1) * 2
}
seen
}
