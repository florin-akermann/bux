// expect-error: L0500
// A match that has not been told what to do with a variant is refused.
fn describe(payment: Payment) -> String {
    match payment {
        Pending => "waiting"
        Authorized { authorization_id } => "authorized: " + authorization_id
    }
}

type Payment =
    | Pending
    | Authorized {
        authorization_id: String
    }
    | Failed(String)
