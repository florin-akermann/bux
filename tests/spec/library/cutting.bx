// expect-run
// > ell
// > nothing there
// `strings.cut` gives the part of a text from one index up to but not including another.
// It gives `None` where the part asked for is not inside the text, which is what the second line
// shows: nothing about an index outside the text fails, and nothing about it panics.
import io
import strings

fn main(arguments: List<String>) -> Int {
    io.println(or(strings.cut("hello", 1, 4), "nothing there"))
    io.println(or(strings.cut("hello", 1, 9), "nothing there"))
    0
}
