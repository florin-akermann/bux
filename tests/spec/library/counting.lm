// expect-run
// > 3
// > 2
// > 0
// `list` is a module of the library the compiler carries, and `list.length` is the compiler's.
// A call of it is written out where it stands as a read of the length the list holds, whatever
// the type of the values, so these three uses ask `list` for no method at all.
import io

import list

fn main(arguments: List<String>) -> Int {
    io.println(shown(list.length([1, 2, 3])))
    io.println(shown(list.length(["one", "two"])))
    io.println(shown(length(kept())))
    0
}

// A list of a type this module declares settles the type parameter on that type.
// example: length(kept()) == 0
fn length(values: List<Kept>) -> Int {
    list.length(values)
}

/// No kept value at all, which is the empty list at a type this module declares.
// example: list.length(kept()) == 0
fn kept() -> List<Kept> {
    []
}

type Kept = Kept(String)
