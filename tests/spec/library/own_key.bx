// expect-run
// > 36
// > none
// > true
// > true
// > 1
// A library generic is written once per set of types it is used at, by the module that declares
// it, and each constraint it writes over a key is answered by the instance that key's own type
// has. `Kept` is this module's, and so are the `Eq` and the `Hash` this module derives for it, so
// `map` writes `insert$main$Kept$Int` and that method calls `main.Eq$Kept$is_equal`.
import io
import list
import map
import set

fn main(arguments: List<String>) -> Int {
    let ages = map.insert(map.insert(map.empty(), Kept("ada"), 36), Kept("alan"), 41)
    io.println(shown(or(map.get(ages, Kept("ada")), 0)))
    io.println(named(map.get(ages, Kept("grace"))))
    let seen = set.insert(set.insert(set.empty(), Kept("a")), Kept("a"))
    io.println(shown(set.has_value(seen, Kept("a"))))
    io.println(shown(list.has_value([Kept("a"), Kept("b")], Kept("b"))))
    io.println(shown(or(list.index_of([Kept("a"), Kept("b")], Kept("b")), 0)))
    0
}

/// The age as it is written, and `none` where the map holds no entry at that key.
// example: named(None) == "none"
fn named(age: Option<Int>) -> String {
    match age {
        Some(held) => shown(held)
        None => "none"
    }
}

derive Eq, Hash for Kept

type Kept = Kept(String)
