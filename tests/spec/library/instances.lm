// expect-error: L0424
// A trait and its instances stay in the module that declares them, so a constraint a library
// function writes over its type parameter is answered where that function is written.
// The `Eq` this module derives is this module's own, and `list` reaches none of it.
import io

import list

fn main(arguments: List<String>) -> Int {
    if list.has_value([Kept("a")], Kept("a")) {
        io.println("kept")
    }
    0
}

derive Eq for Kept

type Kept = Kept(String)
