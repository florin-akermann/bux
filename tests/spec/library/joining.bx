// expect-run
// > to-be-joined
// The library is Bux source the compiler carries, so an import of one of its modules reaches
// that source rather than a file. `docs/specs/library.md` says nothing is looked for beside the
// importing file, which is why this example needs no second file next to it.
import io
import strings

fn main(arguments: List<String>) -> Int {
    io.println(strings.join(["to", "be", "joined"], "-"))
    0
}
