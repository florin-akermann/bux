// expect-run
// > nothing, boxed
// A `()` given to a declared type a type parameter left open, which holds a reference.
import io

fn main(arguments: List<String>) -> Int {
    if is_boxed(Boxed { held: () }) && is_held(Held(())) {
        io.println("nothing, boxed")
    }
    0
}

// example: is_boxed(Boxed { held: () })
fn is_boxed(boxed: Boxed<()>) -> Bool {
    is_given(boxed.held)
}

// example: is_held(Held(()))
fn is_held(box: Box<()>) -> Bool {
    match box {
        Held(inside) => is_given(inside)
    }
}

// example: is_given(())
fn is_given(given: ()) -> Bool {
    _ = given
    true
}

type Boxed<T> = {
    held: T
}

type Box<T> = Held(T)
