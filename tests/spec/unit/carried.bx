// expect-run
// > carried through a Result
// A `()` a `Result` carries, which it holds as a reference.
import io

fn main(arguments: List<String>) -> Int {
    if is_saved() {
        io.println("carried through a Result")
    }
    0
}

/// Whether the `()` a `Result` carries survives a `?`.
// example: is_saved()
fn is_saved() -> Bool {
    match saved() {
        Ok(inside) => is_given(inside)
        Err(why) => why == ""
    }
}

/// A `()` carried through a `?` and put back in an `Ok`.
// example: is_saved()
fn saved() -> Result<(), String> {
    inside := kept()?
    Ok(inside)
}

/// A `()` in an `Ok`.
// example: is_saved()
fn kept() -> Result<(), String> {
    Ok(())
}

/// Nothing is given, and there is nothing to say about it but that it arrived.
// example: is_given(())
fn is_given(given: ()) -> Bool {
    true
}
