// expect-run
// > carried through a Result
// A `()` a `Result` carries, which it holds as a reference.
import io

fn main(arguments: List<String>) -> Int {
    if is_saved() {
        io.println("carried through a Result")
    }
    0
}

// example: is_saved()
fn is_saved() -> Bool {
    match saved() {
        Ok(inside) => is_given(inside)
        Err(why) => why == ""
    }
}

// example: is_saved()
fn saved() -> Result<(), String> {
    let inside = kept()?
    Ok(inside)
}

// example: is_saved()
fn kept() -> Result<(), String> {
    Ok(())
}

// example: is_given(())
fn is_given(given: ()) -> Bool {
    _ = given
    true
}
