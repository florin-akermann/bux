// expect-run
// > one and two
// > and three
// A program reaches the console through `io`, which is a module of the library.
import io

fn main() -> () {
    io.print("one")
    io.print(" and ")
    io.println("two")
    io.println(joined(word: "three"))
}

// example: joined(word: "three") == "and three"
fn joined(word: String) -> String {
    "and " + word
}
