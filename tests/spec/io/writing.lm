// expect-run
// > one and two
// > and three
// A program reaches the console through `io`, which the compiler supplies.
import io

fn main() -> () {
    io.print("one")
    io.print(" and ")
    io.println("two")
    io.println(joined(word: "three"))
}

fn joined(word: String) -> String {
    "and " + word
}
