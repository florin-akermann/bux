// expect-run
// > one.txt
// > two.txt
// A directory is made, written into, and listed.
// A listing is a `List<String>`, which a `for` loop reads, and the names come back in order, so a
// listing reads the same however a file system holds them.
import files
import io
import list

fn main(arguments: List<String>) -> Int {
    match names("box") {
        Ok(found) => each_on_a_line(found)
        Err(why) => io.println(why)
    }
    0
}

fn each_on_a_line(found: List<String>) -> () {
    for name in found {
        io.println(name)
    }
}

// example: list.length(ok_or(names(""), [])) == 0
fn names(at: String) -> Result<List<String>, String> {
    match files.made(at) {
        Ok(made) => the_later_name_first(made)
        Err(why) => Err(why)
    }
}

// example: list.length(ok_or(the_later_name_first("no-such-directory"), [])) == 0
fn the_later_name_first(at: String) -> Result<List<String>, String> {
    match files.write(at + "/two.txt", "two") {
        Ok(_) => the_earlier_name_second(at)
        Err(why) => Err(why)
    }
}

// example: list.length(ok_or(the_earlier_name_second("no-such-directory"), [])) == 0
fn the_earlier_name_second(at: String) -> Result<List<String>, String> {
    match files.write(at + "/one.txt", "one") {
        Ok(_) => files.listed(at)
        Err(why) => Err(why)
    }
}
