// expect-run
// > the read failed and said why
// A read is written wherever an expression is, with a larger one already part worked out.
import files

import io

fn main() -> () {
    match wrapped() {
        Some(result) => io.println(told(result: result))
        None => io.println("nothing")
    }
}

// example: told(result: or(wrapped(), Ok(""))) == "the read failed and said why"
fn wrapped() -> Option<Result<String, String>> {
    Some(files.read("no-such-file.txt"))
}

// example: told(result: Ok("a line")) == "a line"
fn told(result: Result<String, String>) -> String {
    match result {
        Ok(text) => text
        Err(why) => said(why: why)
    }
}

// example: said(why: "") == "the read failed and said nothing"
fn said(why: String) -> String {
    if why == "" {
        "the read failed and said nothing"
    } else {
        "the read failed and said why"
    }
}
