// A record and an algebraic data type, each declared over a type parameter of its own.
fn unwrap(boxed: Box<Int>) -> Int {
    boxed.value
}

fn refill(boxed: Box<String>) -> Box<String> {
    boxed { value: "new" }
}

type Box<T> = {
    value: T
}

fn root(tree: Tree<Int>) -> Int {
    match tree {
        Leaf => 0
        Branch { value } => value
    }
}

fn planted(word: String) -> Tree<String> {
    Branch { value: word, left: Leaf }
}

type Tree<T> =
    | Leaf
    | Branch {
        value: T
        left: Tree<T>
    }
