// Parametric polymorphism: one declaration used at a type of its own each time.
fn go(words: List<String>) -> String {
    let number = identity(1)
    let word = identity("two")
    let nothing = none_of()
    let counted = unwrap_or(nothing, number)
    let named = unwrap_or(nothing, word)
    let found = unwrap_or(first_of(words), named)
    if counted > 0 {
        return found
    }
    word
}

fn identity<T>(value: T) -> T {
    value
}

fn none_of<T>() -> Option<T> {
    None
}

fn unwrap_or<T>(value: Option<T>, fallback: T) -> T {
    match value {
        Some(inner) => inner
        None => fallback
    }
}

fn first_of<T>(items: List<T>) -> Option<T> {
    for item in items {
        return Some(item)
    }
    None
}
