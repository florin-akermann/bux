// expect-error: L0433
// A dot after a value reads a field, so a call is never written with its first argument in front.
// The `help:` shows the plain call, `described(count, "apples")`, with every argument inside.
import io

fn main(arguments: List<String>) -> Int {
    count := 3
    io.println(count.described("apples"))
    0
}

/// How many of something there are, as a line a reader reads.
// example: described(count: 3, said: "apples") == "3 apples"
fn described(count: Int, said: String) -> String {
    shown(count) + " " + said
}
