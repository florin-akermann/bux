// expect-run
// > Payment(3)
// > 7
// Every function in scope takes the form with its first argument in front, as `calls.md` states.
// A trait method and a constructor are functions like any other, so each takes it.
import io

fn main(arguments: List<String>) -> Int {
    count := 3
    io.println(count.Payment().shown())
    io.println(shown(Payment(7).amount()))
    0
}

// example: amount(Payment(2)) == 2
fn amount(payment: Payment) -> Int {
    match payment {
        Payment(held) => held
    }
}

derive Show for Payment

type Payment = Payment(Int)
