// expect-run
// A named call passes its arguments in order like any other, and says what that order is.
fn main() -> () {
    shorter := rename(from: "old", to: "new")
    wider := repeat(word: "ha", times: 3)
    apart := label("done", 1)
    kept := pair(first: shorter, second: wider)
    _ = apart
    _ = kept
    ()
}

fn rename(from: String, to: String) -> String {
    from + to
}

fn repeat(word: String, times: Int) -> String {
    var said = ""
    var left = times
    for left > 0 {
        said = said + word
        left += -1
    }
    said
}

/// The parameter types differ, so this call is written either way and is written in order here.
fn label(text: String, count: Int) -> String {
    text
}

/// A type parameter counts as a type, so `pair` repeats one and every call of it names them.
fn pair<T>(first: T, second: T) -> T {
    first
}
