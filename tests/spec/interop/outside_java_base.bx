// expect-error: L0434
// An `extern` names a class of `java.base` on the list, or a class in an archive the package
// states. `javax.naming.InitialContext` is in `java.naming`, which is not `java.base`, and this
// package states no archive, so the class is refused where the declaration names it.
import io

fn main(arguments: List<String>) -> Int {
    match context() {
        Ok(_) => io.println("a naming context")
        Err(why) => io.println(why)
    }
    0
}

extern new context() -> Result<Context, String>

extern type Context = "javax.naming.InitialContext"
