// expect-run
// > no such variable
// A result declared `Option<T>` reads the reference the member gives back.
// `System.getenv` gives back `null` for a name the environment does not hold, and a `null` is
// `None`. Nothing in the program says `null`, and nothing in it could.
import io

fn main() -> () {
    io.println(told(name: "LUMEN_NO_SUCH_VARIABLE"))
}

// example: told(name: "LUMEN_NO_SUCH_VARIABLE") == "no such variable"
fn told(name: String) -> String {
    match environment(name) {
        Some(value) => value
        None => "no such variable"
    }
}

extern static environment(name: String) -> Option<String> = "java.lang.System.getenv"
