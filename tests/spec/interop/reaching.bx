// expect-run
// > reached through a declaration of its own
// An `extern` declaration names one member of one Java class and gives it a Bux signature.
// A program writes its own where the library has none, and this one writes what `io` writes.
// Nothing about the call is special: `put_line` is a function of this module like any other.
fn main(arguments: List<String>) -> Int {
    put_line(out(), "reached through a declaration of its own")
    0
}

extern method put_line(stream: PrintStream, text: String) -> () = "println"

extern field out() -> PrintStream = "java.lang.System.out"

extern type PrintStream = "java.io.PrintStream"
