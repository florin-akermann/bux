// expect-error: L0425
// A `List` crosses as a parameter and never as a result. A list a member gives back is a JVM
// object that member may still reach through and change, and a Bux value is never that.
fn main() -> () {
    _ = a_list_of("one")
}

extern static a_list_of(value: String) -> List<String> = "java.util.List.of"
