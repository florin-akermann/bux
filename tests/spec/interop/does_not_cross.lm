// expect-error: L0425
// A parameter and a result are types a Java member's own descriptor names, and a record a
// program declares is not one of them. What a declaration cannot say is not reachable, and the
// answer is another declaration that names a type which crosses.
fn main(arguments: List<String>) -> Int {
    _ = written(User { name: "one" })
    0
}

extern static written(user: User) -> String = "java.lang.String.valueOf"

type User = {
    name: String
}
