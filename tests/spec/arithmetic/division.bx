// expect-run
// > 17 / 5 is Some(3)
// > 17 / 0 is None
// > 17 % 5 is Some(2)
// > 17 % 0 is None
// > 17 scaled by 5 is 11
// > 17 scaled by 0 is None
// `/` and `%` give an `Option<Int>`, so a zero divisor is answered rather than thrown.
// A zero written as a divisor is refused where it is written, so each one arrives as a value.
// Each line is written only where the answer is the one it claims, so the header above is
// checked rather than asserted: a wrong answer writes a different line and the harness says so.
import io

fn main(arguments: List<String>) -> Int {
    io.println(answered(claim: "17 / 5 is Some(3)", answer: divided(of: 17, by: 5), wanted: 3))
    io.println(nothing(claim: "17 / 0 is None", answer: divided(of: 17, by: 0)))
    io.println(answered(claim: "17 % 5 is Some(2)", answer: leftover(of: 17, by: 5), wanted: 2))
    io.println(nothing(claim: "17 % 0 is None", answer: leftover(of: 17, by: 0)))
    let eleven = scaled(total: 17, count: 5)
    io.println(answered(claim: "17 scaled by 5 is 11", answer: eleven, wanted: 11))
    io.println(nothing(claim: "17 scaled by 0 is None", answer: scaled(total: 17, count: 0)))
    0
}

// Arithmetic over `Int` divides through `?`, one per division, and reads as arithmetic.
// A `None` is handed straight back, so the rest of the line is never worked out.
// example: or(scaled(total: 17, count: 5), 0) == 11
// example: or(scaled(total: 17, count: 0), 0) == 0
fn scaled(total: Int, count: Int) -> Option<Int> {
    Some(((total / count)? / 2)? + 2 * 5)
}

// example: or(divided(of: 17, by: 5), 0) == 3
// example: or(divided(of: 17, by: 0), 0) == 0
fn divided(of: Int, by: Int) -> Option<Int> {
    of / by
}

// example: or(leftover(of: 17, by: 5), 0) == 2
fn leftover(of: Int, by: Int) -> Option<Int> {
    of % by
}

// example: answered(claim: "17 / 5 is Some(3)", answer: Some(3), wanted: 3) == "17 / 5 is Some(3)"
fn answered(claim: String, answer: Option<Int>, wanted: Int) -> String {
    match answer {
        Some(held) => held_as(claim: claim, held: held, wanted: wanted)
        None => "no answer where " + claim
    }
}

// example: held_as(claim: "it holds", held: 3, wanted: 3) == "it holds"
fn held_as(claim: String, held: Int, wanted: Int) -> String {
    if held == wanted {
        claim
    } else {
        "another answer where " + claim
    }
}

// example: nothing(claim: "17 / 0 is None", answer: None) == "17 / 0 is None"
fn nothing(claim: String, answer: Option<Int>) -> String {
    match answer {
        Some(held) => "an answer where " + claim
        None => claim
    }
}
