// expect-error: L0801
// A process is started with `spawn`, never called as a function.
fn main(arguments: List<String>) -> Int {
    _ = Counter()
    0
}

process Counter {
    fn start() -> Int {
        0
    }

    fn receive(total: Int, message: Counted) -> Next<Int> {
        match message {
            Add(amount) => Continue(total + amount)
            Stop => Done
        }
    }
}

type Counted =
    | Add(Int)
    | Stop
