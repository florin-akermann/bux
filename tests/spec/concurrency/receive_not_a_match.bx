// expect-error: L0808
// The body of `receive` is one `match` on the message.
fn main(arguments: List<String>) -> Int {
    _ = spawn Counter()
    0
}

process Counter {
    fn start() -> Int {
        0
    }

    fn receive(total: Int, message: Counted) -> Next<Int> {
        Continue(total)
    }
}

type Counted =
    | Add(Int)
    | Stop
