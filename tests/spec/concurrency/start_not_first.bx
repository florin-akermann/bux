// expect-error: L0802
// The first function of a process is `start`.
fn main(arguments: List<String>) -> Int {
    _ = spawn Counter()
    0
}

process Counter {
    fn begin() -> Int {
        0
    }

    fn receive(total: Int, message: Counted) -> Next<Int> {
        match message {
            Add(amount) => Continue(total + amount)
            Stop => Done
        }
    }
}

type Counted =
    | Add(Int)
    | Stop
