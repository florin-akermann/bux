// expect-error: L0803
// The second function of a process is `receive`.
fn main(arguments: List<String>) -> Int {
    _ = spawn Counter()
    0
}

process Counter {
    fn start() -> Int {
        0
    }

    fn handle(total: Int, message: Counted) -> Next<Int> {
        match message {
            Add(amount) => Continue(total + amount)
            Stop => Done
        }
    }
}

type Counted =
    | Add(Int)
    | Stop
