// expect-error: L0806
// A process writes the type of each parameter, because nothing infers it.
fn main(arguments: List<String>) -> Int {
    _ = spawn Counter(0)
    0
}

process Counter {
    fn start(initial) -> Int {
        initial
    }

    fn receive(total: Int, message: Counted) -> Next<Int> {
        match message {
            Add(amount) => Continue(total + amount)
            Stop => Done
        }
    }
}

type Counted =
    | Add(Int)
    | Stop
