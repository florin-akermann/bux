// A module that declares a process, which a module that imports it spawns through its name.
/// A total that each `Add` grows, and that `Stop` ends.
process Tally {
    fn start(initial: Int) -> Int {
        initial
    }

    fn receive(total: Int, message: Counted) -> Next<Int> {
        match message {
            Add(amount) => Continue(total + amount)
            Stop => Done
        }
    }
}

/// What a tally is sent.
type Counted =
    | Add(Int)
    | Stop
