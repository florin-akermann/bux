// expect-run
// > 91
// Two workers share six jobs, and each worker sends its answer to one collector.
// A message carries the handle of the collector, which is the address a worker answers to.
// The answers arrive in any order, so the program shows their total, which has one value.
import io
import list

fn main(arguments: List<String>) -> Int {
    let collecting = spawn Collector()
    let first = spawn Worker(collecting)
    let second = spawn Worker(collecting)
    for number in [1, 3, 5] {
        _ = send(first, Square(number), NoLimit)
    }
    for number in [2, 4, 6] {
        _ = send(second, Square(number), NoLimit)
    }
    for worker in [first, second] {
        _ = send(worker, Quit, NoLimit)
        _ = ended(worker)
    }
    io.println(shown(total(collected(collecting))))
    0
}

// example: list.length(collected(spawn Collector())) == 0
fn collected(collector: Process<Collected, List<Int>>) -> List<Int> {
    _ = send(collector, Finish, NoLimit)
    ended(collector)
}

// example: total([1, 4]) == 5
fn total(answers: List<Int>) -> Int {
    var sum = 0
    for answer in answers {
        sum += answer
    }
    sum
}

process Worker {
    fn start(collector: Process<Collected, List<Int>>) -> Process<Collected, List<Int>> {
        collector
    }

    fn receive(collector: Process<Collected, List<Int>>, message: Job) -> Next<Process<Collected, List<Int>>> {
        match message {
            Square(number) => Continue(answered(collector, number))
            Quit => Done
        }
    }
}

// example: total(collected(answered(spawn Collector(), 3))) == 9
fn answered(collector: Process<Collected, List<Int>>, number: Int) -> Process<Collected, List<Int>> {
    _ = send(collector, Answer(number * number), NoLimit)
    collector
}

process Collector {
    fn start() -> List<Int> {
        []
    }

    fn receive(answers: List<Int>, message: Collected) -> Next<List<Int>> {
        match message {
            Answer(number) => Continue(list.push(answers, number))
            Finish => Done
        }
    }
}

type Job =
    | Square(Int)
    | Quit

type Collected =
    | Answer(Int)
    | Finish
