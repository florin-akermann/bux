// expect-error: L0803
// The second function of a process is `receive`.
fn main(arguments: List<String>) -> Int {
    _ = spawn Counter()
    0
}

/// A total that each `Add` grows.
process Counter {
    fn start() -> Int {
        0
    }

    fn handle(total: Int, message: Counted) -> Next<Int> {
        match message {
            Add(amount) => Continue(total + amount)
            Stop => Done
        }
    }
}

/// What a counter is sent.
type Counted =
    | Add(Int)
    | Stop
