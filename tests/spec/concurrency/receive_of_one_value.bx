// expect-error: L0807
// `receive` takes the state and one message.
fn main(arguments: List<String>) -> Int {
    _ = spawn Counter()
    0
}

process Counter {
    fn start() -> Int {
        0
    }

    fn receive(message: Counted) -> Next<Int> {
        match message {
            Add(amount) => Continue(amount)
            Stop => Done
        }
    }
}

type Counted =
    | Add(Int)
    | Stop
