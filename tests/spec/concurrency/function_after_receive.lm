// expect-error: L0804
// A process declares `start` and `receive`, and nothing after them.
fn main(arguments: List<String>) -> Int {
    _ = spawn Counter()
    0
}

/// A total that each `Add` grows.
process Counter {
    fn start() -> Int {
        0
    }

    fn receive(total: Int, message: Counted) -> Next<Int> {
        match message {
            Add(amount) => Continue(total + amount)
            Stop => Done
        }
    }

    fn reset() -> Int {
        0
    }
}

/// What a counter is sent.
type Counted =
    | Add(Int)
    | Stop
