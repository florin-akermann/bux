// expect-run
// A discarded value is worked out and dropped, whatever width the JVM holds it in.
fn main(arguments: List<String>) -> Int {
    _ = plain(2)
    _ = "thrown away"
    _ = wrapped(3)
    _ = is_read(wrapped(4))
    var count = 0
    for count < 3 {
        _ = plain(count)
        _ = wrapped(count)
        count += 1
    }
    0
}

// example: plain(2) == 3
fn plain(value: Int) -> Int {
    value + 1
}

// example: is_read(wrapped(4))
fn wrapped(value: Int) -> UserId {
    UserId(value)
}

// example: is_read(UserId(1))
fn is_read(id: UserId) -> Bool {
    match id {
        UserId(raw) => raw > 0
    }
}

type UserId = UserId(Int)
