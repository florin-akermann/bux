// expect-run
// `Eq` is what `==` is, and version 0.1 ships it for `Int`, `Bool`, and `String`.
fn main() -> () {
    numbers := is_same(left: 7, right: 7)
    if numbers && is_matching(left: "one", right: "one") && is_agreeing(left: true, right: true) {
        return ()
    }
    ()
}

// example: is_same(left: 7, right: 7)
fn is_same(left: Int, right: Int) -> Bool {
    left == right
}

// example: is_matching(left: "one", right: "one")
fn is_matching(left: String, right: String) -> Bool {
    left == right
}

// example: is_agreeing(left: true, right: true)
fn is_agreeing(left: Bool, right: Bool) -> Bool {
    left == right
}
