// expect-run
fn main(arguments: List<String>) -> Int {
    let answer = doubled(21)
    _ = told(Pending)
    _ = told(Failed("declined"))
    _ = later(User { id: answer, active: true })
    0
}

// example: told(Pending) == "waiting"
fn told(payment: Payment) -> String {
    match payment {
        Pending => "waiting"
        Failed(reason) => reason
    }
}

type Payment =
    | Pending
    | Failed(String)

// example: doubled(21) == 42
fn doubled(count: Int) -> Int {
    identity(count) + count
}

// example: identity(7) == 7
fn identity<T>(value: T) -> T {
    value
}

// example: later(User { id: 1, active: true }).active == false
fn later(user: User) -> User {
    user { active: false }
}

type User = {
    id: Int
    active: Bool
}
