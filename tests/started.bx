// Each command of the command line that starts a JVM, done on files written for it.
//
// `docs/specs/run.md` states `run`, and `docs/specs/doc-examples.md` states `test`. A check here
// needs the JDK `JAVA_HOME` names, and every check is skipped where it names none. A check of what
// the command line says where `JAVA_HOME` names no JDK starts the command line in a JVM of its
// own, with `JAVA_HOME` taken away or changed, because this JVM reads the one it was given.
import checking
import command
import enacted
import environment
import exemplified
import files
import held
import ir
import list
import modules
import strings
import walk

/// Every check of this module, or one skip where `JAVA_HOME` names no JDK.
// example: dotted("a/b") == "a.b"
fn every_run_held(library: ir.Library, limit: Int) -> held.Held {
    if !exemplified.is_a_jdk_named() {
        return held.with_skip(held.nothing_failed(0), "tests/started.bx: JAVA_HOME names no JDK, and each check starts a JVM")
    }
    var found = classes_verified(library, limit)
    found = held.added(found, every_test_held(library))
    found = held.added(found, example_program_run(library, limit))
    found = held.added(found, example_program_tested(library))
    found = held.added(found, billion_rows_held(library, limit))
    found = held.added(found, every_missing_jdk_held(limit))
    held.added(found, every_injection_removed(limit))
}

/// Every class `build` writes is one a JVM loads and verifies.
// example: class_named("bux/Result$Ok.class") == "bux.Result$Ok"
fn classes_verified(library: ir.Library, limit: Int) -> held.Held {
    let scene = enacted.scene_of([enacted.Written { at: "example.bx", text: everything_text() }])
    let said = enacted.said_to(["build", modules.joined(scene, "example.bx")], library)
    var facts = [enacted.status_fact(said, 0)]
    let target = modules.joined(scene, "target")
    for class in enacted.relative_files(target) {
        if walk.is_ending_in(class, ".class") {
            facts = list.push(facts, class_loaded(target: target, class: class, limit: limit))
        }
    }
    command.removed_whole(scene)
    enacted.facts_held("every class build writes is one a JVM loads and verifies", facts)
}

/// The fact that a JVM loads the class written at `class` under `target`, which it does where it
/// says nothing but that the class declares no `main`.
// example: is_loaded("Error: Main method not found in class a")
fn class_loaded(target: String, class: String, limit: Int) -> enacted.Fact {
    let line = [java(), "--enable-preview", "-cp", target, class_named(class)]
    let errors = errors_of(walk.completed(line, target, limit))
    if is_loaded(errors) {
        return enacted.Fact { what: class, expected: "loaded", found: "loaded" }
    }
    enacted.Fact { what: class, expected: "loaded", found: errors }
}

/// What a program wrote on standard error, or why it gave no status back.
// example: errors_of(Err(walk.NotStarted)) == "Error: the JVM could not be started"
fn errors_of(completion: Result<walk.Ended, walk.Unended>) -> String {
    match completion {
        Ok(done) => done.errors
        Err(unended) => "Error: " + walk.unended_said(unended, "the JVM")
    }
}

/// Whether what a JVM said of a class it was asked to start says the class loaded.
// example: is_loaded("")
// example: !is_loaded("Error: Unable to initialize main class a")
fn is_loaded(errors: String) -> Bool {
    !enacted.is_within(errors, "Error") || enacted.is_within(errors, "Main method not found")
}

/// The name a JVM is asked for a class by, from the path of its file.
// example: class_named("example.class") == "example"
fn class_named(path: String) -> String {
    dotted(enacted.without(path, ".class"))
}

/// `path` with each slash written as a dot.
// example: dotted("a") == "a"
fn dotted(path: String) -> String {
    var written = ""
    var index = 0
    for index < strings.length(path) {
        let unit = or(strings.cut(path, index, index + 1), "")
        if unit == "/" {
            written += "."
        } else {
            written += unit
        }
        index += 1
    }
    written
}

/// The checks of `test`, which runs the examples of a module in a JVM of their own.
// example: strings.length(does_not_hold_text()) > 0
fn every_test_held(library: ir.Library) -> held.Held {
    var found = examples_tested(library)
    found = held.added(found, example_not_held(library))
    found = held.added(found, line_written_by_the_program(library))
    held.added(found, imported_examples_tested(library))
}

/// `test` says nothing and ends with 0 where every example held.
// example: strings.length(enacted.holds_text()) > 0
fn examples_tested(library: ir.Library) -> held.Held {
    let scene = enacted.scene_of([enacted.Written { at: "example.bx", text: enacted.holds_text() }])
    let said = enacted.said_to(["test", modules.joined(scene, "example.bx")], library)
    command.removed_whole(scene)
    enacted.facts_held("test says nothing where every example held", enacted.said_facts("test", said))
}

/// `test` reports the example that did not hold, where it is written.
// example: enacted.first_line_of(does_not_hold_text()) == "// example: shared(total: 7) == 8"
fn example_not_held(library: ir.Library) -> held.Held {
    let scene = enacted.scene_of([enacted.Written { at: "example.bx", text: does_not_hold_text() }])
    let said = enacted.said_to(["test", modules.joined(scene, "example.bx")], library)
    command.removed_whole(scene)
    let facts = [enacted.status_fact(said, 1), enacted.within_fact("errors", said.errors, "error[L0603]: the example of `shared` does not hold"), enacted.within_fact("errors", said.errors, "// example: shared(total: 7) == 8")]
    enacted.facts_held("test reports the example that did not hold", facts)
}

/// A line a program writes itself is not read as an example that did not hold.
// example: enacted.first_line_of(writes_a_line_text()) == "import io"
fn line_written_by_the_program(library: ir.Library) -> held.Held {
    let scene = enacted.scene_of([enacted.Written { at: "example.bx", text: writes_a_line_text() }])
    let said = enacted.said_to(["test", modules.joined(scene, "example.bx")], library)
    command.removed_whole(scene)
    let facts = [enacted.status_fact(said, 0), enacted.Fact { what: "errors", expected: "", found: said.errors }]
    enacted.facts_held("a line the program writes itself is not a failed example", facts)
}

/// `test` runs the examples of a module that imports another.
// example: enacted.first_line_of(twice_text()) == "import greeting"
fn imported_examples_tested(library: ir.Library) -> held.Held {
    let scene = enacted.scene_of([enacted.Written { at: "example.bx", text: twice_text() }, enacted.Written { at: "greeting.bx", text: enacted.greeting_text() }])
    let said = enacted.said_to(["test", modules.joined(scene, "example.bx")], library)
    command.removed_whole(scene)
    enacted.facts_held("test runs the examples of a module that imports another", [enacted.status_fact(said, 0)])
}

/// `example/main.bx` runs to the end and writes every answer it works out, which
/// `docs/specs/example-program.md` states.
// example: strings.length(java()) >= 0
fn example_program_run(library: ir.Library, limit: Int) -> held.Held {
    let scene = enacted.scene_of([enacted.Written { at: "main.bx", text: ok_or(files.read("example/main.bx"), "") }])
    let answer = command.answered_within(["run", modules.joined(scene, "main.bx")], library)
    let said = ended_said(answer, scene, limit)
    command.removed_whole(scene)
    let facts = [enacted.status_fact(said, 0), enacted.Fact { what: "output", expected: "held: 7\neach: 3\nmost: 6\n", found: said.output }]
    enacted.facts_held("example/main.bx writes every answer it works out", facts)
}

/// Every example of `example/main.bx` holds.
// example: ended_said(command.Spoken(command.nothing_said()), "no-such-directory", 1).status == 0
fn example_program_tested(library: ir.Library) -> held.Held {
    let scene = enacted.scene_of([enacted.Written { at: "main.bx", text: ok_or(files.read("example/main.bx"), "") }])
    let said = enacted.said_to(["test", modules.joined(scene, "main.bx")], library)
    command.removed_whole(scene)
    enacted.facts_held("every example of example/main.bx holds", enacted.said_facts("test", said))
}

/// The checks of `1brc/src/main.bx`, which `docs/specs/billion-rows.md` states: each sample,
/// the run with no file named, the examples of the module, and the tests of its generator.
// example: sample_named("a.txt") == "1brc/tests/samples/a.txt"
fn billion_rows_held(library: ir.Library, limit: Int) -> held.Held {
    var found = every_sample_answered(library, limit)
    found = held.added(found, billion_rows_unnamed(library, limit))
    found = held.added(found, billion_rows_tested(library))
    held.added(found, measurements_tested(library))
}

/// `1brc/src/main.bx` writes the line each sample expects, in `1brc/tests/samples/<name>.out`.
// example: strings.length(billion_rows_text()) >= 0
fn every_sample_answered(library: ir.Library, limit: Int) -> held.Held {
    let names = ok_or(files.listed("1brc/tests/samples"), [])
    var facts = [enacted.Fact { what: "1brc/tests/samples holds a sample", expected: "true", found: shown(list.length(names) > 0) }]
    for name in names {
        if walk.is_ending_in(name, ".txt") {
            facts = command.all_of(facts, sample_facts(name: name, library: library, limit: limit))
        }
    }
    enacted.facts_held("1brc/src/main.bx writes the line each sample expects", facts)
}

/// The status and the output of `1brc/src/main.bx` over the sample called `name`, beside what the
/// sample expects.
// example: strings.length(billion_rows_text()) >= 0
fn sample_facts(name: String, library: ir.Library, limit: Int) -> List<enacted.Fact> {
    let sample = enacted.Written { at: "sample.txt", text: ok_or(files.read(sample_named(name)), "") }
    let scene = enacted.scene_of([enacted.Written { at: "main.bx", text: billion_rows_text() }, sample])
    let answer = command.answered_within(["run", modules.joined(scene, "main.bx"), modules.joined(scene, "sample.txt")], library)
    let said = ended_said(answer, scene, limit)
    command.removed_whole(scene)
    let expected = ok_or(files.read(sample_named(enacted.without(name, ".txt") + ".out")), "no expected output")
    [enacted.Fact { what: name + ": status", expected: "0", found: shown(said.status) }, enacted.Fact { what: name + ": output", expected: expected, found: said.output }]
}

/// The path of the file called `name` under `1brc/tests/samples`.
// example: sample_named("b.out") == "1brc/tests/samples/b.out"
fn sample_named(name: String) -> String {
    modules.joined("1brc/tests/samples", name)
}

/// `1brc/src/main.bx` ends with status 2 and says how it is run, where no file is named.
// example: strings.length(billion_rows_text()) >= 0
fn billion_rows_unnamed(library: ir.Library, limit: Int) -> held.Held {
    let scene = enacted.scene_of([enacted.Written { at: "main.bx", text: billion_rows_text() }])
    let answer = command.answered_within(["run", modules.joined(scene, "main.bx")], library)
    let said = ended_said(answer, scene, limit)
    command.removed_whole(scene)
    let facts = [enacted.status_fact(said, 2), enacted.opening_fact("errors", said.errors, "usage: ")]
    enacted.facts_held("1brc/src/main.bx says how it is run where no file is named", facts)
}

/// Every example of `1brc/src/main.bx` holds.
// example: strings.length(billion_rows_text()) >= 0
// The example of `written` writes the empty answer `{}`, and `bux test` passes that line on.
fn billion_rows_tested(library: ir.Library) -> held.Held {
    let scene = enacted.scene_of([enacted.Written { at: "main.bx", text: billion_rows_text() }])
    let said = enacted.said_to(["test", modules.joined(scene, "main.bx")], library)
    command.removed_whole(scene)
    let facts = [enacted.Fact { what: "test: status", expected: "0", found: shown(said.status) }, enacted.Fact { what: "test: output", expected: "{}\n", found: said.output }, enacted.Fact { what: "test: errors", expected: "", found: said.errors }]
    enacted.facts_held("every example of 1brc/src/main.bx holds", facts)
}

/// Every example and every test of `1brc/src/create_measurements.bx` holds.
///
/// A test of it starts `bin/bux run 1brc/src/main.bx`, which the runner's own directory holds, so
/// only the module is copied into the scene.
// example: strings.length(billion_rows_text()) >= 0
fn measurements_tested(library: ir.Library) -> held.Held {
    let text = ok_or(files.read("1brc/src/create_measurements.bx"), "")
    let scene = enacted.scene_of([enacted.Written { at: "create_measurements.bx", text: text }])
    let said = enacted.said_to(["test", modules.joined(scene, "create_measurements.bx")], library)
    command.removed_whole(scene)
    enacted.facts_held("every example and test of 1brc/src/create_measurements.bx holds", enacted.said_facts("test", said))
}

/// The text of `1brc/src/main.bx`.
// example: strings.length(billion_rows_text()) >= 0
fn billion_rows_text() -> String {
    ok_or(files.read("1brc/src/main.bx"), "")
}

/// What `answer` says, where a program to start is started in `directory` and ends.
// example: ended_said(command.Spoken(command.unusable("a")), "no-such-directory", 1).status == 2
fn ended_said(answer: command.Answer, directory: String, limit: Int) -> command.Said {
    match answer {
        command.Spoken(said) => said
        command.Starts(line) => program_said(walk.completed(line, directory, limit))
    }
}

/// The checks of what `run` and `test` say where `JAVA_HOME` names no JDK.
// example: strings.length(no_jdk_line()) > 0
fn every_missing_jdk_held(limit: Int) -> held.Held {
    var found = run_without_a_jdk(limit)
    found = held.added(found, refused_without_a_jdk(limit))
    found = held.added(found, run_where_no_jdk_is(limit))
    held.added(found, test_without_a_jdk(limit))
}

/// `run` says which variable names the JDK where nothing does, having compiled the program first.
// example: no_jdk_line() == "error: JAVA_HOME is not set, and running a program needs the JDK it names\n"
fn run_without_a_jdk(limit: Int) -> held.Held {
    let scene = enacted.scene_of([enacted.Written { at: "example.bx", text: enacted.counting_program_text() }])
    let said = without_a_jdk(["run", modules.joined(scene, "example.bx")], scene, limit)
    let facts = [enacted.status_fact(said, 2), enacted.Fact { what: "errors", expected: no_jdk_line(), found: said.errors }, enacted.presence_fact(scene, "target/example.class")]
    command.removed_whole(scene)
    enacted.facts_held("run says which variable names the JDK where nothing does", facts)
}

/// `run` reports a program that does not compile, even where no JDK could run it.
// example: strings.length(enacted.refused_program_text()) > 0
fn refused_without_a_jdk(limit: Int) -> held.Held {
    let scene = enacted.scene_of([enacted.Written { at: "example.bx", text: enacted.refused_program_text() }])
    let said = without_a_jdk(["run", modules.joined(scene, "example.bx")], scene, limit)
    command.removed_whole(scene)
    let facts = [enacted.status_fact(said, 1), enacted.opening_fact("errors", said.errors, "error[L03")]
    enacted.facts_held("run reports a program that does not compile where no JDK is", facts)
}

/// `run` says where it looked where `JAVA_HOME` names no JDK.
// example: java_of("/a") == "/a/bin/java"
fn run_where_no_jdk_is(limit: Int) -> held.Held {
    let scene = enacted.scene_of([enacted.Written { at: "example.bx", text: enacted.counting_program_text() }])
    let home = modules.joined(scene, "nowhere")
    let said = command_line_said(command.all_of(["/usr/bin/env", "JAVA_HOME=" + home], command_line(["run", modules.joined(scene, "example.bx")])), scene, limit)
    command.removed_whole(scene)
    let facts = [enacted.status_fact(said, 2), enacted.Fact { what: "errors", expected: "error: " + java_of(home) + ": JAVA_HOME names no JDK\n", found: said.errors }]
    enacted.facts_held("run says where it looked where JAVA_HOME names no JDK", facts)
}

/// `test` says which variable names the JDK where nothing does.
// example: strings.length(enacted.holds_text()) > 0
fn test_without_a_jdk(limit: Int) -> held.Held {
    let scene = enacted.scene_of([enacted.Written { at: "example.bx", text: enacted.holds_text() }])
    let said = without_a_jdk(["test", modules.joined(scene, "example.bx")], scene, limit)
    command.removed_whole(scene)
    let facts = [enacted.status_fact(said, 2), enacted.within_fact("errors", said.errors, "JAVA_HOME is not set")]
    enacted.facts_held("test says which variable names the JDK where nothing does", facts)
}

/// The checks that a program starts with no variable that adds options to its JVM.
// example: picked_up_line() == "Picked up JAVA_TOOL_OPTIONS: -Xmx64m\n"
fn every_injection_removed(limit: Int) -> held.Held {
    held.added(run_without_injected_options(limit), test_without_injected_options(limit))
}

/// `run` starts the program without `JAVA_TOOL_OPTIONS`, which the command line still reads.
///
/// The JVM of the command line writes the one line that says it read the variable, and the JVM of
/// the program writes no second line.
// example: enacted.first_line_of(options_seen_text()) == "import environment"
fn run_without_injected_options(limit: Int) -> held.Held {
    let scene = enacted.scene_of([enacted.Written { at: "example.bx", text: options_seen_text() }])
    let said = with_injected_options(["run", modules.joined(scene, "example.bx")], scene, limit)
    command.removed_whole(scene)
    let facts = [enacted.status_fact(said, 0), enacted.Fact { what: "output", expected: "no options\n", found: said.output }, enacted.Fact { what: "errors", expected: picked_up_line(), found: said.errors }]
    enacted.facts_held("run starts a program without JAVA_TOOL_OPTIONS", facts)
}

/// `test` runs the examples of a module without `JAVA_TOOL_OPTIONS`.
// example: enacted.first_line_of(options_example_text()) == "import environment"
fn test_without_injected_options(limit: Int) -> held.Held {
    let scene = enacted.scene_of([enacted.Written { at: "example.bx", text: options_example_text() }])
    let said = with_injected_options(["test", modules.joined(scene, "example.bx")], scene, limit)
    command.removed_whole(scene)
    let facts = [enacted.status_fact(said, 0), enacted.Fact { what: "errors", expected: picked_up_line(), found: said.errors }]
    enacted.facts_held("test runs the examples without JAVA_TOOL_OPTIONS", facts)
}

/// What the command line says to `words` in a JVM of its own, started in `directory` with
/// `JAVA_TOOL_OPTIONS` set.
// example: list.length(command_line(["a", "b"])) == 7
fn with_injected_options(words: List<String>, directory: String, limit: Int) -> command.Said {
    command_line_said(command.all_of(["/usr/bin/env", "JAVA_TOOL_OPTIONS=-Xmx64m"], command_line(words)), directory, limit)
}

/// The line a JVM writes on standard error when it reads `JAVA_TOOL_OPTIONS=-Xmx64m`.
// example: strings.length(picked_up_line()) == 37
fn picked_up_line() -> String {
    "Picked up JAVA_TOOL_OPTIONS: -Xmx64m\n"
}

/// A program that says whether it sees `JAVA_TOOL_OPTIONS`.
// example: strings.length(options_seen_text()) > 0
fn options_seen_text() -> String {
    "import environment\nimport io\n\nfn main(arguments: List<String>) -> Int {\n    match environment.read(\"JAVA_TOOL_OPTIONS\") {\n        Some(options) => io.println(\"options: \" + options)\n        None => io.println(\"no options\")\n    }\n    0\n}\n"
}

/// A module whose example holds only where `JAVA_TOOL_OPTIONS` is not set.
// example: strings.length(options_example_text()) > 0
fn options_example_text() -> String {
    "import environment\n\n// example: is_bare()\nfn is_bare() -> Bool {\n    match environment.read(\"JAVA_TOOL_OPTIONS\") {\n        Some(_) => false\n        None => true\n    }\n}\n"
}

/// What the command line says to `words` in a JVM of its own, started in `directory` with
/// `JAVA_HOME` taken away.
// example: list.length(command_line(["a"])) == 6
fn without_a_jdk(words: List<String>, directory: String, limit: Int) -> command.Said {
    command_line_said(command.all_of(["/usr/bin/env", "-u", "JAVA_HOME"], command_line(words)), directory, limit)
}

/// What the program `line` starts in `directory` wrote and ended with.
// example: command_line_said(["no-such-program-at-all"], "no-such-directory", 1).status == -1
fn command_line_said(line: List<String>, directory: String, limit: Int) -> command.Said {
    program_said(walk.completed(line, directory, limit))
}

/// What a started program wrote and ended with, or why it gave no status back.
// example: program_said(Err(walk.NotStarted)).errors == "the program could not be started\n"
// example: program_said(Err(walk.PastLimit(3, ""))).status == -1
fn program_said(completion: Result<walk.Ended, walk.Unended>) -> command.Said {
    match completion {
        Ok(done) => command.Said { output: done.output, errors: done.errors, status: done.status }
        Err(unended) => command.Said { output: "", errors: walk.unended_said(unended, "the program") + "\n", status: -1 }
    }
}

/// The line that starts the command line in a JVM of its own, given `words`.
///
/// The class path is `compiler/target` alone, named by its whole path, as `bin/bux` names it: it
/// holds the classes, and beside them the help, the explanations, and the library.
// example: or(list.at(command_line(["a"]), 5), "") == "a"
fn command_line(words: List<String>) -> List<String> {
    let root = or(environment.property("user.dir"), ".")
    command.all_of([java(), "--enable-preview", "-cp", modules.joined(root, "compiler/target"), "main"], words)
}

/// The line every refusal of a run where `JAVA_HOME` is not set reads.
// example: strings.length(no_jdk_line()) == 74
fn no_jdk_line() -> String {
    "error: JAVA_HOME is not set, and running a program needs the JDK it names\n"
}

/// The `java` of the JDK `JAVA_HOME` names.
// example: strings.length(java()) >= 0
fn java() -> String {
    java_of(or(environment.read("JAVA_HOME"), ""))
}

/// The `java` of the JDK at `home`.
// example: java_of("") == "bin/java"
fn java_of(home: String) -> String {
    modules.joined(modules.joined(home, "bin"), "java")
}

/// A module reaching every construct whose lowering the verifier has something to say about.
// example: strings.length(everything_text()) > 0
fn everything_text() -> String {
    "// example: walked([1, 2]) == 3\nfn walked(counts: List<Int>) -> Int {\n    var total = 0\n    for count in counts {\n        total += identity(count)\n    }\n    total\n}\n\n// example: joined(word: \"ha\") == \"ha!\"\nfn joined(word: String) -> String {\n    identity(word) + \"!\"\n}\n\n// example: is_compared(1)\nfn is_compared(count: Int) -> Bool {\n    identity(count) < 2\n}\n\n// example: is_negated(false)\nfn is_negated(flag: Bool) -> Bool {\n    !identity(flag)\n}\n\n// example: picked(2) == 1\nfn picked(count: Int) -> Int {\n    if identity(count > 1) {\n        1\n    } else {\n        2\n    }\n}\n\n// example: identity(7) == 7\nfn identity<T>(value: T) -> T {\n    value\n}\n"
}

/// The module of `holds_text`, with the one example stating what the function does not work out.
// example: strings.length(does_not_hold_text()) > 0
fn does_not_hold_text() -> String {
    "// example: shared(total: 7) == 8\nfn shared(total: Int) -> Int {\n    total\n}\n"
}

/// A module that writes a line of its own, which reads as a run's report of the first example,
/// from inside the example that tries it, and the example holds.
// example: strings.length(writes_a_line_text()) > 0
fn writes_a_line_text() -> String {
    "import io\n\n// example: is_ready()\nfn is_ready() -> Bool {\n    io.println(\"0\")\n    true\n}\n"
}

/// A module whose example reaches a function of the module `greeting` beside it.
// example: strings.length(twice_text()) > 0
fn twice_text() -> String {
    "import greeting\n\n// example: twice() == \"hello, world\"\nfn twice() -> String {\n    greeting.greeting(\"world\")\n}\n"
}

test "each command that starts a JVM does what its check holds it to" {
    held.is_held_reported(every_run_held(checking.carried_library(), walk.start_limit()))
}
