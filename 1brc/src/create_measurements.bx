/// Whether `answer` is the line `1brc/src/main.bx` writes over the stations `names` holds.
///
/// Each station is there once and in the order of its name, as `name=lowest/mean/highest`, and
/// each of the three readings has one decimal.
// example: is_an_answer(answer: "{a=1.0/-2.5/30.0}\n", names: ["a"])
// example: !is_an_answer(answer: "{a=1/2/3}", names: ["a"])
// example: !is_an_answer(answer: "{b=1.0/2.0/3.0}", names: ["a"])
fn is_an_answer(answer: String, names: List<String>) -> Bool {
    var expected = "{"
    for name in names {
        if expected != "{" {
            expected += ", "
        }
        expected += name + "=" + "0.0/0.0/0.0"
    }
    shape_of(answer) == shape_of(expected + "}\n")
}

/// `text` with each reading written as `0.0`, so that two answers of the same stations compare.
///
/// A reading is a run of digits after `=` or `/`, with an optional sign, a dot, and one digit.
// example: shape_of("{a=-12.3/4.5/6.7}") == "{a=0.0/0.0/0.0}"
// example: shape_of("{a=1/2}") == "{a=?1/?2}"
fn shape_of(text: String) -> String {
    var shaped = ""
    var index = 0
    for index < strings.length(text) {
        let unit = or(strings.cut(text, index, index + 1), "")
        shaped += unit
        index += 1
        if unit == "=" || unit == "/" {
            let reading = reading_length(text: text, from: index)
            shaped += if reading > 0 {
                "0.0"
            } else {
                "?"
            }
            index += reading
        }
    }
    shaped
}

/// How many chars of `text` from `from` on are one reading with one decimal, and 0 where none are.
// example: reading_length(text: "-12.3/", from: 0) == 5
// example: reading_length(text: "12/", from: 0) == 0
fn reading_length(text: String, from: Int) -> Int {
    var index = from
    if or(strings.at(text, index), 0) == 45 {
        index += 1
    }
    let digits_from = index
    for is_a_digit(or(strings.at(text, index), 0)) {
        index += 1
    }
    if index == digits_from || or(strings.at(text, index), 0) != 46 || !is_a_digit(or(strings.at(text, index + 1), 0)) || is_a_digit(or(strings.at(text, index + 2), 0)) {
        return 0
    }
    index + 2 - from
}

/// Whether `unit` is the code of a decimal digit.
// example: is_a_digit(48)
// example: !is_a_digit(0)
fn is_a_digit(unit: Int) -> Bool {
    unit >= 48 && unit <= 57
}

derive Eq for Order

/// The count of lines a run writes and the path it writes them to.
type Order = {
    rows: Int
    path: String
}

/// A station of the challenge and its mean temperature, in tenths of a degree.
type Station = {
    name: String
    mean_tenths: Int
}

/// The lines of one part, run together, and the draw that the next part starts from.
type Drawn = {
    text: String
    after: Draw
}

/// Where a generator stands: each value it draws is worked out from this one number.
type Draw = {
    state: Int
}

test "a file it writes is one that 1brc/src/main.bx answers for every station" {
    let directory = or(environment.property("java.io.tmpdir"), ".")
    let path = directory + "/create_measurements-" + shown(clock.nanoseconds()) + ".txt"
    let status = finished(written(rows: 5000, path: path))
    let ran = programs.run("bin/bux", ["run", "1brc/src/main.bx", path])
    _ = files.removed(path)
    var names = []
    for station in every_station() {
        names = list.push(names, station.name)
    }
    let answer = ok_or(ran, programs.Finished { code: 2, output: "", errors: "" })
    status == 0 && answer.code == 0 && is_an_answer(answer: answer.output, names: list.sorted(names))
}

test "two runs with the same count write the same file" {
    let directory = or(environment.property("java.io.tmpdir"), ".")
    let first = directory + "/create_measurements-first-" + shown(clock.nanoseconds()) + ".txt"
    let second = directory + "/create_measurements-second-" + shown(clock.nanoseconds()) + ".txt"
    let first_status = finished(written(rows: 300, path: first))
    let second_status = finished(written(rows: 300, path: second))
    let first_text = files.read(first)
    let second_text = files.read(second)
    _ = files.removed(first)
    _ = files.removed(second)
    first_status == 0 && second_status == 0 && ok_or(first_text, "a") == ok_or(second_text, "b")
}
