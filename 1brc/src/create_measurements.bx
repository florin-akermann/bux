// The file of measurements that `1brc/src/main.bx` reads: `<station>;<reading>` on each line.
//
// `docs/specs/billion-rows.md` states the command line, a line, and how the readings spread.
// The file is written in parts of one million lines, each joined and appended once, so a billion
// lines need no more memory than one part holds. The draws start from one fixed seed, so two runs
// with the same count write the same file.
import clock
import environment
import files
import io
import list
import programs
import strings

fn main(arguments: List<String>) -> Int {
    match asked(arguments) {
        Ok(order) => finished(written(rows: order.rows, path: order.path))
        Err(why) => refused(why)
    }
}

/// The count of lines and the path `arguments` name, or why they name no file to write.
// example: ok_or(asked(["3", "a.txt"]), Order { rows: 0, path: "" }) == Order { rows: 3, path: "a.txt" }
// example: ok_or(asked(["-3", "a.txt"]), Order { rows: 0, path: "" }) == Order { rows: 0, path: "" }
// example: ok_or(asked(["3"]), Order { rows: 0, path: "" }) == Order { rows: 0, path: "" }
fn asked(arguments: List<String>) -> Result<Order, String> {
    match list.at(arguments, 1) {
        Some(path) => counted(count: or(list.at(arguments, 0), ""), path: path)
        None => Err(usage())
    }
}

/// The order to write `count` lines to `path`, or why `count` is no count of lines.
// example: ok_or(counted(count: "2", path: "a.txt"), Order { rows: 0, path: "" }).rows == 2
// example: ok_or(counted(count: "x", path: "a.txt"), Order { rows: 0, path: "" }).rows == 0
fn counted(count: String, path: String) -> Result<Order, String> {
    match whole_number(count) {
        Some(rows) => Ok(Order { rows: rows, path: path })
        None => Err("error: " + count + " is no whole number of rows; " + usage())
    }
}

/// How the program is run, which a run that names no file is told.
// example: usage() == "usage: bux run 1brc/src/create_measurements.bx <rows> <path>"
fn usage() -> String {
    "usage: bux run 1brc/src/create_measurements.bx <rows> <path>"
}

/// The whole number `text` spells in decimal digits, and `None` where it spells none.
///
/// Eighteen digits is the most a count holds, so no count spelled here wraps past the largest `Int`.
// example: or(whole_number("1000"), -1) == 1000
// example: or(whole_number(""), -1) == -1
// example: or(whole_number("-1"), -1) == -1
// example: or(whole_number("1000000000000000000"), -1) == -1
fn whole_number(text: String) -> Option<Int> {
    let length = strings.length(text)
    if length == 0 || length > 18 {
        return None
    }
    var total = 0
    var index = 0
    for index < length {
        let digit = or(strings.at(text, index), 0) - 48
        if digit < 0 || digit > 9 {
            return None
        }
        total = total * 10 + digit
        index += 1
    }
    Some(total)
}

/// The status of a run whose file is `answer`: 0 where it was written, and 2 where it was not.
// example: finished(Ok("a.txt")) == 0
// example: finished(Err("no file")) == 2
fn finished(answer: Result<String, String>) -> Int {
    match answer {
        Ok(_) => 0
        Err(why) => refused("error: " + why)
    }
}

/// The status of a run that writes `why` on standard error, which is 2.
// example: refused("error: no file") == 2
fn refused(why: String) -> Int {
    io.eprintln(why)
    2
}

/// `rows` lines written as the whole of the file at `path`, with `path` back where that worked.
///
/// The file is emptied first, so a second run over the same path writes the same file again.
// example: ok_or(written(rows: 1, path: ""), "not written") == "not written"
fn written(rows: Int, path: String) -> Result<String, String> {
    _ = files.write(path, "")?
    let known = every_station()
    var draw = Draw { state: 1 }
    var done = 0
    for done < rows {
        var count = rows - done
        if count > part_rows() {
            count = part_rows()
        }
        let part = drawn_part(draw: draw, count: count, stations: known)
        _ = files.append(path, part.text)?
        draw = part.after
        done += count
    }
    Ok(path)
}

/// How many lines one part holds, which is what one `String` holds between two appends.
// example: part_rows() == 1000000
fn part_rows() -> Int {
    1000000
}

/// `count` lines of `stations` drawn one after the other from `draw`, and the draw after them.
// example: drawn_part(draw: Draw { state: 1 }, count: 0, stations: every_station()).text == ""
// example: list.length(lines_of(drawn_part(draw: Draw { state: 1 }, count: 3, stations: every_station()).text)) == 3
fn drawn_part(draw: Draw, count: Int, stations: List<Station>) -> Drawn {
    var at = draw
    var lines = []
    for list.length(lines) < count {
        lines = list.push(lines, line_at(draw: at, stations: stations))
        at = next(next(next(next(at))))
    }
    Drawn { text: paired_until_one(lines), after: at }
}

/// The line that `draw` and the three draws after it make: a station, and a reading of it.
///
/// The reading is the mean of the station plus three draws from -100 to 100 tenths. Their sum
/// spreads with a standard deviation of about ten degrees, as the challenge's readings spread.
// example: line_at(draw: Draw { state: 1 }, stations: [Station { name: "a", mean_tenths: 1500 }]) == "a;99.9\n"
fn line_at(draw: Draw, stations: List<Station>) -> String {
    let station = or(list.at(stations, number(draw: draw, bound: list.length(stations))), Station { name: "", mean_tenths: 0 })
    let second = next(draw)
    let third = next(second)
    let offset = number(draw: second, bound: 201) + number(draw: third, bound: 201) + number(draw: next(third), bound: 201) - 300
    station.name + ";" + decimal(clamped(station.mean_tenths + offset)) + "\n"
}

/// Each line of `text`, without the line end that closes it.
// example: lines_of("a\nb\n") == ["a", "b"]
fn lines_of(text: String) -> List<String> {
    var lines = []
    var start = 0
    var index = 0
    for index < strings.length(text) {
        if or(strings.at(text, index), 0) == 10 {
            lines = list.push(lines, or(strings.cut(text, start, index), ""))
            start = index + 1
        }
        index += 1
    }
    lines
}

/// `tenths` held from -999 to 999, which is every reading one decimal and two digits write.
// example: clamped(1200) == 999
// example: clamped(-1200) == -999
// example: clamped(12) == 12
fn clamped(tenths: Int) -> Int {
    if tenths > 999 {
        return 999
    }
    if tenths < -999 {
        return -999
    }
    tenths
}

/// `tenths` written with one decimal, such as `-1.2` for `-12`.
// example: decimal(-12) == "-1.2"
// example: decimal(-5) == "-0.5"
// example: decimal(0) == "0.0"
// example: decimal(999) == "99.9"
fn decimal(tenths: Int) -> String {
    if tenths < 0 {
        return "-" + decimal(-tenths)
    }
    let whole = or(tenths / 10, 0)
    shown(whole) + "." + shown(tenths - whole * 10)
}

/// The parts run together in order, two neighbours at a time until one part is left.
///
/// `strings.join` adds each part to the text it has so far, which copies that text again for each
/// part. A pass here copies each char once, and a part of `n` lines takes `log n` passes.
// example: paired_until_one(["a", "b", "c"]) == "abc"
// example: paired_until_one([]) == ""
fn paired_until_one(parts: List<String>) -> String {
    var runs = parts
    for list.length(runs) > 1 {
        var joined = []
        var index = 0
        for index < list.length(runs) {
            joined = list.push(joined, or(list.at(runs, index), "") + or(list.at(runs, index + 1), ""))
            index += 2
        }
        runs = joined
    }
    or(list.at(runs, 0), "")
}

/// A whole number from 0 up to `bound`, and below it, which is 0 where `bound` holds no number.
///
/// The high half of the state is read, because the low bits of a linear congruential generator
/// repeat after a short run.
// example: number(draw: Draw { state: 1 }, bound: 10) < 10
// example: number(draw: Draw { state: 1 }, bound: 0) == 0
fn number(draw: Draw, bound: Int) -> Int {
    let high = or(draw.state / 4294967296, 0) + 2147483648
    or(high % bound, 0)
}

/// The draw after `draw`, with Knuth's MMIX constants, as `tests/drawn.bx` steps one.
// example: next(Draw { state: 0 }).state == 1442695040888963407
fn next(draw: Draw) -> Draw {
    Draw { state: draw.state * 6364136223846793005 + 1442695040888963407 }
}

