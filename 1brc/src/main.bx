// The One Billion Row Challenge: the lowest, mean, and highest reading of each station in a file.
//
// `docs/specs/billion-rows.md` states the input, the output, and how the file is split. Each
// processor gets a worker, and each worker tallies one contiguous part of the file on its own.
// `main` merges what the workers tallied, sorts the names, and writes the one line of output.
import environment
import files
import io
import list
import map
import strings

fn main(arguments: List<String>) -> Int {
    match list.at(arguments, 0) {
        Some(path) => answered(path)
        None => refused("usage: bux run 1brc/src/main.bx <file of measurements>")
    }
}

// example: answered("no-such-file.txt") == 2
fn answered(path: String) -> Int {
    match every_part_tallied(path) {
        Ok(tally) => written(tally)
        Err(why) => refused("error: " + why)
    }
}

// example: refused("error: no file") == 2
fn refused(why: String) -> Int {
    io.eprintln(why)
    2
}

// example: written(no_tally()) == 0
fn written(tally: Tally) -> Int {
    io.println(answer_of(tally))
    0
}

// example: list.length(ok_or(every_part_tallied("no-such-file.txt"), no_tally()).names) == 0
fn every_part_tallied(path: String) -> Result<Tally, String> {
    let size = files.size(path)?
    let count = environment.processors()
    var workers = []
    var index = 0
    for index < count {
        let part = Part { path: path, from: boundary(size: size, index: index, count: count), to: boundary(size: size, index: index + 1, count: count) }
        workers = list.push(workers, spawn Worker(part))
        index += 1
    }
    var merged = no_tally()
    for worker in workers {
        merged = merged_into(merged: merged, tally: finished(worker)?)
    }
    Ok(merged)
}

// example: boundary(size: 10, index: 1, count: 4) == 2
// example: boundary(size: 10, index: 4, count: 4) == 10
fn boundary(size: Int, index: Int, count: Int) -> Int {
    match size * index / count {
        Some(offset) => offset
        None => size
    }
}

// example: list.length(ok_or(finished(spawn Worker(Part { path: "no-such-file.txt", from: 0, to: 0 })), no_tally()).names) == 0
fn finished(worker: Process<Asked, Result<Tally, String>>) -> Result<Tally, String> {
    _ = send(worker, Finish, NoLimit)
    ended(worker)
}

process Worker {
    fn start(part: Part) -> Result<Tally, String> {
        part_tallied(part)
    }

    fn receive(tally: Result<Tally, String>, message: Asked) -> Next<Result<Tally, String>> {
        match message {
            Finish => Done
        }
    }
}

// A line belongs to the part that holds its first byte, so that no line is in two parts.
// example: list.length(ok_or(part_tallied(Part { path: "no-such-file.txt", from: 0, to: 0 }), no_tally()).names) == 0
fn part_tallied(part: Part) -> Result<Tally, String> {
    let first = line_start(path: part.path, at: part.from)?
    let last = line_start(path: part.path, at: part.to)?
    tallied_between(path: part.path, from: first, to: last)
}

// example: ok_or(line_start(path: "no-such-file.txt", at: 0), -1) == 0
// example: ok_or(line_start(path: "no-such-file.txt", at: 5), -1) == -1
fn line_start(path: String, at: Int) -> Result<Int, String> {
    if at <= 0 {
        return Ok(0)
    }
    var from = at - 1
    for true {
        let slice = files.read_between(path, from, from + 256)?
        let length = strings.length(slice)
        let index = line_end_in(slice)
        if index < length {
            return Ok(from + index + 1)
        }
        if length == 0 {
            return Ok(from)
        }
        from += length
    }
    Ok(from)
}

// example: line_end_in("ab\ncd\n") == 2
// example: line_end_in("ab") == 2
fn line_end_in(slice: String) -> Int {
    var index = 0
    for index < strings.length(slice) {
        if or(strings.at(slice, index), 0) == line_end() {
            return index
        }
        index += 1
    }
    index
}

// The last slice is read whole, because a file need not end with a line end.
// example: list.length(ok_or(tallied_between(path: "no-such-file.txt", from: 0, to: 0), no_tally()).names) == 0
fn tallied_between(path: String, from: Int, to: Int) -> Result<Tally, String> {
    var tally = no_tally()
    var at = from
    for at < to {
        let end = if at + slice_length() < to {
            at + slice_length()
        } else {
            to
        }
        let slice = files.read_between(path, at, end)?
        let through = if at + strings.length(slice) >= to {
            strings.length(slice)
        } else {
            whole_lines_in(slice)
        }
        if through == 0 {
            return Err(path + ": no whole line starts at byte " + shown(at))
        }
        tally = lines_tallied(tally: tally, slice: slice, through: through)
        at += through
    }
    Ok(tally)
}

// One read must hold much more than the longest line.
// example: slice_length() > 107
fn slice_length() -> Int {
    1048576
}

// example: whole_lines_in("a;1\nb;") == 4
// example: whole_lines_in("a;") == 0
fn whole_lines_in(slice: String) -> Int {
    var through = strings.length(slice)
    for through > 0 && or(strings.at(slice, through - 1), 0) != line_end() {
        through = through - 1
    }
    through
}

// example: lines_tallied(tally: no_tally(), slice: "a;1.0\nb;2.0\n", through: 12).names == ["a", "b"]
// example: lines_tallied(tally: no_tally(), slice: "a;1.0\nb;2.0", through: 11).names == ["a", "b"]
// example: lines_tallied(tally: no_tally(), slice: "\nnone\n", through: 6).names == []
fn lines_tallied(tally: Tally, slice: String, through: Int) -> Tally {
    var tallied = tally
    var start = 0
    var semicolon = -1
    var index = 0
    for index <= through {
        let unit = or(strings.at(slice, index), line_end())
        if unit == 59 {
            semicolon = index
        }
        if unit == line_end() || index == through {
            if semicolon > start {
                tallied = with_reading(tally: tallied, name: or(strings.cut(slice, start, semicolon), ""), reading: tenths_in(slice: slice, from: semicolon + 1, to: index))
            }
            start = index + 1
            semicolon = -1
        }
        index += 1
    }
    tallied
}

// example: line_end() == 10
fn line_end() -> Int {
    10
}

// example: tenths_in(slice: "a;-1.2\n", from: 2, to: 6) == -12
// example: tenths_in(slice: "a;45.0", from: 2, to: 6) == 450
fn tenths_in(slice: String, from: Int, to: Int) -> Int {
    var tenths = 0
    var sign = 1
    var index = from
    for index < to {
        let unit = or(strings.at(slice, index), 0)
        if unit == 45 {
            sign = -1
        }
        if unit >= 48 && unit <= 57 {
            tenths = tenths * 10 + unit - 48
        }
        index += 1
    }
    sign * tenths
}

// example: with_reading(tally: with_reading(tally: no_tally(), name: "a", reading: 5), name: "a", reading: -5).names == ["a"]
fn with_reading(tally: Tally, name: String, reading: Int) -> Tally {
    match map.get(tally.summaries, name) {
        Some(summary) => tally { summaries: map.insert(tally.summaries, name, joined(held: summary, added: first_reading(reading))) }
        None => Tally { names: list.push(tally.names, name), summaries: map.insert(tally.summaries, name, first_reading(reading)) }
    }
}

// example: first_reading(7).count == 1
fn first_reading(reading: Int) -> Summary {
    Summary { lowest: reading, highest: reading, total: reading, count: 1 }
}

// example: no_tally().names == []
fn no_tally() -> Tally {
    Tally { names: [], summaries: map.empty() }
}

// A worker holds a name as its bytes, and the decode occurs here, once for each station of each
// worker and not once for each line.
// example: merged_into(merged: no_tally(), tally: with_reading(tally: no_tally(), name: "Ã©", reading: 1)).names == ["é"]
fn merged_into(merged: Tally, tally: Tally) -> Tally {
    var together = merged
    for name in tally.names {
        together = match map.get(tally.summaries, name) {
            Some(summary) => with_summary(tally: together, name: strings.from_utf_8(name), summary: summary)
            None => together
        }
    }
    together
}

// example: with_summary(tally: no_tally(), name: "a", summary: first_reading(1)).names == ["a"]
fn with_summary(tally: Tally, name: String, summary: Summary) -> Tally {
    match map.get(tally.summaries, name) {
        Some(held) => tally { summaries: map.insert(tally.summaries, name, joined(held: held, added: summary)) }
        None => Tally { names: list.push(tally.names, name), summaries: map.insert(tally.summaries, name, summary) }
    }
}

// example: joined(held: first_reading(1), added: first_reading(-3)) == Summary { lowest: -3, highest: 1, total: -2, count: 2 }
fn joined(held: Summary, added: Summary) -> Summary {
    var least = held.lowest
    if added.lowest < least {
        least = added.lowest
    }
    var most = held.highest
    if added.highest > most {
        most = added.highest
    }
    Summary { lowest: least, highest: most, total: held.total + added.total, count: held.count + added.count }
}

// example: answer_of(with_reading(tally: with_reading(tally: no_tally(), name: "b", reading: 5), name: "a", reading: -15)) == "{a=-1.5/-1.5/-1.5, b=0.5/0.5/0.5}"
fn answer_of(tally: Tally) -> String {
    var stations = []
    for name in list.sorted(tally.names) {
        stations = match map.get(tally.summaries, name) {
            Some(summary) => list.push(stations, name + "=" + summary_text(summary))
            None => stations
        }
    }
    "{" + strings.join(stations, ", ") + "}"
}

// example: summary_text(joined(held: first_reading(-1), added: first_reading(-2))) == "-0.2/-0.1/-0.1"
fn summary_text(summary: Summary) -> String {
    decimal(summary.lowest) + "/" + decimal(mean_of(summary)) + "/" + decimal(summary.highest)
}

// A half rounds toward positive infinity, as `Math.round` rounds it. The mean is the floor of
// `(2 * total + count) / (2 * count)`, so no fraction is necessary.
// example: mean_of(joined(held: first_reading(-1), added: first_reading(-2))) == -1
// example: mean_of(joined(held: first_reading(1), added: first_reading(2))) == 2
// example: mean_of(joined(held: first_reading(1), added: first_reading(1))) == 1
fn mean_of(summary: Summary) -> Int {
    match floored(dividend: 2 * summary.total + summary.count, divisor: 2 * summary.count) {
        Some(mean) => mean
        None => summary.total
    }
}

// example: decimal(-12) == "-1.2"
// example: decimal(-5) == "-0.5"
// example: decimal(0) == "0.0"
// example: decimal(999) == "99.9"
fn decimal(tenths: Int) -> String {
    let size = if tenths < 0 {
        -tenths
    } else {
        tenths
    }
    let sign = if tenths < 0 {
        "-"
    } else {
        ""
    }
    let whole = or(floored(dividend: size, divisor: 10), 0)
    sign + shown(whole) + "." + shown(size - whole * 10)
}

// example: or(floored(dividend: -3, divisor: 2), 0) == -2
// example: or(floored(dividend: 3, divisor: 2), 0) == 1
// example: or(floored(dividend: 3, divisor: 0), 7) == 7
fn floored(dividend: Int, divisor: Int) -> Option<Int> {
    let quotient = (dividend / divisor)?
    if quotient * divisor != dividend && (dividend < 0) != (divisor < 0) {
        return Some(quotient - 1)
    }
    Some(quotient)
}

type Part = {
    path: String
    from: Int
    to: Int
}

type Asked = Finish

type Tally = {
    names: List<String>
    summaries: map.Map<String, Summary>
}

derive Eq for Summary

// Each reading is in tenths, so the total of a billion readings fits in an `Int`.
type Summary = {
    lowest: Int
    highest: Int
    total: Int
    count: Int
}
