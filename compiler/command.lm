// The `lumen` command line, written in Bux: every command `lumen --help` lists, and its answer.
//
// `docs/specs/run.md` states the command line and the launcher that starts it, and
// `docs/specs/diagnostics.md` states how a refusal reads. A command answers with text rather than
// with a print, so the runner runs many commands in one JVM and holds each to its golden answer.
// `main.lm` prints the answer; it is a module of its own because no module imports `main`.
import ast
import environment
import exhaustiveness
import files
import format
import holes
import infer
import ir
import jvm
import lexer
import list
import map
import modules
import parser
import programs
import refusal
import resolver
import set
import strings
import surface
import types

/// What the command line says to `arguments`, with the library the compiler carries.
// example: said_by(answered(["--version"])).output == "lumen 0.1.0\n"
fn answered(arguments: List<String>) -> Answer {
    answered_within(arguments, ir.library_read(or(modules.carried("prelude"), "")))
}

/// What the command line says to `arguments`, with `library` read once for many commands.
///
/// Every command but `run` answers with the text each stream is given and the status the command
/// ends with. `run` answers with the program to start, because that program reads and writes the
/// streams of the command line itself.
// example: said_by(answered_within(["--version"], ir.little_library())).status == 0
// example: said_by(answered_within([], ir.little_library())).status == 2
fn answered_within(arguments: List<String>, library: ir.Library) -> Answer {
    match asked_by(arguments) {
        Told(said) => Spoken(said)
        Asked(command) => Spoken(path_said(command, library))
        Running(asked) => run_said(asked, library)
    }
}

/// What one command other than `run` says, or the refusal of a file named as though a directory.
///
/// The JVM reads `main.lm/` as `main.lm`, but the answer is that the path is not a directory,
/// so the path is looked at before it is read.
// example: path_said(Fmt("/"), ir.little_library()).status == 2
fn path_said(command: Command, library: ir.Library) -> Said {
    path := path_of(command)
    if is_a_file_as_a_directory(path) {
        return unusable(path + ": Not a directory (os error 20)")
    }
    command_said(command, library)
}

/// What `run` says, or the refusal of a file named as though it were a directory.
// example: said_by(run_said(Started { file: "no-such-directory/a.lm", arguments: [] }, ir.little_library())).status == 2
fn run_said(asked: Started, library: ir.Library) -> Answer {
    if is_a_file_as_a_directory(asked.file) {
        return Spoken(unusable(asked.file + ": Not a directory (os error 20)"))
    }
    started(asked, library)
}

/// The path a command reads, which is no path for `explain`.
// example: path_of(Explain("L0100")) == ""
fn path_of(command: Command) -> String {
    match command {
        Fmt(file) => file
        Check { path, form } => path
        Build(path) => path
        Test(file) => file
        Api(file) => file
        Explain(code) => ""
    }
}

/// Whether `path` names a file and ends with a slash, as only the path of a directory does.
// example: !is_a_file_as_a_directory("/")
fn is_a_file_as_a_directory(path: String) -> Bool {
    place := place_at(path)
    has_trailing_slash(path) && is_there(place) && !is_folder(place)
}

/// What `answer` says, which for a program to start is what that program ends with.
///
/// The program is started with the streams of this one, so what it reads and writes never passes
/// through here, and its status is the status the command ends with.
// example: said_by(Spoken(nothing_said())).status == 0
fn said_by(answer: Answer) -> Said {
    match answer {
        Spoken(said) => said
        Starts(line) => program_ended(line)
    }
}

/// The status of the program `line` starts, with the streams of this process.
// example: program_ended(["no-such-program-at-all"]).status == 2
fn program_ended(line: List<String>) -> Said {
    match programs.started(inheriting(cleared(programs.of_command(line)))) {
        Ok(ran) => Said { output: "", errors: "", status: ok_or(programs.waited_for(ran), 2) }
        Err(why) => unusable(or(list.at(line, 0), "") + ": " + why)
    }
}

/// What one command other than `run` says, having done what it was asked.
// example: command_said(Explain("L9999"), ir.little_library()).errors == "error: there is no diagnostic L9999\n"
fn command_said(command: Command, library: ir.Library) -> Said {
    match command {
        Fmt(file) => formatted(file)
        Check { path, form } => checked_said(Checking { path: path, form: form }, library)
        Build(path) => built_said(path, library)
        Test(file) => tested(file, library)
        Api(file) => surface_said(file, library)
        Explain(code) => explained(code)
    }
}

/// Writes the canonical text of `path` back to it, leaving a canonical file untouched.
// example: formatted("no-such-directory/main.lm").errors == "error: no-such-directory/main.lm: No such file or directory (os error 2)\n"
fn formatted(path: String) -> Said {
    match files.read(path) {
        Ok(source) => source_formatted(Page { source: source, path: path })
        Err(_) => unusable(path + ": " + read_refusal(path))
    }
}

/// The canonical text of `page` written back to its file, where it differs from what is there.
// example: source_formatted(Page { source: "fn (", path: "a.lm" }).status == 1
fn source_formatted(page: Page) -> Said {
    match format.format(page.source) {
        Ok(canonical) => rewritten(page, canonical)
        Err(error) => refused_each([parse_diagnostic(error)], page)
    }
}

/// `canonical` written over the file of `page`, and nothing written where the two are the same.
// example: rewritten(Page { source: "a", path: "no-such-directory/a.lm" }, "a").status == 0
fn rewritten(page: Page, canonical: String) -> Said {
    if canonical == page.source {
        return nothing_said()
    }
    match files.write(page.path, canonical) {
        Ok(_) => nothing_said()
        Err(_) => unusable(page.path + ": " + write_refusal(page.path))
    }
}

/// Reports the first thing about a file or a package the compiler will not have.
///
/// A directory is a package, so every module of it is checked rather than one file, which
/// `docs/specs/packages.md` states.
// example: checked_said(Checking { path: "no-such-directory/a.lm", form: AsPage }, ir.little_library()).status == 2
fn checked_said(checking: Checking, library: ir.Library) -> Said {
    if is_folder(place_at(checking.path)) {
        return across(checking.path, CheckingAs(checking.form), library)
    }
    match checked(checking.path, library) {
        Ok(_) => nothing_said()
        Err(not) => not_compiled_said(not, checking.form)
    }
}

/// Writes the class files of `path` under `target/` in its directory, one for each class.
// example: built_said("no-such-directory/a.lm", ir.little_library()).status == 2
fn built_said(path: String, library: ir.Library) -> Said {
    if is_folder(place_at(path)) {
        return across(path, Building, library)
    }
    match built(path, library) {
        Ok(_) => nothing_said()
        Err(said) => said
    }
}

/// Runs `over` on every module of the package in `directory`, stopping at the first refusal.
///
/// A directory holding no manifest is no package. The modules are the entries whose name ends
/// in `.lm`, in the order their names sort. A package whose directory cannot be listed is refused.
// example: across("no-such-directory", Building, ir.little_library()).errors == "error: no-such-directory: there is no package here, which is a directory holding `bux.package`\n"
fn across(directory: String, over: Over, library: ir.Library) -> Said {
    if !modules.is_file(modules.file_at(modules.joined(directory, "bux.package"))) {
        return unusable(directory + ": there is no package here, which is a directory holding `bux.package`")
    }
    match files.listed(directory) {
        Ok(names) => every_module_said(Package { directory: directory, names: names }, over, library)
        Err(_) => unusable(directory + ": Permission denied (os error 13)")
    }
}

/// Runs `over` on every module among the entries of `package`, stopping at the first refusal.
// example: every_module_said(Package { directory: "no-such-directory", names: ["a.txt"] }, Building, ir.little_library()).status == 0
fn every_module_said(package: Package, over: Over, library: ir.Library) -> Said {
    for name in package.names {
        if is_a_module_name(name) {
            said := module_said(modules.joined(package.directory, name), over, library)
            if said.status != 0 {
                return said
            }
        }
    }
    nothing_said()
}

/// Whether a file called `name` is a module: its extension is `lm`, after a dot that opens no name.
// example: is_a_module_name("a.lm")
// example: !is_a_module_name(".lm")
fn is_a_module_name(name: String) -> Bool {
    dot := last_dot(name)
    dot > 0 && or(strings.cut(name, dot + 1, strings.length(name)), "") == "lm"
}

/// Where the last dot of `name` is, and `-1` where it holds none.
// example: last_dot("a.b.lm") == 3
fn last_dot(name: String) -> Int {
    var found = -1
    var index = 0
    for index < strings.length(name) {
        if or(strings.at(name, index), 0) == 46 {
            found = index
        }
        index += 1
    }
    found
}

/// What one module of a package says, under the command the package was given to.
// example: module_said("no-such-directory/a.lm", Building, ir.little_library()).status == 2
fn module_said(path: String, over: Over, library: ir.Library) -> Said {
    match over {
        CheckingAs(form) => checked_said(Checking { path: path, form: form }, library)
        Building => built_said(path, library)
    }
}

/// Builds `started.file` and names the program it holds, which ends however that program ends.
///
/// The program is compiled before the JDK is looked for, so a program that does not compile is
/// told so on a machine that could not have run it anyway.
// example: said_by(started(Started { file: "no-such-directory/a.lm", arguments: [] }, ir.little_library())).status == 2
fn started(asked: Started, library: ir.Library) -> Answer {
    match built(asked.file, library) {
        Ok(done) => built_started(done, asked)
        Err(said) => Spoken(said)
    }
}

/// The program `done` holds, started with the words `asked` gives it, where it is one.
// example: said_by(built_started(Built { module: "a", target: "", starts: false }, Started { file: "a.lm", arguments: [] })).errors == "error: a.lm: a module is run through `fn main(arguments: List<String>) -> Int`, which this one does not declare\n"
fn built_started(done: Built, asked: Started) -> Answer {
    if !done.starts {
        return Spoken(unusable(asked.file + ": a module is run through `fn main(arguments: List<String>) -> Int`, which this one does not declare"))
    }
    match java_found() {
        Ok(java) => Starts(program_line(java: java, classes: done.target, module: done.module, arguments: asked.arguments))
        Err(said) => Spoken(said)
    }
}

/// Compiles `path` and every module it reaches, writing every class into the one `target_of(path)`.
///
/// A module is a class of its own, so a program of several modules is several classes, and a JVM
/// is started on the one the command named. `docs/specs/modules.md` states the order.
// example: is_refused(built("no-such-directory/a.lm", ir.little_library()))
fn built(path: String, library: ir.Library) -> Result<Built, Said> {
    program := page_said(checked(path, library))?
    module := named_module(program.root.module.path)?
    lowered := page_said(lowered_of(program, library))?
    classes := page_said(written_of(lowered, program))?
    target := target_of(path)
    _ = classes_written(classes, target)?
    Ok(Built { module: module, target: target, starts: is_a_program(lowered) })
}

/// The one directory a build of `path` writes every class into: `target/` beside the module.
///
/// A module of a package sits in the package's directory, so this is the package's `target/`.
/// No class lands beside a source, and deleting this directory is a clean build.
// example: target_of("compiler/main.lm") == "compiler/target"
// example: target_of("main.lm") == "target"
fn target_of(path: String) -> String {
    modules.joined(modules.directory_of(path), "target")
}

/// Whether a build was refused, which is what the examples of a build that fails read.
// example: is_refused(Err(nothing_said()))
fn is_refused<T>(answer: Result<T, Said>) -> Bool {
    match answer {
        Ok(_) => false
        Err(_) => true
    }
}

/// A refusal of compiling said as a page for a reader, where there is one.
// example: is_refused(page_said(Err(Unusable("error: gone\n"))))
fn page_said<T>(answer: Result<T, NotCompiled>) -> Result<T, Said> {
    match answer {
        Ok(value) => Ok(value)
        Err(not) => Err(not_compiled_said(not, AsPage))
    }
}

/// Whether the last module lowered declares `main` in the one shape a program starts at.
///
/// The module is the one the command named, which lowers last, and its class is the first it
/// writes. `main` takes the arguments as a `String[]`, which is what a JVM starts a class with.
// example: !is_a_program([])
fn is_a_program(lowered: List<ir.Lowered>) -> Bool {
    match list.at(lowered, list.length(lowered) - 1) {
        Some(module) => has_main(module.classes)
        None => false
    }
}

/// Whether the first of `classes` has a `main` that takes the arguments a JVM starts it with.
// example: !has_main([])
fn has_main(classes: List<ir.Class>) -> Bool {
    match list.at(classes, 0) {
        Some(class) => has_starting_method(class.methods)
        None => false
    }
}

/// Whether one of `methods` is `main`, taking an array of strings and nothing else.
// example: !has_starting_method([])
fn has_starting_method(methods: List<ir.Method>) -> Bool {
    for method in methods {
        if method.name == "main" && has_prefix(text: ir.method_descriptor_text(method.descriptor), opening: "([Ljava/lang/String;)") {
            return true
        }
    }
    false
}

/// Runs every example the module in `path` states, reporting each that did not hold.
///
/// `docs/specs/doc-examples.md` says what an example is and what running one amounts to. A
/// module that states none has nothing to run, which is a run that held.
// example: tested("no-such-directory/a.lm", ir.little_library()).status == 2
fn tested(path: String, library: ir.Library) -> Said {
    match checked(path, library) {
        Ok(program) => program_tested(program, library)
        Err(not) => not_compiled_said(not, AsPage)
    }
}

/// The examples of the module `program` was checked for, run, or the reason there is no run.
// example: program_tested(Checked { modules: [], root: Typed { module: modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") } }, ir.little_library()).status == 0
fn program_tested(program: Checked, library: ir.Library) -> Said {
    root := program.root
    match stated_in(root) {
        Ok(found) => run_held(found, root, library)
        Err(refusals) => refused_each(refusals, page_of(root))
    }
}

/// What the run of the examples found, and nothing where the module states none.
// example: run_held(None, Typed { module: modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }, ir.little_library()).status == 0
fn run_held(found: Option<Run>, root: Typed, library: ir.Library) -> Said {
    match found {
        Some(run) => settled(examples_held(run, root, library))
        None => nothing_said()
    }
}

/// The one answer either side of `answer` holds.
// example: settled(Err(nothing_said())).status == 0
fn settled(answer: Result<Said, Said>) -> Said {
    match answer {
        Ok(said) => said
        Err(said) => said
    }
}

/// The run that tries the examples `root` states, where it states any.
// example: is_none_run(stated_in(Typed { module: modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }))
fn stated_in(root: Typed) -> Result<Option<Run>, List<Diagnostic>> {
    source := root.module.source
    program := root.inferred.resolved.program
    stated := stated_by(source, program)?
    if list.length(stated) == 0 {
        return Ok(None)
    }
    match run_of(Page { source: source, path: root.module.path }, program, stated) {
        Ok(run) => Ok(Some(run))
        Err(reached) => Err([reached])
    }
}

/// Whether reading the examples found no run to start.
// example: is_none_run(Ok(None))
fn is_none_run(found: Result<Option<Run>, List<Diagnostic>>) -> Bool {
    match found {
        Ok(None) => true
        _ => false
    }
}

/// Compiles the module `run` wrote, starts it, and reports every example that did not hold.
///
/// The class files go somewhere of the run's own, so nothing a build wrote is touched, and that
/// place is taken away again whether the examples held or not. Every module the one under test
/// imports is written there too, because the run reaches them as the module does.
// example: is_refused(examples_held(Run { source: "", stretches: [], examples: [], module: lexer.Span { start: 0, length: 0 } }, Typed { module: modules.Module { name: "main", path: "a.b.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }, ir.little_library()))
fn examples_held(run: Run, root: Typed, library: ir.Library) -> Result<Said, Said> {
    module := named_module(root.module.path)?
    classes := refusing(run_classes(run, root, library), run, root)?
    java := java_found()?
    beside := somewhere_of_its_own()?
    said := ran_in(Beside { java: java, module: module, beside: beside }, classes, run, root)
    removed_whole(beside)
    Ok(said)
}

/// The `java` of the JDK `JAVA_HOME` names, which is the only JVM a run ever reaches for.
// example: ok_or(java_found(), "") != "java"
fn java_found() -> Result<String, Said> {
    home := or(environment.read("JAVA_HOME"), "")
    if home == "" {
        return Err(unusable("JAVA_HOME is not set, and running a program needs the JDK it names"))
    }
    java := modules.joined(modules.joined(home, "bin"), "java")
    if !modules.is_file(modules.file_at(java)) {
        return Err(unusable(java + ": JAVA_HOME names no JDK"))
    }
    Ok(java)
}

/// The module `path` names, which is the name of its file without what follows the last dot.
///
/// A module class is named after the file, so a file whose name is not one a class may have
/// leaves nothing to write: a JVM would refuse to load what came out.
// example: ok_or(named_module("a/b.lm"), "") == "b"
// example: is_refused(named_module("a.b.lm"))
fn named_module(path: String) -> Result<String, Said> {
    stem := modules.stem_of(path)
    if stem == "" || has_unit_of(stem, [46, 59, 91, 47]) {
        return Err(unusable(path + ": a module is named by its file, and a class name holds none of ['.', ';', '[', '/']"))
    }
    Ok(stem)
}

/// Whether `text` holds one of the code units `units` lists.
// example: has_unit_of("a;b", [59])
fn has_unit_of(text: String, units: List<Int>) -> Bool {
    var index = 0
    for index < strings.length(text) {
        if list.has_value(units, or(strings.at(text, index), 0)) {
            return true
        }
        index += 1
    }
    false
}

/// The class files of the modules of the run, checked as the run wrote them, lowered, and written.
// example: !is_refused(page_said(run_classes(Run { source: "", stretches: [], examples: [], module: lexer.Span { start: 0, length: 0 } }, Typed { module: modules.Module { name: "main", path: "no-such-directory/main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }, ir.little_library())))
fn run_classes(run: Run, root: Typed, library: ir.Library) -> Result<List<jvm.ClassFile>, NotCompiled> {
    run_classes_once(run, root, library, no_memo()).found
}

/// The class files of the modules of the run, checked as the run wrote them, lowered, and
/// written, each module typed once.
///
/// The run stands where the module under test stands, and it is typed anew, because its text is
/// not the text of that module. Every module it imports is taken from `memo` where it is there.
// example: !is_refused(page_said(run_classes_once(Run { source: "", stretches: [], examples: [], module: lexer.Span { start: 0, length: 0 } }, Typed { module: modules.Module { name: "main", path: "no-such-directory/main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }, ir.little_library(), no_memo()).found))
fn run_classes_once(run: Run, root: Typed, library: ir.Library, memo: Memo) -> Memoed<List<jvm.ClassFile>> {
    written := written_once(Page { source: run.source, path: root.module.path }, library, memo)
    match written.found {
        Ok(program) => classes_once(program, library, written.memo)
        Err(not) => Memoed { found: Err(not), memo: written.memo }
    }
}

/// A refusal of the run, shown against the file a reader would go and change.
///
/// A refusal of the run's own module points into the module the compiler wrote, so it is put back
/// into the file the author wrote first. One of a module the run imports points into that
/// module's own file already, and is shown there.
// example: !is_refused(refusing(Ok(1), Run { source: "", stretches: [], examples: [], module: lexer.Span { start: 0, length: 0 } }, Typed { module: modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }))
fn refusing<T>(answer: Result<T, NotCompiled>, run: Run, root: Typed) -> Result<T, Said> {
    match answer {
        Ok(value) => Ok(value)
        Err(not) => Err(run_refused(not, run, root))
    }
}

/// What a refusal of the run says, put back into the file of the module under test.
// example: run_refused(Unusable("error: gone\n"), Run { source: "", stretches: [], examples: [], module: lexer.Span { start: 0, length: 0 } }, Typed { module: modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }).status == 2
fn run_refused(not: NotCompiled, run: Run, root: Typed) -> Said {
    match not {
        Unusable(errors) => Said { output: "", errors: errors, status: 2 }
        Refused(refused) => put_back(refused, run, root)
    }
}

/// The refusals of the run, each about the line in the file it was written from.
// example: put_back(Refusal { diagnostics: [], page: Page { source: "", path: "b.lm" } }, Run { source: "", stretches: [], examples: [], module: lexer.Span { start: 0, length: 0 } }, Typed { module: modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }).status == 1
fn put_back(refused: Refusal, run: Run, root: Typed) -> Said {
    if refused.page.path != root.module.path {
        return refused_each(refused.diagnostics, refused.page)
    }
    var about = []
    for diagnostic in refused.diagnostics {
        about = list.push(about, diagnostic { span: in_original(run, diagnostic.span), fix: None })
    }
    refused_each(about, page_of(root))
}

/// The classes written into `beside.beside`, the run started there, and what it found.
// example: ran_in(Beside { java: "no-such-java", module: "a", beside: "no-such-directory/a" }, [], Run { source: "", stretches: [], examples: [], module: lexer.Span { start: 0, length: 0 } }, Typed { module: modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }).status == 2
fn ran_in(beside: Beside, classes: List<jvm.ClassFile>, run: Run, root: Typed) -> Said {
    match classes_written(classes, beside.beside) {
        Ok(_) => run_ended(program_finished(program_line(java: beside.java, classes: beside.beside, module: beside.module, arguments: [])), beside.java, run, root)
        Err(said) => said
    }
}

/// What the program `line` starts wrote, and the status it ended with, or why it never started.
///
/// The program reads the standard input of this process, as a program that `programs.run` starts
/// does, and it starts with the environment that `cleared` leaves.
// example: ok_or(program_finished(["no-such-program-at-all"]), programs.Finished { code: 9, output: "", errors: "" }).code == 9
fn program_finished(line: List<String>) -> Result<programs.Finished, String> {
    ran := programs.started(programs.reading_from(cleared(programs.of_command(line)), programs.inherited()))?
    output := programs.whole(programs.output_of(ran))
    errors := programs.whole(programs.errors_of(ran))
    code := programs.waited_for(ran)?
    Ok(programs.Finished { code: code, output: output, errors: errors })
}

/// The line that starts a JVM on the class `module` in `classes`, which `arguments` then follow.
///
/// `docs/specs/run.md` states each flag: the preview that a value class needs, no module outside
/// `java.base`, and no class that a stream of serialized bytes names.
// example: list.length(program_line(java: "java", classes: "a", module: "b", arguments: ["c"])) == 9
// example: or(list.at(program_line(java: "java", classes: "a", module: "b", arguments: []), 4), "") == "-Djdk.serialFilter=!*"
fn program_line(java: String, classes: String, module: String, arguments: List<String>) -> List<String> {
    all_of(values: [java, "--enable-preview", "--limit-modules", "java.base", "-Djdk.serialFilter=!*", "-cp", classes, module], more: arguments)
}

/// The builder, with each variable removed that a JVM reads options from.
///
/// Each of the three can add a `-javaagent` to the program, and `docs/specs/run.md` states why.
/// No other variable of the environment changes.
// example: or(list.at(injecting(), 0), "") == "JAVA_TOOL_OPTIONS"
fn cleared(builder: programs.ProcessBuilder) -> programs.ProcessBuilder {
    variables := variables_of(builder)
    for name in injecting() {
        _ = removed(variables, as_object(held_as_constant(name)))
    }
    builder
}

/// The variables of the environment that a JVM reads options from.
// example: list.length(injecting()) == 3
fn injecting() -> List<String> {
    ["JAVA_TOOL_OPTIONS", "JDK_JAVA_OPTIONS", "_JAVA_OPTIONS"]
}

/// Writes each class into the directory `into`, at the path its name gives it there.
// example: !is_refused(classes_written([], "no-such-directory"))
fn classes_written(classes: List<jvm.ClassFile>, into: String) -> Result<(), Said> {
    for class in classes {
        written := modules.joined(into, class.path)
        package := modules.directory_of(written)
        if !is_folder(place_at(package)) && !has_made_all(place_at(package)) {
            return Err(unusable(package + ": " + making_refusal(package)))
        }
        if is_refused_write(files.write_bytes(written, class.bytes)) {
            return Err(unusable(written + ": " + write_refusal(written)))
        }
    }
    Ok(())
}

/// Whether a write did not reach its file.
// example: is_refused_write(Err("gone"))
fn is_refused_write(answer: Result<String, String>) -> Bool {
    match answer {
        Ok(_) => false
        Err(_) => true
    }
}

/// What the run wrote, read for every example that did not hold, or why it could not be read.
///
/// A run that did not end with status 0 did not reach the end of its examples, so what it wrote
/// on standard error is passed on and the command cannot say whether they hold.
// example: run_ended(Err("gone"), "java", Run { source: "", stretches: [], examples: [], module: lexer.Span { start: 0, length: 0 } }, Typed { module: modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }).errors == "error: java: gone\n"
fn run_ended(completion: Result<programs.Finished, String>, java: String, run: Run, root: Typed) -> Said {
    match completion {
        Ok(finished) => finished_read(finished, run, root)
        Err(why) => unusable(java + ": " + why)
    }
}

/// Every example the run wrote a line about, which is every one that did not hold.
// example: finished_read(programs.Finished { code: 1, output: "", errors: "boom\n" }, Run { source: "", stretches: [], examples: [], module: lexer.Span { start: 0, length: 0 } }, Typed { module: modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }).errors == "boom\n"
fn finished_read(finished: programs.Finished, run: Run, root: Typed) -> Said {
    if finished.code != 0 {
        return Said { output: "", errors: finished.errors, status: 2 }
    }
    var refusals = []
    for line in lines_of(finished.output) {
        refusals = match named_in(run, line) {
            Some(example) => list.push(refusals, did_not_hold(example))
            None => refusals
        }
    }
    if list.length(refusals) == 0 {
        return nothing_said()
    }
    refused_each(refusals, page_of(root))
}

/// Every line of `text`, each without its line break.
// example: list.length(lines_of("a\nb\n")) == 2
fn lines_of(text: String) -> List<String> {
    var lines = []
    var start = 0
    var index = 0
    for index < strings.length(text) {
        if or(strings.at(text, index), 0) == 10 {
            lines = list.push(lines, or(strings.cut(text, start, index), ""))
            start = index + 1
        }
        index += 1
    }
    if start < strings.length(text) {
        lines = list.push(lines, or(strings.cut(text, start, strings.length(text)), ""))
    }
    lines
}

/// A directory made for one run, which nothing else holds.
///
/// It is made here rather than found, so a run never opens one that was already there: the
/// temporary directory is shared, and what a run writes into it is deleted whole.
// example: !is_refused(somewhere_of_its_own())
fn somewhere_of_its_own() -> Result<String, Said> {
    shared := or(environment.read("TMPDIR"), "/tmp")
    now := nanoseconds()
    var attempt = 0
    for attempt < 16 {
        beside := modules.joined(shared, "lumen-test-" + shown(now) + "-" + shown(attempt))
        if is_made(place_at(beside)) {
            return Ok(beside)
        }
        attempt += 1
    }
    Err(unusable(shared + ": nowhere to write the classes a run starts"))
}

/// Deletes `path` and everything it holds.
fn removed_whole(path: String) -> () {
    if is_folder(place_at(path)) {
        for name in ok_or(files.listed(path), []) {
            removed_whole(modules.joined(path, name))
        }
    }
    _ = files.removed(path)
}

/// Prints every name `path` declares at the top level, with the type it has.
// example: surface_said("no-such-directory/a.lm", ir.little_library()).status == 2
fn surface_said(path: String, library: ir.Library) -> Said {
    match checked(path, library) {
        Ok(program) => Said { output: types.page_of(program.root.inferred), errors: "", status: 0 }
        Err(not) => not_compiled_said(not, AsPage)
    }
}

/// Prints what one diagnostic code means, at more length than its `help:` line has room for.
// example: explained("L9999").status == 2
fn explained(code: String) -> Said {
    match explanation_of(code) {
        Some(text) => Said { output: text, errors: "", status: 0 }
        None => unusable("there is no diagnostic " + code)
    }
}

/// The long form of `code`, which the compiler carries as a resource, and `None` for no code.
///
/// A code is `L` and four digits, so no text reaches a resource other than an explanation.
// example: or(explanation_of("../x"), "none") == "none"
fn explanation_of(code: String) -> Option<String> {
    if !is_code_shaped(code) {
        return None
    }
    modules.resource_text("explanations/" + code + ".md")
}

/// Whether `code` is written as a code is: `L` and four digits.
// example: is_code_shaped("L0100")
// example: !is_code_shaped("L01")
fn is_code_shaped(code: String) -> Bool {
    if strings.length(code) != 5 || !has_prefix(text: code, opening: "L") {
        return false
    }
    var index = 1
    for index < 5 {
        if !is_digit(or(strings.at(code, index), 0)) {
            return false
        }
        index += 1
    }
    true
}

/// What a refusal of compiling says, as a page for a reader or as data for a tool.
// example: not_compiled_said(Unusable("error: gone\n"), AsPage).errors == "error: gone\n"
fn not_compiled_said(not: NotCompiled, form: Form) -> Said {
    match not {
        Unusable(errors) => Said { output: "", errors: errors, status: 2 }
        Refused(refused) => refused_in_form(refused, form)
    }
}

/// A refusal shown in `form`: every diagnostic as a page, or the first as one line of JSON.
///
/// Checking stops at the first refusal, so with `--json` there is the one to write.
// example: refused_in_form(Refusal { diagnostics: [], page: Page { source: "", path: "a.lm" } }, AsData).status == 1
fn refused_in_form(refused: Refusal, form: Form) -> Said {
    match form {
        AsPage => refused_each(refused.diagnostics, refused.page)
        AsData => Said { output: first_as_data(refused), errors: "", status: 1 }
    }
}

/// The first diagnostic of `refused`, as JSON.
// example: first_as_data(Refusal { diagnostics: [], page: Page { source: "", path: "a.lm" } }) == ""
fn first_as_data(refused: Refusal) -> String {
    match list.at(refused.diagnostics, 0) {
        Some(first) => json_of(first, refused.page.path)
        None => ""
    }
}

/// Refuses every one rather than the first, because a build is how a reader learns what is left.
///
/// The blank line between two blocks is what keeps them two blocks.
// example: refused_each([], Page { source: "", path: "a.lm" }).status == 1
fn refused_each(diagnostics: List<Diagnostic>, page: Page) -> Said {
    var errors = ""
    for diagnostic in diagnostics {
        if errors != "" {
            errors += "\n"
        }
        errors += rendered(diagnostic, page)
    }
    Said { output: "", errors: errors, status: 1 }
}

/// Nothing said, and status 0.
// example: nothing_said().output == ""
fn nothing_said() -> Said {
    Said { output: "", errors: "", status: 0 }
}

/// One line on standard error, and the status of a command that could not do its job at all.
// example: unusable("gone").errors == "error: gone\n"
fn unusable(line: String) -> Said {
    Said { output: "", errors: "error: " + line + "\n", status: 2 }
}

/// The program at `path` and every module it reaches, each held to everything a check holds.
///
/// Each module is held to canonical form, then resolved, typed, and checked for exhaustiveness, in
/// the order they load, so a module is checked after everything it imports.
// example: is_refused(page_said(checked("no-such-directory/a.lm", ir.little_library())))
fn checked(path: String, library: ir.Library) -> Result<Checked, NotCompiled> {
    checked_once(path, library, no_memo()).found
}

/// The program at `path`, checked as `checked` checks it, with each module typed once.
///
/// A module that `memo` holds is not typed again, and each module typed here is added to it. A
/// caller that hands the memo on from one call to the next types each module once, and the runner
/// does so. A command starts with an empty memo, so what it says never depends on one.
// example: is_refused(page_said(checked_once("no-such-directory/a.lm", ir.little_library(), no_memo()).found))
fn checked_once(path: String, library: ir.Library, memo: Memo) -> Memoed<Checked> {
    found := loaded_checked(path, library, memo)
    Memoed { found: found, memo: remembered(memo: memo, found: found, form: ToCanonicalForm) }
}

/// The program at `path`, loaded, and each of its modules accepted or taken from `memo`.
// example: is_refused(page_said(loaded_checked("no-such-directory/a.lm", ir.little_library(), no_memo())))
fn loaded_checked(path: String, library: ir.Library, memo: Memo) -> Result<Checked, NotCompiled> {
    loaded := loaded_or_refused(modules.load(path))?
    each_accepted(loaded, Accepting { imported: surface.nothing_imported(), form: ToCanonicalForm }, library, memo)
}

/// The modules `page.source` reaches, as though it were the file at `page.path`, each checked.
///
/// `lumen test` writes a module out of the module under test, and that module is compiled as it
/// was written: it is held to everything but canonical form, which the run does not keep.
// example: !is_refused(page_said(checked_as_written(Page { source: "fn one() -> Int {\n    1\n}\n", path: "no-such-directory/main.lm" }, ir.little_library())))
fn checked_as_written(page: Page, library: ir.Library) -> Result<Checked, NotCompiled> {
    written_once(page, library, no_memo()).found
}

/// The modules `page.source` reaches, checked as `checked_as_written` checks them, with each
/// module but the one written typed once.
// example: !is_refused(page_said(written_once(Page { source: "fn one() -> Int {\n    1\n}\n", path: "no-such-directory/main.lm" }, ir.little_library(), no_memo()).found))
fn written_once(page: Page, library: ir.Library, memo: Memo) -> Memoed<Checked> {
    found := loaded_written(page, library, memo)
    Memoed { found: found, memo: remembered(memo: memo, found: found, form: AsWritten) }
}

/// The modules `page.source` reaches, loaded, and each accepted or taken from `memo`.
// example: !is_refused(page_said(loaded_written(Page { source: "fn one() -> Int {\n    1\n}\n", path: "no-such-directory/main.lm" }, ir.little_library(), no_memo())))
fn loaded_written(page: Page, library: ir.Library, memo: Memo) -> Result<Checked, NotCompiled> {
    loaded := loaded_or_refused(modules.load_written(page.source, page.path))?
    each_accepted(loaded, Accepting { imported: surface.nothing_imported(), form: AsWritten }, library, memo)
}

/// Every module of `loaded` accepted in turn, or taken from `memo`, the last of them held to the
/// form `root` gives, with what `root` says is imported before the first.
// example: is_refused(page_said(each_accepted([], Accepting { imported: surface.nothing_imported(), form: ToCanonicalForm }, ir.little_library(), no_memo())))
fn each_accepted(loaded: List<modules.Module>, root: Accepting, library: ir.Library, memo: Memo) -> Result<Checked, NotCompiled> {
    var imported = root.imported
    var typed = []
    var index = 0
    for module in loaded {
        index += 1
        var form = ToCanonicalForm
        if index == list.length(loaded) {
            form = root.form
        }
        inferred := refused_in(accepted_once(module, Accepting { imported: imported, form: form }, Typing { library: library, memo: memo }), module)?
        typed = list.push(typed, Typed { module: module, inferred: inferred })
        imported = surface.offering(imported, module.name, types.surface_of(inferred))
    }
    rooted(typed)
}

/// The modules checked, with the last of them, which is the one the command named, as the root.
// example: is_refused(page_said(rooted([])))
fn rooted(typed: List<Typed>) -> Result<Checked, NotCompiled> {
    match list.at(typed, list.length(typed) - 1) {
        Some(root) => Ok(Checked { modules: typed, root: root })
        None => Err(Unusable(""))
    }
}

/// `answer`, with a refusal of it said about the file of `module`.
// example: is_refused(page_said(refused_in(Err(no_diagnostic()), modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } })))
fn refused_in<T>(answer: Result<T, Diagnostic>, module: modules.Module) -> Result<T, NotCompiled> {
    match answer {
        Ok(value) => Ok(value)
        Err(diagnostic) => Err(Refused(Refusal { diagnostics: [diagnostic], page: Page { source: module.source, path: module.path } }))
    }
}

/// The modules a load found, or why it found none: a file not read, or a refusal of one that was.
// example: is_refused(page_said(loaded_or_refused(Err(modules.Unreadable { path: "no-such-directory/a.lm", why: "" }))))
fn loaded_or_refused(answer: Result<List<modules.Module>, modules.NotLoaded>) -> Result<List<modules.Module>, NotCompiled> {
    match answer {
        Ok(loaded) => Ok(loaded)
        Err(not) => Err(not_loaded(not))
    }
}

/// What a load that stopped says: the file it could not read, or the refusal of one it read.
///
/// The reason a file could not be read is the one the Rust compiler gave, found by looking at
/// the path, because the JVM says it in words of its own.
// example: not_compiled_said(not_loaded(modules.Unreadable { path: "no-such-directory/a.lm", why: "" }), AsPage).errors == "error: no-such-directory/a.lm: No such file or directory (os error 2)\n"
fn not_loaded(not: modules.NotLoaded) -> NotCompiled {
    match not {
        modules.Unreadable { path, why } => Unusable("error: " + path + ": " + read_refusal(path) + "\n")
        modules.Unparsed { path, source, error } => Refused(Refusal { diagnostics: [parse_diagnostic(error)], page: Page { source: source, path: path } })
        modules.Refused { path, source, error } => Refused(Refusal { diagnostics: [load_diagnostic(error)], page: Page { source: source, path: path } })
    }
}

/// One module accepted, or the inference `typing.memo` holds of it already.
///
/// Only a module held to canonical form is looked up, because only such a module is remembered.
/// The inference is taken only where the text is the text that was typed.
// example: code_refused(accepted_once(modules.Module { name: "main", path: "main.lm", source: "fn (", program: ast.Program { items: [] } }, Accepting { imported: surface.nothing_imported(), form: AsWritten }, Typing { library: ir.little_library(), memo: no_memo() })) == ""
fn accepted_once(module: modules.Module, accepting: Accepting, typing: Typing) -> Result<infer.Inference, Diagnostic> {
    var found = None
    if accepting.form == ToCanonicalForm {
        found = map.get(typing.memo.typed, key_of(module))
    }
    match found {
        Some(one) => if one.module.source == module.source {
            Ok(one.inferred)
        } else {
            accepted(module, accepting, typing.library)
        }
        None => accepted(module, accepting, typing.library)
    }
}

/// One module held to `accepting.form`, then resolved, typed, and checked for exhaustiveness.
// example: code_refused(accepted(modules.Module { name: "main", path: "main.lm", source: "fn (", program: ast.Program { items: [] } }, Accepting { imported: surface.nothing_imported(), form: ToCanonicalForm }, ir.little_library())) == "L0100"
fn accepted(module: modules.Module, accepting: Accepting, library: ir.Library) -> Result<infer.Inference, Diagnostic> {
    if accepting.form == ToCanonicalForm {
        _ = in_canonical_form(module.source)?
    }
    resolved := resolved_of(resolver.resolve(module.program, module.name, library.prelude.names))?
    inferred := inferred_of(types.check(resolved, accepting.imported, library.prelude))?
    _ = exhaustive(exhaustiveness.check(inferred))?
    Ok(inferred)
}

/// The code a refusal carries, and `""` where there is none.
// example: code_refused(Err(no_diagnostic())) == "L0000"
fn code_refused<T>(answer: Result<T, Diagnostic>) -> String {
    match answer {
        Ok(_) => ""
        Err(diagnostic) => diagnostic.code
    }
}

/// Nothing where `source` is in canonical form, and the first thing about it that is not otherwise.
// example: code_refused(in_canonical_form("import files\n\nimport io\n")) == "L0200"
fn in_canonical_form(source: String) -> Result<(), Diagnostic> {
    match format.check(source) {
        Ok(_) => Ok(())
        Err(refused) => Err(check_diagnostic(refused, source))
    }
}

/// The program resolved, or the refusal of resolving it.
// example: code_refused(resolved_of(resolver.resolve(ast.Program { items: [] }, "main", types.little_prelude().names))) == ""
fn resolved_of(answer: Result<resolver.Resolved, resolver.ResolveError>) -> Result<resolver.Resolved, Diagnostic> {
    match answer {
        Ok(resolved) => Ok(resolved)
        Err(error) => Err(Diagnostic { code: resolver.code_of(error.kind), message: resolver.message(error.kind), span: error.span, help: help_written(resolver.help_of(error.kind)), fix: None })
    }
}

/// The program typed, or the refusal of typing it.
// example: code_refused(inferred_of(Ok(types.checked_of("")))) == ""
fn inferred_of(answer: Result<infer.Inference, refusal.TypeError>) -> Result<infer.Inference, Diagnostic> {
    match answer {
        Ok(inferred) => Ok(inferred)
        Err(error) => Err(Diagnostic { code: refusal.code_of(error.kind), message: refusal.message(error.kind), span: error.span, help: help_written(refusal.help_of(error.kind)), fix: None })
    }
}

/// Nothing where every `match` answers for every value, or the refusal of the first that does not.
// example: code_refused(exhaustive(Ok(()))) == ""
fn exhaustive(answer: Result<(), exhaustiveness.MatchError>) -> Result<(), Diagnostic> {
    match answer {
        Ok(_) => Ok(())
        Err(error) => Err(Diagnostic { code: exhaustiveness.code_of(error), message: exhaustiveness.message_of(error), span: exhaustiveness.span_of(error), help: help_written(exhaustiveness.help_of(error)), fix: None })
    }
}

/// A parse error as the diagnostic the reader is shown.
// example: parse_diagnostic(parser.ParseError { kind: parser.ChainedComparison, span: lexer.Span { start: 0, length: 1 } }).code == "L0105"
fn parse_diagnostic(error: parser.ParseError) -> Diagnostic {
    Diagnostic { code: parser.code_of(error.kind), message: parser.message(error.kind), span: error.span, help: help_written(parser.help_of(error.kind)), fix: None }
}

/// A refusal of loading as the diagnostic the reader is shown.
// example: load_diagnostic(modules.LoadError { kind: modules.Ring(["main"]), span: lexer.Span { start: 0, length: 1 } }).code == "L0307"
fn load_diagnostic(error: modules.LoadError) -> Diagnostic {
    Diagnostic { code: modules.code_of(error.kind), message: modules.message(error.kind), span: error.span, help: help_written(modules.help_of(error.kind)), fix: None }
}

/// A refusal of canonical form as the diagnostic the reader is shown, with its edit.
///
/// The one refusal that carries an edit is a file that departs from canonical form, because the
/// compiler knows the answer: the canonical text, in place of the whole file.
// example: is_fixed(check_diagnostic(format.NotCanonical { deviation: format.Ending(lexer.Span { start: 0, length: 1 }), canonical: "a\n" }, "a"))
fn check_diagnostic(refused: format.CheckError, source: String) -> Diagnostic {
    Diagnostic { code: format.code_of(refused), message: format.message_of(refused), span: format.span_of(refused), help: help_written(format.help_of(refused)), fix: fix_of(refused, source) }
}

/// Whether a diagnostic carries an edit.
// example: !is_fixed(no_diagnostic())
fn is_fixed(diagnostic: Diagnostic) -> Bool {
    match diagnostic.fix {
        Some(_) => true
        None => false
    }
}

/// The edit that answers `refused`, where there is one: the canonical text for the whole file.
// example: is_fixed(Diagnostic { code: "", message: "", span: lexer.Span { start: 0, length: 0 }, help: None, fix: fix_of(format.NotCanonical { deviation: format.ExtraLine(lexer.Span { start: 0, length: 1 }), canonical: "a\n" }, "a") })
fn fix_of(refused: format.CheckError, source: String) -> Option<Fix> {
    match refused {
        format.NotCanonical { deviation, canonical } => Some(Fix { span: lexer.Span { start: 0, length: byte_count(source) }, text: canonical })
        _ => None
    }
}

/// The `help:` line of a diagnostic, and `None` where the phase that refused has none to give.
// example: !is_stated(help_written(""))
fn help_written(help: String) -> Option<String> {
    if help == "" {
        return None
    }
    Some(help)
}

/// Every module of `program` lowered as `lowered_once` lowers it, then written as class files.
// example: list.length(ok_or(classes_once(Checked { modules: [], root: Typed { module: modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") } }, ir.little_library(), no_memo()).found, [])) > 0
fn classes_once(program: Checked, library: ir.Library, memo: Memo) -> Memoed<List<jvm.ClassFile>> {
    lowered := lowered_once(program, library, memo)
    match lowered.found {
        Ok(passes) => Memoed { found: written_of(passes, program), memo: lowered.memo }
        Err(not) => Memoed { found: Err(not), memo: lowered.memo }
    }
}

/// Every module of `program` checked for holes and examples, root first, then lowered.
///
/// A build refuses a hole, and it refuses a function that states no example and an example that
/// documents nothing. Each is refused whole, every hole or every example of one module, because a
/// build is how a reader learns what is left. Lowering refuses nothing.
// example: list.length(ok_or(lowered_of(Checked { modules: [], root: Typed { module: modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") } }, ir.little_library()), [])) == 1
fn lowered_of(program: Checked, library: ir.Library) -> Result<List<ir.Lowered>, NotCompiled> {
    lowered_once(program, library, no_memo()).found
}

/// Every module of `program` checked for holes and examples, as `lowered_of` checks them, then
/// lowered, with each module that `memo` found whole already not checked again.
// example: list.length(ok_or(lowered_once(Checked { modules: [], root: Typed { module: modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") } }, ir.little_library(), no_memo()).found, [])) == 1
fn lowered_once(program: Checked, library: ir.Library, memo: Memo) -> Memoed<List<ir.Lowered>> {
    match each_whole(program.modules, memo) {
        Ok(kept) => Memoed { found: Ok(passes_of(program, library)), memo: kept }
        Err(not) => Memoed { found: Err(not), memo: memo }
    }
}

/// `memo` with every module of `typed` found whole, root first, or the refusal of the first
/// that is not.
///
/// A module is marked whole only where `memo` holds it with the same text. A run stands at the
/// path of the module it tests, and its text is not that module's, so it is never marked.
// example: !is_refused(page_said(each_whole([], no_memo())))
fn each_whole(typed: List<Typed>, memo: Memo) -> Result<Memo, NotCompiled> {
    var kept = memo
    for one in turned(typed) {
        if !is_whole_already(one, kept) {
            _ = whole(one)?
            if is_remembered_as(one, kept) {
                kept = kept { whole: set.insert(kept.whole, key_of(one.module)) }
            }
        }
    }
    Ok(kept)
}

/// Whether `memo` found the module `one` whole already, which it did only for the same text.
// example: !is_whole_already(Typed { module: modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }, no_memo())
fn is_whole_already(one: Typed, memo: Memo) -> Bool {
    is_remembered_as(one, memo) && set.has_value(memo.whole, key_of(one.module))
}

/// Whether `memo` holds the module `one` with the text `one` has.
// example: !is_remembered_as(Typed { module: modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }, no_memo())
fn is_remembered_as(one: Typed, memo: Memo) -> Bool {
    match map.get(memo.typed, key_of(one.module)) {
        Some(typed) => typed.module.source == one.module.source
        None => false
    }
}

/// Every module of `program` lowered, as the passes of the lowering lower a whole program.
// example: list.length(passes_of(Checked { modules: [], root: Typed { module: modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") } }, ir.little_library())) == 1
fn passes_of(program: Checked, library: ir.Library) -> List<ir.Lowered> {
    var typed = []
    for one in program.modules {
        typed = list.push(typed, one.inferred)
    }
    ir.passes_lowered(typed, library)
}

/// A memo that holds no module, which is where every command starts.
// example: !set.has_value(no_memo().whole, "main.lm")
fn no_memo() -> Memo {
    Memo { typed: map.empty(), whole: set.empty() }
}

/// `memo` with every module of `found` that is typed as a file is typed, where `found` is a program.
///
/// A root held only to what it was written as is not the file at its path, so it is not remembered.
// example: !is_typed(remembered(memo: no_memo(), found: Err(Unusable("")), form: ToCanonicalForm), "main.lm")
fn remembered(memo: Memo, found: Result<Checked, NotCompiled>, form: RootForm) -> Memo {
    match found {
        Ok(program) => each_remembered(memo: memo, program: program, form: form)
        Err(_) => memo
    }
}

/// `memo` with every module of `program`, and its root only where the root is in canonical form.
///
/// A module `memo` holds already keeps the text it was typed from, so a mark of `whole` stays true.
// example: !is_typed(each_remembered(memo: no_memo(), program: Checked { modules: [], root: Typed { module: modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") } }, form: AsWritten), "main.lm")
fn each_remembered(memo: Memo, program: Checked, form: RootForm) -> Memo {
    var kept = memo
    var index = 0
    for one in program.modules {
        index += 1
        if (index < list.length(program.modules) || form == ToCanonicalForm) && !is_typed(kept, one.module.path) {
            kept = kept { typed: map.insert(kept.typed, key_of(one.module), one) }
        }
    }
    kept
}

/// The key a module is remembered under: the canonical path of its file.
// example: key_of(modules.Module { name: "main", path: "no-such-directory/../main.lm", source: "", program: ast.Program { items: [] } }) != "no-such-directory/../main.lm"
fn key_of(module: modules.Module) -> String {
    modules.route_to(module.path).found
}

/// Whether `memo` holds a module typed from the file at `path`.
// example: !is_typed(no_memo(), "main.lm")
fn is_typed(memo: Memo, path: String) -> Bool {
    match map.get(memo.typed, modules.route_to(path).found) {
        Some(_) => true
        None => false
    }
}

/// The class files of `lowered`, or the refusal of the writer, shown in the module it is about.
// example: !is_refused(page_said(written_of([], Checked { modules: [], root: Typed { module: modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") } })))
fn written_of(lowered: List<ir.Lowered>, program: Checked) -> Result<List<jvm.ClassFile>, NotCompiled> {
    match jvm.program_written(lowered) {
        Ok(classes) => Ok(classes)
        Err(unwritten) => Err(Refused(unwritten_refused(unwritten, program)))
    }
}

/// A class the writer did not write, as a refusal of the module whose class it is.
///
/// It points at the function the method is written for, where the module declares one of that
/// name, and at the start of the module otherwise. A class of the prelude is shown in the root.
// example: first_of(unwritten_refused(jvm.Unwritten { class: "main", method: Some("f"), why: jvm.TooLarge }, Checked { modules: [], root: Typed { module: modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") } })).code == "L0700"
fn unwritten_refused(unwritten: jvm.Unwritten, program: Checked) -> Refusal {
    one := owning(program, unwritten.class)
    diagnostic := Diagnostic { code: jvm.code_of(unwritten.why), message: jvm.message(unwritten), span: declared_span(one, jvm.named_in(unwritten)), help: Some(jvm.help_of(unwritten.why)), fix: None }
    Refusal { diagnostics: [diagnostic], page: page_of(one) }
}

/// The module of `program` whose class `class` is, which is the root where no module is.
///
/// Where two modules have that name, it is the one loaded last, which is the program's own
/// where the other is a module the library carries.
// example: owning(Checked { modules: [], root: Typed { module: modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") } }, "demo/Box").module.name == "main"
fn owning(program: Checked, class: String) -> Typed {
    var owner = program.root
    for one in program.modules {
        if jvm.module_of(class) == one.module.name {
            owner = one
        }
    }
    owner
}

/// The span of the name of the function `named` that `one` declares, or the start of the module.
// example: declared_span(Typed { module: modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }, "f").length == 0
fn declared_span(one: Typed, named: String) -> lexer.Span {
    for function in infer.functions_of(one.module.program) {
        if function.name.text == named {
            return function.name.span
        }
    }
    lexer.Span { start: 0, length: 0 }
}

/// The first diagnostic of `refused`, which a refusal of the writer holds one of.
// example: first_of(Refusal { diagnostics: [], page: Page { source: "", path: "a.lm" } }).code == ""
fn first_of(refused: Refusal) -> Diagnostic {
    or(list.at(refused.diagnostics, 0), Diagnostic { code: "", message: "", span: lexer.Span { start: 0, length: 0 }, help: None, fix: None })
}

/// Nothing where `one` holds no hole and states an example for each function, else every refusal.
// example: !is_refused(page_said(whole(Typed { module: modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") })))
fn whole(one: Typed) -> Result<(), NotCompiled> {
    page := page_of(one)
    found := holes.of_module(one.inferred.resolved)
    if list.length(found) > 0 {
        return Err(Refused(Refusal { diagnostics: holes_refused(found), page: page }))
    }
    match stated_by(page.source, one.inferred.resolved.program) {
        Ok(_) => Ok(())
        Err(refusals) => Err(Refused(Refusal { diagnostics: refusals, page: page }))
    }
}

/// The page a module is shown on: its source, and the path of its file.
// example: page_of(Typed { module: modules.Module { name: "main", path: "main.lm", source: "", program: ast.Program { items: [] } }, inferred: types.checked_of("") }).path == "main.lm"
fn page_of(one: Typed) -> Page {
    Page { source: one.module.source, path: one.module.path }
}

/// Each hole as the diagnostic the reader is shown.
// example: list.length(holes_refused([holes.Hole { span: lexer.Span { start: 0, length: 1 } }])) == 1
fn holes_refused(found: List<holes.Hole>) -> List<Diagnostic> {
    var refusals = []
    for hole in found {
        refusals = list.push(refusals, Diagnostic { code: "L0600", message: "this hole is not compiled", span: hole.span, help: Some("`lumen check` accepts a hole; fill it in, or build a module that holds none"), fix: None })
    }
    refusals
}

/// Every example `source` states, or every refusal of how it states them, in the order written.
///
/// `docs/specs/doc-examples.md` states the rules. A function other than `main` whose result is
/// not `()` states at least one example, and every example is in the comment above a function.
// example: list.length(ok_or(stated_by("", ast.Program { items: [] }), [])) == 0
fn stated_by(source: String, program: ast.Program) -> Result<List<Example>, List<Diagnostic>> {
    written := commented_of(source)
    var stated = []
    var refused_none = []
    for function in documented(program) {
        theirs := examples_of(written, function)
        if list.length(theirs) == 0 {
            refused_none = list.push(refused_none, Diagnostic { code: "L0601", message: "`" + function.name.text + "` states no example", span: function.name.span, help: Some("write `// example: <an expression that is true>` in the comment above it"), fix: None })
        }
        stated = all_of(values: stated, more: theirs)
    }
    refusals := in_order(first: refused_none, second: documenting_nothing(written, stated))
    if list.length(refusals) > 0 {
        return Err(refusals)
    }
    Ok(stated)
}

/// `values`, then every value of `more`.
// example: list.length(all_of(values: [1], more: [2, 3])) == 3
fn all_of<T>(values: List<T>, more: List<T>) -> List<T> {
    var joined = values
    for value in more {
        joined = list.push(joined, value)
    }
    joined
}

/// The refusals of both lists, in the order of where they start, the first list first on a tie.
// example: list.length(in_order(first: [no_diagnostic()], second: [no_diagnostic()])) == 2
fn in_order(first: List<Diagnostic>, second: List<Diagnostic>) -> List<Diagnostic> {
    var merged = []
    var left = 0
    var right = 0
    for left < list.length(first) || right < list.length(second) {
        one := or(list.at(first, left), no_diagnostic())
        other := or(list.at(second, right), no_diagnostic())
        if right >= list.length(second) || left < list.length(first) && one.span.start <= other.span.start {
            merged = list.push(merged, one)
            left += 1
        } else {
            merged = list.push(merged, other)
            right += 1
        }
    }
    merged
}

/// A diagnostic about nothing, which the examples refuse with.
// example: no_diagnostic().code == "L0000"
fn no_diagnostic() -> Diagnostic {
    Diagnostic { code: "L0000", message: "", span: lexer.Span { start: 0, length: 0 }, help: None, fix: None }
}

/// The functions that state examples: every one but `main`, and every one whose result is not `()`.
// example: list.length(documented(ast.Program { items: [] })) == 0
fn documented(program: ast.Program) -> List<ast.FunctionDeclaration> {
    var found = []
    for item in program.items {
        found = match item {
            ast.Function(function) => with_documented(found, function)
            _ => found
        }
    }
    found
}

/// `found`, then `function` where it states examples.
// example: list.length(with_documented([], parsed_function("fn main() -> Int {\n    0\n}\n"))) == 0
fn with_documented(found: List<ast.FunctionDeclaration>, function: ast.FunctionDeclaration) -> List<ast.FunctionDeclaration> {
    if function.name.text == "main" || is_unit_result(function.result) {
        return found
    }
    list.push(found, function)
}

/// The first function `source` declares, which the examples read.
// example: parsed_function("fn f() -> Int {\n    0\n}\n").name.text == "f"
fn parsed_function(source: String) -> ast.FunctionDeclaration {
    var first = ast.FunctionDeclaration { name: ast.Name { text: "", span: lexer.Span { start: 0, length: 0 } }, type_parameters: [], parameters: [], result: None, body: ast.Block { statements: [], span: lexer.Span { start: 0, length: 0 } }, span: lexer.Span { start: 0, length: 0 } }
    for item in ok_or(parser.parse(source), ast.Program { items: [] }).items {
        first = match item {
            ast.Function(function) => function
            _ => first
        }
    }
    first
}

/// Whether a function's result is written `()`, which gives nothing back to state an example of.
// example: !is_unit_result(None)
fn is_unit_result(result: Option<ast.TypeRef>) -> Bool {
    match result {
        Some(written) => is_unit_type(written.kind)
        None => false
    }
}

/// Whether a written type is `()`.
// example: is_unit_type(ast.UnitType)
fn is_unit_type(kind: ast.TypeRefKind) -> Bool {
    match kind {
        ast.UnitType => true
        _ => false
    }
}

/// The examples the comments above `function` state, in the order they are written.
// example: list.length(examples_of(commented_of("// example: f() == 0\nfn f() -> Int {\n    0\n}\n"), parsed_function("// example: f() == 0\nfn f() -> Int {\n    0\n}\n"))) == 1
fn examples_of(written: Commented, function: ast.FunctionDeclaration) -> List<Example> {
    var found = []
    for comment in comments_above(written, function.span.start) {
        found = match stated_at(comment.text) {
            Some(expression) => list.push(found, Example { of: function.name.text, expression: expression, span: comment.span })
            None => found
        }
    }
    found
}

/// Every comment that states an example no function took up.
// example: list.length(documenting_nothing(commented_of("// example: 1 == 1\n"), [])) == 1
fn documenting_nothing(written: Commented, stated: List<Example>) -> List<Diagnostic> {
    var taken = set.empty()
    for example in stated {
        taken = set.insert(taken, example.span.start)
    }
    var refusals = []
    for comment in written.comments {
        if is_stated(stated_at(comment.text)) && !set.has_value(taken, comment.span.start) {
            refusals = list.push(refusals, Diagnostic { code: "L0602", message: "this example documents nothing", span: comment.span, help: Some("an example goes in the comment above the function it documents"), fix: None })
        }
    }
    refusals
}

/// The expression a comment states as an example, where it states one.
///
/// The comment opens with its slashes and blanks, then `example:`, then the expression.
// example: or(stated_at("// example: f() == 1 "), "") == "f() == 1"
// example: or(stated_at("// an example: 1"), "none") == "none"
fn stated_at(text: String) -> Option<String> {
    var start = 0
    for start < strings.length(text) && or(strings.at(text, start), 0) == 47 {
        start += 1
    }
    rest := trimmed_start(or(strings.cut(text, start, strings.length(text)), ""))
    if !has_prefix(text: rest, opening: "example:") {
        return None
    }
    Some(trimmed_end(trimmed_start(or(strings.cut(rest, 8, strings.length(rest)), ""))))
}

/// `text` without the white space it opens with.
// example: trimmed_start(" \ta") == "a"
fn trimmed_start(text: String) -> String {
    var start = 0
    for start < strings.length(text) && is_white(or(strings.at(text, start), 0)) {
        start += 1
    }
    or(strings.cut(text, start, strings.length(text)), "")
}

/// The run of the examples of a module: a module of its own, compiled and started.
///
/// A run whose module declares `io` or `arguments` is refused, because the run reaches for both.
/// The run writes `main` to try every example in turn, then every declaration but `main`, each
/// with the comments above it, so each stretch of what it writes is said about the original.
// example: code_refused(result_of_run(run_of(Page { source: "", path: "a.lm" }, ok_or(parser.parse("fn io() -> Int {\n    0\n}\n"), ast.Program { items: [] }), []))) == "L0604"
fn run_of(page: Page, program: ast.Program, stated: List<Example>) -> Result<Run, Diagnostic> {
    for named in ["io", "arguments"] {
        declared := declaring(program, named)
        if has_span(declared) {
            return Err(Diagnostic { code: "L0604", message: "a run of the examples reaches `" + named + "`, and this module declares it", span: or(declared, lexer.Span { start: 0, length: 0 }), help: Some("call the declaration something else, or run the module rather than its examples"), fix: None })
        }
    }
    Ok(run_written(page, program, stated))
}

/// A run's answer as a refusal, which is what the examples of `run_of` read.
// example: code_refused(result_of_run(Err(no_diagnostic()))) == "L0000"
fn result_of_run(answer: Result<Run, Diagnostic>) -> Result<(), Diagnostic> {
    match answer {
        Ok(_) => Ok(())
        Err(diagnostic) => Err(diagnostic)
    }
}

/// Whether a declaration was found.
// example: has_span(Some(lexer.Span { start: 0, length: 1 }))
fn has_span(declared: Option<lexer.Span>) -> Bool {
    match declared {
        Some(_) => true
        None => false
    }
}

/// Where `program` declares `named` as a type, a trait, a function, an extern, or a process.
// example: has_span(declaring(ok_or(parser.parse("fn io() -> Int {\n    0\n}\n"), ast.Program { items: [] }), "io"))
fn declaring(program: ast.Program, named: String) -> Option<lexer.Span> {
    for item in program.items {
        declared := name_declared(item)
        if declared.text == named && named != "" {
            return Some(declared.span)
        }
    }
    None
}

/// The name one item declares, and an empty name for an item that declares none.
// example: name_declared(ast.Import(ast.ImportDeclaration { module: ast.Name { text: "io", span: lexer.Span { start: 7, length: 2 } }, span: lexer.Span { start: 0, length: 9 } })).text == ""
fn name_declared(item: ast.Item) -> ast.Name {
    match item {
        ast.Type(declaration) => declaration.name
        ast.Trait(declaration) => declaration.name
        ast.Function(function) => function.name
        ast.Extern(declaration) => declaration.name
        ast.Process(declaration) => declaration.name
        _ => ast.Name { text: "", span: lexer.Span { start: 0, length: 0 } }
    }
}

/// The module the run is: the imports, `main` trying each example, then every declaration.
// example: run_written(Page { source: "", path: "a.lm" }, ast.Program { items: [] }, []).source == "import io\n\nfn main(arguments: List<String>) -> Int {\n    0\n}\n"
fn run_written(page: Page, program: ast.Program, stated: List<Example>) -> Run {
    var writing = Writing { source: "", bytes: 0, stretches: [] }
    writing = wrote(writing, Stretch { text: imports_of(program), about: WholeModule })
    writing = wrote(writing, Stretch { text: "fn main(arguments: List<String>) -> Int {\n", about: WholeModule })
    var ordinal = 0
    for example in stated {
        writing = wrote(writing, Stretch { text: "    if !(" + example.expression + ") {\n        io.println(\"lumen: example " + shown(ordinal) + "\")\n    }\n", about: OneExample(ordinal) })
        ordinal += 1
    }
    writing = wrote(writing, Stretch { text: "    0\n}\n", about: WholeModule })
    commented := commented_of(page.source)
    for declared in declarations_of(program) {
        block := block_of(commented, declared)
        writing = wrote(writing, Stretch { text: "\n", about: WholeModule })
        writing = wrote(writing, Stretch { text: measured_cut(commented.measured, Stretched { from: block.start, to: block.start + block.length }), about: SameText(block.start) })
        writing = wrote(writing, Stretch { text: "\n", about: WholeModule })
    }
    Run { source: writing.source, stretches: writing.stretches, examples: stated, module: lexer.Span { start: 0, length: byte_count(page.source) } }
}

/// The source, with every line comment it holds and where each unit of it starts in bytes.
// example: list.length(commented_of("// a\nfn\n").comments) == 1
fn commented_of(source: String) -> Commented {
    var comments = []
    for token in lexer.lex(source) {
        if token.kind == lexer.LineComment {
            comments = list.push(comments, token)
        }
    }
    Commented { measured: measured_of(source), comments: comments }
}

/// `writing`, with `stretch` written after what it holds and noted as the part it is.
// example: wrote(Writing { source: "", bytes: 0, stretches: [] }, Stretch { text: "é", about: WholeModule }).bytes == 2
fn wrote(writing: Writing, stretch: Stretch) -> Writing {
    width := byte_count(stretch.text)
    placed := Placed { span: lexer.Span { start: writing.bytes, length: width }, about: stretch.about }
    Writing { source: writing.source + stretch.text, bytes: writing.bytes + width, stretches: list.push(writing.stretches, placed) }
}

/// How many bytes the UTF-8 form of `text` takes.
// example: byte_count("aé") == 3
fn byte_count(text: String) -> Int {
    lexer.byte_length(lexer.Rest { source: text, start: 0 }, strings.length(text))
}

/// Every module `program` imports, and `io`, each once and in order, in one block, as the run imports them.
// example: imports_of(ok_or(parser.parse("import list\n"), ast.Program { items: [] })) == "import io\nimport list\n\n"
fn imports_of(program: ast.Program) -> String {
    var named = ["io"]
    for item in program.items {
        named = match item {
            ast.Import(imported) => list.push(named, imported.module.text)
            _ => named
        }
    }
    var written = ""
    var last = ""
    for module in sorted(named) {
        if module != last {
            written += "import " + module + "\n"
        }
        last = module
    }
    written + "\n"
}

/// `values`, from the one that sorts first to the one that sorts last.
// example: or(list.at(sorted(["b", "a"]), 0), "") == "a"
fn sorted(values: List<String>) -> List<String> {
    var ordered = []
    for value in values {
        ordered = inserted(ordered, value)
    }
    ordered
}

/// `ordered`, with `value` after every value that does not sort after it.
// example: or(list.at(inserted(["a", "c"], "b"), 1), "") == "b"
fn inserted(ordered: List<String>, value: String) -> List<String> {
    var placed = []
    var done = false
    for one in ordered {
        if !done && value < one {
            placed = list.push(placed, value)
            done = true
        }
        placed = list.push(placed, one)
    }
    if !done {
        placed = list.push(placed, value)
    }
    placed
}

/// The span of every declaration the run copies: every item but an import and `main`.
// example: list.length(declarations_of(ok_or(parser.parse("import io\n\nfn main() -> Int {\n    0\n}\n"), ast.Program { items: [] }))) == 0
fn declarations_of(program: ast.Program) -> List<lexer.Span> {
    var found = []
    for item in program.items {
        found = match item {
            ast.Import(_) => found
            ast.Type(declaration) => list.push(found, declaration.span)
            ast.Trait(declaration) => list.push(found, declaration.span)
            ast.Instance(declaration) => list.push(found, declaration.span)
            ast.Derive(declaration) => list.push(found, declaration.span)
            ast.Function(function) => with_copied(found, function)
            ast.Extern(declaration) => list.push(found, declaration.span)
            ast.Process(declaration) => list.push(found, declaration.span)
        }
    }
    found
}

/// `found`, then the span of `function` unless it is `main`, which the run writes itself.
// example: list.length(with_copied([], parsed_function("fn main() -> Int {\n    0\n}\n"))) == 0
fn with_copied(found: List<lexer.Span>, function: ast.FunctionDeclaration) -> List<lexer.Span> {
    if function.name.text == "main" {
        return found
    }
    list.push(found, function.span)
}

/// A declaration with every comment directly above it, from the start of the first one's line.
// example: block_of(commented_of("// a\nfn"), lexer.Span { start: 5, length: 2 }).start == 0
fn block_of(written: Commented, declared: lexer.Span) -> lexer.Span {
    opens := match list.at(comments_above(written, declared.start), 0) {
        Some(first) => opening_of(written.measured, first.span.start)
        None => declared.start
    }
    lexer.Span { start: opens, length: declared.start + declared.length - opens }
}

/// The comments directly above the byte `below`, each alone on its line, in the order written.
///
/// A comment is directly above when one line break and nothing but blanks lie between it and
/// what is below it; the run stops at the first blank line or at a comment after code.
// example: list.length(comments_above(commented_of("// a\n// b\nfn"), 10)) == 2
// example: list.length(comments_above(commented_of("// a\n\nfn"), 6)) == 0
fn comments_above(written: Commented, below: Int) -> List<lexer.Token> {
    var found = []
    var reached = below
    for {
        index := last_ending_by(written.comments, reached)
        if index < 0 {
            break
        }
        comment := or(list.at(written.comments, index), no_token())
        opens := opening_of(written.measured, comment.span.start)
        between := measured_cut(written.measured, Stretched { from: comment.span.start + comment.span.length, to: reached })
        before := measured_cut(written.measured, Stretched { from: opens, to: comment.span.start })
        if !is_one_line_break(between) || !is_blank_run(before) {
            break
        }
        found = list.push(found, comment)
        reached = opens
    }
    turned(found)
}

/// `values`, last first.
// example: or(list.at(turned([1, 2]), 0), 0) == 2
fn turned<T>(values: List<T>) -> List<T> {
    var backwards = []
    var index = list.length(values) - 1
    for index >= 0 {
        backwards = match list.at(values, index) {
            Some(value) => list.push(backwards, value)
            None => backwards
        }
        index = index - 1
    }
    backwards
}

/// The index of the last comment that ends at or before the byte `reached`, and `-1` for none.
///
/// The comments are in the order written and never overlap, so where each ends only grows.
// example: last_ending_by(commented_of("// a\n// b\n").comments, 9) == 1
fn last_ending_by(comments: List<lexer.Token>, reached: Int) -> Int {
    var low = 0
    var high = list.length(comments)
    for low < high {
        middle := or((low + high) / 2, 0)
        comment := or(list.at(comments, middle), no_token())
        if comment.span.start + comment.span.length <= reached {
            low = middle + 1
        } else {
            high = middle
        }
    }
    low - 1
}

/// A token that holds nothing, which the examples fall back on.
// example: no_token().text == ""
fn no_token() -> lexer.Token {
    lexer.Token { kind: lexer.Unknown, span: lexer.Span { start: 0, length: 0 }, text: "" }
}

/// Whether `between` holds exactly one line break and nothing else but blanks.
// example: is_one_line_break(" \n\t")
// example: !is_one_line_break("\n\n")
fn is_one_line_break(between: String) -> Bool {
    var breaks = 0
    var index = 0
    for index < strings.length(between) {
        unit := or(strings.at(between, index), 0)
        if unit == 10 {
            breaks += 1
        } else if !is_blank(unit) {
            return false
        }
        index += 1
    }
    breaks == 1
}

/// Whether `text` holds nothing but blanks.
// example: is_blank_run(" \t")
fn is_blank_run(text: String) -> Bool {
    var index = 0
    for index < strings.length(text) {
        if !is_blank(or(strings.at(text, index), 0)) {
            return false
        }
        index += 1
    }
    true
}

/// Whether `unit` is a blank: a space, a tab, or a carriage return.
// example: is_blank(13)
fn is_blank(unit: Int) -> Bool {
    unit == 32 || unit == 9 || unit == 13
}

/// The byte where the line holding the byte `at` opens.
// example: opening_of(measured_of("ab\ncd"), 4) == 3
fn opening_of(measured: Measured, at: Int) -> Int {
    var unit = unit_of(measured, at)
    for unit > 0 && or(strings.at(measured.source, unit - 1), 0) != 10 {
        unit = unit - 1
    }
    byte_of(measured, unit)
}

/// The text between two bytes.
// example: measured_cut(measured_of("aé!"), Stretched { from: 1, to: 3 }) == "é"
fn measured_cut(measured: Measured, stretched: Stretched) -> String {
    or(strings.cut(measured.source, unit_of(measured, stretched.from), unit_of(measured, stretched.to)), "")
}

/// The example a line the run wrote names, where it names one.
// example: is_named(named_in(Run { source: "", stretches: [], examples: [], module: lexer.Span { start: 0, length: 0 } }, "lumen: example 0")) == false
fn named_in(run: Run, line: String) -> Option<Example> {
    trimmed := trimmed_end(line)
    marker := "lumen: example "
    if !has_prefix(text: trimmed, opening: marker) {
        return None
    }
    match ordinal_read(or(strings.cut(trimmed, strings.length(marker), strings.length(trimmed)), "")) {
        Some(ordinal) => list.at(run.examples, ordinal)
        None => None
    }
}

/// `text` without the white space it ends with.
// example: trimmed_end("a \r") == "a"
fn trimmed_end(text: String) -> String {
    var end = strings.length(text)
    for end > 0 && is_white(or(strings.at(text, end - 1), 0)) {
        end = end - 1
    }
    or(strings.cut(text, 0, end), "")
}

/// Whether `unit` is white space, as Unicode counts it.
// example: is_white(12288)
// example: !is_white(97)
fn is_white(unit: Int) -> Bool {
    if unit >= 9 && unit <= 13 {
        return true
    }
    if unit >= 8192 && unit <= 8202 {
        return true
    }
    list.has_value([32, 133, 160, 5760, 8232, 8233, 8239, 8287, 12288], unit)
}

/// Whether a line named an example.
// example: !is_named(None)
fn is_named(found: Option<Example>) -> Bool {
    match found {
        Some(_) => true
        None => false
    }
}

/// The number `text` writes in digits, with a `+` before them allowed, where it writes one.
// example: or(ordinal_read("+12"), 0) == 12
// example: or(ordinal_read("1a"), 0) == 0
fn ordinal_read(text: String) -> Option<Int> {
    var index = 0
    if has_prefix(text: text, opening: "+") {
        index = 1
    }
    if index >= strings.length(text) || strings.length(text) - index > 18 {
        return None
    }
    var value = 0
    for index < strings.length(text) {
        unit := or(strings.at(text, index), 0)
        if !is_digit(unit) {
            return None
        }
        value = value * 10 + unit - 48
        index += 1
    }
    Some(value)
}

/// Whether `unit` is one of the ten digits.
// example: is_digit(48)
fn is_digit(unit: Int) -> Bool {
    unit >= 48 && unit <= 57
}

/// The refusal of an example that did not hold, about the comment that states it.
// example: did_not_hold(Example { of: "f", expression: "false", span: lexer.Span { start: 0, length: 1 } }).message == "the example of `f` does not hold"
fn did_not_hold(example: Example) -> Diagnostic {
    Diagnostic { code: "L0603", message: "the example of `" + example.of + "` does not hold", span: example.span, help: Some("an example states what a function works out, and this one states what it does not"), fix: None }
}

/// Where in the file the author wrote a span of the run lies.
///
/// Copied text maps to the text it was copied from, the lines trying one example map to the
/// comment that states it, and what the run wrote of its own maps to the whole module.
// example: in_original(Run { source: "", stretches: [], examples: [], module: lexer.Span { start: 0, length: 7 } }, lexer.Span { start: 3, length: 1 }).length == 7
fn in_original(run: Run, written: lexer.Span) -> lexer.Span {
    for placed in run.stretches {
        if placed.span.start <= written.start && written.start < placed.span.start + placed.span.length {
            return placed_back(run, placed, written)
        }
    }
    run.module
}

/// `written`, which lies in `placed`, where the author wrote it.
// example: placed_back(Run { source: "", stretches: [], examples: [], module: lexer.Span { start: 0, length: 7 } }, Placed { span: lexer.Span { start: 2, length: 4 }, about: SameText(10) }, lexer.Span { start: 3, length: 9 }).length == 3
fn placed_back(run: Run, placed: Placed, written: lexer.Span) -> lexer.Span {
    match placed.about {
        SameText(from) => lexer.Span { start: from + written.start - placed.span.start, length: smaller(one: written.length, other: placed.span.length - (written.start - placed.span.start)) }
        OneExample(ordinal) => example_span(run, ordinal)
        WholeModule => run.module
    }
}

/// The span of the comment that states example `ordinal`.
// example: example_span(Run { source: "", stretches: [], examples: [], module: lexer.Span { start: 0, length: 7 } }, 0).length == 7
fn example_span(run: Run, ordinal: Int) -> lexer.Span {
    match list.at(run.examples, ordinal) {
        Some(example) => example.span
        None => run.module
    }
}

/// One diagnostic in the layout of `docs/specs/diagnostics.md`, against the file of `page`.
///
/// The first line is the code and the message, the second the place, then the source line under a
/// row of carets, then the help where there is one.
// example: rendered(Diagnostic { code: "L0102", message: "m", span: lexer.Span { start: 1, length: 1 }, help: None, fix: None }, Page { source: "a$b\n", path: "x.lm" }) == "error[L0102]: m\n  --> x.lm:1:2\n\n  1 | a$b\n    |  ^\n"
fn rendered(diagnostic: Diagnostic, page: Page) -> String {
    place := place_of(diagnostic.span, measured_of(page.source))
    line := shown(place.line)
    gutter := "  " + line + " "
    var written = "error[" + diagnostic.code + "]: " + diagnostic.message + "\n"
    written += "  --> " + page.path + ":" + line + ":" + shown(place.column) + "\n\n"
    written += gutter + "| " + place.text + "\n"
    written += repeated(text: " ", times: strings.length(gutter)) + "| " + place.padding + repeated(text: "^", times: place.width) + place.note
    written + help_line(diagnostic.help) + "\n"
}

/// Where every code unit of `source` starts, in bytes, and where the source ends.
// example: or(list.at(measured_of("é!").starts, 1), 0) == 2
fn measured_of(source: String) -> Measured {
    var starts = []
    var at = 0
    var index = 0
    for index < strings.length(source) {
        starts = list.push(starts, at)
        at += lexer.unit_width(or(strings.at(source, index), 0))
        index += 1
    }
    Measured { source: source, starts: list.push(starts, at) }
}

/// The `help:` line after a blank one, and nothing where there is no help.
// example: help_line(Some("x")) == "\n\nhelp: x"
fn help_line(help: Option<String>) -> String {
    match help {
        Some(text) => "\n\nhelp: " + text
        None => ""
    }
}

/// Where `span` points in the source `measured` holds: its line, its column, and its carets.
///
/// A span past the end points at the last byte, and one that runs past its line gets one line of
/// carets and a note naming the line it runs on to.
// example: place_of(lexer.Span { start: 0, length: 3 }, measured_of("a\nb")).note == " this runs on to line 2"
fn place_of(span: lexer.Span, measured: Measured) -> Pointed {
    total := byte_of(measured, strings.length(measured.source))
    start := smaller(one: span.start, other: larger(one: total - 1, other: 0))
    end := span.start + span.length
    start_unit := unit_of(measured, start)
    opens := line_start(measured.source, start_unit)
    closes := line_end(measured.source, start_unit)
    line := 1 + breaks_before(measured.source, start_unit)
    last := 1 + breaks_before(measured.source, unit_of(measured, larger(one: smaller(one: end, other: total) - 1, other: 0)))
    column := 1 + characters_of(measured.source, Stretched { from: opens, to: start_unit })
    reach := unit_of(measured, smaller(one: end, other: byte_of(measured, closes)))
    text := or(strings.cut(measured.source, opens, closes), "")
    Pointed { line: line, column: column, text: text, width: larger(one: characters_of(measured.source, Stretched { from: start_unit, to: reach }), other: 1), padding: padding_of(text, column - 1), note: note_of(Lines { first: line, last: last }) }
}

/// The first code unit that starts at or after the byte `byte`, and the length past the end.
// example: unit_of(measured_of("é!"), 2) == 1
// example: unit_of(measured_of("é!"), 1) == 1
fn unit_of(measured: Measured, byte: Int) -> Int {
    var low = 0
    var high = list.length(measured.starts) - 1
    for low < high {
        middle := or((low + high) / 2, 0)
        if or(list.at(measured.starts, middle), 0) < byte {
            low = middle + 1
        } else {
            high = middle
        }
    }
    low
}

/// The byte where the code unit `unit` starts.
// example: byte_of(measured_of("é!"), 1) == 2
fn byte_of(measured: Measured, unit: Int) -> Int {
    or(list.at(measured.starts, unit), 0)
}

/// The note on a span that runs past its first line, and nothing on one that does not.
// example: note_of(Lines { first: 1, last: 1 }) == ""
fn note_of(lines: Lines) -> String {
    if lines.last > lines.first {
        return " this runs on to line " + shown(lines.last)
    }
    ""
}

/// The code unit a line opens at: the one after the last line break before `unit`.
// example: line_start("ab\ncd", 4) == 3
fn line_start(source: String, unit: Int) -> Int {
    var at = unit
    for at > 0 && or(strings.at(source, at - 1), 0) != 10 {
        at = at - 1
    }
    at
}

/// The code unit a line ends at: its line break, or the end of the source.
// example: line_end("ab\ncd", 1) == 2
fn line_end(source: String, unit: Int) -> Int {
    var at = unit
    for at < strings.length(source) && or(strings.at(source, at), 0) != 10 {
        at += 1
    }
    at
}

/// How many line breaks come before the code unit `unit`.
// example: breaks_before("a\nb\nc", 4) == 2
fn breaks_before(source: String, unit: Int) -> Int {
    var count = 0
    var at = 0
    for at < unit && at < strings.length(source) {
        if or(strings.at(source, at), 0) == 10 {
            count += 1
        }
        at += 1
    }
    count
}

/// How many characters the code units of a stretch hold, where a pair of units is one.
// example: characters_of("a😀b", Stretched { from: 0, to: 4 }) == 3
fn characters_of(source: String, stretched: Stretched) -> Int {
    var count = 0
    var at = stretched.from
    for at < stretched.to && at < strings.length(source) {
        unit := or(strings.at(source, at), 0)
        if unit < 56320 || unit > 57343 {
            count += 1
        }
        at += 1
    }
    count
}

/// What goes before the carets: a blank for each of the first `count` characters of `text`.
///
/// A tab stays a tab, so the carets line up under the text however wide a tab is shown.
// example: padding_of("\tab", 2) == "\t "
fn padding_of(text: String, count: Int) -> String {
    var written = ""
    var taken = 0
    var at = 0
    for taken < count && at < strings.length(text) {
        unit := or(strings.at(text, at), 0)
        if unit == 9 {
            written += "\t"
        } else if unit < 56320 || unit > 57343 {
            written += " "
        }
        if unit < 56320 || unit > 57343 {
            taken += 1
        }
        at += 1
    }
    written
}

/// One diagnostic as one line of JSON, which `docs/specs/diagnostics.md` states field for field.
// example: json_of(no_diagnostic(), "a.lm") == "{\"file\":\"a.lm\",\"code\":\"L0000\",\"message\":\"\",\"span\":{\"start\":0,\"len\":0}}\n"
fn json_of(diagnostic: Diagnostic, path: String) -> String {
    var written = "{" + json_field(name: "file", value: path) + "," + json_field(name: "code", value: diagnostic.code) + "," + json_field(name: "message", value: diagnostic.message)
    written += ",\"span\":" + json_span(diagnostic.span)
    written += json_help(diagnostic.help) + json_fix(diagnostic.fix)
    written + "}\n"
}

/// A span as its start and its length in bytes.
// example: json_span(lexer.Span { start: 1, length: 2 }) == "{\"start\":1,\"len\":2}"
fn json_span(span: lexer.Span) -> String {
    "{\"start\":" + shown(span.start) + ",\"len\":" + shown(span.length) + "}"
}

/// The `help` field, and nothing where there is no help.
// example: json_help(None) == ""
fn json_help(help: Option<String>) -> String {
    match help {
        Some(text) => "," + json_field(name: "help", value: text)
        None => ""
    }
}

/// One field that holds text.
// example: json_field(name: "a", value: "b") == "\"a\":\"b\""
fn json_field(name: String, value: String) -> String {
    "\"" + name + "\":" + quoted(value)
}

/// The `fix` field, and nothing where there is no edit.
// example: json_fix(Some(Fix { span: lexer.Span { start: 0, length: 1 }, text: "a" })) == ",\"fix\":{\"start\":0,\"len\":1,\"text\":\"a\"}"
fn json_fix(fix: Option<Fix>) -> String {
    match fix {
        Some(edit) => ",\"fix\":{\"start\":" + shown(edit.span.start) + ",\"len\":" + shown(edit.span.length) + ",\"text\":" + quoted(edit.text) + "}"
        None => ""
    }
}

/// `text` as a JSON string: quoted, with a quote, a backslash, and each control escaped.
///
/// The text between two escapes is copied whole, so a long text is not rebuilt one unit at a time.
// example: quoted("a\"\n") == "\"a\\\"\\n\""
fn quoted(text: String) -> String {
    var written = "\""
    var plain = 0
    var index = 0
    for index < strings.length(text) {
        escape := escape_of(or(strings.at(text, index), 0))
        if escape != "" {
            written += or(strings.cut(text, plain, index), "") + escape
            plain = index + 1
        }
        index += 1
    }
    written + or(strings.cut(text, plain, strings.length(text)), "") + "\""
}

/// How JSON writes the code unit `unit` inside a string, and `""` where it is written as it is.
// example: escape_of(9) == "\\t"
// example: escape_of(31) == "\\u001f"
// example: escape_of(97) == ""
fn escape_of(unit: Int) -> String {
    if unit == 34 {
        return "\\\""
    }
    if unit == 92 {
        return "\\\\"
    }
    if unit == 10 {
        return "\\n"
    }
    if unit == 13 {
        return "\\r"
    }
    if unit == 9 {
        return "\\t"
    }
    if unit < 32 {
        return "\\u00" + hex_digit(or(unit / 16, 0)) + hex_digit(or(unit % 16, 0))
    }
    ""
}

/// One digit of a number written in base sixteen, in lowercase.
// example: hex_digit(11) == "b"
fn hex_digit(value: Int) -> String {
    or(strings.cut("0123456789abcdef", value, value + 1), "0")
}

/// The command `arguments` ask for, or what the command line answers without running one.
///
/// The surface is the one `docs/specs/run.md` states: a word names a command, `-h` and `--help`
/// ask for help, `-V` and `--version` for the version, and `--` ends the flags. Every refusal of
/// the words reads as the Rust binary wrote it, tip and usage line alike.
// example: is_told(asked_by(["-V"]))
// example: !is_told(asked_by(["check", "a.lm"]))
fn asked_by(arguments: List<String>) -> Parsed {
    var index = 0
    var escaped = false
    for word in arguments {
        index += 1
        if escaped {
            return Told(escaped_word(word))
        }
        if word != "--" {
            return unescaped_parsed(word, after(arguments, index))
        }
        escaped = true
    }
    Told(Said { output: "", errors: top_short_help(), status: 2 })
}

/// Whether the words were answered without a command.
// example: is_told(Told(nothing_said()))
fn is_told(parsed: Parsed) -> Bool {
    match parsed {
        Told(_) => true
        _ => false
    }
}

/// What the first word that is not `--` asks for: a command, a flag, or a word no command names.
// example: is_told(unescaped_parsed("chek", []))
fn unescaped_parsed(word: String, rest: List<String>) -> Parsed {
    match subcommand_named(word) {
        Some(sub) => subcommand_parsed(sub, rest)
        None => Told(flag_or_word(word, rest))
    }
}

/// What the words after a command's name ask for.
// example: !is_told(subcommand_parsed(or(subcommand_named("fmt"), help_subcommand()), ["a.lm"]))
fn subcommand_parsed(sub: Subcommand, rest: List<String>) -> Parsed {
    if sub.name == "help" {
        return Told(help_asked(rest))
    }
    if sub.name == "run" {
        return run_parsed(rest)
    }
    match positional_read(sub, rest) {
        Ok(command) => Asked(command)
        Err(said) => Told(said)
    }
}

/// A top-level flag, or a word that names no command.
// example: flag_or_word("-V", []).output == "lumen 0.1.0\n"
fn flag_or_word(word: String, rest: List<String>) -> Said {
    if is_long(word) {
        return top_long(long_of(word), rest)
    }
    if is_short(word) {
        return top_short(word)
    }
    unrecognized(word)
}

/// A long flag written before any command.
// example: top_long(long_of("--version"), []).output == "lumen 0.1.0\n"
fn top_long(long: Long, rest: List<String>) -> Said {
    if long.name == "help" || long.name == "version" {
        return top_flag(long)
    }
    shown_flag := "--" + long.name
    match most_similar(long.name, ["help", "version"]) {
        Some(similar) => complained(Complaint { message: "unexpected argument '" + shown_flag + "' found", tip: Some("a similar argument exists: '--" + similar + "'"), usage: "lumen --" + similar + " <COMMAND>", offers_help: true })
        None => complained(Complaint { message: "unexpected argument '" + shown_flag + "' found", tip: flag_of_a_command(long.name, rest), usage: "lumen <COMMAND>", offers_help: true })
    }
}

/// `--help` or `--version` written before any command, which takes no value.
// example: top_flag(Long { name: "help", value: Some("x") }).status == 2
fn top_flag(long: Long) -> Said {
    match long.value {
        Some(value) => too_many(value, Complaint { message: "--" + long.name, tip: None, usage: "lumen --" + long.name + " <COMMAND>", offers_help: true })
        None => top_flag_said(long.name)
    }
}

/// What `--help` or `--version` prints.
// example: top_flag_said("version").output == "lumen 0.1.0\n"
fn top_flag_said(name: String) -> Said {
    if name == "version" {
        return version_said()
    }
    Said { output: top_long_help(), errors: "", status: 0 }
}

/// The tip that names a command a flag belongs to, where one of the words after it is that command.
///
/// Of the commands written after the flag with a flag like it, the one written first is named.
// example: or(flag_of_a_command("jsn", ["check"]), "") == "'check --json' exists"
fn flag_of_a_command(name: String, rest: List<String>) -> Option<String> {
    var best = None
    var best_at = list.length(rest)
    for sub in subcommands() {
        at := or(list.index_of(rest, sub.name), list.length(rest))
        similar := most_similar(name, sub.longs)
        if at < best_at && is_stated(similar) {
            best = Some("'" + sub.name + " --" + or(similar, "") + "' exists")
            best_at = at
        }
    }
    best
}

/// A short flag written before any command: `-h` for help, `-V` for the version.
// example: top_short("-x").errors == "error: unexpected argument '-x' found\n\nUsage: lumen <COMMAND>\n\nFor more information, try '--help'.\n"
fn top_short(word: String) -> Said {
    letter := first_letter(word)
    if letter == "h" {
        return Said { output: top_short_help(), errors: "", status: 0 }
    }
    if letter == "V" {
        return version_said()
    }
    complained(Complaint { message: "unexpected argument '-" + letter + "' found", tip: None, usage: "lumen <COMMAND>", offers_help: true })
}

/// The version, which `-V` and `--version` print.
// example: version_said().status == 0
fn version_said() -> Said {
    Said { output: "lumen 0.1.0\n", errors: "", status: 0 }
}

/// A word after `--` where a command's name belongs.
// example: escaped_word("check").errors == "error: unexpected argument 'check' found\n\n  tip: subcommand 'check' exists; to use it, remove the '--' before it\n\nUsage: lumen <COMMAND>\n\nFor more information, try '--help'.\n"
fn escaped_word(word: String) -> Said {
    match subcommand_named(word) {
        Some(_) => complained(Complaint { message: "unexpected argument '" + word + "' found", tip: Some("subcommand '" + word + "' exists; to use it, remove the '--' before it"), usage: "lumen <COMMAND>", offers_help: true })
        None => unrecognized(word)
    }
}

/// A word that names no command, with the commands spelled like it.
// example: unrecognized("chek").errors == "error: unrecognized subcommand 'chek'\n\n  tip: a similar subcommand exists: 'check'\n\nUsage: lumen <COMMAND>\n\nFor more information, try '--help'.\n"
fn unrecognized(word: String) -> Said {
    similar := all_similar(word, subcommand_names())
    complained(Complaint { message: "unrecognized subcommand '" + word + "'", tip: commands_tip(similar), usage: "lumen <COMMAND>", offers_help: true })
}

/// The tip that names the commands spelled like a word, where there are any.
// example: or(commands_tip(["a", "b"]), "") == "some similar subcommands exist: 'a', 'b'"
fn commands_tip(similar: List<String>) -> Option<String> {
    if list.length(similar) == 0 {
        return None
    }
    if list.length(similar) == 1 {
        return Some("a similar subcommand exists: '" + or(list.at(similar, 0), "") + "'")
    }
    var quoted_names = []
    for name in similar {
        quoted_names = list.push(quoted_names, "'" + name + "'")
    }
    Some("some similar subcommands exist: " + strings.join(quoted_names, ", "))
}

/// The name of every command, in the order the help lists them.
// example: list.length(subcommand_names()) == 8
fn subcommand_names() -> List<String> {
    var names = []
    for sub in subcommands() {
        names = list.push(names, sub.name)
    }
    names
}

/// The command a subcommand with one argument names, or what the command line answers instead.
///
/// The words are a flag, `--`, or the one argument. After `--` every word is the argument.
// example: is_refused(positional_read(or(subcommand_named("fmt"), help_subcommand()), []))
fn positional_read(sub: Subcommand, rest: List<String>) -> Result<Command, Said> {
    var used = []
    var given = []
    var escaped = false
    for word in rest {
        if !escaped && word == "--" {
            escaped = true
            continue
        }
        if escaped || !is_long(word) && !is_short(word) {
            if list.length(given) > 0 {
                return Err(complained(Complaint { message: "unexpected argument '" + word + "' found", tip: None, usage: sub.usage, offers_help: true }))
            }
            given = list.push(given, word)
            continue
        }
        used = flag_read(sub, Flagged { word: word, used: used })?
    }
    match list.at(given, 0) {
        Some(value) => Ok(command_of(sub, Given { value: value, used: used }))
        None => Err(complained(Complaint { message: "the following required arguments were not provided:\n  <" + sub.value + ">", tip: None, usage: smart_usage(sub, used), offers_help: true }))
    }
}

/// The command `sub` names, given its argument and the flags written with it.
// example: command_of(or(subcommand_named("explain"), help_subcommand()), Given { value: "L0100", used: [] }) == Explain("L0100")
fn command_of(sub: Subcommand, given: Given) -> Command {
    value := given.value
    match sub.name {
        "fmt" => Fmt(value)
        "check" => Check { path: value, form: form_of(given.used) }
        "build" => Build(value)
        "test" => Test(value)
        "api" => Api(value)
        _ => Explain(value)
    }
}

/// The form a refusal is shown in: as data where `--json` was written, else as a page.
// example: form_of(["json"]) == AsData
fn form_of(used: List<String>) -> Form {
    if list.has_value(used, "json") {
        return AsData
    }
    AsPage
}

/// The flags after one more flag of `sub` is read, or what the command line answers instead.
// example: ok_or(flag_read(or(subcommand_named("check"), help_subcommand()), Flagged { word: "--json", used: [] }), []) == ["json"]
fn flag_read(sub: Subcommand, flagged: Flagged) -> Result<List<String>, Said> {
    if is_short(flagged.word) {
        return Err(short_read(sub, flagged.word))
    }
    long := long_of(flagged.word)
    if long.name == "help" {
        return Err(help_flag_said(sub, Held { long: long, used: flagged.used }))
    }
    if long.name == "json" && list.has_value(sub.longs, "json") {
        return json_read(sub, Held { long: long, used: flagged.used })
    }
    Err(unknown_long(sub, Held { long: long, used: flagged.used }))
}

/// A short flag of a command: `-h` for its short help, and a refusal of any other letter.
// example: short_read(or(subcommand_named("fmt"), help_subcommand()), "-h").status == 0
fn short_read(sub: Subcommand, word: String) -> Said {
    letter := first_letter(word)
    if letter == "h" {
        return Said { output: short_help(sub), errors: "", status: 0 }
    }
    shown_flag := "-" + letter
    complained(Complaint { message: "unexpected argument '" + shown_flag + "' found", tip: Some("to pass '" + shown_flag + "' as a value, use '-- " + shown_flag + "'"), usage: sub.usage, offers_help: true })
}

/// `--help` after a command: its long help, and a refusal where it is given a value.
// example: help_flag_said(or(subcommand_named("fmt"), help_subcommand()), Held { long: Long { name: "help", value: Some("") }, used: [] }).status == 2
fn help_flag_said(sub: Subcommand, held: Held) -> Said {
    match held.long.value {
        Some(value) => too_many(value, Complaint { message: "--help", tip: None, usage: value_usage(sub, held), offers_help: true })
        None => Said { output: long_help(sub), errors: "", status: 0 }
    }
}

/// `--json` after `check`: the flag noted, or a refusal of a value or of a second one.
// example: is_refused(json_read(or(subcommand_named("check"), help_subcommand()), Held { long: Long { name: "json", value: None }, used: ["json"] }))
fn json_read(sub: Subcommand, held: Held) -> Result<List<String>, Said> {
    match held.long.value {
        Some(value) => Err(too_many(value, Complaint { message: "--json", tip: None, usage: value_usage(sub, held), offers_help: true }))
        None => json_noted(sub, held.used)
    }
}

/// A flag given a value it takes none of, with the usage line `complaint` carries.
///
/// The message of `complaint` is the flag, which the refusal names.
// example: too_many("x", Complaint { message: "--help", tip: None, usage: "u", offers_help: false }).errors == "error: unexpected value 'x' for '--help' found; no more were expected\n\nUsage: u\n"
fn too_many(value: String, complaint: Complaint) -> Said {
    complained(complaint { message: "unexpected value '" + value + "' for '" + complaint.message + "' found; no more were expected" })
}

/// The flags with `--json` among them, and a refusal where it is there already.
// example: ok_or(json_noted(or(subcommand_named("check"), help_subcommand()), []), []) == ["json"]
fn json_noted(sub: Subcommand, used: List<String>) -> Result<List<String>, Said> {
    if list.has_value(used, "json") {
        return Err(complained(Complaint { message: "the argument '--json' cannot be used multiple times", tip: None, usage: sub.usage, offers_help: true }))
    }
    Ok(list.push(used, "json"))
}

/// The usage line of a flag given a value, which names that flag.
///
/// Where `--json` was written before, the Rust binary's usage line joined the argument and the flag
/// as `<PATH|--json>`, and this one writes the same.
// example: value_usage(or(subcommand_named("check"), help_subcommand()), Held { long: Long { name: "help", value: None }, used: ["json"] }) == "lumen check --help <PATH|--json>"
fn value_usage(sub: Subcommand, held: Held) -> String {
    if list.has_value(held.used, "json") {
        if held.long.name == "help" {
            return "lumen " + sub.name + " --help <" + sub.value + "|--json>"
        }
        return "lumen " + sub.name + " <" + sub.value + "|--json>"
    }
    smart_usage(sub, [held.long.name])
}

/// A long flag no command has, with the flag spelled like it, or the way to pass it as a value.
// example: unknown_long(or(subcommand_named("fmt"), help_subcommand()), Held { long: Long { name: "hlp", value: None }, used: [] }).errors == "error: unexpected argument '--hlp' found\n\n  tip: a similar argument exists: '--help'\n\nUsage: lumen fmt --help <FILE>\n\nFor more information, try '--help'.\n"
fn unknown_long(sub: Subcommand, held: Held) -> Said {
    shown_flag := "--" + held.long.name
    message := "unexpected argument '" + shown_flag + "' found"
    match most_similar(held.long.name, sub.longs) {
        Some(similar) => complained(Complaint { message: message, tip: Some("a similar argument exists: '--" + similar + "'"), usage: smart_usage(sub, with_flag(held.used, similar)), offers_help: true })
        None => complained(Complaint { message: message, tip: Some("to pass '" + shown_flag + "' as a value, use '-- " + shown_flag + "'"), usage: used_usage(sub, held.used), offers_help: true })
    }
}

/// `used`, with `flag` after them where it is not among them.
// example: list.length(with_flag(["json"], "json")) == 1
fn with_flag(used: List<String>, flag: String) -> List<String> {
    if list.has_value(used, flag) {
        return used
    }
    list.push(used, flag)
}

/// The usage line after a refusal: the command's own, or one naming the flags written.
// example: used_usage(or(subcommand_named("check"), help_subcommand()), []) == "lumen check [OPTIONS] <PATH>"
fn used_usage(sub: Subcommand, used: List<String>) -> String {
    if list.length(used) == 0 {
        return sub.usage
    }
    smart_usage(sub, used)
}

/// The usage line naming the flags written, then the argument the command takes.
// example: smart_usage(or(subcommand_named("check"), help_subcommand()), ["json"]) == "lumen check --json <PATH>"
fn smart_usage(sub: Subcommand, used: List<String>) -> String {
    var written = "lumen " + sub.name + " "
    for flag in used {
        written += "--" + flag + " "
    }
    written + "<" + sub.value + ">"
}

/// The program `run` names and the words it is run with, or what the command line answers.
///
/// `run` has no flag of its own. Before the file, `--` may be written once, and a word that reads
/// as a flag is refused. After the file every word belongs to the program, except a `--` written
/// before the first of them.
// example: is_told(run_parsed([]))
fn run_parsed(rest: List<String>) -> Parsed {
    var escaped = false
    var file = []
    var arguments = []
    for word in rest {
        if !escaped && list.length(arguments) == 0 && word == "--" {
            escaped = true
            continue
        }
        if list.length(file) > 0 {
            arguments = list.push(arguments, word)
            continue
        }
        if !escaped && (is_long(word) || is_short(word)) {
            return Told(run_flag_refused(word))
        }
        file = list.push(file, word)
    }
    match list.at(file, 0) {
        Some(named) => Running(Started { file: named, arguments: arguments })
        None => Told(complained(Complaint { message: "the following required arguments were not provided:\n  <FILE>", tip: None, usage: "lumen run <FILE> [ARGUMENTS]...", offers_help: false }))
    }
}

/// Whether `word` is one or more short flags: one dash and at least one letter.
// example: is_short("-h")
// example: !is_short("-")
fn is_short(word: String) -> Bool {
    has_prefix(text: word, opening: "-") && !has_prefix(text: word, opening: "--") && strings.length(word) > 1
}

/// A flag written before the file `run` names, which is refused.
// example: run_flag_refused("--x=1").errors == "error: unexpected argument '--x' found\n\n  tip: to pass '--x' as a value, use '-- --x'\n\nUsage: lumen run <FILE> [ARGUMENTS]...\n"
fn run_flag_refused(word: String) -> Said {
    shown_flag := flag_shown(word)
    complained(Complaint { message: "unexpected argument '" + shown_flag + "' found", tip: Some("to pass '" + shown_flag + "' as a value, use '-- " + shown_flag + "'"), usage: "lumen run <FILE> [ARGUMENTS]...", offers_help: false })
}

/// A flag as a refusal names it: a long flag without its value, a short one by its first letter.
// example: flag_shown("-xy") == "-x"
fn flag_shown(word: String) -> String {
    if is_long(word) {
        return "--" + long_of(word).name
    }
    "-" + first_letter(word)
}

/// Whether `word` is a long flag: two dashes and a name.
// example: is_long("--json")
// example: !is_long("--")
fn is_long(word: String) -> Bool {
    has_prefix(text: word, opening: "--") && strings.length(word) > 2
}

/// Whether `text` opens with `opening`.
// example: has_prefix(text: "--json", opening: "--")
// example: !has_prefix(text: "-", opening: "--")
fn has_prefix(text: String, opening: String) -> Bool {
    lexer.has_prefix(lexer.Rest { source: text, start: 0 }, opening)
}

/// A long flag's name and the value written after `=`, where one is.
// example: or(long_of("--help=x").value, "") == "x"
fn long_of(word: String) -> Long {
    var index = 2
    for index < strings.length(word) {
        if or(strings.at(word, index), 0) == 61 {
            return Long { name: or(strings.cut(word, 2, index), ""), value: strings.cut(word, index + 1, strings.length(word)) }
        }
        index += 1
    }
    Long { name: or(strings.cut(word, 2, strings.length(word)), ""), value: None }
}

/// The first letter after the dash of a short flag, a pair of code units where it takes two.
// example: first_letter("-xy") == "x"
fn first_letter(word: String) -> String {
    unit := or(strings.at(word, 1), 0)
    if unit >= 55296 && unit <= 56319 {
        return or(strings.cut(word, 1, 3), "")
    }
    or(strings.cut(word, 1, 2), "")
}

/// `help`, with the command it names or none.
// example: help_asked([]).status == 0
// example: help_asked(["nope"]).status == 2
fn help_asked(rest: List<String>) -> Said {
    match list.at(rest, 0) {
        Some(name) => help_named(name, after(rest, 1))
        None => Said { output: top_long_help(), errors: "", status: 0 }
    }
}

/// Every value of `values` from `index` on.
// example: list.length(after([1, 2, 3], 1)) == 2
fn after<T>(values: List<T>, index: Int) -> List<T> {
    var rest = []
    var at = index
    for at < list.length(values) {
        rest = match list.at(values, at) {
            Some(value) => list.push(rest, value)
            None => rest
        }
        at += 1
    }
    rest
}

/// The long help of the command called `name`, where there is one and nothing follows it.
// example: help_named("fmt", ["x"]).errors == "error: unrecognized subcommand 'x'\n\nUsage: lumen fmt <FILE>\n\nFor more information, try '--help'.\n"
fn help_named(name: String, more: List<String>) -> Said {
    match subcommand_named(name) {
        Some(sub) => help_of_command(sub, more)
        None => help_of_topic(name, more)
    }
}

/// The help of the part of the language called `name`, where there is one and nothing follows it.
///
/// `process` is the one such topic: it names no command, and `lumen help process` prints it.
// example: help_of_topic("process", []).status == 0
// example: help_of_topic("proces", []).status == 2
fn help_of_topic(name: String, more: List<String>) -> Said {
    if name != "process" {
        return complained(Complaint { message: "unrecognized subcommand '" + name + "'", tip: None, usage: "lumen <COMMAND>", offers_help: true })
    }
    match list.at(more, 0) {
        Some(extra) => complained(Complaint { message: "unrecognized subcommand '" + extra + "'", tip: None, usage: "lumen help process", offers_help: false })
        None => Said { output: topic_text(name), errors: "", status: 0 }
    }
}

/// The command called `word`, where one is.
// example: or(subcommand_named("check"), help_subcommand()).value == "PATH"
fn subcommand_named(word: String) -> Option<Subcommand> {
    for sub in subcommands() {
        if sub.name == word {
            return Some(sub)
        }
    }
    None
}

/// The long help of `sub`, and a refusal of a word after it.
// example: help_of_command(help_subcommand(), []).output == "Print this message or the help of the given subcommand(s)\n\nUsage: lumen help [COMMAND]...\n\nArguments:\n  [COMMAND]...  Print help for the subcommand(s)\n"
fn help_of_command(sub: Subcommand, more: List<String>) -> Said {
    match list.at(more, 0) {
        Some(extra) => complained(Complaint { message: "unrecognized subcommand '" + extra + "'", tip: None, usage: sub.usage, offers_help: list.has_value(sub.longs, "help") })
        None => Said { output: long_help(sub), errors: "", status: 0 }
    }
}

/// A refusal of the words, in the layout the Rust binary wrote: message, tip, usage, pointer.
// example: complained(Complaint { message: "m", tip: Some("t"), usage: "u", offers_help: false }).errors == "error: m\n\n  tip: t\n\nUsage: u\n"
fn complained(complaint: Complaint) -> Said {
    var written = "error: " + complaint.message + "\n"
    written += tip_line(complaint.tip)
    written += "\nUsage: " + complaint.usage + "\n"
    if complaint.offers_help {
        written += "\nFor more information, try '--help'.\n"
    }
    Said { output: "", errors: written, status: 2 }
}

/// The tip after a blank line, and nothing where there is none.
// example: tip_line(None) == ""
fn tip_line(tip: Option<String>) -> String {
    match tip {
        Some(text) => "\n  tip: " + text + "\n"
        None => ""
    }
}

/// The help `lumen -h` prints: the one-line summary, the usage, the commands, and the flags.
// example: has_prefix(text: top_short_help(), opening: "The Lumen compiler")
fn top_short_help() -> String {
    "The Lumen compiler: Go's simplicity, Haskell's types, the JVM's runtime\n\nUsage: lumen <COMMAND>\n\nCommands:\n" + commands_listed() + "\n\nOptions:\n  -h, --help     Print help (see more with '--help')\n  -V, --version  Print version\n"
}

/// The help `lumen --help` prints: the long topic, then the usage, the commands, and the flags.
// example: has_prefix(text: top_long_help(), opening: "")
fn top_long_help() -> String {
    topic_text("lumen") + "\n\nUsage: lumen <COMMAND>\n\nCommands:\n" + commands_listed() + "\n\nOptions:\n  -h, --help\n          Print help (see a summary with '-h')\n\n  -V, --version\n          Print version\n"
}

/// Every command on a line of its own, with the line that says what it does.
// example: has_prefix(text: commands_listed(), opening: "  fmt      Rewrite")
fn commands_listed() -> String {
    var lines = []
    for sub in subcommands() {
        lines = list.push(lines, "  " + sub.name + repeated(text: " ", times: 7 - strings.length(sub.name)) + "  " + sub.about)
    }
    strings.join(lines, "\n")
}

/// `text`, `times` times over.
// example: repeated(text: "^", times: 3) == "^^^"
fn repeated(text: String, times: Int) -> String {
    var written = ""
    var count = 0
    for count < times {
        written += text
        count += 1
    }
    written
}

/// The help `-h` after a command prints.
// example: short_help(or(subcommand_named("fmt"), help_subcommand())) == "Rewrite a source file in canonical form\n\nUsage: lumen fmt <FILE>\n\nArguments:\n  <FILE>  \n\nOptions:\n  -h, --help  Print help (see more with '--help')\n"
fn short_help(sub: Subcommand) -> String {
    var options = ""
    if list.has_value(sub.longs, "json") {
        options = "      --json  Write the refusal as one line of JSON on standard output, edit included\n"
    }
    sub.about + "\n\nUsage: " + sub.usage + "\n\nArguments:\n  <" + sub.value + ">  \n\nOptions:\n" + options + "  -h, --help  Print help (see more with '--help')\n"
}

/// The help `--help` after a command, or `help` and the command's name, prints.
// example: strings.length(long_help(or(subcommand_named("run"), help_subcommand()))) > 0
fn long_help(sub: Subcommand) -> String {
    if sub.name == "help" {
        return "Print this message or the help of the given subcommand(s)\n\nUsage: lumen help [COMMAND]...\n\nArguments:\n  [COMMAND]...  Print help for the subcommand(s)\n"
    }
    var topics = ""
    for topic in sub.topics {
        topics += topic_text(topic)
    }
    written := topics + "\n\nUsage: " + sub.usage + "\n\nArguments:\n  <" + sub.value + ">\n          \n\n"
    if sub.name == "run" {
        return written + "  [ARGUMENTS]...\n          The words the program is run with, which reach it as the list `main` takes\n"
    }
    var options = "Options:\n"
    if list.has_value(sub.longs, "json") {
        options += "      --json\n          Write the refusal as one line of JSON on standard output, edit included\n\n"
    }
    written + options + "  -h, --help\n          Print help (see a summary with '-h')\n"
}

/// The text of one help topic, which the compiler carries as a resource.
// example: topic_text("no-such-topic") == ""
fn topic_text(topic: String) -> String {
    or(modules.resource_text("help/" + topic + ".md"), "")
}

/// Every command, in the order the help lists them.
// example: list.length(subcommands()) == 8
fn subcommands() -> List<Subcommand> {
    [Subcommand { name: "fmt", about: "Rewrite a source file in canonical form", value: "FILE", usage: "lumen fmt <FILE>", topics: ["fmt"], longs: ["help"] }, Subcommand { name: "check", about: "Report the first thing about a source file or a package the compiler will not have", value: "PATH", usage: "lumen check [OPTIONS] <PATH>", topics: ["check", "packages"], longs: ["json", "help"] }, Subcommand { name: "build", about: "Compile a source file or a package to the class files a JVM loads", value: "PATH", usage: "lumen build <PATH>", topics: ["build", "packages"], longs: ["help"] }, Subcommand { name: "run", about: "Compile a source file and run the program it holds", value: "FILE", usage: "lumen run <FILE> [ARGUMENTS]...", topics: ["run"], longs: [] }, Subcommand { name: "test", about: "Run the examples a module states about its functions", value: "FILE", usage: "lumen test <FILE>", topics: ["test"], longs: ["help"] }, Subcommand { name: "api", about: "Print the public surface of a module", value: "FILE", usage: "lumen api <FILE>", topics: ["api"], longs: ["help"] }, Subcommand { name: "explain", about: "Print the long form of one diagnostic code", value: "CODE", usage: "lumen explain <CODE>", topics: ["explain"], longs: ["help"] }, help_subcommand()]
}

/// `help`, which prints the help of the command it names.
// example: help_subcommand().name == "help"
fn help_subcommand() -> Subcommand {
    Subcommand { name: "help", about: "Print this message or the help of the given subcommand(s)", value: "COMMAND", usage: "lumen help [COMMAND]...", topics: [], longs: [] }
}

/// The most similar of `known` to `written`, where one is similar enough.
// example: or(most_similar("hlp", ["json", "help"]), "") == "help"
fn most_similar(written: String, known: List<String>) -> Option<String> {
    similar := all_similar(written, known)
    list.at(similar, list.length(similar) - 1)
}

/// Every one of `known` similar enough to `written`, the least similar first.
///
/// Two names are similar when their Jaro similarity is above 0.7, which is the measure and the
/// bound the Rust binary's argument parser used. Of two equally similar names the one listed
/// later in `known` comes later.
// example: all_similar("tst", ["fmt", "test"]) == ["test"]
fn all_similar(written: String, known: List<String>) -> List<String> {
    var found = []
    for name in known {
        score := jaro(Compared { written: written, known: name })
        if score.numerator * 10 > score.denominator * 7 {
            found = placed_by_score(found, Scored { name: name, score: score })
        }
    }
    var names = []
    for one in found {
        names = list.push(names, one.name)
    }
    names
}

/// `found`, with `one` after every name that scores no higher than it.
// example: list.length(placed_by_score([], Scored { name: "a", score: Score { numerator: 1, denominator: 1 } })) == 1
fn placed_by_score(found: List<Scored>, one: Scored) -> List<Scored> {
    var placed = []
    var done = false
    for other in found {
        if !done && is_higher(score: other.score, than: one.score) {
            placed = list.push(placed, one)
            done = true
        }
        placed = list.push(placed, other)
    }
    if !done {
        placed = list.push(placed, one)
    }
    placed
}

/// Whether `score` is higher than `than`.
// example: is_higher(score: Score { numerator: 2, denominator: 3 }, than: Score { numerator: 1, denominator: 2 })
fn is_higher(score: Score, than: Score) -> Bool {
    score.numerator * than.denominator > than.numerator * score.denominator
}

/// The Jaro similarity of two words, as a fraction.
///
/// Two letters match where they are equal and no further apart than half the longer word, less
/// one. The similarity is the mean of the matches over each length and of the matches in order.
// example: is_higher(score: jaro(Compared { written: "chek", known: "check" }), than: Score { numerator: 7, denominator: 10 })
// example: jaro(Compared { written: "", known: "" }).numerator == 1
fn jaro(compared: Compared) -> Score {
    written_length := strings.length(compared.written)
    known_length := strings.length(compared.known)
    if written_length == 0 && known_length == 0 {
        return Score { numerator: 1, denominator: 1 }
    }
    if written_length == 0 || known_length == 0 {
        return Score { numerator: 0, denominator: 1 }
    }
    matched := matches_of(compared)
    count := list.length(matched.written)
    if count == 0 {
        return Score { numerator: 0, denominator: 1 }
    }
    swapped := or(transpositions(compared, matched) / 2, 0)
    Score { numerator: count * count * known_length + count * count * written_length + (count - swapped) * written_length * known_length, denominator: 3 * written_length * known_length * count }
}

/// Which letters of each word match a letter of the other, in the order of each word.
// example: list.length(matches_of(Compared { written: "chek", known: "check" }).written) == 4
fn matches_of(compared: Compared) -> Matched {
    written_length := strings.length(compared.written)
    known_length := strings.length(compared.known)
    reach := larger(one: or(larger(one: written_length, other: known_length) / 2, 0) - 1, other: 0)
    var taken = set.empty()
    var written_matched = []
    var index = 0
    for index < written_length {
        letter := or(strings.at(compared.written, index), 0)
        var other = larger(one: index - reach, other: 0)
        for other < smaller(one: known_length, other: index + reach + 1) {
            if !set.has_value(taken, other) && or(strings.at(compared.known, other), 0) == letter {
                taken = set.insert(taken, other)
                written_matched = list.push(written_matched, index)
                break
            }
            other += 1
        }
        index += 1
    }
    var known_matched = []
    var at = 0
    for at < known_length {
        if set.has_value(taken, at) {
            known_matched = list.push(known_matched, at)
        }
        at += 1
    }
    Matched { written: written_matched, known: known_matched }
}

/// The smaller of two numbers.
// example: smaller(one: 2, other: 3) == 2
fn smaller(one: Int, other: Int) -> Int {
    if other < one {
        return other
    }
    one
}

/// The larger of two numbers.
// example: larger(one: 2, other: 3) == 3
fn larger(one: Int, other: Int) -> Int {
    if other > one {
        return other
    }
    one
}

/// How many matched letters, read in order in each word, differ from their partner.
// example: transpositions(Compared { written: "ab", known: "ba" }, Matched { written: [0, 1], known: [0, 1] }) == 2
fn transpositions(compared: Compared, matched: Matched) -> Int {
    var count = 0
    var index = 0
    for index < list.length(matched.written) {
        one := or(strings.at(compared.written, or(list.at(matched.written, index), 0)), 0)
        other := or(strings.at(compared.known, or(list.at(matched.known, index), 0)), 0)
        if one != other {
            count += 1
        }
        index += 1
    }
    count
}

/// Why the file at `path` could not be read, in the words the Rust compiler gave.
///
/// The JVM names a failure in words of its own, so the reason is found by looking at the path: a
/// directory, a file that cannot be opened, a file that is not UTF-8, or no file at all.
// example: read_refusal("no-such-directory/a.lm") == "No such file or directory (os error 2)"
fn read_refusal(path: String) -> String {
    place := place_at(path)
    if is_folder(place) {
        return "Is a directory (os error 21)"
    }
    if is_there(place) && !is_readable(place) {
        return "Permission denied (os error 13)"
    }
    if is_there(place) {
        return "stream did not contain valid UTF-8"
    }
    if is_under_a_file(path) {
        return "Not a directory (os error 20)"
    }
    "No such file or directory (os error 2)"
}

/// Why the file at `path` could not be written, in the words the Rust compiler gave.
// example: write_refusal("no-such-directory/a.lm") == "No such file or directory (os error 2)"
fn write_refusal(path: String) -> String {
    if is_folder(place_at(path)) {
        return "Is a directory (os error 21)"
    }
    if is_under_a_file(path) {
        return "Not a directory (os error 20)"
    }
    if !is_folder(place_at(modules.directory_of(path))) {
        return "No such file or directory (os error 2)"
    }
    "Permission denied (os error 13)"
}

/// Why the directory at `path` could not be made, in the words the Rust compiler gave.
// example: making_refusal("/") == "File exists (os error 17)"
fn making_refusal(path: String) -> String {
    if is_there(place_at(path)) {
        return "File exists (os error 17)"
    }
    if is_under_a_file(path) {
        return "Not a directory (os error 20)"
    }
    "Permission denied (os error 13)"
}

/// Whether `path` ends with a slash, which names a directory.
// example: has_trailing_slash("a/")
fn has_trailing_slash(path: String) -> Bool {
    or(strings.at(path, strings.length(path) - 1), 0) == 47
}

/// Whether a directory `path` passes through is a file, which no path goes on from.
// example: !is_under_a_file("no-such-directory/a.lm")
fn is_under_a_file(path: String) -> Bool {
    var above = parent_path(place_at(path))
    for is_stated(above) {
        place := place_at(or(above, ""))
        if is_there(place) && !is_folder(place) {
            return true
        }
        above = parent_path(place)
    }
    false
}

/// Whether a comment states an example.
// example: is_stated(Some("1 == 1"))
fn is_stated(expression: Option<String>) -> Bool {
    match expression {
        Some(_) => true
        None => false
    }
}

/// The answer of the command line: the text of each stream and a status, or a program to start.
type Answer =
    | Spoken(Said)
    | Starts(List<String>)

derive Eq for Command

derive Eq for Form

/// What the words ask for: an answer given at once, a command, or a program to run.
type Parsed =
    | Told(Said)
    | Asked(Command)
    | Running(Started)

/// What a command writes on standard output and standard error, and the status it ends with.
type Said = {
    output: String
    errors: String
    status: Int
}

/// A command the words ask for, other than `run`.
type Command =
    | Fmt(String)
    | Check {
        path: String
        form: Form
    }
    | Build(String)
    | Test(String)
    | Api(String)
    | Explain(String)

/// `check` over one path, in the form its refusal is shown in.
type Checking = {
    path: String
    form: Form
}

/// A package directory, with the names of every entry it holds.
type Package = {
    directory: String
    names: List<String>
}

/// The command a package is given: `check` in one form, or `build`.
type Over =
    | CheckingAs(Form)
    | Building

/// How a refusal is shown: as a page for a reader, or as one line of JSON for a tool.
type Form =
    | AsPage
    | AsData

/// A program to run, and the words it is run with.
type Started = {
    file: String
    arguments: List<String>
}

/// A module built: the class a JVM starts, where its classes are, and whether it is a program.
type Built = {
    module: String
    target: String
    starts: Bool
}

/// Every module of a program, checked, and the one the command named.
type Checked = {
    modules: List<Typed>
    root: Typed
}

/// What a step found, and the memo as that step left it.
type Memoed<T> = {
    found: Result<T, NotCompiled>
    memo: Memo
}

/// What a module is typed with: the library, and the modules typed already.
type Typing = {
    library: ir.Library
    memo: Memo
}

/// Every module typed so far, by the canonical path of its file, and the paths of those whole.
///
/// A module is whole where it holds no hole and each of its functions states an example.
type Memo = {
    typed: map.Map<String, Typed>
    whole: set.Set<String>
}

/// One module, and what inference settled of it.
type Typed = {
    module: modules.Module
    inferred: infer.Inference
}

/// Why a program was not compiled: a file not read, said already, or a refusal of one that was.
type NotCompiled =
    | Unusable(String)
    | Refused(Refusal)

/// Every diagnostic of one refusal, and the page they point into.
type Refusal = {
    diagnostics: List<Diagnostic>
    page: Page
}

/// A source and the path of its file, which is what a refusal is shown against.
type Page = {
    source: String
    path: String
}

/// One thing the compiler will not have: its code, its message, where it is, and what helps.
type Diagnostic = {
    code: String
    message: String
    span: lexer.Span
    help: Option<String>
    fix: Option<Fix>
}

/// The edit that answers a diagnostic: `text` in place of the bytes `span` covers.
type Fix = {
    span: lexer.Span
    text: String
}

/// Where the run of the examples is written and started: the JDK, the class, and the directory.
type Beside = {
    java: String
    module: String
    beside: String
}

derive Eq for RootForm

/// What one module is checked with: what the modules before it offer, and the form it is held to.
type Accepting = {
    imported: surface.Imported
    form: RootForm
}

/// What the module a command named is held to: canonical form, or only what it was written as.
type RootForm =
    | ToCanonicalForm
    | AsWritten

/// A source with the line comments it holds.
type Commented = {
    measured: Measured
    comments: List<lexer.Token>
}

/// A source, with the byte each of its code units starts at and the byte it ends at.
type Measured = {
    source: String
    starts: List<Int>
}

/// A stretch between two offsets.
type Stretched = {
    from: Int
    to: Int
}

/// The run of the examples: its source, where each stretch of it came from, and its examples.
type Run = {
    source: String
    stretches: List<Placed>
    examples: List<Example>
    module: lexer.Span
}

/// One example: the function it documents, the expression it states, and the comment it is in.
type Example = {
    of: String
    expression: String
    span: lexer.Span
}

/// The run as it is written: its source so far, how many bytes that is, and its stretches.
type Writing = {
    source: String
    bytes: Int
    stretches: List<Placed>
}

/// Text the run writes, and what in the original it is about.
type Stretch = {
    text: String
    about: About
}

/// Where a stretch of the run lies, and what in the original it is about.
type Placed = {
    span: lexer.Span
    about: About
}

/// What a stretch of the run is about: copied text, the trying of one example, or the module.
type About =
    | SameText(Int)
    | OneExample(Int)
    | WholeModule

/// Where a diagnostic points: its line and column, the line's text, and the carets under it.
type Pointed = {
    line: Int
    column: Int
    text: String
    width: Int
    padding: String
    note: String
}

/// The line a span opens on and the line it ends on.
type Lines = {
    first: Int
    last: Int
}

/// A command a word names: what it says of itself, and the flags and the argument it takes.
type Subcommand = {
    name: String
    about: String
    value: String
    usage: String
    topics: List<String>
    longs: List<String>
}

/// One word read as a flag, and the flags read before it.
type Flagged = {
    word: String
    used: List<String>
}

/// A long flag, and the flags read before it.
type Held = {
    long: Long
    used: List<String>
}

/// A long flag: its name, and the value written after `=`, where one is.
type Long = {
    name: String
    value: Option<String>
}

/// The argument of a command, and the flags written with it.
type Given = {
    value: String
    used: List<String>
}

/// A refusal of the words: the message, a tip, the usage line, and whether it points at `--help`.
type Complaint = {
    message: String
    tip: Option<String>
    usage: String
    offers_help: Bool
}

/// A name, and how similar it is to the word written.
type Scored = {
    name: String
    score: Score
}

/// A similarity as a fraction, so two are compared exactly.
type Score = {
    numerator: Int
    denominator: Int
}

/// A word written, and a name it is compared with.
type Compared = {
    written: String
    known: String
}

/// The letters of each word that match one of the other, by index, in order.
type Matched = {
    written: List<Int>
    known: List<Int>
}

/// The file or directory at `path`, whether or not there is one.
extern new place_at(path: String) -> Entry

/// Whether there is anything at the place.
extern method is_there(place: Entry) -> Bool = "exists"

/// Whether the place is a directory.
extern method is_folder(place: Entry) -> Bool = "isDirectory"

/// Whether this process may read the place.
extern method is_readable(place: Entry) -> Bool = "canRead"

/// Whether the directory, and every one above it that was missing, was made.
extern method has_made_all(place: Entry) -> Bool = "mkdirs"

/// Whether the one directory was made, which it is not where anything is there already.
extern method is_made(place: Entry) -> Bool = "mkdir"

/// The path of the directory above the place, and `None` where the path names none.
extern method parent_path(place: Entry) -> Option<String> = "getParent"

/// A clock that only goes forward, in nanoseconds, which names a directory no run has used.
extern static nanoseconds() -> Int = "java.lang.System.nanoTime"

/// The builder, with the program reading and writing the streams of this process.
extern method inheriting(builder: programs.ProcessBuilder) -> programs.ProcessBuilder = "inheritIO"

/// The environment that the builder starts a program with, which a change to it changes.
extern method variables_of(builder: programs.ProcessBuilder) -> Variables = "environment"

/// Removes the variable `name`, and gives back its value where it held one.
extern method removed(variables: Variables, name: VariableName) -> Option<VariableName> = "remove"

/// The text as a constant, which is how a `String` becomes a value that `removed` takes.
extern method held_as_constant(text: String) -> Constant = "describeConstable"

/// The text that the constant holds, as the `java.lang.Object` that `Map.remove` takes.
extern method as_object(constant: Constant) -> VariableName = "orElseThrow"

/// A file or a directory, named by its path.
extern type Entry = "java.io.File"

/// The environment of a program not started yet, from the name of a variable to its value.
extern type interface Variables = "java.util.Map"

/// A constant that a `String` describes itself as, which holds that `String`.
extern type Constant = "java.util.Optional"

/// A value as a JVM object, which is what `java.util.Map` takes as the name of a variable.
extern type VariableName = "java.lang.Object"
