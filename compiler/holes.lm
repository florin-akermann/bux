// Holes: every `todo(…)` a module holds, which `lumen check` accepts and `lumen build` refuses.
//
// `docs/specs/holes.md` states the rule, and `crates/holes` finds the holes in Rust.
// A hole is a call of the prelude's `todo`, and resolution says which calls are of that one.
// Every hole is found, in the order the module writes them, because a build names every one.
import ast

import exhaustiveness

import infer

import lexer

import list

import map

import modules

import resolver

import types

/// What the listing says of the program at `path`, in the form the harness compares.
///
/// A program that every phase before a build accepts is `checked`, then one refusal for each
/// hole, module by module in the order they load. A refusal is the module, then the code, the
/// span, and the message, then the help. A program that a phase before this one refuses is
/// `skipped`.
// example: printed("no-such-directory/main.lm", types.little_prelude()) == "skipped\n"
fn printed(path: String, prelude: types.Prelude) -> String {
    match modules.load(path) {
        Ok(loaded) => listed(exhaustiveness.modules_checked(loaded, prelude))
        Err(_) => "skipped\n"
    }
}

/// The holes of every checked module, and `skipped` where a phase before this one refused.
// example: listed(Err("refused main\n")) == "skipped\n"
fn listed(checked: Result<List<infer.Inference>, String>) -> String {
    match checked {
        Ok(inferred) => every_module_listed(inferred)
        Err(_) => "skipped\n"
    }
}

/// `checked`, then each hole of each module, in the order the modules load.
// example: every_module_listed([types.checked_of("fn f() -> Int {\n    todo(\"x\")\n}\n")]) == "checked\nmain L0600 20..29 this hole is not compiled\nhelp: `lumen check` accepts a hole; fill it in, or build a module that holds none\n"
fn every_module_listed(inferred: List<infer.Inference>) -> String {
    var written = "checked\n"
    for one in inferred {
        for hole in of_module(one.resolved) {
            written += one.resolved.module + " " + hole_printed(hole)
        }
    }
    written
}

/// The spans of the holes `source` holds, one after another.
// example: holes_of("fn f() -> Int {\n    todo(todo(\"x\"))\n}\n") == "20..35 25..34 "
fn holes_of(source: String) -> String {
    var written = ""
    for hole in of_module(declared_resolved(source)) {
        written += shown(hole.span) + " "
    }
    written
}

/// `source`, resolved against the small prelude of the examples.
// example: declared_resolved("").module == "main"
fn declared_resolved(source: String) -> resolver.Resolved {
    types.checked_of(source).resolved
}

/// Every hole of `resolved`, in the order they are written.
// example: list.length(of_module(declared_resolved("fn f() -> Int {\n    1\n}\n"))) == 0
fn of_module(resolved: resolver.Resolved) -> List<Hole> {
    var found = []
    for function in infer.functions_of(resolved.program) {
        found = block_holes(resolved, found, function.body)
    }
    found
}

/// `found`, then the holes of each statement of a block.
// example: holes_of("fn f() -> Int {\n    held := todo(\"x\")\n    held\n}\n") == "28..37 "
fn block_holes(resolved: resolver.Resolved, found: List<Hole>, walked: ast.Block) -> List<Hole> {
    var gathered = found
    for statement in walked.statements {
        gathered = statement_holes(resolved, gathered, statement)
    }
    gathered
}

/// `found`, then the holes of the expressions of one statement.
// example: holes_of("fn f() -> Int {\n    return todo(\"x\")\n}\n") == "27..36 "
fn statement_holes(resolved: resolver.Resolved, found: List<Hole>, statement: ast.Statement) -> List<Hole> {
    match statement.kind {
        ast.Binding { mutability, name, value } => expression_holes(resolved, found, value)
        ast.Assign { target, operator, value } => expression_holes(resolved, found, value)
        ast.Return(given) => given_holes(resolved, found, given)
        ast.For(looped) => loop_holes(resolved, found, looped)
        ast.Discard(value) => expression_holes(resolved, found, value)
        ast.Evaluated(value) => expression_holes(resolved, found, value)
        _ => found
    }
}

/// `found`, then the holes of the value a `return` gives back, when it gives one.
// example: list.length(given_holes(declared_resolved(""), [], None)) == 0
fn given_holes(resolved: resolver.Resolved, found: List<Hole>, given: Option<ast.Expr>) -> List<Hole> {
    match given {
        Some(value) => expression_holes(resolved, found, value)
        None => found
    }
}

/// `found`, then the holes of what a `for` loops over or while, then those of its body.
// example: holes_of("fn f() -> Int {\n    for todo(\"x\") {\n        _ = todo(\"y\")\n    }\n    1\n}\n") == "24..33 48..57 "
fn loop_holes(resolved: resolver.Resolved, found: List<Hole>, looped: ast.ForLoop) -> List<Hole> {
    block_holes(resolved, header_holes(resolved, found, looped.header), looped.body)
}

/// `found`, then the holes of the condition of a `for`, or of what it loops over.
// example: list.length(header_holes(declared_resolved(""), [], ast.Forever)) == 0
fn header_holes(resolved: resolver.Resolved, found: List<Hole>, header: ast.ForHeader) -> List<Hole> {
    match header {
        ast.Forever => found
        ast.While(condition) => expression_holes(resolved, found, condition)
        ast.Over { binding, iterable } => expression_holes(resolved, found, iterable)
    }
}

/// `found`, then the holes inside one expression, in the order they are written.
// example: holes_of("fn f() -> Int {\n    todo(\"x\") + todo(\"y\")\n}\n") == "20..29 32..41 "
fn expression_holes(resolved: resolver.Resolved, found: List<Hole>, walked: ast.Expr) -> List<Hole> {
    match walked.kind {
        ast.Unary { operator, operand } => expression_holes(resolved, found, operand)
        ast.Binary { operator, left, right } => each_holes(resolved, found, [left, right])
        ast.Call { callee, arguments } => call_holes(resolved, callee_holes(resolved, found, callee, walked.span), arguments)
        ast.Field { receiver, name } => expression_holes(resolved, found, receiver)
        ast.Try(inner) => expression_holes(resolved, found, inner)
        ast.Written(values) => each_holes(resolved, found, values)
        ast.Record { base, fields } => fields_holes(resolved, found, fields)
        ast.If(chain) => if_holes(resolved, found, chain)
        ast.Match(matched) => match_holes(resolved, found, matched)
        _ => found
    }
}

/// `found`, then the holes of each argument of a call.
///
/// The arguments are walked whether or not the call is a hole, because `todo(name_of(todo("why")))`
/// holds two.
// example: holes_of("fn f(held: Int) -> Int {\n    f(held: todo(\"x\"))\n}\n") == "37..46 "
fn call_holes(resolved: resolver.Resolved, found: List<Hole>, arguments: ast.Arguments) -> List<Hole> {
    each_holes(resolved, found, infer.values_of(arguments))
}

/// `found` with the call at `span` where its callee is the hole, and the holes of the callee otherwise.
// example: holes_of("fn f() -> Int {\n    or(todo(\"x\"), 1)\n}\n") == "23..32 "
fn callee_holes(resolved: resolver.Resolved, found: List<Hole>, callee: ast.Expr, span: lexer.Span) -> List<Hole> {
    if is_the_hole(resolved, callee) {
        return list.push(found, Hole { span: span })
    }
    expression_holes(resolved, found, callee)
}

/// Whether `callee` names the hole the prelude supplies, rather than one a module declared.
// example: holes_of("fn f() -> Int {\n    todo(\"x\")\n}\n") == "20..29 "
fn is_the_hole(resolved: resolver.Resolved, callee: ast.Expr) -> Bool {
    match callee.kind {
        ast.NameExpr(name) => name.text == "todo" && is_from_prelude(map.get(resolved.found, resolver.key_of(resolver.ValueNamespace, name.span.start)))
        _ => false
    }
}

/// Whether a name resolved to a definition of the prelude.
// example: !is_from_prelude(None)
fn is_from_prelude(found: Option<resolver.Resolution>) -> Bool {
    match found {
        Some(resolution) => is_prelude_origin(resolution.definition.origin)
        None => false
    }
}

/// Whether a definition came from the prelude.
// example: is_prelude_origin(resolver.InPrelude)
fn is_prelude_origin(origin: resolver.Origin) -> Bool {
    match origin {
        resolver.InPrelude => true
        resolver.Declared(_) => false
    }
}

/// `found`, then the holes of each of `values`, in the order they are written.
// example: holes_of("fn f() -> List<Int> {\n    [todo(\"x\"), todo(\"y\")]\n}\n") == "27..36 38..47 "
fn each_holes(resolved: resolver.Resolved, found: List<Hole>, values: List<ast.Expr>) -> List<Hole> {
    var gathered = found
    for value in values {
        gathered = expression_holes(resolved, gathered, value)
    }
    gathered
}

/// `found`, then the holes of the value of each field a record literal writes.
// example: holes_of("fn f() -> Box {\n    Box { held: todo(\"x\") }\n}\n\ntype Box = {\n    held: Int\n}\n") == "32..41 "
fn fields_holes(resolved: resolver.Resolved, found: List<Hole>, fields: List<ast.FieldValue>) -> List<Hole> {
    var gathered = found
    for field in fields {
        gathered = expression_holes(resolved, gathered, field.value)
    }
    gathered
}

/// `found`, then the holes of each condition and the block it guards, then of the `else` block.
// example: holes_of("fn f() -> Int {\n    if todo(\"x\") {\n        todo(\"y\")\n    } else {\n        todo(\"z\")\n    }\n}\n") == "23..32 43..52 74..83 "
fn if_holes(resolved: resolver.Resolved, found: List<Hole>, chain: ast.IfExpr) -> List<Hole> {
    var gathered = found
    for branch in chain.branches {
        gathered = block_holes(resolved, expression_holes(resolved, gathered, branch.condition), branch.block)
    }
    match chain.otherwise {
        Some(otherwise) => block_holes(resolved, gathered, otherwise)
        None => gathered
    }
}

/// `found`, then the holes of the scrutinee, then those of the body of each arm.
// example: holes_of("fn f() -> Int {\n    match todo(\"x\") {\n        _ => todo(\"y\")\n    }\n}\n") == "26..35 51..60 "
fn match_holes(resolved: resolver.Resolved, found: List<Hole>, matched: ast.MatchExpr) -> List<Hole> {
    var gathered = expression_holes(resolved, found, matched.scrutinee)
    for arm in matched.arms {
        gathered = expression_holes(resolved, gathered, arm.body)
    }
    gathered
}

/// One hole as a build refuses it: the code, the span, and the message, then the help.
// example: hole_printed(Hole { span: lexer.Span { start: 2, length: 9 } }) == "L0600 2..11 this hole is not compiled\nhelp: `lumen check` accepts a hole; fill it in, or build a module that holds none\n"
fn hole_printed(hole: Hole) -> String {
    "L0600 " + shown(hole.span) + " this hole is not compiled\nhelp: `lumen check` accepts a hole; fill it in, or build a module that holds none\n"
}

/// A `todo(…)` written where a value belongs.
///
/// A hole carries only where it is written, because the reason is written there too: the
/// rendered line under the message is what names it.
type Hole = {
    span: lexer.Span
}
