// The refusal of an `Option` that carries `()`, where inference reaches one.
//
// `docs/specs/types.md` states the rule, and `compiler/declared.lm` refuses a written one first.
// This module reads the types inference settled, so it is reached after every other refusal of
// inference. An expression is read after the expressions inside it, so the refusal points at the
// innermost expression whose type holds `Option<()>`.
import ast
import declared
import infer
import lexer
import refusal
import surface
import unify

/// The code and span of the refusal `source` earns against the small prelude, or `""`.
// example: carried_code("fn is_none() -> Bool {\n    match [None, Some(())] {\n        _ => true\n    }\n}\n") == "L0432 34..38"
fn carried_code(source: String) -> String {
    resolved := declared.resolved_of(source)
    match declared.environment_of(declared.little_environment(), resolved, [], [], unify.empty_table()) {
        Ok(declaring) => refusal.code_given(inferred_and_read(infer.module_inferred(resolved, surface.nothing_imported(), declaring)))
        Err(refused) => infer.code_of_error(refused)
    }
}

/// `inferred`, read for an `Option<()>` where inference accepted it.
// example: refusal.code_given(inferred_and_read(Ok(infer.nothing_inferred()))) == ""
fn inferred_and_read(inferred: Result<infer.Inference, refusal.TypeError>) -> Result<infer.Inference, refusal.TypeError> {
    nothing_carried(inferred?)
}

/// `inference`, or the refusal of the first expression whose type holds `Option<()>`.
///
/// The functions are read in the order the module writes them.
// example: carried_code("fn is_there() -> Bool {\n    match Some(()) {\n        Some(_) => true\n        None => false\n    }\n}\n") == "L0432 34..42"
// example: carried_code("fn is_there() -> Bool {\n    match Some(true) {\n        Some(held) => held\n        None => false\n    }\n}\n") == ""
fn nothing_carried(inference: infer.Inference) -> Result<infer.Inference, refusal.TypeError> {
    for function in infer.functions_of(inference.resolved.program) {
        _ = block_read(inference, function.body)?
    }
    Ok(inference)
}

/// Each statement of `block`, read in the order it is written.
// example: refusal.code_given(block_read(infer.nothing_inferred(), ast.Block { statements: [], span: nowhere() })) == ""
fn block_read(inference: infer.Inference, block: ast.Block) -> Result<(), refusal.TypeError> {
    for statement in block.statements {
        _ = statement_read(inference, statement)?
    }
    Ok(())
}

/// The expressions of one statement.
// example: refusal.code_given(statement_read(infer.nothing_inferred(), ast.Statement { kind: ast.Break, span: nowhere() })) == ""
fn statement_read(inference: infer.Inference, statement: ast.Statement) -> Result<(), refusal.TypeError> {
    match statement.kind {
        ast.Binding { mutability, name, value } => expression_read(inference, value)
        ast.Assign { target, operator, value } => expression_read(inference, value)
        ast.Return(given) => given_read(inference, given)
        ast.For(looped) => loop_read(inference, looped)
        ast.Discard(value) => expression_read(inference, value)
        ast.Evaluated(value) => expression_read(inference, value)
        _ => Ok(())
    }
}

/// The value a `return` gives back, where it gives one.
// example: refusal.code_given(given_read(infer.nothing_inferred(), None)) == ""
fn given_read(inference: infer.Inference, given: Option<ast.Expr>) -> Result<(), refusal.TypeError> {
    match given {
        Some(value) => expression_read(inference, value)
        None => Ok(())
    }
}

/// The header of a `for`, then its body.
// example: carried_code("fn is_there() -> Bool {\n    for held in [Some(())] {\n        return true\n    }\n    false\n}\n") == "L0432 41..49"
fn loop_read(inference: infer.Inference, looped: ast.ForLoop) -> Result<(), refusal.TypeError> {
    _ = header_read(inference, looped.header)?
    block_read(inference, looped.body)
}

/// The condition of a `for`, or what it loops over.
// example: refusal.code_given(header_read(infer.nothing_inferred(), ast.Forever)) == ""
fn header_read(inference: infer.Inference, header: ast.ForHeader) -> Result<(), refusal.TypeError> {
    match header {
        ast.Forever => Ok(())
        ast.While(condition) => expression_read(inference, condition)
        ast.Over { binding, iterable } => expression_read(inference, iterable)
    }
}

/// The expressions inside `written`, then `written` itself.
// example: refusal.code_given(expression_read(infer.nothing_inferred(), ast.Expr { kind: ast.Unit, span: nowhere() })) == ""
fn expression_read(inference: infer.Inference, written: ast.Expr) -> Result<(), refusal.TypeError> {
    _ = inside_read(inference, written)?
    match infer.type_at(inference, written.span) {
        Some(found) => held_refused(found, written.span)
        None => Ok(())
    }
}

/// Refuses the expression at `at` where its type `found` holds `Option<()>`.
// example: refusal.code_given(held_refused(unify.list_of(unify.option_of(unify.Unit)), nowhere())) == "L0432 0..0"
fn held_refused(found: unify.Type, at: lexer.Span) -> Result<(), refusal.TypeError> {
    if unify.has_unit_in_option(found) {
        return Err(refusal.TypeError { kind: refusal.UnitInOption, span: at })
    }
    Ok(())
}

/// The expressions `written` holds, each in the order it is written.
// example: carried_code("fn held() -> Option<Bool> {\n    _ = Some(())?\n    None\n}\n") == "L0432 36..44"
fn inside_read(inference: infer.Inference, written: ast.Expr) -> Result<(), refusal.TypeError> {
    match written.kind {
        ast.Unary { operator, operand } => expression_read(inference, operand)
        ast.Binary { operator, left, right } => each_read(inference, [left, right])
        ast.Call { callee, arguments } => call_read(inference, callee, arguments)
        ast.Field { receiver, name } => expression_read(inference, receiver)
        ast.Try(inner) => expression_read(inference, inner)
        ast.Written(elements) => each_read(inference, elements)
        ast.Record { base, fields } => fields_read(inference, fields)
        ast.If(chain) => if_read(inference, chain)
        ast.Match(matched) => match_read(inference, matched)
        ast.Spawn(started) => expression_read(inference, started)
        _ => Ok(())
    }
}

/// What a call calls, then each value it passes.
// example: carried_code("fn is_there() -> Bool {\n    _ = or(Some(()), ())\n    true\n}\n") == "L0432 35..43"
fn call_read(inference: infer.Inference, callee: ast.Expr, arguments: ast.Arguments) -> Result<(), refusal.TypeError> {
    _ = expression_read(inference, callee)?
    each_read(inference, infer.values_of(arguments))
}

/// Each of `values`, in order.
// example: refusal.code_given(each_read(infer.nothing_inferred(), [])) == ""
fn each_read(inference: infer.Inference, values: List<ast.Expr>) -> Result<(), refusal.TypeError> {
    for value in values {
        _ = expression_read(inference, value)?
    }
    Ok(())
}

/// The value of each field a record literal writes.
// example: refusal.code_given(fields_read(infer.nothing_inferred(), [])) == ""
fn fields_read(inference: infer.Inference, fields: List<ast.FieldValue>) -> Result<(), refusal.TypeError> {
    for field in fields {
        _ = expression_read(inference, field.value)?
    }
    Ok(())
}

/// Each condition and the block it guards, then the `else` block.
// example: carried_code("fn is_there(held: Int) -> Bool {\n    _ = if held == 1 {\n        Some(())\n    } else {\n        None\n    }\n    true\n}\n") == "L0432 64..72"
fn if_read(inference: infer.Inference, chain: ast.IfExpr) -> Result<(), refusal.TypeError> {
    for branch in chain.branches {
        _ = expression_read(inference, branch.condition)?
        _ = block_read(inference, branch.block)?
    }
    match chain.otherwise {
        Some(otherwise) => block_read(inference, otherwise)
        None => Ok(())
    }
}

/// The scrutinee, then the body of each arm.
// example: carried_code("fn is_there(held: Int) -> Bool {\n    match held {\n        1 => is_there(held)\n        _ => false\n    }\n}\n") == ""
fn match_read(inference: infer.Inference, matched: ast.MatchExpr) -> Result<(), refusal.TypeError> {
    _ = expression_read(inference, matched.scrutinee)?
    for arm in matched.arms {
        _ = expression_read(inference, arm.body)?
    }
    Ok(())
}

/// A span at the start of the source, which the examples of a single node are written at.
// example: nowhere().length == 0
fn nowhere() -> lexer.Span {
    lexer.Span { start: 0, length: 0 }
}
