// Lowering: each typed module turned into the classes of the JVM, as instructions over a stack.
//
// `docs/specs/codegen.md` states the rules, and `tests/lowering.lm` holds them on drawn modules.
// A module gives its own class, one class for each type it declares, and the class of a list.
// A generic is written once for each set of types a use settles it on, which a pass asks for.
// The passes go on until no module asks another for a method it has not written.
import ast

import declared

import exhaustiveness

import holes

import infer

import lexer

import list

import map

import modules

import parser

import resolver

import set

import strings

import surface

import types

import unify

/// Every module of the program at `path`, lowered, or `skipped` where a phase before this refuses.
///
/// A program that does not load, resolve, type, or pass the exhaustiveness check is skipped, and
/// so is one that holds a hole, because a build refuses a hole.
// example: list.length(ok_or(program_lowered("no-such-directory/main.lm", little_library()), [])) == 0
fn program_lowered(path: String, library: Library) -> Result<List<Lowered>, String> {
    match modules.load(path) {
        Ok(loaded) => checked_lowered(exhaustiveness.modules_checked(loaded, library.prelude), library)
        Err(_) => Err("skipped\n")
    }
}

/// The checked modules, lowered, or `skipped` where a check refused or a module holds a hole.
// example: list.length(ok_or(checked_lowered(Err("refused"), little_library()), [])) == 0
fn checked_lowered(checked: Result<List<infer.Inference>, String>, library: Library) -> Result<List<Lowered>, String> {
    typed := checked?
    for module in typed {
        if list.length(holes.of_module(module.resolved)) > 0 {
            return Err("skipped\n")
        }
    }
    Ok(passes_lowered(typed, library))
}

/// Every module lowered, pass after pass, until no module asks another for a method it lacks.
///
/// A module written before another asked it for a generic has not written that generic, so the
/// pass is run again with every ask known. The modules are lowered last first, so a module is
/// lowered after each module that imports it, and the prelude is lowered after all of them.
// example: list.length(passes_lowered([], little_library())) == 1
fn passes_lowered(typed: List<infer.Inference>, library: Library) -> List<Lowered> {
    classes := module_classes(typed)
    var asked = no_asks()
    for {
        pass := pass_over(typed, library, classes, asked)
        if !is_asking_more(pass) {
            return reversed(pass.lowered)
        }
        asked = pass.asked
    }
    []
}

/// One pass: each module lowered with what the pass knows is asked of it, and the prelude last.
///
/// `classes` holds the class of each module whose class is not its name.
// example: list.length(pass_over([], little_library(), only_the_prelude(), no_asks()).knew) == 1
fn pass_over(typed: List<infer.Inference>, library: Library, classes: map.Map<String, String>, asked: Asked) -> Pass {
    var pass = Pass { lowered: [], asked: asked, knew: [] }
    for module in reversed(typed) {
        naming := naming_in(pass, classes, module.resolved.module)
        pass = pass_added(pass, naming.module, lowered_module(module, library, naming, pass.asked))
    }
    pass_added(pass, "prelude", lowered_prelude(library, classes, pass.asked))
}

/// How the module `name` is named in `pass`, where `classes` holds the class of each module whose
/// class is not its name.
///
/// The first module a pass lowers is the one the command names, and its class is its name.
/// The other modules spell it as `root_spelled` spells it, and each other one by its name.
// example: naming_in(Pass { lowered: [], asked: no_asks(), knew: [] }, only_the_prelude(), "prelude").class == "prelude"
// example: naming_in(Pass { lowered: [], asked: no_asks(), knew: [] }, only_the_prelude(), "prelude").module == "prelude$"
// example: naming_in(Pass { lowered: [no_lowered()], asked: no_asks(), knew: [] }, only_the_prelude(), "prelude").class == "lumen/library/prelude"
fn naming_in(pass: Pass, classes: map.Map<String, String>, name: String) -> Naming {
    if list.length(pass.lowered) == 0 {
        return Naming { module: root_spelled(classes, name), class: name, classes: classes }
    }
    Naming { module: name, class: module_named(classes, name), classes: classes }
}

/// The class of each module whose class is not its name, among the modules `typed` and the prelude.
///
/// The last module is the one the command names, and it is the program's whatever its name is.
/// Each other module whose name the library carries is the library's, because an import of that
/// name reaches the library before it reaches a file.
/// The last module is spelled as `root_spelled` spells it, and that spelling names its class.
// example: module_named(module_classes([]), "prelude") == "lumen/library/prelude"
// example: module_named(module_classes([types.checked_of("")]), "main") == "main"
fn module_classes(typed: List<infer.Inference>) -> map.Map<String, String> {
    var classes = only_the_prelude()
    last := list.length(typed) - 1
    var index = 0
    for module in typed {
        name := module.resolved.module
        if index < last && is_carried(name) {
            classes = library_class_added(classes, name)
        }
        index += 1
    }
    match list.at(typed, last) {
        Some(root) => root_class_added(classes, root.resolved.module)
        None => classes
    }
}

/// `classes`, with the class of the module `name` that the command names, where a module of the
/// library has that name too, so that its spelling is not its class.
// example: module_named(root_class_added(only_the_prelude(), "prelude"), "prelude$") == "prelude"
// example: module_named(root_class_added(only_the_prelude(), "main"), "main") == "main"
fn root_class_added(classes: map.Map<String, String>, name: String) -> map.Map<String, String> {
    spelled := root_spelled(classes, name)
    if spelled == name {
        return classes
    }
    map.insert(classes, spelled, name)
}

/// Whether the library carries a module named `name`.
// example: !is_carried("lexer")
fn is_carried(name: String) -> Bool {
    match modules.carried(name) {
        Some(_) => true
        None => false
    }
}

/// How the other modules spell the module `name` that the command names.
///
/// A type of a module is spelled with the name of its module in what one module asks of another.
/// So where a module of the library has the name `name`, a `$` after it tells the two apart.
// example: root_spelled(only_the_prelude(), "prelude") == "prelude$"
// example: root_spelled(only_the_prelude(), "main") == "main"
fn root_spelled(classes: map.Map<String, String>, name: String) -> String {
    match map.get(classes, name) {
        Some(_) => name + "$"
        None => name
    }
}

/// `pass` with `one` lowered as `module`, and what `one` asks of other modules noted.
// example: list.length(pass_added(Pass { lowered: [], asked: no_asks(), knew: [] }, "main", no_lowered()).lowered) == 1
fn pass_added(pass: Pass, module: String, one: Lowered) -> Pass {
    Pass { lowered: list.push(pass.lowered, one), asked: asks_joined(asked: pass.asked, other: one.asks), knew: list.push(pass.knew, Knew { module: module, asked: pass.asked }) }
}

/// Whether the pass asks some module for a method that module did not know of when it was lowered.
// example: !is_asking_more(Pass { lowered: [], asked: no_asks(), knew: [] })
fn is_asking_more(pass: Pass) -> Bool {
    for knew in pass.knew {
        if is_asked_more_of(asked: pass.asked, module: knew.module, before: knew.asked) {
            return true
        }
    }
    false
}

/// `values`, last first.
// example: or(list.at(reversed([1, 2]), 0), 0) == 2
fn reversed<T>(values: List<T>) -> List<T> {
    var turned = []
    var index = list.length(values) - 1
    for index >= 0 {
        turned = match list.at(values, index) {
            Some(value) => list.push(turned, value)
            None => turned
        }
        index = index - 1
    }
    turned
}

/// Every ask of `asked`, then each of `other` that `asked` does not hold yet.
// example: list.length(asks_joined(asked: no_asks(), other: Asked { of: [little_ask()] }).of) == 1
fn asks_joined(asked: Asked, other: Asked) -> Asked {
    var joined = asked
    for one in other.of {
        joined = noted(joined, one)
    }
    joined
}

/// Whether `asked` asks `module` for a method that `before` does not.
// example: is_asked_more_of(asked: Asked { of: [little_ask()] }, module: "main", before: no_asks())
fn is_asked_more_of(asked: Asked, module: String, before: Asked) -> Bool {
    for one in asked.of {
        if one.module == module && !list.has_value(before.of, one) {
            return true
        }
    }
    false
}

/// One ask of the module `main`, for `pick` settled on `Int`.
// example: little_ask().function == "pick"
fn little_ask() -> Specialisation {
    Specialisation { module: "main", function: "pick", settled: [unify.int()], foreign: [] }
}

/// A module that lowered to nothing and asks nothing.
// example: list.length(no_lowered().classes) == 0
fn no_lowered() -> Lowered {
    Lowered { classes: [], asks: no_asks() }
}

/// The prelude a program is lowered against, read out of the prelude's own `source`.
///
/// The prelude is typed as a module is, so the bodies of its instances over a list are lowered
/// from what inference gave them.
// example: set.has_value(library_read("type Box = Box\n").types, "Box")
fn library_read(source: String) -> Library {
    program := ok_or(parser.parse(source), ast.Program { items: [] })
    prelude := types.prelude_read(source)
    resolved := ok_or(resolver.prelude_resolved(program), resolver.Resolved { module: "prelude", program: program, found: map.empty() })
    library_of(prelude, resolved)
}

/// One module, named as `naming` names it, lowered with what the pass knows is asked of it.
// example: list.length(lowered_module(types.checked_of("fn f() -> Int {\n    1\n}\n"), little_library(), main_naming(), no_asks()).classes) == 8
fn lowered_module(typed: infer.Inference, library: Library, naming: Naming, asked: Asked) -> Lowered {
    lowered(lowering_of(typed, library, naming.module, shapes_of(typed, naming, library)), asked)
}

/// The prelude, lowered with what the pass knows is asked of it.
// example: list.length(lowered_prelude(little_library(), only_the_prelude(), no_asks()).classes) == 8
fn lowered_prelude(library: Library, classes: map.Map<String, String>, asked: Asked) -> Lowered {
    lowered(lowering_of(library.typed, library, "prelude", prelude_shapes(library, classes)), asked)
}

/// The module class, then one class for each type the module reaches, then the class of a list.
// example: list.length(lowered(little_lowering("fn f() -> Int {\n    1\n}\n"), no_asks()).classes) == 8
fn lowered(lowering: Lowering, asked: Asked) -> Lowered {
    reached := lowering { shapes: asked_reached(lowering.shapes, asked, lowering.module) }
    classed := module_class(reached, asked)
    written := concatenated(first: concatenated(first: [classed.class], second: shape_classes(reached.shapes)), second: process_classes(classed.lowering))
    Lowered { classes: list.push(written, carrier()), asks: classed.lowering.asks }
}

/// The class of each process the module declares, then the class of a handle where it declares
/// one.
///
/// Every module that declares a process writes the class of a handle, and each writes the same
/// bytes, as each module writes the same class of a list.
// example: list.length(process_classes(little_lowering("fn f() -> Int {\n    1\n}\n"))) == 0
fn process_classes(lowering: Lowering) -> List<Class> {
    var classes = []
    for item in lowering.typed.resolved.program.items {
        classes = match item {
            ast.Process(declaration) => list.push(classes, process_class(lowering, declaration))
            _ => classes
        }
    }
    if list.length(classes) == 0 {
        return []
    }
    list.push(classes, handle_class(lowering.shapes))
}

/// The class a process runs as: what `start` takes, the mailbox, and the end, with the method
/// `spawn` calls and the method the virtual thread of the process runs.
// example: process_class(little_lowering(""), ast.ProcessDeclaration { name: infer.no_name(), functions: [], span: infer.no_name().span }).implements == ["java/lang/Runnable"]
fn process_class(lowering: Lowering, declaration: ast.ProcessDeclaration) -> Class {
    started := signature_of_process(lowering, declaration, 0)
    received := signature_of_process(lowering, declaration, 1)
    shape := process_shape(process_class_name(module: lowering.shapes.class, named: declaration.name.text), started)
    ran := Ran { module: lowering.shapes.class, named: declaration.name.text, started: started, received: received }
    methods := [constructor_method(shape, object_class()), spawned_method(shape, started), run_method(lowering.shapes, shape, ran)]
    Class { name: shape.class, extends: object_class(), extending: Never, implements: ["java/lang/Runnable"], fields: held_fields(shape), methods: methods }
}

/// The fields of a process: each value `start` takes, then the mailbox, then the end.
// example: list.length(process_shape("main/process$Counter", Signature { parameters: [Some(Long)], result: Some(Long) }).carries) == 3
fn process_shape(class: String, started: Signature) -> Shape {
    var carries = []
    var index = 0
    for taken in started.parameters {
        carries = list.push(carries, Carried { name: "argument" + shown(index), of: taken })
        index += 1
    }
    carries = concatenated(first: carries, second: [Carried { name: "mailbox", of: Some(mailbox_descriptor()) }, Carried { name: "finished", of: Some(finished_descriptor()) }])
    Shape { class: class, base: class, tag: None, carries: carries }
}

/// The method `spawn` calls: a mailbox and an end, the process on a virtual thread of its own,
/// and the handle of both.
///
/// `start` runs on the new thread, so `spawn` never waits for it.
// example: spawned_method(process_shape("main/process$Counter", Signature { parameters: [], result: Some(Long) }), Signature { parameters: [], result: Some(Long) }).name == "spawned"
fn spawned_method(shape: Shape, started: Signature) -> Method {
    taken := descriptor_of(Signature { parameters: started.parameters, result: None }).parameters
    mailbox := parameters_width(MethodDescriptor { parameters: taken, result: None })
    finished := mailbox + 1
    var loading = []
    var slot = 0
    for one in taken {
        loading = list.push(loading, Load { slot: slot, of: one })
        slot += width(one)
    }
    opened := [New(mailbox_class()), Copy, IntegerOf(mailbox_bound()), Construct(MethodRef { class: mailbox_class(), name: "<init>", descriptor: MethodDescriptor { parameters: [Integer], result: None } }), Store { slot: mailbox, of: mailbox_descriptor() }, New(finished_class()), Copy, Construct(MethodRef { class: finished_class(), name: "<init>", descriptor: MethodDescriptor { parameters: [], result: None } }), Store { slot: finished, of: finished_descriptor() }]
    held := [Load { slot: mailbox, of: mailbox_descriptor() }, Load { slot: finished, of: finished_descriptor() }]
    started_thread := concatenated(first: concatenated(first: concatenated(first: [New(shape.class), Copy], second: loading), second: held), second: [Construct(MethodRef { class: shape.class, name: "<init>", descriptor: constructor_descriptor(shape) }), InvokeStatic(virtual_thread_started()), Drop(Reference("java/lang/Thread"))])
    handed_back := concatenated(first: concatenated(first: [New(handle_class_name()), Copy], second: held), second: [Construct(MethodRef { class: handle_class_name(), name: "<init>", descriptor: constructor_descriptor(handle_shape()) }), Return(Some(handle_descriptor()))])
    body := Body { instructions: concatenated(first: concatenated(first: opened, second: started_thread), second: handed_back), locals: 2, guards: [] }
    Method { name: "spawned", descriptor: MethodDescriptor { parameters: taken, result: Some(handle_descriptor()) }, reached: ThroughTheClass, body: body }
}

/// `Thread.startVirtualThread`, which runs what it is given on a virtual thread of its own.
// example: virtual_thread_started().name == "startVirtualThread"
fn virtual_thread_started() -> MethodRef {
    MethodRef { class: "java/lang/Thread", name: "startVirtualThread", descriptor: MethodDescriptor { parameters: [Reference("java/lang/Runnable")], result: Some(Reference("java/lang/Thread")) } }
}

/// The method the virtual thread runs: `start`, then `receive` of each message the mailbox gives,
/// until `receive` gives `Done`, and then the state it held completes the end.
///
/// The state is held as an object between two messages, and each call is given it as it takes it.
// example: run_method(no_shapes(), process_shape("main/process$Counter", Signature { parameters: [], result: Some(Long) }), Ran { module: "main", named: "Counter", started: Signature { parameters: [], result: Some(Long) }, received: Signature { parameters: [Some(Long), Some(Long)], result: Some(object()) } }).name == "run"
fn run_method(shapes: Shapes, shape: Shape, ran: Ran) -> Method {
    this := Reference(shape.class)
    var starting = []
    for carried in shape.carries {
        starting = match carried.of {
            Some(of) => if carried.name != "mailbox" && carried.name != "finished" {
                concatenated(first: starting, second: [Load { slot: 0, of: this }, GetField(FieldRef { class: shape.class, name: carried.name, of: of })])
            } else {
                starting
            }
            None => starting
        }
    }
    module := ran.module
    named := ran.named
    started := concatenated(first: list.push(starting, InvokeStatic(MethodRef { class: module, name: named + "$start", descriptor: descriptor_of(ran.started) })), second: as_object(ran.started.result))
    taking := [Store { slot: 1, of: object() }, Label(0), Load { slot: 0, of: this }, GetField(FieldRef { class: shape.class, name: "mailbox", of: mailbox_descriptor() }), InvokeVirtual(MethodRef { class: mailbox_class(), name: "take", descriptor: MethodDescriptor { parameters: [], result: Some(object()) } }), Store { slot: 2, of: object() }]
    receiving := concatenated(first: concatenated(first: object_as(1, or(list.at(ran.received.parameters, 0), None)), second: object_as(2, or(list.at(ran.received.parameters, 1), None))), second: [InvokeStatic(MethodRef { class: module, name: named + "$receive", descriptor: descriptor_of(ran.received) }), Store { slot: 3, of: next_descriptor() }])
    again := built_shape(shapes, "Continue")
    tested := carrying_tag(again, Slot { at: 3, of: next_descriptor() }, 1)
    kept := concatenated(first: [Load { slot: 3, of: next_descriptor() }, Cast(again.class), GetField(FieldRef { class: again.class, name: first_carried_name(again), of: or(first_carried(again), object()) })], second: as_object(first_carried(again)))
    ending := [Store { slot: 1, of: object() }, Jump(0), Label(1), Load { slot: 0, of: this }, GetField(FieldRef { class: shape.class, name: "finished", of: finished_descriptor() }), Load { slot: 1, of: object() }, InvokeVirtual(MethodRef { class: finished_class(), name: "complete", descriptor: MethodDescriptor { parameters: [object()], result: Some(Boolean) } }), Drop(Boolean), Return(None)]
    instructions := concatenated(first: concatenated(first: concatenated(first: concatenated(first: [Label(2)], second: started), second: taking), second: concatenated(first: receiving, second: tested)), second: concatenated(first: concatenated(first: kept, second: ending), second: failed_end(shape)))
    guard := Guard { from: 2, to: 4, handler: 4, catching: "java/lang/Throwable" }
    Method { name: "run", descriptor: MethodDescriptor { parameters: [], result: None }, reached: ThroughAnInstance, body: Body { instructions: instructions, locals: 3, guards: [guard] } }
}

/// What a throw out of `start` or `receive` becomes: the end of the process completes with the
/// throwable, and the throwable goes on to the thread, which writes it to standard error.
///
/// So `send` to that process gives `ProcessEnded`, and `ended` on it throws in its turn, and no
/// one waits for an end that never comes.
// example: list.length(failed_end(process_shape("main/process$Counter", Signature { parameters: [], result: Some(Long) }))) == 9
fn failed_end(shape: Shape) -> List<Instruction> {
    thrown := Reference("java/lang/Throwable")
    completed := InvokeVirtual(MethodRef { class: finished_class(), name: "completeExceptionally", descriptor: MethodDescriptor { parameters: [thrown], result: Some(Boolean) } })
    [Label(4), Store { slot: 1, of: thrown }, Load { slot: 0, of: Reference(shape.class) }, GetField(FieldRef { class: shape.class, name: "finished", of: finished_descriptor() }), Load { slot: 1, of: thrown }, completed, Drop(Boolean), Load { slot: 1, of: thrown }, Throw]
}

/// The instructions that turn a value `held` holds into an object, and a new object for `()`.
// example: list.length(as_object(None)) == 3
fn as_object(held: Option<Descriptor>) -> List<Instruction> {
    match held {
        Some(of) => converted(held: of, wanted: object())
        None => [New(object_class()), Copy, Construct(MethodRef { class: object_class(), name: "<init>", descriptor: MethodDescriptor { parameters: [], result: None } })]
    }
}

/// The object in `slot`, loaded as what `wanted` takes, and nothing where `wanted` takes `()`.
// example: list.length(object_as(1, None)) == 0
fn object_as(slot: Int, wanted: Option<Descriptor>) -> List<Instruction> {
    match wanted {
        Some(of) => concatenated(first: [Load { slot: slot, of: object() }], second: converted(held: object(), wanted: of))
        None => []
    }
}

/// The class of a handle: the mailbox and the end of one process, and the method `send` calls.
// example: list.length(handle_class(no_shapes()).methods) == 2
fn handle_class(shapes: Shapes) -> Class {
    shape := handle_shape()
    Class { name: shape.class, extends: object_class(), extending: Never, implements: [], fields: held_fields(shape), methods: [constructor_method(shape, object_class()), sent_method(shapes)] }
}

/// The method `send` calls: an ended process refuses the message, and a full mailbox is waited on
/// as `waiting` says.
///
/// A wait without limit offers the message a tenth of a second at a time and looks for the end
/// in between, so a process that ends while the sender waits is told as ended.
// example: sent_method(no_shapes()).name == "sent"
fn sent_method(shapes: Shapes) -> Method {
    waiting := Slot { at: 2, of: named_descriptor(shapes, "Waiting") }
    opened := concatenated(first: ended_test(shapes, 0), second: [Label(0)])
    unlimited := concatenated(first: carrying_tag(built_shape(shapes, "NoLimit"), waiting, 2), second: [Label(1)])
    offered := concatenated(first: offer_within([LongOf(100)], shapes, 5), second: [Label(5)])
    again := concatenated(first: ended_test(shapes, 1), second: [Label(2), LongOf(0), Store { slot: 3, of: Long }])
    timed := built_shape(shapes, "Milliseconds")
    limit := concatenated(first: carrying_tag(timed, waiting, 3), second: [Load { slot: 2, of: waiting.of }, Cast(timed.class), GetField(FieldRef { class: timed.class, name: first_carried_name(timed), of: or(first_carried(timed), Long) }), Store { slot: 3, of: Long }, Label(3)])
    bounded := concatenated(first: offer_within([Load { slot: 3, of: Long }], shapes, 4), second: concatenated(first: [Label(4)], second: ended_test(shapes, 6)))
    full := concatenated(first: [Label(6)], second: sent_answer(shapes, "MailboxFull"))
    instructions := concatenated(first: concatenated(first: concatenated(first: opened, second: unlimited), second: concatenated(first: offered, second: again)), second: concatenated(first: concatenated(first: limit, second: bounded), second: full))
    taken := [handle_descriptor(), object(), waiting.of]
    Method { name: "sent", descriptor: MethodDescriptor { parameters: taken, result: Some(named_descriptor(shapes, "Sent")) }, reached: ThroughTheClass, body: Body { instructions: instructions, locals: 2, guards: [] } }
}

/// `ProcessEnded` where the process of the handle in slot 0 has ended, and a jump to `open` where
/// it has not.
// example: list.length(ended_test(no_shapes(), 0)) == 8
fn ended_test(shapes: Shapes, open: Int) -> List<Instruction> {
    tested := [Load { slot: 0, of: handle_descriptor() }, GetField(handle_finished()), InvokeVirtual(MethodRef { class: finished_class(), name: "isDone", descriptor: MethodDescriptor { parameters: [], result: Some(Boolean) } }), JumpIfFalse(open)]
    concatenated(first: tested, second: sent_answer(shapes, "ProcessEnded"))
}

/// `Delivered` where the mailbox takes the message within the milliseconds `within` loads, and a
/// jump to `missed` where it does not.
// example: list.length(offer_within([LongOf(0)], no_shapes(), 0)) == 11
fn offer_within(within: List<Instruction>, shapes: Shapes, missed: Int) -> List<Instruction> {
    unit := GetStatic(FieldRef { class: "java/util/concurrent/TimeUnit", name: "MILLISECONDS", of: Reference("java/util/concurrent/TimeUnit") })
    offer := MethodRef { class: mailbox_class(), name: "offer", descriptor: MethodDescriptor { parameters: [object(), Long, Reference("java/util/concurrent/TimeUnit")], result: Some(Boolean) } }
    loaded := concatenated(first: [Load { slot: 0, of: handle_descriptor() }, GetField(handle_mailbox()), Load { slot: 1, of: object() }], second: within)
    concatenated(first: concatenated(first: loaded, second: [unit, InvokeVirtual(offer), JumpIfFalse(missed)]), second: sent_answer(shapes, "Delivered"))
}

/// The variant `named` of `Sent`, built and given back.
// example: list.length(sent_answer(no_shapes(), "Delivered")) == 4
fn sent_answer(shapes: Shapes, named: String) -> List<Instruction> {
    shape := built_shape(shapes, named)
    [New(shape.class), Copy, Construct(MethodRef { class: shape.class, name: "<init>", descriptor: constructor_descriptor(shape) }), Return(Some(named_descriptor(shapes, "Sent")))]
}

/// What a handle holds: the mailbox of its process, and the end of it.
// example: list.length(handle_shape().carries) == 2
fn handle_shape() -> Shape {
    Shape { class: handle_class_name(), base: handle_class_name(), tag: None, carries: [Carried { name: "mailbox", of: Some(mailbox_descriptor()) }, Carried { name: "finished", of: Some(finished_descriptor()) }] }
}

/// What holds a `Next`, which `receive` gives back and the prelude declares.
// example: descriptor_text(next_descriptor()) == "Llumen/Next;"
fn next_descriptor() -> Descriptor {
    Reference("lumen/Next")
}

/// How many messages a mailbox holds at most, which is one bound for every mailbox.
// example: mailbox_bound() == 64
fn mailbox_bound() -> Int {
    64
}

/// The class of the module: every method nothing has to ask for, every one asked for, and `main`.
// example: list.length(module_class(little_lowering("fn f() -> Int {\n    1\n}\n"), no_asks()).class.methods) == 1
fn module_class(lowering: Lowering, asked: Asked) -> Classed {
    owing := every_asked_owed(every_plain_owed(lowering), asked)
    written := methods_owed(owing)
    methods := concatenated(first: written.methods, second: entry_point(written.lowering))
    Classed { lowering: written.lowering, class: Class { name: owing.shapes.class, extends: object_class(), extending: Never, implements: [], fields: [], methods: methods } }
}

/// `lowering` owing each method a module writes whatever is asked of it.
///
/// That is each function that is not generic, and `main`, each method a derive writes, and each
/// `extern`, in the order the module writes them.
// example: list.length(every_plain_owed(little_lowering("fn f() -> Int {\n    1\n}\n")).owed) == 1
fn every_plain_owed(lowering: Lowering) -> Lowering {
    program := lowering.typed.resolved.program
    var owing = lowering
    for function in infer.functions_of(program) {
        if list.length(function.type_parameters) == 0 || function.name.text == "main" {
            owing = plainly_owed(owing, function.name.span)
        }
    }
    for derived in derived_in(program) {
        owing = plainly_owed(owing, derived.named.span)
    }
    for item in program.items {
        owing = extern_owed(owing, item)
    }
    owing
}

/// `lowering` owing the method `item` writes, where `item` is an `extern`.
// example: list.length(extern_owed(little_lowering(""), declared.first_item("type Box = Box\n")).owed) == 0
fn extern_owed(lowering: Lowering, item: ast.Item) -> Lowering {
    match item {
        ast.Extern(declaration) => plainly_owed(lowering, declaration.name.span)
        _ => lowering
    }
}

/// `lowering` owing each method another module asked this one for.
// example: list.length(every_asked_owed(little_lowering(""), no_asks()).owed) == 0
fn every_asked_owed(lowering: Lowering, asked: Asked) -> Lowering {
    var owing = lowering
    for one in asked.of {
        if one.module == lowering.module {
            owing = one_asked_owed(owing, one)
        }
    }
    owing
}

/// `lowering` owing the method `one` asks for, which is an instance's or a generic function's.
// example: list.length(one_asked_owed(little_lowering(""), little_ask()).owed) == 0
fn one_asked_owed(lowering: Lowering, one: Specialisation) -> Lowering {
    match instance_named(lowering, one.function) {
        Some(answers) => instance_method(lowering, answers, one.settled).lowering
        None => function_asked_owed(lowering, one)
    }
}

/// `lowering` owing the function `one` asks for, settled as `one` settles it.
// example: list.length(function_asked_owed(little_lowering("fn pick<T>(value: T) -> T {\n    value\n}\n"), little_ask()).owed) == 1
fn function_asked_owed(lowering: Lowering, one: Specialisation) -> Lowering {
    match function_named(lowering, one.function) {
        Some(function) => settled_function_owed(lowering, function, one.settled)
        None => lowering
    }
}

/// `lowering` owing `function` with its type parameters settled on `settled`, in order.
// example: list.length(settled_function_owed(little_lowering(""), no_function(), []).owed) == 1
fn settled_function_owed(lowering: Lowering, function: ast.FunctionDeclaration, settled: List<unify.Type>) -> Lowering {
    at := asked_for(function, settled)
    owe(lowering, function.name.span, instantiation_names(at, named_at(lowering, function.name.span)), at)
}

/// The instance method this module declares under the name `named`, where there is one.
// example: is_nothing_answered(instance_named(little_lowering(""), "Eq$Box$is_equal"))
fn instance_named(lowering: Lowering, named: String) -> Option<Answers> {
    for answers in lowering.instances {
        if named_at(lowering, answers.declared) == named {
            return Some(answers)
        }
    }
    None
}

/// Whether nothing answers.
// example: is_nothing_answered(None)
fn is_nothing_answered(answers: Option<Answers>) -> Bool {
    match answers {
        Some(_) => false
        None => true
    }
}

/// Each method owed, written in the order it was owed, and each name and descriptor only once.
///
/// Writing a body may owe more, which is written after it, so this runs until nothing is owed.
// example: list.length(methods_owed(every_plain_owed(little_lowering("fn f() -> Int {\n    1\n}\n"))).methods) == 1
fn methods_owed(lowering: Lowering) -> MethodsWritten {
    var writing = lowering
    var written = set.empty()
    var methods = []
    for writing.next_owed < list.length(writing.owed) {
        owed := or(list.at(writing.owed, writing.next_owed), Owed { declared: infer.no_name().span, named: "", at: whole() })
        writing = writing { next_owed: writing.next_owed + 1 }
        signature := signature_of(writing, owed.declared, owed.at)
        key := owed.named + " " + method_descriptor_text(descriptor_of(signature))
        if !set.has_value(written, key) {
            written = set.insert(written, key)
            made := method_written(writing, owed, signature)
            writing = made.lowering
            methods = list.push(methods, made.method)
        }
    }
    MethodsWritten { lowering: writing, methods: methods }
}

/// The method `owed` names, with its body written from its declaration.
// example: method_written(little_lowering(""), Owed { declared: infer.no_name().span, named: "f", at: whole() }, Signature { parameters: [], result: None }).method.name == "f"
fn method_written(lowering: Lowering, owed: Owed, signature: Signature) -> MethodMade {
    made := body_written(lowering, owed, signature)
    MethodMade { lowering: made.lowering, method: Method { name: owed.named, descriptor: descriptor_of(signature), reached: ThroughTheClass, body: made.body } }
}

/// The body of the method `owed` names: its source, a derive, or the member an `extern` reaches.
// example: list.length(body_written(little_lowering(""), Owed { declared: infer.no_name().span, named: "f", at: whole() }, Signature { parameters: [], result: None }).body.instructions) == 0
fn body_written(lowering: Lowering, owed: Owed, signature: Signature) -> BodyMade {
    match map.get(lowering.declared, infer.span_key(owed.declared)) {
        Some(written_at) => declared_body(lowering, written_at.body, signature, owed.at)
        None => BodyMade { lowering: lowering, body: empty_body() }
    }
}

/// The body `written` gives the method, settled as `at` settles it.
// example: list.length(declared_body(little_lowering(""), FromJava(no_extern()), Signature { parameters: [], result: None }, whole()).body.instructions) > 0
fn declared_body(lowering: Lowering, written: Written, signature: Signature, at: Instantiation) -> BodyMade {
    match written {
        Source(function) => source_body(lowering, function, signature, at)
        FromJava(declaration) => BodyMade { lowering: lowering, body: extern_body(lowering, declaration, signature) }
        Derived { of, declaration } => derived_body(lowering, of, declaration)
    }
}

/// The body of `function`, written from its source.
// example: list.length(source_body(little_lowering(""), no_function(), Signature { parameters: [], result: None }, whole()).body.instructions) == 1
fn source_body(lowering: Lowering, function: ast.FunctionDeclaration, signature: Signature, at: Instantiation) -> BodyMade {
    built := body_built(builder_entering(lowering, function, signature, at), function.body)
    BodyMade { lowering: built.lowering, body: Body { instructions: built.instructions, locals: built.next_slot - built.first_local, guards: [] } }
}

/// A body of no instructions.
// example: list.length(empty_body().instructions) == 0
fn empty_body() -> Body {
    Body { instructions: [], locals: 0, guards: [] }
}

/// The method a program starts at, where `main` has the one shape a program starts at.
///
/// It takes the arguments as an array, builds a list of them, and calls the `main` the source
/// writes; the low eight bits of what that gives back are the code the process exits with.
// example: list.length(entry_point(little_lowering("fn f() -> Int {\n    1\n}\n"))) == 0
fn entry_point(lowering: Lowering) -> List<Method> {
    match function_named(lowering, "main") {
        Some(function) => entry_of(lowering, function)
        None => []
    }
}

/// The function this module writes under the name `named`, instance methods among them.
// example: or(function_named(little_lowering("fn f() -> Int {\n    1\n}\n"), "f"), no_function()).name.text == "f"
fn function_named(lowering: Lowering, named: String) -> Option<ast.FunctionDeclaration> {
    for function in infer.functions_of(lowering.typed.resolved.program) {
        if named_at(lowering, function.name.span) == named {
            return Some(function)
        }
    }
    None
}

/// The entry point that calls `function`, where it takes a list of text and gives back an `Int`.
// example: list.length(entry_of(little_lowering(""), no_function())) == 0
fn entry_of(lowering: Lowering, function: ast.FunctionDeclaration) -> List<Method> {
    entered := unify.Function { parameters: [unify.list_of(unify.text_type())], result: unify.int() }
    if used_as(lowering, function.name.span) != entered {
        return []
    }
    started := descriptor_of(signature_of(lowering, function.name.span, whole()))
    taken := arguments_descriptor()
    instructions := [Load { slot: 0, of: taken }, InvokeStatic(list_built()), InvokeStatic(MethodRef { class: lowering.shapes.class, name: "main", descriptor: started }), LowEightBits, InvokeStatic(MethodRef { class: "java/lang/System", name: "exit", descriptor: MethodDescriptor { parameters: [Integer], result: None } }), Return(None)]
    [Method { name: "main", descriptor: MethodDescriptor { parameters: [taken], result: None }, reached: ThroughTheClass, body: Body { instructions: instructions, locals: 0, guards: [] } }]
}

/// `String[]`, which is what the JVM starts a program with.
// example: descriptor_text(arguments_descriptor()) == "[Ljava/lang/String;"
fn arguments_descriptor() -> Descriptor {
    Array(text_descriptor())
}

/// Whether nothing answered.
// example: is_unanswered(Answered { lowering: little_lowering(""), answered_by: None })
fn is_unanswered(answered: Answered) -> Bool {
    match answered.answered_by {
        Some(_) => false
        None => true
    }
}

/// Whether no generic function was found.
// example: is_plain(None)
fn is_plain(found: Option<ast.FunctionDeclaration>) -> Bool {
    match found {
        Some(_) => false
        None => true
    }
}

/// `lowering` owing the method declared at `declared`, as it is written.
// example: list.length(plainly_owed(little_lowering(""), infer.no_name().span).owed) == 1
fn plainly_owed(lowering: Lowering, written_at: lexer.Span) -> Lowering {
    owe(lowering, written_at, named_at(lowering, written_at), whole())
}

/// An `extern` of no name, which reaches a constructor of nothing.
// example: no_extern().name.text == ""
fn no_extern() -> ast.ExternDeclaration {
    ast.ExternDeclaration { name: infer.no_name(), reaches: ast.Constructor, gives: ast.GivesAsDeclared, parameters: [], result: ast.TypeRef { kind: ast.UnitType, span: infer.no_name().span }, span: infer.no_name().span }
}

/// A builder of the body of the first function `source` writes, typed against the small prelude.
// example: little_builder("fn f() -> Int {\n    1\n}\n").next_slot == 0
fn little_builder(source: String) -> Builder {
    lowering := little_lowering(source)
    function := or(list.at(infer.functions_of(lowering.typed.resolved.program), 0), no_function())
    builder_entering(lowering, function, signature_of(lowering, function.name.span, whole()), whole())
}

/// A builder of the body of `function`, with each parameter in the slot it arrives in.
// example: little_builder("fn f(x: Int) -> Int {\n    x\n}\n").first_local == 2
fn builder_entering(lowering: Lowering, function: ast.FunctionDeclaration, signature: Signature, at: Instantiation) -> Builder {
    var builder = Builder { lowering: lowering, instructions: [], slots: map.empty(), next_slot: 0, first_local: 0, next_label: 0, repeat: None, splitting: split(lowering, function), fields: map.empty(), result: signature.result, at: at }
    for parameter in function.parameters {
        builder = declare(builder, parameter.name)
    }
    builder { first_local: builder.next_slot }
}

/// The first expression the first function `source` writes gives back.
// example: first_expr("fn f() -> Int {\n    1\n}\n").span.start == 20
fn first_expr(source: String) -> ast.Expr {
    function := or(list.at(infer.functions_of(declared.first_program(source)), 0), no_function())
    var found = []
    for statement in function.body.statements {
        found = match statement.kind {
            ast.Evaluated(value) => list.push(found, value)
            _ => found
        }
    }
    or(list.at(found, 0), no_expr())
}

/// The builder after the body `block` is written, and what it gives back is returned.
// example: list.length(body_built(little_builder("fn f() -> Int {\n    1\n}\n"), first_function_body("fn f() -> Int {\n    1\n}\n")).instructions) == 2
fn body_built(builder: Builder, block: ast.Block) -> Builder {
    left := block_built(builder, block)
    adapted := adapt(builder: left.builder, from: left.held, to: builder.result)
    emit(adapted, Return(builder.result))
}

/// The body of the first function `source` writes.
// example: list.length(first_function_body("fn f() -> Int {\n    1\n}\n").statements) == 1
fn first_function_body(source: String) -> ast.Block {
    or(list.at(infer.functions_of(declared.first_program(source)), 0), no_function()).body
}

/// A function of no name, which takes nothing and does nothing.
// example: no_function().name.text == ""
fn no_function() -> ast.FunctionDeclaration {
    ast.FunctionDeclaration { name: infer.no_name(), type_parameters: [], parameters: [], result: None, body: ast.Block { statements: [], span: infer.no_name().span }, span: infer.no_name().span }
}

/// Whether no span was found.
// example: is_whole(None)
fn is_whole(found: Option<lexer.Span>) -> Bool {
    match found {
        Some(_) => false
        None => true
    }
}

/// The name of the method `instruction` calls, and `""` where it calls none.
// example: method_named(Copy) == ""
fn method_named(instruction: Instruction) -> String {
    match instruction {
        Construct(reached) => reached.name
        InvokeStatic(reached) => reached.name
        InvokeVirtual(reached) => reached.name
        InvokeInterface(reached) => reached.name
        InvokeStaticOfInterface(reached) => reached.name
        _ => ""
    }
}

/// Whether no slot was found.
// example: is_unslotted(None)
fn is_unslotted(found: Option<Slot>) -> Bool {
    match found {
        Some(_) => false
        None => true
    }
}

/// Whether no instance was found.
// example: is_unfound(Found { builder: little_builder(""), answered_by: None })
fn is_unfound(found: Found) -> Bool {
    match found.answered_by {
        Some(_) => false
        None => true
    }
}

/// Whether nothing was reached through a module.
// example: is_not_through(None)
fn is_not_through(found: Option<Through>) -> Bool {
    match found {
        Some(_) => false
        None => true
    }
}

/// Whether no shape was found.
// example: is_unshaped(None)
fn is_unshaped(found: Option<Shape>) -> Bool {
    match found {
        Some(_) => false
        None => true
    }
}

/// Whether nothing was written.
// example: is_unwritten(None)
fn is_unwritten(found: Option<Left>) -> Bool {
    match found {
        Some(_) => false
        None => true
    }
}

/// Where each binding of `function` is written that is split into one local for each field.
///
/// A binding is split where it is bound once to a record literal and only ever has a field read
/// off it: `docs/specs/codegen.md` states the rule. Any other use lets the record escape.
// example: list.length(split_list(little_lowering("fn f() -> Int {\n    1\n}\n"), no_function())) == 0
fn split(lowering: Lowering, function: ast.FunctionDeclaration) -> set.Set<Int> {
    var splitting = set.empty()
    for one in split_list(lowering, function) {
        splitting = set.insert(splitting, one)
    }
    splitting
}

/// Where each binding of `function` is written that is split, in the order it is written.
// example: list.length(split_list(little_lowering(""), no_function())) == 0
fn split_list(lowering: Lowering, function: ast.FunctionDeclaration) -> List<Int> {
    walk := block_walked(lowering, Escape { built: [], escaped: set.empty() }, function.body)
    var kept = []
    for one in walk.built {
        if !set.has_value(walk.escaped, one) {
            kept = list.push(kept, one)
        }
    }
    kept
}

/// `walk` after each statement of `block`.
// example: list.length(block_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, first_function_body("")).built) == 0
fn block_walked(lowering: Lowering, walk: Escape, block: ast.Block) -> Escape {
    var walking = walk
    for statement in block.statements {
        walking = statement_walked(lowering, walking, statement.kind)
    }
    walking
}

/// `walk` after the statement `kind`.
// example: list.length(statement_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, ast.Break).built) == 0
fn statement_walked(lowering: Lowering, walk: Escape, kind: ast.StatementKind) -> Escape {
    match kind {
        ast.Binding { mutability, name, value } => bound_walked(lowering, walk, mutability, name, value)
        ast.Assign { target, operator, value } => expr_walked(lowering, let_go_of(lowering, walk, target), value)
        ast.Return(value) => optional_walked(lowering, walk, value)
        ast.For(repeated) => loop_walked(lowering, walk, repeated)
        ast.Discard(value) => expr_walked(lowering, walk, value)
        ast.Evaluated(value) => expr_walked(lowering, walk, value)
        _ => walk
    }
}

/// `walk` after the binding of `name` to `value`, which is split where it holds a record literal.
// example: list.length(bound_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, ast.Immutable, infer.no_name(), no_expr()).built) == 0
fn bound_walked(lowering: Lowering, walk: Escape, mutability: ast.Mutability, name: ast.Name, value: ast.Expr) -> Escape {
    walked := expr_walked(lowering, walk, value)
    if is_immutable(mutability) && is_record_literal(lowering, value) {
        return walked { built: list.push(walked.built, infer.span_key(name.span)) }
    }
    walked
}

/// `walk` after the loop `repeated`: its header, then its body.
// example: list.length(loop_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, ast.ForLoop { header: ast.Forever, body: first_function_body("") }).built) == 0
fn loop_walked(lowering: Lowering, walk: Escape, repeated: ast.ForLoop) -> Escape {
    headed := match repeated.header {
        ast.Forever => walk
        ast.While(condition) => expr_walked(lowering, walk, condition)
        ast.Over { binding, iterable } => expr_walked(lowering, walk, iterable)
    }
    block_walked(lowering, headed, repeated.body)
}

/// `walk` after `value`, where there is one.
// example: list.length(optional_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, None).built) == 0
fn optional_walked(lowering: Lowering, walk: Escape, value: Option<ast.Expr>) -> Escape {
    match value {
        Some(written) => expr_walked(lowering, walk, written)
        None => walk
    }
}

/// `walk` after `written`, where each binding it names other than to read a field escapes.
// example: list.length(expr_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, no_expr()).built) == 0
fn expr_walked(lowering: Lowering, walk: Escape, written: ast.Expr) -> Escape {
    match written.kind {
        ast.NameExpr(name) => let_go_of(lowering, walk, name)
        ast.Unary { operator, operand } => expr_walked(lowering, walk, operand)
        ast.Binary { operator, left, right } => expr_walked(lowering, expr_walked(lowering, walk, left), right)
        ast.Call { callee, arguments } => each_walked(lowering, callee_walked(lowering, walk, callee), infer.values_of(arguments))
        ast.Field { receiver, name } => receiver_walked(lowering, walk, receiver)
        ast.Try(inner) => expr_walked(lowering, walk, inner)
        ast.Written(elements) => each_walked(lowering, walk, elements)
        ast.Record { base, fields } => fields_walked(lowering, record_base_walked(lowering, walk, base), fields)
        ast.If(chain) => chain_walked(lowering, walk, chain)
        ast.Match(matched) => arms_walked(lowering, expr_walked(lowering, walk, matched.scrutinee), matched.arms)
        ast.Spawn(started) => expr_walked(lowering, walk, started)
        _ => walk
    }
}

/// `walk` after the receiver of a field, which escapes only where it is not a bare name.
// example: list.length(receiver_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, no_expr()).built) == 0
fn receiver_walked(lowering: Lowering, walk: Escape, receiver: ast.Expr) -> Escape {
    match receiver.kind {
        ast.NameExpr(_) => walk
        _ => expr_walked(lowering, walk, receiver)
    }
}

/// `walk` after what a call is made on, which lets nothing go where it is a function of a module.
// example: list.length(callee_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, no_expr()).built) == 0
fn callee_walked(lowering: Lowering, walk: Escape, callee: ast.Expr) -> Escape {
    match callee.kind {
        ast.Field { receiver, name } => walk
        _ => expr_walked(lowering, walk, callee)
    }
}

/// `walk` after each of `values`.
// example: list.length(each_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, []).built) == 0
fn each_walked(lowering: Lowering, walk: Escape, values: List<ast.Expr>) -> Escape {
    var walking = walk
    for value in values {
        walking = expr_walked(lowering, walking, value)
    }
    walking
}

/// `walk` after the value of each field.
// example: list.length(fields_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, []).built) == 0
fn fields_walked(lowering: Lowering, walk: Escape, fields: List<ast.FieldValue>) -> Escape {
    var walking = walk
    for field in fields {
        walking = expr_walked(lowering, walking, field.value)
    }
    walking
}

/// `walk` after each branch of `chain`: its condition, then its block.
// example: list.length(chain_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, ast.IfExpr { branches: [], otherwise: None }).built) == 0
fn chain_walked(lowering: Lowering, walk: Escape, chain: ast.IfExpr) -> Escape {
    var walking = walk
    for branch in chain.branches {
        walking = block_walked(lowering, expr_walked(lowering, walking, branch.condition), branch.block)
    }
    match chain.otherwise {
        Some(block) => block_walked(lowering, walking, block)
        None => walking
    }
}

/// `walk` after the body of each arm.
// example: list.length(arms_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, []).built) == 0
fn arms_walked(lowering: Lowering, walk: Escape, arms: List<ast.MatchArm>) -> Escape {
    var walking = walk
    for arm in arms {
        walking = expr_walked(lowering, walking, arm.body)
    }
    walking
}

/// Whether a binding is bound once.
// example: is_immutable(ast.Immutable)
fn is_immutable(mutability: ast.Mutability) -> Bool {
    match mutability {
        ast.Immutable => true
        ast.Mutable => false
    }
}

/// Whether `value` is a literal that builds a record.
// example: !is_record_literal(little_lowering(""), no_expr())
fn is_record_literal(lowering: Lowering, value: ast.Expr) -> Bool {
    match value.kind {
        ast.Record { base, fields } => is_constructor(lowering, base) && is_record_constructor(lowering.shapes, path_text(base))
        _ => false
    }
}

/// Whether `base` names a constructor, which it does where it is reached through a module.
// example: !is_constructor(little_lowering(""), ast.Path { module: None, name: infer.no_name() })
fn is_constructor(lowering: Lowering, base: ast.Path) -> Bool {
    if !is_unnamed(base.module) {
        return true
    }
    declared.definition_of(lowering.typed.resolved, resolver.ValueNamespace, base.name).kind == resolver.Constructor
}

/// `walk` after the base of a record literal, which escapes where it is a binding updated.
// example: list.length(record_base_walked(little_lowering(""), Escape { built: [], escaped: set.empty() }, ast.Path { module: None, name: infer.no_name() }).built) == 0
fn record_base_walked(lowering: Lowering, walk: Escape, base: ast.Path) -> Escape {
    if is_unnamed(base.module) {
        return let_go_of(lowering, walk, base.name)
    }
    walk
}

/// `walk` with the binding `name` reads marked as escaped.
// example: list.length(let_go_of(little_lowering(""), Escape { built: [], escaped: set.empty() }, infer.no_name()).built) == 0
fn let_go_of(lowering: Lowering, walk: Escape, name: ast.Name) -> Escape {
    match declared.definition_of(lowering.typed.resolved, resolver.ValueNamespace, name).origin {
        resolver.InPrelude => walk
        resolver.Declared(at) => walk { escaped: set.insert(walk.escaped, infer.span_key(at)) }
    }
}

/// The shapes of the prelude, whose class is `lumen/library/prelude`.
// example: prelude_shapes(little_library(), only_the_prelude()).class == "lumen/library/prelude"
fn prelude_shapes(library: Library, classes: map.Map<String, String>) -> Shapes {
    naming := Naming { module: "prelude", class: module_named(classes, "prelude"), classes: classes }
    prelude_declared(empty_shapes(naming, library), library)
}

/// `shapes` with each Java class another module asked this one for a method at.
// example: asked_reached(no_shapes(), no_asks(), "main").module == ""
fn asked_reached(shapes: Shapes, asked: Asked, module: String) -> Shapes {
    var reaching = shapes
    for one in asked.of {
        if one.module == module {
            for foreign in one.foreign {
                if is_not_foreign(map.get(reaching.foreign, foreign.name)) {
                    reaching = reaching { foreign: map.insert(reaching.foreign, foreign.name, foreign.reached) }
                }
            }
        }
    }
    reaching
}

/// Whether no Java class was found.
// example: is_not_foreign(None)
fn is_not_foreign(found: Option<JavaClass>) -> Bool {
    match found {
        Some(_) => false
        None => true
    }
}

/// Whether `named` is a constructor that builds a record.
// example: !is_record_constructor(no_shapes(), "Box")
fn is_record_constructor(shapes: Shapes, named: String) -> Bool {
    set.has_value(shapes.record_builders, named)
}

/// Whether no dot was found.
// example: is_undotted(None)
fn is_undotted(found: Option<Home>) -> Bool {
    match found {
        Some(_) => false
        None => true
    }
}

/// Every class the shapes lay out: each record, and each base with its variants.
// example: list.length(shape_classes(prelude_shapes(little_library(), only_the_prelude()))) == 6
fn shape_classes(shapes: Shapes) -> List<Class> {
    var classes = []
    for declaration in shapes.declarations {
        classes = concatenated(first: classes, second: declaration_classes(shapes, declaration))
    }
    classes
}

/// The classes one declaration lays out.
// example: list.length(declaration_classes(no_shapes(), RecordDeclared("Box"))) == 1
fn declaration_classes(shapes: Shapes, declaration: ShapeDeclared) -> List<Class> {
    match declaration {
        RecordDeclared(constructor) => [record_class(built_shape(shapes, constructor))]
        VariantsDeclared { base, constructors } => variant_classes(shapes, base, constructors)
    }
}

/// The base class `base`, then one class for each variant, which extends it.
// example: list.length(variant_classes(no_shapes(), "main/Box", ["Box"])) == 2
fn variant_classes(shapes: Shapes, base: String, constructors: List<String>) -> List<Class> {
    var classes = [base_class(base)]
    for constructor in constructors {
        classes = list.push(classes, variant_class(built_shape(shapes, constructor), base))
    }
    classes
}

/// The base class of a type's variants, which holds the tag each variant is told apart by.
// example: list.length(base_class("main/Box").fields) == 1
fn base_class(base: String) -> Class {
    this := Reference(base)
    instructions := [Load { slot: 0, of: this }, Load { slot: 1, of: Integer }, PutField(FieldRef { class: base, name: "tag", of: Integer }), Load { slot: 0, of: this }, Construct(MethodRef { class: object_class(), name: "<init>", descriptor: MethodDescriptor { parameters: [], result: None } }), Return(None)]
    made := Method { name: "<init>", descriptor: MethodDescriptor { parameters: [Integer], result: None }, reached: ThroughAnInstance, body: Body { instructions: instructions, locals: 0, guards: [] } }
    Class { name: base, extends: object_class(), extending: ByItsVariants, implements: [], fields: [Field { name: "tag", of: Integer }], methods: [made] }
}

/// The class of one variant, which extends `base`.
// example: variant_class(no_shape(), "main/Box").extends == "main/Box"
fn variant_class(shape: Shape, base: String) -> Class {
    Class { name: shape.class, extends: base, extending: Never, implements: [], fields: held_fields(shape), methods: [constructor_method(shape, base)] }
}

/// The class of a list: its slots and length, and the methods that build, push onto, and cross it.
// example: list.length(carrier().methods) == 4
fn carrier() -> Class {
    made := record_class(list_shape())
    made { methods: concatenated(first: made.methods, second: [list_of_method(), list_push_method(), list_listed_method()]) }
}

/// The class of a record: a field for each value it carries, and a constructor that sets them.
// example: list.length(record_class(no_shape()).methods) == 1
fn record_class(shape: Shape) -> Class {
    Class { name: shape.class, extends: object_class(), extending: Never, implements: [], fields: held_fields(shape), methods: [constructor_method(shape, object_class())] }
}

/// The constructor of `shape`: each value set on its field, then the constructor of `extends`.
// example: list.length(constructor_method(no_shape(), object_class()).body.instructions) == 3
fn constructor_method(shape: Shape, extends: String) -> Method {
    this := Reference(shape.class)
    var instructions = []
    var slot = 1
    for field in held_fields(shape) {
        instructions = concatenated(first: instructions, second: [Load { slot: 0, of: this }, Load { slot: slot, of: field.of }, PutField(FieldRef { class: shape.class, name: field.name, of: field.of })])
        slot += width(field.of)
    }
    instructions = list.push(instructions, Load { slot: 0, of: this })
    var taken = []
    instructions = match shape.tag {
        Some(tag) => list.push(instructions, IntegerOf(tag))
        None => instructions
    }
    taken = match shape.tag {
        Some(_) => [Integer]
        None => taken
    }
    instructions = concatenated(first: instructions, second: [Construct(MethodRef { class: extends, name: "<init>", descriptor: MethodDescriptor { parameters: taken, result: None } }), Return(None)])
    Method { name: "<init>", descriptor: constructor_descriptor(shape), reached: ThroughAnInstance, body: Body { instructions: instructions, locals: 0, guards: [] } }
}

/// A field for each value `shape` carries, and none for a `()`.
// example: list.length(held_fields(Shape { class: "a", base: "a", tag: None, carries: [Carried { name: "x", of: None }] })) == 0
fn held_fields(shape: Shape) -> List<Field> {
    var fields = []
    for carried in shape.carries {
        fields = match carried.of {
            Some(of) => list.push(fields, Field { name: carried.name, of: of })
            None => fields
        }
    }
    fields
}

/// The method that builds a list out of an array, which holds every slot it fills.
// example: list.length(list_of_method().body.instructions) == 7
fn list_of_method() -> Method {
    instructions := [New(list_class()), Copy, Load { slot: 0, of: buffer() }, Load { slot: 0, of: buffer() }, ArrayLength, list_constructed(), Return(Some(list_descriptor()))]
    static_method(list_built(), instructions, 0)
}

/// The method that pushes a value onto a list, which claims the free slot where no push has.
// example: list.length(list_push_method().body.instructions) == 45
fn list_push_method() -> Method {
    buffered := Load { slot: 2, of: buffer() }
    counted := Load { slot: 3, of: Integer }
    testing := [Load { slot: 0, of: list_descriptor() }, GetField(list_slots()), Store { slot: 2, of: buffer() }, Load { slot: 0, of: list_descriptor() }, GetField(list_length()), Store { slot: 3, of: Integer }, counted, buffered, ArrayLength, CompareIntegers(Less), JumpIfFalse(0), buffered, counted, LoadFromArray, JumpIfNull(1), Label(0)]
    copying := [counted, Widen, LongOf(2), Arithmetic(Multiply), LongOf(1), Arithmetic(Add), Narrow, NewArray(object_class()), Store { slot: 4, of: buffer() }, buffered, IntegerOf(0), Load { slot: 4, of: buffer() }, IntegerOf(0), counted, InvokeStatic(array_copy()), Load { slot: 4, of: buffer() }, Store { slot: 2, of: buffer() }]
    claiming := [Label(1), buffered, counted, Load { slot: 1, of: object() }, StoreInArray, Increment(3), New(list_class()), Copy, buffered, counted, list_constructed(), Return(Some(list_descriptor()))]
    static_method(list_pushed(), concatenated(first: concatenated(first: testing, second: copying), second: claiming), 3)
}

/// `System.arraycopy`, which copies the slots of one array into another.
// example: array_copy().name == "arraycopy"
fn array_copy() -> MethodRef {
    MethodRef { class: "java/lang/System", name: "arraycopy", descriptor: MethodDescriptor { parameters: [object(), Integer, object(), Integer, Integer], result: None } }
}

/// The method that turns a list into a `java.util.List`, each list inside it turned too.
// example: list.length(list_listed_method().body.instructions) == 35
fn list_listed_method() -> Method {
    counted := [Load { slot: 0, of: list_descriptor() }, GetField(list_length())]
    element := Load { slot: 3, of: object() }
    index := Load { slot: 2, of: Integer }
    starting := concatenated(first: counted, second: [NewArray(object_class()), Store { slot: 1, of: buffer() }, IntegerOf(0), Store { slot: 2, of: Integer }, Label(0), index])
    walking := concatenated(first: counted, second: [CompareIntegers(Less), JumpIfFalse(2), Load { slot: 0, of: list_descriptor() }, GetField(list_slots()), index, LoadFromArray, Store { slot: 3, of: object() }, element, InstanceOf(list_class()), JumpIfFalse(1), element, Cast(list_class()), InvokeStatic(list_crossed()), Store { slot: 3, of: object() }, Label(1)])
    putting := [Load { slot: 1, of: buffer() }, index, element, StoreInArray, Increment(2), Jump(0), Label(2), Load { slot: 1, of: buffer() }, InvokeStaticOfInterface(MethodRef { class: "java/util/List", name: "of", descriptor: MethodDescriptor { parameters: [buffer()], result: Some(java_list()) } }), Return(Some(java_list()))]
    static_method(list_crossed(), concatenated(first: concatenated(first: starting, second: walking), second: putting), 3)
}

/// The call of the constructor of a list, which takes its slots and its length.
// example: method_named(list_constructed()) == "<init>"
fn list_constructed() -> Instruction {
    Construct(MethodRef { class: list_class(), name: "<init>", descriptor: constructor_descriptor(list_shape()) })
}

/// The shape of a list: its slots, and how many of them it fills.
// example: list.length(list_shape().carries) == 2
fn list_shape() -> Shape {
    Shape { class: list_class(), base: list_class(), tag: None, carries: [Carried { name: "slots", of: Some(buffer()) }, Carried { name: "length", of: Some(Integer) }] }
}

/// A method reached through its class, of the name and descriptor `method` gives.
// example: static_method(list_built(), [], 0).name == "of"
fn static_method(method: MethodRef, instructions: List<Instruction>, locals: Int) -> Method {
    Method { name: method.name, descriptor: method.descriptor, reached: ThroughTheClass, body: Body { instructions: instructions, locals: locals, guards: [] } }
}

/// `method` as a class file writes it.
// example: method_descriptor_text(MethodDescriptor { parameters: [Long, object()], result: Some(Boolean) }) == "(JLjava/lang/Object;)Z"
fn method_descriptor_text(method: MethodDescriptor) -> String {
    var written = "("
    for parameter in method.parameters {
        written += descriptor_text(parameter)
    }
    written + ")" + held_text(method.result)
}

/// How many slots the parameters of `method` take.
// example: parameters_width(MethodDescriptor { parameters: [Long, object()], result: None }) == 3
fn parameters_width(method: MethodDescriptor) -> Int {
    var slots = 0
    for parameter in method.parameters {
        slots += width(parameter)
    }
    slots
}

/// Whether no type was found.
// example: is_unsettled(None)
fn is_unsettled(found: Option<unify.Type>) -> Bool {
    match found {
        Some(_) => false
        None => true
    }
}

/// The body of the method `derive of for T` writes, read off the declaration of `T`, which
/// reads each value the type holds with the instance of that value's own type.
// example: list.length(derived_body(little_lowering("type Box = Box\n"), "Show", declared.first_type("type Box = Box\n")).body.instructions) == 3
fn derived_body(lowering: Lowering, of: String, declaration: ast.TypeDeclaration) -> BodyMade {
    begun := Writing { lowering: lowering, instructions: [], next_label: 0 }
    writing := if of == "Eq" {
        is_equal_written(begun, declaration)
    } else if of == "Ord" {
        is_less_written(begun, declaration)
    } else if of == "Hash" {
        hashed_written(begun, declaration)
    } else {
        shown_written(begun, declaration)
    }
    BodyMade { lowering: writing.lowering, body: Body { instructions: writing.instructions, locals: 0, guards: [] } }
}

/// A derived body with nothing written yet, over a lowering of `source`.
// example: writing_over(box_module()).lowering.module == "main"
fn writing_over(source: String) -> Writing {
    Writing { lowering: little_lowering(source), instructions: [], next_label: 0 }
}

/// A module that declares the record `Box`, which holds one whole number.
// example: box_module() == "type Box = {\n    at: Int\n}\n"
fn box_module() -> String {
    "type Box = {\n    at: Int\n}\n"
}

/// A derived body with nothing written yet, over a lowering of nothing.
// example: no_writing().next_label == 0
fn no_writing() -> Writing {
    Writing { lowering: little_lowering(""), instructions: [], next_label: 0 }
}

/// The lowering of `source`, typed against the small prelude as the module `main`.
// example: little_lowering("fn f() -> Int {\n    1\n}\n").shapes.module == "main"
fn little_lowering(source: String) -> Lowering {
    typed := types.checked_of(source)
    library := little_library()
    lowering_of(typed, library, "main", shapes_of(typed, main_naming(), library))
}

/// The small prelude of the examples, which declares `Option`, `Result`, `Eq`, `Add`, and literals.
///
/// It is resolved as `library_read` resolves the prelude, so a type parameter of `Option` is held
/// as an object in each module that writes the classes of `Option`.
// example: set.has_value(little_library().types, "Result")
fn little_library() -> Library {
    program := declared.little_prelude()
    library_of(types.little_prelude(), ok_or(resolver.prelude_resolved(program), resolver.Resolved { module: "prelude", program: program, found: map.empty() }))
}

/// The prelude of `prelude` and `resolved`, with its own bodies typed.
// example: set.has_value(library_of(types.little_prelude(), declared.resolved_of("type Box = Box\n")).types, "Box")
fn library_of(prelude: types.Prelude, resolved: resolver.Resolved) -> Library {
    Library { prelude: prelude, typed: prelude_typed(prelude, resolved), traits: traits_in(resolved.program), types: types_in(resolved.program) }
}

/// The prelude's own bodies, typed against what the prelude declares.
// example: list.length(prelude_typed(types.little_prelude(), declared.resolved_of("")).functions) == 0
fn prelude_typed(prelude: types.Prelude, resolved: resolver.Resolved) -> infer.Inference {
    empty := infer.inference_of(resolved, surface.nothing_imported(), infer.no_declaring())
    match declared.environment_of(prelude.declared, resolved, [], [], unify.empty_table()) {
        Ok(declaring) => ok_or(infer.module_inferred(resolved, surface.nothing_imported(), declaring), empty)
        Err(_) => empty
    }
}

/// Every trait `program` declares, in the order it writes them.
// example: list.length(traits_in(declared.little_prelude())) == 3
fn traits_in(program: ast.Program) -> List<ast.TraitDeclaration> {
    var traits = []
    for item in program.items {
        traits = match item {
            ast.Trait(declaration) => list.push(traits, declaration)
            _ => traits
        }
    }
    traits
}

/// The name of every type `program` declares.
// example: set.has_value(types_in(declared.little_prelude()), "Option")
fn types_in(program: ast.Program) -> set.Set<String> {
    var named = set.empty()
    for item in program.items {
        named = match item {
            ast.Type(declaration) => set.insert(named, declaration.name.text)
            _ => named
        }
    }
    named
}

/// The lowering of the module `module`, which has written nothing yet.
// example: little_lowering("").module == "main"
fn lowering_of(typed: infer.Inference, library: Library, module: String, shapes: Shapes) -> Lowering {
    program := typed.resolved.program
    instances := instances_of(program, library)
    Lowering { typed: typed, library: library, module: module, shapes: shapes, declared: declarations_of(program, library), answers: answers_by_key(instances), instances: instances, owed: [], next_owed: 0, asks: no_asks() }
}

/// Nothing asked of any module.
// example: list.length(no_asks().of) == 0
fn no_asks() -> Asked {
    Asked { of: [] }
}

/// Every declaration that writes a method, by where its name is written, and the name it writes.
// example: named_at(little_lowering("fn f() -> Int {\n    1\n}\n"), lexer.Span { start: 3, length: 1 }) == "f"
fn declarations_of(program: ast.Program, library: Library) -> map.Map<Int, Declared> {
    var declarations = map.empty()
    for item in program.items {
        declarations = item_declared(declarations, program, library, item)
    }
    declarations
}

/// `declarations` with each method `item` writes.
// example: list.length(infer.functions_of(declared.little_prelude())) == 6
fn item_declared(declarations: map.Map<Int, Declared>, program: ast.Program, library: Library, item: ast.Item) -> map.Map<Int, Declared> {
    match item {
        ast.Instance(answerer) => instance_declared(declarations, answerer)
        ast.Derive(deriving) => derive_declared(declarations, program, library, deriving)
        ast.Function(function) => map.insert(declarations, infer.span_key(function.name.span), Declared { named: function.name.text, body: Source(function) })
        ast.Extern(declaration) => map.insert(declarations, infer.span_key(declaration.name.span), Declared { named: declaration.name.text, body: FromJava(declaration) })
        ast.Process(declaration) => process_declared(declarations, declaration)
        _ => declarations
    }
}

/// `declarations` with `start` and `receive` of `process`, each named after the process.
// example: named_at(little_lowering("process Counter {\n    fn start() -> Int {\n        0\n    }\n\n    fn receive(total: Int, message: Int) -> Next<Int> {\n        match message {\n            _ => Done\n        }\n    }\n}\n"), lexer.Span { start: 25, length: 5 }) == "Counter$start"
fn process_declared(declarations: map.Map<Int, Declared>, process_of: ast.ProcessDeclaration) -> map.Map<Int, Declared> {
    var declaring = declarations
    for function in process_of.functions {
        named := process_of.name.text + "$" + function.name.text
        declaring = map.insert(declaring, infer.span_key(function.name.span), Declared { named: named, body: Source(function) })
    }
    declaring
}

/// `declarations` with each method of `instance`, named after its trait and its type.
// example: named_at(little_lowering("instance Eq<Box> {\n    fn is_equal(one: Box, other: Box) -> Bool {\n        true\n    }\n}\n\ntype Box = Box\n"), lexer.Span { start: 26, length: 8 }) == "Eq$Box$is_equal"
fn instance_declared(declarations: map.Map<Int, Declared>, answerer: ast.InstanceDeclaration) -> map.Map<Int, Declared> {
    var declaring = declarations
    for method in answerer.methods {
        named := answerer.trait_name.text + "$" + answerer.for_type.text + "$" + method.name.text
        declaring = map.insert(declaring, infer.span_key(method.name.span), Declared { named: named, body: Source(method) })
    }
    declaring
}

/// `declarations` with the method of each trait `derive` names, at the name of that trait.
// example: named_at(little_lowering("derive Eq for Box\n\ntype Box = Box\n"), lexer.Span { start: 7, length: 2 }) == "Eq$Box$is_equal"
fn derive_declared(declarations: map.Map<Int, Declared>, program: ast.Program, library: Library, deriving: ast.DeriveDeclaration) -> map.Map<Int, Declared> {
    var declaring = declarations
    declaration := type_declared(program, deriving.for_type)
    for named in deriving.traits {
        method := method_of(library, named.text)
        written := Declared { named: named.text + "$" + deriving.for_type.text + "$" + method, body: Derived { of: named.text, declaration: declaration } }
        declaring = map.insert(declaring, infer.span_key(named.span), written)
    }
    declaring
}

/// The declaration of the type `named`, which a derive names in the module that declares it.
// example: type_declared(declared.little_prelude(), ast.Name { text: "Option", span: infer.no_name().span }).name.text == "Option"
fn type_declared(program: ast.Program, named: ast.Name) -> ast.TypeDeclaration {
    var found = []
    for item in program.items {
        found = match item {
            ast.Type(declaration) => if declaration.name.text == named.text {
                list.push(found, declaration)
            } else {
                found
            }
            _ => found
        }
    }
    or(list.at(found, 0), ast.TypeDeclaration { name: named, parameters: [], definition: ast.Variants([]), span: named.span })
}

/// Every instance method this module writes, and the method of each trait a derive names.
// example: list.length(instances_of(declared.little_prelude(), little_library())) == 5
fn instances_of(program: ast.Program, library: Library) -> List<Answers> {
    var answers = []
    for item in program.items {
        answers = concatenated(first: answers, second: instance_answers(item))
    }
    for derived in derived_in(program) {
        answers = list.push(answers, Answers { method: method_of(library, derived.named.text), for_type: derived.deriving.for_type.text, arguments: [], declared: derived.named.span })
    }
    answers
}

/// The methods `item` writes, where it is an instance.
// example: list.length(instance_answers(declared.first_item("type Box = Box\n"))) == 0
fn instance_answers(item: ast.Item) -> List<Answers> {
    match item {
        ast.Instance(answerer) => each_answer(answerer)
        _ => []
    }
}

/// Each method of `instance`, with the arguments its type is written with.
// example: list.length(each_answer(ast.InstanceDeclaration { trait_name: infer.no_name(), type_parameters: [], for_type: infer.no_name(), arguments: [], methods: [], span: infer.no_name().span })) == 0
fn each_answer(answerer: ast.InstanceDeclaration) -> List<Answers> {
    var arguments = []
    for written in answerer.arguments {
        arguments = list.push(arguments, written.text)
    }
    var answers = []
    for method in answerer.methods {
        answers = list.push(answers, Answers { method: method.name.text, for_type: answerer.for_type.text, arguments: arguments, declared: method.name.span })
    }
    answers
}

/// `answers`, each under its method and its type.
// example: is_nothing_answered(map.get(answers_by_key([]), "is_equal Int"))
fn answers_by_key(answers: List<Answers>) -> map.Map<String, Answers> {
    var by_key = map.empty()
    for one in answers {
        by_key = map.insert(by_key, one.method + " " + one.for_type, one)
    }
    by_key
}

/// Each trait a derive names, with the derive that names it, in the order the module writes them.
// example: list.length(derived_in(declared.first_program("derive Eq for Box\n\ntype Box = Box\n"))) == 1
fn derived_in(program: ast.Program) -> List<DerivedName> {
    var derived = []
    for item in program.items {
        derived = concatenated(first: derived, second: derive_names(item))
    }
    derived
}

/// Each trait `item` names, where it is a derive.
// example: list.length(derive_names(declared.first_item("type Box = Box\n"))) == 0
fn derive_names(item: ast.Item) -> List<DerivedName> {
    match item {
        ast.Derive(deriving) => each_derive_name(deriving)
        _ => []
    }
}

/// Each trait `derive` names.
// example: list.length(each_derive_name(ast.DeriveDeclaration { traits: [infer.no_name()], for_type: infer.no_name(), span: infer.no_name().span })) == 1
fn each_derive_name(deriving: ast.DeriveDeclaration) -> List<DerivedName> {
    var names = []
    for named in deriving.traits {
        names = list.push(names, DerivedName { named: named, deriving: deriving })
    }
    names
}

/// The shapes of a module: each type it declares, each type it reaches, and each prelude type.
// example: set.has_value(shapes_of(types.checked_of("type Box = Box\n"), main_naming(), little_library()).own, "Box")
fn shapes_of(typed: infer.Inference, naming: Naming, library: Library) -> Shapes {
    var shapes = empty_shapes(naming, library)
    for item in typed.resolved.program.items {
        shapes = match item {
            ast.Type(declaration) => own_declared(shapes, typed.resolved, declaration)
            _ => shapes
        }
    }
    for offered in surface.every_type(typed.imported) {
        shapes = reached_declared(shapes, offered)
    }
    prelude_declared(shapes, library)
}

/// Shapes of nothing, for the module `naming` names.
// example: list.length(empty_shapes(main_naming(), little_library()).declarations) == 0
fn empty_shapes(naming: Naming, library: Library) -> Shapes {
    Shapes { module: naming.module, class: naming.class, classes: naming.classes, declarations: [], built_by: map.empty(), records: map.empty(), record_builders: set.empty(), own: set.empty(), foreign: map.empty(), prelude_types: library.types }
}

/// `shapes` with the type the module declares as `declaration`, in the module's own package.
// example: set.has_value(own_declared(no_shapes(), declared.resolved_of(""), declared.first_type("type Box = Box\n")).own, "Box")
fn own_declared(shapes: Shapes, resolved: resolver.Resolved, declaration: ast.TypeDeclaration) -> Shapes {
    owning := shapes { own: set.insert(shapes.own, declaration.name.text) }
    declared_as(owning, resolved, declaration, declared_class(owning, declaration.name.text))
}

/// `shapes` with a type another module offers, laid out as that module lays it out.
// example: built_shape(reached_declared(main_shapes(), surface.record_of_user()), "User").class == "main/User"
fn reached_declared(shapes: Shapes, offered: surface.OfferedType) -> Shapes {
    base := declared_class(shapes, offered.name)
    match offered.built_by {
        surface.Record(one) => offered_record(shapes: shapes, named: offered.name, one: one, base: base)
        surface.Variants(variants) => offered_variants(shapes, variants, base)
        surface.ForeignClass { class, called } => shapes { foreign: map.insert(shapes.foreign, offered.name, JavaClass { class: slashed(class), called: called_as(called) }) }
    }
}

/// `shapes` with the offered record `named`, which `one` builds.
// example: built_shape(offered_record(shapes: no_shapes(), named: "user.User", one: surface.OfferedConstructor { name: "user.User", labels: [], carries: [] }, base: "user/User"), "user.User").class == "user/User"
fn offered_record(shapes: Shapes, named: String, one: surface.OfferedConstructor, base: String) -> Shapes {
    shape := Shape { class: base, base: base, tag: None, carries: offered_carries(shapes, one) }
    shapes { records: map.insert(shapes.records, named, one.name), record_builders: set.insert(shapes.record_builders, one.name), built_by: map.insert(shapes.built_by, one.name, shape) }
}

/// `shapes` with each offered variant, each a class that extends `base`.
// example: built_shape(offered_variants(no_shapes(), [surface.OfferedConstructor { name: "a.C", labels: [], carries: [] }], "a/B"), "a.C").class == "a/B$C"
fn offered_variants(shapes: Shapes, variants: List<surface.OfferedConstructor>, base: String) -> Shapes {
    var reaching = shapes
    var position = 0
    for variant in variants {
        shape := Shape { class: base + "$" + simple(variant.name), base: base, tag: Some(position), carries: offered_carries(reaching, variant) }
        reaching = reaching { built_by: map.insert(reaching.built_by, variant.name, shape) }
        position += 1
    }
    reaching
}

/// What each value an offered constructor carries is held in, under its label or its position.
// example: list.length(offered_carries(no_shapes(), surface.OfferedConstructor { name: "a.B", labels: [], carries: [unify.int()] })) == 1
fn offered_carries(shapes: Shapes, built: surface.OfferedConstructor) -> List<Carried> {
    var carries = []
    var position = 0
    for of in built.carries {
        carries = list.push(carries, Carried { name: or(list.at(built.labels, position), positional(position)), of: carried_type(shapes, of) })
        position += 1
    }
    carries
}

/// `shapes` with each type the prelude declares, each in the package `lumen`.
// example: built_shape(prelude_declared(no_shapes(), little_library()), "Some").class == "lumen/Option$Some"
fn prelude_declared(shapes: Shapes, library: Library) -> Shapes {
    var declaring = shapes
    resolved := library.typed.resolved
    for item in resolved.program.items {
        declaring = match item {
            ast.Type(declaration) => declared_as(declaring, resolved, declaration, "lumen/" + declaration.name.text)
            _ => declaring
        }
    }
    declaring
}

/// `shapes` with `declaration` laid out with `base` as its class: a Java class, a record, or
/// a base class and one class for each variant.
// example: built_shape(declared_as(no_shapes(), declared.resolved_of(""), declared.first_type("type Box = Box\n"), "main/Box"), "Box").class == "main/Box$Box"
fn declared_as(shapes: Shapes, resolved: resolver.Resolved, declaration: ast.TypeDeclaration, base: String) -> Shapes {
    named := declaration.name.text
    match declaration.definition {
        ast.RecordType(fields) => record_declared(shapes: shapes, named: named, base: base, carries: fields_carried(shapes, resolved, fields))
        ast.Variants(variants) => variants_declared(shapes, resolved, variants, base)
        ast.Foreign { class, called } => shapes { foreign: map.insert(shapes.foreign, named, JavaClass { class: slashed(class.text), called: called_as(called) }) }
    }
}

/// How a Java class is called, as the AST writes it.
// example: called_as(ast.AsAnInterface) == ThroughItsInterface
fn called_as(called: ast.Called) -> CalledAs {
    match called {
        ast.AsAClass => ThroughItsClass
        ast.AsAnInterface => ThroughItsInterface
    }
}

/// `shapes` with the record `named`, its own constructor, laid out as the class `base`.
// example: is_record_constructor(record_declared(shapes: no_shapes(), named: "Box", base: "main/Box", carries: []), "Box")
fn record_declared(shapes: Shapes, named: String, base: String, carries: List<Carried>) -> Shapes {
    shape := Shape { class: base, base: base, tag: None, carries: carries }
    shapes { records: map.insert(shapes.records, named, named), record_builders: set.insert(shapes.record_builders, named), declarations: list.push(shapes.declarations, RecordDeclared(named)), built_by: map.insert(shapes.built_by, named, shape) }
}

/// `shapes` with each variant, a class that extends `base` and carries its tag.
// example: list.length(variants_declared(no_shapes(), declared.resolved_of(""), [declared.no_variant()], "main/Box").declarations) == 1
fn variants_declared(shapes: Shapes, resolved: resolver.Resolved, variants: List<ast.Variant>, base: String) -> Shapes {
    var declaring = shapes
    var constructors = []
    var position = 0
    for variant in variants {
        named := variant.name.text
        shape := Shape { class: base + "$" + named, base: base, tag: Some(position), carries: payload_carried(declaring, resolved, variant.payload) }
        constructors = list.push(constructors, named)
        declaring = declaring { built_by: map.insert(declaring.built_by, named, shape) }
        position += 1
    }
    declaring { declarations: list.push(declaring.declarations, VariantsDeclared { base: base, constructors: constructors }) }
}

/// What each value a variant carries is held in: its position for a tuple, its field for a record.
// example: list.length(payload_carried(no_shapes(), declared.resolved_of(""), ast.NoPayload)) == 0
fn payload_carried(shapes: Shapes, resolved: resolver.Resolved, payload: ast.VariantPayload) -> List<Carried> {
    match payload {
        ast.NoPayload => []
        ast.TuplePayload(written) => positions_carried(shapes, resolved, written)
        ast.RecordPayload(fields) => fields_carried(shapes, resolved, fields)
    }
}

/// What each value of a tuple variant is held in, named for its position.
// example: list.length(positions_carried(no_shapes(), declared.resolved_of(""), [])) == 0
fn positions_carried(shapes: Shapes, resolved: resolver.Resolved, written: List<ast.TypeRef>) -> List<Carried> {
    var carries = []
    var position = 0
    for type_ref in written {
        carries = list.push(carries, Carried { name: positional(position), of: written_type(shapes, resolved, type_ref) })
        position += 1
    }
    carries
}

/// What each field is held in.
// example: list.length(fields_carried(no_shapes(), declared.resolved_of(""), [])) == 0
fn fields_carried(shapes: Shapes, resolved: resolver.Resolved, fields: List<ast.RecordField>) -> List<Carried> {
    var carries = []
    for field in fields {
        carries = list.push(carries, Carried { name: field.name.text, of: written_type(shapes, resolved, field.type_ref) })
    }
    carries
}

/// What holds a value of the type `type_ref` writes: nothing for `()`, and an object for a type
/// parameter, which a generic class holds as an object whatever it stands for.
// example: is_nothing(written_type(no_shapes(), declared.resolved_of(""), ast.TypeRef { kind: ast.UnitType, span: infer.no_name().span }))
fn written_type(shapes: Shapes, resolved: resolver.Resolved, type_ref: ast.TypeRef) -> Option<Descriptor> {
    match type_ref.kind {
        ast.NamedType { path, arguments } => Some(named_path(shapes, resolved, path))
        ast.UnitType => None
    }
}

/// What holds a value of the type `path` names.
// example: descriptor_text(named_path(no_shapes(), declared.resolved_of(""), ast.Path { module: None, name: ast.Name { text: "Int", span: infer.no_name().span } })) == "J"
fn named_path(shapes: Shapes, resolved: resolver.Resolved, path: ast.Path) -> Descriptor {
    if is_unnamed(path.module) && declared.definition_of(resolved, resolver.TypeNamespace, path.name).kind == resolver.TypeParameter {
        return object()
    }
    named_descriptor(shapes, path_text(path))
}

/// The field a value is held in that is carried at `position` without a label.
// example: positional(1) == "value1"
fn positional(position: Int) -> String {
    "value" + shown(position)
}

/// A name reached through a module, after the dot.
// example: simple("lexer.Span") == "Span"
// example: simple("Span") == "Span"
fn simple(reached: String) -> String {
    match split_at_dot(reached) {
        Some(home) => home.name
        None => reached
    }
}

/// The type `()`, as the source writes it.
// example: is_unit_written(unit_written())
fn unit_written() -> ast.TypeRef {
    ast.TypeRef { kind: ast.UnitType, span: infer.no_name().span }
}

/// Whether `written` is the type `()`.
// example: is_unit_written(unit_written())
fn is_unit_written(written: ast.TypeRef) -> Bool {
    match written.kind {
        ast.UnitType => true
        _ => false
    }
}

/// `Eq$T$is_equal`: the same variant, then everything both hold equal, and then the two answers.
// example: list.length(is_equal_written(writing_over(box_module()), declared.first_type(box_module())).instructions) == 12
fn is_equal_written(writing: Writing, declaration: ast.TypeDeclaration) -> Writing {
    differs := labelled_writing(writing)
    var writes = differs.writing
    for holds in record_holds(writes, declaration.name.text, record_fields_of(declaration)) {
        writes = equal_written(writes, holds, differs.label)
    }
    if has_variants(declaration) {
        writes = same_variant(writes, variants_of(declaration), differs.label)
    }
    equality_answered(writes, differs.label)
}

/// Variants: the same variant first, and then whatever that variant carries.
// example: list.length(same_variant(no_writing(), [], 0).instructions) == 7
fn same_variant(writing: Writing, variants: List<ast.Variant>, differs: Int) -> Writing {
    equally := labelled_writing(writing)
    base := base_of(equally.writing, variants)
    var writes = tag_read(tag_read(equally.writing, base, 0), base, 1)
    writes = each_written_out(writes, [CompareIntegers(Equal), JumpIfFalse(differs)])
    for variant in variants {
        writes = variant_equal(writing: writes, variant: variant, differs: differs, equally: equally.label)
    }
    written_out(writes, Label(equally.label))
}

/// One variant, whose values are compared where both values are that variant.
// example: list.length(variant_equal(writing: no_writing(), variant: declared.no_variant(), differs: 0, equally: 1).instructions) == 0
fn variant_equal(writing: Writing, variant: ast.Variant, differs: Int, equally: Int) -> Writing {
    held := variant_holds(writing, variant)
    if list.length(held) == 0 {
        return writing
    }
    next := labelled_writing(writing)
    var writes = unless_it_is(next.writing, built_shape(writing.lowering.shapes, variant.name.text), next.label)
    for holds in held {
        writes = equal_written(writes, holds, differs)
    }
    each_written_out(writes, [Jump(equally), Label(next.label)])
}

/// One value both sides hold, which leaves for `differs` unless the two of it are equal.
// example: list.length(equal_written(no_writing(), Holds { shape: no_shape(), carried: Carried { name: "x", of: Some(Long) }, of: Long, named: None, written: unit_written() }, 0).instructions) == 6
fn equal_written(writing: Writing, holds: Holds, differs: Int) -> Writing {
    compared_both := derived_through(value_read(value_read(writing, holds, 0), holds, 1), "Eq", holds)
    written_out(compared_both, JumpIfFalse(differs))
}

/// The two answers of `is_equal` and the one way out, which every comparison jumped into.
// example: list.length(equality_answered(no_writing(), 0).instructions) == 6
fn equality_answered(writing: Writing, differs: Int) -> Writing {
    end := labelled_writing(writing)
    each_written_out(end.writing, [BooleanOf(true), Jump(end.label), Label(differs), BooleanOf(false), Label(end.label), Return(Some(Boolean))])
}

/// `Hash$T$hashed`: the tag or zero to start from, each value taken in, and the answer.
// example: list.length(hashed_written(writing_over(box_module()), declared.first_type(box_module())).instructions) == 7
fn hashed_written(writing: Writing, declaration: ast.TypeDeclaration) -> Writing {
    var writes = writing
    if is_record(declaration) {
        writes = written_out(writes, LongOf(0))
    }
    for holds in record_holds(writes, declaration.name.text, record_fields_of(declaration)) {
        writes = taken_in(writes, holds)
    }
    if has_variants(declaration) {
        writes = hashed_by_variant(writes, variants_of(declaration))
    }
    written_out(writes, Return(Some(Long)))
}

/// Variants: the tag to start from, and then whatever that one variant carries.
// example: list.length(hashed_by_variant(no_writing(), []).instructions) == 4
fn hashed_by_variant(writing: Writing, variants: List<ast.Variant>) -> Writing {
    end := labelled_writing(writing)
    var writes = written_out(tag_read(end.writing, base_of(end.writing, variants), 0), Widen)
    for variant in variants {
        writes = carried_by(writes, variant, end.label)
    }
    written_out(writes, Label(end.label))
}

/// What one variant carries, taken in where the value turns out to be that variant.
// example: list.length(carried_by(no_writing(), declared.no_variant(), 0).instructions) == 0
fn carried_by(writing: Writing, variant: ast.Variant, end: Int) -> Writing {
    held := variant_holds(writing, variant)
    if list.length(held) == 0 {
        return writing
    }
    next := labelled_writing(writing)
    var writes = unless_it_is(next.writing, built_shape(writing.lowering.shapes, variant.name.text), next.label)
    for holds in held {
        writes = taken_in(writes, holds)
    }
    each_written_out(writes, [Jump(end), Label(next.label)])
}

/// One value taken into the number worked out below it: times 31, and its own hash added.
// example: list.length(taken_in(no_writing(), Holds { shape: no_shape(), carried: Carried { name: "x", of: Some(Long) }, of: Long, named: None, written: unit_written() }).instructions) == 5
fn taken_in(writing: Writing, holds: Holds) -> Writing {
    spread := each_written_out(writing, [LongOf(31), Arithmetic(Multiply)])
    written_out(derived_through(value_read(spread, holds, 0), "Hash", holds), Arithmetic(Add))
}

/// `Ord$T$is_less`: whatever the type holds decides, and then the two answers.
// example: list.length(is_less_written(writing_over(box_module()), declared.first_type(box_module())).instructions) == 22
fn is_less_written(writing: Writing, declaration: ast.TypeDeclaration) -> Writing {
    less := labelled_writing(writing)
    not_less := labelled_writing(less.writing)
    settled := Decided { less: less.label, not_less: not_less.label }
    var writes = not_less.writing
    for holds in record_holds(writes, declaration.name.text, record_fields_of(declaration)) {
        writes = deciding(writes, holds, settled)
    }
    if has_variants(declaration) {
        writes = ordered_by_variant(writes, variants_of(declaration), settled)
    }
    order_answered(writes, settled)
}

/// Variants: which variant each value is first, and then what that variant carries.
// example: list.length(ordered_by_variant(no_writing(), [], Decided { less: 0, not_less: 1 }).instructions) == 13
fn ordered_by_variant(writing: Writing, variants: List<ast.Variant>, settled: Decided) -> Writing {
    base := base_of(writing, variants)
    var writes = written_out(tag_read(tag_read(writing, base, 0), base, 1), CompareIntegers(Less))
    writes = leaving_where_it_holds(writes, settled.less)
    writes = written_out(tag_read(tag_read(writes, base, 0), base, 1), CompareIntegers(Equal))
    writes = written_out(writes, JumpIfFalse(settled.not_less))
    for variant in variants {
        writes = variant_ordered(writes, variant, settled)
    }
    writes
}

/// The base class of a type declaring variants, which both slots hold a value as.
// example: base_of(no_writing(), []) == ""
fn base_of(writing: Writing, variants: List<ast.Variant>) -> String {
    match list.at(variants, 0) {
        Some(first) => built_shape(writing.lowering.shapes, first.name.text).base
        None => ""
    }
}

/// One variant, whose values decide where both values are that variant.
// example: list.length(variant_ordered(no_writing(), declared.no_variant(), Decided { less: 0, not_less: 1 }).instructions) == 0
fn variant_ordered(writing: Writing, variant: ast.Variant, settled: Decided) -> Writing {
    held := variant_holds(writing, variant)
    if list.length(held) == 0 {
        return writing
    }
    next := labelled_writing(writing)
    var writes = unless_it_is(next.writing, built_shape(writing.lowering.shapes, variant.name.text), next.label)
    for holds in held {
        writes = deciding(writes, holds, settled)
    }
    each_written_out(writes, [Jump(settled.not_less), Label(next.label)])
}

/// One value both sides hold, which decides unless the two of it come in neither order.
// example: list.length(deciding(no_writing(), Holds { shape: no_shape(), carried: Carried { name: "x", of: Some(Long) }, of: Long, named: None, written: unit_written() }, Decided { less: 0, not_less: 1 }).instructions) == 14
fn deciding(writing: Writing, holds: Holds, settled: Decided) -> Writing {
    before := derived_through(value_read(value_read(writing, holds, 0), holds, 1), "Ord", holds)
    after := derived_through(value_read(value_read(leaving_where_it_holds(before, settled.less), holds, 1), holds, 0), "Ord", holds)
    leaving_where_it_holds(after, settled.not_less)
}

/// `writing` with a jump to `answer` where the truth value on the stack holds.
// example: list.length(leaving_where_it_holds(no_writing(), 0).instructions) == 2
fn leaving_where_it_holds(writing: Writing, answer: Int) -> Writing {
    each_written_out(writing, [Not, JumpIfFalse(answer)])
}

/// The two answers of `is_less` and the one way out, which every decision jumped into.
// example: list.length(order_answered(no_writing(), Decided { less: 0, not_less: 1 }).instructions) == 8
fn order_answered(writing: Writing, settled: Decided) -> Writing {
    end := labelled_writing(writing)
    each_written_out(end.writing, [Jump(settled.not_less), Label(settled.less), BooleanOf(true), Jump(end.label), Label(settled.not_less), BooleanOf(false), Label(end.label), Return(Some(Boolean))])
}

/// `Show$T$shown`: the text the value is shown as, and the answer.
// example: list.length(shown_written(no_writing(), declared.first_type("type Box = Box\n")).instructions) == 3
fn shown_written(writing: Writing, declaration: ast.TypeDeclaration) -> Writing {
    var writes = writing
    if is_record(declaration) {
        writes = inside_braces(writes, declaration.name.text, record_holds(writes, declaration.name.text, record_fields_of(declaration)))
    }
    if has_variants(declaration) {
        writes = shown_by_variant(writes, variants_of(declaration))
    }
    written_out(writes, Return(Some(text_descriptor())))
}

/// Every value a record holds, in the order the type declares its fields.
// example: list.length(record_holds(no_writing(), "Box", [])) == 0
fn record_holds(writing: Writing, named: String, fields: List<ast.RecordField>) -> List<Holds> {
    held_values(record_shape(writing.lowering.shapes, named), fields_written(fields))
}

/// The builder after each statement of `block`, and what the last one leaves.
///
/// What a statement before the last leaves is dropped.
// example: held_text(block_built(little_builder("fn f() -> Int {\n    1\n}\n"), first_function_body("fn f() -> Int {\n    1\n}\n")).held) == "J"
fn block_built(builder: Builder, block: ast.Block) -> Left {
    last := list.length(block.statements) - 1
    var left = Left { builder: builder, held: None }
    var at = 0
    for statement in block.statements {
        left = statement_built(left.builder, statement)
        if at < last {
            left = Left { builder: adapt(builder: left.builder, from: left.held, to: None), held: None }
        }
        at += 1
    }
    left
}

/// The builder after `statement`, and what it leaves, which only an expression does.
// example: held_text(statement_built(little_builder(""), ast.Statement { kind: ast.Break, span: infer.no_name().span }).held) == "V"
fn statement_built(builder: Builder, statement: ast.Statement) -> Left {
    match statement.kind {
        ast.Evaluated(value) => expr_built(builder, value)
        _ => Left { builder: performed(builder, statement.kind), held: None }
    }
}

/// The builder after the statement `kind`, which leaves nothing.
// example: list.length(performed(little_builder(""), ast.Break).instructions) == 0
fn performed(builder: Builder, kind: ast.StatementKind) -> Builder {
    match kind {
        ast.Binding { mutability, name, value } => binding_built(builder, name, value)
        ast.Assign { target, operator, value } => assigned(builder, target, operator, value)
        ast.Return(value) => returned(builder, value)
        ast.Break => left_for(builder, repeat_done(builder.repeat))
        ast.ContinueLoop => left_for(builder, repeat_again(builder.repeat))
        ast.For(repeated) => for_loop(builder, repeated)
        ast.Discard(value) => discarded(builder, value)
        ast.Evaluated(_) => builder
    }
}

/// The builder after `value` is written and what it leaves is dropped.
// example: list.length(discarded(little_builder(""), no_expr()).instructions) == 0
fn discarded(builder: Builder, value: ast.Expr) -> Builder {
    left := expr_built(builder, value)
    adapt(builder: left.builder, from: left.held, to: None)
}

/// The builder after `name` is bound to `value`, or to each field of it where the binding is split.
// example: list.length(binding_built(little_builder(""), infer.no_name(), no_expr()).instructions) == 0
fn binding_built(builder: Builder, name: ast.Name, value: ast.Expr) -> Builder {
    if set.has_value(builder.splitting, infer.span_key(name.span)) {
        return split_bound(builder, name, value)
    }
    left := expr_built(builder, value)
    stored_value(declare(left.builder, name), name, left.held)
}

/// The builder after each field the record literal `value` gives is held in a slot of its own.
// example: list.length(split_bound(little_builder(""), infer.no_name(), no_expr()).instructions) == 0
fn split_bound(builder: Builder, name: ast.Name, value: ast.Expr) -> Builder {
    match value.kind {
        ast.Record { base, fields } => each_field_split(builder, name, fields, built_shape(builder.lowering.shapes, path_text(base)))
        _ => builder
    }
}

/// The builder after each value `shape` carries is given from `fields` and held in a slot.
// example: list.length(each_field_split(little_builder(""), infer.no_name(), [], no_shape()).instructions) == 0
fn each_field_split(builder: Builder, name: ast.Name, fields: List<ast.FieldValue>, shape: Shape) -> Builder {
    var splitting = builder
    for carried in shape.carries {
        splitting = given_fields(splitting, fields, carried)
        splitting = match carried.of {
            Some(of) => field_held(splitting, held_key(name.span, carried.name), of)
            None => splitting
        }
    }
    splitting
}

/// The builder after `value` is set on, or added to, the variable `name`.
// example: list.length(assigned(little_builder(""), infer.no_name(), ast.SetTo, no_expr()).instructions) == 0
fn assigned(builder: Builder, name: ast.Name, operator: ast.AssignOperator, value: ast.Expr) -> Builder {
    left := match operator {
        ast.SetTo => expr_built(builder, value)
        ast.AddTo => added_or_written(builder, local(builder, name), value)
    }
    stored_value(left.builder, name, left.held)
}

/// The builder after `value` is added to what `slot` holds, where there is a slot.
// example: held_text(added_or_written(little_builder(""), None, no_expr()).held) == "V"
fn added_or_written(builder: Builder, slot: Option<Slot>, value: ast.Expr) -> Left {
    match slot {
        Some(held) => added_to(builder, held, value)
        None => expr_built(builder, value)
    }
}

/// The builder after `value`, where there is one, is given back.
// example: list.length(returned(little_builder(""), None).instructions) == 1
fn returned(builder: Builder, value: Option<ast.Expr>) -> Builder {
    written := match value {
        Some(given) => left_as(expr_built(builder, given), builder.result)
        None => builder
    }
    emit(written, Return(builder.result))
}

/// The builder after the loop `repeated`: its test at the top, its body, and a jump back.
// example: list.length(for_loop(little_builder(""), ast.ForLoop { header: ast.Forever, body: ast.Block { statements: [], span: infer.no_name().span } }).instructions) == 4
fn for_loop(builder: Builder, repeated: ast.ForLoop) -> Builder {
    entered := loop_entered(builder, repeated.header)
    turn := entered.turn
    top := entered.builder.next_label
    again := top + 1
    done := top + 2
    entering := entered.builder
    labelled := emit(entering { next_label: top + 3 }, Label(top))
    tested := loop_tested(labelled, turn, done)
    outer := tested.repeat
    left := block_built(tested { repeat: Some(Repeat { again: again, done: done }) }, repeated.body)
    adapted := adapt(builder: left.builder, from: left.held, to: None)
    walked := emit(adapted { repeat: outer }, Label(again))
    stepped := match turn {
        Walk { walked_list, index, item } => emit(walked, Increment(index))
        _ => walked
    }
    emit(emit(stepped, Jump(top)), Label(done))
}

/// The builder after a loop's header is entered, and how the loop goes round.
// example: loop_entered(little_builder(""), ast.Forever).builder.next_slot == 0
fn loop_entered(builder: Builder, header: ast.ForHeader) -> Entered {
    match header {
        ast.Forever => Entered { builder: builder, turn: Forever }
        ast.While(condition) => Entered { builder: builder, turn: While(condition) }
        ast.Over { binding, iterable } => walk_entered(builder, binding, iterable)
    }
}

/// The builder after the list `iterable` is held in a slot, the index starts at zero, and
/// `binding` has a slot.
// example: walk_entered(little_builder(""), infer.no_name(), no_expr()).builder.next_slot == 2
fn walk_entered(builder: Builder, binding: ast.Name, iterable: ast.Expr) -> Entered {
    of := list_descriptor()
    left := expr_built(builder, iterable)
    list_at := left.builder.next_slot
    holding := emit(temporary(adapt(builder: left.builder, from: left.held, to: Some(of)), of), Store { slot: list_at, of: of })
    index := holding.next_slot
    counting := emit(emit(temporary(holding, Integer), IntegerOf(0)), Store { slot: index, of: Integer })
    bound := declare(counting, binding)
    Entered { builder: bound, turn: Walk { walked_list: list_at, index: index, item: local(bound, binding) } }
}

/// The builder after the test at the top of a loop, which jumps to `done` when the loop is over.
// example: list.length(loop_tested(little_builder(""), Forever, 0).instructions) == 0
fn loop_tested(builder: Builder, turn: Turn, done: Int) -> Builder {
    match turn {
        Forever => builder
        While(condition) => emit(condition_built(builder, condition), JumpIfFalse(done))
        Walk { walked_list, index, item } => walk_stepped(builder, Walk { walked_list: walked_list, index: index, item: item }, done)
    }
}

/// The builder after `condition` is written as a truth value on the stack.
// example: list.length(condition_built(little_builder(""), no_expr()).instructions) == 0
fn condition_built(builder: Builder, condition: ast.Expr) -> Builder {
    left := expr_built(builder, condition)
    adapt(builder: left.builder, from: left.held, to: Some(Boolean))
}

/// The builder after `written` is written as what its own type is carried as.
// example: held_text(value_built(little_builder(""), no_expr()).held) == "V"
fn value_built(builder: Builder, written: ast.Expr) -> Left {
    left := expr_built(builder, written)
    settled := carried_at(left.builder, written.span)
    Left { builder: adapt(builder: left.builder, from: left.held, to: settled), held: settled }
}

/// The builder after `written` is written as what `wanted` holds.
///
/// A `()` that a type parameter stands for is handed on as a new `Object`, because a slot of a
/// generic holds an object where the source holds `()`.
// example: list.length(handed(little_builder(""), no_expr(), None).instructions) == 0
fn handed(builder: Builder, written: ast.Expr, wanted: Option<Descriptor>) -> Builder {
    left := expr_built(builder, written)
    if is_nothing(left.held) && !is_nothing(wanted) && is_holding_nothing(left.builder, written.span) {
        return adapt(builder: nothing(left.builder), from: Some(object()), to: wanted)
    }
    adapt(builder: left.builder, from: left.held, to: wanted)
}

/// The builder after `written` is written, and what holds its value, which is nothing for `()`.
// example: held_text(expr_built(little_builder("fn f() -> Int {\n    1\n}\n"), first_expr("fn f() -> Int {\n    1\n}\n")).held) == "J"
// example: held_text(expr_built(little_builder(""), no_expr()).held) == "V"
fn expr_built(builder: Builder, written: ast.Expr) -> Left {
    match written.kind {
        ast.NameExpr(name) => name_written(builder, name)
        ast.Integer(value) => whole_number(builder, value, written.span)
        ast.Text(value) => Left { builder: emit(builder, TextOf(value)), held: Some(text_descriptor()) }
        ast.Truth(value) => Left { builder: emit(builder, BooleanOf(value)), held: Some(Boolean) }
        ast.Unit => Left { builder: builder, held: None }
        ast.Unary { operator, operand } => unary(builder, operator, operand)
        ast.Binary { operator, left, right } => binary(builder: builder, operator: operator, left: left, right: right)
        ast.Call { callee, arguments } => call(builder, callee, infer.values_of(arguments), written.span)
        ast.Field { receiver, name } => field_built(builder, receiver, name)
        ast.Try(inner) => propagated(builder, inner, written.span)
        ast.Written(elements) => written_list(builder, elements)
        ast.Record { base, fields } => record(builder, base, fields)
        ast.If(chain) => if_expr(builder, chain, written.span)
        ast.Match(matched) => match_expr(builder, matched, written.span)
        ast.Spawn(started) => spawn_built(builder, started)
    }
}

/// The builder after the process `started` calls is spawned, which gives back its handle.
// example: held_text(spawn_built(little_builder(""), no_expr()).held) == "Llumen/Process;"
fn spawn_built(builder: Builder, started: ast.Expr) -> Left {
    requested := match started.kind {
        ast.Call { callee, arguments } => callee_of(callee, infer.values_of(arguments))
        _ => callee_of(started, [])
    }
    declaration := spawned_declaration(builder.lowering, value_definition(builder, requested.name).origin)
    signature := signature_of_process(builder.lowering, declaration, 0)
    handing := each_handed(builder, requested.passed, signature.parameters)
    taken := descriptor_of(Signature { parameters: signature.parameters, result: None }).parameters
    spawned := MethodRef { class: process_class_name(module: builder.lowering.shapes.class, named: declaration.name.text), name: "spawned", descriptor: MethodDescriptor { parameters: taken, result: Some(handle_descriptor()) } }
    Left { builder: emit(handing, InvokeStatic(spawned)), held: Some(handle_descriptor()) }
}

/// The process declared at `origin`, which the resolver holds `spawn` to.
// example: spawned_declaration(little_lowering(""), resolver.InPrelude).name.text == ""
fn spawned_declaration(lowering: Lowering, origin: resolver.Origin) -> ast.ProcessDeclaration {
    var found = ast.ProcessDeclaration { name: infer.no_name(), functions: [], span: infer.no_name().span }
    for item in lowering.typed.resolved.program.items {
        found = match item {
            ast.Process(declaration) => if is_declared_at(origin, declaration.name.span) {
                declaration
            } else {
                found
            }
            _ => found
        }
    }
    found
}

/// Whether `origin` is the declaration written at `written`.
// example: !is_declared_at(resolver.InPrelude, infer.no_name().span)
fn is_declared_at(origin: resolver.Origin, written: lexer.Span) -> Bool {
    match origin {
        resolver.InPrelude => false
        resolver.Declared(at) => infer.span_key(at) == infer.span_key(written)
    }
}

/// The builder after a list of `elements` is built out of an array of them.
// example: held_text(written_list(little_builder(""), []).held) == "Llumen/List;"
fn written_list(builder: Builder, elements: List<ast.Expr>) -> Left {
    var writing = emits(builder, [IntegerOf(list.length(elements)), NewArray(object_class())])
    var at = 0
    for element in elements {
        writing = emit(handed(emits(writing, [Copy, IntegerOf(at)]), element, Some(object())), StoreInArray)
        at += 1
    }
    Left { builder: emit(writing, InvokeStatic(list_built())), held: Some(list_descriptor()) }
}

/// The builder after the value the name `name` stands for is written.
// example: held_text(name_written(little_builder(""), infer.no_name()).held) == "V"
fn name_written(builder: Builder, name: ast.Name) -> Left {
    match value_definition(builder, name).kind {
        resolver.Constructor => builds(builder, built_shape(builder.lowering.shapes, name.text), [])
        _ => loaded_value(builder, name)
    }
}

/// The builder after `operator` is written over `operand`.
// example: held_text(unary(little_builder(""), ast.Not, no_expr()).held) == "Z"
fn unary(builder: Builder, operator: ast.UnaryOperator, operand: ast.Expr) -> Left {
    match operator {
        ast.Not => Left { builder: emit(condition_built(builder, operand), Not), held: Some(Boolean) }
        ast.Negate => negated(builder, operand)
    }
}

/// The builder after `operator` is written over `left` and `right`.
// example: held_text(binary(builder: little_builder(""), operator: ast.Or, left: no_expr(), right: no_expr()).held) == "Z"
fn binary(builder: Builder, operator: ast.BinaryOperator, left: ast.Expr, right: ast.Expr) -> Left {
    match operator {
        ast.Or => either(builder: builder, left: left, right: right)
        ast.And => both(builder: builder, left: left, right: right)
        _ => operated(builder: builder, operator: operator, left: left, right: right)
    }
}

/// The builder after a division: `None` where the divisor is zero, and `Some` of the answer.
// example: held_text(divided(builder: little_builder(""), how: Divide, left: no_expr(), right: no_expr()).held) == "Llumen/Option;"
fn divided(builder: Builder, how: Arithmetic, left: ast.Expr, right: ast.Expr) -> Left {
    dividend := put_aside_as(builder, left, Long)
    divisor := put_aside_as(dividend.builder, right, Long)
    answered := divisor.builder.next_label
    end := answered + 1
    dividing := divisor.builder
    testing := emits(dividing { next_label: end + 1 }, [Load { slot: divisor.slot.at, of: Long }, LongOf(0), CompareLongs(Equal), JumpIfFalse(answered)])
    none := built_shape(testing.lowering.shapes, "None")
    absent := constructed(emits(testing, [New(none.class), Copy]), none)
    answering := emits(absent.builder, [Jump(end), Label(answered)])
    Left { builder: emit(divided_answer(builder: answering, how: how, dividend: dividend.slot.at, divisor: divisor.slot.at), Label(end)), held: absent.held }
}

/// The builder after `operand` is written as a value `of` holds and put aside in a new slot.
// example: put_aside_as(little_builder(""), no_expr(), Long).slot.at == 0
fn put_aside_as(builder: Builder, operand: ast.Expr, of: Descriptor) -> Aside {
    left := value_built(builder, operand)
    at := left.builder.next_slot
    Aside { builder: emit(temporary(adapt(builder: left.builder, from: left.held, to: Some(of)), of), Store { slot: at, of: of }), slot: Slot { at: at, of: of } }
}

/// The builder after `left || right`, which reads `right` only where `left` is false.
// example: list.length(either(builder: little_builder(""), left: no_expr(), right: no_expr()).builder.instructions) == 5
fn either(builder: Builder, left: ast.Expr, right: ast.Expr) -> Left {
    otherwise := builder.next_label
    end := otherwise + 1
    tested := emit(condition_built(builder { next_label: end + 1 }, left), JumpIfFalse(otherwise))
    other := condition_built(emits(tested, [BooleanOf(true), Jump(end), Label(otherwise)]), right)
    Left { builder: emit(other, Label(end)), held: Some(Boolean) }
}

/// The builder after `left && right`, which reads `right` only where `left` is true.
// example: list.length(both(builder: little_builder(""), left: no_expr(), right: no_expr()).builder.instructions) == 5
fn both(builder: Builder, left: ast.Expr, right: ast.Expr) -> Left {
    otherwise := builder.next_label
    end := otherwise + 1
    tested := emit(condition_built(builder { next_label: end + 1 }, left), JumpIfFalse(otherwise))
    other := condition_built(tested, right)
    Left { builder: emits(other, [Jump(end), Label(otherwise), BooleanOf(false), Label(end)]), held: Some(Boolean) }
}

/// The builder after a call of `callee` with `arguments`.
// example: held_text(call(little_builder(""), no_expr(), [], infer.no_name().span).held) == "V"
fn call(builder: Builder, callee: ast.Expr, arguments: List<ast.Expr>, at: lexer.Span) -> Left {
    match reached_inside(builder, callee) {
        Some(through) => inside_module(builder, through, arguments)
        None => call_written(builder, callee_of(callee, arguments), at)
    }
}

/// The builder after a call of the name `callee` holds: a constructor, or a function.
// example: held_text(call_written(little_builder(""), Callee { name: infer.no_name(), passed: [] }, infer.no_name().span).held) == "V"
fn call_written(builder: Builder, callee: Callee, at: lexer.Span) -> Left {
    match value_definition(builder, callee.name).kind {
        resolver.Constructor => builds(builder, built_shape(builder.lowering.shapes, callee.name.text), callee.passed)
        _ => invoked(builder, callee.name, callee.passed, at)
    }
}

/// The builder after a call of the function `name`: a trait method, one of the module, or the prelude's.
// example: held_text(invoked(little_builder(""), infer.no_name(), [], infer.no_name().span).held) == "V"
fn invoked(builder: Builder, name: ast.Name, arguments: List<ast.Expr>, written: lexer.Span) -> Left {
    definition := value_definition(builder, name)
    if definition.kind == resolver.TraitMethod {
        return through_the_instance(builder, name, arguments)
    }
    match definition.origin {
        resolver.InPrelude => supplied(builder, name, arguments, written)
        resolver.Declared(at) => statically(builder, Use { declared: at, at: name.span, within: builder.at }, arguments)
    }
}

/// The builder after a call of the trait method `name`, through the instance its use asks for.
// example: held_text(through_the_instance(little_builder(""), infer.no_name(), []).held) == "V"
fn through_the_instance(builder: Builder, name: ast.Name, arguments: List<ast.Expr>) -> Left {
    at := or(infer.method_type_at(builder.lowering.typed, name.span), unify.Unit)
    found := found_in(builder, answering_at(builder.lowering, name.text, substituted(builder.at, at)))
    match found.answered_by {
        Some(answerer) => calling(found.builder, answerer, arguments)
        None => written_out_instance(found.builder, name, arguments)
    }
}

/// The builder after a call of `instance` with `arguments`.
// example: held_text(calling(little_builder(""), Instance { class: "main", reaching: Reaching { named: "f", signature: Signature { parameters: [], result: Some(Long) } } }, []).held) == "J"
fn calling(builder: Builder, answerer: Instance, arguments: List<ast.Expr>) -> Left {
    handing := each_handed(builder, arguments, answerer.reaching.signature.parameters)
    Left { builder: emit(handing, instance_called(answerer)), held: answerer.reaching.signature.result }
}

/// The builder after each argument is handed on as what the parameter at its place takes.
// example: list.length(each_handed(little_builder(""), [no_expr()], []).instructions) == 0
fn each_handed(builder: Builder, arguments: List<ast.Expr>, parameters: List<Option<Descriptor>>) -> Builder {
    var handing = builder
    var at = 0
    for argument in arguments {
        handing = match list.at(parameters, at) {
            Some(wanted) => handed(handing, argument, wanted)
            None => handing
        }
        at += 1
    }
    handing
}

/// The builder after a call of a function this module declares, settled as `use` settles it.
// example: held_text(statically(little_builder(""), Use { declared: infer.no_name().span, at: infer.no_name().span, within: whole() }, []).held) == "V"
fn statically(builder: Builder, use: Use, arguments: List<ast.Expr>) -> Left {
    reached := use_reached(builder.lowering, use)
    handing := each_handed(builder { lowering: reached.lowering }, arguments, reached.reaching.signature.parameters)
    invoking := InvokeStatic(MethodRef { class: handing.lowering.shapes.class, name: reached.reaching.named, descriptor: descriptor_of(reached.reaching.signature) })
    Left { builder: emit(handing, invoking), held: reached.reaching.signature.result }
}

/// The builder after a value of `shape` is built out of `arguments`.
// example: held_text(builds(little_builder(""), no_shape(), []).held) == "L;"
fn builds(builder: Builder, shape: Shape, arguments: List<ast.Expr>) -> Left {
    var building = emits(builder, [New(shape.class), Copy])
    var at = 0
    for argument in arguments {
        building = match list.at(shape.carries, at) {
            Some(carried) => handed(building, argument, carried.of)
            None => building
        }
        at += 1
    }
    constructed(building, shape)
}

/// The builder after the field `name` of `receiver` is read.
// example: held_text(field_built(little_builder(""), no_expr(), infer.no_name()).held) == "V"
fn field_built(builder: Builder, receiver: ast.Expr, name: ast.Name) -> Left {
    match offered_variant(builder, receiver, name) {
        Some(shape) => builds(builder, shape, [])
        None => field_read(builder, receiver, name)
    }
}

/// The builder after the field `name` of `receiver` is read, from its own slot where it is split.
// example: held_text(field_read(little_builder(""), no_expr(), infer.no_name()).held) == "V"
fn field_read(builder: Builder, receiver: ast.Expr, name: ast.Name) -> Left {
    match split_receiver(builder, receiver) {
        Some(binding) => held_field(builder: builder, binding: binding, at: receiver.span, name: name)
        None => field_of_record(builder, receiver, name)
    }
}

/// The builder after the record `receiver` is written and its field `name` read.
// example: held_text(field_of_record(little_builder(""), no_expr(), infer.no_name()).held) == "V"
fn field_of_record(builder: Builder, receiver: ast.Expr, name: ast.Name) -> Left {
    shape := record_of(builder, receiver.span)
    left := expr_built(builder, receiver)
    base := Reference(shape.base)
    reading := adapt(builder: left.builder, from: left.held, to: Some(base))
    match carried_named(shape, name.text) {
        Some(of) => Left { builder: emit(reading, GetField(FieldRef { class: shape.class, name: name.text, of: of })), held: Some(of) }
        None => Left { builder: adapt(builder: reading, from: Some(base), to: None), held: None }
    }
}

/// The builder after `inner?`: the failure is given back at once, and the value read otherwise.
// example: held_text(propagated(little_builder(""), no_expr(), infer.no_name().span).held) == "V"
fn propagated(builder: Builder, inner: ast.Expr, at: lexer.Span) -> Left {
    named := named_type_at(builder, inner.span)
    handed_back := if named == "Option" {
        "None"
    } else {
        "Err"
    }
    carrying := if named == "Option" {
        "Some"
    } else {
        "Ok"
    }
    failed := built_shape(builder.lowering.shapes, handed_back)
    worked := built_shape(builder.lowering.shapes, carrying)
    of := Reference(failed.base)
    left := expr_built(builder, inner)
    slot := left.builder.next_slot
    holding := emit(temporary(adapt(builder: left.builder, from: left.held, to: Some(of)), of), Store { slot: slot, of: of })
    value := holding.next_label
    tested := emits(label_taken(holding), [Load { slot: slot, of: of }, GetField(FieldRef { class: failed.base, name: "tag", of: Integer }), IntegerOf(or(failed.tag, 0)), CompareIntegers(Equal), JumpIfFalse(value)])
    reading := emits(tested, [Load { slot: slot, of: of }, Return(tested.result), Label(value), Load { slot: slot, of: of }, Cast(worked.class), GetField(FieldRef { class: worked.class, name: first_carried_name(worked), of: object() })])
    wanted := carried_at(reading, at)
    Left { builder: adapt(builder: reading, from: Some(object()), to: wanted), held: wanted }
}

/// The builder after a record literal: a new value, or a copy of a binding with some fields new.
// example: held_text(record(little_builder(""), ast.Path { module: None, name: infer.no_name() }, []).held) == "L;"
fn record(builder: Builder, base: ast.Path, fields: List<ast.FieldValue>) -> Left {
    if !is_unnamed(base.module) || value_definition(builder, base.name).kind == resolver.Constructor {
        return built_with(builder, base, fields)
    }
    updated(builder, base.name, fields)
}

/// The builder after a new value of the constructor `base` is built out of `fields`.
// example: held_text(built_with(little_builder(""), ast.Path { module: None, name: infer.no_name() }, []).held) == "L;"
fn built_with(builder: Builder, base: ast.Path, fields: List<ast.FieldValue>) -> Left {
    shape := built_shape(builder.lowering.shapes, path_text(base))
    var building = emits(builder, [New(shape.class), Copy])
    for carried in shape.carries {
        building = given_fields(building, fields, carried)
    }
    constructed(building, shape)
}

/// The builder after the field of `fields` that `carried` names is handed on.
// example: list.length(given_fields(little_builder(""), [], Carried { name: "a", of: Some(Long) }).instructions) == 0
fn given_fields(builder: Builder, fields: List<ast.FieldValue>, carried: Carried) -> Builder {
    for written in fields {
        if written.name.text == carried.name {
            return handed(builder, written.value, carried.of)
        }
    }
    builder
}

/// The builder after a copy of the record `base` holds is built, with each of `fields` new.
// example: held_text(updated(little_builder(""), infer.no_name(), []).held) == "L;"
fn updated(builder: Builder, base: ast.Name, fields: List<ast.FieldValue>) -> Left {
    shape := record_updated(builder, base)
    var building = emits(builder, [New(shape.class), Copy])
    for carried in shape.carries {
        building = if is_written_for(fields, carried) {
            given_fields(building, fields, carried)
        } else {
            kept_values(building, base, shape, carried)
        }
    }
    constructed(building, shape)
}

/// The builder after an `if`: each branch tested in turn, and the one that holds written.
// example: held_text(if_expr(little_builder(""), ast.IfExpr { branches: [], otherwise: None }, infer.no_name().span).held) == "V"
fn if_expr(builder: Builder, chain: ast.IfExpr, at: lexer.Span) -> Left {
    wanted := carried_at(builder, at)
    end := builder.next_label
    var writing = label_taken(builder)
    for branch in chain.branches {
        otherwise := writing.next_label
        tested := emit(condition_built(label_taken(writing), branch.condition), JumpIfFalse(otherwise))
        left := block_built(tested, branch.block)
        writing = emits(adapt(builder: left.builder, from: left.held, to: wanted), [Jump(end), Label(otherwise)])
    }
    writing = match chain.otherwise {
        Some(block) => left_as(block_built(writing, block), wanted)
        None => writing
    }
    Left { builder: emit(writing, Label(end)), held: wanted }
}

/// The builder after `operator` is written over `left` and `right`, through an instance where
/// one answers the operator's trait at the type of `left`.
// example: held_text(operated(builder: little_builder(""), operator: ast.Add, left: no_expr(), right: no_expr()).held) == "V"
fn operated(builder: Builder, operator: ast.BinaryOperator, left: ast.Expr, right: ast.Expr) -> Left {
    asked := asked_by(operator)
    found := instance_written(builder, method_of(builder.lowering.library, asked.of), left.span)
    match found.answered_by {
        Some(answerer) => through_the_operator(found.builder, asked, answerer, [left, right])
        None => written_out_operator(builder: found.builder, operator: operator, left: left, right: right)
    }
}

/// The builder after a trait method the prelude supplies is written out as instructions.
// example: held_text(written_out_instance(little_builder(""), ast.Name { text: "from_literal", span: infer.no_name().span }, [no_expr()]).held) == "V"
fn written_out_instance(builder: Builder, name: ast.Name, arguments: List<ast.Expr>) -> Left {
    of := trait_of(builder.lowering.library, name.text)
    first := or(list.at(arguments, 0), no_expr())
    if of == "IntegerLiteral" {
        return expr_built(builder, first)
    }
    if of == "Hash" || of == "Show" {
        return read_one(builder, of, first)
    }
    if of == "Neg" {
        return negated(builder, first)
    }
    written_out_operator(builder: builder, operator: written_as_operator(of), left: first, right: or(list.at(arguments, 1), no_expr()))
}

/// The builder after `value` is hashed, or shown, as `of` asks.
// example: held_text(read_one(little_builder(""), "Show", no_expr()).held) == "Ljava/lang/String;"
fn read_one(builder: Builder, of: String, value: ast.Expr) -> Left {
    left := value_built(builder, value)
    held := or(left.held, Long)
    if of == "Hash" {
        return Left { builder: emits(left.builder, hashed_as(held)), held: Some(Long) }
    }
    Left { builder: emits(left.builder, shown_as(held)), held: Some(text_descriptor()) }
}

/// The builder after `value` is added to what `slot` holds, which `+=` writes.
// example: held_text(added_to(little_builder(""), Slot { at: 0, of: Long }, no_expr()).held) == "J"
fn added_to(builder: Builder, slot: Slot, value: ast.Expr) -> Left {
    loading := emit(builder, Load { slot: slot.at, of: slot.of })
    found := instance_written(loading, method_of(loading.lowering.library, "Add"), value.span)
    match found.answered_by {
        Some(answerer) => added_through(found.builder, answerer, value)
        None => added_out(found.builder, slot, value)
    }
}

/// The builder after `value` is added through the instance of `Add` that answers.
// example: held_text(added_through(little_builder(""), Instance { class: "main", reaching: Reaching { named: "add", signature: Signature { parameters: [Some(Long), Some(Long)], result: Some(Long) } } }, no_expr()).held) == "J"
fn added_through(builder: Builder, answerer: Instance, value: ast.Expr) -> Left {
    wanted := or(list.at(answerer.reaching.signature.parameters, 1), None)
    Left { builder: emit(handed(builder, value, wanted), instance_called(answerer)), held: answerer.reaching.signature.result }
}

/// The builder after `value` is added as the JVM adds: joined for text, summed for numbers.
// example: held_text(added_out(little_builder(""), Slot { at: 0, of: Long }, no_expr()).held) == "J"
fn added_out(builder: Builder, slot: Slot, value: ast.Expr) -> Left {
    left := expr_built(builder, value)
    Left { builder: emit(adapt(builder: left.builder, from: left.held, to: Some(slot.of)), written_out_add(slot.of)), held: Some(slot.of) }
}

/// The builder after `operand` is negated, through an instance where one answers `Neg`.
// example: held_text(negated(little_builder(""), no_expr()).held) == "J"
fn negated(builder: Builder, operand: ast.Expr) -> Left {
    found := instance_written(builder, method_of(builder.lowering.library, "Neg"), operand.span)
    match found.answered_by {
        Some(answerer) => calling(found.builder, answerer, [operand])
        None => negated_out(found.builder, operand)
    }
}

/// The builder after `operand` is negated as a JVM `long`.
// example: held_text(negated_out(little_builder(""), no_expr()).held) == "J"
fn negated_out(builder: Builder, operand: ast.Expr) -> Left {
    left := expr_built(builder, operand)
    Left { builder: emit(adapt(builder: left.builder, from: left.held, to: Some(Long)), Arithmetic(Negate)), held: Some(Long) }
}

/// The builder after the operator's method is called, with its operands swapped and its answer
/// turned over where the operator asks for that.
// example: held_text(through_the_operator(little_builder(""), asked_by(ast.Add), Instance { class: "main", reaching: Reaching { named: "add", signature: Signature { parameters: [], result: Some(Long) } } }, []).held) == "J"
fn through_the_operator(builder: Builder, asked: OperatorAsk, answerer: Instance, operands: List<ast.Expr>) -> Left {
    given := if asked.reversed {
        the_other_way_round(builder, answerer, operands)
    } else {
        calling(builder, answerer, operands)
    }
    if asked.flipped {
        return Left { builder: emit(given.builder, Not), held: given.held }
    }
    given
}

/// The builder after each operand is put aside and the two are loaded back last first.
///
/// Each operand is adapted to its parameter as `calling` adapts it: a `()` a type parameter stands
/// for is put aside as a new `Object`, and an operand whose parameter is `()` is written and dropped.
// example: held_text(the_other_way_round(little_builder(""), Instance { class: "main", reaching: Reaching { named: "is_less", signature: Signature { parameters: [], result: Some(Boolean) } } }, []).held) == "Z"
// example: list.length(the_other_way_round(little_builder("fn f() {\n    ()\n}\n"), Instance { class: "main", reaching: Reaching { named: "is_less", signature: Signature { parameters: [Some(object()), Some(object())], result: Some(Boolean) } } }, [first_expr("fn f() {\n    ()\n}\n"), first_expr("fn f() {\n    ()\n}\n")]).builder.instructions) == 11
fn the_other_way_round(builder: Builder, answerer: Instance, operands: List<ast.Expr>) -> Left {
    var writing = builder
    var kept = []
    var at = 0
    for operand in operands {
        wanted := list.at(answerer.reaching.signature.parameters, at)
        if at < list.length(answerer.reaching.signature.parameters) {
            aside := operand_aside(writing, operand, or(wanted, None))
            writing = aside.builder
            kept = concatenated(first: aside.slots, second: kept)
        }
        at += 1
    }
    for slot in kept {
        writing = emit(writing, Load { slot: slot.at, of: slot.of })
    }
    Left { builder: emit(writing, instance_called(answerer)), held: answerer.reaching.signature.result }
}

/// The builder after `operand` is put aside as what `wanted` holds, or written where it is `()`.
// example: list.length(operand_aside(little_builder(""), no_expr(), None).slots) == 0
fn operand_aside(builder: Builder, operand: ast.Expr, wanted: Option<Descriptor>) -> Asides {
    match wanted {
        Some(of) => aside_of(handed_aside(builder, operand, of))
        None => Asides { builder: handed(builder, operand, None), slots: [] }
    }
}

/// The builder after `operand` is handed on as what `of` holds and put aside in a new slot.
///
/// A `()` is handed on as `handed` hands it, and any other operand as `put_aside_as` puts it.
// example: handed_aside(little_builder(""), no_expr(), Long).slot.at == 0
fn handed_aside(builder: Builder, operand: ast.Expr, of: Descriptor) -> Aside {
    if !is_holding_nothing(builder, operand.span) {
        return put_aside_as(builder, operand, of)
    }
    handing := handed(builder, operand, Some(of))
    at := handing.next_slot
    Aside { builder: emit(temporary(handing, of), Store { slot: at, of: of }), slot: Slot { at: at, of: of } }
}

/// The builder after `operator` is written out as the JVM writes it over two values.
// example: held_text(written_out_operator(builder: little_builder(""), operator: ast.Equal, left: no_expr(), right: no_expr()).held) == "Z"
fn written_out_operator(builder: Builder, operator: ast.BinaryOperator, left: ast.Expr, right: ast.Expr) -> Left {
    if is_division(operator) {
        return divided(builder: builder, how: counted_by(operator), left: left, right: right)
    }
    one := value_built(builder, left)
    other := value_built(one.builder, right)
    both_held := adapt(builder: other.builder, from: other.held, to: one.held)
    match operator {
        ast.Add => added(both_held, one.held)
        ast.Subtract => Left { builder: emit(both_held, Arithmetic(Subtract)), held: Some(Long) }
        ast.Multiply => Left { builder: emit(both_held, Arithmetic(Multiply)), held: Some(Long) }
        _ => Left { builder: emits(both_held, compared(one.held, operator_how(operator))), held: Some(Boolean) }
    }
}

/// The builder after a call of a function the prelude supplies: `push` and `at` of a list, or
/// `or` and `ok_or`, which read their answer or fall back.
// example: held_text(supplied(little_builder(""), infer.no_name(), [], infer.no_name().span).held) == "V"
fn supplied(builder: Builder, name: ast.Name, arguments: List<ast.Expr>, written: lexer.Span) -> Left {
    if name.text == "send" || name.text == "ended" {
        return process_supplied(builder, name.text, arguments, written)
    }
    match held_named(builder, name.text, arguments) {
        Some(left) => left
        None => with_fallback(builder, name.text, arguments, written)
    }
}

/// The builder after `send` or `ended`, which the handle of a process reaches.
///
/// `send` hands the message on as an object and gives a `Sent`; `ended` waits on the end, and
/// gives the last state as the call's type holds it.
// example: held_text(process_supplied(little_builder(""), "ended", [no_expr()], infer.no_name().span).held) == "V"
fn process_supplied(builder: Builder, name: String, arguments: List<ast.Expr>, written: lexer.Span) -> Left {
    handle := handed(builder, or(list.at(arguments, 0), no_expr()), Some(handle_descriptor()))
    if name == "ended" {
        joined := MethodRef { class: finished_class(), name: "join", descriptor: MethodDescriptor { parameters: [], result: Some(object()) } }
        wanted := carried_at(builder, written)
        return Left { builder: adapt(builder: emits(handle, [GetField(handle_finished()), InvokeVirtual(joined)]), from: Some(object()), to: wanted), held: wanted }
    }
    waiting := named_descriptor(builder.lowering.shapes, "Waiting")
    sent := named_descriptor(builder.lowering.shapes, "Sent")
    handing := handed(handed(handle, or(list.at(arguments, 1), no_expr()), Some(object())), or(list.at(arguments, 2), no_expr()), Some(waiting))
    offered := MethodRef { class: handle_class_name(), name: "sent", descriptor: MethodDescriptor { parameters: [handle_descriptor(), object(), waiting], result: Some(sent) } }
    Left { builder: emit(handing, InvokeStatic(offered)), held: Some(sent) }
}

/// The signature of the function at `index` of a process, which the one shape puts there.
// example: is_nothing(signature_of_process(little_lowering(""), ast.ProcessDeclaration { name: infer.no_name(), functions: [], span: infer.no_name().span }, 0).result)
fn signature_of_process(lowering: Lowering, declaration: ast.ProcessDeclaration, index: Int) -> Signature {
    match list.at(declaration.functions, index) {
        Some(function) => signature_of(lowering, function.name.span, whole())
        None => Signature { parameters: [], result: None }
    }
}

/// The class of the process `named` of `module`, a name no type has, since `process` is a keyword.
// example: process_class_name(module: "main", named: "Counter") == "main/process$Counter"
fn process_class_name(module: String, named: String) -> String {
    module + "/process$" + named
}

/// The field of a handle that holds the mailbox.
// example: handle_mailbox().name == "mailbox"
fn handle_mailbox() -> FieldRef {
    FieldRef { class: handle_class_name(), name: "mailbox", of: mailbox_descriptor() }
}

/// The field of a handle that holds the end.
// example: handle_finished().name == "finished"
fn handle_finished() -> FieldRef {
    FieldRef { class: handle_class_name(), name: "finished", of: finished_descriptor() }
}

/// What holds a mailbox.
// example: descriptor_text(mailbox_descriptor()) == "Ljava/util/concurrent/ArrayBlockingQueue;"
fn mailbox_descriptor() -> Descriptor {
    Reference(mailbox_class())
}

/// The class of a mailbox: a queue of one fixed bound, whose `put` and `take` wait.
// example: mailbox_class() == "java/util/concurrent/ArrayBlockingQueue"
fn mailbox_class() -> String {
    "java/util/concurrent/ArrayBlockingQueue"
}

/// What holds the end of a process.
// example: descriptor_text(finished_descriptor()) == "Ljava/util/concurrent/CompletableFuture;"
fn finished_descriptor() -> Descriptor {
    Reference(finished_class())
}

/// The class of the end of a process, which the last state completes and `ended` waits on.
// example: finished_class() == "java/util/concurrent/CompletableFuture"
fn finished_class() -> String {
    "java/util/concurrent/CompletableFuture"
}

/// The builder after `or` or `ok_or`: the value the answer carries, or the fallback.
// example: held_text(with_fallback(little_builder(""), "", [], infer.no_name().span).held) == "V"
fn with_fallback(builder: Builder, name: String, arguments: List<ast.Expr>, written: lexer.Span) -> Left {
    carrying := if name == "or" {
        "Some"
    } else {
        "Ok"
    }
    if name != "or" && name != "ok_or" {
        return Left { builder: builder, held: None }
    }
    wanted := carried_at(builder, written)
    held := set_aside(builder, or(list.at(arguments, 0), no_expr()))
    fallback := set_aside_as(held.builder, or(list.at(arguments, 1), no_expr()), wanted)
    otherwise := fallback.builder.next_label
    end := otherwise + 1
    shape := built_shape(builder.lowering.shapes, carrying)
    falling := fallback.builder
    tested := emits(falling { next_label: end + 1 }, carrying_tag(shape, held.slot, otherwise))
    read := read_carried(tested, shape, held.slot, wanted)
    reloaded := emits(read, concatenated(first: [Jump(end), Label(otherwise)], second: reloaded_from(fallback.slots)))
    Left { builder: emit(reloaded, Label(end)), held: wanted }
}

/// The builder after `answer` is put aside in a new slot.
// example: set_aside(little_builder(""), no_expr()).slot.at == 0
fn set_aside(builder: Builder, answer: ast.Expr) -> Aside {
    of := or(carried_at(builder, answer.span), object())
    left := expr_built(builder, answer)
    at := left.builder.next_slot
    Aside { builder: emit(temporary(adapt(builder: left.builder, from: left.held, to: Some(of)), of), Store { slot: at, of: of }), slot: Slot { at: at, of: of } }
}

/// The builder after `fallback` is put aside in a new slot, where it is not `()`.
// example: list.length(set_aside_as(little_builder(""), no_expr(), None).slots) == 0
fn set_aside_as(builder: Builder, fallback: ast.Expr, wanted: Option<Descriptor>) -> Asides {
    handing := handed(builder, fallback, wanted)
    match wanted {
        Some(of) => Asides { builder: emit(temporary(handing, of), Store { slot: handing.next_slot, of: of }), slots: [Slot { at: handing.next_slot, of: of }] }
        None => Asides { builder: handing, slots: [] }
    }
}

/// The builder after a call of `length`, `push`, or `at` of the module `list`, which the compiler
/// writes.
// example: is_unwritten(held_by_the_compiler(little_builder(""), Through { module: infer.no_name(), name: infer.no_name(), used: infer.no_name().span }, []))
fn held_by_the_compiler(builder: Builder, through: Through, arguments: List<ast.Expr>) -> Option<Left> {
    if through.module.text != "list" {
        return None
    }
    held_named(builder, through.name.text, arguments)
}

/// The builder after `length` over one argument, or `push` or `at` over two, where `name` is one
/// of them.
// example: is_unwritten(held_named(little_builder(""), "push", []))
// example: !is_unwritten(held_named(little_builder(""), "length", [no_expr()]))
fn held_named(builder: Builder, name: String, arguments: List<ast.Expr>) -> Option<Left> {
    values := or(list.at(arguments, 0), no_expr())
    if name == "length" && list.length(arguments) == 1 {
        return Some(read_length(builder: builder, values: values))
    }
    if list.length(arguments) != 2 {
        return None
    }
    second := or(list.at(arguments, 1), no_expr())
    if name == "push" {
        return Some(list_push_built(builder: builder, values: values, value: second))
    }
    if name == "at" {
        return Some(read_at(builder: builder, values: values, index: second))
    }
    None
}

/// The builder after the length `values` holds is read, and widened to the `long` an `Int` is.
// example: held_text(read_length(builder: little_builder(""), values: no_expr()).held) == "J"
fn read_length(builder: Builder, values: ast.Expr) -> Left {
    listed := handed(builder, values, Some(list_descriptor()))
    Left { builder: emits(listed, [GetField(list_length()), Widen]), held: Some(Long) }
}

/// The builder after `value` is pushed onto `values`.
// example: held_text(list_push_built(builder: little_builder(""), values: no_expr(), value: no_expr()).held) == "Llumen/List;"
fn list_push_built(builder: Builder, values: ast.Expr, value: ast.Expr) -> Left {
    handing := handed(handed(builder, values, Some(list_descriptor())), value, Some(object()))
    Left { builder: emit(handing, InvokeStatic(list_pushed())), held: Some(list_descriptor()) }
}

/// The builder after the value at `index` of `values` is read: `Some` of it, or `None` outside.
// example: held_text(read_at(builder: little_builder(""), values: no_expr(), index: no_expr()).held) == "Llumen/Option;"
fn read_at(builder: Builder, values: ast.Expr, index: ast.Expr) -> Left {
    holding := list_descriptor()
    listed := handed(builder, values, Some(holding))
    list_at := listed.next_slot
    indexed := handed(emit(temporary(listed, holding), Store { slot: list_at, of: holding }), index, Some(Long))
    at := indexed.next_slot
    stored_at := emit(temporary(indexed, Long), Store { slot: at, of: Long })
    empty := stored_at.next_label
    end := empty + 1
    within := [Load { slot: at, of: Long }, LongOf(0), CompareLongs(GreaterOrEqual), JumpIfFalse(empty), Load { slot: at, of: Long }, Load { slot: list_at, of: holding }, GetField(list_length()), Widen, CompareLongs(Less), JumpIfFalse(empty)]
    some := built_shape(builder.lowering.shapes, "Some")
    reading := emits(stored_at { next_label: end + 1 }, concatenated(first: within, second: [New(some.class), Copy, Load { slot: list_at, of: holding }, GetField(list_slots()), Load { slot: at, of: Long }, Narrow, LoadFromArray]))
    held := constructed(reading, some)
    none := builds(emits(held.builder, [Jump(end), Label(empty)]), built_shape(builder.lowering.shapes, "None"), [])
    Left { builder: emit(none.builder, Label(end)), held: held.held }
}

/// The builder after a call through a module: a variant it offers, a list function, or a function.
// example: held_text(inside_module(little_builder(""), Through { module: infer.no_name(), name: infer.no_name(), used: infer.no_name().span }, []).held) == "V"
fn inside_module(builder: Builder, through: Through, arguments: List<ast.Expr>) -> Left {
    match offered_shape(shapes: builder.lowering.shapes, module: through.module.text, name: through.name.text) {
        Some(shape) => builds(builder, shape, arguments)
        None => compiled_or_called(builder, through, arguments)
    }
}

/// The builder after a list function the compiler writes, or a call into another module.
// example: held_text(compiled_or_called(little_builder(""), Through { module: infer.no_name(), name: infer.no_name(), used: infer.no_name().span }, []).held) == "V"
fn compiled_or_called(builder: Builder, through: Through, arguments: List<ast.Expr>) -> Left {
    match held_by_the_compiler(builder, through, arguments) {
        Some(left) => left
        None => in_another_module(builder, through, arguments)
    }
}

/// The builder after a call of a function another module declares.
// example: held_text(in_another_module(little_builder(""), Through { module: infer.no_name(), name: infer.no_name(), used: infer.no_name().span }, []).held) == "V"
fn in_another_module(builder: Builder, through: Through, arguments: List<ast.Expr>) -> Left {
    reached := reached_method(builder, through)
    handing := each_handed(reached.builder, arguments, reached.reaching.signature.parameters)
    invoking := InvokeStatic(MethodRef { class: module_named(builder.lowering.shapes.classes, through.module.text), name: reached.reaching.named, descriptor: descriptor_of(reached.reaching.signature) })
    Left { builder: emit(handing, invoking), held: reached.reaching.signature.result }
}

/// The builder after a `match`: each arm's pattern tried in turn, and the first that fits written.
///
/// Where no arm fits, which the exhaustiveness check proves never happens, an `AssertionError`
/// is thrown, because the JVM does not take a method that can run off its end.
// example: held_text(match_expr(little_builder(""), ast.MatchExpr { scrutinee: no_expr(), arms: [] }, infer.no_name().span).held) == "V"
fn match_expr(builder: Builder, matched: ast.MatchExpr, at: lexer.Span) -> Left {
    wanted := carried_at(builder, at)
    held := matched_held(builder, matched.scrutinee)
    end := held.builder.next_label
    var writing = label_taken(held.builder)
    for arm in matched.arms {
        next := writing.next_label
        left := expr_built(tried(label_taken(writing), arm.pattern, held.slot, next), arm.body)
        writing = emits(adapt(builder: left.builder, from: left.held, to: wanted), [Jump(end), Label(next)])
    }
    Left { builder: emit(unmatched(writing), Label(end)), held: wanted }
}

/// The builder after `scrutinee` is held in a new slot, where it is not `()`.
// example: is_unslotted(matched_held(little_builder(""), no_expr()).slot)
fn matched_held(builder: Builder, scrutinee: ast.Expr) -> HeldSlot {
    of := carried_at(builder, scrutinee.span)
    left := expr_built(builder, scrutinee)
    adapted := adapt(builder: left.builder, from: left.held, to: of)
    match of {
        Some(holding) => HeldSlot { builder: emit(temporary(adapted, holding), Store { slot: adapted.next_slot, of: holding }), slot: Some(Slot { at: adapted.next_slot, of: holding }) }
        None => HeldSlot { builder: adapted, slot: None }
    }
}

/// The method a use at `at` of the function declared at `declared` reaches, settled where it is generic.
///
/// `within` is what the body the use is written in was settled on, which a generic body passes
/// on to what it calls.
// example: use_reached(little_lowering(""), Use { declared: infer.no_name().span, at: infer.no_name().span, within: whole() }).reaching.named == ""
fn use_reached(lowering: Lowering, use: Use) -> Reachable {
    match generic_source(lowering, use.declared) {
        Some(function) => used_settled(lowering, use, function)
        None => Reachable { lowering: lowering, reaching: plainly(lowering, use.declared) }
    }
}

/// The generic `function`, owed settled on what its use settles it on.
// example: used_settled(little_lowering(""), Use { declared: infer.no_name().span, at: infer.no_name().span, within: whole() }, no_function()).reaching.named == ""
fn used_settled(lowering: Lowering, use: Use, function: ast.FunctionDeclaration) -> Reachable {
    at_use := substituted(use.within, used_as(lowering, use.at))
    settled := instantiation_of(function: function, written_at: used_as(lowering, use.declared), used: at_use)
    named := instantiation_names(settled, named_at(lowering, use.declared))
    reaching := Reaching { named: named, signature: signature_of(lowering, use.declared, settled) }
    Reachable { lowering: owe(lowering, use.declared, named, settled), reaching: reaching }
}

/// An expression of `()`, written nowhere.
// example: no_expr().span.start == 0
fn no_expr() -> ast.Expr {
    ast.Expr { kind: ast.Unit, span: infer.no_name().span }
}

/// The label a `break` jumps to, where there is a loop.
// example: or(repeat_done(Some(Repeat { again: 1, done: 2 })), 0) == 2
fn repeat_done(repeat: Option<Repeat>) -> Option<Int> {
    match repeat {
        Some(labels) => Some(labels.done)
        None => None
    }
}

/// The label a `continue` jumps to, where there is a loop.
// example: or(repeat_again(Some(Repeat { again: 1, done: 2 })), 0) == 1
fn repeat_again(repeat: Option<Repeat>) -> Option<Int> {
    match repeat {
        Some(labels) => Some(labels.again)
        None => None
    }
}

/// The builder after a jump to `label`, where there is one.
// example: list.length(left_for(little_builder(""), Some(3)).instructions) == 1
fn left_for(builder: Builder, label: Option<Int>) -> Builder {
    match label {
        Some(to) => emit(builder, Jump(to))
        None => builder
    }
}

/// The builder after the value on the stack is held in a new slot, which `key` names.
// example: !is_unslotted(map.get(field_held(little_builder(""), "a", Long).fields, "a"))
fn field_held(builder: Builder, key: String, of: Descriptor) -> Builder {
    at := builder.next_slot
    holding := emit(temporary(builder, of), Store { slot: at, of: of })
    holding { fields: map.insert(holding.fields, key, Slot { at: at, of: of }) }
}

/// The builder after what `left` holds is turned into what `wanted` holds.
// example: list.length(left_as(Left { builder: little_builder(""), held: Some(Long) }, None).instructions) == 1
fn left_as(left: Left, wanted: Option<Descriptor>) -> Builder {
    adapt(builder: left.builder, from: left.held, to: wanted)
}

/// The builder after the test of a walk over a list, and the item at the index held.
// example: list.length(walk_stepped(little_builder(""), Walk { walked_list: 0, index: 1, item: None }, 0).instructions) == 10
fn walk_stepped(builder: Builder, turn: Turn, done: Int) -> Builder {
    match turn {
        Walk { walked_list, index, item } => walked_over(builder: builder, walked_list: Slot { at: walked_list, of: list_descriptor() }, index: index, item: item, done: done)
        _ => builder
    }
}

/// The builder after the test of a walk over the list in `list`, and the item held in `item`.
// example: list.length(walked_over(builder: little_builder(""), walked_list: Slot { at: 0, of: Long }, index: 1, item: None, done: 0).instructions) == 10
fn walked_over(builder: Builder, walked_list: Slot, index: Int, item: Option<Slot>, done: Int) -> Builder {
    counting := Load { slot: index, of: Integer }
    walking := Load { slot: walked_list.at, of: walked_list.of }
    testing := emits(builder, [counting, walking, GetField(list_length()), CompareIntegers(Less), JumpIfFalse(done)])
    reading := emits(testing, [walking, GetField(list_slots()), counting, LoadFromArray])
    stored_in(reading, item, Some(object()))
}

/// Whether nothing holds a value.
// example: is_nothing(None)
fn is_nothing(held: Option<Descriptor>) -> Bool {
    match held {
        Some(_) => false
        None => true
    }
}

/// The builder after a new `Object` is built, which stands for `()`.
// example: list.length(nothing(little_builder("")).instructions) == 3
fn nothing(builder: Builder) -> Builder {
    emits(builder, [New(object_class()), Copy, Construct(MethodRef { class: object_class(), name: "<init>", descriptor: MethodDescriptor { parameters: [], result: None } })])
}

/// Whether what is written at `written` is `()`, as the body is settled.
// example: !is_holding_nothing(little_builder(""), infer.no_name().span)
fn is_holding_nothing(builder: Builder, written: lexer.Span) -> Bool {
    match infer.type_at(builder.lowering.typed, written) {
        Some(of) => substituted(builder.at, of) == unify.Unit
        None => false
    }
}

/// The builder after `Some` of the quotient or the remainder of the two slots is built.
// example: list.length(divided_answer(builder: little_builder(""), how: Divide, dividend: 0, divisor: 2).instructions) == 7
fn divided_answer(builder: Builder, how: Arithmetic, dividend: Int, divisor: Int) -> Builder {
    some := built_shape(builder.lowering.shapes, "Some")
    computed := emits(builder, [New(some.class), Copy, Load { slot: dividend, of: Long }, Load { slot: divisor, of: Long }, Arithmetic(how)])
    constructed(adapt(builder: computed, from: Some(Long), to: first_carried(some)), some).builder
}

/// The builder after two values `held` holds are added: joined for text, summed for numbers.
// example: list.length(added(little_builder(""), Some(Long)).builder.instructions) == 1
fn added(builder: Builder, held: Option<Descriptor>) -> Left {
    adding := match held {
        Some(Reference(_)) => Concat
        _ => Arithmetic(Add)
    }
    Left { builder: emit(builder, adding), held: held }
}

/// The module and the name a call through a module reaches, where `callee` is one.
// example: is_not_through(reached_inside(little_builder(""), no_expr()))
fn reached_inside(builder: Builder, callee: ast.Expr) -> Option<Through> {
    match callee.kind {
        ast.Field { receiver, name } => through_module(builder, receiver, name, callee.span)
        _ => None
    }
}

/// The module `receiver` names and the name after it, where `receiver` names a module.
// example: is_not_through(through_module(little_builder(""), no_expr(), infer.no_name(), infer.no_name().span))
fn through_module(builder: Builder, receiver: ast.Expr, name: ast.Name, used: lexer.Span) -> Option<Through> {
    match module_named_by(builder, receiver) {
        Some(module) => Some(Through { module: module, name: name, used: used })
        None => None
    }
}

/// The name a call reaches, and what it passes.
// example: list.length(callee_of(no_expr(), [no_expr()]).passed) == 1
fn callee_of(callee: ast.Expr, arguments: List<ast.Expr>) -> Callee {
    match callee.kind {
        ast.NameExpr(name) => Callee { name: name, passed: arguments }
        _ => Callee { name: infer.no_name(), passed: arguments }
    }
}

/// Where the split binding `receiver` names is written, where it names one.
// example: is_whole(split_receiver(little_builder(""), no_expr()))
fn split_receiver(builder: Builder, receiver: ast.Expr) -> Option<lexer.Span> {
    match receiver.kind {
        ast.NameExpr(held) => split_binding(builder, held)
        _ => None
    }
}

/// Where the binding `name` reads is written, where that binding is split into its fields.
// example: is_whole(split_binding(little_builder(""), infer.no_name()))
fn split_binding(builder: Builder, name: ast.Name) -> Option<lexer.Span> {
    match value_definition(builder, name).origin {
        resolver.InPrelude => None
        resolver.Declared(at) => if set.has_value(builder.splitting, infer.span_key(at)) {
            Some(at)
        } else {
            None
        }
    }
}

/// The shape of the variant `name` inside the module `receiver` names, where it is one.
// example: is_unshaped(offered_variant(little_builder(""), no_expr(), infer.no_name()))
fn offered_variant(builder: Builder, receiver: ast.Expr, name: ast.Name) -> Option<Shape> {
    match module_named_by(builder, receiver) {
        Some(module) => offered_shape(shapes: builder.lowering.shapes, module: module.text, name: name.text)
        None => None
    }
}

/// The name of the module `receiver` is, where it is one.
// example: is_unnamed(module_named_by(little_builder(""), no_expr()))
fn module_named_by(builder: Builder, receiver: ast.Expr) -> Option<ast.Name> {
    match receiver.kind {
        ast.NameExpr(module) => if value_definition(builder, module).kind == resolver.Module {
            Some(module)
        } else {
            None
        }
        _ => None
    }
}

/// The builder after the field `name` of the split binding at `binding` is read from its slot.
// example: held_text(held_field(builder: little_builder(""), binding: infer.no_name().span, at: infer.no_name().span, name: infer.no_name()).held) == "V"
fn held_field(builder: Builder, binding: lexer.Span, at: lexer.Span, name: ast.Name) -> Left {
    match carried_named(record_of(builder, at), name.text) {
        Some(_) => slot_loaded(builder, map.get(builder.fields, held_key(binding, name.text)))
        None => Left { builder: builder, held: None }
    }
}

/// The key of the field `field` of the split binding written at `binding`.
// example: held_key(lexer.Span { start: 1, length: 2 }, "a") == "1048578 a"
fn held_key(binding: lexer.Span, field: String) -> String {
    shown(infer.span_key(binding)) + " " + field
}

/// The name of the type written at `written`, and `""` where it is not a named type.
// example: named_type_at(little_builder(""), infer.no_name().span) == ""
fn named_type_at(builder: Builder, written: lexer.Span) -> String {
    match infer.type_at(builder.lowering.typed, written) {
        Some(unify.Named { name, arguments }) => name
        _ => ""
    }
}

/// Whether `fields` gives the value `carried` names.
// example: !is_written_for([], Carried { name: "a", of: None })
fn is_written_for(fields: List<ast.FieldValue>, carried: Carried) -> Bool {
    for written in fields {
        if written.name.text == carried.name {
            return true
        }
    }
    false
}

/// The builder after the field `carried` names is read from the record `base` holds.
// example: list.length(kept_values(little_builder(""), infer.no_name(), no_shape(), Carried { name: "a", of: None }).instructions) == 0
fn kept_values(builder: Builder, base: ast.Name, shape: Shape, carried: Carried) -> Builder {
    match carried.of {
        Some(of) => field_kept(builder, base, shape, FieldRef { class: shape.class, name: carried.name, of: of })
        None => builder
    }
}

/// The builder after `reading` is read from the record `base` holds.
// example: list.length(field_kept(little_builder(""), infer.no_name(), no_shape(), FieldRef { class: "", name: "a", of: Long }).instructions) == 1
fn field_kept(builder: Builder, base: ast.Name, shape: Shape, reading: FieldRef) -> Builder {
    left := loaded_value(builder, base)
    emit(adapt(builder: left.builder, from: left.held, to: Some(Reference(shape.class))), GetField(reading))
}

/// The shape of the record the binding `base` holds.
// example: no_shape().class == ""
fn record_updated(builder: Builder, base: ast.Name) -> Shape {
    match value_definition(builder, base).origin {
        resolver.InPrelude => no_shape()
        resolver.Declared(at) => record_of(builder, at)
    }
}

/// The shape of the record whose type is written at `written`.
// example: record_of(little_builder(""), infer.no_name().span).class == ""
fn record_of(builder: Builder, written: lexer.Span) -> Shape {
    match infer.type_at(builder.lowering.typed, written) {
        Some(unify.Named { name, arguments }) => record_shape(builder.lowering.shapes, name)
        _ => no_shape()
    }
}

/// The builder after the constructor of `shape` is called on what the stack holds.
// example: held_text(constructed(little_builder(""), no_shape()).held) == "L;"
fn constructed(builder: Builder, shape: Shape) -> Left {
    Left { builder: emit(builder, Construct(MethodRef { class: shape.class, name: "<init>", descriptor: constructor_descriptor(shape) })), held: Some(Reference(shape.base)) }
}

/// The builder after the local `name` is loaded, where it has a slot.
// example: held_text(loaded_value(little_builder(""), infer.no_name()).held) == "V"
fn loaded_value(builder: Builder, name: ast.Name) -> Left {
    slot_loaded(builder, local(builder, name))
}

/// The builder after what `slot` holds is loaded, where there is a slot.
// example: held_text(slot_loaded(little_builder(""), Some(Slot { at: 0, of: Long })).held) == "J"
fn slot_loaded(builder: Builder, slot: Option<Slot>) -> Left {
    match slot {
        Some(held) => Left { builder: emit(builder, Load { slot: held.at, of: held.of }), held: Some(held.of) }
        None => Left { builder: builder, held: None }
    }
}

/// The trait an operator asks for, whether its operands are swapped, and whether its answer is.
// example: asked_by(ast.Greater).reversed
fn asked_by(operator: ast.BinaryOperator) -> OperatorAsk {
    match operator {
        ast.Equal => OperatorAsk { of: "Eq", reversed: false, flipped: false }
        ast.NotEqual => OperatorAsk { of: "Eq", reversed: false, flipped: true }
        ast.Less => OperatorAsk { of: "Ord", reversed: false, flipped: false }
        ast.LessOrEqual => OperatorAsk { of: "Ord", reversed: true, flipped: true }
        ast.Greater => OperatorAsk { of: "Ord", reversed: true, flipped: false }
        ast.GreaterOrEqual => OperatorAsk { of: "Ord", reversed: false, flipped: true }
        ast.Subtract => OperatorAsk { of: "Sub", reversed: false, flipped: false }
        ast.Multiply => OperatorAsk { of: "Mul", reversed: false, flipped: false }
        ast.Divide => OperatorAsk { of: "Div", reversed: false, flipped: false }
        ast.Remainder => OperatorAsk { of: "Rem", reversed: false, flipped: false }
        _ => OperatorAsk { of: "Add", reversed: false, flipped: false }
    }
}

/// The instruction that adds two values `of` holds.
// example: method_named(written_out_add(text_descriptor())) == ""
fn written_out_add(of: Descriptor) -> Instruction {
    match of {
        Reference(_) => Concat
        Array(_) => Concat
        _ => Arithmetic(Add)
    }
}

/// The one slot `aside` put a value in.
// example: list.length(aside_of(put_aside_as(little_builder(""), no_expr(), Long)).slots) == 1
fn aside_of(aside: Aside) -> Asides {
    Asides { builder: aside.builder, slots: [aside.slot] }
}

/// Whether `operator` divides, which gives an `Option`.
// example: is_division(ast.Remainder)
fn is_division(operator: ast.BinaryOperator) -> Bool {
    match operator {
        ast.Divide => true
        ast.Remainder => true
        _ => false
    }
}

/// The operator that writes out the method of the trait `of`.
// example: is_division(written_as_operator("Div"))
fn written_as_operator(of: String) -> ast.BinaryOperator {
    match of {
        "Eq" => ast.Equal
        "Ord" => ast.Less
        "Sub" => ast.Subtract
        "Mul" => ast.Multiply
        "Div" => ast.Divide
        "Rem" => ast.Remainder
        _ => ast.Add
    }
}

/// How a comparison operator compares.
// example: operator_how(ast.Less) == Less
fn operator_how(operator: ast.BinaryOperator) -> Comparison {
    match operator {
        ast.NotEqual => NotEqual
        ast.Less => Less
        ast.LessOrEqual => LessOrEqual
        ast.Greater => Greater
        ast.GreaterOrEqual => GreaterOrEqual
        _ => Equal
    }
}

/// The arithmetic an operator counts with.
// example: list.length([counted_by(ast.Multiply)]) == 1
fn counted_by(operator: ast.BinaryOperator) -> Arithmetic {
    match operator {
        ast.Subtract => Subtract
        ast.Multiply => Multiply
        ast.Divide => Divide
        ast.Remainder => Remainder
        _ => Add
    }
}

/// The loads of each slot of `slots`.
// example: list.length(reloaded_from([Slot { at: 0, of: Long }])) == 1
fn reloaded_from(slots: List<Slot>) -> List<Instruction> {
    var loads = []
    for slot in slots {
        loads = list.push(loads, Load { slot: slot.at, of: slot.of })
    }
    loads
}

/// The builder after the value the variant in `held` carries is read as what `wanted` holds.
// example: list.length(read_carried(little_builder(""), no_shape(), Slot { at: 0, of: Long }, None).instructions) == 0
fn read_carried(builder: Builder, shape: Shape, held: Slot, wanted: Option<Descriptor>) -> Builder {
    match first_carried(shape) {
        Some(of) => adapt(builder: emits(builder, [Load { slot: held.at, of: held.of }, Cast(shape.class), GetField(FieldRef { class: shape.class, name: first_carried_name(shape), of: of })]), from: Some(of), to: wanted)
        None => builder
    }
}

/// What holds the first value `shape` carries, and nothing where it carries none.
// example: is_nothing(first_carried(no_shape()))
fn first_carried(shape: Shape) -> Option<Descriptor> {
    match list.at(shape.carries, 0) {
        Some(carried) => carried.of
        None => None
    }
}

/// The field the first value `shape` carries is held in.
// example: first_carried_name(no_shape()) == ""
fn first_carried_name(shape: Shape) -> String {
    match list.at(shape.carries, 0) {
        Some(carried) => carried.name
        None => ""
    }
}

/// The method a call through a module reaches, which that module is asked for where it is generic.
// example: reached_method(little_builder(""), Through { module: infer.no_name(), name: infer.no_name(), used: infer.no_name().span }).reaching.named == ""
fn reached_method(builder: Builder, through: Through) -> Reaches {
    match infer.generic_at(builder.lowering.typed, through.name.span) {
        Some(generic) => generic_reached(builder, through, generic)
        None => Reaches { builder: builder, reaching: Reaching { named: through.name.text, signature: signature_of(builder.lowering, through.used, whole()) } }
    }
}

/// The generic another module declares, asked for as `generic` settles it, with each instance
/// its constraints ask for owed.
// example: generic_reached(little_builder(""), Through { module: infer.no_name(), name: infer.no_name(), used: infer.no_name().span }, infer.GenericUse { settled: [], constrained: [], written_as: unify.Unit }).reaching.named == ""
fn generic_reached(builder: Builder, through: Through, generic: infer.GenericUse) -> Reaches {
    var settled = []
    for one in generic.settled {
        settled = list.push(settled, substituted(builder.at, one))
    }
    owing := each_instance_owed(builder.lowering, generic.constrained, settled)
    named := asking_named(owing, GenericAsked { module: through.module.text, function: through.name.text, settled: settled, constrained: generic.constrained })
    signature := written_as(named.lowering, substituted(builder.at, generic.written_as))
    Reaches { builder: builder { lowering: named.lowering }, reaching: Reaching { named: named.named, signature: signature } }
}

/// The name a use of a generic of `module` reaches, which that module is asked for.
// example: asking_named(little_lowering(""), GenericAsked { module: "lexer", function: "pick", settled: [unify.int()], constrained: [[]] }).named == "pick$Int"
fn asking_named(lowering: Lowering, asked: GenericAsked) -> NamedAsked {
    made := ask(lowering: lowering, module: asked.module, function: asked.function, settled: asked.settled)
    NamedAsked { lowering: made.lowering, named: generic_names(asked.function, made.written, asked.constrained) }
}

/// `lowering` after each instance each constraint asks for is answered, and so owed or asked for.
// example: list.length(each_instance_owed(little_lowering(""), [], []).owed) == 0
fn each_instance_owed(lowering: Lowering, constrained: List<List<String>>, settled: List<unify.Type>) -> Lowering {
    var owing = lowering
    var at = 0
    for traits in constrained {
        owing = match list.at(settled, at) {
            Some(one) => traits_answered(owing, traits, one)
            None => owing
        }
        at += 1
    }
    owing
}

/// `lowering` after the method of each of `traits` is answered at `at`.
// example: list.length(traits_answered(little_lowering(""), ["Eq"], unify.int()).owed) == 0
fn traits_answered(lowering: Lowering, traits: List<String>, at: unify.Type) -> Lowering {
    var owing = lowering
    for of in traits {
        owing = answering_at(owing, method_of(owing.library, of), at).lowering
    }
    owing
}

/// The builder after the throw of an `AssertionError`.
// example: list.length(unmatched(little_builder("")).instructions) == 4
fn unmatched(builder: Builder) -> Builder {
    thrown := "java/lang/AssertionError"
    emits(builder, [New(thrown), Copy, Construct(MethodRef { class: thrown, name: "<init>", descriptor: MethodDescriptor { parameters: [], result: None } }), Throw])
}

/// The builder after `pattern` is tried against what `held` holds, jumping to `next` where it
/// does not fit; a `()` fits every pattern, and is tried against nothing.
// example: list.length(tried(little_builder(""), ast.Pattern { kind: ast.Wildcard, span: infer.no_name().span }, None, 0).instructions) == 0
fn tried(builder: Builder, pattern: ast.Pattern, held: Option<Slot>, next: Int) -> Builder {
    match held {
        Some(slot) => tried_against(builder, pattern, Against { slot: slot, next: next })
        None => builder
    }
}

/// The builder after `pattern` is tried against what `against` holds.
// example: list.length(tried_against(little_builder(""), ast.Pattern { kind: ast.TruthPattern(true), span: infer.no_name().span }, Against { slot: Slot { at: 0, of: Boolean }, next: 0 }).instructions) == 4
fn tried_against(builder: Builder, pattern: ast.Pattern, against: Against) -> Builder {
    match pattern.kind {
        ast.NamePattern(path) => tried_name(builder, path, against)
        ast.TuplePattern { path, elements } => tried_tuple(builder, path, elements, against)
        ast.RecordPattern { path, fields } => tried_record(builder, path, fields, against)
        ast.IntegerPattern(value) => tried_number(builder, value, pattern.span, against)
        ast.TextPattern(value) => equal_to(builder, TextOf(value), text_descriptor(), pattern.span, against)
        ast.TruthPattern(value) => equal_to(builder, BooleanOf(value), Boolean, pattern.span, against)
        ast.Wildcard => builder
        ast.OrPattern(alternatives) => tried_any_of(builder, alternatives, against)
    }
}

/// The builder after each alternative is tried in turn, the first that fits going on.
// example: little_builder("").next_label == 0
fn tried_any_of(builder: Builder, alternatives: List<ast.Pattern>, against: Against) -> Builder {
    matched := builder.next_label
    var writing = label_taken(builder)
    last := list.length(alternatives) - 1
    if last < 0 {
        return writing
    }
    var at = 0
    for alternative in alternatives {
        if at < last {
            next := writing.next_label
            writing = emits(tried(label_taken(writing), alternative, Some(against.slot), next), [Jump(matched), Label(next)])
        } else {
            writing = tried(writing, alternative, Some(against.slot), against.next)
        }
        at += 1
    }
    emit(writing, Label(matched))
}

/// The builder after the variant is tested for and each value it carries tried against its pattern.
// example: list.length(tried_tuple(little_builder(""), ast.Path { module: None, name: infer.no_name() }, [], Against { slot: Slot { at: 0, of: Long }, next: 0 }).instructions) == 0
fn tried_tuple(builder: Builder, path: ast.Path, elements: List<ast.Pattern>, against: Against) -> Builder {
    found := tagged(builder, path, against)
    var writing = found.builder
    var at = 0
    for element in elements {
        writing = match list.at(found.shape.carries, at) {
            Some(carried) => element_tried(writing, element, found.shape, carried, against)
            None => writing
        }
        at += 1
    }
    writing
}

/// The builder after the value `carried` names is read, held, and tried against `element`.
// example: list.length(element_tried(little_builder(""), ast.Pattern { kind: ast.Wildcard, span: infer.no_name().span }, no_shape(), Carried { name: "a", of: None }, Against { slot: Slot { at: 0, of: Long }, next: 0 }).instructions) == 0
fn element_tried(builder: Builder, element: ast.Pattern, shape: Shape, carried: Carried, against: Against) -> Builder {
    match carried.of {
        Some(of) => tried(emit(temporary(pattern_read(builder, shape, carried, against), of), Store { slot: builder.next_slot, of: of }), element, Some(Slot { at: builder.next_slot, of: of }), against.next)
        None => builder
    }
}

/// The builder with one more label taken.
// example: label_taken(little_builder("")).next_label == 1
fn label_taken(builder: Builder) -> Builder {
    builder { next_label: builder.next_label + 1 }
}

/// The builder after the whole number `value` is compared with what `against` holds.
// example: list.length(tried_number(little_builder(""), 1, infer.no_name().span, Against { slot: Slot { at: 0, of: Long }, next: 0 }).instructions) == 5
fn tried_number(builder: Builder, value: Int, written: lexer.Span, against: Against) -> Builder {
    of := carried_at(builder, written)
    loading := adapt(builder: emit(builder, Load { slot: against.slot.at, of: against.slot.of }), from: Some(against.slot.of), to: of)
    pushed := whole_number(loading, value, written)
    same_as(pushed.builder, or(pushed.held, Long), written, against)
}

/// The builder after the whole number `value`, built through `from_literal` where an instance
/// answers it at the type the literal is written at.
// example: held_text(whole_number(little_builder(""), 1, infer.no_name().span).held) == "J"
fn whole_number(builder: Builder, value: Int, written: lexer.Span) -> Left {
    found := instance_written(emit(builder, LongOf(value)), "from_literal", written)
    match found.answered_by {
        Some(answerer) => Left { builder: emit(found.builder, instance_called(answerer)), held: answerer.reaching.signature.result }
        None => Left { builder: found.builder, held: Some(Long) }
    }
}

/// The builder after a name pattern: a variant tested for, or a binding of what `against` holds.
// example: list.length(tried_name(little_builder(""), ast.Path { module: None, name: infer.no_name() }, Against { slot: Slot { at: 0, of: Long }, next: 0 }).instructions) == 2
fn tried_name(builder: Builder, path: ast.Path, against: Against) -> Builder {
    if !is_unnamed(path.module) || value_definition(builder, path.name).kind == resolver.Constructor {
        return tagged(builder, path, against).builder
    }
    declaring := declare(builder, path.name)
    stored_value(emit(declaring, Load { slot: against.slot.at, of: against.slot.of }), path.name, Some(against.slot.of))
}

/// Whether no name was found.
// example: is_unnamed(None)
fn is_unnamed(found: Option<ast.Name>) -> Bool {
    match found {
        Some(_) => false
        None => true
    }
}

/// The builder after the variant is tested for and each field it names bound.
// example: list.length(tried_record(little_builder(""), ast.Path { module: None, name: infer.no_name() }, [], Against { slot: Slot { at: 0, of: Long }, next: 0 }).instructions) == 0
fn tried_record(builder: Builder, path: ast.Path, fields: List<ast.Name>, against: Against) -> Builder {
    found := tagged(builder, path, against)
    var writing = found.builder
    for field in fields {
        carried := Carried { name: field.text, of: carried_named(found.shape, field.text) }
        writing = stored_value(pattern_read(declare(writing, field), found.shape, carried, against), field, carried.of)
    }
    writing
}

/// The builder after what `left` holds is stored in the slot of the local `name`.
// example: list.length(stored_value(little_builder(""), infer.no_name(), Some(Long)).instructions) == 1
fn stored_value(builder: Builder, name: ast.Name, left: Option<Descriptor>) -> Builder {
    stored_in(builder, local(builder, name), left)
}

/// The builder after what `left` holds is stored in `slot`, or dropped where there is no slot.
// example: list.length(stored_in(little_builder(""), Some(Slot { at: 0, of: Long }), Some(Long)).instructions) == 1
fn stored_in(builder: Builder, slot: Option<Slot>, left: Option<Descriptor>) -> Builder {
    match slot {
        Some(into) => emit(adapt(builder: builder, from: left, to: Some(into.of)), Store { slot: into.at, of: into.of })
        None => adapt(builder: builder, from: left, to: None)
    }
}

/// The builder with a slot for the local `name`, where its type is carried by something.
// example: declare(little_builder(""), infer.no_name()).next_slot == 0
fn declare(builder: Builder, name: ast.Name) -> Builder {
    match carried_at(builder, name.span) {
        Some(of) => temporary(builder { slots: map.insert(builder.slots, infer.span_key(name.span), Slot { at: builder.next_slot, of: of }) }, of)
        None => builder
    }
}

/// The slot of the local `name` reads, where it has one.
// example: is_unslotted(local(little_builder(""), infer.no_name()))
fn local(builder: Builder, name: ast.Name) -> Option<Slot> {
    match value_definition(builder, name).origin {
        resolver.InPrelude => None
        resolver.Declared(at) => map.get(builder.slots, infer.span_key(at))
    }
}

/// What carries the value written at `written`, as the body is settled.
// example: is_nothing(carried_at(little_builder(""), infer.no_name().span))
fn carried_at(builder: Builder, written: lexer.Span) -> Option<Descriptor> {
    match infer.type_at(builder.lowering.typed, written) {
        Some(of) => carried_type(builder.lowering.shapes, substituted(builder.at, of))
        None => None
    }
}

/// What the value name `name` means.
// example: value_definition(little_builder(""), infer.no_name()).kind == resolver.Local
fn value_definition(builder: Builder, name: ast.Name) -> resolver.Definition {
    declared.definition_of(builder.lowering.typed.resolved, resolver.ValueNamespace, name)
}

/// The builder with the slots a value `of` holds taken, past each slot taken so far.
// example: temporary(little_builder(""), Long).next_slot == 2
fn temporary(builder: Builder, of: Descriptor) -> Builder {
    builder { next_slot: builder.next_slot + width(of) }
}

/// What holds the value `shape` carries under `name`, and nothing where that value is `()`.
// example: is_nothing(carried_named(no_shape(), "a"))
fn carried_named(shape: Shape, name: String) -> Option<Descriptor> {
    for carried in shape.carries {
        if carried.name == name {
            return carried.of
        }
    }
    None
}

/// The builder after the test that jumps to `against.next` unless it holds the variant `path`
/// names, and the shape of that variant; a record has no tag, and is not tested.
// example: tagged(little_builder(""), ast.Path { module: None, name: infer.no_name() }, Against { slot: Slot { at: 0, of: Long }, next: 0 }).shape.class == ""
fn tagged(builder: Builder, path: ast.Path, against: Against) -> Tagged {
    shape := built_shape(builder.lowering.shapes, path_text(path))
    match shape.tag {
        Some(_) => Tagged { builder: emits(builder, carrying_tag(shape, against.slot, against.next)), shape: shape }
        None => Tagged { builder: builder, shape: shape }
    }
}

/// The test that jumps to `otherwise` unless `held` holds the variant `shape` builds.
// example: list.length(carrying_tag(no_shape(), Slot { at: 0, of: Long }, 0)) == 6
fn carrying_tag(shape: Shape, held: Slot, otherwise: Int) -> List<Instruction> {
    [Load { slot: held.at, of: held.of }, Cast(shape.base), GetField(FieldRef { class: shape.base, name: "tag", of: Integer }), IntegerOf(or(shape.tag, 0)), CompareIntegers(Equal), JumpIfFalse(otherwise)]
}

/// The builder after the value `carried` names is read out of what `against` holds.
// example: list.length(pattern_read(little_builder(""), no_shape(), Carried { name: "a", of: Some(Long) }, Against { slot: Slot { at: 0, of: Long }, next: 0 }).instructions) == 3
fn pattern_read(builder: Builder, shape: Shape, carried: Carried, against: Against) -> Builder {
    match carried.of {
        Some(of) => emits(builder, [Load { slot: against.slot.at, of: against.slot.of }, Cast(shape.class), GetField(FieldRef { class: shape.class, name: carried.name, of: of })])
        None => builder
    }
}

/// The builder after the literal `pushed`, which a value `of` holds, is compared with `against`.
// example: list.length(equal_to(little_builder(""), BooleanOf(true), Boolean, infer.no_name().span, Against { slot: Slot { at: 0, of: Boolean }, next: 0 }).instructions) == 4
fn equal_to(builder: Builder, pushed: Instruction, of: Descriptor, written: lexer.Span, against: Against) -> Builder {
    loading := adapt(builder: emit(builder, Load { slot: against.slot.at, of: against.slot.of }), from: Some(against.slot.of), to: Some(of))
    same_as(emit(loading, pushed), of, written, against)
}

/// The builder after what `from` holds is turned into what `to` holds, or dropped for nothing.
// example: list.length(adapt(builder: little_builder(""), from: Some(Long), to: None).instructions) == 1
fn adapt(builder: Builder, from: Option<Descriptor>, to: Option<Descriptor>) -> Builder {
    match from {
        Some(held) => adapted_to(builder, held, to)
        None => builder
    }
}

/// The builder after `held` is turned into `to`, or dropped where `to` is nothing.
// example: list.length(adapted_to(little_builder(""), Long, Some(object())).instructions) == 1
fn adapted_to(builder: Builder, held: Descriptor, to: Option<Descriptor>) -> Builder {
    match to {
        Some(wanted) => emits(builder, converted(held: held, wanted: wanted))
        None => emit(builder, Drop(held))
    }
}

/// What turns `held` into `wanted`: a box, an unbox, a cast from `Object`, or nothing.
// example: list.length(converted(held: Long, wanted: object())) == 1
// example: list.length(converted(held: object(), wanted: Long)) == 2
// example: list.length(converted(held: object(), wanted: text_descriptor())) == 1
fn converted(held: Descriptor, wanted: Descriptor) -> List<Instruction> {
    if held == wanted {
        return []
    }
    boxed := boxing_class(held)
    unboxed := boxing_class(wanted)
    if boxed != "" && unboxed == "" {
        return [holding_class(held)]
    }
    if boxed == "" && unboxed != "" {
        return read_out_of(wanted)
    }
    if boxed == "" && unboxed == "" {
        return narrowed(held: held, wanted: wanted)
    }
    []
}

/// A cast from `Object` to the class `wanted` names, where both are classes.
// example: list.length(narrowed(held: object(), wanted: text_descriptor())) == 1
// example: list.length(narrowed(held: text_descriptor(), wanted: object())) == 0
fn narrowed(held: Descriptor, wanted: Descriptor) -> List<Instruction> {
    match wanted {
        Reference(class) => if held == object() && class != object_class() {
            [Cast(class)]
        } else {
            []
        }
        _ => []
    }
}

/// The cast to the box of `wanted`, and the call that reads the value out of it.
// example: list.length(read_out_of(Long)) == 2
fn read_out_of(wanted: Descriptor) -> List<Instruction> {
    class := boxing_class(wanted)
    [Cast(class), InvokeVirtual(MethodRef { class: class, name: box_read(wanted), descriptor: MethodDescriptor { parameters: [], result: Some(wanted) } })]
}

/// The method of its box that reads a value `of` holds back out.
// example: box_read(Boolean) == "booleanValue"
fn box_read(of: Descriptor) -> String {
    match of {
        Long => "longValue"
        Boolean => "booleanValue"
        _ => "intValue"
    }
}

/// The builder after the two values on the stack are compared, jumping to `against.next` where
/// they differ, through `is_equal` where an instance answers it at the type of the pattern.
// example: list.length(same_as(little_builder(""), Long, infer.no_name().span, Against { slot: Slot { at: 0, of: Long }, next: 0 }).instructions) == 2
fn same_as(builder: Builder, held: Descriptor, written: lexer.Span, against: Against) -> Builder {
    found := instance_written(builder, "is_equal", written)
    comparing := match found.answered_by {
        Some(answerer) => emit(found.builder, instance_called(answerer))
        None => emits(found.builder, compared(Some(held), Equal))
    }
    emit(comparing, JumpIfFalse(against.next))
}

/// The builder with `instruction` written after each instruction so far.
// example: list.length(emit(little_builder(""), Copy).instructions) == 1
fn emit(builder: Builder, instruction: Instruction) -> Builder {
    builder { instructions: list.push(builder.instructions, instruction) }
}

/// The builder with each of `instructions` written, in order.
// example: list.length(emits(little_builder(""), [Copy, Copy]).instructions) == 2
fn emits(builder: Builder, instructions: List<Instruction>) -> Builder {
    var writing = builder.instructions
    for instruction in instructions {
        writing = list.push(writing, instruction)
    }
    builder { instructions: writing }
}

/// The instance of `method` at the type written at `of`, as the body is settled, where one answers.
// example: is_unfound(instance_written(little_builder(""), "is_equal", infer.no_name().span))
fn instance_written(builder: Builder, method: String, of: lexer.Span) -> Found {
    match infer.type_at(builder.lowering.typed, of) {
        Some(at) => found_in(builder, answering_at(builder.lowering, method, substituted(builder.at, at)))
        None => Found { builder: builder, answered_by: None }
    }
}

/// The builder with the lowering `answered` leaves, and the instance it found.
// example: is_unfound(found_in(little_builder(""), Answered { lowering: little_lowering(""), answered_by: None }))
fn found_in(builder: Builder, answered: Answered) -> Found {
    Found { builder: builder { lowering: answered.lowering }, answered_by: answered.answered_by }
}

/// The shape of the variant `name` the module `module` offers, where it offers one.
// example: is_unshaped(offered_shape(shapes: no_shapes(), module: "lexer", name: "Span"))
fn offered_shape(shapes: Shapes, module: String, name: String) -> Option<Shape> {
    map.get(shapes.built_by, module + "." + name)
}

/// The shape of the record type `named`.
// example: record_shape(no_shapes(), "Box").class == ""
fn record_shape(shapes: Shapes, named: String) -> Shape {
    match map.get(shapes.records, named) {
        Some(constructor) => built_shape(shapes, constructor)
        None => no_shape()
    }
}

/// The method that builds a list out of an array.
// example: list_built().name == "of"
fn list_built() -> MethodRef {
    MethodRef { class: list_class(), name: "of", descriptor: MethodDescriptor { parameters: [buffer()], result: Some(list_descriptor()) } }
}

/// The method that pushes onto a list.
// example: list_pushed().name == "push"
fn list_pushed() -> MethodRef {
    MethodRef { class: list_class(), name: "push", descriptor: MethodDescriptor { parameters: [list_descriptor(), object()], result: Some(list_descriptor()) } }
}

/// The field that holds the slots of a list.
// example: list_slots().name == "slots"
fn list_slots() -> FieldRef {
    FieldRef { class: list_class(), name: "slots", of: buffer() }
}

/// The field that holds the length of a list.
// example: list_length().name == "length"
fn list_length() -> FieldRef {
    FieldRef { class: list_class(), name: "length", of: Integer }
}

/// What holds the slots of a list: an array of objects.
// example: descriptor_text(buffer()) == "[Ljava/lang/Object;"
fn buffer() -> Descriptor {
    Array(object())
}

/// What a use settles each type parameter of `function` on, read off its declared type and the
/// type at the use; a parameter the use does not settle stays itself.
// example: list.length(instantiation_of(function: no_function(), written_at: unify.Unit, used: unify.Unit).settled) == 0
fn instantiation_of(function: ast.FunctionDeclaration, written_at: unify.Type, used: unify.Type) -> Instantiation {
    found := settle(written_at: written_at, used: used, into: [])
    var settled = []
    for written in function.type_parameters {
        settled = list.push(settled, Settled { origin: written.name.span.start, at: or(bound_at(found, written.name.span.start), parameter_itself(written.name)), constrained: list.length(written.constraints) > 0 })
    }
    Instantiation { settled: settled }
}

/// `into`, with what each type parameter of `declared` stands for at `used`; the first wins.
// example: list.length(settle(written_at: unify.Unit, used: unify.Unit, into: [])) == 0
fn settle(written_at: unify.Type, used: unify.Type, into: List<Settled>) -> List<Settled> {
    match written_at {
        unify.Parameter(parameter) => bound_first(into, origin_of(parameter), used)
        unify.Named { name, arguments } => each_settled(mine: arguments, theirs: arguments_of(used), into: into)
        unify.Function { parameters, result } => settle(written_at: result, used: result_or_unit(used), into: each_settled(mine: parameters, theirs: parameters_or_none(used), into: into))
        _ => into
    }
}

/// `into`, with each of `mine` settled against the one at its place in `theirs`.
// example: list.length(each_settled(mine: [], theirs: [], into: [])) == 0
fn each_settled(mine: List<unify.Type>, theirs: List<unify.Type>, into: List<Settled>) -> List<Settled> {
    var settling = into
    var at = 0
    for one in mine {
        settling = match list.at(theirs, at) {
            Some(other) => settle(written_at: one, used: other, into: settling)
            None => settling
        }
        at += 1
    }
    settling
}

/// `into`, with `at` bound to `origin` where nothing is bound to it yet.
// example: list.length(bound_first([], 3, unify.int())) == 1
fn bound_first(into: List<Settled>, origin: Int, at: unify.Type) -> List<Settled> {
    match bound_at(into, origin) {
        Some(_) => into
        None => list.push(into, Settled { origin: origin, at: at, constrained: false })
    }
}

/// The arguments of `of`, where it is a named type.
// example: list.length(arguments_of(unify.list_of(unify.int()))) == 1
fn arguments_of(of: unify.Type) -> List<unify.Type> {
    match of {
        unify.Named { name, arguments } => arguments
        _ => []
    }
}

/// The name of a generic settled as `at` settles it: a part for each type parameter, which is
/// the whole type where a trait asks of the parameter, and only its head where none does.
// example: instantiation_names(whole(), "pick") == "pick"
fn instantiation_names(at: Instantiation, function: String) -> String {
    var named = function
    for settled in at.settled {
        named += "$" + named_at_type(settled)
    }
    named
}

/// The name of a generic settled on `at`, where `constrained` says which parameters a trait asks of.
// example: generic_names("pick", [unify.list_of(unify.int())], [[]]) == "pick$List"
// example: generic_names("pick", [unify.list_of(unify.int())], [["Eq"]]) == "pick$List$Int"
fn generic_names(function: String, at: List<unify.Type>, constrained: List<List<String>>) -> String {
    var named = function
    var position = 0
    for one in at {
        named = match list.at(constrained, position) {
            Some(traits) => named + "$" + named_at_type(Settled { origin: 0, at: one, constrained: list.length(traits) > 0 })
            None => named
        }
        position += 1
    }
    named
}

/// The part of a name `at` gives: the whole type where it is constrained, and its head otherwise.
// example: named_at_type(Settled { origin: 0, at: unify.Unit, constrained: false }) == "Unit"
fn named_at_type(settled: Settled) -> String {
    if settled.constrained {
        return wholly(settled.at)
    }
    head_of(settled.at)
}

/// The record fields `declaration` declares, and none where it declares no record.
// example: list.length(record_fields_of(declared.first_type("type Box = Box\n"))) == 0
fn record_fields_of(declaration: ast.TypeDeclaration) -> List<ast.RecordField> {
    match declaration.definition {
        ast.RecordType(fields) => fields
        _ => []
    }
}

/// The variants `declaration` declares, and none where it declares no variants.
// example: list.length(variants_of(declared.first_type("type Box = Box\n"))) == 1
fn variants_of(declaration: ast.TypeDeclaration) -> List<ast.Variant> {
    match declaration.definition {
        ast.Variants(variants) => variants
        _ => []
    }
}

/// Whether `declaration` declares variants.
// example: has_variants(declared.first_type("type Box = Box\n"))
fn has_variants(declaration: ast.TypeDeclaration) -> Bool {
    match declaration.definition {
        ast.Variants(_) => true
        _ => false
    }
}

/// Whether `declaration` declares a record.
// example: is_record(declared.first_type("type Box = { at: Int }\n"))
fn is_record(declaration: ast.TypeDeclaration) -> Bool {
    match declaration.definition {
        ast.RecordType(_) => true
        _ => false
    }
}

/// Variants: the one the value turns out to be, and the last one without a test.
// example: list.length(shown_by_variant(no_writing(), [declared.no_variant()]).instructions) == 2
fn shown_by_variant(writing: Writing, variants: List<ast.Variant>) -> Writing {
    end := labelled_writing(writing)
    var writes = end.writing
    last := list.length(variants) - 1
    var position = 0
    for variant in variants {
        writes = if position == last {
            one_variant_shown(writes, variant)
        } else {
            variant_tested(writes, variant, end.label)
        }
        position += 1
    }
    written_out(writes, Label(end.label))
}

/// One variant shown where the value turns out to be it, and a jump past the rest.
// example: list.length(variant_tested(no_writing(), declared.no_variant(), 0).instructions) == 8
fn variant_tested(writing: Writing, variant: ast.Variant, end: Int) -> Writing {
    next := labelled_writing(writing)
    tested := unless_it_is(next.writing, built_shape(writing.lowering.shapes, variant.name.text), next.label)
    each_written_out(one_variant_shown(tested, variant), [Jump(end), Label(next.label)])
}

/// `writing` with the next label taken, and the label.
// example: labelled_writing(no_writing()).label == 0
fn labelled_writing(writing: Writing) -> LabelledWriting {
    LabelledWriting { writing: writing { next_label: writing.next_label + 1 }, label: writing.next_label }
}

/// `writing` with a jump to `elsewhere` unless what slot 0 holds is the variant `shape` builds.
// example: list.length(unless_it_is(no_writing(), tagged_shape(), 3).instructions) == 5
fn unless_it_is(writing: Writing, shape: Shape, elsewhere: Int) -> Writing {
    tagged_one := tag_read(writing, shape.base, 0)
    each_written_out(tagged_one, [IntegerOf(or(shape.tag, 0)), CompareIntegers(Equal), JumpIfFalse(elsewhere)])
}

/// `writing` with the tag of what `slot` holds, which says which variant that value is.
// example: list.length(tag_read(no_writing(), "a/B", 1).instructions) == 2
fn tag_read(writing: Writing, base: String, slot: Int) -> Writing {
    each_written_out(writing, [Load { slot: slot, of: Reference(base) }, GetField(FieldRef { class: base, name: "tag", of: Integer })])
}

/// One variant: its name alone, its name and what it carries, or its name and its fields.
// example: list.length(one_variant_shown(no_writing(), declared.no_variant()).instructions) == 1
fn one_variant_shown(writing: Writing, variant: ast.Variant) -> Writing {
    named := variant.name.text
    held := variant_holds(writing, variant)
    match variant.payload {
        ast.NoPayload => written_out(writing, TextOf(named))
        ast.TuplePayload(_) => inside_brackets(writing, named, held)
        ast.RecordPayload(_) => inside_braces(writing, named, held)
    }
}

/// Every value one variant carries, in the order it carries them.
// example: list.length(variant_holds(no_writing(), declared.no_variant())) == 0
fn variant_holds(writing: Writing, variant: ast.Variant) -> List<Holds> {
    shape := built_shape(writing.lowering.shapes, variant.name.text)
    match variant.payload {
        ast.NoPayload => []
        ast.TuplePayload(written) => held_values(shape, positions_written(written))
        ast.RecordPayload(fields) => held_values(shape, fields_written(fields))
    }
}

/// Each field, as the name it is written with and the type it is written as.
// example: list.length(fields_written([])) == 0
fn fields_written(fields: List<ast.RecordField>) -> List<WrittenValue> {
    var written = []
    for field in fields {
        written = list.push(written, WrittenValue { named: Some(field.name.text), written: field.type_ref })
    }
    written
}

/// Each type a tuple variant carries, with no name.
// example: list.length(positions_written([])) == 0
fn positions_written(written: List<ast.TypeRef>) -> List<WrittenValue> {
    var values = []
    for type_ref in written {
        values = list.push(values, WrittenValue { named: None, written: type_ref })
    }
    values
}

/// The values `shape` holds, paired with what the source wrote each as; a `()` is left out.
// example: list.length(held_values(no_shape(), [])) == 0
fn held_values(shape: Shape, written: List<WrittenValue>) -> List<Holds> {
    var held = []
    var position = 0
    for carried in shape.carries {
        held = match list.at(written, position) {
            Some(value) => held_value(held, shape, carried, value)
            None => held
        }
        position += 1
    }
    held
}

/// `held`, with one value that is carried by something.
// example: list.length(held_value([], no_shape(), Carried { name: "x", of: None }, WrittenValue { named: None, written: unit_written() })) == 0
fn held_value(held: List<Holds>, shape: Shape, carried: Carried, value: WrittenValue) -> List<Holds> {
    match carried.of {
        Some(of) => list.push(held, Holds { shape: shape, carried: carried, of: of, named: value.named, written: value.written })
        None => held
    }
}

/// `User { id: 1, name: ada }`: the name, then each field as the source names it.
// example: list.length(inside_braces(no_writing(), "Box", []).instructions) == 3
fn inside_braces(writing: Writing, named: String, held: List<Holds>) -> Writing {
    var writes = written_out(writing, TextOf(named + " {"))
    var position = 0
    for holds in held {
        opening := if position == 0 {
            " "
        } else {
            ", "
        }
        writes = showing(each_written_out(writes, [TextOf(opening + or(holds.named, "") + ": "), Concat]), holds)
        position += 1
    }
    closing := if list.length(held) == 0 {
        "}"
    } else {
        " }"
    }
    each_written_out(writes, [TextOf(closing), Concat])
}

/// `Failed(late)`: the name, then each value it carries in the order it carries them.
// example: list.length(inside_brackets(no_writing(), "Box", []).instructions) == 3
fn inside_brackets(writing: Writing, named: String, held: List<Holds>) -> Writing {
    var writes = written_out(writing, TextOf(named + "("))
    var position = 0
    for holds in held {
        if position > 0 {
            writes = each_written_out(writes, [TextOf(", "), Concat])
        }
        writes = showing(writes, holds)
        position += 1
    }
    each_written_out(writes, [TextOf(")"), Concat])
}

/// One value shown by the `Show` of its own type and joined to the text below it.
// example: list.length(showing(no_writing(), Holds { shape: no_shape(), carried: Carried { name: "x", of: Some(Long) }, of: Long, named: None, written: unit_written() }).instructions) == 4
fn showing(writing: Writing, holds: Holds) -> Writing {
    written_out(derived_through(value_read(writing, holds, 0), "Show", holds), Concat)
}

/// `writing` with one value read off what `slot` holds, which a variant is cast to first.
// example: list.length(value_read(no_writing(), Holds { shape: no_shape(), carried: Carried { name: "x", of: Some(Long) }, of: Long, named: None, written: unit_written() }, 0).instructions) == 2
fn value_read(writing: Writing, holds: Holds, slot: Int) -> Writing {
    shape := holds.shape
    loaded := written_out(writing, Load { slot: slot, of: Reference(shape.base) })
    cast := if shape.class != shape.base {
        written_out(loaded, Cast(shape.class))
    } else {
        loaded
    }
    written_out(cast, GetField(FieldRef { class: shape.class, name: holds.carried.name, of: holds.of }))
}

/// `writing` with the instance of `of` at the type one value was written as called over what is
/// on the stack; a type the JVM holds is what its instance amounts to, written out.
// example: list.length(derived_through(no_writing(), "Eq", Holds { shape: no_shape(), carried: Carried { name: "x", of: Some(Long) }, of: Long, named: None, written: unit_written() }).instructions) == 1
fn derived_through(writing: Writing, of: String, holds: Holds) -> Writing {
    answered := answering_at(writing.lowering, method_of(writing.lowering.library, of), type_written_as(holds.written))
    answering_writing := writing { lowering: answered.lowering }
    match answered.answered_by {
        Some(answerer) => written_out(answering_writing, instance_called(answerer))
        None => each_written_out(answering_writing, derived_supplied(of, holds.of))
    }
}

/// The method a use of a trait's method at `at` reaches, where some instance answers it.
///
/// `Bool`, `Int`, and `String` answer inside the prelude with instructions rather than a call. A
/// type another module declares is answered by that module, which is asked for the method.
// example: is_unanswered(answering_at(little_lowering(""), "is_equal", unify.int()))
fn answering_at(lowering: Lowering, method: String, at: unify.Type) -> Answered {
    match at {
        unify.Named { name, arguments } => answering_named(lowering, method, at, Home { module: name, name: name }, arguments)
        _ => Answered { lowering: lowering, answered_by: None }
    }
}

/// The instance of `method` at the named type `at`, whose name `written` holds twice.
// example: is_unanswered(answering_named(little_lowering(""), "is_equal", unify.int(), Home { module: "Int", name: "Int" }, []))
fn answering_named(lowering: Lowering, method: String, at: unify.Type, written: Home, arguments: List<unify.Type>) -> Answered {
    name := written.name
    if lowering.module == "prelude" && (name == "Bool" || name == "Int" || name == "String") {
        return Answered { lowering: lowering, answered_by: None }
    }
    match declaring_module(lowering, name) {
        Some(home) => answered_elsewhere(lowering, Asking { method: method, at: at, home: home, arguments: arguments })
        None => written_here(lowering: lowering, method: method, named: name, arguments: arguments)
    }
}

/// The module that declares the type `name`, and the name it declares it by, where that is not this one.
// example: or(declaring_module(little_lowering(""), "List"), Home { module: "", name: "" }).module == "prelude"
fn declaring_module(lowering: Lowering, name: String) -> Option<Home> {
    if name == "List" {
        if lowering.module != "prelude" {
            return Some(Home { module: "prelude", name: "List" })
        }
        return None
    }
    split_at_dot(name)
}

/// The instance another module writes for the type `asking.at`, which that module is asked for.
// example: is_unanswered(answered_elsewhere(little_lowering(""), Asking { method: "is_equal", at: unify.Unit, home: Home { module: "lexer", name: "Span" }, arguments: [] })) == false
fn answered_elsewhere(lowering: Lowering, asking: Asking) -> Answered {
    of := trait_of(lowering.library, asking.method)
    answerer := of + "$" + asking.home.name + "$" + asking.method
    asked := if list.length(asking.arguments) == 0 {
        AskedOf { lowering: lowering, written: [] }
    } else {
        ask(lowering: lowering, module: asking.home.module, function: answerer, settled: asking.arguments)
    }
    signature := written_as(lowering, instance_signature(library: lowering.library, of: of, method: asking.method, at: asking.at))
    reaching := Reaching { named: names_wholly(answerer, asked.written), signature: signature }
    Answered { lowering: asked.lowering, answered_by: Some(Instance { class: module_named(asked.lowering.shapes.classes, asking.home.module), reaching: reaching }) }
}

/// The type the prelude gives the method `method` of the trait `of` at `at`.
// example: unify.text_of(instance_signature(library: little_library(), of: "Eq", method: "is_equal", at: unify.int())) == "(Int, Int) -> Bool"
fn instance_signature(library: Library, of: String, method: String, at: unify.Type) -> unify.Type {
    or(declared.method_at(library.prelude.declared, of, method, at), unify.Unit)
}

/// `settled`, noted as asked of `module` for `function`, and as that module writes each type.
// example: list.length(ask(lowering: little_lowering(""), module: "lexer", function: "pick", settled: [unify.int()]).lowering.asks.of) == 1
fn ask(lowering: Lowering, module: String, function: String, settled: List<unify.Type>) -> AskedOf {
    written := each_written_by(lowering.shapes, module, settled)
    foreign := foreign_written_by(lowering.shapes, module, settled)
    asks := noted(lowering.asks, Specialisation { module: module, function: function, settled: written, foreign: foreign })
    AskedOf { lowering: lowering { asks: asks }, written: written }
}

/// `asked` with `one` added, where it does not hold `one` already.
// example: list.length(noted(Asked { of: [little_ask()] }, little_ask()).of) == 1
fn noted(asked: Asked, one: Specialisation) -> Asked {
    if list.has_value(asked.of, one) {
        return asked
    }
    Asked { of: list.push(asked.of, one) }
}

/// The instance this module writes of `method` for the type `named`, where it writes one.
// example: is_unanswered(written_here(lowering: little_lowering(""), method: "is_equal", named: "Box", arguments: []))
fn written_here(lowering: Lowering, method: String, named: String, arguments: List<unify.Type>) -> Answered {
    match map.get(lowering.answers, method + " " + named) {
        Some(answers) => answered_here(lowering, answers, arguments)
        None => Answered { lowering: lowering, answered_by: None }
    }
}

/// The instance `answers` writes, reached in this module's own class.
// example: answered_here(little_lowering(""), Answers { method: "f", for_type: "Box", arguments: [], declared: infer.no_name().span }, []).lowering.module == "main"
fn answered_here(lowering: Lowering, answers: Answers, arguments: List<unify.Type>) -> Answered {
    reached := instance_method(lowering, answers, arguments)
    Answered { lowering: reached.lowering, answered_by: Some(Instance { class: lowering.shapes.class, reaching: reached.reaching }) }
}

/// The method of the instance `answers` names, owed settled on `arguments` where it is generic.
// example: instance_method(little_lowering(""), Answers { method: "f", for_type: "Box", arguments: [], declared: infer.no_name().span }, []).reaching.named == ""
fn instance_method(lowering: Lowering, answers: Answers, arguments: List<unify.Type>) -> Reachable {
    match generic_source(lowering, answers.declared) {
        Some(function) => instance_settled(lowering, answers, arguments, function)
        None => Reachable { lowering: lowering, reaching: plainly(lowering, answers.declared) }
    }
}

/// The generic instance method `function`, owed with its parameters settled on `arguments`.
// example: instance_settled(little_lowering(""), Answers { method: "f", for_type: "Box", arguments: [], declared: infer.no_name().span }, [unify.int()], no_function()).reaching.named == "$Int"
fn instance_settled(lowering: Lowering, answers: Answers, arguments: List<unify.Type>, function: ast.FunctionDeclaration) -> Reachable {
    settled := asked_for(function, settled_by(function, answers, arguments))
    named := names_wholly(named_at(lowering, answers.declared), arguments)
    reaching := Reaching { named: named, signature: signature_of(lowering, answers.declared, settled) }
    Reachable { lowering: owe(lowering, answers.declared, named, settled), reaching: reaching }
}

/// The function declared at `declared` when it is written in the source and is generic.
// example: is_plain(generic_source(little_lowering(""), infer.no_name().span))
fn generic_source(lowering: Lowering, written_at: lexer.Span) -> Option<ast.FunctionDeclaration> {
    match map.get(lowering.declared, infer.span_key(written_at)) {
        Some(found) => generic_body(found.body)
        None => None
    }
}

/// The function `written` holds, where it is a source function with type parameters.
// example: is_plain(generic_body(FromJava(no_extern())))
fn generic_body(written: Written) -> Option<ast.FunctionDeclaration> {
    match written {
        Source(function) => generic_function(function)
        _ => None
    }
}

/// `function`, where it has type parameters.
// example: is_plain(generic_function(no_function()))
fn generic_function(function: ast.FunctionDeclaration) -> Option<ast.FunctionDeclaration> {
    if list.length(function.type_parameters) == 0 {
        return None
    }
    Some(function)
}

/// The method declared at `declared`, reached as it is written.
// example: plainly(little_lowering(""), infer.no_name().span).named == ""
fn plainly(lowering: Lowering, written_at: lexer.Span) -> Reaching {
    Reaching { named: named_at(lowering, written_at), signature: signature_of(lowering, written_at, whole()) }
}

/// `lowering` owing the method declared at `declared` under `named`, settled as `at` settles it.
// example: list.length(owe(little_lowering(""), infer.no_name().span, "f", whole()).owed) == 1
fn owe(lowering: Lowering, written_at: lexer.Span, named: String, at: Instantiation) -> Lowering {
    lowering { owed: list.push(lowering.owed, Owed { declared: written_at, named: named, at: at }) }
}

/// The name the method declared at `declared` is written under.
// example: named_at(little_lowering("fn f() -> Int {\n    1\n}\n"), lexer.Span { start: 3, length: 1 }) == "f"
fn named_at(lowering: Lowering, written_at: lexer.Span) -> String {
    match map.get(lowering.declared, infer.span_key(written_at)) {
        Some(found) => found.named
        None => ""
    }
}

/// The signature `declared` has where it is written with its type parameters as they are.
// example: list.length(written_as(little_lowering(""), unify.Function { parameters: [unify.int()], result: unify.Unit }).parameters) == 1
fn written_as(lowering: Lowering, written_at: unify.Type) -> Signature {
    signature_over(lowering.shapes, written_at, whole())
}

/// The signature of the function declared at `declared`, settled as `at` settles it.
// example: list.length(signature_of(little_lowering("fn f(x: Int) -> Int {\n    x\n}\n"), lexer.Span { start: 3, length: 1 }, whole()).parameters) == 1
fn signature_of(lowering: Lowering, written_at: lexer.Span, at: Instantiation) -> Signature {
    signature_over(lowering.shapes, used_as(lowering, written_at), at)
}

/// What carries each parameter and the result of the function type `declared`, settled by `at`.
// example: is_nothing(signature_over(no_shapes(), unify.Unit, whole()).result)
fn signature_over(shapes: Shapes, written_at: unify.Type, at: Instantiation) -> Signature {
    match written_at {
        unify.Function { parameters, result } => Signature { parameters: each_carried(shapes, parameters, at), result: carried_type(shapes, substituted(at, result)) }
        _ => Signature { parameters: [], result: None }
    }
}

/// What carries each of `types`, settled by `at`.
// example: held_text(or(list.at(each_carried(no_shapes(), [unify.int()], whole()), 0), None)) == "J"
fn each_carried(shapes: Shapes, several: List<unify.Type>, at: Instantiation) -> List<Option<Descriptor>> {
    var carried = []
    for one in several {
        carried = list.push(carried, carried_type(shapes, substituted(at, one)))
    }
    carried
}

/// The call of the method `instance` reaches.
// example: method_named(instance_called(Instance { class: "main", reaching: Reaching { named: "f", signature: Signature { parameters: [], result: None } } })) == "f"
fn instance_called(answerer: Instance) -> Instruction {
    InvokeStatic(MethodRef { class: answerer.class, name: answerer.reaching.named, descriptor: descriptor_of(answerer.reaching.signature) })
}

/// The descriptor of a method of `signature`, which leaves out each parameter nothing carries.
// example: method_descriptor_text(descriptor_of(Signature { parameters: [None, Some(Long)], result: None })) == "(J)V"
fn descriptor_of(signature: Signature) -> MethodDescriptor {
    var taken = []
    for parameter in signature.parameters {
        taken = match parameter {
            Some(of) => list.push(taken, of)
            None => taken
        }
    }
    MethodDescriptor { parameters: taken, result: signature.result }
}

/// What each type parameter of `function` is settled on, read off the arguments `answers` writes.
///
/// A parameter the instance's type is written with takes the argument at its place; one it is
/// not stays itself.
// example: settled_by(no_function(), Answers { method: "", for_type: "", arguments: [], declared: infer.no_name().span }, []) == []
fn settled_by(function: ast.FunctionDeclaration, answers: Answers, at: List<unify.Type>) -> List<unify.Type> {
    var settled = []
    for written_at in function.type_parameters {
        settled = list.push(settled, settling_of(written_at.name, answers, at))
    }
    settled
}

/// What the type parameter `declared` is settled on.
// example: settling_of(infer.no_name(), Answers { method: "", for_type: "", arguments: [""], declared: infer.no_name().span }, [unify.int()]) == unify.int()
fn settling_of(written_at: ast.Name, answers: Answers, at: List<unify.Type>) -> unify.Type {
    itself := parameter_itself(written_at)
    match list.index_of(answers.arguments, written_at.text) {
        Some(position) => or(list.at(at, position), itself)
        None => itself
    }
}

/// The one method the trait `of` declares, where the prelude declares it.
// example: method_of(little_library(), "Eq") == "is_equal"
fn method_of(library: Library, of: String) -> String {
    for declaration in library.traits {
        if declaration.name.text == of && list.length(declaration.methods) == 1 {
            return or(list.at(declaration.methods, 0), no_signature()).name.text
        }
    }
    ""
}

/// The trait of the prelude that declares the method `method`.
// example: trait_of(little_library(), "from_literal") == "IntegerLiteral"
fn trait_of(library: Library, method: String) -> String {
    for declaration in library.traits {
        for signature in declaration.methods {
            if signature.name.text == method {
                return declaration.name.text
            }
        }
    }
    ""
}

/// A signature of no name, which nothing declares.
// example: no_signature().name.text == ""
fn no_signature() -> ast.Signature {
    ast.Signature { name: infer.no_name(), parameters: [], result: None, span: infer.no_name().span }
}

/// `of`, with each type named as the module `by` names it.
// example: unify.text_of(as_written_by(main_shapes(), "lexer", unify.Named { name: "Box", arguments: [] })) == "main.Box"
fn as_written_by(shapes: Shapes, by: String, of: unify.Type) -> unify.Type {
    match of {
        unify.Named { name, arguments } => unify.Named { name: written_by(shapes: shapes, by: by, named: name), arguments: each_written_by(shapes, by, arguments) }
        _ => of
    }
}

/// Each of `types`, with each type named as the module `by` names it.
// example: list.length(each_written_by(no_shapes(), "lexer", [unify.int()])) == 1
fn each_written_by(shapes: Shapes, by: String, several: List<unify.Type>) -> List<unify.Type> {
    var written = []
    for one in several {
        written = list.push(written, as_written_by(shapes, by, one))
    }
    written
}

/// Each Java class a type of `types` names, as the module `by` names the type.
// example: list.length(foreign_written_by(no_shapes(), "lexer", [unify.int()])) == 0
fn foreign_written_by(shapes: Shapes, by: String, several: List<unify.Type>) -> List<Foreign> {
    var found = []
    for one in several {
        found = match one {
            unify.Named { name, arguments } => concatenated(first: foreign_named(shapes: shapes, by: by, name: name, found: found), second: foreign_written_by(shapes, by, arguments))
            _ => found
        }
    }
    found
}

/// `found`, with the Java class the type `name` stands for, where one does.
// example: list.length(foreign_named(shapes: no_shapes(), by: "lexer", name: "Int", found: [])) == 0
fn foreign_named(shapes: Shapes, by: String, name: String, found: List<Foreign>) -> List<Foreign> {
    match map.get(shapes.foreign, name) {
        Some(reached) => list.push(found, Foreign { name: written_by(shapes: shapes, by: by, named: name), reached: reached })
        None => found
    }
}

/// The name the module `by` gives the type this module calls `named`.
// example: written_by(shapes: no_shapes(), by: "lexer", named: "lexer.Span") == "Span"
// example: written_by(shapes: no_shapes(), by: "main", named: "lexer.Span") == "lexer.Span"
fn written_by(shapes: Shapes, by: String, named: String) -> String {
    match split_at_dot(named) {
        Some(home) => if home.module == by {
            home.name
        } else {
            named
        }
        None => if set.has_value(shapes.own, named) {
            shapes.module + "." + named
        } else {
            named
        }
    }
}

/// Nothing settled, which is how a body that is not generic is lowered.
// example: list.length(whole().settled) == 0
fn whole() -> Instantiation {
    Instantiation { settled: [] }
}

/// What each type parameter of `function` is settled on, taken in order from `settled`.
// example: list.length(asked_for(no_function(), []).settled) == 0
fn asked_for(function: ast.FunctionDeclaration, settled: List<unify.Type>) -> Instantiation {
    var over = []
    var position = 0
    for written in function.type_parameters {
        over = list.push(over, Settled { origin: written.name.span.start, at: or(list.at(settled, position), parameter_itself(written.name)), constrained: list.length(written.constraints) > 0 })
        position += 1
    }
    Instantiation { settled: over }
}

/// The type parameter `written` names, standing for itself.
// example: unify.text_of(parameter_itself(ast.Name { text: "T", span: infer.no_name().span })) == "T"
fn parameter_itself(written: ast.Name) -> unify.Type {
    unify.Parameter(unify.written_parameter(written.text, written.span.start))
}

/// `of`, with each type parameter `at` settles replaced by what it is settled on.
// example: substituted(whole(), unify.int()) == unify.int()
fn substituted(at: Instantiation, of: unify.Type) -> unify.Type {
    if list.length(at.settled) == 0 {
        return of
    }
    match of {
        unify.Parameter(parameter) => or(bound_at(at.settled, origin_of(parameter)), of)
        unify.Named { name, arguments } => unify.Named { name: name, arguments: each_substituted(at, arguments) }
        unify.Function { parameters, result } => unify.Function { parameters: each_substituted(at, parameters), result: substituted(at, result) }
        _ => of
    }
}

/// Each of `types`, with each type parameter `at` settles replaced.
// example: list.length(each_substituted(whole(), [unify.int()])) == 1
fn each_substituted(at: Instantiation, several: List<unify.Type>) -> List<unify.Type> {
    var replaced = []
    for one in several {
        replaced = list.push(replaced, substituted(at, one))
    }
    replaced
}

/// Where the type parameter `parameter` is written, and -1 for one of the prelude's own.
// example: origin_of(unify.written_parameter("T", 4)) == 4
fn origin_of(parameter: unify.TypeParameter) -> Int {
    match parameter.origin {
        unify.FromThePrelude => -1
        unify.WrittenAt(start) => start
    }
}

/// What the type parameter written at `origin` is settled on, where `settled` settles it.
// example: is_unsettled(bound_at([], 3))
fn bound_at(settled: List<Settled>, origin: Int) -> Option<unify.Type> {
    for one in settled {
        if one.origin == origin {
            return Some(one.at)
        }
    }
    None
}

/// `named`, with the whole of each of `at` after it.
// example: names_wholly("Eq$List$is_equal", [unify.int()]) == "Eq$List$is_equal$Int"
fn names_wholly(named: String, at: List<unify.Type>) -> String {
    var written = named
    for one in at {
        written += "$" + wholly(one)
    }
    written
}

/// The whole of `at` as part of a name: its head, then each argument's whole.
// example: wholly(unify.list_of(unify.list_of(unify.int()))) == "List$List$Int"
fn wholly(at: unify.Type) -> String {
    match at {
        unify.Named { name, arguments } => wholly_named(name, arguments)
        _ => head_of(at)
    }
}

/// The whole of the named type `name` over `arguments`.
// example: wholly_named("lexer.Span", []) == "lexer$Span"
fn wholly_named(name: String, arguments: List<unify.Type>) -> String {
    var written = dots_replaced(named: name, replacement: "$")
    for argument in arguments {
        written += "$" + wholly(argument)
    }
    written
}

/// The head of `at` as part of a name: its own name, `Unit` for `()`, and `Any` for the rest.
// example: head_of(unify.Unit) == "Unit"
// example: head_of(unify.Var(1)) == "Any"
fn head_of(at: unify.Type) -> String {
    match at {
        unify.Named { name, arguments } => dots_replaced(named: name, replacement: "$")
        unify.Unit => "Unit"
        _ => "Any"
    }
}

/// `writing` with `instruction` after what it holds.
// example: list.length(written_out(no_writing(), Copy).instructions) == 1
fn written_out(writing: Writing, instruction: Instruction) -> Writing {
    writing { instructions: list.push(writing.instructions, instruction) }
}

/// `writing` with each of `instructions` after what it holds.
// example: list.length(each_written_out(no_writing(), [Copy, Copy]).instructions) == 2
fn each_written_out(writing: Writing, instructions: List<Instruction>) -> Writing {
    writing { instructions: concatenated(first: writing.instructions, second: instructions) }
}

/// The type one value was written as, with every argument it is written with.
// example: unify.text_of(type_written_as(unit_written())) == "()"
fn type_written_as(written: ast.TypeRef) -> unify.Type {
    match written.kind {
        ast.NamedType { path, arguments } => unify.Named { name: path_text(path), arguments: each_type_written_as(arguments) }
        ast.UnitType => unify.Unit
    }
}

/// Each of `written`, as the type it is written as.
// example: list.length(each_type_written_as([])) == 0
fn each_type_written_as(written: List<ast.TypeRef>) -> List<unify.Type> {
    var several = []
    for one in written {
        several = list.push(several, type_written_as(one))
    }
    several
}

/// `path` as it is written, with its module in front where it names one.
// example: path_text(ast.Path { module: Some(ast.Name { text: "a", span: infer.no_name().span }), name: ast.Name { text: "B", span: infer.no_name().span } }) == "a.B"
fn path_text(path: ast.Path) -> String {
    match path.module {
        Some(module) => module.text + "." + path.name.text
        None => path.name.text
    }
}

/// What the prelude's own instance of `of` amounts to, over a value the JVM holds as `held`.
// example: list.length(derived_supplied("Hash", Long)) == 0
fn derived_supplied(of: String, held: Descriptor) -> List<Instruction> {
    if of == "Eq" {
        return compared(Some(held), Equal)
    }
    if of == "Ord" {
        return compared(Some(held), Less)
    }
    if of == "Hash" {
        return hashed_as(held)
    }
    shown_as(held)
}

/// The instructions that compare two values `held` holds, as `how` asks.
// example: list.length(compared(Some(text_descriptor()), Less)) == 3
// example: list.length(compared(None, Equal)) == 1
fn compared(held: Option<Descriptor>, how: Comparison) -> List<Instruction> {
    match held {
        Some(Long) => [CompareLongs(how)]
        Some(Boolean) => [CompareIntegers(how)]
        Some(Integer) => [CompareIntegers(how)]
        Some(_) => by_value(how)
        None => [BooleanOf(how == Equal)]
    }
}

/// The instructions that compare two strings, as `how` asks.
// example: list.length(by_value(NotEqual)) == 2
fn by_value(how: Comparison) -> List<Instruction> {
    equals := InvokeVirtual(MethodRef { class: string_class(), name: "equals", descriptor: MethodDescriptor { parameters: [object()], result: Some(Boolean) } })
    match how {
        Equal => [equals]
        NotEqual => [equals, Not]
        _ => [InvokeVirtual(MethodRef { class: string_class(), name: "compareTo", descriptor: MethodDescriptor { parameters: [text_descriptor()], result: Some(Integer) } }), IntegerOf(0), CompareIntegers(how)]
    }
}

/// The instructions that turn a value `held` holds into its hash, a `long`.
// example: list.length(hashed_as(Long)) == 0
// example: list.length(hashed_as(text_descriptor())) == 2
fn hashed_as(held: Descriptor) -> List<Instruction> {
    match held {
        Long => []
        Reference(_) => [InvokeVirtual(MethodRef { class: string_class(), name: "hashCode", descriptor: MethodDescriptor { parameters: [], result: Some(Integer) } }), Widen]
        _ => [Widen]
    }
}

/// The instructions that turn a value `held` holds into its text.
// example: list.length(shown_as(text_descriptor())) == 0
fn shown_as(held: Descriptor) -> List<Instruction> {
    match held {
        Long => [rendered("java/lang/Long", Long)]
        Boolean => [rendered("java/lang/Boolean", Boolean)]
        _ => []
    }
}

/// The call of `toString` on the class `class`, which takes a value `of` holds.
// example: method_named(rendered("java/lang/Long", Long)) == "toString"
fn rendered(class: String, of: Descriptor) -> Instruction {
    InvokeStatic(MethodRef { class: class, name: "toString", descriptor: MethodDescriptor { parameters: [of], result: Some(text_descriptor()) } })
}

/// What an `extern` declaration runs: the member it names, and the mapping it asks for.
// example: list.length(extern_body(little_lowering(""), no_extern(), Signature { parameters: [], result: None }).guards) == 0
fn extern_body(lowering: Lowering, declaration: ast.ExternDeclaration, signature: Signature) -> Body {
    shapes := lowering.shapes
    written_at := used_as(lowering, declaration.name.span)
    answer := answer_of(shapes, written_at, declaration.gives)
    arguments := arguments_of_extern(signature, declaration)
    held := arguments_width(arguments)
    var instructions = list.push(fitting(arguments), Label(0))
    instructions = concatenated(first: instructions, second: member_reached(declaration.reaches, arguments, answer.member, called_by(shapes, received_by(written_at))))
    instructions = list.push(instructions, Label(1))
    if !is_held_alike(one: answer.member, other: answer.widened) {
        instructions = list.push(instructions, Widen)
    }
    instructions = concatenated(first: instructions, second: given_back(answer, shapes, held))
    if has_narrowed(arguments) {
        instructions = concatenated(first: list.push(instructions, Label(4)), second: none_of(answer, shapes, held))
    }
    if answer.guarded {
        instructions = concatenated(first: list.push(instructions, Label(2)), second: caught(shapes, held))
    }
    Body { instructions: instructions, locals: answer_locals(answer.widened), guards: guards_of(answer) }
}

/// The type inference gave what is written at `written`.
// example: used_as(little_lowering(""), infer.no_name().span) == unify.Unit
fn used_as(lowering: Lowering, written: lexer.Span) -> unify.Type {
    or(infer.type_at(lowering.typed, written), unify.Unit)
}

/// How the Java class the type `of` stands for is called, and as a class where it is none.
// example: called_by(no_shapes(), unify.int()) == ThroughItsClass
fn called_by(shapes: Shapes, of: unify.Type) -> CalledAs {
    match of {
        unify.Named { name, arguments } => foreign_called(map.get(shapes.foreign, name))
        _ => ThroughItsClass
    }
}

/// How `found` is called, and as a class where there is none.
// example: foreign_called(None) == ThroughItsClass
fn foreign_called(found: Option<JavaClass>) -> CalledAs {
    match found {
        Some(reached) => reached.called
        None => ThroughItsClass
    }
}

/// The slots past the parameters an extern body needs: one, or two for a whole number.
// example: answer_locals(Some(Long)) == 2
// example: answer_locals(None) == 1
fn answer_locals(widened: Option<Descriptor>) -> Int {
    match widened {
        Some(of) => width(of)
        None => 1
    }
}

/// Whether two answers are held alike, which nothing is alike to but nothing.
// example: is_held_alike(one: None, other: None)
// example: !is_held_alike(one: Some(Integer), other: Some(Long))
fn is_held_alike(one: Option<Descriptor>, other: Option<Descriptor>) -> Bool {
    held_text(one) == held_text(other)
}

/// What a value `held` holds is written as in a descriptor, and `V` for nothing.
// example: held_text(Some(Long)) == "J"
// example: held_text(None) == "V"
fn held_text(held: Option<Descriptor>) -> String {
    match held {
        Some(of) => descriptor_text(of)
        None => "V"
    }
}

/// `of` as a class file writes it.
// example: descriptor_text(Array(Integer)) == "[I"
fn descriptor_text(of: Descriptor) -> String {
    match of {
        Long => "J"
        Boolean => "Z"
        Integer => "I"
        Character => "C"
        Reference(class) => "L" + class + ";"
        Array(held) => "[" + descriptor_text(held)
    }
}

/// The arguments an extern reaches its member with: what each arrives as, and how it crosses.
// example: list.length(arguments_of_extern(Signature { parameters: [Some(Long), None], result: None }, no_extern())) == 0
fn arguments_of_extern(signature: Signature, declaration: ast.ExternDeclaration) -> List<Argument> {
    var arriving = []
    for parameter in signature.parameters {
        arriving = match parameter {
            Some(of) => list.push(arriving, of)
            None => arriving
        }
    }
    var arguments = []
    var position = 0
    var slot = 0
    for of in arriving {
        arguments = match list.at(declaration.parameters, position) {
            Some(parameter) => list.push(arguments, Argument { slot: slot, arrives: of, crossing: crossing_of(of, parameter.takes) })
            None => arguments
        }
        slot += width(of)
        position += 1
    }
    arguments
}

/// How an argument that arrives as `of` crosses to the member, which the declaration writes.
// example: crossing_of(list_descriptor(), ast.TakesAsDeclared) == Listed
// example: crossing_of(Long, ast.TakesInt) == Narrowed
fn crossing_of(of: Descriptor, takes: ast.Takes) -> Crossing {
    match takes {
        ast.TakesAsDeclared => if of == list_descriptor() {
            Listed
        } else {
            AsItIs
        }
        ast.TakesInt => Narrowed
    }
}

/// Whether any argument is narrowed, which is what a range is read for.
// example: has_narrowed([Argument { slot: 0, arrives: Long, crossing: Narrowed }])
fn has_narrowed(arguments: List<Argument>) -> Bool {
    for argument in arguments {
        if argument.crossing == Narrowed {
            return true
        }
    }
    false
}

/// The first slot no argument takes, which is where the body holds what it needs to.
// example: arguments_width([Argument { slot: 0, arrives: Long, crossing: Narrowed }]) == 2
fn arguments_width(arguments: List<Argument>) -> Int {
    var slots = 0
    for argument in arguments {
        slots += width(argument.arrives)
    }
    slots
}

/// How many slots a value `of` holds takes: two for a `long`, and one for anything else.
// example: width(Long) == 2
// example: width(Integer) == 1
fn width(of: Descriptor) -> Int {
    match of {
        Long => 2
        _ => 1
    }
}

/// Every narrowed argument read against the `int` range, which a `None` answers outside it.
// example: list.length(fitting([Argument { slot: 0, arrives: Long, crossing: Narrowed }])) == 8
fn fitting(arguments: List<Argument>) -> List<Instruction> {
    var instructions = []
    for argument in arguments {
        if argument.crossing == Narrowed {
            instructions = concatenated(first: instructions, second: within_bound(slot: argument.slot, bound: -2147483648, how: GreaterOrEqual))
            instructions = concatenated(first: instructions, second: within_bound(slot: argument.slot, bound: 2147483647, how: LessOrEqual))
        }
    }
    instructions
}

/// The whole number in `slot` read against `bound`, which jumps to the `None` outside it.
// example: list.length(within_bound(slot: 0, bound: 1, how: Less)) == 4
fn within_bound(slot: Int, bound: Int, how: Comparison) -> List<Instruction> {
    [Load { slot: slot, of: Long }, LongOf(bound), CompareLongs(how), JumpIfFalse(4)]
}

/// What the member gives back, and what the declaration wraps it in, read off the result.
// example: answer_of(no_shapes(), unify.Unit, ast.GivesAsDeclared).guarded == false
fn answer_of(shapes: Shapes, written_at: unify.Type, gives: ast.Gives) -> Answer {
    result := result_or_unit(written_at)
    guarded := is_wrapped_in("Result", result)
    inside_result := peeled("Result", result)
    widened := carried_type(shapes, peeled("Option", inside_result))
    Answer { member: reached_for(widened, gives), widened: widened, optional: is_wrapped_in("Option", inside_result), guarded: guarded }
}

/// What holds a value of the type `of`: nothing for `()`, and an object for what is not named.
// example: descriptor_text(or(carried_type(no_shapes(), unify.int()), Character)) == "J"
// example: is_nothing(carried_type(no_shapes(), unify.Unit))
fn carried_type(shapes: Shapes, of: unify.Type) -> Option<Descriptor> {
    match of {
        unify.Named { name, arguments } => Some(named_descriptor(shapes, name))
        unify.Unit => None
        _ => Some(object())
    }
}

/// What holds a value of the type called `named`.
// example: descriptor_text(named_descriptor(no_shapes(), "String")) == "Ljava/lang/String;"
// example: descriptor_text(named_descriptor(main_shapes(), "Box")) == "Lmain/Box;"
fn named_descriptor(shapes: Shapes, named: String) -> Descriptor {
    match map.get(shapes.foreign, named) {
        Some(reached) => Reference(reached.class)
        None => plain_descriptor(shapes, named)
    }
}

/// What holds a value of the type `named`, where no Java class stands for it.
// example: descriptor_text(plain_descriptor(no_shapes(), "Bool")) == "Z"
fn plain_descriptor(shapes: Shapes, named: String) -> Descriptor {
    if named == "Int" {
        return Long
    }
    if named == "Bool" {
        return Boolean
    }
    if named == "String" {
        return text_descriptor()
    }
    if named == "List" {
        return list_descriptor()
    }
    if named == "Process" {
        return handle_descriptor()
    }
    if set.has_value(shapes.prelude_types, named) {
        return Reference("lumen/" + named)
    }
    Reference(declared_class(shapes, named))
}

/// What holds a handle.
// example: descriptor_text(handle_descriptor()) == "Llumen/Process;"
fn handle_descriptor() -> Descriptor {
    Reference(handle_class_name())
}

/// The class of a handle, which is laid out beside the classes of the prelude.
// example: handle_class_name() == "lumen/Process"
fn handle_class_name() -> String {
    "lumen/Process"
}

/// The class a module lays out the type `declared` as: its own package, or the module's before a dot.
// example: declared_class(main_shapes(), "Box") == "main/Box"
// example: declared_class(no_shapes(), "lexer.Span") == "lexer/Span"
fn declared_class(shapes: Shapes, written_at: String) -> String {
    match split_at_dot(written_at) {
        Some(home) => module_named(shapes.classes, home.module) + "/" + home.name
        None => shapes.class + "/" + written_at
    }
}

/// The class of the module `module`, where `classes` holds each class that is not a module's name.
// example: module_named(only_the_prelude(), "prelude") == "lumen/library/prelude"
// example: module_named(only_the_prelude(), "lexer") == "lexer"
fn module_named(classes: map.Map<String, String>, module: String) -> String {
    or(map.get(classes, module), module)
}

/// `named` split at its first dot, where it has one.
// example: or(split_at_dot("a.b.c"), Home { module: "", name: "" }).name == "b.c"
// example: is_undotted(split_at_dot("abc"))
fn split_at_dot(named: String) -> Option<Home> {
    match first_dot(named) {
        Some(at) => Some(Home { module: or(strings.cut(named, 0, at), ""), name: or(strings.cut(named, at + 1, strings.length(named)), "") })
        None => None
    }
}

/// Where the first dot of `named` is, where it has one.
// example: or(first_dot("a.b.c"), 0) == 1
fn first_dot(named: String) -> Option<Int> {
    var at = strings.length(named) - 1
    var found = None
    for at >= 0 {
        found = match strings.at(named, at) {
            Some(46) => Some(at)
            _ => found
        }
        at = at - 1
    }
    found
}

/// The result of `of`, where it is a function type, and `()` where it is not.
// example: result_or_unit(unify.Unit) == unify.Unit
fn result_or_unit(of: unify.Type) -> unify.Type {
    match of {
        unify.Function { parameters, result } => result
        _ => unify.Unit
    }
}

/// Whether `held` is `wrapper` of something.
// example: is_wrapped_in("Option", unify.Named { name: "Option", arguments: [unify.int()] })
fn is_wrapped_in(wrapper: String, held: unify.Type) -> Bool {
    match held {
        unify.Named { name, arguments } => name == wrapper && list.length(arguments) > 0
        _ => false
    }
}

/// What `wrapper` wraps where `held` is one, and `held` itself where it is not.
// example: peeled("Option", unify.Named { name: "Option", arguments: [unify.int()] }) == unify.int()
fn peeled(wrapper: String, held: unify.Type) -> unify.Type {
    match held {
        unify.Named { name, arguments } => if name == wrapper {
            or(list.at(arguments, 0), held)
        } else {
            held
        }
        _ => held
    }
}

/// What the member is reached for, which a width says is narrower than the result.
// example: held_text(reached_for(Some(Long), ast.GivesInt)) == "I"
fn reached_for(widened: Option<Descriptor>, gives: ast.Gives) -> Option<Descriptor> {
    match widened {
        Some(of) => Some(member_gives(of, gives))
        None => None
    }
}

/// What the member gives where the result is `of` and the declaration writes `gives`.
// example: member_gives(Long, ast.GivesChar) == Character
fn member_gives(of: Descriptor, gives: ast.Gives) -> Descriptor {
    match gives {
        ast.GivesAsDeclared => of
        ast.GivesInt => Integer
        ast.GivesChar => Character
    }
}

/// The type the first parameter is, which is the receiver of a `method` and nothing elsewhere.
// example: received_by(unify.Unit) == unify.Unit
fn received_by(written_at: unify.Type) -> unify.Type {
    or(list.at(parameters_or_none(written_at), 0), unify.Unit)
}

/// The parameters of `of`, where it is a function type.
// example: list.length(parameters_or_none(unify.Unit)) == 0
fn parameters_or_none(of: unify.Type) -> List<unify.Type> {
    match of {
        unify.Function { parameters, result } => parameters
        _ => []
    }
}

/// The guard a `Result` puts round the member access, and none without one.
// example: list.length(guards_of(Answer { member: None, widened: None, optional: false, guarded: true })) == 1
fn guards_of(answer: Answer) -> List<Guard> {
    if answer.guarded {
        return [Guard { from: 0, to: 1, handler: 2, catching: "java/lang/Throwable" }]
    }
    []
}

/// What the method gives back, once the member has left its own answer on the stack.
// example: list.length(given_back(Answer { member: None, widened: None, optional: false, guarded: false }, no_shapes(), 0)) == 1
fn given_back(answer: Answer, shapes: Shapes, held: Int) -> List<Instruction> {
    match answer.widened {
        Some(of) => if answer.optional {
            optional_given_back(answer, shapes, of, held)
        } else {
            handed_on(answer, shapes, answer.widened, held)
        }
        None => handed_on(answer, shapes, answer.widened, held)
    }
}

/// An optional answer given back: a `Some` of it, or a `None` where it is `null`.
// example: list.length(optional_given_back(Answer { member: Some(Long), widened: Some(Long), optional: true, guarded: false }, no_shapes(), Long, 0)) == 6
fn optional_given_back(answer: Answer, shapes: Shapes, of: Descriptor, held: Int) -> List<Instruction> {
    stored := [Store { slot: held, of: of }]
    if !is_reference(of) {
        return concatenated(first: stored, second: some_of(answer, shapes, of, held))
    }
    tested := concatenated(first: stored, second: [Load { slot: held, of: of }, JumpIfNull(3)])
    concatenated(first: list.push(concatenated(first: tested, second: some_of(answer, shapes, of, held)), Label(3)), second: none_of(answer, shapes, held))
}

/// A `Some` of what the slot holds, handed on the way the result asks.
// example: list.length(some_of(Answer { member: None, widened: None, optional: true, guarded: false }, no_shapes(), Long, 0)) == 5
fn some_of(answer: Answer, shapes: Shapes, of: Descriptor, held: Int) -> List<Instruction> {
    concatenated(first: variant_built(built_shape(shapes, "Some"), [Argument { slot: held, arrives: of, crossing: AsItIs }]), second: handed_on(answer, shapes, Some(optional(shapes)), held))
}

/// A `None`, which a `null` and an argument outside the `int` range each become.
// example: list.length(none_of(Answer { member: None, widened: None, optional: true, guarded: false }, no_shapes(), 0)) == 4
fn none_of(answer: Answer, shapes: Shapes, held: Int) -> List<Instruction> {
    concatenated(first: variant_built(built_shape(shapes, "None"), []), second: handed_on(answer, shapes, Some(optional(shapes)), held))
}

/// What is on the stack given back, wrapped in `Ok` where the declaration guards the call.
// example: list.length(handed_on(Answer { member: None, widened: None, optional: false, guarded: true }, no_shapes(), Some(Long), 0)) == 6
fn handed_on(answer: Answer, shapes: Shapes, on_the_stack: Option<Descriptor>, held: Int) -> List<Instruction> {
    if !answer.guarded {
        return [Return(on_the_stack)]
    }
    of := or(on_the_stack, object())
    ok := built_shape(shapes, "Ok")
    list.push(concatenated(first: [Store { slot: held, of: of }], second: variant_built(ok, [Argument { slot: held, arrives: of, crossing: AsItIs }])), Return(Some(Reference(ok.base))))
}

/// What an `Option` stands on the stack as, which both of its variants are folded into.
// example: descriptor_text(optional(no_shapes())) == "L;"
fn optional(shapes: Shapes) -> Descriptor {
    Reference(built_shape(shapes, "Some").base)
}

/// What a throw becomes: the `Err` holding what the throwable says of itself, given back.
// example: list.length(caught(no_shapes(), 0)) == 7
fn caught(shapes: Shapes, held: Int) -> List<Instruction> {
    err := built_shape(shapes, "Err")
    says := InvokeVirtual(MethodRef { class: "java/lang/Throwable", name: "toString", descriptor: MethodDescriptor { parameters: [], result: Some(text_descriptor()) } })
    list.push(concatenated(first: [says, Store { slot: held, of: text_descriptor() }], second: variant_built(err, [Argument { slot: held, arrives: text_descriptor(), crossing: AsItIs }])), Return(Some(Reference(err.base))))
}

/// The shape of the value the constructor `constructor` builds.
// example: built_shape(no_shapes(), "Nothing").class == ""
fn built_shape(shapes: Shapes, constructor: String) -> Shape {
    or(map.get(shapes.built_by, constructor), no_shape())
}

/// The shapes of the module `main`, which declares the type `Box`.
// example: main_shapes().module == "main"
fn main_shapes() -> Shapes {
    shapes := no_shapes()
    shapes { module: "main", class: "main", own: set.insert(set.empty(), "Box") }
}

/// How the module `main` of the examples is named, in a program that reaches only the prelude.
// example: main_naming().class == "main"
fn main_naming() -> Naming {
    Naming { module: "main", class: "main", classes: only_the_prelude() }
}

/// Shapes of nothing, for no module and no prelude.
// example: no_shapes().module == ""
fn no_shapes() -> Shapes {
    Shapes { module: "", class: "", classes: only_the_prelude(), declarations: [], built_by: map.empty(), records: map.empty(), record_builders: set.empty(), own: set.empty(), foreign: map.empty(), prelude_types: set.empty() }
}

/// The classes of a program that reaches no module of the library but the prelude.
// example: module_named(only_the_prelude(), "prelude") == "lumen/library/prelude"
fn only_the_prelude() -> map.Map<String, String> {
    library_class_added(map.empty(), "prelude")
}

/// `classes`, with the class of the module of the library named `name`.
///
/// A module of the library is a class of the package `lumen/library`, and a module of the program
/// is a class of no package. So a module name and a type name, which the package `lumen` holds,
/// never meet, and a program may name a module as the library names one.
// example: module_named(library_class_added(map.empty(), "strings"), "strings") == "lumen/library/strings"
fn library_class_added(classes: map.Map<String, String>, name: String) -> map.Map<String, String> {
    map.insert(classes, name, "lumen/library/" + name)
}

/// The shape of the second variant `C` of the type `a.B`.
// example: tagged_shape().class == "a/B$C"
fn tagged_shape() -> Shape {
    Shape { class: "a/B$C", base: "a/B", tag: Some(1), carries: [] }
}

/// A shape of no class, which carries nothing.
// example: list.length(no_shape().carries) == 0
fn no_shape() -> Shape {
    Shape { class: "", base: "", tag: None, carries: [] }
}

/// What holds text.
// example: descriptor_text(text_descriptor()) == "Ljava/lang/String;"
fn text_descriptor() -> Descriptor {
    Reference(string_class())
}

/// The class of text.
// example: string_class() == "java/lang/String"
fn string_class() -> String {
    "java/lang/String"
}

/// The variant `shape` builds, around what the slot of `around` holds, where there is one.
// example: list.length(variant_built(no_shape(), [])) == 3
fn variant_built(shape: Shape, around: List<Argument>) -> List<Instruction> {
    var instructions = [New(shape.class), Copy]
    for one in around {
        instructions = list.push(instructions, Load { slot: one.slot, of: one.arrives })
        if list.length(shape.carries) == 1 && is_carrying_a_reference(shape) {
            instructions = concatenated(first: instructions, second: as_a_reference(one.arrives))
        }
    }
    list.push(instructions, Construct(MethodRef { class: shape.class, name: "<init>", descriptor: constructor_descriptor(shape) }))
}

/// The call that boxes a value `of` holds, where a box holds it.
// example: list.length(as_a_reference(Long)) == 1
// example: list.length(as_a_reference(object())) == 0
fn as_a_reference(of: Descriptor) -> List<Instruction> {
    if boxing_class(of) == "" {
        return []
    }
    [holding_class(of)]
}

/// The call that puts a value `held` holds in its box.
// example: method_named(holding_class(Long)) == "valueOf"
fn holding_class(held: Descriptor) -> Instruction {
    class := boxing_class(held)
    InvokeStatic(MethodRef { class: class, name: "valueOf", descriptor: MethodDescriptor { parameters: [held], result: Some(Reference(class)) } })
}

/// The class a value `of` holds is boxed in, and `""` for a value no box holds.
// example: boxing_class(Long) == "java/lang/Long"
// example: boxing_class(object()) == ""
fn boxing_class(of: Descriptor) -> String {
    match of {
        Long => "java/lang/Long"
        Boolean => "java/lang/Boolean"
        Integer => "java/lang/Integer"
        _ => ""
    }
}

/// What the constructor of `shape` takes: each value it carries, and nothing for a `()`.
// example: method_descriptor_text(constructor_descriptor(no_shape())) == "()V"
fn constructor_descriptor(shape: Shape) -> MethodDescriptor {
    var taken = []
    for carried in shape.carries {
        taken = match carried.of {
            Some(of) => list.push(taken, of)
            None => taken
        }
    }
    MethodDescriptor { parameters: taken, result: None }
}

/// Whether the first value `shape` carries is held as a reference.
// example: !is_carrying_a_reference(no_shape())
fn is_carrying_a_reference(shape: Shape) -> Bool {
    match list.at(shape.carries, 0) {
        Some(carried) => match carried.of {
            Some(of) => is_reference(of)
            None => false
        }
        None => false
    }
}

/// Whether `of` is a reference, which is the one thing that can be `null`.
// example: is_reference(object())
fn is_reference(of: Descriptor) -> Bool {
    match of {
        Reference(_) => true
        _ => false
    }
}

/// The member itself: every argument loaded from its slot, and the access.
// example: list.length(member_reached(ast.Constructor, [], Some(object()), ThroughItsClass)) == 3
fn member_reached(reaches: ast.Reaches, arguments: List<Argument>, gives: Option<Descriptor>, called: CalledAs) -> List<Instruction> {
    taken := each_reaching(arguments)
    match reaches {
        ast.StaticField(named) => [GetStatic(FieldRef { class: class_of_member(named.text), name: member_of(named.text), of: or(gives, object()) })]
        ast.StaticMethod(named) => list.push(arguments_loaded(arguments), InvokeStatic(MethodRef { class: class_of_member(named.text), name: member_of(named.text), descriptor: MethodDescriptor { parameters: taken, result: gives } }))
        ast.InstanceMethod(named) => list.push(arguments_loaded(arguments), member_called(called, MethodRef { class: class_named_by(or(list.at(taken, 0), object())), name: named.text, descriptor: MethodDescriptor { parameters: after_first(taken), result: gives } }))
        ast.Constructor => constructed_member(arguments, taken, class_named_by(or(gives, object())))
    }
}

/// What holds an object.
// example: descriptor_text(object()) == "Ljava/lang/Object;"
fn object() -> Descriptor {
    Reference(object_class())
}

/// The class every class extends.
// example: object_class() == "java/lang/Object"
fn object_class() -> String {
    "java/lang/Object"
}

/// What each argument reaches the member as.
// example: list.length(each_reaching([])) == 0
fn each_reaching(arguments: List<Argument>) -> List<Descriptor> {
    var taken = []
    for argument in arguments {
        taken = list.push(taken, reaching_of(argument))
    }
    taken
}

/// What the member takes where the argument arrives as `arrived` and crosses as `crossing`.
// example: descriptor_text(reaching_of(Argument { slot: 0, arrives: Long, crossing: Narrowed })) == "I"
fn reaching_of(argument: Argument) -> Descriptor {
    match argument.crossing {
        AsItIs => argument.arrives
        Narrowed => Integer
        Listed => java_list()
    }
}

/// A class built and its constructor called with every argument.
// example: list.length(constructed_member([], [], "a/B")) == 3
fn constructed_member(arguments: List<Argument>, taken: List<Descriptor>, class: String) -> List<Instruction> {
    list.push(concatenated(first: [New(class), Copy], second: arguments_loaded(arguments)), Construct(MethodRef { class: class, name: "<init>", descriptor: MethodDescriptor { parameters: taken, result: None } }))
}

/// `first`, then `second`.
// example: or(list.at(concatenated(first: [1], second: [2]), 1), 0) == 2
fn concatenated<T>(first: List<T>, second: List<T>) -> List<T> {
    var all = first
    for value in second {
        all = list.push(all, value)
    }
    all
}

/// Every argument loaded from the slot it arrives in, and made what the member takes.
// example: list.length(arguments_loaded([Argument { slot: 0, arrives: Long, crossing: Narrowed }])) == 2
fn arguments_loaded(arguments: List<Argument>) -> List<Instruction> {
    var instructions = []
    for argument in arguments {
        instructions = list.push(instructions, Load { slot: argument.slot, of: argument.arrives })
        instructions = match argument.crossing {
            AsItIs => instructions
            Narrowed => list.push(instructions, Narrow)
            Listed => list.push(instructions, InvokeStatic(list_crossed()))
        }
    }
    instructions
}

/// The method that turns a list into a `java.util.List`.
// example: list_crossed().name == "listed"
fn list_crossed() -> MethodRef {
    MethodRef { class: list_class(), name: "listed", descriptor: MethodDescriptor { parameters: [list_descriptor()], result: Some(java_list()) } }
}

/// What holds a list.
// example: descriptor_text(list_descriptor()) == "Llumen/List;"
fn list_descriptor() -> Descriptor {
    Reference(list_class())
}

/// The class of a list.
// example: list_class() == "lumen/List"
fn list_class() -> String {
    "lumen/List"
}

/// What holds a `java.util.List`.
// example: descriptor_text(java_list()) == "Ljava/util/List;"
fn java_list() -> Descriptor {
    Reference("java/util/List")
}

/// Each of `taken` after the first.
// example: list.length(after_first([Long, Integer])) == 1
fn after_first(taken: List<Descriptor>) -> List<Descriptor> {
    var rest = []
    var position = 0
    for one in taken {
        if position > 0 {
            rest = list.push(rest, one)
        }
        position += 1
    }
    rest
}

/// The call an instance method is reached with, which the JVM writes one way for an interface.
// example: method_named(member_called(ThroughItsInterface, list_built())) == "of"
fn member_called(called: CalledAs, method: MethodRef) -> Instruction {
    match called {
        ThroughItsClass => InvokeVirtual(method)
        ThroughItsInterface => InvokeInterface(method)
    }
}

/// The class a `field` or a `static` names, which is every segment but the last.
// example: class_of_member("java.lang.Math.abs") == "java/lang/Math"
fn class_of_member(named: String) -> String {
    match last_dot(named) {
        Some(at) => slashed(or(strings.cut(named, 0, at), ""))
        None => ""
    }
}

/// A Java name with each dot turned into a slash, which is how a class file names a class.
// example: slashed("java.lang.String") == "java/lang/String"
fn slashed(java: String) -> String {
    dots_replaced(named: java, replacement: "/")
}

/// `named` with each dot turned into `replacement`.
// example: dots_replaced(named: "a.b.c", replacement: "$") == "a$b$c"
fn dots_replaced(named: String, replacement: String) -> String {
    var written = ""
    var at = 0
    var from = 0
    for at < strings.length(named) {
        if is_dot_at(named, at) {
            written += or(strings.cut(named, from, at), "") + replacement
            from = at + 1
        }
        at += 1
    }
    written + or(strings.cut(named, from, strings.length(named)), "")
}

/// Whether the character at `at` of `named` is a dot.
// example: is_dot_at("a.b", 1)
fn is_dot_at(named: String, at: Int) -> Bool {
    match strings.at(named, at) {
        Some(46) => true
        _ => false
    }
}

/// The member a `field` or a `static` names, which is the last segment.
// example: member_of("java.lang.Math.abs") == "abs"
fn member_of(named: String) -> String {
    match last_dot(named) {
        Some(at) => or(strings.cut(named, at + 1, strings.length(named)), "")
        None => named
    }
}

/// Where the last dot of `named` is, where it has one.
// example: or(last_dot("a.b.c"), 0) == 3
fn last_dot(named: String) -> Option<Int> {
    var found = None
    var at = 0
    for at < strings.length(named) {
        found = match strings.at(named, at) {
            Some(46) => Some(at)
            _ => found
        }
        at += 1
    }
    found
}

/// The class `of` is, which every descriptor an `extern` writes a class into is one of.
// example: class_named_by(object()) == "java/lang/Object"
fn class_named_by(of: Descriptor) -> String {
    match of {
        Reference(class) => class
        _ => ""
    }
}

/// One pass over the program: each module lowered, every ask, and what each module knew of.
type Pass = {
    lowered: List<Lowered>
    asked: Asked
    knew: List<Knew>
}

/// Each class one module lowers to, and what it asks of other modules.
type Lowered = {
    classes: List<Class>
    asks: Asked
}

/// The asks a module knew of when it was lowered.
type Knew = {
    module: String
    asked: Asked
}

/// A reached method, and the lowering after it is owed.
type Reachable = {
    lowering: Lowering
    reaching: Reaching
}

/// An instance, where one answers, and the lowering after it is asked for.
type Answered = {
    lowering: Lowering
    answered_by: Option<Instance>
}

/// Types written as another module writes them, and the lowering after it is asked.
type AskedOf = {
    lowering: Lowering
    written: List<unify.Type>
}

/// A class, and the lowering after it is written.
type Classed = {
    lowering: Lowering
    class: Class
}

/// The methods written, and the lowering after they are written.
type MethodsWritten = {
    lowering: Lowering
    methods: List<Method>
}

/// A method, and the lowering after it is written.
type MethodMade = {
    lowering: Lowering
    method: Method
}

/// A body, and the lowering after it is written.
type BodyMade = {
    lowering: Lowering
    body: Body
}

/// A method of a trait, asked at a type another module declares.
type Asking = {
    method: String
    at: unify.Type
    home: Home
    arguments: List<unify.Type>
}

/// The module that declares a type, and the name the type has there.
type Home = {
    module: String
    name: String
}

/// A generic of another module, and what one use settles it on.
type GenericAsked = {
    module: String
    function: String
    settled: List<unify.Type>
    constrained: List<List<String>>
}

/// A name, and the lowering after it is asked for.
type NamedAsked = {
    lowering: Lowering
    named: String
}

/// A use of a function: where it is declared, where it is used, and what the body is settled on.
type Use = {
    declared: lexer.Span
    at: lexer.Span
    within: Instantiation
}

/// One trait a derive names, and the derive.
type DerivedName = {
    named: ast.Name
    deriving: ast.DeriveDeclaration
}

/// The builder after a value is written, and what holds the value, which is nothing for `()`.
type Left = {
    builder: Builder
    held: Option<Descriptor>
}

/// One class: its name, what it extends, how it is extended, the interfaces it implements, its
/// fields, and its methods.
type Class = {
    name: String
    extends: String
    extending: Extending
    implements: List<String>
    fields: List<Field>
    methods: List<Method>
}

/// Whether a class is never extended, or is the base its variants extend.
type Extending =
    | Never
    | ByItsVariants

/// One field of a class.
type Field = {
    name: String
    of: Descriptor
}

/// One method of a class.
type Method = {
    name: String
    descriptor: MethodDescriptor
    reached: Reached
    body: Body
}

/// Whether a method is reached through its class or through an instance.
type Reached =
    | ThroughTheClass
    | ThroughAnInstance

/// The instructions of a method, the slots it needs past its parameters, and its guards.
type Body = {
    instructions: List<Instruction>
    locals: Int
    guards: List<Guard>
}

/// A range of instructions whose throw of `catching` lands at `handler`.
type Guard = {
    from: Int
    to: Int
    handler: Int
    catching: String
}

/// The builder after a loop is entered, and how the loop goes round.
type Entered = {
    builder: Builder
    turn: Turn
}

/// How a loop goes round: forever, while a condition holds, or over a list.
type Turn =
    | Forever
    | While(ast.Expr)
    | Walk {
        walked_list: Int
        index: Int
        item: Option<Slot>
    }

/// The builder after an instance is looked for, and the instance, where one answers.
type Found = {
    builder: Builder
    answered_by: Option<Instance>
}

/// A method an instance writes, and the class that holds it.
type Instance = {
    class: String
    reaching: Reaching
}

/// The builder after a value is put aside, and the slot it is put aside in.
type Aside = {
    builder: Builder
    slot: Slot
}

/// The builder after values are put aside, and the slot of each.
type Asides = {
    builder: Builder
    slots: List<Slot>
}

/// What a call calls, and what it passes, once a method call is read as a function call.
type Callee = {
    name: ast.Name
    passed: List<ast.Expr>
}

/// A name reached through a module: the module, the name, and where the use is written.
type Through = {
    module: ast.Name
    name: ast.Name
    used: lexer.Span
}

/// The method of a trait an operator asks for, and how its operands are handed to it.
type OperatorAsk = {
    of: String
    reversed: Bool
    flipped: Bool
}

/// The builder after a method is reached, and the method.
type Reaches = {
    builder: Builder
    reaching: Reaching
}

/// The name of a method, and its signature.
type Reaching = {
    named: String
    signature: Signature
}

/// What the thread of a process calls: the module and name of the process, and the signatures
/// of `start` and `receive`.
type Ran = {
    module: String
    named: String
    started: Signature
    received: Signature
}

/// What carries each parameter and the result of a method, and nothing where it is `()`.
type Signature = {
    parameters: List<Option<Descriptor>>
    result: Option<Descriptor>
}

/// The builder after a scrutinee is held, and the slot that holds it, which `()` has none of.
type HeldSlot = {
    builder: Builder
    slot: Option<Slot>
}

/// What one pattern is tried against: the slot of the value, and the label a miss jumps to.
type Against = {
    slot: Slot
    next: Int
}

/// The builder after a value is read as a variant, and the shape of that variant.
type Tagged = {
    builder: Builder
    shape: Shape
}

/// What builds one body: the instructions so far, the slots, the labels, and the loops.
type Builder = {
    lowering: Lowering
    instructions: List<Instruction>
    slots: map.Map<Int, Slot>
    next_slot: Int
    first_local: Int
    next_label: Int
    repeat: Option<Repeat>
    splitting: set.Set<Int>
    fields: map.Map<String, Slot>
    result: Option<Descriptor>
    at: Instantiation
}

/// A slot of the frame, and what it holds.
type Slot = {
    at: Int
    of: Descriptor
}

/// The labels a `continue` and a `break` jump to.
type Repeat = {
    again: Int
    done: Int
}

/// The escape walk so far: each binding it has walked, and each that escapes.
type Escape = {
    built: List<Int>
    escaped: set.Set<Int>
}

/// A derived body after a label is taken, and the label.
type LabelledWriting = {
    writing: Writing
    label: Int
}

/// One derived body part-way through: the lowering, the instructions, and the next label.
type Writing = {
    lowering: Lowering
    instructions: List<Instruction>
    next_label: Int
}

/// What lowering one module holds: its types, its shapes, its methods, and what it owes.
type Lowering = {
    typed: infer.Inference
    library: Library
    module: String
    shapes: Shapes
    declared: map.Map<Int, Declared>
    answers: map.Map<String, Answers>
    instances: List<Answers>
    owed: List<Owed>
    next_owed: Int
    asks: Asked
}

/// Every method one module asks other modules for.
type Asked = {
    of: List<Specialisation>
}

/// One ask: the module, the name of its generic, and the types it is settled on.
///
/// Each type is written as the asked module writes it, and `foreign` names each Java class that
/// one of those types names, which the asked module cannot read off its own imports.
derive Eq for Specialisation

type Specialisation = {
    module: String
    function: String
    settled: List<unify.Type>
    foreign: List<Foreign>
}

/// A type written in the asking module as the Java class `reached`.
derive Eq for Foreign

type Foreign = {
    name: String
    reached: JavaClass
}

/// The prelude a program is lowered against, with its own bodies typed.
type Library = {
    prelude: types.Prelude
    typed: infer.Inference
    traits: List<ast.TraitDeclaration>
    types: set.Set<String>
}

/// A declaration that writes a method: the name of the method, and what gives its body.
type Declared = {
    named: String
    body: Written
}

/// What gives a method its body: source, the member an `extern` reaches, or a derive.
type Written =
    | Source(ast.FunctionDeclaration)
    | FromJava(ast.ExternDeclaration)
    | Derived {
        of: String
        declaration: ast.TypeDeclaration
    }

/// A method one instance writes: the method, its type, the type's arguments, and its name.
type Answers = {
    method: String
    for_type: String
    arguments: List<String>
    declared: lexer.Span
}

/// A method the module owes: its declaration, its name, and the types it is settled on.
type Owed = {
    declared: lexer.Span
    named: String
    at: Instantiation
}

/// What each type parameter of one generic is settled on.
type Instantiation = {
    settled: List<Settled>
}

/// One type parameter: where it is written, what it is settled on, and whether a trait asks of it.
type Settled = {
    origin: Int
    at: unify.Type
    constrained: Bool
}

/// The shape of each type a module reaches: its class, its tag, and what it carries.
///
/// `module` is how other modules spell the module, `class` is its class, and `classes` holds the
/// class of each module of its program whose class is not its name.
type Shapes = {
    module: String
    class: String
    classes: map.Map<String, String>
    declarations: List<ShapeDeclared>
    built_by: map.Map<String, Shape>
    records: map.Map<String, String>
    record_builders: set.Set<String>
    own: set.Set<String>
    foreign: map.Map<String, JavaClass>
    prelude_types: set.Set<String>
}

/// How one module is named: how other modules spell it, its class, and the class of each module
/// of its program whose class is not its name.
type Naming = {
    module: String
    class: String
    classes: map.Map<String, String>
}

/// A Java class a type stands for, and how the class is called.
derive Eq for JavaClass

type JavaClass = {
    class: String
    called: CalledAs
}

/// How a Java class is called: as a class, or as an interface.
derive Eq for CalledAs

type CalledAs =
    | ThroughItsClass
    | ThroughItsInterface

/// A type the module declares: a record, or a base class and its variants.
type ShapeDeclared =
    | RecordDeclared(String)
    | VariantsDeclared {
        base: String
        constructors: List<String>
    }

/// One instruction of a body, over a stack.
type Instruction =
    | LongOf(Int)
    | BooleanOf(Bool)
    | IntegerOf(Int)
    | TextOf(String)
    | Load {
        slot: Int
        of: Descriptor
    }
    | Store {
        slot: Int
        of: Descriptor
    }
    | Drop(Descriptor)
    | Copy
    | Arithmetic(Arithmetic)
    | Concat
    | CompareLongs(Comparison)
    | CompareIntegers(Comparison)
    | Not
    | Widen
    | Narrow
    | LowEightBits
    | Label(Int)
    | Jump(Int)
    | JumpIfFalse(Int)
    | JumpIfNull(Int)
    | New(String)
    | NewArray(String)
    | StoreInArray
    | LoadFromArray
    | ArrayLength
    | Construct(MethodRef)
    | GetField(FieldRef)
    | GetStatic(FieldRef)
    | PutField(FieldRef)
    | InvokeStatic(MethodRef)
    | InvokeVirtual(MethodRef)
    | InvokeInterface(MethodRef)
    | InvokeStaticOfInterface(MethodRef)
    | Cast(String)
    | InstanceOf(String)
    | Increment(Int)
    | Return(Option<Descriptor>)
    | Throw

/// A field of a class.
type FieldRef = {
    class: String
    name: String
    of: Descriptor
}

/// A method of a class.
type MethodRef = {
    class: String
    name: String
    descriptor: MethodDescriptor
}

/// What a method takes, and what it gives back, which is nothing for `void`.
type MethodDescriptor = {
    parameters: List<Descriptor>
    result: Option<Descriptor>
}

/// How two values are compared.
derive Eq for Comparison

type Comparison =
    | Equal
    | NotEqual
    | Less
    | LessOrEqual
    | Greater
    | GreaterOrEqual

/// What arithmetic is done on whole numbers.
type Arithmetic =
    | Add
    | Subtract
    | Multiply
    | Divide
    | Remainder
    | Negate

/// Where the walk of `is_less` leaves for once it settled which value comes first.
type Decided = {
    less: Int
    not_less: Int
}

/// One value a derived body reads: its shape, where it lives, what holds it, and how it is written.
type Holds = {
    shape: Shape
    carried: Carried
    of: Descriptor
    named: Option<String>
    written: ast.TypeRef
}

/// What a constructor builds: its class, the base class, its tag, and what it carries.
type Shape = {
    class: String
    base: String
    tag: Option<Int>
    carries: List<Carried>
}

/// One value a constructor carries: its field, and what holds it, which is nothing for `()`.
type Carried = {
    name: String
    of: Option<Descriptor>
}

/// One value as the source writes it: its field name, where it has one, and its type.
type WrittenValue = {
    named: Option<String>
    written: ast.TypeRef
}

/// What the member of an `extern` gives back, and what the declaration wraps it in.
type Answer = {
    member: Option<Descriptor>
    widened: Option<Descriptor>
    optional: Bool
    guarded: Bool
}

/// One argument of an `extern`: the slot it arrives in, what it arrives as, and how it crosses.
type Argument = {
    slot: Int
    arrives: Descriptor
    crossing: Crossing
}

/// What holds a value on the JVM.
derive Eq for Descriptor

type Descriptor =
    | Long
    | Boolean
    | Integer
    | Character
    | Reference(String)
    | Array(Descriptor)

/// What an argument becomes between its slot and the member it reaches.
derive Eq for Crossing

type Crossing =
    | AsItIs
    | Narrowed
    | Listed
