// The parser: the tokens of a source file to the tree `compiler/ast.bx` declares.
//
// `docs/specs/grammar.md` states what it does, and `tests/parsing.bx` holds it on drawn input.
// `tests/siblings.bx` holds it to every `.ast` and `.error` file under `tests/spec`.
// Parsing stops at the first error, which carries the span of the token that failed.
// The parser knows no definitions, so it never asks whether a name exists or what it names.
import ast
import lexer
import list
import strings

/// The tree `source` parses to, or the error it is refused with, in the form a fixture holds.
///
/// A tree is written as `ast.printed` writes it. An error is `<start>..<end> <message>` on one
/// line, then `help: <text>` on the next where the error names a fix.
// example: printed("import io\n") == "import io 0..9\n"
// example: printed("fn (") == "3..4 expected a function name, found `(`\nhelp: every function has a name; Bux has no anonymous functions\n"
fn printed(source: String) -> String {
    match parse(source) {
        Ok(parsed) => ast.printed(parsed)
        Err(refused) => error_printed(refused)
    }
}

/// The program `source` spells, or the first place it does not fit the grammar.
// example: list.length(ok_or(parse("import io\nimport list\n"), ast.Program { items: [] }).items) == 2
fn parse(source: String) -> Result<ast.Program, ParseError> {
    program(over(source))
}

/// Every item of the file, each ending at a newline or at the end of the file.
// example: failed_with(program(over("import io import list"))) == "10..16 expected the end of the line, found `import`\n"
fn program(from: Cursor) -> Result<ast.Program, ParseError> {
    var cursor = from
    var items = []
    for !is_at_end(cursor) {
        let declared = item(cursor)?
        items = list.push(items, declared.value)
        cursor = expect_end_of_line(declared.cursor)?
    }
    Ok(ast.Program { items: items })
}

/// A top-level declaration, which the keyword it starts with says the kind of.
// example: position_after(item(over("import io\n"))) == 2
// example: failed(item(over("x"))) == "0..1 expected an import, a type, a trait, an instance, a derive, a function, an extern, a process, or a test, found `x`\n"
fn item(cursor: Cursor) -> Result<Parsed<ast.Item>, ParseError> {
    if is_at_keyword(cursor, lexer.Import) {
        return import_item(cursor)
    }
    if is_at_keyword(cursor, lexer.Type) {
        return type_item(cursor)
    }
    if is_at_keyword(cursor, lexer.Trait) {
        return trait_item(cursor)
    }
    if is_at_keyword(cursor, lexer.Instance) {
        return instance_item(cursor)
    }
    if is_at_keyword(cursor, lexer.Derive) {
        return derive_item(cursor)
    }
    if is_at_keyword(cursor, lexer.Fn) {
        let declared = function_declaration(cursor)?
        return Ok(Parsed { value: ast.Function(declared.value), cursor: declared.cursor })
    }
    if is_at_keyword(cursor, lexer.Extern) {
        return reaching_java(cursor)
    }
    if is_at_keyword(cursor, lexer.Process) {
        return process_item(cursor)
    }
    if is_at_keyword(cursor, lexer.Test) {
        return test_item(cursor)
    }
    if is_at_keyword(cursor, lexer.Private) {
        return private_item(cursor)
    }
    Err(error(cursor, ItemWanted))
}

/// `private` and the declaration it keeps in its module, whose span runs from `private` on.
// example: item_printed(private_item(over("private type Id = Id(Int)"))) == "private type Id 0..25\n  variant Id 18..25\n    named-type Int 21..24\n"
// example: failed(private_item(over("private import io"))) == "8..14 expected a function, a type, a trait, or a process, found `import`\nhelp: `private` keeps a name in its module, and only these four declare a name that another module reaches\n"
fn private_item(cursor: Cursor) -> Result<Parsed<ast.Item>, ParseError> {
    let start = offset(cursor)
    let past_private = expect_keyword(cursor, lexer.Private)?
    let declared = named_item(past_private)?
    Ok(Parsed { value: made_private(declared.value, span_since(declared.cursor, start)), cursor: declared.cursor })
}

/// A declaration whose name another module reaches: a function, a type, a trait, or a process.
// example: item_printed(named_item(over("type Id = Id(Int)"))) == "type Id 0..17\n  variant Id 10..17\n    named-type Int 13..16\n"
fn named_item(cursor: Cursor) -> Result<Parsed<ast.Item>, ParseError> {
    if is_at_keyword(cursor, lexer.Fn) {
        let declared = function_declaration(cursor)?
        return Ok(Parsed { value: ast.Function(declared.value), cursor: declared.cursor })
    }
    if is_at_keyword(cursor, lexer.Type) {
        return type_item(cursor)
    }
    if is_at_keyword(cursor, lexer.Trait) {
        return trait_item(cursor)
    }
    if is_at_keyword(cursor, lexer.Process) {
        return process_item(cursor)
    }
    Err(error(cursor, NamedItemWanted))
}

/// `declared`, kept in its module, over `span`.
// example: ast.extent_of(made_private(ast.Test(ast.TestDeclaration { name: ast.Name { text: "a", span: lexer.Span { start: 5, length: 3 } }, body: ast.Block { statements: [], span: lexer.Span { start: 9, length: 3 } }, span: lexer.Span { start: 0, length: 12 } }), lexer.Span { start: 0, length: 1 })).length == 12
fn made_private(declared: ast.Item, span: lexer.Span) -> ast.Item {
    match declared {
        ast.Type(declaration) => ast.Type(declaration { span: span, visibility: ast.Private })
        ast.Trait(declaration) => ast.Trait(declaration { span: span, visibility: ast.Private })
        ast.Function(declaration) => ast.Function(declaration { span: span, visibility: ast.Private })
        ast.Process(declaration) => ast.Process(declaration { span: span, visibility: ast.Private })
        _ => declared
    }
}

/// `extern type File = "java.io.File"`, or an `extern` naming one member of a Java class.
// example: position_after(reaching_java(over("extern type File = \"java.io.File\""))) == 5
fn reaching_java(cursor: Cursor) -> Result<Parsed<ast.Item>, ParseError> {
    if is_ahead(cursor, 1, lexer.Keyword(lexer.Type)) {
        return foreign_type(cursor)
    }
    declared_extern(cursor)
}

/// `extern type File = "java.io.File"`: a name for a Java class a value is held as.
// example: item_printed(foreign_type(over("extern type interface Path = \"java.nio.file.Path\""))) == "type Path 0..49\n  java interface java.nio.file.Path 29..49\n"
fn foreign_type(cursor: Cursor) -> Result<Parsed<ast.Item>, ParseError> {
    let start = offset(cursor)
    let past_extern = expect_keyword(cursor, lexer.Extern)?
    let past_type = expect_keyword(past_extern, lexer.Type)?
    let called = how_it_is_called(past_type)
    let name = expect_name(called.cursor, NameWanted)?
    let equals = expect_punct(name.cursor, lexer.Eq)?
    let class = java_name(equals)?
    let definition = ast.Foreign { class: class.value, called: called.value }
    let declared = ast.TypeDeclaration { name: name.value, parameters: [], definition: definition, span: span_since(class.cursor, start), visibility: ast.Public }
    Ok(Parsed { value: ast.Type(declared), cursor: class.cursor })
}

/// `interface` before the name, which says the class is one, and only where a name follows it.
// example: position_after(Ok(how_it_is_called(over("interface Path")))) == 1
// example: position_after(Ok(how_it_is_called(over("interface =")))) == 0
fn how_it_is_called(cursor: Cursor) -> Parsed<ast.Called> {
    if word_before_a_name(cursor) == "interface" {
        return Parsed { value: ast.AsAnInterface, cursor: advanced(cursor) }
    }
    Parsed { value: ast.AsAClass, cursor: cursor }
}

/// `extern static read(path: Path) -> String = "java.nio.file.Files.readString"`, and the rest.
///
/// The word after `extern` says which kind of member it is, and how much of the rest is written.
// example: printed("extern new now() -> Clock") == "extern new now 0..25\n  result\n    named-type Clock 20..25\n"
// example: failed(declared_extern(over("extern method len() -> Int = \"length\""))) == "18..19 expected a name, found `)`\n"
fn declared_extern(cursor: Cursor) -> Result<Parsed<ast.Item>, ParseError> {
    let start = offset(cursor)
    let past_extern = expect_keyword(cursor, lexer.Extern)?
    let member = extern_member(past_extern)?
    let gives = given_back(member.cursor)
    let name = expect_name(gives.cursor, FunctionNameWanted)?
    let opened = expect_punct(name.cursor, lexer.LParen)?
    let parameters = taken(opened, member.value)?
    let arrow = expect_punct(parameters.cursor, lexer.Arrow)?
    let result = type_ref(arrow)?
    let reaches = reaching(result.cursor, member.value)?
    let declared = ast.ExternDeclaration { name: name.value, reaches: reaches.value, gives: gives.value, parameters: parameters.value, result: result.value, span: span_since(reaches.cursor, start) }
    Ok(Parsed { value: ast.Extern(declared), cursor: reaches.cursor })
}

/// The word after `extern`, which is read only there and is an ordinary name anywhere else.
// example: position_after(extern_member(over("static x"))) == 1
// example: failed(extern_member(over("fixed x"))) == "0..5 expected `field`, `static`, `method`, or `new`, found `fixed`\n"
fn extern_member(cursor: Cursor) -> Result<Parsed<Member>, ParseError> {
    let word = word_at(cursor)
    if word == "field" {
        return Ok(Parsed { value: FieldMember, cursor: advanced(cursor) })
    }
    if word == "static" {
        return Ok(Parsed { value: StaticMember, cursor: advanced(cursor) })
    }
    if word == "method" {
        return Ok(Parsed { value: MethodMember, cursor: advanced(cursor) })
    }
    if word == "new" {
        return Ok(Parsed { value: NewMember, cursor: advanced(cursor) })
    }
    Err(error(cursor, ExternKindWanted))
}

/// `int` or `char` before the name, which says what the member's own descriptor gives back.
// example: position_after(Ok(given_back(over("int length(")))) == 1
// example: position_after(Ok(given_back(over("int(")))) == 0
fn given_back(cursor: Cursor) -> Parsed<ast.Gives> {
    let word = word_before_a_name(cursor)
    if word == "int" {
        return Parsed { value: ast.GivesInt, cursor: advanced(cursor) }
    }
    if word == "char" {
        return Parsed { value: ast.GivesChar, cursor: advanced(cursor) }
    }
    Parsed { value: ast.GivesAsDeclared, cursor: cursor }
}

/// The parameters a member of this kind is written with, the opening bracket already read.
///
/// A `field` is read rather than called, so it takes nothing, and a `method` is called on the
/// first of its parameters, so it takes at least that one.
// example: position_after(taken(over(")"), FieldMember)) == 1
// example: failed(taken(over(")"), MethodMember)) == "0..1 expected a name, found `)`\n"
fn taken(cursor: Cursor, member: Member) -> Result<Parsed<List<ast.ExternParameter>>, ParseError> {
    if member == FieldMember {
        let closed = expect_punct(cursor, lexer.RParen)?
        return Ok(Parsed { value: [], cursor: closed })
    }
    var parameters = []
    var step = opening(cursor, lexer.RParen, emptiness_of(member))
    for is_open(step) {
        let taken_one = extern_parameter(cursor_of(step))?
        parameters = list.push(parameters, taken_one.value)
        step = after_element(taken_one.cursor, lexer.RParen)?
    }
    Ok(Parsed { value: parameters, cursor: cursor_of(step) })
}

/// Whether a member of this kind may be declared with no parameter at all.
// example: emptiness_of(MethodMember) == NeverEmpty
fn emptiness_of(member: Member) -> Emptiness {
    if member == MethodMember {
        return NeverEmpty
    }
    MayBeEmpty
}

/// One parameter of an `extern`, with `int` before its name where the member narrows it.
// example: position_after(extern_parameter(over("int index: Int"))) == 4
fn extern_parameter(cursor: Cursor) -> Result<Parsed<ast.ExternParameter>, ParseError> {
    let takes = narrowed(cursor)
    let declared = parameter(takes.cursor)?
    Ok(Parsed { value: ast.ExternParameter { declared: declared.value, takes: takes.value }, cursor: declared.cursor })
}

/// `int` before a parameter's name, which says the member's descriptor takes one.
// example: position_after(Ok(narrowed(over("int index")))) == 1
// example: position_after(Ok(narrowed(over("int: Int")))) == 0
fn narrowed(cursor: Cursor) -> Parsed<ast.Takes> {
    if word_before_a_name(cursor) == "int" {
        return Parsed { value: ast.TakesInt, cursor: advanced(cursor) }
    }
    Parsed { value: ast.TakesAsDeclared, cursor: cursor }
}

/// The word at the cursor where a name follows it, and `""` where no such word is there.
///
/// A word written before a declared name is that word only where a name follows it, which is the
/// one place the grammar reads a second token.
// example: word_before_a_name(over("int length")) == "int"
// example: word_before_a_name(over("int(")) == ""
fn word_before_a_name(cursor: Cursor) -> String {
    if !is_ahead(cursor, 1, lexer.Identifier) {
        return ""
    }
    word_at(cursor)
}

/// The identifier at the cursor, and `""` where the cursor is at no identifier.
// example: word_at(over("static")) == "static"
// example: word_at(over("(")) == ""
fn word_at(cursor: Cursor) -> String {
    match token_at(cursor, 0) {
        Some(token) => identifier_text(token)
        None => ""
    }
}

/// The text of `token` where it is an identifier, and `""` where it is anything else.
// example: identifier_text(lexer.Token { kind: lexer.Identifier, span: lexer.Span { start: 0, length: 2 }, text: "ab" }) == "ab"
fn identifier_text(token: lexer.Token) -> String {
    if token.kind == lexer.Identifier {
        return token.text
    }
    ""
}

/// What the declaration names after its signature, which is the member this kind reaches.
///
/// A constructor names nothing: the class it builds is the one its result already is.
// example: position_after(reaching(over("= \"toPath\""), MethodMember)) == 2
// example: position_after(reaching(over(""), NewMember)) == 0
fn reaching(cursor: Cursor, member: Member) -> Result<Parsed<ast.Reaches>, ParseError> {
    if member == NewMember {
        return Ok(Parsed { value: ast.Constructor, cursor: cursor })
    }
    let equals = expect_punct(cursor, lexer.Eq)?
    let named = java_name(equals)?
    Ok(Parsed { value: reached_by(member, named.value), cursor: named.cursor })
}

/// The member a kind of `extern` reaches through `named`.
///
/// It returns from each test rather than match, because a match that gives a variant of a type
/// from another module fails the JVM's verifier.
// example: ast.reaches_word(reached_by(FieldMember, ast.JavaName { text: "out", span: lexer.Span { start: 0, length: 5 } })) == "field"
fn reached_by(member: Member, named: ast.JavaName) -> ast.Reaches {
    if member == FieldMember {
        return ast.StaticField(named)
    }
    if member == StaticMember {
        return ast.StaticMethod(named)
    }
    if member == MethodMember {
        return ast.InstanceMethod(named)
    }
    ast.Constructor
}

/// The Java name in quotes that an `extern` states, which the JVM rather than the compiler holds.
// example: position_after(java_name(over("\"java.io.File\""))) == 1
// example: failed(java_name(over("File"))) == "0..4 expected a Java name in quotes, found `File`\n"
fn java_name(cursor: Cursor) -> Result<Parsed<ast.JavaName>, ParseError> {
    let token = expect(cursor, lexer.String, JavaNameWanted)?
    let text = decode_string(token.value)?
    Ok(Parsed { value: ast.JavaName { text: text, span: token.value.span }, cursor: token.cursor })
}

/// `import io`: another module, by its name.
// example: item_printed(import_item(over("import io"))) == "import io 0..9\n"
fn import_item(cursor: Cursor) -> Result<Parsed<ast.Item>, ParseError> {
    let start = offset(cursor)
    let past_import = expect_keyword(cursor, lexer.Import)?
    let module = expect_name(past_import, NameWanted)?
    let declared = ast.ImportDeclaration { module: module.value, span: span_since(module.cursor, start) }
    Ok(Parsed { value: ast.Import(declared), cursor: module.cursor })
}

/// `type User = { … }` or `type Payment = | Pending | Failed(String)`.
// example: item_printed(type_item(over("type Id = Id(Int)"))) == "type Id 0..17\n  variant Id 10..17\n    named-type Int 13..16\n"
// example: position_after(type_item(over("type Ids = List<Int>"))) == 4
fn type_item(cursor: Cursor) -> Result<Parsed<ast.Item>, ParseError> {
    let start = offset(cursor)
    let past_type = expect_keyword(cursor, lexer.Type)?
    let name = expect_name(past_type, NameWanted)?
    let parameters = type_parameters(name.cursor)?
    let equals = expect_punct(parameters.cursor, lexer.Eq)?
    let definition = type_definition(equals)?
    let declared = ast.TypeDeclaration { name: name.value, parameters: parameters.value, definition: definition.value, span: span_since(definition.cursor, start), visibility: ast.Public }
    Ok(Parsed { value: ast.Type(declared), cursor: definition.cursor })
}

/// A record body, one variant on the same line, or a `|` variant per line.
// example: position_after(type_definition(over("| On\n| Off"))) == 5
fn type_definition(cursor: Cursor) -> Result<Parsed<ast.TypeDefinition>, ParseError> {
    if is_at_punct(cursor, lexer.LBrace) {
        let body = record_body(cursor)?
        return Ok(Parsed { value: ast.RecordType(body.value), cursor: body.cursor })
    }
    if !is_at_variant_bar(cursor) {
        let only = variant(cursor)?
        return Ok(Parsed { value: ast.Variants([only.value]), cursor: only.cursor })
    }
    var variants = []
    var after = cursor
    for is_at_variant_bar(after) {
        let bar = expect_punct(skip_newline(after), lexer.Pipe)?
        let declared = variant(bar)?
        variants = list.push(variants, declared.value)
        after = declared.cursor
    }
    Ok(Parsed { value: ast.Variants(variants), cursor: after })
}

/// Whether another `|` variant follows, on this line or the next.
// example: is_at_variant_bar(over("\n| On"))
// example: !is_at_variant_bar(over("On"))
fn is_at_variant_bar(cursor: Cursor) -> Bool {
    is_at_punct(cursor, lexer.Pipe) || is_ahead(cursor, 0, lexer.Newline) && is_ahead(cursor, 1, lexer.Punct(lexer.Pipe))
}

/// One variant, with whatever it carries.
// example: position_after(variant(over("Failed(String)"))) == 4
fn variant(cursor: Cursor) -> Result<Parsed<ast.Variant>, ParseError> {
    let start = offset(cursor)
    let name = expect_name(cursor, NameWanted)?
    let payload = variant_payload(name.cursor)?
    Ok(Parsed { value: ast.Variant { name: name.value, payload: payload.value, span: span_since(payload.cursor, start) }, cursor: payload.cursor })
}

/// What a variant carries: nothing, positional types, or named fields.
// example: failed(variant_payload(over("()"))) == "1..2 expected a type, found `)`\n"
fn variant_payload(cursor: Cursor) -> Result<Parsed<ast.VariantPayload>, ParseError> {
    if is_at_punct(cursor, lexer.LBrace) {
        let body = record_body(cursor)?
        return Ok(Parsed { value: ast.RecordPayload(body.value), cursor: body.cursor })
    }
    if !is_at_punct(cursor, lexer.LParen) {
        return Ok(Parsed { value: ast.NoPayload, cursor: cursor })
    }
    let types = type_list(advanced(cursor), lexer.RParen)?
    Ok(Parsed { value: ast.TuplePayload(types.value), cursor: types.cursor })
}

/// `{ name: Type … }`, one field per line.
// example: position_after(record_body(over("{\n    id: Int\n}"))) == 6
fn record_body(cursor: Cursor) -> Result<Parsed<List<ast.RecordField>>, ParseError> {
    let opened = expect_punct(cursor, lexer.LBrace)?
    var fields = []
    var step = line_opening(opened, lexer.RBrace)?
    for is_open(step) {
        let field = record_field(cursor_of(step))?
        fields = list.push(fields, field.value)
        step = line_opening(after_line(field.cursor, lexer.RBrace)?, lexer.RBrace)?
    }
    Ok(Parsed { value: fields, cursor: cursor_of(step) })
}

/// `name: Type`, one line of a record body.
// example: position_after(record_field(over("id: Int"))) == 3
fn record_field(cursor: Cursor) -> Result<Parsed<ast.RecordField>, ParseError> {
    let start = offset(cursor)
    let name = expect_name(cursor, NameWanted)?
    let colon = expect_punct(name.cursor, lexer.Colon)?
    let written = type_ref(colon)?
    Ok(Parsed { value: ast.RecordField { name: name.value, type_ref: written.value, span: span_since(written.cursor, start) }, cursor: written.cursor })
}

/// `trait Eq<T> { … }`: a name, the one type it is written over, and a signature per line.
// example: item_printed(trait_item(over("trait Named<T> {\n    fn name(value: T) -> String\n}"))) == "trait Named 0..50\n  type-parameter T 12..13\n  signature name 21..48\n    parameter value 29..37\n      named-type T 36..37\n    result\n      named-type String 42..48\n"
fn trait_item(cursor: Cursor) -> Result<Parsed<ast.Item>, ParseError> {
    let start = offset(cursor)
    let past_trait = expect_keyword(cursor, lexer.Trait)?
    let name = expect_name(past_trait, NameWanted)?
    let opened_angle = expect_punct(name.cursor, lexer.Lt)?
    let written_over = expect_name(opened_angle, NameWanted)?
    let closed_angle = expect_punct(written_over.cursor, lexer.Gt)?
    let opened = expect_punct(closed_angle, lexer.LBrace)?
    var methods = []
    var step = body_opening(opened, 0)
    for is_open(step) {
        let method = signature(cursor_of(step))?
        methods = list.push(methods, method.value)
        step = body_opening(method.cursor, 1)
    }
    let declared = ast.TraitDeclaration { name: name.value, parameter: written_over.value, methods: methods, span: span_since(cursor_of(step), start), visibility: ast.Public }
    Ok(Parsed { value: ast.Trait(declared), cursor: cursor_of(step) })
}

/// A function's first line with no body, which is what a trait declares a method as.
// example: position_after(signature(over("fn go() -> Int"))) == 6
fn signature(cursor: Cursor) -> Result<Parsed<ast.Signature>, ParseError> {
    let start = offset(cursor)
    let past_fn = expect_keyword(cursor, lexer.Fn)?
    let name = expect_name(past_fn, FunctionNameWanted)?
    let shape = takes_and_gives(name.cursor)?
    let declared = ast.Signature { name: name.value, parameters: shape.value.parameters, result: shape.value.result, span: span_since(shape.cursor, start) }
    Ok(Parsed { value: declared, cursor: shape.cursor })
}

/// `instance Eq<Point> { … }`: a trait, the type it is for, and a body for each of its methods.
///
/// Each method carries the instance's type parameters, because the method is generic in them
/// exactly as a constrained function is.
// example: item_printed(instance_item(over("instance<T> Show<Box<T>> {\n    fn shown(value: Box<T>) -> String {\n        \"box\"\n    }\n}"))) == "instance Show<Box> 0..88\n  function shown 31..86\n    type-parameter T 9..10\n    parameter value 40..53\n      named-type Box 47..53\n        named-type T 51..52\n    result\n      named-type String 58..64\n    block 65..86\n      string \"box\" 75..80\n"
fn instance_item(cursor: Cursor) -> Result<Parsed<ast.Item>, ParseError> {
    let start = offset(cursor)
    let past_instance = expect_keyword(cursor, lexer.Instance)?
    let over_types = constrained_parameters(past_instance)?
    let trait_name = expect_name(over_types.cursor, TraitWanted)?
    let opened_angle = expect_punct(trait_name.cursor, lexer.Lt)?
    let for_type = expect_name(opened_angle, TypeWanted)?
    let arguments = type_parameters(for_type.cursor)?
    let closed_angle = expect_punct(arguments.cursor, lexer.Gt)?
    let opened = expect_punct(closed_angle, lexer.LBrace)?
    var methods = []
    var step = body_opening(opened, 0)
    for is_open(step) {
        let method = function_declaration(cursor_of(step))?
        let generic = method.value
        methods = list.push(methods, generic { type_parameters: over_types.value })
        step = body_opening(method.cursor, 1)
    }
    let declared = ast.InstanceDeclaration { trait_name: trait_name.value, type_parameters: over_types.value, for_type: for_type.value, arguments: arguments.value, methods: methods, span: span_since(cursor_of(step), start) }
    Ok(Parsed { value: ast.Instance(declared), cursor: cursor_of(step) })
}

/// `process Counter { … }`: the name of a process, and each function written inside the braces.
///
/// Any number of functions parses here, because the type phase holds them to the one process shape.
// example: item_printed(process_item(over("process Counter {\n    fn start() -> Int {\n        0\n    }\n}"))) == "process Counter 0..59\n  function start 22..57\n    result\n      named-type Int 36..39\n    block 40..57\n      integer 0 50..51\n"
fn process_item(cursor: Cursor) -> Result<Parsed<ast.Item>, ParseError> {
    let start = offset(cursor)
    let past_process = expect_keyword(cursor, lexer.Process)?
    let name = expect_name(past_process, NameWanted)?
    let opened = expect_punct(name.cursor, lexer.LBrace)?
    var functions = []
    var step = body_opening(opened, 0)
    for is_open(step) {
        let function = function_declaration(cursor_of(step))?
        functions = list.push(functions, function.value)
        step = body_opening(function.cursor, 1)
    }
    let declared = ast.ProcessDeclaration { name: name.value, functions: functions, span: span_since(cursor_of(step), start), visibility: ast.Public }
    Ok(Parsed { value: ast.Process(declared), cursor: cursor_of(step) })
}

/// `test "name" { … }`: the name of a test in quotes, and the block whose value says it holds.
// example: item_printed(test_item(over("test \"sums\" {\n    true\n}"))) == "test \"sums\" 0..24\n  block 12..24\n    bool true 18..22\n"
// example: failed(test_item(over("test sums {"))) == "5..9 expected the name of the test in quotes, found `sums`\n"
fn test_item(cursor: Cursor) -> Result<Parsed<ast.Item>, ParseError> {
    let start = offset(cursor)
    let past_test = expect_keyword(cursor, lexer.Test)?
    let token = expect(past_test, lexer.String, TestNameWanted)?
    let text = decode_string(token.value)?
    let body = block(token.cursor)?
    let declared = ast.TestDeclaration { name: ast.Name { text: text, span: token.value.span }, body: body.value, span: span_since(body.cursor, start) }
    Ok(Parsed { value: ast.Test(declared), cursor: body.cursor })
}

/// `derive Eq, Ord for User`: the traits the compiler writes, and the type it writes them for.
// example: item_printed(derive_item(over("derive Eq, Hash for Id"))) == "derive Eq, Hash for Id 0..22\n"
fn derive_item(cursor: Cursor) -> Result<Parsed<ast.Item>, ParseError> {
    let start = offset(cursor)
    let past_derive = expect_keyword(cursor, lexer.Derive)?
    let first = expect_name(past_derive, NameWanted)?
    var traits = [first.value]
    var after = first.cursor
    for is_at_punct(after, lexer.Comma) {
        let next = expect_name(advanced(after), NameWanted)?
        traits = list.push(traits, next.value)
        after = next.cursor
    }
    let past_for = expect_keyword(after, lexer.For)?
    let for_type = expect_name(past_for, NameWanted)?
    let declared = ast.DeriveDeclaration { traits: traits, for_type: for_type.value, span: span_since(for_type.cursor, start) }
    Ok(Parsed { value: ast.Derive(declared), cursor: for_type.cursor })
}

/// `fn name<T>(parameter: Type) -> Type { … }`.
// example: printed("fn go() {\n}") == "function go 0..11\n  block 8..11\n"
// example: failed(function_declaration(over("fn (x)"))) == "3..4 expected a function name, found `(`\nhelp: every function has a name; Bux has no anonymous functions\n"
fn function_declaration(cursor: Cursor) -> Result<Parsed<ast.FunctionDeclaration>, ParseError> {
    let start = offset(cursor)
    let past_fn = expect_keyword(cursor, lexer.Fn)?
    let name = expect_name(past_fn, FunctionNameWanted)?
    let generic = constrained_parameters(name.cursor)?
    let shape = takes_and_gives(generic.cursor)?
    let body = block(shape.cursor)?
    let declared = ast.FunctionDeclaration { name: name.value, type_parameters: generic.value, parameters: shape.value.parameters, result: shape.value.result, body: body.value, span: span_since(body.cursor, start), visibility: ast.Public }
    Ok(Parsed { value: declared, cursor: body.cursor })
}

/// `(one: Int, other: Int) -> Bool`: what a function takes, and what it gives back.
// example: position_after(takes_and_gives(over("(one: Int) -> Bool {"))) == 7
fn takes_and_gives(cursor: Cursor) -> Result<Parsed<Shape>, ParseError> {
    let opened = expect_punct(cursor, lexer.LParen)?
    var parameters = []
    var step = opening(opened, lexer.RParen, MayBeEmpty)
    for is_open(step) {
        let declared = parameter(cursor_of(step))?
        parameters = list.push(parameters, declared.value)
        step = after_element(declared.cursor, lexer.RParen)?
    }
    let result = result_type(cursor_of(step))?
    Ok(Parsed { value: Shape { parameters: parameters, result: result.value }, cursor: result.cursor })
}

/// A name, and the type annotation the author may have left to inference.
// example: position_after(parameter(over("count: Int"))) == 3
// example: position_after(parameter(over("count)"))) == 1
fn parameter(cursor: Cursor) -> Result<Parsed<ast.Parameter>, ParseError> {
    let start = offset(cursor)
    let name = expect_name(cursor, NameWanted)?
    if !is_at_punct(name.cursor, lexer.Colon) {
        return Ok(Parsed { value: ast.Parameter { name: name.value, type_ref: None, span: span_since(name.cursor, start) }, cursor: name.cursor })
    }
    let written = type_ref(advanced(name.cursor))?
    Ok(Parsed { value: ast.Parameter { name: name.value, type_ref: Some(written.value), span: span_since(written.cursor, start) }, cursor: written.cursor })
}

/// The result type after `->`, which a function need not declare.
// example: position_after(result_type(over("-> Int"))) == 2
// example: position_after(result_type(over("{"))) == 0
fn result_type(cursor: Cursor) -> Result<Parsed<Option<ast.TypeRef>>, ParseError> {
    if !is_at_punct(cursor, lexer.Arrow) {
        return Ok(Parsed { value: None, cursor: cursor })
    }
    let written = type_ref(advanced(cursor))?
    Ok(Parsed { value: Some(written.value), cursor: written.cursor })
}

/// A `{ … }` body, one statement per line, which spends one level of the nesting budget.
// example: position_after(block(over("{\n    x\n}"))) == 4
fn block(cursor: Cursor) -> Result<Parsed<ast.Block>, ParseError> {
    let start = offset(cursor)
    let opened = expect_punct(cursor, lexer.LBrace)?
    let inside = deeper(opened)?
    var statements = []
    var step = line_opening(inside, lexer.RBrace)?
    for is_open(step) {
        let written = statement(cursor_of(step))?
        statements = list.push(statements, written.value)
        step = line_opening(after_line(written.cursor, lexer.RBrace)?, lexer.RBrace)?
    }
    let closed = cursor_of(step)
    Ok(Parsed { value: ast.Block { statements: statements, span: span_since(closed, start) }, cursor: shallower(closed) })
}

/// One statement of a block.
// example: position_after(statement(over("total += 1"))) == 3
fn statement(cursor: Cursor) -> Result<Parsed<ast.Statement>, ParseError> {
    let start = offset(cursor)
    let kind = statement_kind(cursor)?
    Ok(Parsed { value: ast.Statement { kind: kind.value, span: span_since(kind.cursor, start) }, cursor: kind.cursor })
}

/// Which statement the cursor is at, which its first token or two say.
// example: position_after(statement_kind(over("break"))) == 1
fn statement_kind(cursor: Cursor) -> Result<Parsed<ast.StatementKind>, ParseError> {
    if is_at_keyword(cursor, lexer.Let) || is_at_keyword(cursor, lexer.Var) {
        return binding(cursor)
    }
    if is_at_keyword(cursor, lexer.Return) {
        return return_statement(cursor)
    }
    if is_at_keyword(cursor, lexer.Break) {
        return Ok(Parsed { value: ast.Break, cursor: advanced(cursor) })
    }
    if is_at_keyword(cursor, lexer.ContinueLoop) {
        return Ok(Parsed { value: ast.ContinueLoop, cursor: advanced(cursor) })
    }
    if is_at_keyword(cursor, lexer.For) {
        return for_statement(cursor)
    }
    if is_at_colon_equals(cursor) {
        return Err(colon_equals(cursor))
    }
    if is_at_keyword(cursor, lexer.Underscore) {
        return discard(cursor)
    }
    if is_at_keyword(cursor, lexer.Test) {
        return Err(failure(cursor, TestInABody))
    }
    expression_statement(cursor)
}

/// `let total = 0` binds a name never assigned to again; `var total = 0` binds one that may be.
///
/// The keyword alone says which of the two a name is, and `=` joins the name to its value.
// example: failed(binding(over("let total == 0"))) == "10..12 expected `=`, found `==`\n"
fn binding(from: Cursor) -> Result<Parsed<ast.StatementKind>, ParseError> {
    var mutability = ast.Immutable
    if is_at_keyword(from, lexer.Var) {
        mutability = ast.Mutable
    }
    let name = expect_name(advanced(from), NameWanted)?
    let past_joiner = expect_punct(name.cursor, lexer.Eq)?
    let bound = expression(past_joiner, Allowed)?
    Ok(Parsed { value: ast.Binding { mutability: mutability, name: name.value, value: bound.value }, cursor: bound.cursor })
}

/// Whether the cursor is at `total :=`, which no statement starts with.
///
/// The `:` and the `=` touch, so `total : = 0` is not refused as `:=`, which it does not write.
// example: is_at_colon_equals(over("total := 0"))
// example: !is_at_colon_equals(over("total : = 0"))
// example: !is_at_colon_equals(over("total = 0"))
fn is_at_colon_equals(cursor: Cursor) -> Bool {
    let colon = advanced(cursor)
    let equals = advanced(colon)
    let is_written = is_ahead(cursor, 0, lexer.Identifier) && is_at_punct(colon, lexer.Colon) && is_at_punct(equals, lexer.Eq)
    is_written && offset(colon) + 1 == offset(equals)
}

/// The refusal of `total := 0`, which binds with `let`, over the text from the name to the `=`.
// example: error_printed(colon_equals(over("total := 0"))) == "0..8 `:=` does not bind a name\nhelp: write `let total =`\n"
fn colon_equals(cursor: Cursor) -> ParseError {
    let past_equals = advanced(advanced(advanced(cursor)))
    let span = span_since(past_equals, offset(cursor))
    match token_at(cursor, 0) {
        Some(token) => ParseError { kind: ColonEquals(token.text), span: span }
        None => ParseError { kind: ColonEquals(""), span: span }
    }
}

/// `return`, with the value it gives back where the statement goes on.
// example: position_after(return_statement(over("return\n"))) == 1
// example: position_after(return_statement(over("return 1"))) == 2
fn return_statement(cursor: Cursor) -> Result<Parsed<ast.StatementKind>, ParseError> {
    let past_return = expect_keyword(cursor, lexer.Return)?
    if is_at_statement_end(past_return) {
        return Ok(Parsed { value: ast.Return(None), cursor: past_return })
    }
    let returned = expression(past_return, Allowed)?
    Ok(Parsed { value: ast.Return(Some(returned.value)), cursor: returned.cursor })
}

/// A `for` loop: what it loops over, and its body.
// example: position_after(for_statement(over("for {\n}"))) == 3
fn for_statement(cursor: Cursor) -> Result<Parsed<ast.StatementKind>, ParseError> {
    let past_for = expect_keyword(cursor, lexer.For)?
    let header = for_header(past_for)?
    let body = block(cursor: header.cursor)?
    Ok(Parsed { value: ast.For(ast.ForLoop { header: header.value, body: body.value }), cursor: body.cursor })
}

/// What a `for` loops over: a collection, a condition, or nothing at all.
// example: position_after(for_header(over("user in users {"))) == 3
// example: position_after(for_header(over("{"))) == 0
fn for_header(cursor: Cursor) -> Result<Parsed<ast.ForHeader>, ParseError> {
    if is_at_punct(cursor, lexer.LBrace) {
        return Ok(Parsed { value: ast.Forever, cursor: cursor })
    }
    if is_ahead(cursor, 0, lexer.Identifier) && is_ahead(cursor, 1, lexer.Keyword(lexer.In)) {
        let bound_name = expect_name(cursor, NameWanted)?
        return looped_over(bound_name.value, bound_name.cursor)
    }
    if is_ahead(cursor, 0, lexer.Keyword(lexer.Underscore)) && is_ahead(cursor, 1, lexer.Keyword(lexer.In)) {
        return looped_over(discarded_name(cursor), advanced(cursor))
    }
    let condition = expression(cursor, Forbidden)?
    Ok(Parsed { value: ast.While(condition.value), cursor: condition.cursor })
}

/// `in values`, after the name each value is bound to, which `_` binds to nothing.
// example: position_after(looped_over(discarded_name(over("_ in users {")), advanced(over("_ in users {")))) == 3
fn looped_over(bound: ast.Name, cursor: Cursor) -> Result<Parsed<ast.ForHeader>, ParseError> {
    let past_in = expect_keyword(cursor, lexer.In)?
    let iterable = expression(past_in, Forbidden)?
    Ok(Parsed { value: ast.Over { binding: bound, iterable: iterable.value }, cursor: iterable.cursor })
}

/// The `_` a `for` writes where a loop reads none of the values, as a name no one can write.
// example: discarded_name(over("_ in users")).text == "_"
fn discarded_name(cursor: Cursor) -> ast.Name {
    ast.Name { text: "_", span: lexer.Span { start: offset(cursor), length: 1 } }
}

/// `_ = save(user)`, which works the value out and throws it away on purpose.
///
/// `_` is no name, so `=` is all that may follow it.
// example: failed(discard(over("_ += 1"))) == "2..4 expected `=`, found `+=`\n"
fn discard(cursor: Cursor) -> Result<Parsed<ast.StatementKind>, ParseError> {
    let past_discard = expect_keyword(cursor, lexer.Underscore)?
    let equals = expect_punct(past_discard, lexer.Eq)?
    let thrown = expression(equals, Allowed)?
    Ok(Parsed { value: ast.Discard(thrown.value), cursor: thrown.cursor })
}

/// An expression, which becomes an assignment when `=` or `+=` follows it.
// example: position_after(expression_statement(over("total += 1"))) == 3
// example: failed(expression_statement(over("user.name = x"))) == "0..9 only a name is assigned to\nhelp: build the value it becomes: `user { name: \"Bob\" }`\n"
fn expression_statement(cursor: Cursor) -> Result<Parsed<ast.StatementKind>, ParseError> {
    let written = expression(cursor, Allowed)?
    if !is_at_punct(written.cursor, lexer.Eq) && !is_at_punct(written.cursor, lexer.PlusEq) {
        return Ok(Parsed { value: ast.Evaluated(written.value), cursor: written.cursor })
    }
    var operator = ast.SetTo
    if is_at_punct(written.cursor, lexer.PlusEq) {
        operator = ast.AddTo
    }
    let target = assigned_to(written.value)?
    let assigned = expression(advanced(written.cursor), Allowed)?
    Ok(Parsed { value: ast.Assign { target: target, operator: operator, value: assigned.value }, cursor: assigned.cursor })
}

/// The name an assignment changes, which is all the left of `=` or `+=` may be.
// example: failed_with(assigned_to(ast.Expr { kind: ast.Unit, span: lexer.Span { start: 0, length: 2 } })) == "0..2 only a name is assigned to\nhelp: build the value it becomes: `user { name: \"Bob\" }`\n"
fn assigned_to(written: ast.Expr) -> Result<ast.Name, ParseError> {
    match written.kind {
        ast.NameExpr(name) => Ok(name)
        _ => Err(ParseError { kind: AssignedToValue, span: written.span })
    }
}

/// An expression, by precedence, the loosest operator first.
// example: expression_printed(expression(over("a + b * c"), Allowed)) == "binary Add 0..9\n  name a 0..1\n  binary Multiply 4..9\n    name b 4..5\n    name c 8..9\n"
fn expression(cursor: Cursor, records: RecordLiterals) -> Result<Parsed<ast.Expr>, ParseError> {
    binary(cursor, records, 0)
}

/// The operators of `level` and every level tighter, each left-associative.
///
/// A comparison does not chain: `a < b < c` is an error rather than a nested comparison.
// example: failed(binary(over("a < b < c"), Allowed, 0)) == "6..7 comparisons do not chain\nhelp: compare twice and join the two with `&&`\n"
fn binary(cursor: Cursor, records: RecordLiterals, level: Int) -> Result<Parsed<ast.Expr>, ParseError> {
    if level == 5 {
        return unary(cursor, records)
    }
    let start = offset(cursor)
    let first = binary(cursor, records, level + 1)?
    var left = first.value
    var after = first.cursor
    for level_at(after) == level {
        let right = binary(advanced(after), records, level + 1)?
        left = joined(left: left, operator: operator_at(after), right: right.value, span: span_since(right.cursor, start))
        after = right.cursor
        if level == 2 && level_at(after) == level {
            return Err(failure(after, ChainedComparison))
        }
    }
    Ok(Parsed { value: left, cursor: after })
}

/// Two operands and the operator between them, which the precedence level already found there.
///
/// A match that gives a variant of a type from another module fails the JVM's verifier, so this
/// match gives a whole node, which is of one class in both arms.
// example: ast.expression_lines(joined(left: ast.Expr { kind: ast.Unit, span: lexer.Span { start: 0, length: 2 } }, operator: None, right: ast.Expr { kind: ast.Unit, span: lexer.Span { start: 3, length: 2 } }, span: lexer.Span { start: 0, length: 5 }), 0) == "unit 0..2\n"
fn joined(left: ast.Expr, operator: Option<ast.BinaryOperator>, right: ast.Expr, span: lexer.Span) -> ast.Expr {
    match operator {
        Some(between) => ast.Expr { kind: ast.Binary { operator: between, left: left, right: right }, span: span }
        None => left
    }
}

/// The precedence level of the infix operator at the cursor, loosest first, and -1 where none is.
// example: level_at(over("||")) == 0
// example: level_at(over("*")) == 4
// example: level_at(over("x")) == -1
fn level_at(cursor: Cursor) -> Int {
    match token_at(cursor, 0) {
        Some(token) => level_of(token.kind)
        None => -1
    }
}

/// The precedence level of an infix operator, loosest first, and -1 for any other token.
// example: level_of(lexer.Punct(lexer.EqEq)) == 2
fn level_of(kind: lexer.TokenKind) -> Int {
    if kind == lexer.Punct(lexer.OrOr) {
        return 0
    }
    if kind == lexer.Punct(lexer.AndAnd) {
        return 1
    }
    if is_comparison(kind) {
        return 2
    }
    if kind == lexer.Punct(lexer.Plus) || kind == lexer.Punct(lexer.Minus) {
        return 3
    }
    if kind == lexer.Punct(lexer.Star) || kind == lexer.Punct(lexer.Slash) || kind == lexer.Punct(lexer.Percent) {
        return 4
    }
    -1
}

/// Whether `kind` is one of the six comparisons, which share a level and do not chain.
// example: is_comparison(lexer.Punct(lexer.GtEq))
// example: !is_comparison(lexer.Punct(lexer.Plus))
fn is_comparison(kind: lexer.TokenKind) -> Bool {
    match kind {
        lexer.Punct(punctuation) => is_comparing(punctuation)
        _ => false
    }
}

/// Whether `punctuation` compares two values.
// example: is_comparing(lexer.BangEq)
fn is_comparing(punctuation: lexer.Punct) -> Bool {
    punctuation == lexer.EqEq || punctuation == lexer.BangEq || punctuation == lexer.Lt || punctuation == lexer.LtEq || punctuation == lexer.Gt || punctuation == lexer.GtEq
}

/// The infix operator at the cursor, where one is there.
// example: ast.binary_word(or(operator_at(over("<=")), ast.Add)) == "LessOrEqual"
fn operator_at(cursor: Cursor) -> Option<ast.BinaryOperator> {
    match token_at(cursor, 0) {
        Some(token) => operator_of(token.kind)
        None => None
    }
}

/// The infix operator `kind` spells, where it spells one.
// example: ast.binary_word(or(operator_of(lexer.Punct(lexer.Percent)), ast.Add)) == "Remainder"
fn operator_of(kind: lexer.TokenKind) -> Option<ast.BinaryOperator> {
    match kind {
        lexer.Punct(punctuation) => infix_operator(punctuation)
        _ => None
    }
}

/// The infix operator `punctuation` spells, where it spells one.
// example: ast.binary_word(or(infix_operator(lexer.OrOr), ast.Add)) == "Or"
fn infix_operator(punctuation: lexer.Punct) -> Option<ast.BinaryOperator> {
    match punctuation {
        lexer.EqEq => Some(ast.Equal)
        lexer.BangEq => Some(ast.NotEqual)
        lexer.LtEq => Some(ast.LessOrEqual)
        lexer.GtEq => Some(ast.GreaterOrEqual)
        lexer.AndAnd => Some(ast.And)
        lexer.OrOr => Some(ast.Or)
        lexer.Lt => Some(ast.Less)
        lexer.Gt => Some(ast.Greater)
        lexer.Plus => Some(ast.Add)
        lexer.Minus => Some(ast.Subtract)
        lexer.Star => Some(ast.Multiply)
        lexer.Slash => Some(ast.Divide)
        lexer.Percent => Some(ast.Remainder)
        _ => None
    }
}

/// A `!`, a `-`, or `spawn` before an operand, or the operand alone.
///
/// A `-` before a number is part of that number, so the smallest whole number can be written.
// example: expression_printed(unary(over("-5"), Allowed)) == "integer -5 0..2\n"
// example: expression_printed(unary(over("!x"), Allowed)) == "unary Not 0..2\n  name x 1..2\n"
fn unary(cursor: Cursor, records: RecordLiterals) -> Result<Parsed<ast.Expr>, ParseError> {
    let start = offset(cursor)
    if is_at_punct(cursor, lexer.Bang) {
        return prefixed(advanced(cursor), records, ast.Not, start)
    }
    if is_at_keyword(cursor, lexer.Spawn) {
        return spawned(advanced(cursor), records, start)
    }
    if !is_at_punct(cursor, lexer.Minus) {
        return postfix(cursor, records)
    }
    if is_ahead(advanced(cursor), 0, lexer.Integer) {
        return negative_number(advanced(cursor), start)
    }
    prefixed(advanced(cursor), records, ast.Negate, start)
}

/// The operand after a prefix operator, which spends one level of the nesting budget.
// example: expression_printed(prefixed(over("x"), Allowed, ast.Negate, 0)) == "unary Negate 0..1\n  name x 0..1\n"
fn prefixed(cursor: Cursor, records: RecordLiterals, operator: ast.UnaryOperator, start: Int) -> Result<Parsed<ast.Expr>, ParseError> {
    let inside = deeper(cursor)?
    let operand = unary(cursor: inside, records: records)?
    let kind = ast.Unary { operator: operator, operand: operand.value }
    Ok(Parsed { value: ast.Expr { kind: kind, span: span_since(operand.cursor, start) }, cursor: shallower(operand.cursor) })
}

/// The call after `spawn`, which starts a process, and which spends one level of the nesting budget.
///
/// The parser takes any operand here, and the type phase refuses one that names no process.
// example: expression_printed(spawned(over("Counter(0)"), Allowed, 0)) == "spawn 0..10\n  call 0..10\n    name Counter 0..7\n    integer 0 8..9\n"
fn spawned(cursor: Cursor, records: RecordLiterals, start: Int) -> Result<Parsed<ast.Expr>, ParseError> {
    let inside = deeper(cursor)?
    let started = postfix(inside, records)?
    let kind = ast.Spawn(started.value)
    Ok(Parsed { value: ast.Expr { kind: kind, span: span_since(started.cursor, start) }, cursor: shallower(started.cursor) })
}

/// The number after a `-`, which the `-` is part of, and whatever is applied to it after.
// example: expression_printed(negative_number(over("9223372036854775808"), 0)) == "integer -9223372036854775808 0..19\n"
fn negative_number(cursor: Cursor, start: Int) -> Result<Parsed<ast.Expr>, ParseError> {
    let token = expect(cursor, lexer.Integer, ExpressionWanted)?
    let span = span_since(token.cursor, start)
    let value = decode_integer("-" + token.value.text, span)?
    postfix_chain(ast.Expr { kind: ast.Integer(value), span: span }, token.cursor, start)
}

/// One operand, and the calls, fields, and `?` applied to it.
// example: expression_printed(postfix(over("f(x)?"), Allowed)) == "try 0..5\n  call 0..4\n    name f 0..1\n    name x 2..3\n"
fn postfix(cursor: Cursor, records: RecordLiterals) -> Result<Parsed<ast.Expr>, ParseError> {
    let start = offset(cursor)
    let base = primary(cursor, records)?
    postfix_chain(base.value, base.cursor, start)
}

/// A call, a field, or a `?`, applied left to right to whatever came before it.
// example: position_after(postfix_chain(ast.Expr { kind: ast.Unit, span: lexer.Span { start: 0, length: 0 } }, over(".name?"), 0)) == 3
fn postfix_chain(base: ast.Expr, from: Cursor, start: Int) -> Result<Parsed<ast.Expr>, ParseError> {
    var expr = base
    var cursor = from
    for is_at_punct(cursor, lexer.LParen) || is_at_punct(cursor, lexer.Dot) || is_at_punct(cursor, lexer.Question) {
        let applied = applied_to(expr, cursor)?
        expr = ast.Expr { kind: applied.value, span: span_since(applied.cursor, start) }
        cursor = applied.cursor
    }
    Ok(Parsed { value: expr, cursor: cursor })
}

/// The one call, field, or `?` at the cursor, applied to `expr`.
// example: position_after(applied_to(ast.Expr { kind: ast.Unit, span: lexer.Span { start: 0, length: 0 } }, over("?"))) == 1
fn applied_to(expr: ast.Expr, cursor: Cursor) -> Result<Parsed<ast.ExprKind>, ParseError> {
    if is_at_punct(cursor, lexer.LParen) {
        let passed = call_arguments(advanced(cursor))?
        return Ok(Parsed { value: ast.Call { callee: expr, arguments: passed.value }, cursor: passed.cursor })
    }
    if is_at_punct(cursor, lexer.Dot) {
        let name = expect_name(advanced(cursor), NameWanted)?
        return Ok(Parsed { value: ast.Field { receiver: expr, name: name.value }, cursor: name.cursor })
    }
    Ok(Parsed { value: ast.Try(expr), cursor: advanced(cursor) })
}

/// What a call passes, which is its values alone or each value with the parameter it is for.
///
/// The first argument settles which, because a call names all of its arguments or none of them.
// example: failed(call_arguments(over("old, to: new)"))) == "5..7 this call names some of its arguments and not others\nhelp: a call names all of its arguments or none of them\n"
// example: failed(call_arguments(over("from: old, new)"))) == "11..14 this call names some of its arguments and not others\nhelp: a call names all of its arguments or none of them\n"
fn call_arguments(cursor: Cursor) -> Result<Parsed<ast.Arguments>, ParseError> {
    if is_naming(cursor) {
        return named_arguments(cursor)
    }
    var values = []
    var step = opening(cursor, lexer.RParen, MayBeEmpty)
    for is_open(step) {
        let value = positional_argument(cursor_of(step))?
        values = list.push(values, value.value)
        step = after_element(value.cursor, lexer.RParen)?
    }
    Ok(Parsed { value: ast.Positional(values), cursor: cursor_of(step) })
}

/// Each argument with the parameter it is passed for, up to and including the `)`.
// example: position_after(named_arguments(over("from: old, to: new)"))) == 8
fn named_arguments(cursor: Cursor) -> Result<Parsed<ast.Arguments>, ParseError> {
    var arguments = []
    var step = opening(cursor, lexer.RParen, MayBeEmpty)
    for is_open(step) {
        let argument = named_argument(cursor_of(step))?
        arguments = list.push(arguments, argument.value)
        step = after_element(argument.cursor, lexer.RParen)?
    }
    Ok(Parsed { value: ast.Named(arguments), cursor: cursor_of(step) })
}

/// `from: old`: the parameter the value is passed for, and the value.
// example: position_after(named_argument(over("from: old"))) == 3
fn named_argument(cursor: Cursor) -> Result<Parsed<ast.NamedArgument>, ParseError> {
    if !is_naming(cursor) {
        return Err(failure(cursor, PartlyNamedCall))
    }
    let name = expect_name(cursor, NameWanted)?
    let colon = expect_punct(name.cursor, lexer.Colon)?
    let value = expression(cursor: colon, records: Allowed)?
    Ok(Parsed { value: ast.NamedArgument { name: name.value, value: value.value }, cursor: value.cursor })
}

/// `old`: the value alone, the first argument having settled that this call names none of them.
// example: position_after(positional_argument(over("old"))) == 1
fn positional_argument(cursor: Cursor) -> Result<Parsed<ast.Expr>, ParseError> {
    if is_naming(cursor) {
        return Err(failure(cursor, PartlyNamedCall))
    }
    expression(cursor: cursor, records: Allowed)
}

/// Whether the cursor is at a name and a `:`, which is how a call writes a parameter's name.
// example: is_naming(over("from: old"))
// example: !is_naming(over("old"))
fn is_naming(cursor: Cursor) -> Bool {
    is_ahead(cursor, 0, lexer.Identifier) && is_ahead(cursor, 1, lexer.Punct(lexer.Colon))
}

/// One value, which spends one level of the nesting budget.
// example: expression_printed(primary(over("(x)"), Allowed)) == "name x 0..3\n"
fn primary(cursor: Cursor, records: RecordLiterals) -> Result<Parsed<ast.Expr>, ParseError> {
    let start = offset(cursor)
    let inside = deeper(cursor)?
    let kind = primary_kind(inside, records)?
    Ok(Parsed { value: ast.Expr { kind: kind.value, span: span_since(kind.cursor, start) }, cursor: shallower(kind.cursor) })
}

/// What one value is: a literal, an `if`, a `match`, a bracket, or a name.
// example: position_after(primary_kind(over("true"), Allowed)) == 1
// example: failed(primary_kind(over("="), Allowed)) == "0..1 expected an expression, found `=`\n"
fn primary_kind(cursor: Cursor, records: RecordLiterals) -> Result<Parsed<ast.ExprKind>, ParseError> {
    match literal_at(cursor)? {
        Some(literal) => Ok(literal_expression(literal, advanced(cursor)))
        None => non_literal(cursor, records)
    }
}

/// The expression a literal is, and the cursor past it.
///
/// Each arm gives a whole `Parsed`, because a match that gives a variant of a type from another
/// module fails the JVM's verifier.
// example: ast.expression_lines(ast.Expr { kind: literal_expression(TruthLiteral(true), over("")).value, span: lexer.Span { start: 0, length: 4 } }, 0) == "bool true 0..4\n"
fn literal_expression(literal: Literal, after: Cursor) -> Parsed<ast.ExprKind> {
    match literal {
        IntegerLiteral(value) => Parsed { value: ast.Integer(value), cursor: after }
        TextLiteral(value) => Parsed { value: ast.Text(value), cursor: after }
        TruthLiteral(value) => Parsed { value: ast.Truth(value), cursor: after }
    }
}

/// A value that is no literal: an `if`, a `match`, a bracket, or a name.
// example: position_after(non_literal(over("()"), Allowed)) == 2
fn non_literal(cursor: Cursor, records: RecordLiterals) -> Result<Parsed<ast.ExprKind>, ParseError> {
    if is_at_keyword(cursor, lexer.If) {
        let chain = if_expression(cursor)?
        return Ok(Parsed { value: ast.If(chain.value), cursor: chain.cursor })
    }
    if is_at_keyword(cursor, lexer.Match) {
        let matched = match_expression(cursor)?
        return Ok(Parsed { value: ast.Match(matched.value), cursor: matched.cursor })
    }
    if is_at_punct(cursor, lexer.LParen) {
        return parenthesised(cursor)
    }
    if is_at_punct(cursor, lexer.LBracket) {
        return written_list(cursor)
    }
    if is_ahead(cursor, 0, lexer.Identifier) {
        return name_or_record(cursor, records)
    }
    Err(error(cursor, ExpressionWanted))
}

/// `()`, or an expression in parentheses, which takes the parentheses into its span.
// example: position_after(parenthesised(over("(a + b)"))) == 5
fn parenthesised(cursor: Cursor) -> Result<Parsed<ast.ExprKind>, ParseError> {
    let opened = expect_punct(cursor, lexer.LParen)?
    if is_at_punct(opened, lexer.RParen) {
        return Ok(Parsed { value: ast.Unit, cursor: advanced(opened) })
    }
    let inner = expression(cursor: opened, records: Allowed)?
    let closed = expect_punct(inner.cursor, lexer.RParen)?
    Ok(Parsed { value: inner.value.kind, cursor: closed })
}

/// `[first, second]`, or `[]`, which is the one way a list is written.
// example: position_after(written_list(over("[1, 2]"))) == 5
fn written_list(cursor: Cursor) -> Result<Parsed<ast.ExprKind>, ParseError> {
    let opened = expect_punct(cursor, lexer.LBracket)?
    var elements = []
    var step = opening(opened, lexer.RBracket, MayBeEmpty)
    for is_open(step) {
        let element = expression(cursor: cursor_of(step), records: Allowed)?
        elements = list.push(elements, element.value)
        step = after_element(element.cursor, lexer.RBracket)?
    }
    Ok(Parsed { value: ast.Written(elements), cursor: cursor_of(step) })
}

/// A name, or the record literal it heads, which is reached through a module or not.
// example: position_after(name_or_record(over("user { id: 1 }"), Allowed)) == 6
// example: position_after(name_or_record(over("user { id: 1 }"), Forbidden)) == 1
fn name_or_record(cursor: Cursor, records: RecordLiterals) -> Result<Parsed<ast.ExprKind>, ParseError> {
    if records == Allowed && is_record_of_a_module(cursor) {
        let base = expect_path(cursor, ExpressionWanted)?
        return record_literal(base.cursor, base.value)
    }
    let name = expect_name(cursor, ExpressionWanted)?
    if records == Forbidden || !is_at_punct(name.cursor, lexer.LBrace) {
        return Ok(Parsed { value: ast.NameExpr(name.value), cursor: name.cursor })
    }
    record_literal(name.cursor, ast.Path { module: None, name: name.value })
}

/// Whether the cursor is at `demo.User {`, the one dotted name a brace follows.
// example: is_record_of_a_module(over("demo.User {"))
// example: !is_record_of_a_module(over("demo.name"))
fn is_record_of_a_module(cursor: Cursor) -> Bool {
    is_ahead(cursor, 1, lexer.Punct(lexer.Dot)) && is_ahead(cursor, 2, lexer.Identifier) && is_ahead(cursor, 3, lexer.Punct(lexer.LBrace))
}

/// The `{ … }` after a base name, which builds a record or updates one.
// example: position_after(record_literal(over("{ id: 1 }"), ast.Path { module: None, name: ast.Name { text: "User", span: lexer.Span { start: 0, length: 4 } } })) == 5
fn record_literal(cursor: Cursor, base: ast.Path) -> Result<Parsed<ast.ExprKind>, ParseError> {
    let opened = expect_punct(cursor, lexer.LBrace)?
    var fields = []
    var step = opening(opened, lexer.RBrace, MayBeEmpty)
    for is_open(step) {
        let field = field_value(cursor_of(step))?
        fields = list.push(fields, field.value)
        step = after_element(field.cursor, lexer.RBrace)?
    }
    Ok(Parsed { value: ast.Record { base: base, fields: fields }, cursor: cursor_of(step) })
}

/// `name: value`, or a bare `name` that reads its binding, one field of a record literal.
// example: position_after(field_value(over("id: 1"))) == 3
// example: position_after(field_value(over("id }"))) == 1
fn field_value(cursor: Cursor) -> Result<Parsed<ast.FieldValue>, ParseError> {
    let start = offset(cursor)
    let name = expect_name(cursor, NameWanted)?
    if !is_at_punct(name.cursor, lexer.Colon) {
        return Ok(Parsed { value: ast.FieldValue { name: name.value, given: ast.Bare, span: name.value.span }, cursor: name.cursor })
    }
    let value = expression(cursor: advanced(name.cursor), records: Allowed)?
    Ok(Parsed { value: ast.FieldValue { name: name.value, given: ast.Given(value.value), span: span_since(value.cursor, start) }, cursor: value.cursor })
}

/// `if a { … } else if b { … } else { … }`, a flat chain of branches.
// example: position_after(if_expression(over("if a {\n} else if b {\n} else {\n}"))) == 12
fn if_expression(cursor: Cursor) -> Result<Parsed<ast.IfExpr>, ParseError> {
    let first = branch(cursor)?
    var branches = [first.value]
    var after = first.cursor
    var otherwise = None
    for is_at_keyword(after, lexer.Else) {
        let past_else = advanced(after)
        if is_at_keyword(past_else, lexer.If) {
            let next = branch(past_else)?
            branches = list.push(branches, next.value)
            after = next.cursor
            continue
        }
        let last = block(cursor: past_else)?
        otherwise = Some(last.value)
        after = last.cursor
        break
    }
    Ok(Parsed { value: ast.IfExpr { branches: branches, otherwise: otherwise }, cursor: after })
}

/// One `if condition { … }`, whether it opens the chain or follows an `else`.
// example: position_after(branch(over("if ok {\n}"))) == 4
fn branch(cursor: Cursor) -> Result<Parsed<ast.Branch>, ParseError> {
    let start = offset(cursor)
    let past_if = expect_keyword(cursor, lexer.If)?
    let condition = expression(cursor: past_if, records: Forbidden)?
    let body = block(cursor: condition.cursor)?
    Ok(Parsed { value: ast.Branch { condition: condition.value, block: body.value, span: span_since(body.cursor, start) }, cursor: body.cursor })
}

/// `match scrutinee { pattern => body … }`, one arm per line.
// example: position_after(match_expression(over("match x {\n    _ => 1\n}"))) == 8
fn match_expression(cursor: Cursor) -> Result<Parsed<ast.MatchExpr>, ParseError> {
    let past_match = expect_keyword(cursor, lexer.Match)?
    let scrutinee = expression(cursor: past_match, records: Forbidden)?
    let opened = expect_punct(scrutinee.cursor, lexer.LBrace)?
    var arms = []
    var step = line_opening(opened, lexer.RBrace)?
    for is_open(step) {
        let arm = match_arm(cursor_of(step))?
        arms = list.push(arms, arm.value)
        step = line_opening(after_line(arm.cursor, lexer.RBrace)?, lexer.RBrace)?
    }
    Ok(Parsed { value: ast.MatchExpr { scrutinee: scrutinee.value, arms: arms }, cursor: cursor_of(step) })
}

/// `Failed(reason) => "Failed: " + reason`.
// example: position_after(match_arm(over("Some(x) => x"))) == 6
fn match_arm(cursor: Cursor) -> Result<Parsed<ast.MatchArm>, ParseError> {
    let start = offset(cursor)
    let matched = pattern(cursor)?
    let arrow = expect_punct(matched.cursor, lexer.FatArrow)?
    let body = expression(cursor: arrow, records: Allowed)?
    Ok(Parsed { value: ast.MatchArm { pattern: matched.value, body: body.value, span: span_since(body.cursor, start) }, cursor: body.cursor })
}

/// A pattern, which is one alternative or several written with a `|` between them.
// example: pattern_printed(pattern(over("On | Off"))) == "pattern-or 0..8\n  pattern On 0..2\n  pattern Off 5..8\n"
fn pattern(cursor: Cursor) -> Result<Parsed<ast.Pattern>, ParseError> {
    let start = offset(cursor)
    let first = alternative(cursor)?
    if !is_at_punct(first.cursor, lexer.Pipe) {
        return Ok(first)
    }
    var alternatives = [first.value]
    var after = first.cursor
    for is_at_punct(after, lexer.Pipe) {
        let next = alternative(advanced(after))?
        alternatives = list.push(alternatives, next.value)
        after = next.cursor
    }
    Ok(Parsed { value: ast.Pattern { kind: ast.OrPattern(alternatives), span: span_since(after, start) }, cursor: after })
}

/// One alternative, which is every form of pattern but the `|` that joins them.
// example: pattern_printed(alternative(over("_"))) == "pattern-wildcard 0..1\n"
fn alternative(cursor: Cursor) -> Result<Parsed<ast.Pattern>, ParseError> {
    let start = offset(cursor)
    let kind = pattern_kind(cursor)?
    Ok(Parsed { value: ast.Pattern { kind: kind.value, span: span_since(kind.cursor, start) }, cursor: kind.cursor })
}

/// What one alternative is: `_`, a literal, or a name with what it carries.
// example: failed(pattern_kind(over("("))) == "0..1 expected a pattern, found `(`\n"
fn pattern_kind(cursor: Cursor) -> Result<Parsed<ast.PatternKind>, ParseError> {
    if is_at_keyword(cursor, lexer.Underscore) {
        return Ok(Parsed { value: ast.Wildcard, cursor: advanced(cursor) })
    }
    match literal_at(cursor)? {
        Some(literal) => Ok(literal_pattern(literal, advanced(cursor)))
        None => named_pattern(cursor)
    }
}

/// The pattern a literal is, and the cursor past it, each arm a whole `Parsed` as in expressions.
// example: ast.pattern_lines(ast.Pattern { kind: literal_pattern(IntegerLiteral(3), over("")).value, span: lexer.Span { start: 0, length: 1 } }, 0) == "pattern-integer 3 0..1\n"
fn literal_pattern(literal: Literal, after: Cursor) -> Parsed<ast.PatternKind> {
    match literal {
        IntegerLiteral(value) => Parsed { value: ast.IntegerPattern(value), cursor: after }
        TextLiteral(value) => Parsed { value: ast.TextPattern(value), cursor: after }
        TruthLiteral(value) => Parsed { value: ast.TruthPattern(value), cursor: after }
    }
}

/// A name, reached through a module or not, or a variant matched on what it carries.
// example: pattern_printed(alternative(over("Failed(reason)"))) == "pattern-tuple Failed 0..14\n  pattern reason 7..13\n"
// example: pattern_printed(alternative(over("demo.Sent { how }"))) == "pattern-record demo.Sent 0..17\n  pattern-field how 12..15\n"
// example: position_after(named_pattern(over("demo.Sent { how }"))) == 6
fn named_pattern(cursor: Cursor) -> Result<Parsed<ast.PatternKind>, ParseError> {
    if !is_ahead(cursor, 0, lexer.Identifier) {
        return Err(error(cursor, PatternWanted))
    }
    let path = expect_path(cursor, PatternWanted)?
    if is_at_punct(path.cursor, lexer.LParen) {
        let inside = deeper(advanced(path.cursor))?
        let elements = pattern_list(inside)?
        return Ok(Parsed { value: ast.TuplePattern { path: path.value, elements: elements.value }, cursor: shallower(elements.cursor) })
    }
    if is_at_punct(path.cursor, lexer.LBrace) {
        let fields = field_names(advanced(path.cursor))?
        return Ok(Parsed { value: ast.RecordPattern { path: path.value, fields: fields.value }, cursor: fields.cursor })
    }
    Ok(Parsed { value: ast.NamePattern(path.value), cursor: path.cursor })
}

/// The patterns a variant is matched on, up to and including the `)`, and never none.
// example: position_after(pattern_list(over("a, _)"))) == 4
fn pattern_list(cursor: Cursor) -> Result<Parsed<List<ast.Pattern>>, ParseError> {
    var patterns = []
    var step = opening(cursor, lexer.RParen, NeverEmpty)
    for is_open(step) {
        let element = pattern(cursor: cursor_of(step))?
        patterns = list.push(patterns, element.value)
        step = after_element(element.cursor, lexer.RParen)?
    }
    Ok(Parsed { value: patterns, cursor: cursor_of(step) })
}

/// The `<…>` after a type name, which most types do not have, and which spends a nesting level.
// example: position_after(type_arguments(over("<Int>"))) == 3
// example: position_after(type_arguments(over("x"))) == 0
fn type_arguments(cursor: Cursor) -> Result<Parsed<List<ast.TypeRef>>, ParseError> {
    if !is_at_punct(cursor, lexer.Lt) {
        return Ok(Parsed { value: [], cursor: cursor })
    }
    let inside = deeper(advanced(cursor))?
    let types = type_list(inside, lexer.Gt)?
    Ok(Parsed { value: types.value, cursor: shallower(types.cursor) })
}

/// Types separated by commas, up to and including `close`, and never none.
// example: position_after(type_list(over("Int, ())"), lexer.RParen)) == 5
fn type_list(cursor: Cursor, close: lexer.Punct) -> Result<Parsed<List<ast.TypeRef>>, ParseError> {
    var types = []
    var step = opening(cursor, close, NeverEmpty)
    for is_open(step) {
        let written = type_ref(cursor: cursor_of(step))?
        types = list.push(types, written.value)
        step = after_element(written.cursor, close)?
    }
    Ok(Parsed { value: types, cursor: cursor_of(step) })
}

/// The `<T, E>` after a type name, naming the types it is generic over.
// example: position_after(type_parameters(over("<T, E> ="))) == 5
fn type_parameters(cursor: Cursor) -> Result<Parsed<List<ast.Name>>, ParseError> {
    if !is_at_punct(cursor, lexer.Lt) {
        return Ok(Parsed { value: [], cursor: cursor })
    }
    name_list(advanced(cursor), lexer.Gt)
}

/// The fields a record pattern binds, up to and including the `}`, which may be none.
///
/// `Point {}` binds no field, and matches every `Point` as a record pattern of fields does.
// example: position_after(field_names(over("}"))) == 1
// example: position_after(field_names(over("x, y }"))) == 4
fn field_names(cursor: Cursor) -> Result<Parsed<List<ast.Name>>, ParseError> {
    var names = []
    var step = opening(cursor, lexer.RBrace, MayBeEmpty)
    for is_open(step) {
        let name = expect_name(cursor_of(step), NameWanted)?
        names = list.push(names, name.value)
        step = after_element(name.cursor, lexer.RBrace)?
    }
    Ok(Parsed { value: names, cursor: cursor_of(step) })
}

/// Names separated by commas, up to and including `close`, and never none.
// example: failed(name_list(over("}"), lexer.RBrace)) == "0..1 expected a name, found `}`\n"
fn name_list(cursor: Cursor, close: lexer.Punct) -> Result<Parsed<List<ast.Name>>, ParseError> {
    var names = []
    var step = opening(cursor, close, NeverEmpty)
    for is_open(step) {
        let name = expect_name(cursor_of(step), NameWanted)?
        names = list.push(names, name.value)
        step = after_element(name.cursor, close)?
    }
    Ok(Parsed { value: names, cursor: cursor_of(step) })
}

/// The `<T, E>` or `<T: Eq<T>>` after a function name, naming the types it is written over.
// example: position_after(constrained_parameters(over("<T: Eq<T> + Hash<T>>("))) == 13
fn constrained_parameters(cursor: Cursor) -> Result<Parsed<List<ast.TypeParameter>>, ParseError> {
    if !is_at_punct(cursor, lexer.Lt) {
        return Ok(Parsed { value: [], cursor: cursor })
    }
    var parameters = []
    var step = opening(advanced(cursor), lexer.Gt, NeverEmpty)
    for is_open(step) {
        let declared = constrained_parameter(cursor_of(step))?
        parameters = list.push(parameters, declared.value)
        step = after_element(declared.cursor, lexer.Gt)?
    }
    Ok(Parsed { value: parameters, cursor: cursor_of(step) })
}

/// One type parameter, with the traits it is constrained by, a `+` between two of them.
// example: position_after(constrained_parameter(over("T: Eq<T>"))) == 6
fn constrained_parameter(cursor: Cursor) -> Result<Parsed<ast.TypeParameter>, ParseError> {
    let name = expect_name(cursor, NameWanted)?
    if !is_at_punct(name.cursor, lexer.Colon) {
        return Ok(Parsed { value: ast.TypeParameter { name: name.value, constraints: [] }, cursor: name.cursor })
    }
    let first = constraint(advanced(name.cursor))?
    var constraints = [first.value]
    var after = first.cursor
    for is_at_punct(after, lexer.Plus) {
        let next = constraint(advanced(after))?
        constraints = list.push(constraints, next.value)
        after = next.cursor
    }
    Ok(Parsed { value: ast.TypeParameter { name: name.value, constraints: constraints }, cursor: after })
}

/// `Eq<T>`: a trait, written over the one type it constrains.
// example: failed(constraint(over("Eq"))) == "0..2 expected `<`, found the end of the file\n"
fn constraint(cursor: Cursor) -> Result<Parsed<ast.Constraint>, ParseError> {
    let start = offset(cursor)
    let name = expect_name(cursor, TraitWanted)?
    let opened = expect_punct(name.cursor, lexer.Lt)?
    let inside = deeper(opened)?
    let argument = type_ref(cursor: inside)?
    let closed = expect_punct(shallower(argument.cursor), lexer.Gt)?
    Ok(Parsed { value: ast.Constraint { name: name.value, argument: argument.value, span: span_since(closed, start) }, cursor: closed })
}

/// `Int`, `List<User>`, `demo.Held<Int>`, or `()`.
// example: type_printed(type_ref(over("List<demo.Id>"))) == "named-type List 0..13\n  named-type demo.Id 5..12\n"
// example: failed(type_ref(over("List<>"))) == "5..6 expected a type, found `>`\n"
fn type_ref(cursor: Cursor) -> Result<Parsed<ast.TypeRef>, ParseError> {
    let start = offset(cursor)
    if is_at_punct(cursor, lexer.LParen) {
        let closed = expect_punct(advanced(cursor), lexer.RParen)?
        return Ok(Parsed { value: ast.TypeRef { kind: ast.UnitType, span: span_since(closed, start) }, cursor: closed })
    }
    let path = expect_path(cursor, TypeWanted)?
    let arguments = type_arguments(cursor: path.cursor)?
    let kind = ast.NamedType { path: path.value, arguments: arguments.value }
    Ok(Parsed { value: ast.TypeRef { kind: kind, span: span_since(arguments.cursor, start) }, cursor: arguments.cursor })
}

/// The literal at the cursor, where what is there is one, decoded.
// example: failed_with(literal_at(over("\"\\q\""))) == "1..3 `\\q` is not an escape\nhelp: the escapes are `\\\"`, `\\\\`, `\\n`, `\\t`, and `\\r`\n"
fn literal_at(cursor: Cursor) -> Result<Option<Literal>, ParseError> {
    match token_at(cursor, 0) {
        Some(token) => literal_of(token)
        None => Ok(None)
    }
}

/// The literal `token` spells, decoded, and nothing where it spells none.
// example: failed_with(literal_of(lexer.Token { kind: lexer.Integer, span: lexer.Span { start: 0, length: 19 }, text: "9223372036854775808" })) == "0..19 this number does not fit in a whole number\nhelp: the largest whole number is 9223372036854775807\n"
fn literal_of(token: lexer.Token) -> Result<Option<Literal>, ParseError> {
    match token.kind {
        lexer.Keyword(keyword) => Ok(truth_of(keyword))
        lexer.Integer => Ok(Some(IntegerLiteral(decode_integer(token.text, token.span)?)))
        lexer.String => Ok(Some(TextLiteral(decode_string(token)?)))
        _ => Ok(None)
    }
}

/// The literal `true` or `false` is, and nothing for every other keyword.
// example: ast.expression_lines(ast.Expr { kind: literal_expression(or(truth_of(lexer.False), TruthLiteral(true)), over("")).value, span: lexer.Span { start: 0, length: 5 } }, 0) == "bool false 0..5\n"
fn truth_of(keyword: lexer.Keyword) -> Option<Literal> {
    match keyword {
        lexer.True => Some(TruthLiteral(true))
        lexer.False => Some(TruthLiteral(false))
        _ => None
    }
}

/// The value of an integer literal, whose text is all digits after an optional `-`.
///
/// The value is built one digit at a time toward its own sign, so the smallest whole number is
/// built as well as the largest, and a digit that would carry it past either is refused.
// example: ok_or(decode_integer("-9223372036854775808", lexer.Span { start: 0, length: 20 }), 0) == -9223372036854775808
// example: failed_with(decode_integer("9223372036854775808", lexer.Span { start: 0, length: 19 })) == "0..19 this number does not fit in a whole number\nhelp: the largest whole number is 9223372036854775807\n"
fn decode_integer(text: String, span: lexer.Span) -> Result<Int, ParseError> {
    var sign = 1
    var index = 0
    var last_digit = 7
    if or(strings.at(text, 0), 0) == 45 {
        sign = -1
        index = 1
        last_digit = 8
    }
    var value = 0
    for index < strings.length(text) {
        let digit = sign * (or(strings.at(text, index), 48) - 48)
        if sign * value > 922337203685477580 || sign * value == 922337203685477580 && sign * digit > last_digit {
            return Err(ParseError { kind: IntegerTooLarge, span: span })
        }
        value = value * 10 + digit
        index += 1
    }
    Ok(value)
}

/// The value of a string literal, with its escapes resolved.
///
/// An unknown escape is refused at the backslash and the character after it, whose byte offsets
/// are counted in UTF-8 as every span is.
// example: ok_or(decode_string(lexer.Token { kind: lexer.String, span: lexer.Span { start: 0, length: 6 }, text: "\"a\\tb\"" }), "") == "a\tb"
// example: failed_with(decode_string(lexer.Token { kind: lexer.String, span: lexer.Span { start: 4, length: 6 }, text: "\"é\\q\"" })) == "7..9 `\\q` is not an escape\nhelp: the escapes are `\\\"`, `\\\\`, `\\n`, `\\t`, and `\\r`\n"
fn decode_string(token: lexer.Token) -> Result<String, ParseError> {
    let text = token.text
    let last = strings.length(text) - 1
    var value = ""
    var index = 1
    var bytes = 1
    for index < last {
        let letter = or(strings.cut(text, index, index + 1), "")
        if letter != "\\" {
            value += letter
            bytes += lexer.unit_width(or(strings.at(text, index), 0))
            index += 1
            continue
        }
        let escaped = lexer.Rest { source: text, start: index + 1 }
        let units = lexer.character_length(escaped)
        let character = or(strings.cut(text, index + 1, index + 1 + units), "")
        if !is_escape(character) {
            let span = lexer.Span { start: token.span.start + bytes, length: 1 + lexer.byte_length(escaped, units) }
            return Err(ParseError { kind: UnknownEscape(character), span: span })
        }
        value += unescaped(character)
        bytes += 2
        index += 2
    }
    Ok(value)
}

/// Whether a backslash before `character` writes an escape the language knows.
// example: is_escape("n")
// example: !is_escape("q")
fn is_escape(character: String) -> Bool {
    character == "\"" || character == "\\" || character == "n" || character == "t" || character == "r"
}

/// What a backslash makes of the character after it, which `is_escape` says it knows.
// example: unescaped("n") == "\n"
// example: unescaped("\\") == "\\"
fn unescaped(character: String) -> String {
    if character == "n" {
        return "\n"
    }
    if character == "t" {
        return "\t"
    }
    if character == "r" {
        return "\r"
    }
    character
}

/// Elements separated by commas, the opening bracket read: where the first element starts.
///
/// A list the grammar lets hold nothing is closed at once where `close` follows the bracket.
// example: is_open(opening(over(")"), lexer.RParen, NeverEmpty))
// example: !is_open(opening(over(")"), lexer.RParen, MayBeEmpty))
fn opening(cursor: Cursor, close: lexer.Punct, emptiness: Emptiness) -> Step {
    let skipped = skip_newline(cursor)
    if emptiness == MayBeEmpty && is_at_punct(skipped, close) {
        return Closed(advanced(skipped))
    }
    Open(skipped)
}

/// After one element of a comma-separated list: the `close` that ends it, or a comma and more.
///
/// A trailing comma is not canonical form and is not accepted, so `close` follows the last one.
// example: is_open(or_closed(after_element(over(", b"), lexer.RParen)))
// example: failed_step(after_element(over(",)"), lexer.RParen)) == ""
fn after_element(cursor: Cursor, close: lexer.Punct) -> Result<Step, ParseError> {
    let skipped = skip_newline(cursor)
    if is_at_punct(skipped, close) {
        return Ok(Closed(advanced(skipped)))
    }
    let comma = expect_punct(skipped, lexer.Comma)?
    Ok(Open(skip_newline(comma)))
}

/// Elements one per line, the `{` read: where the next element starts, or past the `close`.
// example: !is_open(or_closed(line_opening(over("}"), lexer.RBrace)))
// example: failed_step(line_opening(over(""), lexer.RBrace)) == "0..0 expected `}`, found the end of the file\n"
fn line_opening(cursor: Cursor, close: lexer.Punct) -> Result<Step, ParseError> {
    if is_at_punct(cursor, close) {
        return Ok(Closed(advanced(cursor)))
    }
    if is_at_end(cursor) {
        return Err(error(cursor, PunctWanted(close)))
    }
    Ok(Open(cursor))
}

/// After one element of a list written one per line: the newline that ends it, unless `close`
/// follows on the same line.
// example: failed_with(after_line(over("}"), lexer.RBrace)) == ""
fn after_line(cursor: Cursor, close: lexer.Punct) -> Result<Cursor, ParseError> {
    if is_at_punct(cursor, close) {
        return Ok(cursor)
    }
    expect_end_of_line(cursor)
}

/// The `{ … }` of a trait or an instance, the `{` read: where the next declaration starts.
///
/// A body holding nothing reads as the declaration that was wanted and is not there, so `}`
/// closes it only after `declared` declarations, which is at least one.
// example: is_open(body_opening(over("}"), 0))
// example: !is_open(body_opening(over("\n}"), 1))
fn body_opening(cursor: Cursor, declared: Int) -> Step {
    let skipped = skip_newline(cursor)
    if declared > 0 && is_at_punct(skipped, lexer.RBrace) {
        return Closed(advanced(skipped))
    }
    Open(skipped)
}

/// Whether a list goes on with another element.
// example: is_open(Open(over("")))
fn is_open(step: Step) -> Bool {
    match step {
        Open(_) => true
        Closed(_) => false
    }
}

/// Where a list goes on, or where it is over.
// example: cursor_of(Closed(over(""))).position == 0
fn cursor_of(step: Step) -> Cursor {
    match step {
        Open(cursor) => cursor
        Closed(cursor) => cursor
    }
}

/// The step a list takes after one element, and a closed list at the start where it failed.
// example: !is_open(or_closed(Err(error(over(""), NameWanted))))
fn or_closed(step: Result<Step, ParseError>) -> Step {
    match step {
        Ok(next) => next
        Err(_) => Closed(over(""))
    }
}

/// The cursor over the tokens of `source` that the grammar reads, at the first of them.
// example: over("fn // note\n").count == 1
// example: over("x\n\n\ny").count == 3
fn over(source: String) -> Cursor {
    let tokens = significant_tokens(lexer.lex(source))
    let count = list.length(tokens)
    let whole = lexer.Span { start: 0, length: lexer.byte_length(lexer.Rest { source: source, start: 0 }, strings.length(source)) }
    let ending = match list.at(tokens, count - 1) {
        Some(token) => token.span
        None => whole
    }
    Cursor { tokens: tokens, position: 0, depth: 0, count: count, ending: ending }
}

/// The tokens the grammar reads: no comments, and only the newlines that end something.
///
/// A newline ends something only where the token before it can be the last of a statement, a
/// field, a variant, or an arm, so a run of blank lines is one newline at most.
// example: list.length(significant_tokens(lexer.lex("a +\nb\n\n"))) == 4
fn significant_tokens(tokens: List<lexer.Token>) -> List<lexer.Token> {
    var kept = []
    var is_line_open = false
    for token in tokens {
        let is_kept = token.kind != lexer.LineComment && (token.kind != lexer.Newline || is_line_open)
        if is_kept {
            kept = list.push(kept, token)
            is_line_open = can_end_a_line(token.kind)
        }
    }
    kept
}

/// Whether a token of `kind` can be the last one of a statement, a field, a variant, or an arm.
// example: can_end_a_line(lexer.Punct(lexer.Gt))
// example: !can_end_a_line(lexer.Punct(lexer.Plus))
fn can_end_a_line(kind: lexer.TokenKind) -> Bool {
    match kind {
        lexer.Identifier => true
        lexer.Keyword(keyword) => keyword == lexer.True || keyword == lexer.False || keyword == lexer.Break || keyword == lexer.ContinueLoop || keyword == lexer.Return
        lexer.Integer => true
        lexer.String => true
        lexer.Punct(punctuation) => punctuation == lexer.RParen || punctuation == lexer.RBracket || punctuation == lexer.RBrace || punctuation == lexer.Gt || punctuation == lexer.Question
        _ => false
    }
}

/// The error a step fails with, printed, and `""` where it does not fail.
// example: failed_step(Ok(Open(over("")))) == ""
fn failed_step(step: Result<Step, ParseError>) -> String {
    match step {
        Ok(_) => ""
        Err(why) => error_printed(why)
    }
}

/// The identifier at the cursor, with the module it is reached through when a `.` follows.
///
/// A type and a pattern each name one thing, so a dot there opens no field and no call: it names
/// the module the name is reached inside of.
// example: ast.path_text(or_path(expect_path(over("demo.User"), TypeWanted))) == "demo.User"
fn expect_path(cursor: Cursor, expected: Expected) -> Result<Parsed<ast.Path>, ParseError> {
    let name = expect_name(cursor, expected)?
    if !is_at_punct(name.cursor, lexer.Dot) {
        return Ok(Parsed { value: ast.Path { module: None, name: name.value }, cursor: name.cursor })
    }
    let reached = expect_name(advanced(name.cursor), expected)?
    Ok(Parsed { value: ast.Path { module: Some(name.value), name: reached.value }, cursor: reached.cursor })
}

/// The path a parse gave, and an empty one where it failed.
// example: ast.path_text(or_path(Err(error(over(""), TypeWanted)))) == ""
fn or_path(parsed: Result<Parsed<ast.Path>, ParseError>) -> ast.Path {
    match parsed {
        Ok(done) => done.value
        Err(_) => ast.Path { module: None, name: ast.Name { text: "", span: lexer.Span { start: 0, length: 0 } } }
    }
}

/// The identifier at the cursor, as a name.
// example: position_after(expect_name(over("total"), NameWanted)) == 1
// example: failed(expect_name(over("fn"), NameWanted)) == "0..2 expected a name, found `fn`\n"
fn expect_name(cursor: Cursor, expected: Expected) -> Result<Parsed<ast.Name>, ParseError> {
    let token = expect(cursor, lexer.Identifier, expected)?
    Ok(Parsed { value: ast.Name { text: token.value.text, span: token.value.span }, cursor: token.cursor })
}

/// Past the punctuation `punctuation`, which the cursor must be at.
// example: failed_with(expect_punct(over(")"), lexer.RParen)) == ""
fn expect_punct(cursor: Cursor, punctuation: lexer.Punct) -> Result<Cursor, ParseError> {
    if is_at_punct(cursor, punctuation) {
        return Ok(advanced(cursor))
    }
    Err(error(cursor, PunctWanted(punctuation)))
}

/// Past the keyword `keyword`, which the cursor must be at.
// example: failed_with(expect_keyword(over("in"), lexer.For)) == "0..2 expected `for`, found `in`\n"
fn expect_keyword(cursor: Cursor, keyword: lexer.Keyword) -> Result<Cursor, ParseError> {
    if is_at_keyword(cursor, keyword) {
        return Ok(advanced(cursor))
    }
    Err(error(cursor, KeywordWanted(keyword)))
}

/// The token at the cursor, and the cursor past it, where the token is of `kind`.
// example: position_after(expect(over("1"), lexer.Integer, ExpressionWanted)) == 1
fn expect(cursor: Cursor, kind: lexer.TokenKind, expected: Expected) -> Result<Parsed<lexer.Token>, ParseError> {
    if !is_ahead(cursor, 0, kind) {
        return Err(error(cursor, expected))
    }
    match token_at(cursor, 0) {
        Some(token) => Ok(Parsed { value: token, cursor: advanced(cursor) })
        None => Err(error(cursor, expected))
    }
}

/// Past the newline that ends an item or a statement; the end of the file and a `}` end one too.
// example: failed_with(expect_end_of_line(over("x"))) == "0..1 expected the end of the line, found `x`\n"
fn expect_end_of_line(cursor: Cursor) -> Result<Cursor, ParseError> {
    if is_at_statement_end(cursor) {
        return Ok(skip_newline(cursor))
    }
    Err(error(cursor, EndOfLineWanted))
}

/// Past a newline that ends nothing, which is the one before a closing bracket.
// example: skip_newline(over("x\n)")).position == 0
fn skip_newline(cursor: Cursor) -> Cursor {
    if is_ahead(cursor, 0, lexer.Newline) {
        return advanced(cursor)
    }
    cursor
}

/// Whether nothing more of the current statement follows on this line.
// example: is_at_statement_end(over("}"))
// example: !is_at_statement_end(over("x"))
fn is_at_statement_end(cursor: Cursor) -> Bool {
    is_at_end(cursor) || is_ahead(cursor, 0, lexer.Newline) || is_at_punct(cursor, lexer.RBrace)
}

/// Whether the cursor is at the punctuation `punctuation`.
// example: is_at_punct(over("->"), lexer.Arrow)
fn is_at_punct(cursor: Cursor, punctuation: lexer.Punct) -> Bool {
    is_ahead(cursor, 0, lexer.Punct(punctuation))
}

/// Whether the cursor is at the keyword `keyword`.
// example: is_at_keyword(over("match"), lexer.Match)
fn is_at_keyword(cursor: Cursor, keyword: lexer.Keyword) -> Bool {
    is_ahead(cursor, 0, lexer.Keyword(keyword))
}

/// Whether the token `distance` tokens past the cursor is of `kind`.
// example: is_ahead(over("a b"), 1, lexer.Identifier)
// example: !is_ahead(over("a"), 1, lexer.Identifier)
fn is_ahead(cursor: Cursor, distance: Int, kind: lexer.TokenKind) -> Bool {
    match token_at(cursor, distance) {
        Some(token) => token.kind == kind
        None => false
    }
}

/// Whether every token has been read.
// example: is_at_end(over("// only a note"))
fn is_at_end(cursor: Cursor) -> Bool {
    cursor.position >= cursor.count
}

/// The cursor one token further on.
// example: advanced(over("a b")).position == 1
fn advanced(cursor: Cursor) -> Cursor {
    cursor { position: cursor.position + 1 }
}

/// One level deeper in the nesting budget, and an error where the budget is spent.
///
/// Brackets nest at most 32 deep, which keeps a generated file of many nested brackets from
/// running the parser out of stack, and canonical form never comes near it.
// example: failed_with(deeper(Cursor { tokens: [], position: 0, depth: 32, count: 0, ending: lexer.Span { start: 0, length: 1 } })) == "0..1 this nests too deeply to parse\nhelp: brackets nest at most 32 deep; name a part of it\n"
fn deeper(cursor: Cursor) -> Result<Cursor, ParseError> {
    if cursor.depth == 32 {
        return Err(failure(cursor, NestingTooDeep))
    }
    Ok(cursor { depth: cursor.depth + 1 })
}

/// One level back out of the nesting budget.
// example: shallower(Cursor { tokens: [], position: 0, depth: 2, count: 0, ending: lexer.Span { start: 0, length: 1 } }).depth == 1
fn shallower(cursor: Cursor) -> Cursor {
    cursor { depth: cursor.depth - 1 }
}

/// The byte offset the next token starts at, which is where a node's span starts.
// example: offset(advanced(over("ab cd"))) == 3
// example: offset(advanced(over("ab"))) == 2
fn offset(cursor: Cursor) -> Int {
    match token_at(cursor, 0) {
        Some(token) => token.span.start
        None => previous_end(cursor)
    }
}

/// The span from `start` to the end of the last token read.
// example: span_since(advanced(advanced(over("ab cd"))), 0).length == 5
fn span_since(cursor: Cursor, start: Int) -> lexer.Span {
    let length = previous_end(cursor) - start
    if length < 0 {
        return lexer.Span { start: start, length: 0 }
    }
    lexer.Span { start: start, length: length }
}

/// Where the last token read ended, which is where a token next to it would start.
// example: previous_end(over("ab")) == 0
fn previous_end(cursor: Cursor) -> Int {
    match list.at(cursor.tokens, cursor.position - 1) {
        Some(token) => ast.end_of(token.span)
        None => 0
    }
}

/// The error for finding what is at the cursor where `expected` was wanted.
// example: error_printed(error(over(""), TypeWanted)) == "0..0 expected a type, found the end of the file\n"
fn error(cursor: Cursor, expected: Expected) -> ParseError {
    match token_at(cursor, 0) {
        Some(token) => ParseError { kind: token_error(expected, token), span: token.span }
        None => ParseError { kind: Unexpected { expected: expected, found: FileEnd }, span: cursor.ending }
    }
}

/// The error for a failure that is not about which token was found, at the token it failed at.
// example: error_printed(failure(over("a b"), ChainedComparison)) == "0..1 comparisons do not chain\nhelp: compare twice and join the two with `&&`\n"
fn failure(cursor: Cursor, kind: ErrorKind) -> ParseError {
    match token_at(cursor, 0) {
        Some(token) => ParseError { kind: kind, span: token.span }
        None => ParseError { kind: kind, span: cursor.ending }
    }
}

/// The token `distance` tokens past the cursor, where there is one.
// example: or(token_at(over("a b"), 1), lexer.Token { kind: lexer.Unknown, span: lexer.Span { start: 0, length: 0 }, text: "" }).text == "b"
fn token_at(cursor: Cursor, distance: Int) -> Option<lexer.Token> {
    list.at(cursor.tokens, cursor.position + distance)
}

/// What kind of failure `token` is: it may be the error itself, or merely not what was wanted.
// example: message(token_error(NameWanted, lexer.Token { kind: lexer.Unknown, span: lexer.Span { start: 0, length: 1 }, text: "@" })) == "this character is not part of the language"
fn token_error(expected: Expected, token: lexer.Token) -> ErrorKind {
    match token.kind {
        lexer.Identifier => Unexpected { expected: expected, found: Word(token.text) }
        lexer.Keyword(keyword) => Unexpected { expected: expected, found: Word(lexer.keyword_text(keyword)) }
        lexer.Integer => Unexpected { expected: expected, found: Number }
        lexer.String => Unexpected { expected: expected, found: Quoted }
        lexer.Punct(punctuation) => Unexpected { expected: expected, found: Punctuation(punctuation) }
        lexer.Newline => Unexpected { expected: expected, found: LineEnd }
        lexer.LineComment => Unexpected { expected: expected, found: LineEnd }
        lexer.UnterminatedString => UnterminatedString
        lexer.Unknown => UnknownCharacter
    }
}

/// Where a parse left the cursor, and -1 where it failed, which is what an example reads.
// example: position_after(Ok(Parsed { value: 0, cursor: advanced(over("a b")) })) == 1
fn position_after<T>(parsed: Result<Parsed<T>, ParseError>) -> Int {
    match parsed {
        Ok(done) => done.cursor.position
        Err(_) => -1
    }
}

/// The error a parse failed with, printed, and `""` where it did not fail.
// example: failed(expect_name(over("x"), NameWanted)) == ""
fn failed<T>(parsed: Result<Parsed<T>, ParseError>) -> String {
    match parsed {
        Ok(_) => ""
        Err(why) => error_printed(why)
    }
}

/// The error a result failed with, printed, and `""` where it did not fail.
// example: failed_with(Ok(1)) == ""
fn failed_with<T>(result: Result<T, ParseError>) -> String {
    match result {
        Ok(_) => ""
        Err(why) => error_printed(why)
    }
}

/// An item a parse gave, printed, or the error it failed with.
// example: item_printed(item(over("import io"))) == "import io 0..9\n"
fn item_printed(parsed: Result<Parsed<ast.Item>, ParseError>) -> String {
    match parsed {
        Ok(done) => ast.item_lines(done.value)
        Err(why) => error_printed(why)
    }
}

/// An expression a parse gave, printed, or the error it failed with.
// example: expression_printed(expression(over("x"), Allowed)) == "name x 0..1\n"
fn expression_printed(parsed: Result<Parsed<ast.Expr>, ParseError>) -> String {
    match parsed {
        Ok(done) => ast.expression_lines(done.value, 0)
        Err(why) => error_printed(why)
    }
}

/// A pattern a parse gave, printed, or the error it failed with.
// example: pattern_printed(pattern(over("1"))) == "pattern-integer 1 0..1\n"
fn pattern_printed(parsed: Result<Parsed<ast.Pattern>, ParseError>) -> String {
    match parsed {
        Ok(done) => ast.pattern_lines(done.value, 0)
        Err(why) => error_printed(why)
    }
}

/// A type a parse gave, printed, or the error it failed with.
// example: type_printed(type_ref(over("()"))) == "unit-type 0..2\n"
fn type_printed(parsed: Result<Parsed<ast.TypeRef>, ParseError>) -> String {
    match parsed {
        Ok(done) => ast.type_ref_lines(done.value, 0)
        Err(why) => error_printed(why)
    }
}

/// An error as a fixture holds it: the span and the message, then the help where there is one.
// example: error_printed(ParseError { kind: ChainedComparison, span: lexer.Span { start: 1, length: 1 } }) == "1..2 comparisons do not chain\nhelp: compare twice and join the two with `&&`\n"
fn error_printed(refused: ParseError) -> String {
    let written = shown(refused.span) + " " + message(refused.kind) + "\n"
    let help = help_of(refused.kind)
    if help == "" {
        return written
    }
    written + "help: " + help + "\n"
}

/// The `help:` line, and `""` where there is no fix worth naming.
// example: help_of(UnknownCharacter) == ""
fn help_of(kind: ErrorKind) -> String {
    match kind {
        Unexpected { expected } => expected_help(expected)
        UnterminatedString => "add a closing `\"` before the end of the line"
        UnknownCharacter => ""
        IntegerTooLarge => "the largest whole number is 9223372036854775807"
        UnknownEscape(_) => "the escapes are `\\\"`, `\\\\`, `\\n`, `\\t`, and `\\r`"
        ChainedComparison => "compare twice and join the two with `&&`"
        NestingTooDeep => "brackets nest at most 32 deep; name a part of it"
        AssignedToValue => "build the value it becomes: `user { name: \"Bob\" }`"
        PartlyNamedCall => "a call names all of its arguments or none of them"
        ColonEquals(name) => "write `let " + name + " =`"
        TestInABody => "a test is an item of its own; write it below every declaration of the module"
    }
}

/// The help an unexpected token gets, which is only where a function has no name.
// example: expected_help(FunctionNameWanted) == "every function has a name; Bux has no anonymous functions"
fn expected_help(expected: Expected) -> String {
    match expected {
        FunctionNameWanted => "every function has a name; Bux has no anonymous functions"
        NamedItemWanted => "`private` keeps a name in its module, and only these four declare a name that another module reaches"
        _ => ""
    }
}

/// The code a refusal of this kind is refused with, which `docs/specs/diagnostics.md` lists.
// example: code_of(ChainedComparison) == "L0105"
fn code_of(kind: ErrorKind) -> String {
    match kind {
        Unexpected {} => "L0100"
        UnterminatedString => "L0101"
        UnknownCharacter => "L0102"
        IntegerTooLarge => "L0103"
        UnknownEscape(_) => "L0104"
        ChainedComparison => "L0105"
        NestingTooDeep => "L0106"
        AssignedToValue => "L0107"
        PartlyNamedCall => "L0108"
        ColonEquals(_) => "L0109"
        TestInABody => "L0110"
    }
}

/// The `error:` line, without its prefix.
// example: message(UnknownEscape("q")) == "`\\q` is not an escape"
fn message(kind: ErrorKind) -> String {
    match kind {
        Unexpected { expected, found } => "expected " + expected_text(expected) + ", found " + found_text(found)
        UnterminatedString => "this string has no closing quote"
        UnknownCharacter => "this character is not part of the language"
        IntegerTooLarge => "this number does not fit in a whole number"
        UnknownEscape(escaped) => "`\\" + escaped + "` is not an escape"
        ChainedComparison => "comparisons do not chain"
        NestingTooDeep => "this nests too deeply to parse"
        AssignedToValue => "only a name is assigned to"
        PartlyNamedCall => "this call names some of its arguments and not others"
        ColonEquals(_) => "`:=` does not bind a name"
        TestInABody => "a test is written at the top level of a module, and this one is inside a body"
    }
}

/// What was there instead, named the same way.
// example: found_text(Quoted) == "a string"
fn found_text(found: Found) -> String {
    match found {
        Word(word) => "`" + word + "`"
        Punctuation(punctuation) => "`" + lexer.punctuation_text(punctuation) + "`"
        Number => "a number"
        Quoted => "a string"
        LineEnd => "the end of the line"
        FileEnd => "the end of the file"
    }
}

/// What the parser was looking for, named as a thing the reader writes.
// example: expected_text(PunctWanted(lexer.FatArrow)) == "`=>`"
fn expected_text(expected: Expected) -> String {
    match expected {
        PunctWanted(punctuation) => "`" + lexer.punctuation_text(punctuation) + "`"
        KeywordWanted(keyword) => "`" + lexer.keyword_text(keyword) + "`"
        NameWanted => "a name"
        FunctionNameWanted => "a function name"
        ExternKindWanted => "`field`, `static`, `method`, or `new`"
        JavaNameWanted => "a Java name in quotes"
        TestNameWanted => "the name of the test in quotes"
        TraitWanted => "a trait"
        ItemWanted => "an import, a type, a trait, an instance, a derive, a function, an extern, a process, or a test"
        NamedItemWanted => "a function, a type, a trait, or a process"
        ExpressionWanted => "an expression"
        TypeWanted => "a type"
        PatternWanted => "a pattern"
        EndOfLineWanted => "the end of the line"
    }
}

/// Why a parse failed, and where.
type ParseError = {
    kind: ErrorKind
    span: lexer.Span
}

/// What went wrong, in the words the reader sees.
type ErrorKind =
    | Unexpected {
        expected: Expected
        found: Found
    }
    | UnterminatedString
    | UnknownCharacter
    | IntegerTooLarge
    | UnknownEscape(String)
    | ChainedComparison
    | NestingTooDeep
    | AssignedToValue
    | PartlyNamedCall
    | ColonEquals(String)
    | TestInABody

/// What the parser was looking for.
type Expected =
    | PunctWanted(lexer.Punct)
    | KeywordWanted(lexer.Keyword)
    | NameWanted
    | FunctionNameWanted
    | ExternKindWanted
    | JavaNameWanted
    | TestNameWanted
    | TraitWanted
    | ItemWanted
    | NamedItemWanted
    | ExpressionWanted
    | TypeWanted
    | PatternWanted
    | EndOfLineWanted

/// What was there instead.
type Found =
    | Word(String)
    | Punctuation(lexer.Punct)
    | Number
    | Quoted
    | LineEnd
    | FileEnd

/// What a parse gave, and the cursor past the tokens it read.
type Parsed<T> = {
    value: T
    cursor: Cursor
}

/// What a function takes, and what it gives back.
type Shape = {
    parameters: List<ast.Parameter>
    result: Option<ast.TypeRef>
}

/// A value written out in source, which an expression and a pattern each make their own node of.
type Literal =
    | IntegerLiteral(Int)
    | TextLiteral(String)
    | TruthLiteral(Bool)

derive Eq for Member

/// Which kind of member an `extern` reaches, which is the word written after `extern`.
type Member =
    | FieldMember
    | StaticMember
    | MethodMember
    | NewMember

derive Eq for RecordLiterals

/// Whether a `{` after a name opens a record literal or the block of an `if`, `for`, or `match`.
///
/// In those three headers a record literal needs parentheses around it, as it does in Go.
type RecordLiterals =
    | Allowed
    | Forbidden

derive Eq for Emptiness

/// Whether a comma-separated list may hold nothing at all.
type Emptiness =
    | MayBeEmpty
    | NeverEmpty

/// Where a list is after an element: open for another one, or closed past its bracket.
type Step =
    | Open(Cursor)
    | Closed(Cursor)

/// The tokens the grammar reads, and how far into them the parser is.
///
/// `depth` is how much of the nesting budget is spent, `count` is how many tokens there are, and
/// `ending` is the span an error at the end of the file points at: the last token, or the whole
/// source where there is none.
type Cursor = {
    tokens: List<lexer.Token>
    position: Int
    depth: Int
    count: Int
    ending: lexer.Span
}
