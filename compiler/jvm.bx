// Writing class files: every lowered module of a program as the bytes a JVM loads.
//
// `docs/specs/codegen.md` states the class file, and `tests/written.bx` reads the bytes back.
// Nothing here knows the language: it knows classes, descriptors, slots, opcodes, and the verifier.
// The lowering names no JVM shape, so each kind, value, local, and call of it is spelled here.
// Each step takes the state it writes to and gives back the state it made, which is a value.
import ast
import bytes
import exhaustiveness
import ir
import list
import map
import set
import strings

/// Every class file of the program at `path`, in the order a build writes them, or why not.
// example: list.length(ok_or(classes_of("no-such-directory/main.bx", ir.little_library()), [])) == 0
private fn classes_of(path: String, library: ir.Library) -> Result<List<ClassFile>, String> {
    match ir.program_lowered(path, library) {
        Ok(lowered) => written_or_said(program_written(lowered))
        Err(unchecked) => Err(exhaustiveness.unchecked_printed(unchecked))
    }
}

/// The class files, or why they are not written, printed.
// example: list.length(ok_or(written_or_said(Ok([])), [ClassFile { path: "", bytes: [] }])) == 0
private fn written_or_said(answer: Result<List<ClassFile>, Unwritten>) -> Result<List<ClassFile>, String> {
    match answer {
        Ok(files) => Ok(files)
        Err(unwritten) => Err(message(unwritten))
    }
}

/// Every class of every module of `program`, each once, in the order the modules name them.
///
/// The modules are written together, because a frame names the class two branches share, and a
/// variant one module gives back may extend a base that another module declares. Two modules
/// that write one class, such as the class of a list, write the same bytes, and the file is
/// written once. Two different classes of one name are refused: two parts of the program have one name.
/// Two classes whose names differ only in case are refused too, even with the same bytes, because
/// a disk that ignores case holds them as one file, and a build gives one answer on every disk.
// example: list.length(ok_or(program_written([]), [ClassFile { path: "", bytes: [] }])) == 0
// example: list.length(ok_or(program_written([one_class(record_class()), one_class(record_class())]), [])) == 1
// example: refused_code(program_written([one_class(record_class()), one_class(base_class())])) == "L0702"
// example: refused_code(program_written([one_class(record_class()), one_class(record_class_named("b"))])) == "L0702"
fn program_written(program: List<ir.Lowered>) -> Result<List<ClassFile>, Unwritten> {
    var every = []
    for module in program {
        for class in module.classes {
            every = list.push(every, class)
        }
    }
    let hierarchy = hierarchy_of(every)
    var files = []
    var written = map.empty()
    for class in every {
        let name = class_of(class.of)
        let file = ClassFile { path: name + ".class", bytes: class_written(class, hierarchy)? }
        let folded = case_folded(file.path)
        let earlier = map.get(written, folded)
        let clash = clash_of(earlier, file)
        if is_held(clash) {
            return Err(Unwritten { class: name, method: None, why: or(clash, NamedTwice) })
        }
        if !is_held(earlier) {
            files = list.push(files, file)
            written = map.insert(written, folded, file)
        }
    }
    Ok(files)
}

/// Why `file` is not written, where `earlier` is the file written first under its folded path.
///
/// The same path with the same bytes is one class that two modules write, and it is no clash.
// example: !is_held(clash_of(Some(ClassFile { path: "a/B.class", bytes: [1] }), ClassFile { path: "a/B.class", bytes: [1] }))
// example: help_of(or(clash_of(Some(ClassFile { path: "a/B.class", bytes: [1] }), ClassFile { path: "a/B.class", bytes: [2] }), TooLarge)) == help_of(NamedTwice)
// example: help_of(or(clash_of(Some(ClassFile { path: "a/B.class", bytes: [1] }), ClassFile { path: "a/b.class", bytes: [1] }), TooLarge)) == help_of(NamedInCase("a/B"))
fn clash_of(earlier: Option<ClassFile>, file: ClassFile) -> Option<Why> {
    match earlier {
        Some(held) => if held.path != file.path {
            Some(NamedInCase(or(strings.cut(held.path, 0, strings.length(held.path) - 6), held.path)))
        } else if held.bytes != file.bytes {
            Some(NamedTwice)
        } else {
            None
        }
        None => None
    }
}

/// `path` with each ASCII uppercase letter in lowercase, which is how a disk that ignores case
/// compares two names.
///
/// A class name is spelled in the letters of Java names. Only the 26 ASCII letters are folded
/// here, and a letter outside ASCII keeps its case.
// example: case_folded("demo/Box.class") == "demo/box.class"
// example: case_folded("Ärger/ZZ") == "Ärger/zz"
fn case_folded(path: String) -> String {
    var folded = ""
    var at = 0
    for at < strings.length(path) {
        folded += unit_folded(path, at)
        at += 1
    }
    folded
}

/// The code unit of `path` at `at` as a text, in lowercase where it is an ASCII uppercase letter.
// example: unit_folded("aB", 1) == "b"
// example: unit_folded("aB", 0) == "a"
fn unit_folded(path: String, at: Int) -> String {
    let unit = or(strings.at(path, at), 0)
    if unit >= 65 && unit <= 90 {
        return or(strings.cut("abcdefghijklmnopqrstuvwxyz", unit - 65, unit - 64), "")
    }
    or(strings.cut(path, at, at + 1), "")
}

/// `class` as the bytes a JVM loads, or why it is not written.
///
/// The class file is JDK 28 marked preview, and the class is a value class: its identity bit is
/// clear. A class that waits on the layout of no other class carries no attribute for it.
// example: list.length(ok_or(class_written(record_class(), hierarchy_of([record_class()])), [])) > 10
fn class_written(class: ir.Class, hierarchy: Hierarchy) -> Result<List<Int>, Unwritten> {
    let name = class_of(class.of)
    let named = pooled_class(no_pool(), name)
    let extends = pooled_class(named.pool, class_of(class.extends))
    let implemented = interfaces_written(extends.pool, class.implements)
    let fields = fields_written(implemented.pool, class)
    let methods = methods_written(Writer { pool: fields.pool, hierarchy: hierarchy }, class)?
    let wanted = loadable_written(methods.pool, class, hierarchy)
    let pool = wanted.pool
    _ = texts_held(pool: pool, from: 0, class: name, method: None)?
    var written = bytes.u4([], 3405691582)
    written = bytes.u2(bytes.u2(written, 65535), 72)
    written = bytes.all(bytes.u2(written, pool.next), pool_written(pool))
    written = bytes.u2(written, 1 + extending_access(class.extending))
    written = bytes.u2(bytes.u2(written, named.index), extends.index)
    written = bytes.all(bytes.all(written, implemented.bytes), fields.bytes)
    written = bytes.all(written, methods.bytes)
    if list.length(wanted.bytes) == 0 {
        return Ok(bytes.u2(written, 0))
    }
    Ok(bytes.all(bytes.u2(written, 1), wanted.bytes))
}

/// How many interfaces a class implements, then the pool index of each one.
// example: interfaces_written(no_pool(), []).bytes == [0, 0]
fn interfaces_written(pool: Pool, implements: List<ir.Kind>) -> Written {
    var writing = Written { pool: pool, bytes: bytes.u2([], list.length(implements)) }
    for interface in implements {
        let entry = pooled_class(writing.pool, class_of(interface))
        writing = Written { pool: entry.pool, bytes: bytes.u2(writing.bytes, entry.index) }
    }
    writing
}

/// The access a class is written with beside `ACC_PUBLIC`: final, or abstract for a base.
// example: extending_access(ir.ByItsVariants) == 1024
fn extending_access(extending: ir.Extending) -> Int {
    match extending {
        ir.Never => 16
        ir.ByItsVariants => 1024
    }
}

/// The fields of `class`, each public, final, and written before the constructor hands itself up.
// example: fields_written(no_pool(), base_class()).bytes == [0, 1, 8, 17, 0, 1, 0, 2, 0, 0]
fn fields_written(pool: Pool, class: ir.Class) -> Written {
    var writing = Written { pool: pool, bytes: bytes.u2([], list.length(class.fields)) }
    for field in class.fields {
        let name = pooled_utf8(writing.pool, field.name)
        let descriptor = pooled_utf8(name.pool, descriptor_text(descriptor_of(field.of)))
        let written = bytes.u2(bytes.u2(bytes.u2(writing.bytes, 2065), name.index), descriptor.index)
        writing = Written { pool: descriptor.pool, bytes: bytes.u2(written, 0) }
    }
    writing
}

/// The methods of `class`, each with its code, or why one of them is not written.
// example: list.length(written_or_none(methods_written(Writer { pool: no_pool(), hierarchy: hierarchy_of([]) }, base_class())).bytes) == 2
fn methods_written(writer: Writer, class: ir.Class) -> Result<Written, Unwritten> {
    let name = class_of(class.of)
    let spelled = spelled_once(class.methods, name)?
    var writing = Written { pool: writer.pool, bytes: bytes.u2([], list.length(spelled)) }
    for method in spelled {
        writing = method_written(Writer { pool: writing.pool, hierarchy: writer.hierarchy }, method, name, writing.bytes)?
    }
    Ok(writing)
}

/// Each of `methods` of the class `class` as a JVM runs it, the first of each name and descriptor
/// only, or why one of them is not spelled.
///
/// The lowering tells two methods apart by their Bux values, and two values can have one
/// descriptor, such as `Anything` and an extern type of `java.lang.Object`.
// example: list.length(ok_or(spelled_once([returning_method(), returning_method()], "a/B"), [])) == 1
fn spelled_once(methods: List<ir.Method>, class: String) -> Result<List<Spelled>, Unwritten> {
    var seen = set.empty()
    var spelled = []
    for method in methods {
        let one = placed_in(answer: method_spelled(method, class), class: class, method: name_spelled(method))?
        let key = one.name + method_descriptor_text(one.descriptor)
        if !set.has_value(seen, key) {
            seen = set.insert(seen, key)
            spelled = list.push(spelled, one)
        }
    }
    Ok(spelled)
}

/// `into`, with one method of the class `class` after it: its access, its name, its descriptor,
/// and its code.
///
/// A text the method asks the pool for is held to the length a class file can write here, so a
/// refusal names the method whose text it is.
// example: list.length(written_or_none(method_written(Writer { pool: no_pool(), hierarchy: hierarchy_of([]) }, returning_spelled(), "a/B", [])).bytes) > 10
fn method_written(writer: Writer, spelled: Spelled, class: String, into: List<Int>) -> Result<Written, Unwritten> {
    let name = pooled_utf8(writer.pool, spelled.name)
    let descriptor = pooled_utf8(name.pool, method_descriptor_text(spelled.descriptor))
    let code = code_written(Writer { pool: descriptor.pool, hierarchy: writer.hierarchy }, spelled, class)?
    _ = texts_held(pool: code.pool, from: list.length(writer.pool.entries), class: class, method: Some(spelled.name))?
    let written = bytes.u2(bytes.u2(into, 1 + static_access(spelled.receiver)), name.index)
    Ok(Written { pool: code.pool, bytes: bytes.all(bytes.u2(bytes.u2(written, descriptor.index), 1), code.bytes) })
}

/// `method` of the class `class` as a JVM runs it, or the defect of a local that no slot holds.
///
/// Each local is given its slot, each value its descriptor, and each instruction is spelled as
/// the ones a JVM runs for it.
// example: list.length(ok_or(method_spelled(returning_method(), "a/B"), returning_spelled()).instructions) == 2
// example: why_code(method_spelled(ir.Method { name: "of", parameters: [], result: None, reached: ir.ThroughTheClass, body: ir.Body { instructions: [ir.Load(ir.Local { name: "x", of: ir.Whole })], locals: [], guards: [] } }, "a/B")) == "L0703"
fn method_spelled(method: ir.Method, class: String) -> Result<Spelled, Why> {
    let receiver = receiver_of(method.reached, class)
    let locals = locals_of(receiver: receiver, parameters: method.parameters, body: method.body.locals)
    var instructions = []
    for instruction in method.body.instructions {
        let each = instruction_spelled(instruction, locals)?
        for spelled in each {
            instructions = list.push(instructions, spelled)
        }
    }
    let descriptor = MethodDescriptor { parameters: parameters_spelled(method.parameters), result: result_of(method.result) }
    Ok(Spelled { name: name_spelled(method), descriptor: descriptor, receiver: receiver, instructions: instructions, slots: locals.width, guards: method.body.guards })
}

/// The name a class file gives `method`: `<init>` for a constructor, and its own name otherwise.
// example: name_spelled(returning_method()) == "of"
fn name_spelled(method: ir.Method) -> String {
    match method.reached {
        ir.AsItsConstructor => "<init>"
        _ => method.name
    }
}

/// The class a method reached through an instance runs on, and nothing for a static method.
// example: or(receiver_of(ir.AsItsConstructor, "a/B"), "") == "a/B"
// example: !is_held(receiver_of(ir.ThroughTheClass, "a/B"))
fn receiver_of(reached: ir.Reached, class: String) -> Option<String> {
    match reached {
        ir.ThroughTheClass => None
        _ => Some(class)
    }
}

/// Where each local of a method lives: the receiver as `this` in slot zero, then each parameter,
/// then each local of the body, each as wide as what it holds.
// example: locals_of(receiver: None, parameters: [ir.Local { name: "x", of: ir.Whole }], body: [ir.Local { name: "y", of: ir.Small }]).width == 3
// example: ok_or(slot_of(locals_of(receiver: Some("a/B"), parameters: [], body: [ir.Local { name: "y", of: ir.Small }]), ir.Local { name: "y", of: ir.Small }), 0) == 1
fn locals_of(receiver: Option<String>, parameters: List<ir.Local>, body: List<ir.Local>) -> Locals {
    var every = match receiver {
        Some(class) => local_placed(locals: Locals { slots: map.empty(), width: 0 }, name: "this", of: Reference(class))
        None => Locals { slots: map.empty(), width: 0 }
    }
    for one in parameters {
        every = local_placed(locals: every, name: one.name, of: descriptor_of(one.of))
    }
    for one in body {
        every = local_placed(locals: every, name: one.name, of: descriptor_of(one.of))
    }
    every
}

/// `locals`, with `name` given the next slot and as many slots as `of` takes.
///
/// A name is one local, so a name placed already takes no second slot.
// example: local_placed(locals: Locals { slots: map.empty(), width: 0 }, name: "x", of: Long).width == 2
// example: local_placed(locals: local_placed(locals: Locals { slots: map.empty(), width: 0 }, name: "x", of: Long), name: "x", of: Long).width == 2
fn local_placed(locals: Locals, name: String, of: Descriptor) -> Locals {
    if is_held(map.get(locals.slots, name)) {
        return locals
    }
    Locals { slots: map.insert(locals.slots, name, Placed { at: locals.width, width: width(of) }), width: locals.width + width(of) }
}

/// The instructions a JVM runs for `instruction`, each local read as its slot in `locals`, or the
/// defect of a local that no slot holds.
// example: list.length(ok_or(instruction_spelled(ir.Increment(ir.Local { name: "x", of: ir.Small }), locals_of(receiver: None, parameters: [ir.Local { name: "x", of: ir.Small }], body: [])), [])) == 1
fn instruction_spelled(instruction: ir.Instruction, locals: Locals) -> Result<List<Instruction>, Why> {
    match instruction {
        ir.Load(local) => Ok([Load { slot: slot_of(locals, local)?, of: descriptor_of(local.of) }])
        ir.Store(local) => Ok([Store { slot: slot_of(locals, local)?, of: descriptor_of(local.of) }])
        ir.Increment(local) => Ok([Increment(slot_of(locals, local)?)])
        ir.Reach { reaches, arguments, gives, called } => Ok(member_reached(reaches: reaches, through: called, taking: MethodDescriptor { parameters: each_reaching(arguments), result: result_of(gives) }, loaded: arguments_loaded(arguments, locals)?))
        _ => Ok(plain_spelled(instruction))
    }
}

/// The instructions a JVM runs for `instruction`, which names no local: a constant, the stack,
/// arithmetic, or a jump.
// example: list.length(plain_spelled(ir.Convert { from: ir.Of(ir.Anything), to: ir.Whole })) == 2
fn plain_spelled(instruction: ir.Instruction) -> List<Instruction> {
    match instruction {
        ir.LongOf(value) => [LongOf(value)]
        ir.BooleanOf(value) => [BooleanOf(value)]
        ir.IntegerOf(value) => [IntegerOf(value)]
        ir.TextOf(value) => [TextOf(value)]
        ir.Drop(of) => [Drop(descriptor_of(of))]
        ir.Copy => [Copy]
        ir.Convert { from, to } => converted(held: descriptor_of(from), wanted: descriptor_of(to))
        ir.Arithmetic(what) => [Arithmetic(what)]
        ir.Concat => [Concat]
        ir.CompareLongs(how) => [CompareLongs(how)]
        ir.CompareIntegers(how) => [CompareIntegers(how)]
        ir.Not => [Not]
        ir.Widen => [Widen]
        ir.Narrow => [Narrow]
        ir.LowEightBits => [LowEightBits]
        ir.Label(label) => [Label(label)]
        ir.Jump(label) => [Jump(label)]
        ir.JumpIfFalse(label) => [JumpIfFalse(label)]
        ir.JumpIfNull(label) => [JumpIfNull(label)]
        _ => object_spelled(instruction)
    }
}

/// The instructions a JVM runs for `instruction`, which makes, reads, or calls a class the
/// lowering names by its kind.
// example: list.length(object_spelled(ir.Construct { built: ir.Anything, taken: [] })) == 1
fn object_spelled(instruction: ir.Instruction) -> List<Instruction> {
    match instruction {
        ir.New(kind) => [New(class_of(kind))]
        ir.NewArray(kind) => [NewArray(class_of(kind))]
        ir.StoreInArray => [StoreInArray]
        ir.LoadFromArray => [LoadFromArray]
        ir.ArrayLength => [ArrayLength]
        ir.Construct { built, taken } => [Construct(constructor_of(class_of(built), descriptors_of(taken)))]
        ir.GetField(field) => [GetField(field_spelled(field))]
        ir.PutField(field) => [PutField(field_spelled(field))]
        ir.Call(function) => [InvokeStatic(method_of(class: class_of(function.owner), name: function.name, taken: descriptors_of(function.taken), gives: result_of(function.gives)))]
        ir.Cast(kind) => [Cast(class_of(kind))]
        ir.InstanceOf(kind) => [InstanceOf(class_of(kind))]
        ir.Return(of) => [Return(result_of(of))]
        _ => java_spelled(instruction)
    }
}

/// The instructions a JVM runs for `instruction`, which asks the Java platform for text, a
/// failure, the end of the program, or an array.
// example: list.length(java_spelled(ir.Unmatched)) == 4
fn java_spelled(instruction: ir.Instruction) -> List<Instruction> {
    let text = "java/lang/String"
    let system = "java/lang/System"
    match instruction {
        ir.TextEqual => [InvokeVirtual(method_of(class: text, name: "equals", taken: [object()], gives: Some(Boolean)))]
        ir.TextCompared => [InvokeVirtual(method_of(class: text, name: "compareTo", taken: [text_descriptor()], gives: Some(Integer)))]
        ir.TextHashed => [InvokeVirtual(method_of(class: text, name: "hashCode", taken: [], gives: Some(Integer)))]
        ir.Shown(of) => shown_spelled(of)
        ir.Unmatched => unmatched()
        ir.Exited => [InvokeStatic(method_of(class: system, name: "exit", taken: [Integer], gives: None))]
        ir.ArrayCopied => [InvokeStatic(method_of(class: system, name: "arraycopy", taken: [object(), Integer, object(), Integer, Integer], gives: None))]
        ir.JavaListOf => [InvokeStaticOfInterface(method_of(class: class_of(ir.JavaList), name: "of", taken: [Array(object())], gives: Some(java_list())))]
        _ => process_spelled(instruction)
    }
}

/// The call that turns a value `of` holds into its text, and nothing for a value that is text.
// example: list.length(shown_spelled(ir.Whole)) == 1
// example: list.length(shown_spelled(ir.Of(ir.Text))) == 0
fn shown_spelled(of: ir.Value) -> List<Instruction> {
    match of {
        ir.Whole => [InvokeStatic(method_of(class: "java/lang/Long", name: "toString", taken: [Long], gives: Some(text_descriptor())))]
        ir.Truth => [InvokeStatic(method_of(class: "java/lang/Boolean", name: "toString", taken: [Boolean], gives: Some(text_descriptor())))]
        _ => []
    }
}

/// The throw of an `AssertionError`, which a match where no arm fits runs.
// example: list.length(unmatched()) == 4
fn unmatched() -> List<Instruction> {
    let thrown = "java/lang/AssertionError"
    [New(thrown), Copy, Construct(constructor_of(thrown, [])), Throw]
}

/// The instructions a JVM runs for `instruction`, which starts a process, or reads its mailbox,
/// its envelope, its end, or the failure it ended with.
// example: list.length(process_spelled(ir.Started)) == 2
fn process_spelled(instruction: ir.Instruction) -> List<Instruction> {
    let mailbox = class_of(ir.Mailbox)
    let end = class_of(ir.End)
    let failure = class_of(ir.Failure)
    match instruction {
        ir.Started => started()
        ir.Taken => [InvokeVirtual(method_of(class: mailbox, name: "take", taken: [], gives: Some(object())))]
        ir.Opened => [Cast(class_of(ir.Envelope)), InvokeVirtual(method_of(class: class_of(ir.Envelope), name: "get", taken: [], gives: Some(object())))]
        ir.Offered => offered(mailbox)
        ir.Removed => [InvokeVirtual(method_of(class: mailbox, name: "remove", taken: [object()], gives: Some(Boolean)))]
        ir.IsEnded => [InvokeVirtual(method_of(class: end, name: "isDone", taken: [], gives: Some(Boolean)))]
        ir.Awaited => [InvokeVirtual(method_of(class: end, name: "join", taken: [], gives: Some(object())))]
        ir.Completed => [InvokeVirtual(method_of(class: end, name: "complete", taken: [object()], gives: Some(Boolean))), Drop(Boolean)]
        ir.CompletedWithFailure => [InvokeVirtual(method_of(class: end, name: "completeExceptionally", taken: [Reference(failure)], gives: Some(Boolean))), Drop(Boolean)]
        ir.FailureWritten => [InvokeVirtual(method_of(class: failure, name: "printStackTrace", taken: [], gives: None))]
        ir.FailureText => [InvokeVirtual(method_of(class: failure, name: "toString", taken: [], gives: Some(text_descriptor())))]
        _ => []
    }
}

/// The task on the stack started on a virtual thread of its own, and the thread dropped.
// example: list.length(started()) == 2
fn started() -> List<Instruction> {
    let thread = Reference("java/lang/Thread")
    [InvokeStatic(method_of(class: "java/lang/Thread", name: "startVirtualThread", taken: [Reference(class_of(ir.Task))], gives: Some(thread))), Drop(thread)]
}

/// The offer of the envelope on the stack to the class `mailbox`, within the milliseconds on the
/// stack, which leaves whether the mailbox took it.
// example: list.length(offered("java/util/concurrent/ArrayBlockingQueue")) == 2
fn offered(mailbox: String) -> List<Instruction> {
    let unit = Reference("java/util/concurrent/TimeUnit")
    [GetStatic(FieldRef { class: "java/util/concurrent/TimeUnit", name: "MILLISECONDS", of: unit }), InvokeVirtual(method_of(class: mailbox, name: "offer", taken: [object(), Long, unit], gives: Some(Boolean)))]
}

/// `field` as a class file names it.
// example: field_spelled(ir.FieldRef { owner: ir.Anything, name: "at", of: ir.Whole }).of == Long
fn field_spelled(field: ir.FieldRef) -> FieldRef {
    FieldRef { class: class_of(field.owner), name: field.name, of: descriptor_of(field.of) }
}

/// What turns `held` into `wanted`: a box, an unbox, a cast from `Object`, or nothing.
// example: list.length(converted(held: Long, wanted: object())) == 1
// example: list.length(converted(held: object(), wanted: Long)) == 2
// example: list.length(converted(held: object(), wanted: text_descriptor())) == 1
// example: list.length(converted(held: Boolean, wanted: Integer)) == 0
fn converted(held: Descriptor, wanted: Descriptor) -> List<Instruction> {
    if held == wanted {
        return []
    }
    let boxed = boxing_class(held)
    let unboxed = boxing_class(wanted)
    if boxed != "" && unboxed == "" {
        return [InvokeStatic(method_of(class: boxed, name: "valueOf", taken: [held], gives: Some(Reference(boxed))))]
    }
    if boxed == "" && unboxed != "" {
        return [Cast(unboxed), InvokeVirtual(method_of(class: unboxed, name: box_read(wanted), taken: [], gives: Some(wanted)))]
    }
    if boxed == "" && unboxed == "" {
        return narrowed(held: held, wanted: wanted)
    }
    []
}

/// A cast from `Object` to the class `wanted` names, where both are classes.
// example: list.length(narrowed(held: object(), wanted: text_descriptor())) == 1
// example: list.length(narrowed(held: text_descriptor(), wanted: object())) == 0
fn narrowed(held: Descriptor, wanted: Descriptor) -> List<Instruction> {
    match wanted {
        Reference(class) => if held == object() && class != "java/lang/Object" {
            [Cast(class)]
        } else {
            []
        }
        _ => []
    }
}

/// The method of its box that reads a value `of` holds back out.
// example: box_read(Boolean) == "booleanValue"
fn box_read(of: Descriptor) -> String {
    match of {
        Long => "longValue"
        Boolean => "booleanValue"
        _ => "intValue"
    }
}

/// The class a value `of` holds is boxed in, and `""` for a value no box holds.
// example: boxing_class(Long) == "java/lang/Long"
// example: boxing_class(object()) == ""
fn boxing_class(of: Descriptor) -> String {
    match of {
        Long => "java/lang/Long"
        Boolean => "java/lang/Boolean"
        Integer => "java/lang/Integer"
        _ => ""
    }
}

/// The member an `extern` reaches, with `loaded` put on the stack first where it takes them.
///
/// `taking` is what the member takes and gives back. An instance method takes its receiver
/// first, and a constructor gives back the class it builds.
// example: list.length(member_reached(reaches: ast.Constructor, through: ir.ThroughItsClass, taking: MethodDescriptor { parameters: [], result: Some(object()) }, loaded: [])) == 3
fn member_reached(reaches: ast.Reaches, through: ir.CalledAs, taking: MethodDescriptor, loaded: List<Instruction>) -> List<Instruction> {
    match reaches {
        ast.StaticField(named) => [GetStatic(FieldRef { class: class_of_member(named.text), name: member_of(named.text), of: or(taking.result, object()) })]
        ast.StaticMethod(named) => list.push(loaded, InvokeStatic(MethodRef { class: class_of_member(named.text), name: member_of(named.text), descriptor: taking }))
        ast.InstanceMethod(named) => list.push(loaded, member_called(through, MethodRef { class: class_named_by(or(list.at(taking.parameters, 0), object())), name: named.text, descriptor: MethodDescriptor { parameters: after_first(taking.parameters), result: taking.result } }))
        ast.Constructor => constructed_member(loaded, taking)
    }
}

/// What each argument reaches the member as.
// example: list.length(each_reaching([])) == 0
fn each_reaching(arguments: List<ir.Argument>) -> List<Descriptor> {
    var taken = []
    for argument in arguments {
        taken = list.push(taken, reaching_of(argument))
    }
    taken
}

/// What the member takes where `argument` arrives as its local holds it and crosses as it says.
// example: reaching_of(ir.Argument { local: ir.Local { name: "x", of: ir.Whole }, crossing: ir.Narrowed }) == Integer
fn reaching_of(argument: ir.Argument) -> Descriptor {
    match argument.crossing {
        ir.AsItIs => descriptor_of(argument.local.of)
        ir.Narrowed => Integer
        ir.Listed => java_list()
    }
}

/// A class built and its constructor called with each of `loaded`.
// example: list.length(constructed_member([], MethodDescriptor { parameters: [], result: Some(object()) })) == 3
fn constructed_member(loaded: List<Instruction>, taking: MethodDescriptor) -> List<Instruction> {
    let class = class_named_by(or(taking.result, object()))
    var instructions = [New(class), Copy]
    for one in loaded {
        instructions = list.push(instructions, one)
    }
    list.push(instructions, Construct(constructor_of(class, taking.parameters)))
}

/// The constructor of the class `class`, which takes `taken`.
// example: constructor_of("a/B", [Long]).name == "<init>"
fn constructor_of(class: String, taken: List<Descriptor>) -> MethodRef {
    method_of(class: class, name: "<init>", taken: taken, gives: None)
}

/// Every argument loaded from the slot it arrives in, and made what the member takes, or the
/// defect of an argument that no slot holds.
// example: list.length(ok_or(arguments_loaded([ir.Argument { local: ir.Local { name: "x", of: ir.Whole }, crossing: ir.Narrowed }], locals_of(receiver: None, parameters: [ir.Local { name: "x", of: ir.Whole }], body: [])), [])) == 2
fn arguments_loaded(arguments: List<ir.Argument>, locals: Locals) -> Result<List<Instruction>, Why> {
    var instructions = []
    for argument in arguments {
        instructions = list.push(instructions, Load { slot: slot_of(locals, argument.local)?, of: descriptor_of(argument.local.of) })
        instructions = match argument.crossing {
            ir.AsItIs => instructions
            ir.Narrowed => list.push(instructions, Narrow)
            ir.Listed => list.push(instructions, InvokeStatic(list_crossed()))
        }
    }
    Ok(instructions)
}

/// The slot `local` lives in, or the defect of a local that no slot holds, or that holds a value
/// wider than its slot.
// example: why_code(slot_of(locals_of(receiver: None, parameters: [], body: []), ir.Local { name: "x", of: ir.Whole })) == "L0703"
// example: why_code(slot_of(locals_of(receiver: None, parameters: [], body: [ir.Local { name: "x", of: ir.Small }]), ir.Local { name: "x", of: ir.Whole })) == "L0703"
fn slot_of(locals: Locals, local: ir.Local) -> Result<Int, Why> {
    match map.get(locals.slots, local.name) {
        Some(slot) => slot_held(slot, local)
        None => Err(Defect("the local `" + local.name + "` is used, and no slot holds it"))
    }
}

/// Where `slot` is wide enough for `local`, the first of its slots, and the defect otherwise.
// example: ok_or(slot_held(Placed { at: 3, width: 2 }, ir.Local { name: "x", of: ir.Small }), 0) == 3
fn slot_held(slot: Placed, local: ir.Local) -> Result<Int, Why> {
    if width(descriptor_of(local.of)) > slot.width {
        return Err(Defect("the local `" + local.name + "` holds a value wider than its slot"))
    }
    Ok(slot.at)
}

/// The function of the prelude that turns a list into a `java.util.List`.
// example: list_crossed().name == "listed"
fn list_crossed() -> MethodRef {
    let listed = class_of(ir.TypeOf { module: ir.ThePrelude, name: "List" })
    method_of(class: listed, name: "listed", taken: [Reference(listed)], gives: Some(java_list()))
}

/// The method `name` of the class `class`, which takes `taken` and gives back `gives`.
// example: method_of(class: "a/B", name: "of", taken: [], gives: None).name == "of"
fn method_of(class: String, name: String, taken: List<Descriptor>, gives: Option<Descriptor>) -> MethodRef {
    MethodRef { class: class, name: name, descriptor: MethodDescriptor { parameters: taken, result: gives } }
}

/// The call an instance method is reached with, which the JVM writes one way for an interface.
// example: list.length(instruction_written(assembling_of([]), member_called(ir.ThroughItsInterface, list_crossed())).code) == 5
fn member_called(through: ir.CalledAs, method: MethodRef) -> Instruction {
    match through {
        ir.ThroughItsClass => InvokeVirtual(method)
        ir.ThroughItsInterface => InvokeInterface(method)
    }
}

/// The class a `field` or a `static` names, which is every segment but the last.
// example: class_of_member("java.lang.Math.abs") == "java/lang/Math"
fn class_of_member(named: String) -> String {
    match last_dot(named) {
        Some(at) => ir.dots_replaced(or(strings.cut(named, 0, at), ""), "/")
        None => ""
    }
}

/// The member a `field` or a `static` names, which is the last segment.
// example: member_of("java.lang.Math.abs") == "abs"
fn member_of(named: String) -> String {
    match last_dot(named) {
        Some(at) => or(strings.cut(named, at + 1, strings.length(named)), "")
        None => named
    }
}

/// Where the last dot of `named` is, where it has one.
// example: or(last_dot("a.b.c"), 0) == 3
fn last_dot(named: String) -> Option<Int> {
    var found = None
    var at = 0
    for at < strings.length(named) {
        found = match strings.at(named, at) {
            Some(46) => Some(at)
            _ => found
        }
        at += 1
    }
    found
}

/// The class `of` is, which every descriptor an `extern` writes a class into is one of.
// example: class_named_by(object()) == "java/lang/Object"
fn class_named_by(of: Descriptor) -> String {
    match of {
        Reference(class) => class
        _ => ""
    }
}

/// Each of `taken` after the first.
// example: list.length(after_first([Long, Integer])) == 1
fn after_first(taken: List<Descriptor>) -> List<Descriptor> {
    var rest = []
    var position = 0
    for one in taken {
        if position > 0 {
            rest = list.push(rest, one)
        }
        position += 1
    }
    rest
}

/// What each parameter holds, as a class file writes it.
// example: parameters_spelled([ir.Local { name: "x", of: ir.Whole }]) == [Long]
fn parameters_spelled(parameters: List<ir.Local>) -> List<Descriptor> {
    var spelled = []
    for one in parameters {
        spelled = list.push(spelled, descriptor_of(one.of))
    }
    spelled
}

/// What each of `values` is, as a class file writes it.
// example: descriptors_of([ir.Small]) == [Integer]
fn descriptors_of(values: List<ir.Value>) -> List<Descriptor> {
    var spelled = []
    for one in values {
        spelled = list.push(spelled, descriptor_of(one))
    }
    spelled
}

/// What `value` is, as a class file writes it, and nothing for a function that gives nothing.
// example: held_text(result_of(Some(ir.Truth))) == "Z"
fn result_of(value: Option<ir.Value>) -> Option<Descriptor> {
    match value {
        Some(one) => Some(descriptor_of(one))
        None => None
    }
}

/// What holds an object.
// example: descriptor_text(object()) == "Ljava/lang/Object;"
fn object() -> Descriptor {
    Reference(class_of(ir.Anything))
}

/// What holds a `java.util.List`.
// example: descriptor_text(java_list()) == "Ljava/util/List;"
fn java_list() -> Descriptor {
    Reference(class_of(ir.JavaList))
}

/// What `answer` wrote, and nothing written where it was refused.
// example: written_or_none(Ok(Written { pool: no_pool(), bytes: [1] })).bytes == [1]
private fn written_or_none(answer: Result<Written, Unwritten>) -> Written {
    ok_or(answer, Written { pool: no_pool(), bytes: [] })
}

/// Nothing where each text `pool` holds from its entry `from` on fits, and why not where one does not.
///
/// A class file writes the length of a text in two bytes, so a text of more is refused, not cut.
/// Only a text of more than a third of that many units can take more bytes than that.
// example: refused_code(texts_held(pool: pooled_utf8(no_pool(), "a").pool, from: 0, class: "a/B", method: None)) == ""
fn texts_held(pool: Pool, from: Int, class: String, method: Option<String>) -> Result<(), Unwritten> {
    var at = 0
    for entry in pool.entries {
        if at >= from {
            _ = text_held(entry: entry, class: class, method: method)?
        }
        at += 1
    }
    Ok(())
}

/// Nothing where `entry` is no text or a text that fits, and why not where it is one that does not.
// example: refused_code(text_held(entry: Utf8Entry("a"), class: "a/B", method: None)) == ""
fn text_held(entry: Entry, class: String, method: Option<String>) -> Result<(), Unwritten> {
    match entry {
        Utf8Entry(text) => if strings.length(text) > 21845 && list.length(bytes.modified_utf8(text)) > 65535 {
            Err(Unwritten { class: class, method: method, why: TooLong(list.length(bytes.modified_utf8(text))) })
        } else {
            Ok(())
        }
        _ => Ok(())
    }
}

/// The access a method is written with beside `ACC_PUBLIC`: static where it has no receiver.
// example: static_access(None) == 8
// example: static_access(Some("a/B")) == 0
fn static_access(receiver: Option<String>) -> Int {
    match receiver {
        Some(_) => 0
        None => 8
    }
}

/// The `Code` attribute of one method, with the exception table and the stack map it needs.
// example: list.length(written_or_none(code_written(Writer { pool: no_pool(), hierarchy: hierarchy_of([]) }, returning_spelled(), "a/B")).bytes) == 22
fn code_written(writer: Writer, spelled: Spelled, class: String) -> Result<Written, Unwritten> {
    let assembled = placed_in(answer: assembled_of(spelled, writer), class: class, method: spelled.name)?
    let caught = handlers_written(assembled.pool, assembled.handlers)
    let mapped = map_written(caught.pool, assembled.frames)
    let named = pooled_utf8(mapped.pool, "Code")
    var body = bytes.u2(bytes.u2([], assembled.max_stack), assembled.max_locals)
    body = bytes.all(bytes.u4(body, list.length(assembled.code)), assembled.code)
    body = bytes.all(body, caught.bytes)
    body = bytes.all(bytes.u2(body, has_any(mapped.bytes)), mapped.bytes)
    Ok(Written { pool: named.pool, bytes: bytes.all(bytes.u4(bytes.u2([], named.index), list.length(body)), body) })
}

/// `answer`, where a refusal is one of the method `method` of the class `class`.
// example: refused_code(placed_in(answer: Err(TooLarge), class: "a/B", method: "of")) == "L0700"
fn placed_in<T>(answer: Result<T, Why>, class: String, method: String) -> Result<T, Unwritten> {
    match answer {
        Ok(value) => Ok(value)
        Err(why) => Err(Unwritten { class: class, method: Some(method), why: why })
    }
}

/// One where `written` holds anything, and zero where it holds nothing.
// example: has_any([]) == 0
fn has_any(written: List<Int>) -> Int {
    if list.length(written) == 0 {
        return 0
    }
    1
}

/// The exception table, which names every span whose throw is caught and where it lands.
// example: handlers_written(no_pool(), []).bytes == [0, 0]
fn handlers_written(pool: Pool, handlers: List<Caught>) -> Written {
    var writing = Written { pool: pool, bytes: bytes.u2([], list.length(handlers)) }
    for caught in handlers {
        let catching = pooled_class(writing.pool, caught.catching)
        let written = bytes.u2(bytes.u2(writing.bytes, caught.from), caught.to)
        writing = Written { pool: catching.pool, bytes: bytes.u2(bytes.u2(written, caught.handler), catching.index) }
    }
    writing
}

/// The `StackMapTable` attribute, each frame a full one, and nothing where nothing branches.
// example: map_written(no_pool(), []).bytes == []
fn map_written(pool: Pool, frames: List<Landed>) -> Written {
    if list.length(frames) == 0 {
        return Written { pool: pool, bytes: [] }
    }
    var writing = Written { pool: pool, bytes: bytes.u2([], list.length(frames)) }
    var previous = -1
    for landed in frames {
        let delta = landed.at - previous - 1
        writing = frame_written(writing.pool, landed.frame, delta, writing.bytes)
        previous = landed.at
    }
    let named = pooled_utf8(writing.pool, "StackMapTable")
    Written { pool: named.pool, bytes: bytes.all(bytes.u4(bytes.u2([], named.index), list.length(writing.bytes)), writing.bytes) }
}

/// The `LoadableDescriptors` attribute: each field whose class a JVM may fold, named once.
///
/// A class that waits on nothing carries no attribute, which is written here as no bytes.
// example: loadable_written(no_pool(), record_class(), hierarchy_of([])).bytes == []
fn loadable_written(pool: Pool, class: ir.Class, hierarchy: Hierarchy) -> Written {
    var wanted = []
    var pooling = pool
    for field in class.fields {
        let of = descriptor_of(field.of)
        if is_foldable(hierarchy, of) {
            let descriptor = pooled_utf8(pooling, descriptor_text(of))
            pooling = descriptor.pool
            if !list.has_value(wanted, descriptor.index) {
                wanted = list.push(wanted, descriptor.index)
            }
        }
    }
    if list.length(wanted) == 0 {
        return Written { pool: pooling, bytes: [] }
    }
    let named = pooled_utf8(pooling, "LoadableDescriptors")
    var descriptors = bytes.u2([], list.length(wanted))
    for index in wanted {
        descriptors = bytes.u2(descriptors, index)
    }
    Written { pool: named.pool, bytes: bytes.all(bytes.u4(bytes.u2([], named.index), list.length(descriptors)), descriptors) }
}

/// What holds a value of `value` on the JVM.
// example: descriptor_of(ir.Array(ir.Small)) == Array(Integer)
// example: descriptor_of(ir.Of(ir.Text)) == Reference("java/lang/String")
fn descriptor_of(value: ir.Value) -> Descriptor {
    match value {
        ir.Whole => Long
        ir.Truth => Boolean
        ir.Small => Integer
        ir.Character => Character
        ir.Array(held) => Array(descriptor_of(held))
        ir.Of(kind) => Reference(class_of(kind))
    }
}

/// Whether a value of `of` is one a JVM may fold into the class that holds it.
///
/// Only a class this build writes is a value class, and a base of a sum type is not folded,
/// because a field typed as one holds whichever variant it was given.
// example: !is_foldable(hierarchy_of([]), Long)
fn is_foldable(hierarchy: Hierarchy, of: Descriptor) -> Bool {
    match of {
        Reference(class) => is_written_here(hierarchy, class) && !set.has_value(hierarchy.extends_it, class)
        _ => false
    }
}

/// Whether this build writes the class `class`.
// example: !is_written_here(hierarchy_of([]), "a/B")
fn is_written_here(hierarchy: Hierarchy, class: String) -> Bool {
    match map.get(hierarchy.extends, class) {
        Some(_) => true
        None => false
    }
}

/// The instructions of `spelled` assembled into the bytes it runs, with its frames and handlers.
// example: why_code(assembled_of(returning_spelled(), Writer { pool: no_pool(), hierarchy: hierarchy_of([]) })) == ""
fn assembled_of(spelled: Spelled, writer: Writer) -> Result<Assembled, Why> {
    var assembling = Assembling { code: [], frame: entering(spelled.descriptor.parameters, spelled.receiver, spelled.slots), is_reachable: true, landings: map.empty(), landed: [], expected: map.empty(), pending: [], deepest: 0, next: 4294967295, guards: spelled.guards, pool: writer.pool, hierarchy: writer.hierarchy, defect: None }
    for instruction in spelled.instructions {
        assembling = one_written(assembling, instruction)
    }
    finished(assembling, spelled.slots)
}

/// The assembled body: each branch patched, each frame and each handler read off where they land.
///
/// A body longer than a method holds, or with a branch farther than two bytes of offset reach, is
/// refused as too large. A defect found while it was assembled is refused as one.
// example: why_code(finished(assembling_of([]), 0)) == ""
// example: why_code(finished(branched(assembling: assembling_of([]), opcode: 167, label: 3), 0)) == "L0703"
// example: why_code(finished(too_large(), 0)) == "L0700"
fn finished(assembling: Assembling, slots: Int) -> Result<Assembled, Why> {
    _ = sound(assembling.defect)?
    if list.length(assembling.code) > 65535 {
        return Err(TooLarge)
    }
    var patches = map.empty()
    for patch in assembling.pending {
        patches = map.insert(patches, patch.at, reach_of(assembling, patch)?)
    }
    let handlers = caught_of(assembling)?
    Ok(Assembled { code: patched(assembling.code, patches), max_stack: capped(assembling.deepest), max_locals: slots, frames: frames_written(assembling), handlers: handlers, pool: assembling.pool })
}

/// Nothing where no defect was found, and the defect where one was.
// example: why_code(sound(Some("a defect"))) == "L0703"
fn sound(defect: Option<String>) -> Result<(), Why> {
    match defect {
        Some(what) => Err(Defect(what))
        None => Ok(())
    }
}

/// The offset `patch` branches by, or why it has none that two bytes hold.
// example: ok_or(reach_of(landed_with(assembling_of([]), 3, Frame { locals: [], stack: [] }), Patch { at: 0, label: 3, from: 0 }), 1) == 0
fn reach_of(assembling: Assembling, patch: Patch) -> Result<Int, Why> {
    let away = landing_of(assembling, patch.label)? - patch.from
    if away > 32767 || away < -32768 {
        return Err(TooLarge)
    }
    Ok(away)
}

/// A body one byte longer than a method may be, with nothing else assembled.
// example: list.length(too_large().code) == 65536
private fn too_large() -> Assembling {
    var code = []
    for list.length(code) < 65536 {
        code = list.push(code, 0)
    }
    Assembling { code: code, frame: Frame { locals: [], stack: [] }, is_reachable: true, landings: map.empty(), landed: [], expected: map.empty(), pending: [], deepest: 0, next: 4294967295, guards: [], pool: no_pool(), hierarchy: hierarchy_of([]), defect: None }
}

/// `code`, with the two bytes at each place `patches` names replaced by what it holds there.
// example: patched([167, 0, 0], map.insert(map.empty(), 1, 3)) == [167, 0, 3]
fn patched(code: List<Int>, patches: map.Map<Int, Int>) -> List<Int> {
    var written = []
    var at = 0
    for at < list.length(code) {
        written = match map.get(patches, at) {
            Some(value) => bytes.u2(written, value)
            None => list.push(written, or(list.at(code, at), 0))
        }
        at = match map.get(patches, at) {
            Some(_) => at + 2
            None => at + 1
        }
    }
    written
}

/// Each guard as the offsets the exception table names, in the order they were stated.
// example: list.length(ok_or(caught_of(assembling_of([])), [])) == 0
fn caught_of(assembling: Assembling) -> Result<List<Caught>, Why> {
    var caught = []
    for guard in assembling.guards {
        caught = list.push(caught, Caught { from: landing_of(assembling, guard.from)?, to: landing_of(assembling, guard.to)?, handler: landing_of(assembling, guard.handler)?, catching: class_of(guard.catching) })
    }
    Ok(caught)
}

/// Where `label` lands, or the defect of a label that never does.
// example: why_code(landing_of(assembling_of([]), 3)) == "L0703"
fn landing_of(assembling: Assembling, label: Int) -> Result<Int, Why> {
    match map.get(assembling.landings, label) {
        Some(at) => Ok(at)
        None => Err(Defect("a jump goes to a place that is never written"))
    }
}

/// Each place a jump lands, in the order they are written, with no offset named twice.
///
/// Two labels that land at one offset are taken in the order of their numbers, and a label the
/// assembler made for itself has a larger number than any a body names.
// example: list.length(frames_written(assembling_of([]))) == 0
fn frames_written(assembling: Assembling) -> List<Landed> {
    var frames = []
    var seen = -1
    for label in landings_in_order(assembling) {
        let at = landed_at(assembling, label)
        if at != seen {
            frames = match map.get(assembling.expected, label) {
                Some(frame) => list.push(frames, Landed { at: at, frame: frame })
                None => frames
            }
            seen = match map.get(assembling.expected, label) {
                Some(_) => at
                None => seen
            }
        }
    }
    frames
}

/// Each label that landed, by where it landed and then by its number.
// example: list.length(landings_in_order(assembling_of([]))) == 0
fn landings_in_order(assembling: Assembling) -> List<Int> {
    var ordered = []
    for label in assembling.landed {
        ordered = placed(assembling, ordered, label)
    }
    ordered
}

/// `ordered`, with `label` put in its place.
// example: placed(assembling_of([]), [1, 2], 3) == [1, 2, 3]
fn placed(assembling: Assembling, ordered: List<Int>, label: Int) -> List<Int> {
    var placing = []
    var is_put = false
    for one in ordered {
        if !is_put && is_before(assembling: assembling, label: label, other: one) {
            placing = list.push(placing, label)
            is_put = true
        }
        placing = list.push(placing, one)
    }
    if !is_put {
        placing = list.push(placing, label)
    }
    placing
}

/// Whether `label` lands before `other`, or at the same offset with a smaller number.
// example: is_before(assembling: assembling_of([]), label: 1, other: 2)
fn is_before(assembling: Assembling, label: Int, other: Int) -> Bool {
    let at = landed_at(assembling, label)
    let there = landed_at(assembling, other)
    at < there || at == there && label < other
}

/// Where `label`, which has landed, lands.
// example: landed_at(landed_with(assembling_of([]), 3, Frame { locals: [], stack: [] }), 3) == 0
fn landed_at(assembling: Assembling, label: Int) -> Int {
    or(map.get(assembling.landings, label), 0)
}

/// An empty body part-way through being assembled, with no slots and no guards.
// example: assembling_of([]).is_reachable
private fn assembling_of(guards: List<ir.Guard>) -> Assembling {
    Assembling { code: [], frame: Frame { locals: [], stack: [] }, is_reachable: true, landings: map.empty(), landed: [], expected: map.empty(), pending: [], deepest: 0, next: 4294967295, guards: guards, pool: no_pool(), hierarchy: hierarchy_of([]), defect: None }
}

/// What each class extends, each class named once, by the first class of its name.
///
/// A later class of one name is the same class, or `program_written` refuses it as named twice.
// example: set.has_value(hierarchy_of([base_class()]).extends_it, "java/lang/Object")
// example: or(map.get(hierarchy_of([variant_class(), ir.Class { of: variant_class().of, extends: ir.TypeOf { module: ir.OfTheProgram("a"), name: "D" }, extending: ir.Never, implements: [], fields: [], methods: [] }]).extends, "a/B$C"), "") == "a/B"
fn hierarchy_of(classes: List<ir.Class>) -> Hierarchy {
    var extends = map.empty()
    for class in classes {
        let name = class_of(class.of)
        if !is_held(map.get(extends, name)) {
            extends = map.insert(extends, name, class_of(class.extends))
        }
    }
    var bases = set.empty()
    for class in classes {
        bases = set.insert(bases, or(map.get(extends, class_of(class.of)), ""))
    }
    Hierarchy { extends: extends, extends_it: bases }
}

/// `assembling` after one instruction: a label lands, and anything else is written where reached.
// example: list.length(one_written(assembling_of([]), Copy).code) == 0
fn one_written(assembling: Assembling, instruction: Instruction) -> Assembling {
    match instruction {
        Label(label) => guarding(landing(assembling, label), label)
        _ => if assembling.is_reachable {
            instruction_written(assembling, instruction)
        } else {
            assembling
        }
    }
}

/// `assembling`, having said that control may reach the handler of each guard `label` opens or closes.
///
/// A throw reaches a handler, not a branch, so the locals are the ones the span runs with, and
/// the stack holds the throwable alone, which is what the JVM leaves when it hands control over.
// example: assembling_of([]).is_reachable == guarding(assembling_of([]), 0).is_reachable
fn guarding(assembling: Assembling, label: Int) -> Assembling {
    if !assembling.is_reachable {
        return assembling
    }
    var reached = assembling
    for guard in assembling.guards {
        if guard.from == label || guard.to == label {
            let caught = Frame { locals: reached.frame.locals, stack: [HeldObject(class_of(guard.catching))] }
            reached = reaching(reached, guard.handler, caught)
        }
    }
    reached
}

/// Whether some place control may reach `label` from is known.
// example: !is_expecting(assembling_of([]), 3)
private fn is_expecting(assembling: Assembling, label: Int) -> Bool {
    match map.get(assembling.expected, label) {
        Some(_) => true
        None => false
    }
}

/// `assembling` with `instruction` written, and what it does to the stack and the locals followed.
// example: instruction_written(assembling_of([]), LongOf(1)).code == [20, 0, 1]
fn instruction_written(assembling: Assembling, instruction: Instruction) -> Assembling {
    match instruction {
        LongOf(value) => long_written(assembling, value)
        BooleanOf(value) => integer_written(assembling, if value {
            1
        } else {
            0
        })
        IntegerOf(value) => integer_written(assembling, value)
        TextOf(value) => text_written(assembling, value)
        Load { slot, of } => pushed(indexed(assembling: assembling, opcode: load_opcode(of), slot: slot), held_of(of))
        Store { slot, of } => stored(assembling, slot, of)
        Drop(of) => popped(byte(assembling, drop_opcode(of)))
        Copy => copied(assembling)
        Arithmetic(what) => arithmetic_written(assembling, what)
        Concat => invoked(assembling: assembling, opcode: 182, method: concat_method(), receivers: 1)
        CompareLongs(how) => truth(assembling: pushed(popped_times(byte(assembling, 148), 2), HeldInteger), opcode: 153 + step(how), consumes: 1)
        CompareIntegers(how) => truth(assembling: assembling, opcode: 159 + step(how), consumes: 2)
        Not => popped(byte(pushed(byte(assembling, 4), HeldInteger), 130))
        Widen => pushed(popped(byte(assembling, 133)), HeldLong)
        Narrow => pushed(popped(byte(assembling, 136)), HeldInteger)
        LowEightBits => popped(byte(pushed(short(byte(pushed(popped(byte(assembling, 136)), HeldInteger), 17), 255), HeldInteger), 126))
        Label(_) => assembling
        Jump(label) => unreachable(branched(assembling: assembling, opcode: 167, label: label))
        JumpIfFalse(label) => branched(assembling: popped(assembling), opcode: 153, label: label)
        JumpIfNull(label) => branched(assembling: popped(assembling), opcode: 198, label: label)
        New(class) => made(assembling, class)
        NewArray(class) => array_made(assembling, class)
        StoreInArray => popped_times(byte(assembling, 83), 3)
        LoadFromArray => pushed(popped_times(byte(assembling, 50), 2), HeldObject("java/lang/Object"))
        ArrayLength => pushed(popped(byte(assembling, 190)), HeldInteger)
        Construct(method) => constructed(assembling, method)
        GetField(field) => pushed(popped(field_written(assembling, 180, field)), held_of(field.of))
        GetStatic(field) => pushed(field_written(assembling, 178, field), held_of(field.of))
        PutField(field) => popped_times(field_written(assembling, 181, field), 2)
        InvokeStatic(method) => invoked(assembling: assembling, opcode: 184, method: method, receivers: 0)
        InvokeVirtual(method) => invoked(assembling: assembling, opcode: 182, method: method, receivers: 1)
        InvokeInterface(method) => interface_invoked(assembling, method)
        InvokeStaticOfInterface(method) => static_of_interface_invoked(assembling, method)
        Cast(class) => pushed(popped(class_named(assembling, 192, class)), HeldObject(class))
        InstanceOf(class) => pushed(popped(class_named(assembling, 193, class)), HeldInteger)
        Increment(slot) => incremented(assembling, slot)
        Return(of) => unreachable(byte(assembling, return_opcode(of)))
        Throw => unreachable(popped(byte(assembling, 191)))
    }
}

/// `assembling` with a comparison written as the truth value it leaves behind.
// example: truth(assembling: assembling_of([]), opcode: 153, consumes: 1).code == [153, 0, 0, 3, 167, 0, 0, 4]
fn truth(assembling: Assembling, opcode: Int, consumes: Int) -> Assembling {
    let yes = own_label(assembling)
    let done = own_label(yes)
    var writing = branched(assembling: popped_times(done, consumes), opcode: opcode, label: yes.next)
    writing = pushed(byte(writing, 3), HeldInteger)
    writing = unreachable(branched(assembling: writing, opcode: 167, label: done.next))
    writing = pushed(byte(landing(writing, yes.next), 4), HeldInteger)
    landing(writing, done.next)
}

/// `assembling`, having recorded where `label` lands and what holds there.
///
/// A handler is reached with the throwable on the stack, which nothing pushed, so the deepest the
/// stack goes is read here as well as where a value is put on it.
// example: landed_at(landing(assembling_of([]), 3), 3) == 0
fn landing(assembling: Assembling, label: Int) -> Assembling {
    let expecting = if assembling.is_reachable {
        reaching(assembling, label, assembling.frame)
    } else {
        assembling
    }
    match map.get(expecting.expected, label) {
        Some(frame) => landed_with(expecting, label, frame)
        None => expecting
    }
}

/// `assembling`, where `label` lands here with `frame`.
// example: list.length(landed_with(assembling_of([]), 3, Frame { locals: [], stack: [] }).landed) == 1
fn landed_with(assembling: Assembling, label: Int, frame: Frame) -> Assembling {
    let landed = match map.get(assembling.landings, label) {
        Some(_) => assembling.landed
        None => list.push(assembling.landed, label)
    }
    let deepest = greater(one: assembling.deepest, other: depth(frame))
    assembling { frame: frame, deepest: deepest, is_reachable: true, landings: map.insert(assembling.landings, label, offset(assembling)), landed: landed }
}

/// `assembling`, where nothing reaches what comes next until a label says otherwise.
// example: !unreachable(assembling_of([])).is_reachable
fn unreachable(assembling: Assembling) -> Assembling {
    assembling { is_reachable: false }
}

/// `assembling` with a branch to `label`, whose offset is patched once the label lands.
// example: branched(assembling: assembling_of([]), opcode: 167, label: 3).code == [167, 0, 0]
fn branched(assembling: Assembling, opcode: Int, label: Int) -> Assembling {
    let expecting = reaching(assembling, label, assembling.frame)
    let from = offset(expecting)
    let written = byte(expecting, opcode)
    short(written { pending: list.push(written.pending, Patch { at: list.length(written.code), label: label, from: from }) }, 0)
}

/// `assembling`, having said that control may reach `label` holding what `frame` holds.
// example: is_expecting(reaching(assembling_of([]), 3, Frame { locals: [], stack: [] }), 3)
// example: is_held(reaching(reaching(assembling_of([]), 3, Frame { locals: [], stack: [] }), 3, Frame { locals: [], stack: [HeldLong] }).defect)
fn reaching(assembling: Assembling, label: Int, frame: Frame) -> Assembling {
    let merged = match map.get(assembling.expected, label) {
        Some(known) => merged_with(frame: known, other: frame, hierarchy: assembling.hierarchy)
        None => Ok(frame)
    }
    match merged {
        Ok(expected) => assembling { expected: map.insert(assembling.expected, label, expected) }
        Err(defect) => defective(assembling, defect)
    }
}

/// `assembling`, having found `defect`, where it found none before; the first one found is kept.
// example: or(defective(defective(assembling_of([]), "one"), "two").defect, "") == "one"
fn defective(assembling: Assembling, defect: String) -> Assembling {
    if is_held(assembling.defect) {
        return assembling
    }
    assembling { defect: Some(defect) }
}

/// `assembling` with a label of the assembler's own taken, counting down from the largest.
// example: own_label(assembling_of([])).next == 4294967294
fn own_label(assembling: Assembling) -> Assembling {
    assembling { next: assembling.next - 1 }
}

/// `assembling` with a whole number put on the stack, out of the constant pool.
// example: long_written(assembling_of([]), 7).code == [20, 0, 1]
fn long_written(assembling: Assembling, value: Int) -> Assembling {
    let held = pooled(assembling.pool, LongEntry(value))
    pushed(short(byte(assembling { pool: held.pool }, 20), held.index), HeldLong)
}

/// `assembling` with a small whole number put on the stack in the fewest bytes that hold it.
// example: integer_written(assembling_of([]), -1).code == [16, 255]
// example: integer_written(assembling_of([]), 1000).code == [17, 3, 232]
fn integer_written(assembling: Assembling, value: Int) -> Assembling {
    let written = if value == 0 {
        byte(assembling, 3)
    } else if value == 1 {
        byte(assembling, 4)
    } else if value >= -128 && value <= 127 {
        each_byte(assembling, [16, bytes.wrapped(value, 256)])
    } else if value >= -32768 && value <= 32767 {
        short(byte(assembling, 17), value)
    } else {
        pooled_integer(assembling, value)
    }
    pushed(written, HeldInteger)
}

/// `assembling` with a small whole number put on the stack out of the constant pool.
// example: pooled_integer(assembling_of([]), 100000).code == [18, 1]
fn pooled_integer(assembling: Assembling, value: Int) -> Assembling {
    let held = pooled(assembling.pool, IntegerEntry(value))
    constant(assembling { pool: held.pool }, held.index)
}

/// `assembling` with text put on the stack, out of the constant pool.
// example: text_written(assembling_of([]), "a").code == [18, 2]
fn text_written(assembling: Assembling, value: String) -> Assembling {
    let held = pooled_text(assembling.pool, value)
    pushed(constant(assembling { pool: held.pool }, held.index), HeldObject("java/lang/String"))
}

/// `assembling` with what the pool holds at `held` put on the stack, in one word.
// example: constant(assembling_of([]), 300).code == [19, 1, 44]
fn constant(assembling: Assembling, held: Int) -> Assembling {
    if held < 256 {
        return each_byte(assembling, [18, held])
    }
    short(byte(assembling, 19), held)
}

/// The opcode that loads a value `of` holds.
// example: load_opcode(Long) == 22
fn load_opcode(of: Descriptor) -> Int {
    match of {
        Long => 22
        Reference(_) => 25
        Array(_) => 25
        _ => 21
    }
}

/// `assembling` with a value stored in `slot`, which holds it from here on.
// example: stored(assembling_of([]), 0, Long).code == [55, 0]
fn stored(assembling: Assembling, slot: Int, of: Descriptor) -> Assembling {
    let opcode = match of {
        Long => 55
        Reference(_) => 58
        Array(_) => 58
        _ => 54
    }
    let written = popped(indexed(assembling: assembling, opcode: opcode, slot: slot))
    written { frame: held_in(written.frame, slot, of) }
}

/// `assembling` with an instruction that names a local, widened where the slot needs two bytes.
// example: indexed(assembling: assembling_of([]), opcode: 22, slot: 300).code == [196, 22, 1, 44]
fn indexed(assembling: Assembling, opcode: Int, slot: Int) -> Assembling {
    if slot < 256 {
        return each_byte(assembling, [opcode, slot])
    }
    short(each_byte(assembling, [196, opcode]), slot)
}

/// The opcode that drops a value `of` holds: two words for a whole number, and one otherwise.
// example: drop_opcode(Long) == 88
fn drop_opcode(of: Descriptor) -> Int {
    match of {
        Long => 88
        _ => 87
    }
}

/// `assembling` with the top of the stack copied, and nothing done where the stack is empty.
// example: copied(assembling_of([])).code == []
fn copied(assembling: Assembling) -> Assembling {
    match list.at(assembling.frame.stack, list.length(assembling.frame.stack) - 1) {
        Some(top) => pushed(byte(assembling, copy_opcode(top)), top)
        None => assembling
    }
}

/// The opcode that copies `top`: two words for a whole number, and one otherwise.
// example: copy_opcode(HeldLong) == 92
fn copy_opcode(top: Held) -> Int {
    match top {
        HeldLong => 92
        _ => 89
    }
}

/// `assembling` with arithmetic on whole numbers, which takes two and leaves one, or negates one.
// example: arithmetic_written(assembling_of([]), ir.Negate).code == [117]
fn arithmetic_written(assembling: Assembling, what: ir.Arithmetic) -> Assembling {
    match what {
        ir.Add => popped(byte(assembling, 97))
        ir.Subtract => popped(byte(assembling, 101))
        ir.Multiply => popped(byte(assembling, 105))
        ir.Divide => popped(byte(assembling, 109))
        ir.Remainder => popped(byte(assembling, 113))
        ir.Negate => byte(assembling, 117)
    }
}

/// `String.concat`, which joins two texts.
// example: concat_method().name == "concat"
fn concat_method() -> MethodRef {
    MethodRef { class: "java/lang/String", name: "concat", descriptor: MethodDescriptor { parameters: [text_descriptor()], result: Some(text_descriptor()) } }
}

/// What holds text.
// example: descriptor_text(text_descriptor()) == "Ljava/lang/String;"
fn text_descriptor() -> Descriptor {
    Reference(class_of(ir.Text))
}

/// The class a value of `kind` is, as a class file names it.
// example: class_of(ir.Text) == "java/lang/String"
// example: class_of(ir.TypeOf { module: ir.ThePrelude, name: "List" }) == "bux/List"
// example: class_of(ir.VariantOf { module: ir.OfTheLibrary("lexer"), of: "Token", variant: "Word" }) == "bux/library/lexer/Token$Word"
// example: class_of(ir.ProcessOf { module: ir.OfTheProgram("main"), name: "Counter" }) == "main/process$Counter"
// example: class_of(ir.ForeignClass("java.lang.Thread")) == "java/lang/Thread"
fn class_of(kind: ir.Kind) -> String {
    match kind {
        ir.Anything => "java/lang/Object"
        ir.Text => "java/lang/String"
        ir.TypeOf { module, name } => type_class(module, name)
        ir.VariantOf { module, of, variant } => type_class(module, of) + "$" + variant
        ir.ModuleOf(module) => module_class(module)
        ir.ProcessOf { module, name } => module_class(module) + "/process$" + name
        ir.ForeignClass(dotted) => ir.dots_replaced(dotted, "/")
        ir.Mailbox => "java/util/concurrent/ArrayBlockingQueue"
        ir.End => "java/util/concurrent/CompletableFuture"
        ir.Envelope => "java/util/concurrent/atomic/AtomicReference"
        ir.Task => "java/lang/Runnable"
        ir.Failure => "java/lang/Throwable"
        ir.JavaList => "java/util/List"
    }
}

/// The class of the type `name` that `module` declares; the prelude's types are in `bux`.
// example: type_class(ir.OfTheProgram("demo"), "Box") == "demo/Box"
fn type_class(module: ir.Module, name: String) -> String {
    match module {
        ir.ThePrelude => "bux/" + name
        _ => module_class(module) + "/" + name
    }
}

/// The class of `module`, which holds its functions.
///
/// A module of the library is a class of the package `bux/library`, and a module of the program
/// is a class of no package, so a program may name a module as the library names one.
// example: module_class(ir.ThePrelude) == "bux/library/prelude"
// example: module_class(ir.OfTheProgram("demo")) == "demo"
fn module_class(module: ir.Module) -> String {
    match module {
        ir.ThePrelude => "bux/library/prelude"
        ir.OfTheLibrary(name) => "bux/library/" + name
        ir.OfTheProgram(name) => name
    }
}

/// How far a comparison's opcode sits from `ifeq`, which is as far as it sits from `if_icmpeq`.
// example: step(ir.GreaterOrEqual) == 3
fn step(how: ir.Comparison) -> Int {
    match how {
        ir.Equal => 0
        ir.NotEqual => 1
        ir.Less => 2
        ir.LessOrEqual => 5
        ir.Greater => 4
        ir.GreaterOrEqual => 3
    }
}

/// `assembling` with an instance of `class` made, which is not built until its constructor runs.
// example: made(assembling_of([]), "a/B").code == [187, 0, 2]
fn made(assembling: Assembling, class: String) -> Assembling {
    let named = pooled_class(assembling.pool, class)
    let at = offset(assembling)
    pushed(short(byte(assembling { pool: named.pool }, 187), named.index), Uninitialised(at))
}

/// The offset the next instruction is written at.
// example: offset(assembling_of([])) == 0
fn offset(assembling: Assembling) -> Int {
    capped(list.length(assembling.code))
}

/// `assembling` with an array of `class` as long as the number on the stack, which it replaces.
// example: array_made(assembling_of([]), "java/lang/Object").code == [189, 0, 2]
fn array_made(assembling: Assembling, class: String) -> Assembling {
    let written = popped(class_named(assembling, 189, class))
    pushed(written, held_of(Array(Reference(class))))
}

/// `assembling` with an instruction that names `class` out of the pool.
// example: class_named(assembling_of([]), 192, "a/B").code == [192, 0, 2]
fn class_named(assembling: Assembling, opcode: Int, class: String) -> Assembling {
    let named = pooled_class(assembling.pool, class)
    short(byte(assembling { pool: named.pool }, opcode), named.index)
}

/// `assembling` with an instruction that names `field` out of the pool.
// example: field_written(assembling_of([]), 180, boxed_at()).code == [180, 0, 6]
fn field_written(assembling: Assembling, opcode: Int, field: FieldRef) -> Assembling {
    let named = pooled_field(assembling.pool, field)
    short(byte(assembling { pool: named.pool }, opcode), named.index)
}

/// `assembling` with a constructor run, which builds each copy of the instance it is handed.
// example: list.length(constructed(assembling_of([]), box_made()).code) == 3
fn constructed(assembling: Assembling, method: MethodRef) -> Assembling {
    let named = pooled_method(assembling.pool, method)
    let written = popped_times(short(byte(assembling { pool: named.pool }, 183), named.index), list.length(method.descriptor.parameters))
    let top = list.at(written.frame.stack, list.length(written.frame.stack) - 1)
    let taken = popped(written)
    match top {
        Some(Uninitialised(at)) => taken { frame: initialised(taken.frame, at, method.class) }
        _ => taken
    }
}

/// `assembling` with a method called: its arguments and receiver taken, and its result left.
// example: list.length(invoked(assembling: assembling_of([]), opcode: 184, method: box_made(), receivers: 0).frame.stack) == 0
fn invoked(assembling: Assembling, opcode: Int, method: MethodRef, receivers: Int) -> Assembling {
    let named = pooled_method(assembling.pool, method)
    returned_from(short(byte(assembling { pool: named.pool }, opcode), named.index), method, receivers)
}

/// `assembling` with a method of an interface called on the receiver below its arguments.
// example: list.length(interface_invoked(assembling_of([]), box_made()).code) == 5
fn interface_invoked(assembling: Assembling, method: MethodRef) -> Assembling {
    let named = pooled_interface_method(assembling.pool, method)
    let taken = parameters_width(method.descriptor) + 1
    let counted = if taken > 255 {
        255
    } else {
        taken
    }
    returned_from(each_byte(short(byte(assembling { pool: named.pool }, 185), named.index), [counted, 0]), method, 1)
}

/// How many slots the parameters of `method` take.
// example: parameters_width(MethodDescriptor { parameters: [Long, object()], result: None }) == 3
fn parameters_width(method: MethodDescriptor) -> Int {
    var slots = 0
    for parameter in method.parameters {
        slots += width(parameter)
    }
    slots
}

/// `assembling` with a static method of an interface called, which the pool names as such.
// example: list.length(static_of_interface_invoked(assembling_of([]), box_made()).code) == 3
fn static_of_interface_invoked(assembling: Assembling, method: MethodRef) -> Assembling {
    let named = pooled_interface_method(assembling.pool, method)
    returned_from(short(byte(assembling { pool: named.pool }, 184), named.index), method, 0)
}

/// `assembling` with one byte written.
// example: byte(assembling_of([]), 3).code == [3]
fn byte(assembling: Assembling, value: Int) -> Assembling {
    assembling { code: bytes.u1(assembling.code, value) }
}

/// What a call leaves: its arguments gone, the receiver too, and its result on top.
// example: list.length(returned_from(assembling_of([]), box_made(), 0).frame.stack) == 0
fn returned_from(assembling: Assembling, method: MethodRef, receivers: Int) -> Assembling {
    let taken = popped_times(assembling, list.length(method.descriptor.parameters) + receivers)
    match method.descriptor.result {
        Some(result) => pushed(taken, held_of(result))
        None => taken
    }
}

/// `assembling` with `held` put on the stack, and the deepest the stack goes kept.
// example: pushed(assembling_of([]), HeldLong).deepest == 2
fn pushed(assembling: Assembling, held: Held) -> Assembling {
    let frame = assembling.frame
    let grown = frame { stack: list.push(frame.stack, held) }
    assembling { frame: grown, deepest: greater(one: assembling.deepest, other: depth(grown)) }
}

/// The larger of `one` and `other`.
// example: greater(one: 3, other: 5) == 5
fn greater(one: Int, other: Int) -> Int {
    if one > other {
        return one
    }
    other
}

/// `assembling` with `count` values taken off the stack.
// example: list.length(popped_times(pushed(assembling_of([]), HeldLong), 2).frame.stack) == 0
fn popped_times(assembling: Assembling, count: Int) -> Assembling {
    var popping = assembling
    var left = count
    for left > 0 {
        popping = popped(popping)
        left = left - 1
    }
    popping
}

/// `assembling` with the top of the stack taken off, where there is one.
// example: list.length(popped(pushed(assembling_of([]), HeldLong)).frame.stack) == 0
fn popped(assembling: Assembling) -> Assembling {
    let frame = assembling.frame
    assembling { frame: frame { stack: without_last(frame.stack) } }
}

/// `values` without the last one.
// example: without_last([1, 2]) == [1]
fn without_last<T>(values: List<T>) -> List<T> {
    var kept = []
    var at = 0
    for value in values {
        if at < list.length(values) - 1 {
            kept = list.push(kept, value)
        }
        at += 1
    }
    kept
}

/// `assembling` with one added to the small whole number in `slot`, widened where it needs to be.
// example: incremented(assembling_of([]), 3).code == [132, 3, 1]
fn incremented(assembling: Assembling, slot: Int) -> Assembling {
    if slot < 256 {
        return each_byte(assembling, [132, slot, 1])
    }
    short(short(each_byte(assembling, [196, 132]), slot), 1)
}

/// `assembling` with two bytes written.
// example: short(assembling_of([]), 258).code == [1, 2]
fn short(assembling: Assembling, value: Int) -> Assembling {
    assembling { code: bytes.u2(assembling.code, value) }
}

/// `assembling` with each of `values` written as one byte.
// example: each_byte(assembling_of([]), [1, 2]).code == [1, 2]
fn each_byte(assembling: Assembling, values: List<Int>) -> Assembling {
    assembling { code: bytes.all(assembling.code, values) }
}

/// The opcode that gives back a value `of` holds, and nothing for `void`.
// example: return_opcode(None) == 177
fn return_opcode(of: Option<Descriptor>) -> Int {
    match of {
        Some(Long) => 173
        Some(Reference(_)) => 176
        Some(Array(_)) => 176
        Some(_) => 172
        None => 177
    }
}

/// What a method starts with: what it is reached through, then its parameters.
// example: list.length(entering([Long], None, 3).locals) == 3
fn entering(parameters: List<Descriptor>, receiver: Option<String>, slots: Int) -> Frame {
    var locals = []
    var at = 0
    for at < slots {
        locals = list.push(locals, Nothing)
        at += 1
    }
    var frame = Frame { locals: locals, stack: [] }
    at = 0
    frame = match receiver {
        Some(class) => frame { locals: replaced(frame.locals, 0, Holding(HeldObject(class))) }
        None => frame
    }
    at = receiver_width(receiver)
    for parameter in parameters {
        frame = held_in(frame, at, parameter)
        at += width(parameter)
    }
    frame
}

/// The slot a receiver takes, which a static method has none of.
// example: receiver_width(Some("a/B")) == 1
fn receiver_width(receiver: Option<String>) -> Int {
    match receiver {
        Some(_) => 1
        None => 0
    }
}

/// `frame`, with `slot` holding a value `of` holds, and the slot after it where that is two wide.
// example: held_in(Frame { locals: [Nothing, Nothing], stack: [] }, 0, Long).locals == [Holding(HeldLong), Second]
fn held_in(frame: Frame, slot: Int, of: Descriptor) -> Frame {
    let holding = replaced(frame.locals, slot, Holding(held_of(of)))
    if width(of) == 2 {
        return frame { locals: replaced(holding, slot + 1, Second) }
    }
    frame { locals: holding }
}

/// How many slots a value `of` holds takes: two for a `long`, and one for anything else.
// example: width(Long) == 2
// example: width(Integer) == 1
fn width(of: Descriptor) -> Int {
    match of {
        Long => 2
        _ => 1
    }
}

/// `values`, with the one at `at` replaced by `value`.
// example: replaced([1, 2, 3], 1, 5) == [1, 5, 3]
fn replaced<T>(values: List<T>, at: Int, value: T) -> List<T> {
    var written = []
    var position = 0
    for one in values {
        written = if position == at {
            list.push(written, value)
        } else {
            list.push(written, one)
        }
        position += 1
    }
    written
}

/// `frame`, with every copy of the instance made at `at` now one that is built.
// example: initialised(Frame { locals: [], stack: [Uninitialised(4)] }, 4, "a/B").stack == [HeldObject("a/B")]
fn initialised(frame: Frame, at: Int, class: String) -> Frame {
    var stack = []
    for held in frame.stack {
        stack = list.push(stack, built_if_made(held, at, class))
    }
    var locals = []
    for slot in frame.locals {
        locals = match slot {
            Holding(held) => list.push(locals, Holding(built_if_made(held, at, class)))
            _ => list.push(locals, slot)
        }
    }
    Frame { locals: locals, stack: stack }
}

/// `held`, or a built `class` where it is the instance made at `at`.
// example: built_if_made(Uninitialised(4), 4, "a/B") == HeldObject("a/B")
fn built_if_made(held: Held, at: Int, class: String) -> Held {
    if held == Uninitialised(at) {
        return HeldObject(class)
    }
    held
}

/// The stack words `frame` holds, which is what the deepest stack is the largest of.
// example: depth(Frame { locals: [], stack: [HeldLong, HeldInteger] }) == 3
fn depth(frame: Frame) -> Int {
    var words = 0
    for held in frame.stack {
        words += held_width(held)
    }
    words
}

/// The stack words `held` takes, which is two for a whole number.
// example: held_width(HeldLong) == 2
fn held_width(held: Held) -> Int {
    match held {
        HeldLong => 2
        _ => 1
    }
}

/// What holds on both paths into one place, which is what the verifier is told.
///
/// A slot that holds one thing on one path and another on the other holds nothing, and a value
/// that is one class on one path and another on the other is the class they share. Two paths
/// with locals or a stack of two lengths are a defect, which is refused, not cut to the shorter.
// example: ok_or(merged_with(frame: Frame { locals: [Holding(HeldLong)], stack: [] }, other: Frame { locals: [Nothing], stack: [] }, hierarchy: hierarchy_of([])), Frame { locals: [], stack: [] }).locals == [Nothing]
// example: ok_or(merged_with(frame: Frame { locals: [], stack: [HeldLong] }, other: Frame { locals: [], stack: [] }, hierarchy: hierarchy_of([])), Frame { locals: [], stack: [HeldLong] }).stack == [HeldLong]
fn merged_with(frame: Frame, other: Frame, hierarchy: Hierarchy) -> Result<Frame, String> {
    if list.length(frame.locals) != list.length(other.locals) || list.length(frame.stack) != list.length(other.stack) {
        return Err("two paths into one place hold a different number of values")
    }
    var locals = []
    var at = 0
    for mine in frame.locals {
        locals = match list.at(other.locals, at) {
            Some(theirs) => list.push(locals, if mine == theirs {
                mine
            } else {
                Nothing
            })
            None => locals
        }
        at += 1
    }
    var stack = []
    at = 0
    for mine in frame.stack {
        stack = match list.at(other.stack, at) {
            Some(theirs) => list.push(stack, shared_by(hierarchy: hierarchy, mine: mine, theirs: theirs))
            None => stack
        }
        at += 1
    }
    Ok(Frame { locals: locals, stack: stack })
}

/// The class both are: one of them, the one they extend, or `java.lang.Object`.
// example: shared_by(hierarchy: hierarchy_of([]), mine: HeldObject("a/B"), theirs: HeldObject("a/C")) == HeldObject("java/lang/Object")
fn shared_by(hierarchy: Hierarchy, mine: Held, theirs: Held) -> Held {
    match mine {
        HeldObject(one) => match theirs {
            HeldObject(other) => HeldObject(class_shared(hierarchy: hierarchy, one: one, other: other))
            _ => mine
        }
        _ => mine
    }
}

/// The class `one` and `other` share, read one step up the hierarchy.
// example: class_shared(hierarchy: hierarchy_of([variant_class()]), one: "a/B$C", other: "a/B") == "a/B"
fn class_shared(hierarchy: Hierarchy, one: String, other: String) -> String {
    if one == other {
        return one
    }
    let above_one = or(map.get(hierarchy.extends, one), "java/lang/Object")
    let above_other = or(map.get(hierarchy.extends, other), "java/lang/Object")
    if above_one == other {
        return other
    }
    if above_other == one {
        return one
    }
    if above_one == above_other {
        return above_one
    }
    "java/lang/Object"
}

/// `into`, with `frame` after it as a full frame, which is the one form that says everything.
// example: frame_written(no_pool(), Frame { locals: [Holding(HeldInteger)], stack: [] }, 3, []).bytes == [255, 0, 3, 0, 1, 1, 0, 0]
fn frame_written(pool: Pool, frame: Frame, delta: Int, into: List<Int>) -> Written {
    let named = named_locals(frame)
    var writing = Written { pool: pool, bytes: bytes.u2(bytes.u2(bytes.u1(into, 255), delta), capped(list.length(named))) }
    for slot in named {
        writing = match slot {
            Holding(held) => held_written(writing, held)
            _ => Written { pool: writing.pool, bytes: bytes.u1(writing.bytes, 0) }
        }
    }
    writing = Written { pool: writing.pool, bytes: bytes.u2(writing.bytes, capped(list.length(frame.stack))) }
    for held in frame.stack {
        writing = held_written(writing, held)
    }
    writing
}

/// The locals as a frame writes them.
///
/// The second half of a whole number is left out, a slot that holds nothing yet is the verifier's
/// `Top`, and the slots after the last one that holds anything are left off.
// example: named_locals(Frame { locals: [Holding(HeldLong), Second, Nothing], stack: [] }) == [Holding(HeldLong)]
fn named_locals(frame: Frame) -> List<Slot> {
    var last = 0
    var at = 0
    for slot in frame.locals {
        at += 1
        last = match slot {
            Holding(_) => at
            _ => last
        }
    }
    var named = []
    at = 0
    for slot in frame.locals {
        if at < last {
            named = match slot {
                Second => named
                _ => list.push(named, slot)
            }
        }
        at += 1
    }
    named
}

/// `writing`, with one value a frame holds after it.
// example: held_written(Written { pool: no_pool(), bytes: [] }, HeldLong).bytes == [4]
fn held_written(writing: Written, held: Held) -> Written {
    match held {
        HeldInteger => Written { pool: writing.pool, bytes: bytes.u1(writing.bytes, 1) }
        HeldLong => Written { pool: writing.pool, bytes: bytes.u1(writing.bytes, 4) }
        HeldObject(class) => object_written(writing, class)
        Uninitialised(at) => Written { pool: writing.pool, bytes: bytes.u2(bytes.u1(writing.bytes, 8), at) }
    }
}

/// `writing`, with an object of `class` after it, which the pool names.
// example: object_written(Written { pool: no_pool(), bytes: [] }, "a/B").bytes == [7, 0, 2]
fn object_written(writing: Written, class: String) -> Written {
    let named = pooled_class(writing.pool, class)
    Written { pool: named.pool, bytes: bytes.u2(bytes.u1(writing.bytes, 7), named.index) }
}

/// What a value `of` holds is, to the verifier; a truth value is a small whole number there.
// example: held_of(Array(Long)) == HeldObject("[J")
fn held_of(of: Descriptor) -> Held {
    match of {
        Long => HeldLong
        Reference(class) => HeldObject(class)
        Array(held) => HeldObject("[" + descriptor_text(held))
        _ => HeldInteger
    }
}

/// A constant pool that holds nothing yet, whose first index is one, as a class file counts.
// example: no_pool().next == 1
fn no_pool() -> Pool {
    Pool { entries: [], known: map.empty(), next: 1 }
}

/// `pool` with `text` held as text, and its index.
// example: pooled_text(no_pool(), "a").index == 2
fn pooled_text(pool: Pool, text: String) -> Pooled {
    let held = pooled_utf8(pool, text)
    pooled(held.pool, TextEntry(held.index))
}

/// `pool` with `field` held, and its index.
// example: pooled_field(no_pool(), boxed_at()).index == 6
fn pooled_field(pool: Pool, field: FieldRef) -> Pooled {
    let class = pooled_class(pool, field.class)
    let member = name_and_type(pool: class.pool, name: field.name, descriptor: descriptor_text(field.of))
    pooled(member.pool, FieldEntry { class: class.index, member: member.index })
}

/// `pool` with `method` held as a method of a class, and its index.
// example: pooled_method(no_pool(), box_made()).index == 6
fn pooled_method(pool: Pool, method: MethodRef) -> Pooled {
    let class = pooled_class(pool, method.class)
    let member = name_and_type(pool: class.pool, name: method.name, descriptor: method_descriptor_text(method.descriptor))
    pooled(member.pool, MethodEntry { class: class.index, member: member.index })
}

/// `pool` with `method` held as a method of an interface, and its index.
// example: pooled_interface_method(no_pool(), box_made()).index == 6
fn pooled_interface_method(pool: Pool, method: MethodRef) -> Pooled {
    let class = pooled_class(pool, method.class)
    let member = name_and_type(pool: class.pool, name: method.name, descriptor: method_descriptor_text(method.descriptor))
    pooled(member.pool, InterfaceMethodEntry { class: class.index, member: member.index })
}

/// `method` as a class file writes it.
// example: method_descriptor_text(MethodDescriptor { parameters: [Long, object()], result: Some(Boolean) }) == "(JLjava/lang/Object;)Z"
fn method_descriptor_text(method: MethodDescriptor) -> String {
    var written = "("
    for parameter in method.parameters {
        written += descriptor_text(parameter)
    }
    written + ")" + held_text(method.result)
}

/// What a value `held` holds is written as in a descriptor, and `V` for nothing.
// example: held_text(Some(Long)) == "J"
// example: held_text(None) == "V"
fn held_text(held: Option<Descriptor>) -> String {
    match held {
        Some(of) => descriptor_text(of)
        None => "V"
    }
}

/// `of` as a class file writes it.
// example: descriptor_text(Array(Integer)) == "[I"
fn descriptor_text(of: Descriptor) -> String {
    match of {
        Long => "J"
        Boolean => "Z"
        Integer => "I"
        Character => "C"
        Reference(class) => "L" + class + ";"
        Array(held) => "[" + descriptor_text(held)
    }
}

/// `pool` with a name and a descriptor held as one member, and its index.
// example: name_and_type(pool: no_pool(), name: "of", descriptor: "()V").index == 3
fn name_and_type(pool: Pool, name: String, descriptor: String) -> Pooled {
    let named = pooled_utf8(pool, name)
    let described = pooled_utf8(named.pool, descriptor)
    pooled(described.pool, NameAndTypeEntry { name: named.index, descriptor: described.index })
}

/// `pool` with the class `class` held, and its index.
// example: pooled_class(no_pool(), "a/B").index == 2
fn pooled_class(pool: Pool, class: String) -> Pooled {
    let written = pooled_utf8(pool, class)
    pooled(written.pool, ClassEntry(written.index))
}

/// `pool` with `text` held as modified UTF-8, and its index.
// example: pooled_utf8(no_pool(), "a").index == 1
fn pooled_utf8(pool: Pool, text: String) -> Pooled {
    pooled(pool, Utf8Entry(text))
}

/// `pool` with `entry` held, and its index; an entry held already keeps the index it has.
///
/// A whole number takes two indices, the second of which a class file leaves unusable.
// example: pooled(pooled(no_pool(), LongEntry(1)).pool, Utf8Entry("a")).index == 3
fn pooled(pool: Pool, entry: Entry) -> Pooled {
    let key = entry_key(entry)
    match map.get(pool.known, key) {
        Some(index) => Pooled { pool: pool, index: index }
        None => Pooled { pool: Pool { entries: list.push(pool.entries, entry), known: map.insert(pool.known, key, pool.next), next: pool.next + entry_width(entry) }, index: pool.next }
    }
}

/// How many indices `entry` takes: two for a whole number, and one otherwise.
// example: entry_width(LongEntry(1)) == 2
fn entry_width(entry: Entry) -> Int {
    match entry {
        LongEntry(_) => 2
        _ => 1
    }
}

/// The key two equal entries share, and no two different entries do.
// example: entry_key(ClassEntry(3)) == "class 3"
fn entry_key(entry: Entry) -> String {
    match entry {
        Utf8Entry(text) => "utf8 " + text
        IntegerEntry(value) => "integer " + shown(value)
        LongEntry(value) => "long " + shown(value)
        TextEntry(held) => "text " + shown(held)
        ClassEntry(written) => "class " + shown(written)
        NameAndTypeEntry { name, descriptor } => "member " + shown(name) + " " + shown(descriptor)
        FieldEntry { class, member } => "field " + shown(class) + " " + shown(member)
        MethodEntry { class, member } => "method " + shown(class) + " " + shown(member)
        InterfaceMethodEntry { class, member } => "interface " + shown(class) + " " + shown(member)
    }
}

/// Every entry of `pool`, in the order they were added, as a class file writes them.
// example: pool_written(pooled_utf8(no_pool(), "a").pool) == [1, 0, 1, 97]
fn pool_written(pool: Pool) -> List<Int> {
    var written = []
    for entry in pool.entries {
        written = entry_written(written, entry)
    }
    written
}

/// `into`, with one entry of the pool after it.
// example: entry_written([], IntegerEntry(-1)) == [3, 255, 255, 255, 255]
fn entry_written(into: List<Int>, entry: Entry) -> List<Int> {
    match entry {
        Utf8Entry(text) => utf8_written(into, text)
        IntegerEntry(value) => bytes.u4(bytes.u1(into, 3), value)
        LongEntry(value) => bytes.u8(bytes.u1(into, 5), value)
        TextEntry(held) => bytes.u2(bytes.u1(into, 8), held)
        ClassEntry(written) => bytes.u2(bytes.u1(into, 7), written)
        NameAndTypeEntry { name, descriptor } => pair_written(into: into, tag: 12, first: name, second: descriptor)
        FieldEntry { class, member } => pair_written(into: into, tag: 9, first: class, second: member)
        MethodEntry { class, member } => pair_written(into: into, tag: 10, first: class, second: member)
        InterfaceMethodEntry { class, member } => pair_written(into: into, tag: 11, first: class, second: member)
    }
}

/// `into`, with a text entry after it, whose length `texts_held` has held to two bytes already.
// example: utf8_written([], "a") == [1, 0, 1, 97]
fn utf8_written(into: List<Int>, text: String) -> List<Int> {
    let encoded = bytes.modified_utf8(text)
    bytes.all(bytes.u2(bytes.u1(into, 1), list.length(encoded)), encoded)
}

/// `value`, or the largest two bytes hold where it is larger.
// example: capped(70000) == 65535
fn capped(value: Int) -> Int {
    if value > 65535 {
        return 65535
    }
    value
}

/// `into`, with an entry of the tag `tag` that names two other entries after it.
// example: pair_written(into: [], tag: 12, first: 1, second: 2) == [12, 0, 1, 0, 2]
fn pair_written(into: List<Int>, tag: Int, first: Int, second: Int) -> List<Int> {
    bytes.u2(bytes.u2(bytes.u1(into, tag), first), second)
}

/// Whether `maybe` holds a value.
// example: !is_held(None)
fn is_held<T>(maybe: Option<T>) -> Bool {
    match maybe {
        Some(_) => true
        None => false
    }
}

/// The code of the refusal `answer` holds, and nothing where it holds none.
// example: refused_code(Ok(1)) == ""
// example: refused_code(Err(Unwritten { class: "a/B", method: None, why: TooLarge })) == "L0700"
fn refused_code<T>(answer: Result<T, Unwritten>) -> String {
    match answer {
        Ok(_) => ""
        Err(unwritten) => code_of(unwritten.why)
    }
}

/// The code of the reason `answer` holds, and nothing where it holds none.
// example: why_code(Err(Defect("a defect"))) == "L0703"
private fn why_code<T>(answer: Result<T, Why>) -> String {
    match answer {
        Ok(_) => ""
        Err(why) => code_of(why)
    }
}

/// The code a refusal of the writer is refused with, which `docs/specs/diagnostics.md` lists.
// example: code_of(TooLong(65536)) == "L0701"
fn code_of(why: Why) -> String {
    match why {
        TooLarge => "L0700"
        TooLong(_) => "L0701"
        NamedTwice => "L0702"
        NamedInCase(_) => "L0702"
        Defect(_) => "L0703"
    }
}

/// The line a refusal of the writer opens with, which names the function or the type it is in.
// example: message(Unwritten { class: "demo", method: Some("total$Int"), why: TooLarge }) == "`total` is too large to compile as one function"
// example: message(Unwritten { class: "demo/Box", method: None, why: TooLong(65536) }) == "a text or a name in `demo/Box` takes 65536 bytes, and one takes 65535 at most"
// example: message(Unwritten { class: "demo/SetUp", method: None, why: NamedInCase("demo/Setup") }) == "two names in `demo` differ only in case: `demo/SetUp` and `demo/Setup`"
fn message(unwritten: Unwritten) -> String {
    let named = named_in(unwritten)
    match unwritten.why {
        TooLarge => "`" + named + "` is too large to compile as one function"
        TooLong(length) => "a text or a name in `" + named + "` takes " + shown(length) + " bytes, and one takes 65535 at most"
        NamedTwice => "two parts of this program are both named `" + module_of(unwritten.class) + "`"
        NamedInCase(earlier) => "two names in `" + module_of(unwritten.class) + "` differ only in case: `" + unwritten.class + "` and `" + earlier + "`"
        Defect(what) => "the compiler did not write `" + named + "`: " + what
    }
}

/// What a reader does about a refusal of the writer.
// example: help_of(TooLarge) == "split the function into smaller functions"
fn help_of(why: Why) -> String {
    match why {
        TooLarge => "split the function into smaller functions"
        TooLong(_) => "split the text into parts joined with `+`, or give the name fewer characters"
        NamedTwice => "rename this module, so that no other part of the program has its name"
        NamedInCase(_) => "rename one of the two, so that their names differ in more than case"
        Defect(_) => "this is a defect of the compiler; report it with the program that shows it"
    }
}

/// The module a class belongs to: `<module>` under `bux/library/`, else its name up to the first `/`.
///
/// A class `bux/<Type>` is a type of the prelude, or of a program's module named `bux`. The
/// prelude is written first, so a class refused there is the program's, and it names `bux`.
// example: module_of("demo/Box") == "demo"
// example: module_of("strings") == "strings"
// example: module_of("bux/library/strings") == "strings"
// example: module_of("bux/library/lexer/Span") == "lexer"
// example: module_of("bux/Option") == "bux"
fn module_of(class: String) -> String {
    let library = "bux/library/"
    let within = strings.length(library)
    if or(strings.cut(class, 0, within), "") == library {
        return up_to(or(strings.cut(class, within, strings.length(class)), class), 47)
    }
    up_to(class, 47)
}

/// The function a refusal is in, which is the method up to its first `$`, or else the class.
// example: named_in(Unwritten { class: "demo", method: Some("total$Int"), why: TooLarge }) == "total"
// example: named_in(Unwritten { class: "demo", method: None, why: TooLarge }) == "demo"
fn named_in(unwritten: Unwritten) -> String {
    match unwritten.method {
        Some(method) => up_to(method, 36)
        None => unwritten.class
    }
}

/// `name` up to the first code unit `unit`, or all of `name` where it holds none.
///
/// Up to a `$`, it is the function that a specialised or derived method was written for.
/// Up to a `/`, it is the package of a class.
// example: up_to("Eq$Box$is_equal", 36) == "Eq"
// example: up_to("total", 36) == "total"
fn up_to(name: String, unit: Int) -> String {
    var at = 0
    for at < strings.length(name) {
        if or(strings.at(name, at), 0) == unit {
            return or(strings.cut(name, 0, at), name)
        }
        at += 1
    }
    name
}

/// A lowered module of the one class `class`.
// example: list.length(one_class(record_class()).classes) == 1
fn one_class(class: ir.Class) -> ir.Lowered {
    ir.Lowered { classes: [class], asks: ir.no_asks() }
}

/// The record `a.B`, which holds one whole number, `at`.
// example: class_of(record_class().of) == "a/B"
private fn record_class() -> ir.Class {
    record_class_named("B")
}

/// The record `named` of the module `a`, which holds one whole number, `at`.
// example: class_of(record_class_named("b").of) == "a/b"
private fn record_class_named(named: String) -> ir.Class {
    ir.Class { of: ir.TypeOf { module: ir.OfTheProgram("a"), name: named }, extends: ir.Anything, extending: ir.Never, implements: [], fields: [ir.Field { name: "at", of: ir.Whole }], methods: [] }
}

/// The variant `C` of `a.B`, which extends the base `a.B`.
// example: class_of(variant_class().extends) == "a/B"
private fn variant_class() -> ir.Class {
    ir.Class { of: ir.VariantOf { module: ir.OfTheProgram("a"), of: "B", variant: "C" }, extends: base_class().of, extending: ir.Never, implements: [], fields: [], methods: [] }
}

/// The base `a.B` of a sum type, which holds the tag of its variant.
// example: base_class().extends == ir.Anything
private fn base_class() -> ir.Class {
    ir.Class { of: ir.TypeOf { module: ir.OfTheProgram("a"), name: "B" }, extends: ir.Anything, extending: ir.ByItsVariants, implements: [], fields: [ir.Field { name: "tag", of: ir.Small }], methods: [] }
}

/// A static method `of` that gives back the whole number one.
// example: returning_method().name == "of"
private fn returning_method() -> ir.Method {
    let body = ir.Body { instructions: [ir.LongOf(1), ir.Return(Some(ir.Whole))], locals: [], guards: [] }
    ir.Method { name: "of", parameters: [], result: Some(ir.Whole), reached: ir.ThroughTheClass, body: body }
}

/// The method `returning_method` spelled, which gives back the whole number one.
// example: list.length(returning_spelled().instructions) == 2
private fn returning_spelled() -> Spelled {
    Spelled { name: "of", descriptor: MethodDescriptor { parameters: [], result: Some(Long) }, receiver: None, instructions: [LongOf(1), Return(Some(Long))], slots: 0, guards: [] }
}

/// The field `at` of the record `a/B`.
// example: boxed_at().name == "at"
private fn boxed_at() -> FieldRef {
    FieldRef { class: "a/B", name: "at", of: Long }
}

/// The constructor of the record `a/B`, which takes one whole number.
// example: box_made().name == "<init>"
private fn box_made() -> MethodRef {
    MethodRef { class: "a/B", name: "<init>", descriptor: MethodDescriptor { parameters: [Long], result: None } }
}

/// A class the writer did not write, the method of it at fault where one is, and why.
type Unwritten = {
    class: String
    method: Option<String>
    why: Why
}

/// Why a class was not written: past a limit a program can reach, or a defect of the compiler.
///
/// A method holds 65535 bytes of code, and a branch reaches 32767 bytes either way, and a body
/// past either is too large. A text of the pool holds 65535 bytes, and one of more is too long.
/// Two modules of one name write two different classes of one name, and one file holds one.
/// Two classes whose names differ only in case are one file on a disk that ignores case, and
/// `NamedInCase` holds the name of the class written first.
type Why =
    | TooLarge
    | TooLong(Int)
    | NamedTwice
    | NamedInCase(String)
    | Defect(String)

/// One class, and the path a build writes it to, such as `demo/User.class`.
type ClassFile = {
    path: String
    bytes: List<Int>
}

/// What writing one class holds besides the bytes: the pool so far, and the hierarchy.
type Writer = {
    pool: Pool
    hierarchy: Hierarchy
}

/// Bytes written, and the pool after they are written.
type Written = {
    pool: Pool
    bytes: List<Int>
}

/// A body's bytes, with everything its `Code` attribute is written from.
type Assembled = {
    code: List<Int>
    max_stack: Int
    max_locals: Int
    frames: List<Landed>
    handlers: List<Caught>
    pool: Pool
}

/// One place a jump lands, and what holds there.
type Landed = {
    at: Int
    frame: Frame
}

/// One row of the exception table: the span covered, where it lands, and what it catches.
type Caught = {
    from: Int
    to: Int
    handler: Int
    catching: String
}

/// A body part-way through being assembled.
type Assembling = {
    code: List<Int>
    frame: Frame
    is_reachable: Bool
    landings: map.Map<Int, Int>
    landed: List<Int>
    expected: map.Map<Int, Frame>
    pending: List<Patch>
    deepest: Int
    next: Int
    guards: List<ir.Guard>
    pool: Pool
    hierarchy: Hierarchy
    defect: Option<String>
}

/// What extends what, which is how two classes are found to share one, and each class extended.
type Hierarchy = {
    extends: map.Map<String, String>
    extends_it: set.Set<String>
}

/// A branch whose landing was not known when it was written: where its offset goes, the label,
/// and where its opcode sits, which the offset is measured from.
type Patch = {
    at: Int
    label: Int
    from: Int
}

/// What holds where control is, which is what a frame says.
type Frame = {
    locals: List<Slot>
    stack: List<Held>
}

/// One local slot: what it holds, the second half of a whole number, or nothing yet.
derive Eq for Slot

type Slot =
    | Holding(Held)
    | Second
    | Nothing

/// What one value is, as the verifier counts them; an instance not yet built is named by where
/// it was made.
derive Eq for Held

type Held =
    | HeldInteger
    | HeldLong
    | HeldObject(String)
    | Uninitialised(Int)

/// A pool after an entry is asked for, and the index the entry has.
type Pooled = {
    pool: Pool
    index: Int
}

/// Everything one class file names, each named once, in the order it was first asked for.
type Pool = {
    entries: List<Entry>
    known: map.Map<String, Int>
    next: Int
}

/// One entry of the constant pool.
type Entry =
    | Utf8Entry(String)
    | IntegerEntry(Int)
    | LongEntry(Int)
    | TextEntry(Int)
    | ClassEntry(Int)
    | NameAndTypeEntry {
        name: Int
        descriptor: Int
    }
    | FieldEntry {
        class: Int
        member: Int
    }
    | MethodEntry {
        class: Int
        member: Int
    }
    | InterfaceMethodEntry {
        class: Int
        member: Int
    }

/// A method as a JVM runs it: its name and descriptor, the class of its receiver where it has
/// one, its instructions over numbered slots, how many slots it takes, and its guards.
type Spelled = {
    name: String
    descriptor: MethodDescriptor
    receiver: Option<String>
    instructions: List<Instruction>
    slots: Int
    guards: List<ir.Guard>
}

/// Where the locals of one method live: the slot of each name, and how many slots they take.
type Locals = {
    slots: map.Map<String, Placed>
    width: Int
}

/// Where one local lives: the first of its slots, and how many slots it takes.
type Placed = {
    at: Int
    width: Int
}

/// One instruction a JVM runs, over a stack and numbered slots.
type Instruction =
    | LongOf(Int)
    | BooleanOf(Bool)
    | IntegerOf(Int)
    | TextOf(String)
    | Load {
        slot: Int
        of: Descriptor
    }
    | Store {
        slot: Int
        of: Descriptor
    }
    | Drop(Descriptor)
    | Copy
    | Arithmetic(ir.Arithmetic)
    | Concat
    | CompareLongs(ir.Comparison)
    | CompareIntegers(ir.Comparison)
    | Not
    | Widen
    | Narrow
    | LowEightBits
    | Label(Int)
    | Jump(Int)
    | JumpIfFalse(Int)
    | JumpIfNull(Int)
    | New(String)
    | NewArray(String)
    | StoreInArray
    | LoadFromArray
    | ArrayLength
    | Construct(MethodRef)
    | GetField(FieldRef)
    | GetStatic(FieldRef)
    | PutField(FieldRef)
    | InvokeStatic(MethodRef)
    | InvokeVirtual(MethodRef)
    | InvokeInterface(MethodRef)
    | InvokeStaticOfInterface(MethodRef)
    | Cast(String)
    | InstanceOf(String)
    | Increment(Int)
    | Return(Option<Descriptor>)
    | Throw

/// A field of a class.
type FieldRef = {
    class: String
    name: String
    of: Descriptor
}

/// A method of a class.
type MethodRef = {
    class: String
    name: String
    descriptor: MethodDescriptor
}

/// What a method takes, and what it gives back, which is nothing for `void`.
type MethodDescriptor = {
    parameters: List<Descriptor>
    result: Option<Descriptor>
}

/// What holds a value on the JVM.
derive Eq for Descriptor

type Descriptor =
    | Long
    | Boolean
    | Integer
    | Character
    | Reference(String)
    | Array(Descriptor)
