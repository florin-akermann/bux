// The lexer: source text to tokens, each with the byte span of the text it covers.
//
// `docs/specs/lexer.md` states what it does, and `tests/lexing.bx` holds it on drawn text.
// `tests/siblings.bx` holds it to every `.tokens` file under `tests/spec`.
// Lexing is total: text the language has no use for is an `Unknown` or an `UnterminatedString`.
// A string is read one UTF-16 code unit at a time, and a span counts the bytes of its UTF-8 form.
import list
import strings

/// The tokens of `source`, one line each: the kind, then the span as a start and an end.
// example: listed("x := 1") == "Identifier 0..1\nPunct(:=) 2..4\nInteger 5..6\n"
// example: listed("fn\n") == "Keyword(fn) 0..2\nNewline 2..3\n"
fn listed(source: String) -> String {
    var written = ""
    for token in lex(source) {
        written += shown(token) + "\n"
    }
    written
}

/// The tokens `source` lexes to, in source order.
///
/// Blanks separate tokens and give none, and every other byte lies inside one token's span.
// example: list.length(lex("fn main")) == 2
// example: list.length(lex(" \t\r")) == 0
fn lex(source: String) -> List<Token> {
    var tokens = []
    var rest = Rest { source: source, start: run_length(Rest { source: source, start: 0 }, Blanks) }
    var offset = rest.start
    for rest.start < strings.length(source) {
        scanned := scan_token(rest)
        length := byte_length(rest, scanned.units)
        text := or(strings.cut(source, rest.start, rest.start + scanned.units), "")
        tokens = list.push(tokens, Token { kind: scanned.kind, span: Span { start: offset, length: length }, text: text })
        after := rest { start: rest.start + scanned.units }
        blanks := run_length(after, Blanks)
        offset += length + blanks
        rest = after { start: after.start + blanks }
    }
    tokens
}

/// The kind and the length in code units of the token at the start of `rest`.
///
/// `rest` holds at least one more code unit, and it is not a blank.
// example: shown(scan_token(Rest { source: "a::=", start: 2 }).kind) == "Punct(:=)"
// example: scan_token(Rest { source: "// note\n", start: 0 }).units == 7
fn scan_token(rest: Rest) -> Scanned {
    first := letter_at(rest, 0)
    if first == "\n" {
        return Scanned { kind: Newline, units: 1 }
    }
    if has_prefix(rest, "//") {
        return Scanned { kind: LineComment, units: run_length(rest, RestOfLine) }
    }
    if is_part_of(first, Digits) {
        return Scanned { kind: Integer, units: run_length(rest, Digits) }
    }
    if is_part_of(first, WordLetters) {
        return scan_word(rest)
    }
    if first == "\"" {
        return scan_string(rest)
    }
    scan_punctuation(rest)
}

/// An identifier, or the keyword it spells.
// example: shown(scan_word(Rest { source: "fnord", start: 0 }).kind) == "Identifier"
// example: shown(scan_word(Rest { source: "fn(", start: 0 }).kind) == "Keyword(fn)"
fn scan_word(rest: Rest) -> Scanned {
    length := run_length(rest, WordLetters)
    word := or(strings.cut(rest.source, rest.start, rest.start + length), "")
    Scanned { kind: word_kind(word), units: length }
}

/// The keyword `word` spells, or an identifier where it spells none.
// example: shown(word_kind("match")) == "Keyword(match)"
// example: shown(word_kind("_x")) == "Identifier"
fn word_kind(word: String) -> TokenKind {
    for keyword in keywords() {
        if keyword_text(keyword) == word {
            return Keyword(keyword)
        }
    }
    Identifier
}

/// A string from its opening quote to the first unescaped `"` on the same line.
///
/// It is an unterminated string where the line or the input ends first, and it stops before the
/// line ending, so the newline is still a token of its own.
// example: shown(scan_string(Rest { source: "\"a\\\"b\" c", start: 0 }).kind) == "String"
// example: scan_string(Rest { source: "\"ab\nc", start: 0 }).units == 3
fn scan_string(rest: Rest) -> Scanned {
    var ahead = 1
    for is_part_of(letter_at(rest, ahead), RestOfLine) {
        letter := letter_at(rest, ahead)
        if letter == "\"" {
            return Scanned { kind: String, units: ahead + 1 }
        }
        if letter == "\\" && is_part_of(letter_at(rest, ahead + 1), RestOfLine) {
            ahead += 1
        }
        ahead += 1
    }
    Scanned { kind: UnterminatedString, units: ahead }
}

/// The longest punctuation `rest` starts with, or one unknown character where it starts none.
// example: scan_punctuation(Rest { source: "->", start: 0 }).units == 2
// example: shown(scan_punctuation(Rest { source: "@", start: 0 }).kind) == "Unknown"
fn scan_punctuation(rest: Rest) -> Scanned {
    for punctuation in every_punctuation() {
        text := punctuation_text(punctuation)
        if has_prefix(rest, text) {
            return Scanned { kind: Punct(punctuation), units: strings.length(text) }
        }
    }
    Scanned { kind: Unknown, units: character_length(rest) }
}

/// How many code units the character at the start of `rest` takes, which is two for a pair.
///
/// A JVM holds a character outside the basic plane, such as an emoji, as two code units: a high
/// surrogate, then a low one. Every other character is one code unit.
// example: character_length(Rest { source: "é", start: 0 }) == 1
// example: character_length(Rest { source: "😀", start: 0 }) == 2
fn character_length(rest: Rest) -> Int {
    if is_high_surrogate(unit_at(rest, 0)) && is_low_surrogate(unit_at(rest, 1)) {
        return 2
    }
    1
}

/// How many bytes the UTF-8 form of the first `units` code units of `rest` takes.
// example: byte_length(Rest { source: "aé", start: 0 }, 2) == 3
// example: byte_length(Rest { source: "😀", start: 0 }, 2) == 4
fn byte_length(rest: Rest, units: Int) -> Int {
    var length = 0
    var ahead = 0
    for ahead < units {
        length += unit_width(unit_at(rest, ahead))
        ahead += 1
    }
    length
}

/// How many bytes one code unit takes in UTF-8, where each half of a surrogate pair takes two.
///
/// A code unit below 128 is one byte, one below 2048 is two, and any other is three. A pair of
/// surrogates is one character of four bytes, so each half counts as two.
// example: unit_width(97) == 1
// example: unit_width(233) == 2
// example: unit_width(8364) == 3
// example: unit_width(55357) == 2
fn unit_width(unit: Int) -> Int {
    if unit < 128 {
        return 1
    }
    if unit < 2048 {
        return 2
    }
    if is_high_surrogate(unit) || is_low_surrogate(unit) {
        return 2
    }
    3
}

/// Whether `unit` is the first half of a pair of code units, which is 55296 up to 56319.
// example: is_high_surrogate(55357)
// example: !is_high_surrogate(56832)
fn is_high_surrogate(unit: Int) -> Bool {
    unit >= 55296 && unit <= 56319
}

/// Whether `unit` is the second half of a pair of code units, which is 56320 up to 57343.
// example: is_low_surrogate(56832)
// example: !is_low_surrogate(55357)
fn is_low_surrogate(unit: Int) -> Bool {
    unit >= 56320 && unit <= 57343
}

/// The code unit `ahead` units into `rest`, and -1 past the end, which is no code unit at all.
// example: unit_at(Rest { source: "ab", start: 1 }, 0) == 98
// example: unit_at(Rest { source: "ab", start: 1 }, 1) == -1
fn unit_at(rest: Rest, ahead: Int) -> Int {
    or(strings.at(rest.source, rest.start + ahead), -1)
}

/// Whether `rest` starts with `text`.
// example: has_prefix(Rest { source: "a:=", start: 1 }, ":=")
// example: !has_prefix(Rest { source: "a:", start: 1 }, ":=")
fn has_prefix(rest: Rest, text: String) -> Bool {
    from := rest.start
    match strings.cut(rest.source, from, from + strings.length(text)) {
        Some(part) => part == text
        None => false
    }
}

/// How many code units at the start of `rest` are part of `run`.
// example: run_length(Rest { source: "123abc", start: 0 }, Digits) == 3
// example: run_length(Rest { source: "ab // c\nd", start: 3 }, RestOfLine) == 4
fn run_length(rest: Rest, run: Run) -> Int {
    var length = 0
    for is_part_of(letter_at(rest, length), run) {
        length += 1
    }
    length
}

/// The code unit `ahead` units into `rest`, as a text of its own, and `""` past the end.
///
/// The empty text is part of no run, so a loop over a run stops at the end of the input.
// example: letter_at(Rest { source: "ab", start: 1 }, 0) == "b"
// example: letter_at(Rest { source: "ab", start: 1 }, 1) == ""
fn letter_at(rest: Rest, ahead: Int) -> String {
    from := rest.start + ahead
    or(strings.cut(rest.source, from, from + 1), "")
}

/// Whether `letter`, one code unit as a text of its own, is part of `run`.
// example: is_part_of("\t", Blanks)
// example: !is_part_of("", RestOfLine)
fn is_part_of(letter: String, run: Run) -> Bool {
    match run {
        Blanks => letter == " " || letter == "\t" || letter == "\r"
        Digits => letter >= "0" && letter <= "9"
        WordLetters => is_word_letter(letter)
        RestOfLine => letter != "" && letter != "\n" && letter != "\r"
    }
}

/// Whether `letter` is an ASCII letter, an ASCII digit, or `_`, which is what a word is made of.
///
/// A word never starts with a digit, because a digit starts a number first.
// example: is_word_letter("_")
// example: !is_word_letter("é")
fn is_word_letter(letter: String) -> Bool {
    if letter >= "a" && letter <= "z" {
        return true
    }
    if letter >= "A" && letter <= "Z" {
        return true
    }
    letter == "_" || letter >= "0" && letter <= "9"
}

/// Every keyword, so that a word can be looked up among them.
// example: list.length(keywords()) == 21
fn keywords() -> List<Keyword> {
    [Fn, Type, Trait, Instance, Derive, Process, Spawn, Var, If, Else, For, In, Match, Break, ContinueLoop, Return, Import, Extern, True, False, Underscore]
}

/// Every punctuation, longest first, so that `:=` wins over `:` and `->` over `-`.
// example: list.length(every_punctuation()) == 30
fn every_punctuation() -> List<Punct> {
    [Walrus, EqEq, BangEq, LtEq, GtEq, PlusEq, AndAnd, OrOr, Arrow, FatArrow, Eq, Lt, Gt, Plus, Minus, Star, Slash, Percent, Bang, Question, Dot, Comma, Colon, Pipe, LParen, RParen, LBrace, RBrace, LBracket, RBracket]
}

instance Show<Token> {
    fn shown(value: Token) -> String {
        shown(value.kind) + " " + shown(value.span)
    }
}

instance Show<Span> {
    fn shown(value: Span) -> String {
        shown(value.start) + ".." + shown(value.start + value.length)
    }
}

instance Show<TokenKind> {
    fn shown(value: TokenKind) -> String {
        match value {
            Identifier => "Identifier"
            Keyword(keyword) => "Keyword(" + keyword_text(keyword) + ")"
            Integer => "Integer"
            String => "String"
            Punct(punctuation) => "Punct(" + punctuation_text(punctuation) + ")"
            Newline => "Newline"
            LineComment => "LineComment"
            UnterminatedString => "UnterminatedString"
            Unknown => "Unknown"
        }
    }
}

/// The text that spells `keyword`, which is how a later phase names one in a message.
// example: keyword_text(Underscore) == "_"
fn keyword_text(keyword: Keyword) -> String {
    match keyword {
        Fn => "fn"
        Type => "type"
        Trait => "trait"
        Instance => "instance"
        Derive => "derive"
        Process => "process"
        Spawn => "spawn"
        Var => "var"
        If => "if"
        Else => "else"
        For => "for"
        In => "in"
        Match => "match"
        Break => "break"
        ContinueLoop => "continue"
        Return => "return"
        Import => "import"
        Extern => "extern"
        True => "true"
        False => "false"
        Underscore => "_"
    }
}

/// The text that spells `punctuation`, which is how a later phase names one in a message.
// example: punctuation_text(FatArrow) == "=>"
fn punctuation_text(punctuation: Punct) -> String {
    match punctuation {
        Walrus => ":="
        EqEq => "=="
        BangEq => "!="
        LtEq => "<="
        GtEq => ">="
        PlusEq => "+="
        AndAnd => "&&"
        OrOr => "||"
        Arrow => "->"
        FatArrow => "=>"
        Eq => "="
        Lt => "<"
        Gt => ">"
        Plus => "+"
        Minus => "-"
        Star => "*"
        Slash => "/"
        Percent => "%"
        Bang => "!"
        Question => "?"
        Dot => "."
        Comma => ","
        Colon => ":"
        Pipe => "|"
        LParen => "("
        RParen => ")"
        LBrace => "{"
        RBrace => "}"
        LBracket => "["
        RBracket => "]"
    }
}

/// One token of the source: what it is, where its text lies, and the text itself.
///
/// A span counts UTF-8 bytes and a string is read in UTF-16 code units, so a span alone cannot
/// cut the text out of the source again; the parser reads a name and a literal from `text`.
type Token = {
    kind: TokenKind
    span: Span
    text: String
}

/// Where a token's text lies, as a byte offset into the UTF-8 source and a length in bytes.
type Span = {
    start: Int
    length: Int
}

/// The source, and the code unit where the part not yet lexed starts.
type Rest = {
    source: String
    start: Int
}

/// A token not yet placed: its kind, and how many code units of the source it takes.
type Scanned = {
    kind: TokenKind
    units: Int
}

derive Eq for TokenKind

derive Eq for Keyword

derive Eq for Punct

/// The token classes, with the two that keep lexing total last.
type TokenKind =
    | Identifier
    | Keyword(Keyword)
    | Integer
    | String
    | Punct(Punct)
    | Newline
    | LineComment
    | UnterminatedString
    | Unknown

/// The words the grammar reserves, and `_`, which is written on the left of `=` and nowhere else.
type Keyword =
    | Fn
    | Type
    | Trait
    | Instance
    | Derive
    | Process
    | Spawn
    | Var
    | If
    | Else
    | For
    | In
    | Match
    | Break
    | ContinueLoop
    | Return
    | Import
    | Extern
    | True
    | False
    | Underscore

/// Operators and punctuation.
type Punct =
    | Walrus
    | EqEq
    | BangEq
    | LtEq
    | GtEq
    | PlusEq
    | AndAnd
    | OrOr
    | Arrow
    | FatArrow
    | Eq
    | Lt
    | Gt
    | Plus
    | Minus
    | Star
    | Slash
    | Percent
    | Bang
    | Question
    | Dot
    | Comma
    | Colon
    | Pipe
    | LParen
    | RParen
    | LBrace
    | RBrace
    | LBracket
    | RBracket

/// A kind of code unit a token runs over for as long as the source goes on giving one.
type Run =
    | Blanks
    | Digits
    | WordLetters
    | RestOfLine
