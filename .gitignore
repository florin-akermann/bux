/target
CLAUDE.md

# transient /code-review pre-commit gate file
.review-passed

# dev-team plugin exhaust: metrics, scratch memory, review reports. Disposable;
# nothing in this repo reads it.
.claude/metrics/
.claude/memory/
.claude/agent-memory/
.dev-team-reports/

# Python bytecode from `uv run` dev tooling
__pycache__/

# hegeltest regression corpora, rebuilt by a run; nothing in this repo reads them
.hegel/

# class files a `lumen build` writes beside a source file; the source is what the repo keeps
tests/spec/**/*.class
example/**/*.class
