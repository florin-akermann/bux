// The names every module has in scope without importing anything.
//
// `docs/specs/library.md` says where this file lives and why it is Bux rather than a table.
// The compiler carries it, compiles it before every other module, and puts what it declares in
// scope unasked.
// example: or(Some(1), 0) == 1
// example: or(None, 0) == 0
fn or<T>(maybe: Option<T>, fallback: T) -> T {
    match maybe {
        Some(value) => value
        None => fallback
    }
}

/// The value an answer holds, or `fallback` where it holds why it failed instead.
// example: ok_or(Ok(1), 0) == 1
// example: ok_or(Err("no"), 0) == 0
fn ok_or<T, E>(answer: Result<T, E>, fallback: T) -> T {
    match answer {
        Ok(value) => value
        Err(why) => fallback
    }
}

instance Eq<Bool> {
    fn is_equal(one: Bool, other: Bool) -> Bool {
        one == other
    }
}

instance Eq<Int> {
    fn is_equal(one: Int, other: Int) -> Bool {
        one == other
    }
}

instance Eq<String> {
    fn is_equal(one: String, other: String) -> Bool {
        one == other
    }
}

instance<T: Eq<T>> Eq<List<T>> {
    fn is_equal(one: List<T>, other: List<T>) -> Bool {
        var index = 0
        for value in one {
            var alike = match at(other, index) {
                Some(held) => value == held
                None => false
            }
            if alike {
                index += 1
            } else {
                return false
            }
        }
        var counted = 0
        for held in other {
            counted += 1
        }
        index == counted
    }
}

instance Hash<Bool> {
    fn hashed(value: Bool) -> Int {
        match value {
            true => 1
            false => 0
        }
    }
}

instance Hash<Int> {
    fn hashed(value: Int) -> Int {
        value
    }
}

instance Hash<String> {
    fn hashed(value: String) -> Int {
        hashed_text(value)
    }
}

instance<T: Hash<T>> Hash<List<T>> {
    fn hashed(value: List<T>) -> Int {
        var code = 1
        for held in value {
            code = code * 31 + hashed(held)
        }
        code
    }
}

instance Show<Bool> {
    fn shown(value: Bool) -> String {
        shown_truth(value)
    }
}

instance Show<Int> {
    fn shown(value: Int) -> String {
        shown_number(value)
    }
}

instance Show<String> {
    fn shown(value: String) -> String {
        value
    }
}

instance<T: Show<T>> Show<List<T>> {
    fn shown(value: List<T>) -> String {
        var text = "["
        var first = true
        for held in value {
            if first {
                first = false
            } else {
                text += ", "
            }
            text += shown(held)
        }
        text + "]"
    }
}

instance Ord<Bool> {
    fn is_less(one: Bool, other: Bool) -> Bool {
        one < other
    }
}

instance Ord<Int> {
    fn is_less(one: Int, other: Int) -> Bool {
        one < other
    }
}

instance Ord<String> {
    fn is_less(one: String, other: String) -> Bool {
        one < other
    }
}

instance<T: Ord<T>> Ord<List<T>> {
    fn is_less(one: List<T>, other: List<T>) -> Bool {
        var index = 0
        for value in one {
            var against = at(other, index)
            var below = match against {
                Some(held) => value < held
                None => false
            }
            if below {
                return true
            }
            var above = match against {
                Some(held) => held < value
                None => true
            }
            if above {
                return false
            }
            index += 1
        }
        var counted = 0
        for held in other {
            counted += 1
        }
        index < counted
    }
}

instance Add<Int> {
    fn add(one: Int, other: Int) -> Int {
        one + other
    }
}

instance Add<String> {
    fn add(one: String, other: String) -> String {
        one + other
    }
}

instance Sub<Int> {
    fn subtract(one: Int, other: Int) -> Int {
        one - other
    }
}

instance Mul<Int> {
    fn multiply(one: Int, other: Int) -> Int {
        one * other
    }
}

instance Div<Int> {
    fn divide(one: Int, other: Int) -> Option<Int> {
        one / other
    }
}

instance Rem<Int> {
    fn remainder(one: Int, other: Int) -> Option<Int> {
        one % other
    }
}

instance Neg<Int> {
    fn negate(value: Int) -> Int {
        -value
    }
}

instance IntegerLiteral<Int> {
    fn lowest() -> Int {
        -9223372036854775808
    }

    fn highest() -> Int {
        9223372036854775807
    }

    fn from_literal(literal: Int) -> Int {
        literal
    }
}

trait Eq<T> {
    fn is_equal(one: T, other: T) -> Bool
}

trait Ord<T> {
    fn is_less(one: T, other: T) -> Bool
}

trait Hash<T> {
    fn hashed(value: T) -> Int
}

trait Show<T> {
    fn shown(value: T) -> String
}

trait Add<T> {
    fn add(one: T, other: T) -> T
}

trait Sub<T> {
    fn subtract(one: T, other: T) -> T
}

trait Mul<T> {
    fn multiply(one: T, other: T) -> T
}

trait Div<T> {
    fn divide(one: T, other: T) -> Option<T>
}

trait Rem<T> {
    fn remainder(one: T, other: T) -> Option<T>
}

trait Neg<T> {
    fn negate(value: T) -> T
}

trait IntegerLiteral<T> {
    fn lowest() -> Int
    fn highest() -> Int
    fn from_literal(literal: Int) -> T
}

type Option<T> =
    | Some(T)
    | None

type Result<T, E> =
    | Ok(T)
    | Err(E)

/// What `receive` gives back: the next state of a process, or the end of it.
type Next<T> =
    | Continue(T)
    | Done

/// What became of one message that `send` put toward a process.
type Sent =
    | Delivered
    | MailboxFull
    | ProcessEnded

/// How long `send` waits while the mailbox is full.
type Waiting =
    | NoWait
    | Milliseconds(Int)
    | NoLimit

/// `value` as the text a JVM writes a truth value as, which is `true` or `false`.
extern static shown_truth(value: Bool) -> String = "java.lang.String.valueOf"

/// `value` as the text a JVM writes a whole number as, which is its digits and a sign.
extern static shown_number(value: Int) -> String = "java.lang.String.valueOf"

/// The whole number a JVM reads `value` off the characters of, widened from the `int` it gives.
extern method int hashed_text(value: String) -> Int = "hashCode"
