// Reading a file, writing one, listing, making, and removing a directory, and asking about a path.
//
// `docs/specs/io.md` states what each of these gives back. Each is written over `extern`
// declarations, which `docs/specs/interop.md` states, and every step that can throw gives a
// `Result`, except the close of a file read in parts, which gives nothing back to guard.
import list
import strings

// example: ok_or(read(""), "nothing there") == "nothing there"
fn read(path: String) -> Result<String, String> {
    match as_a_path(named(path)) {
        Ok(found) => read_whole(found)
        Err(why) => Err(why)
    }
}

// example: ok_or(read_bytes(""), [1]) == [1]
fn read_bytes(path: String) -> Result<List<Int>, String> {
    match as_a_path(named(path)) {
        Ok(found) => each_byte(read_whole_as(found, strings.as_latin_1()))
        Err(why) => Err(why)
    }
}

// example: ok_or(read_between(path: "no-such-file.bin", from: 0, to: 1), "not there") == "not there"
// example: ok_or(read_between(path: "unused.bin", from: 2, to: 1), "refused") == "refused"
// example: ok_or(read_between(path: "unused.bin", from: 0, to: 2147483648), "refused") == "refused"
fn read_between(path: String, from: Int, to: Int) -> Result<String, String> {
    if from < 0 || to < from {
        return Err("no part of " + path + " runs from " + shown(from) + " to " + shown(to))
    }
    if to - from > 2147483647 {
        return Err(too_long(path: path, length: to - from))
    }
    match size(path) {
        Ok(end) => part_before(path: path, from: from, to: to, end: end)
        Err(why) => Err(why)
    }
}

// example: ok_or(part_before(path: "no-such-file.bin", from: 3, to: 9, end: 3), "none") == ""
fn part_before(path: String, from: Int, to: Int, end: Int) -> Result<String, String> {
    var last = to
    if end < last {
        last = end
    }
    if from >= last {
        return Ok("")
    }
    match allotted(last - from) {
        Ok(Some(buffer)) => read_into(path: path, buffer: buffer, from: from)
        Ok(None) => Err(too_long(path: path, length: last - from))
        Err(why) => Err(why)
    }
}

// example: too_long(path: "a.txt", length: 3) == "a part of 3 bytes of a.txt is more than one buffer holds"
fn too_long(path: String, length: Int) -> String {
    "a part of " + shown(length) + " bytes of " + path + " is more than one buffer holds"
}

// example: ok_or(part_before(path: "no-such-file.bin", from: 0, to: 9, end: 9), "none") == "none"
fn read_into(path: String, buffer: strings.Bytes, from: Int) -> Result<String, String> {
    match opened_to_read(path) {
        Ok(stream) => read_and_let_go(stream: stream, buffer: buffer, from: from)
        Err(why) => Err(why)
    }
}

// example: ok_or(part_before(path: "no-such-file.bin", from: 0, to: 9, end: 9), "none") == "none"
fn read_and_let_go(stream: Source, buffer: strings.Bytes, from: Int) -> Result<String, String> {
    let part = filled(channel: channel_of(stream), buffer: buffer, from: from)
    let_go(stream)
    part
}

// A read can give fewer bytes than the room that is left, and `-1` at the end of the file.
// A count of `0` also stops the reads, so that no loop waits on a file that holds no more.
// example: ok_or(part_before(path: "no-such-file.bin", from: 0, to: 9, end: 9), "none") == "none"
fn filled(channel: Channel, buffer: strings.Bytes, from: Int) -> Result<String, String> {
    var at = from
    for has_room(buffer) {
        let answer = read_at(channel, buffer, at)
        let count = ok_or(answer, 0)
        if count <= 0 {
            return text_or_why(answer: answer, buffer: buffer)
        }
        at += count
    }
    Ok(text_of(buffer))
}

// example: ok_or(part_before(path: "no-such-file.bin", from: 0, to: 9, end: 9), "none") == "none"
fn text_or_why(answer: Result<Int, String>, buffer: strings.Bytes) -> Result<String, String> {
    match answer {
        Ok(_) => Ok(text_of(buffer))
        Err(why) => Err(why)
    }
}

// example: ok_or(part_before(path: "no-such-file.bin", from: 0, to: 9, end: 9), "none") == "none"
fn text_of(buffer: strings.Bytes) -> String {
    strings.spelled(strings.decoded(strings.as_latin_1(), flipped(buffer)))
}

// example: ok_or(size("no-such-file.bin"), -1) == -1
fn size(path: String) -> Result<Int, String> {
    match as_a_path(named(path)) {
        Ok(found) => byte_count(found)
        Err(why) => Err(why)
    }
}

// example: ok_or(each_byte(Ok("AB")), []) == [65, 66]
fn each_byte(answer: Result<String, String>) -> Result<List<Int>, String> {
    match answer {
        Ok(text) => Ok(values_of(text))
        Err(why) => Err(why)
    }
}

// example: values_of("é") == [233]
fn values_of(text: String) -> List<Int> {
    var values = []
    var index = 0
    for index < strings.length(text) {
        values = list.push(values, or(strings.at(text, index), 0))
        index += 1
    }
    values
}

// example: ok_or(write(path: "", text: ""), "nothing written") == "nothing written"
fn write(path: String, text: String) -> Result<String, String> {
    match opened(path, strings.as_utf_8()) {
        Ok(sink) => sent(sink: sink, text: text, to: path)
        Err(why) => Err(why)
    }
}

// The sink must close here, because the file does not get the text before the close.
// example: ok_or(write(path: "", text: ""), "nothing written") == "nothing written"
fn sent(sink: Writer, text: String, to: String) -> Result<String, String> {
    put(sink, text)
    closed(sink)
    if failed(sink) {
        return Err("the whole of the text did not reach " + to)
    }
    Ok(to)
}

// example: ok_or(write_bytes(path: "", bytes: [65]), "nothing written") == "nothing written"
// example: ok_or(write_bytes(path: "unused.bin", bytes: [256]), "refused") == "refused"
fn write_bytes(path: String, bytes: List<Int>) -> Result<String, String> {
    for byte in bytes {
        if byte < 0 || byte > 255 {
            return Err(shown(byte) + " is no byte, so nothing was written to " + path)
        }
    }
    match opened(path, strings.as_latin_1()) {
        Ok(sink) => bytes_sent(sink: sink, bytes: bytes, to: path)
        Err(why) => Err(why)
    }
}

// example: ok_or(write_bytes(path: "", bytes: []), "nothing written") == "nothing written"
fn bytes_sent(sink: Writer, bytes: List<Int>, to: String) -> Result<String, String> {
    for byte in bytes {
        put(sink, or(strings.one_char(byte), ""))
    }
    closed(sink)
    if failed(sink) {
        return Err("the whole of the bytes did not reach " + to)
    }
    Ok(to)
}

// example: ok_or(append(path: "", text: "a"), "nothing appended") == "nothing appended"
fn append(path: String, text: String) -> Result<String, String> {
    match opened_to_append(path, true) {
        Ok(stream) => appended_and_let_go(stream: stream, bytes: strings.encoded(strings.as_utf_8(), text), to: path)
        Err(why) => Err(why)
    }
}

// example: ok_or(append(path: "", text: ""), "nothing appended") == "nothing appended"
fn appended_and_let_go(stream: Sink, bytes: strings.Bytes, to: String) -> Result<String, String> {
    let answer = drained(channel: channel_to(stream), bytes: bytes, to: to)
    shut(stream)
    answer
}

// A write can take fewer bytes than are left, so the writes continue until none are left.
// A write that takes none stops them, so that no loop waits on a file that takes no more.
// example: ok_or(append(path: "", text: ""), "nothing appended") == "nothing appended"
fn drained(channel: Channel, bytes: strings.Bytes, to: String) -> Result<String, String> {
    for has_room(bytes) {
        let count = written_from(channel, bytes)?
        if count <= 0 {
            return Err("the whole of the text did not reach " + to)
        }
    }
    Ok(to)
}

// example: list.length(ok_or(listed("no-such-directory"), [])) == 0
fn listed(path: String) -> Result<List<String>, String> {
    match as_a_path(named(path)) {
        Ok(found) => names_within(found)
        Err(why) => Err(why)
    }
}

// example: list.length(ok_or(listed("no-such-directory"), [])) == 0
fn names_within(found: Path) -> Result<List<String>, String> {
    match entries(found) {
        Ok(stream) => every_name(stream)
        Err(why) => Err(why)
    }
}

// All names come out of the stream first, so that no later step of the walk can throw.
// example: list.length(ok_or(listed("no-such-directory"), [])) == 0
fn every_name(stream: Entries) -> Result<List<String>, String> {
    let held = all_of(in_order(stream))
    released(stream)
    match held {
        Ok(names) => Ok(each_bare_name(names))
        Err(why) => Err(why)
    }
}

// example: list.length(ok_or(listed("no-such-directory"), [])) == 0
fn each_bare_name(names: Held) -> List<String> {
    let walk = one_by_one(names)
    var found = []
    for has_another(walk) {
        found = list.push(found, bare_name(named(as_text(next_value(walk)))))
    }
    found
}

// The JVM tells only whether it made the directory, so this function writes the reason.
// example: ok_or(made(""), "nothing made") == "nothing made"
fn made(path: String) -> Result<String, String> {
    if make(named(path)) {
        return Ok(path)
    }
    Err("no directory was made at " + path)
}

// example: !ok_or(removed("no-such-directory"), true)
fn removed(path: String) -> Result<Bool, String> {
    match as_a_path(named(path)) {
        Ok(found) => delete(found)
        Err(why) => Err(why)
    }
}

extern static read_whole(path: Path) -> Result<String, String> = "java.nio.file.Files.readString"

extern static read_whole_as(path: Path, encoding: strings.Encoding) -> Result<String, String> = "java.nio.file.Files.readString"

extern static byte_count(path: Path) -> Result<Int, String> = "java.nio.file.Files.size"

extern new opened_to_read(path: String) -> Result<Source, String>

extern method channel_of(stream: Source) -> Channel = "getChannel"

extern method int read_at(channel: Channel, buffer: strings.Bytes, position: Int) -> Result<Int, String> = "read"

// An `Err` is a JVM that has no memory left for so many bytes.
extern static allotted(int capacity: Int) -> Result<Option<strings.Bytes>, String> = "java.nio.ByteBuffer.allocate"

extern method has_room(buffer: strings.Bytes) -> Bool = "hasRemaining"

extern method flipped(buffer: strings.Bytes) -> strings.Bytes = "flip"

// A close gives nothing back, so no `Result` can hold what it throws.
// The read occurs before the close, so a close that fails loses no byte.
extern method let_go(stream: Source) -> () = "close"

extern new opened(path: String, written_as: strings.Encoding) -> Result<Writer, String>

extern method put(sink: Writer, text: String) -> () = "print"

extern method closed(sink: Writer) -> () = "close"

// A `PrintWriter` throws nothing, so this is the only report of a write that failed.
extern method failed(sink: Writer) -> Bool = "checkError"

extern static entries(path: Path) -> Result<Entries, String> = "java.nio.file.Files.list"

// The entries are sorted, so that two listings of one directory have the same order.
extern method in_order(stream: Entries) -> Entries = "sorted"

extern method all_of(stream: Entries) -> Result<Held, String> = "toList"

extern method one_by_one(names: Held) -> Walk = "iterator"

extern method released(stream: Entries) -> () = "close"

extern method has_another(walk: Walk) -> Bool = "hasNext"

extern method next_value(walk: Walk) -> Anything = "next"

extern method as_text(value: Anything) -> String = "toString"

extern method bare_name(file: File) -> String = "getName"

extern method make(file: File) -> Bool = "mkdir"

extern static delete(path: Path) -> Result<Bool, String> = "java.nio.file.Files.deleteIfExists"

extern method as_a_path(file: File) -> Result<Path, String> = "toPath"

extern new named(path: String) -> File

extern method is_there(file: File) -> Bool = "exists"

extern method is_file(file: File) -> Bool = "isFile"

extern method is_directory(file: File) -> Bool = "isDirectory"

extern method is_readable(file: File) -> Bool = "canRead"

extern method has_made_all(file: File) -> Bool = "mkdirs"

extern method parent_path(file: File) -> Option<String> = "getParent"

extern method canonical_path(file: File) -> Result<String, String> = "getCanonicalPath"

extern field path_separator() -> String = "java.io.File.pathSeparator"

extern type File = "java.io.File"

extern type Writer = "java.io.PrintWriter"

extern type interface Entries = "java.util.stream.Stream"

extern type interface Held = "java.util.List"

extern type interface Walk = "java.util.Iterator"

extern type Anything = "java.lang.Object"

extern type interface Path = "java.nio.file.Path"

extern new opened_to_append(path: String, at_the_end: Bool) -> Result<Sink, String>

extern method channel_to(stream: Sink) -> Channel = "getChannel"

extern method int written_from(channel: Channel, bytes: strings.Bytes) -> Result<Int, String> = "write"

// A close gives nothing back, so no `Result` can hold what it throws.
// The stream has no buffer, so a close that fails loses no byte.
extern method shut(stream: Sink) -> () = "close"

extern type Sink = "java.io.FileOutputStream"

extern type Source = "java.io.FileInputStream"

extern type Channel = "java.nio.channels.FileChannel"
