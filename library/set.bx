// The `Set<T>` a program builds by `empty` and `insert`, and reads by `has_value`.
//
// `docs/specs/collections.md` states each function, its type, and what it costs. A set holds a
// value once however often it is given, and a member is any type with an `Eq` and a `Hash`
// instance.
// A set is the trie `map` holds, at a key for each value and one value at every key, so a set
// costs what a map costs and the walk of the trie is written once rather than twice.
import map

// example: !has_value(empty(), 1)
fn empty<T>() -> Set<T> {
    Set(map.empty())
}

// example: has_value(insert(empty(), 1), 1)
fn insert<T: Eq<T> + Hash<T>>(into: Set<T>, value: T) -> Set<T> {
    Set(map.insert(held_by(into), value, true))
}

// example: !has_value(insert(empty(), 1), 2)
fn has_value<T: Eq<T> + Hash<T>>(within: Set<T>, value: T) -> Bool {
    match map.get(held_by(within), value) {
        Some(_) => true
        None => false
    }
}

// example: or(map.get(held_by(insert(empty(), 1)), 1), false)
fn held_by<T>(within: Set<T>) -> map.Map<T, Bool> {
    match within {
        Set(held) => held
    }
}

type Set<T> = Set(map.Map<T, Bool>)
