// Starting a program and reading what it wrote, which is how one command line tool runs another.
//
// `docs/specs/io.md` states what a run gives back. It is written over `extern` declarations,
// which `docs/specs/interop.md` states, and the list a JVM starts a program from crosses as a
// `java.util.List` of what the Bux list holds.
import files
import list

// The program reads the standard input of this program, so that it never waits on an empty pipe.
// example: ok_or(run("", []), Finished { code: 9, output: "", errors: "" }).code == 9
fn run(command: String, arguments: List<String>) -> Result<Finished, String> {
    let started_from = whole_command(command, arguments)
    let ran = started(reading_from(of_command(started_from), inherited()))?
    let output = whole(output_of(ran))
    let errors = whole(errors_of(ran))
    let code = waited_for(ran)?
    Ok(Finished { code: code, output: output, errors: errors })
}

// example: or(list.at(whole_command("java", ["-version"]), 0), "") == "java"
// example: or(list.at(whole_command("java", ["-version"]), 1), "") == "-version"
fn whole_command(command: String, arguments: List<String>) -> List<String> {
    var parts = [command]
    for argument in arguments {
        parts = list.push(parts, argument)
    }
    parts
}

// The delimiter matches no text, so the whole stream is one token.
// The read of that token waits until the writer closes the stream.
// example: whole(nothing_at_all()) == ""
fn whole(stream: InputStream) -> String {
    let scanner = delimited(over(stream), "\\A")
    let text = ok_or(token(scanner), "")
    closed(scanner)
    text
}

extern new of_command(command: List<String>) -> ProcessBuilder

extern method reading_from(builder: ProcessBuilder, input: Redirect) -> ProcessBuilder = "redirectInput"

extern field inherited() -> Redirect = "java.lang.ProcessBuilder$Redirect.INHERIT"

extern method started(builder: ProcessBuilder) -> Result<Running, String> = "start"

extern method output_of(ran: Running) -> InputStream = "getInputStream"

extern method errors_of(ran: Running) -> InputStream = "getErrorStream"

extern method int waited_for(ran: Running) -> Result<Int, String> = "waitFor"

extern method inheriting(builder: ProcessBuilder) -> ProcessBuilder = "inheritIO"

extern method within(builder: ProcessBuilder, directory: files.File) -> ProcessBuilder = "directory"

extern method input_from(builder: ProcessBuilder, file: files.File) -> ProcessBuilder = "redirectInput"

extern method output_to(builder: ProcessBuilder, file: files.File) -> ProcessBuilder = "redirectOutput"

extern method errors_to(builder: ProcessBuilder, file: files.File) -> ProcessBuilder = "redirectError"

extern method variables_of(builder: ProcessBuilder) -> Variables = "environment"

extern method removed(variables: Variables, name: files.Anything) -> Option<files.Anything> = "remove"

// `Map.remove` takes an `Object`, and a `String` becomes one only through this constant.
extern method held_as_constant(text: String) -> Constant = "describeConstable"

extern method as_object(constant: Constant) -> files.Anything = "orElseThrow"

extern method is_ended_within(ran: Running, limit: Int, unit: TimeUnit) -> Result<Bool, String> = "waitFor"

extern method stopped(ran: Running) -> Running = "destroyForcibly"

extern field seconds() -> TimeUnit = "java.util.concurrent.TimeUnit.SECONDS"

extern new over(stream: InputStream) -> Scanner

extern method delimited(scanner: Scanner, pattern: String) -> Scanner = "useDelimiter"

extern method token(scanner: Scanner) -> Result<String, String> = "next"

extern method closed(scanner: Scanner) -> () = "close"

extern static nothing_at_all() -> InputStream = "java.io.InputStream.nullInputStream"

type Finished = {
    code: Int
    output: String
    errors: String
}

extern type ProcessBuilder = "java.lang.ProcessBuilder"

extern type Running = "java.lang.Process"

extern type InputStream = "java.io.InputStream"

extern type Scanner = "java.util.Scanner"

extern type Redirect = "java.lang.ProcessBuilder$Redirect"

extern type interface Variables = "java.util.Map"

extern type Constant = "java.util.Optional"

extern type TimeUnit = "java.util.concurrent.TimeUnit"
