// The `Set<T>` a program builds by `empty` and `insert`, and reads by `has_value`.
//
// `docs/specs/collections.md` states each function, its type, and what it costs. A set holds a
// value once however often it is given, and a member is a type the prelude reaches `Eq` for.
// Every walk here is a `for` loop over a `var`, because a walk written as a function that calls
// itself runs out of stack on a set a program can build; the steps of that walk are the
// functions below, because a `match` arm is an expression and cannot assign.
/// The set that holds nothing, which every set is built out of.
// example: !has_value(empty(), 1)
fn empty<T>() -> Set<T> {
    Nothing
}

/// The set this one becomes with `value` in it, which is this one where it is in it already.
// example: has_value(insert(empty(), 1), 1)
fn insert<T: Eq<T>>(into: Set<T>, value: T) -> Set<T> {
    if has_value(into, value) {
        return into
    }
    Held(value, into)
}

/// Whether the set holds a value equal to this one.
// example: !has_value(insert(empty(), 1), 2)
fn has_value<T: Eq<T>>(within: Set<T>, value: T) -> Bool {
    var rest = within
    for is_at_another_value(rest, value) {
        rest = behind(rest)
    }
    is_a_value(rest)
}

/// Whether there is a value here, and it is not the one being looked for.
// example: is_at_another_value(insert(empty(), 1), 2)
fn is_at_another_value<T: Eq<T>>(within: Set<T>, value: T) -> Bool {
    match within {
        Nothing => false
        Held(held, _) => held != value
    }
}

/// Whether there is a value here at all.
// example: !is_a_value(empty())
fn is_a_value<T>(within: Set<T>) -> Bool {
    match within {
        Nothing => false
        Held(_, _) => true
    }
}

/// What is behind the value here, which is nothing where there is no value here.
// example: !is_a_value(behind(insert(empty(), 1)))
fn behind<T>(within: Set<T>) -> Set<T> {
    match within {
        Nothing => Nothing
        Held(_, rest) => rest
    }
}

type Set<T> =
    | Nothing
    | Held(T, Set<T>)
