// The readings of a `String`: what a `for` loop would otherwise write the same way twice, and
// what no `for` loop reads at all.
//
// `docs/specs/library.md` states the test a function here is held to: it is written in Bux over
// what the language already gives, and it lands only where a reader would write the loop twice.
// `length` meets neither test, because no loop reaches the characters of a string. It is one
// `extern` declaration away from a JVM method, which `docs/specs/interop.md` states.
// `at` and `cut` are the bounds check each such call needs, written once here rather than at
// every reading of a string. Every name here is public, so each of the two declarations they
// call guards its member: nothing this module offers is partial.
// `from_utf_8` reaches the decoder of the JVM, so no loop over `strings.one_char` writes another.
// A `Charset` of the JVM decodes the text, and a `ByteBuffer` holds the bytes, so no array crosses.
// example: or(at("ab", 1), 0) == 98
fn at(text: String, index: Int) -> Option<Int> {
    if index < 0 {
        return None
    }
    if index >= length(text) {
        return None
    }
    match code_unit_at(text, index) {
        Ok(unit) => unit
        Err(_) => None
    }
}

// example: or(cut(text: "abcd", from: 1, to: 3), "") == "bc"
fn cut(text: String, from: Int, to: Int) -> Option<String> {
    if from < 0 {
        return None
    }
    if to > length(text) {
        return None
    }
    if from > to {
        return None
    }
    match cut_out(text, from, to) {
        Ok(part) => part
        Err(_) => None
    }
}

// example: join(["a", "b"], "-") == "a-b"
fn join(parts: List<String>, between: String) -> String {
    var joined = ""
    var first = true
    for part in parts {
        if first {
            joined += part
        }
        if !first {
            joined += between
            joined += part
        }
        first = false
    }
    joined
}

// ISO-8859-1 writes a char above 255 as `?`, and a sequence that is not UTF-8 decodes to the
// replacement char, so every text has an answer.
// example: from_utf_8("Ã©") == "é"
// example: from_utf_8("é") == "�"
// example: from_utf_8("Bux") == "Bux"
fn from_utf_8(text: String) -> String {
    spelled(decoded(as_utf_8(), encoded(as_latin_1(), text)))
}

// This is the count of UTF-16 code units and not of characters: an emoji counts as two.
extern method int length(text: String) -> Int = "length"

// `at` checks the bounds before it calls this, so the `None` and the `Err` never reach its caller.
extern method char code_unit_at(text: String, int index: Int) -> Result<Option<Int>, String> = "charAt"

// `cut` checks the bounds before it calls this, so the `None` and the `Err` never reach its caller.
extern method cut_out(text: String, int from: Int, int to: Int) -> Result<Option<String>, String> = "substring"

extern static one_char(int code: Int) -> Option<String> = "java.lang.Character.toString"

extern static is_alphabetic(int code: Int) -> Option<Bool> = "java.lang.Character.isAlphabetic"

extern static int general_category(int code: Int) -> Option<Int> = "java.lang.Character.getType"

extern method encoded(encoding: Encoding, text: String) -> Bytes = "encode"

extern method decoded(encoding: Encoding, bytes: Bytes) -> Chars = "decode"

extern method spelled(chars: Chars) -> String = "toString"

extern field as_utf_8() -> Encoding = "java.nio.charset.StandardCharsets.UTF_8"

// ISO-8859-1 reads each char from 0 to 255 as the one byte of the same value.
extern field as_latin_1() -> Encoding = "java.nio.charset.StandardCharsets.ISO_8859_1"

extern type Encoding = "java.nio.charset.Charset"

extern type Bytes = "java.nio.ByteBuffer"

extern type Chars = "java.nio.CharBuffer"
