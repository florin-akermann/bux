// The variables and the properties the process a program runs in was started with, and the
// processors it may use.
//
// `docs/specs/io.md` states what a read gives back. Each is one `extern` declaration away from a
// JVM member, which `docs/specs/interop.md` states, and a variable or a property nothing set is
// `None` rather than a failure, because a process that was started without one is an ordinary case.
// example: processors() > 0
fn processors() -> Int {
    processors_of(machine())
}

extern static read(name: String) -> Option<String> = "java.lang.System.getenv"

extern static property(name: String) -> Option<String> = "java.lang.System.getProperty"

extern static machine() -> Machine = "java.lang.Runtime.getRuntime"

extern method int processors_of(running: Machine) -> Int = "availableProcessors"

extern type Machine = "java.lang.Runtime"
